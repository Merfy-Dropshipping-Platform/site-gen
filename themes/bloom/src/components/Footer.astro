---
import { inlineFormat } from "../lib/rich-text";
import SocialIcon from "./footer/SocialIcon.astro";
import { categoryPages } from "../data/categories";

const today = new Date();

const navColumnDefault = [
	...categoryPages,
	{ label: "О нас", href: "/about" },
];

// ОЖИВЛЕНИЕ (Фаза B, объём rose Footer): канон-схема theme-base Footer.puckConfig —
// siteTitle, phone, email/socialColumn.email, newsletter.enabled, navigationColumn,
// informationColumn, socialColumn.socialLinks, copyright, bottomStrip, padding.
// Тело ниже — verbatim верстальщика; дефолтные ветки = прежним строкам байт-в-байт
// (цвета → токены с пиксель-фоллбеком §7); новые элементы (заголовки колонок) не
// рендерятся без пропсов.
const p = Astro.props as Record<string, any>;
const id = p.id;
// Пустая строка (canon default Puck / коэрсер) не должна ронять «Bloom».
// Запасное имя магазина — нейтральное, НЕ название темы. Владелец 18.09: «в
// подвал должна идти лого из настроек темы, если загружена, или, если нет, то
// как в шапке браться с админки, а не отображаться название темы». Имя темы
// приезжало сюда ЧЕТВЁРТЫМ путём (после сидов, copyright.companyName и
// siteTitle в ревизии): порт сам подставлял SITE_TITLE из consts.ts, и подвал
// печатал «Bloom» при магазине «Bloom Pilot». Название магазина подставляет
// сборка (build.service) и миграция ревизии; сюда управление доходит, только
// если магазин безымянный.
const siteTitle = typeof p.siteTitle === "string" && p.siteTitle.trim() ? p.siteTitle : "Мой магазин";
// Логотип подвала: тот же источник, что у шапки (брендинг мерчанта).
// Плейсхолдер «/logo.svg» не существует на витрине — считаем его отсутствием.
const _rawFooterLogo = typeof p.logo === "string" ? p.logo.trim() : "";
let _footerLogoPath = "";
try {
	_footerLogoPath = new URL(_rawFooterLogo, "https://_merfy_").pathname;
} catch {
	_footerLogoPath = _rawFooterLogo;
}
// Как в шапке: файл темы (/icons/…) и плейсхолдер — не логотип магазина.
const footerLogo =
	_rawFooterLogo && _footerLogoPath !== "/logo.svg" && !_footerLogoPath.startsWith("/icons/")
		? _rawFooterLogo
		: "";
const phone = typeof p.phone === "string" && p.phone.trim() ? p.phone.trim() : "";
const rawEmail = p.socialColumn?.email ?? p.email ?? "";
const email = typeof rawEmail === "string" ? rawEmail.trim() : "";
const contactFields: Array<{ label: string; value: string }> = Array.isArray(p.socialColumn?.contactFields)
	? p.socialColumn.contactFields.filter((f: any) => f && typeof f.value === "string" && f.value.trim())
	: [];

// Блок «Адрес» — отдельный элемент вёрстки bloom. Значение берём из «Информации
// о компании» (поле с подписью «Адрес»), а не из литерала верстальщика: показывать
// мерчанту выдуманный адрес нельзя. Нет такого поля — блок не рендерится вовсе.
// Одну строку адреса разбиваем по запятым, чтобы сохранить многострочный вид.
const addressField = contactFields.find((f) => /адрес|address/i.test(f.label ?? ""));
const addressLines = addressField
	? addressField.value
			.split(",")
			.map((part) => part.trim())
			.filter(Boolean)
	: [];
// Остальные поля компании (ИНН, часы работы и т.п.) идут в колонку контактов —
// адрес там не дублируем.
const otherContactFields = contactFields.filter((f) => f !== addressField);
// Колонка контактов рендерится ТОЛЬКО когда есть что показать: иначе в подвале
// висела голая подпись «Контакты:» без единого значения (пользователь #17).
const hasContacts = Boolean(phone || email || otherContactFields.length > 0);
const emailPlaceholder = `example@${siteTitle.toLowerCase()}.merfy`;

// Канон newsletter.enabled — скрыть блок подписки ТОЛЬКО при явном false/'false'
// (булево может прийти строкой). Отсутствие пропа → блок показан = пиксель.
const newsletterEnabled = !(
	p.newsletter &&
	(p.newsletter.enabled === false || p.newsletter.enabled === "false")
);
// Оживление полей панели «Рассылка» (Figma 314-34558 «Заголовок»/«Текст» =
// heading.text / text.content). Раньше обе строки были захардкожены → правка в
// панели ничего не меняла. Fallback = литералы верстальщика, поэтому без правок
// мерчанта футер остаётся байт-в-байт. Паритет rose Footer.
const newsletterHeadingText =
	typeof p.heading?.text === "string" && p.heading.text.trim()
		? p.heading.text
		: "ПОДПИШИТЕСЬ НА РАССЫЛКУ";
// Своя colorScheme на <footer> (как rose Footer): при hot-render одиночного блока
// в превью обёртки композитора нет, и футер брал :root — тёмный BASE_DEFAULT.
// На live обёртка даёт ту же схему, дубль безвреден.
const footerSchemeClass = (() => {
	// схема приходит строкой ("scheme-4") ИЛИ числом — разбираем оба вида
	const raw = p.colorScheme;
	const id =
		typeof raw === "number"
			? String(raw)
			: typeof raw === "string" && raw
				? String(raw).replace("scheme-", "")
				: "";
	return id ? `color-scheme-${id}` : "";
})();
// «Выравнивание» (contentAlign) — блок рассылки и группа колонок. Классы
// литералами, иначе Tailwind JIT их не соберёт. Дефолт left = вёрстка как была.
const _AL_ITEMS: Record<string, string> = { left: "items-start", center: "items-center", right: "items-end" };
const _AL_TEXT: Record<string, string> = { left: "text-left", center: "text-center", right: "text-right" };
const _ca = ["left", "center", "right"].includes(p.contentAlign) ? p.contentAlign : "left";
const nlSectionAlignCls = _ca === "left" ? "lg:items-start lg:justify-between" : _AL_ITEMS[_ca];
const nlCopyAlignCls = _ca === "left" ? "" : `${_AL_ITEMS[_ca]} ${_AL_TEXT[_ca]}`;
// Лестницы §9 MANNER: заголовок рассылки Urbanist 20 (canon medium) → small 14,
// large 24; текст Inter 16 (canon medium) → small 14, large 19.
const nlHeadingSize = p.heading?.size ?? p.headingSize;
const nlHeadingSizeCls =
	nlHeadingSize === "small" ? "text-[14px]" : nlHeadingSize === "large" ? "text-[24px]" : "text-[20px]";
const nlTextSize = p.text?.size ?? p.textSize;
const nlTextSizeCls =
	nlTextSize === "small" ? "text-[14px]" : nlTextSize === "large" ? "text-[19px]" : "text-[16px]";
const newsletterText =
	typeof p.text?.content === "string" && p.text.content.trim()
		? p.text.content
		: "Подпишитесь на наши акции и новости";

// Канон-колонки {title, links:[{label,href}]}: ссылки из пропсов с fallback на
// литералы верстальщика (навигация = категории + О нас; информация = правовые
// ссылки /legal/*); заголовок колонки — НОВЫЙ элемент, рендерится только при
// непустом title (в вёрстке верстальщика заголовков колонок нет).
const coerceColumnLinks = (
	col: any,
	fallback: Array<{ label: string; href: string }>,
): Array<{ label: string; href: string }> =>
	Array.isArray(col?.links) && col.links.length > 0
		? col.links.map((l: any) => ({ label: String(l?.label ?? ""), href: String(l?.href ?? "/") }))
		: fallback;
const navLinks = coerceColumnLinks(p.navigationColumn, navColumnDefault);
const infoLinks = coerceColumnLinks(p.informationColumn, []);
const columnTitle = (col: any): string | undefined =>
	typeof col?.title === "string" && col.title.trim() ? col.title : undefined;
const navColTitle = columnTitle(p.navigationColumn);
const infoColTitle = columnTitle(p.informationColumn);
const columnTitleCls =
	"font-urbanist text-[16px] font-light uppercase leading-normal text-[rgb(var(--color-text,0_0_0))]";

// Канон socialColumn.socialLinks (enum платформ) → подписи верстальщика для
// SocialIcon (DS-карта иконок); fallback = литеральный набор верстальщика дословно.
const SOCIAL_PLATFORMS: Record<string, string> = {
	vk: "VK",
	youtube: "YouTube",
	dzen: "Яндекс Дзен",
	tiktok: "TikTok",
	telegram: "Telegram",
	// MAX — российский мессенджер (просьба владельца 14.09). Подпись «MAX» ловит
	// SocialIcon темы: в карте дизайн-системы такой сети нет.
	max: "MAX",
};
const socials = Array.isArray(p.socialColumn?.socialLinks)
	? p.socialColumn.socialLinks
			.map((s: any) => {
				const label = SOCIAL_PLATFORMS[String(s?.platform ?? "")];
				const href = String(s?.href ?? "").trim();
				return label && href && href !== "#" ? { platform: label, href } : null;
			})
			.filter((s: any) => s !== null)
	: [];

// Канон copyright {companyName, poweredBy, showYear} (+ legacy-строка целиком).
// Дефолтная сборка = литерал блока 3 верстальщика байт-в-байт:
// «© {год} {siteTitle} Все права защищены.» — БЕЗ хвоста Powered by
// (он живёт в розовой полосе блока 4). canon-default poweredBy 'Powered by Merfy'
// из puckConfig трактуется как «не задан» → литерал (правило canon-default → пиксель).
const copyrightProp = p.copyright;
const copyrightOverride =
	typeof copyrightProp === "string" && copyrightProp.trim() ? copyrightProp : undefined;
const copyrightObj = copyrightProp && typeof copyrightProp === "object" ? copyrightProp : {};
const showYear = !(copyrightObj.showYear === false || copyrightObj.showYear === "false");
const companyPart =
	typeof copyrightObj.companyName === "string" && copyrightObj.companyName.trim()
		? copyrightObj.companyName
		: siteTitle;
// Подпись платформы. Владелец 20.09: во всех темах по умолчанию «Разработано
// на Merfy», текст задаёт мерчант в админке («Редактировать содержимое темы»).
// Стандартный текст — ссылка на https://merfy.ru/ (владелец 20.09 поправил
// сам себя: «ссылку всё таки надо оставлять»). Прежнее «Powered by
// Merfy» в старых ревизиях считаем не тронутым и заменяем новым текстом.
const poweredByTail =
	typeof copyrightObj.poweredBy === "string" &&
	copyrightObj.poweredBy.trim() &&
	copyrightObj.poweredBy !== "Powered by Merfy" &&
	copyrightObj.poweredBy !== "Разработано на Merfy"
		? copyrightObj.poweredBy
		: "";
const copyrightText =
	// Копирайт убран из тем (владелец 20.09). Показывается только то, что
	// мерчант сам завёл: либо своей строкой копирайта, либо записью в
	// «Блоках информации о компании» — она выводится в контактах.
	copyrightOverride ?? "";

// Канон bottomStrip {enabled, text} — розовая полоса блока 4 верстальщика.
// enabled false/'false' → полоса скрыта; непустой text перебивает литеральную
// сборку. НЮАНС: blockDefaults bloom пишут text «© 2026 Bloom Theme. Powered by
// Merfy» (короче литерала) — трактуем как canon-default → литерал.
const CANON_STRIP_TEXT = "© 2026 Bloom Theme. Powered by Merfy";
const strip = p.bottomStrip && typeof p.bottomStrip === "object" ? p.bottomStrip : undefined;
const bottomStripVisible = !(strip && (strip.enabled === false || strip.enabled === "false"));
// Подпись платформы ведёт на лендинг (владелец 20.09: «сделать именно
// ссылкой на https://merfy.ru/»). Ссылка только у стандартного текста: вписал
// мерчант своё — остаётся просто текст.
const PLATFORM_URL = "https://merfy.ru/";
const stripText =
	typeof strip?.text === "string" && strip.text.trim() && strip.text !== CANON_STRIP_TEXT &&
		strip.text.trim() !== "Powered by Merfy"
		? strip.text
		// Дефолт полосы — только подпись платформы. Раньше он дословно повторял
		// строку копирайта выше, и в подвале было два одинаковых «© … Все права
		// защищены» подряд. Мерчантский текст полосы, если задан, идёт как есть.
		// Мерчантский текст из окна «Содержимое темы» (админка) приходит в
		// copyright.poweredBy. До 20.09 он кормил только строку копирайта, а её
		// из тем убрали — и поле в админке правилось вхолостую. Теперь он
		// перебивает дефолт полосы; ссылку с него тема снимает (stripIsDefault).
		: poweredByTail || "Разработано на Merfy";
const stripIsDefault = stripText === "Разработано на Merfy";
// Копирайт рисуем, только если мерчант его сам задал (пустая строка —
// дефолт после 20.09), иначе осталась бы висящая линейка без текста.
const showCopyright = copyrightText.trim().length > 0;

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при пропе, на носителе отступов
// верстальщика (контейнер pt-16 pb-24 md:pb-28). {80,80} = canon-default puckConfig
// (его впрыскивает коэрсер) → литерал (правило canon-default → пиксель).
const pad = p.padding && typeof p.padding === "object" ? p.padding : undefined;
const isCanonPad = pad && Number(pad.top) === 80 && Number(pad.bottom) === 80;
const footerPadStyle =
	pad && !isCanonPad
		? `padding-top:${Number(pad.top) || 0}px;padding-bottom:${Number(pad.bottom) || 0}px;`
		: undefined;
// Footer верстальщиков: низ pt-16 pb-20 (без md:pb-28), зазор блоков gap-16, поле
// подписки pl-3, кнопка px-2, адрес/контакты gap-1 и mt-6, списки gap-2, правовая
// строка gap-8. Подпись платформы и две колонки — наши решения, не трогаем.
// PARITY_DESIGN (владелец 23.09: «как у верстальщиков, только стили»): отступы,
// зазоры и высота строк по актуальной вёрстке Bloom-theme @5aae2ad6. Настройки и
// цвета не меняются; без признака — прежние классы. Признак ставит sites.
const designParity = p.__designParity === true;
const FT = designParity
	? { pad: "pt-16 pb-20", stack: "gap-16", inputPl: "pl-3", btnPx: "px-2", lines: "gap-1", contactsMt: "mt-6", list: "gap-2", legal: "gap-8" }
	: { pad: "pt-16 pb-24 md:pb-28", stack: "gap-12", inputPl: "pl-4", btnPx: "px-4", lines: "gap-[3px]", contactsMt: "mt-5", list: "gap-3", legal: "gap-4 pt-2" };
const footerContainerCls = footerPadStyle
	? "mx-auto w-full max-w-[1920px] px-4 md:px-20 2xl:px-[300px]"
	: `mx-auto w-full max-w-[1920px] px-4 ${FT.pad} md:px-20 2xl:px-[300px]`;
---

<footer class:list={["w-full bg-[rgb(var(--color-bg,255_255_255))]", footerSchemeClass]} data-puck-component-id={id}>
	<div class={footerContainerCls} style={footerPadStyle} data-animate>
		<div class={`mx-auto flex w-full max-w-[1320px] flex-col ${FT.stack}`}>
			<!-- Block 1: Newsletter -->
			{newsletterEnabled && (
			<section
				class={`flex w-full flex-col gap-6 lg:flex-row ${nlSectionAlignCls}`}
				aria-labelledby="newsletter-heading"
			>
				<div class={`flex flex-col gap-2 ${nlCopyAlignCls}`}>
					<h2
						id="newsletter-heading"
						class={`font-urbanist ${nlHeadingSizeCls} font-light leading-normal text-[rgb(var(--color-heading,0_0_0))]`}
						data-puck-subsection-parent={id}
						data-puck-subsection-index="100"
						data-puck-subsection-field="newsletter"
						set:html={inlineFormat(newsletterHeadingText)}
					></h2>
					<p
						class={`font-inter ${nlTextSizeCls} font-light leading-normal text-[rgb(var(--color-muted,153_153_153))]`}
						set:html={inlineFormat(newsletterText)}
					></p>
				</div>

				<div class="flex w-full max-w-[318px] flex-col gap-2 lg:shrink-0">
					{/* Поле подписки — «Фон» СХЕМЫ, надпись в нём — «Текст» СХЕМЫ. Было
					    `bg-white`/`text-black`: Tailwind 4 печатает их как
					    var(--color-white)/var(--color-black) — переменные ЕСТЬ, а схемы в них
					    нет, и поле замирало белым с чёрной надписью, пока полотно подвала
					    вокруг уже ехало (замер матрицы, схемы-зонды 1 → 4: #fff → #fff и
					    #000 → #000 против 17,0,0 → 0,17,0 у подвала). Пара «фон + надпись»
					    переводится ЦЕЛИКОМ: увести в схему только фон значит получить чёрное
					    на тёмном. Роль та же, что у поля промокода «Сводки заказа» (fix b19).
					    Фолбэки = прежний вид. Сторож: pnpm test:scheme-targets. */}
					<form
						class={`flex h-10 w-full items-center gap-2 rounded-full border border-[rgb(var(--color-input-border,255_212_229))] bg-[rgb(var(--color-bg,255_255_255))] ${FT.inputPl} pr-1 transition-colors focus-within:border-[#E38E9F]`}
						data-newsletter-form
						data-puck-subsection-parent={id}
						data-puck-subsection-index="997"
						data-puck-subsection-field="newsletter"
					>
						<input
							type="email"
							name="email"
							required
							placeholder={emailPlaceholder}
							aria-label="Email"
							class="min-w-0 flex-1 bg-transparent font-inter text-[14px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))] outline-none placeholder:text-[#FFD4E5]"
						/>
						<button
							type="submit"
							class={`inline-flex h-8 shrink-0 items-center justify-center rounded-full bg-[rgb(var(--color-surface,253_244_246))] ${FT.btnPx} font-inter text-[12px] font-light leading-normal text-[rgb(var(--color-accent,227_142_159))] transition-opacity hover:opacity-80 active:scale-95`}
						>
							Отправить
						</button>
					</form>
					<p
						data-newsletter-status
						role="status"
						class="hidden font-inter text-[14px] font-light leading-normal text-[rgb(var(--color-accent,227_142_159))]"
					></p>
				</div>
			</section>
			)}

			<!-- Block 2: Main footer -->
			<section
				class="flex w-full flex-col gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-16"
				aria-label="Навигация по сайту"
			>
				<div class="flex flex-col items-start">
					<a href="/" class="inline-flex transition-opacity hover:opacity-80" aria-label={siteTitle}>
						{/* Логотип магазина, а не картинка темы: файл берём из брендинга
						    (p.logo), без него — название магазина текстом, как в шапке. */}
						{footerLogo ? (
							<img
								src={footerLogo}
								alt={siteTitle}
								class="h-[19px] w-auto max-w-[160px] object-contain"
								decoding="async"
							/>
						) : (
							<span class="font-comfortaa text-[19px] font-normal leading-none tracking-normal text-[rgb(var(--color-heading,227_142_159))]">
								{siteTitle}
							</span>
						)}
					</a>

					{addressLines.length > 0 && (
						<address class={`mt-8 flex flex-col ${FT.lines} not-italic`}>
							<span class="font-inter text-[14px] font-light leading-[18px] text-[rgb(var(--color-muted,153_153_153))]">
								{addressField?.label ?? "Адрес"}:
							</span>
							{addressLines.map((line) => (
								<span class="font-inter text-[14px] font-light leading-[18px] text-[rgb(var(--color-muted,153_153_153))]">
									{line}
								</span>
							))}
						</address>
					)}

					{hasContacts && (
					<div
						class={`${FT.contactsMt} flex flex-col ${FT.lines}`}
						data-puck-subsection-parent={id}
						data-puck-subsection-index="994"
						data-puck-subsection-field="socialColumn"
					>
						<span class="font-inter text-[14px] font-light leading-[18px] text-[rgb(var(--color-muted,153_153_153))]">
							Контакты:
						</span>
						{phone && (
							<a
								href={`tel:${phone.replace(/[^+\d]/g, "")}`}
								class="font-inter text-[14px] font-light leading-[18px] text-[rgb(var(--color-muted,153_153_153))] transition-opacity hover:opacity-70"
							>
								{phone}
							</a>
						)}
						{email && (
							<a
								href={`mailto:${email}`}
								class="font-inter text-[14px] font-light leading-[18px] text-[rgb(var(--color-muted,153_153_153))] transition-opacity hover:opacity-70"
							>
								{email}
							</a>
						)}
						{otherContactFields.map((f) => (
							<div class="font-inter text-[14px] font-light leading-[18px] text-[rgb(var(--color-muted,153_153_153))]">
								<span class="text-[rgb(var(--color-text,0_0_0))]">{f.label}:</span> {f.value}
							</div>
						))}
					</div>
					)}

					{socials.length > 0 && (
						<div class="mt-6 flex flex-wrap items-center gap-2">
							{socials.map((s) => (
								<SocialIcon
									href={s.href}
									ariaLabel={s.platform}
									platform={s.platform}
								/>
							))}
						</div>
					)}
				</div>

				{/* «Навигация» и «Информация» — колонки ОДНОЙ сетки (пользователь #17:
				    раньше «Информация» жила отдельной строкой в правовом блоке ниже,
				    и колонки не стояли на одной линии). */}
				<div class="flex flex-col gap-10 sm:flex-row sm:gap-16 lg:ml-auto lg:pt-0">
					<ul
						class={`flex flex-col ${FT.list}`}
						role="list"
						data-puck-subsection-parent={id}
						data-puck-subsection-index="996"
						data-puck-subsection-field="navigationColumn"
					>
						{navColTitle && (
							<li>
								<h3 class={columnTitleCls}>{navColTitle}</h3>
							</li>
						)}
						{navLinks.map((link) => (
							<li>
								<a
									href={link.href}
									class="font-inter text-[14px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))] transition-opacity hover:opacity-70"
								>
									{link.label}
								</a>
							</li>
						))}
					</ul>

					{(infoColTitle || infoLinks.length > 0) && (
						<ul
							class={`flex flex-col ${FT.list}`}
							role="list"
							data-puck-subsection-parent={id}
							data-puck-subsection-index="995"
							data-puck-subsection-field="informationColumn"
						>
							{infoColTitle && (
								<li>
									<h3 class={columnTitleCls}>{infoColTitle}</h3>
								</li>
							)}
							{infoLinks.map((link) => (
								<li>
									<a
										href={link.href}
										class="font-inter text-[14px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))] transition-opacity hover:opacity-70"
									>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					)}
				</div>
			</section>

			<!-- Block 3: Legal row -->
			{showCopyright && (
				<section class={`flex w-full flex-col ${FT.legal}`} aria-label="Правовая информация">
					<div class="h-px w-full bg-[rgb(var(--color-accent,227_142_159)/0.5)]" aria-hidden="true"></div>

					<div class="flex w-full flex-col gap-3 md:flex-row md:items-center md:justify-between">
						<p
							class="font-inter text-[14px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))]"
							data-puck-subsection-parent={id}
							data-puck-subsection-index="993"
							data-puck-subsection-field="copyright"
						>
							{copyrightText}
						</p>
					</div>
				</section>
			)}
		</div>
	</div>

	<!-- Block 4: Bottom pink bar -->
	{bottomStripVisible && (
		<div
			class="w-full bg-[rgb(var(--color-bg,227_142_159))] py-5"
			data-puck-subsection-parent={id}
			data-puck-subsection-index="992"
			data-puck-subsection-field="bottomStrip"
		>
			<p class="text-center font-inter text-[14px] font-light leading-normal text-[rgb(var(--color-text,255_255_255))]">
				{stripIsDefault ? (
					<a href={PLATFORM_URL} target="_blank" rel="noopener noreferrer" class="hover:opacity-70">{stripText}</a>
				) : (
					stripText
				)}
			</p>
		</div>
	)}
</footer>

<script>
	document.querySelector<HTMLFormElement>("[data-newsletter-form]")?.addEventListener("submit", (event) => {
		event.preventDefault();
		const form = event.currentTarget as HTMLFormElement;
		const status = document.querySelector<HTMLElement>("[data-newsletter-status]");
		if (status) {
			status.textContent = "Спасибо! Мы отправим вам приветственное письмо.";
			status.classList.remove("hidden");
		}
		form.reset();
	});
</script>
