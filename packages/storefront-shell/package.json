{
  "name": "@merfy/shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/core/index.ts",
  "types": "./src/core/index.ts",
  "exports": {
    ".": "./src/core/index.ts",
    "./core": "./src/core/index.ts",
    "./behaviors": "./src/core/behaviors/index.ts",
    "./behaviors/catalog": "./src/core/behaviors/catalog.ts",
    "./behaviors/motion-css": "./src/core/behaviors/motion-css.ts",
    "./events": "./src/core/event-catalog.ts",
    "./actions": "./src/core/action-catalog.ts",
    "./core-parts.json": "./core-parts.json"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "vitest run --project browser",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write --no-error-on-unmatched-pattern src build sections __tests__ scripts",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src build sections __tests__ scripts"
  },
  "dependencies": {
    "@merfy/storefront-config": "workspace:*",
    "embla-carousel": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-fade": "8.6.0",
    "motion": "14.0.0",
    "nanostores": "1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "esbuild": "0.25.12",
    "eslint": "9.39.2",
    "jsdom": "24.1.3",
    "playwright": "1.59.1",
    "prettier": "3.8.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0",
    "vitest": "3.2.7"
  }
}
