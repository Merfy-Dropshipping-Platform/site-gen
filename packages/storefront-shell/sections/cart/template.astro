<!-- Значки — Lucide (shopping-bag, image, minus, plus, x), лицензия ISC, lucide.dev/license. -->
<div class="mx-auto flex max-w-page flex-col gap-6 px-4 font-body text-foreground">
  <h1 class="m-0 font-heading weight-heading tracking-heading text-3xl text-heading md:text-4xl">Корзина</h1>
  <div data-ref="empty" class="flex flex-col items-center gap-4 rounded-card bg-muted px-6 py-16 text-center" hidden>
    <svg class="size-10 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><path d="M3 6h18" /><path d="M16 10a4 4 0 0 1-8 0" /></svg>
    <p class="m-0 font-heading weight-heading text-xl text-heading">В корзине пока пусто</p>
    <a class="inline-flex h-12 items-center justify-center rounded-button border-width-button border-primary-border bg-primary px-8 text-base text-primary-foreground no-underline shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground" href="/catalog">Продолжить покупки</a>
  </div>
  <div data-ref="lines" class="flex flex-col border-t border-border" hidden>
    <template>
      <div class="flex gap-4 border-b border-border py-5">
        <span class="relative flex size-20 shrink-0 items-center justify-center overflow-hidden rounded-media bg-muted text-muted-foreground md:size-24">
          <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /></svg>
          <img data-ref="image" alt="" class="absolute inset-0 size-full object-cover" />
        </span>
        <div class="flex min-w-0 flex-1 flex-col gap-3 md:flex-row md:items-center md:gap-6">
          <div class="flex min-w-0 flex-1 flex-col gap-1">
            <p data-ref="title" class="m-0 line-clamp-2 text-base text-heading"></p>
            <p data-ref="options" class="m-0 text-sm text-muted-foreground"></p>
            <p data-ref="price" class="m-0 text-sm text-muted-foreground"></p>
          </div>
          <div class="flex items-center justify-between gap-4 md:gap-6">
            <div class="inline-flex h-11 shrink-0 items-center rounded-input border-width-input border-input bg-background" role="group" aria-label="Количество">
              <button
                type="button"
                data-ref="less"
                data-action="cart.change"
                aria-label="Меньше"
                class="inline-flex size-11 cursor-pointer items-center justify-center rounded-input bg-transparent p-0 text-foreground hover:bg-accent hover:text-accent-foreground"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /></svg>
              </button>
              <span data-ref="quantity" class="min-w-6 text-center text-sm tabular-nums">0</span>
              <button
                type="button"
                data-ref="more"
                data-action="cart.change"
                aria-label="Больше"
                class="inline-flex size-11 cursor-pointer items-center justify-center rounded-input bg-transparent p-0 text-foreground hover:bg-accent hover:text-accent-foreground"
              >
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
              </button>
            </div>
            <p data-ref="total" class="m-0 shrink-0 text-base weight-heading text-price md:min-w-24 md:text-right"></p>
            <button type="button" data-ref="remove" data-action="cart.remove" class="inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-button bg-transparent p-0 text-muted-foreground hover:bg-accent hover:text-accent-foreground" aria-label="Удалить">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
            </button>
          </div>
        </div>
      </div>
    </template>
  </div>
  <div data-ext-point="cart"></div>
</div>
