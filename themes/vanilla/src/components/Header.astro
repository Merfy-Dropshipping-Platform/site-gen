---
import NtIcon from "@merfy-dropshipping-platform/design-systems-theme/components/ui/NtIcon.astro";
import SchemeIcon from "../../../../packages/theme-base/primitives/SchemeIcon.astro";
import { VANILLA_ICON_SVGS } from "./icons/vanilla-icon-svgs";
import VanilaLogo from "../icons/VanilaLogo.astro";
import VanilaLogoDesigners from "../icons/VanilaLogoDesigners.astro";
import NavItem from "./NavItem.astro";
import { NAV_SUBMENU_TOGGLE_SOURCE } from "../../../../packages/theme-base/runtime/nav-submenu-toggle";
import { SITE_TITLE } from "../consts";
import { getProductById } from "../data/products";

interface NavLink {
	label: string;
	href: string;
	match?: (url: URL) => boolean;
	submenu?: NavLink[];
}

function pathnameBase(url: URL): string {
	const p = url.pathname.replace(/\/+$/, "");
	return p === "" ? "/" : p;
}

/** Активный раздел каталога на карточке товара */
function catalogNavFromProduct(url: URL): "textile" | "decor" | null {
	const p = pathnameBase(url);
	const m = p.match(/^\/products\/([^/]+)$/);
	if (!m?.[1]) return null;
	const product = getProductById(m[1]);
	return product?.collection === "Декор" ? "decor" : "textile";
}

const defaultNav: NavLink[] = [
	{
		label: "Текстиль",
		href: "/catalog/textile",
		match: (url) =>
			catalogNavFromProduct(url) === "textile" ||
			pathnameBase(url) === "/catalog" ||
			pathnameBase(url) === "/catalog/textile",
	},
	{
		label: "Декор",
		href: "/catalog/decor",
		match: (url) => catalogNavFromProduct(url) === "decor" || pathnameBase(url) === "/catalog/decor",
	},
	{ label: "История", href: "/about", match: (url) => pathnameBase(url).startsWith("/about") },
];

// ОЖИВЛЕНИЕ (Фаза B, объём bloom Header): канон-схема theme-base Header.puckConfig —
// siteTitle, navigationLinks, logo, logoPosition, activeLinkIndicator, stickiness,
// padding. Тело ниже — verbatim верстальщика; дефолтные ветки тернарников = прежним
// строкам байт-в-байт (цвета шапки → токены с пиксель-фоллбеком родных, MANNER §7).
const p = Astro.props as Record<string, any>;
const id = p.id;
// Пустая строка (впрыск коэрсера live-пути) не должна гасить название магазина.
const siteTitle = typeof p.siteTitle === "string" && p.siteTitle.trim() ? p.siteTitle : SITE_TITLE;
// Вложенность сохраняем рекурсивно (до 3 уровней рисует NavItem). Раньше маппинг
// оставлял только label+href — и подменю мерчанта у vanilla пропадало целиком,
// в отличие от остальных четырёх тем.
const mapNavLink = (l: any): NavLink => ({
	label: l.label ?? l.text ?? "",
	href: l.href ?? l.link ?? "/",
	submenu: Array.isArray(l.submenu) ? l.submenu.map(mapNavLink) : undefined,
});
const nav: NavLink[] =
	Array.isArray(p.navigationLinks) && p.navigationLinks.length > 0
		? p.navigationLinks.map(mapNavLink)
		: defaultNav;

// Канон logo (URL картинки; панель «Логотип» пишет в props.logo): непустая строка →
// <img> высотой var(--size-logo-width) (слайдер «Размер» канона задаёт высоту лого)
// в mobile И desktop. Дефолт = SVG-вордмарк VanilaLogo верстальщика (white-вариант):
// mobile h-6 (24px), desktop h-7 (28px) — фоллбеки токена = родные высоты.
const logo = typeof p.logo === "string" && p.logo.trim() ? p.logo : undefined;
const logoImgMobileCls = "h-[var(--size-logo-width,24px)] w-auto max-w-[76px] object-contain";
const logoImgDesktopCls = "h-[var(--size-logo-width,28px)] w-auto max-w-[160px] object-contain";

// PARITY_DESIGN (владелец 23-24.09: «как у верстальщиков, только стили»):
// встроенный вордмарк — ширина и сам рисунок по актуальной Vanilla-theme
// @c65d9e1c. У них «Vanilla» двумя «l» (другой набор путей, не только
// размер) — рисует отдельный компонент VanilaLogoDesigners, выбор по
// признаку. Загруженный МЕРЧАНТОМ логотип (logoImgMobileCls/DesktopCls выше)
// не трогаем — это чужая настройка «Логотип», не вордмарк темы.
// Без признака — прежние классы и прежний VanilaLogo байт-в-байт.
const designParity = p.__designParity === true;
const VANILA_LOGO_MOBILE_CLS = designParity
	? "h-[var(--size-logo-width,24px)] w-auto max-w-[85px]"
	: "h-[var(--size-logo-width,24px)] w-auto max-w-[76px]";
const VANILA_LOGO_DESKTOP_CLS = designParity
	? "h-[var(--size-logo-width,28px)] w-[98px]"
	: "h-[var(--size-logo-width,28px)] w-auto max-w-[89px]";

// Канон logoPosition: 'center-absolute' (canon-default из blockDefaults vanilla) И
// отсутствие / неизвестное значение → ЛИТЕРАЛ верстальщика (лого центр абсолютом,
// нав слева, иконки справа gap-5). Явный 'center-left' («Слева») → лого в поток в
// начало строки (justify-between раздаёт: лого слева, нав в центре, иконки справа).
// 'top-left' / 'top-center' → TWO-ROW layouts (NEW).
const logoPosition = typeof p.logoPosition === "string" ? p.logoPosition : "";
const logoLeft = logoPosition === "center-left";
const isTwoRow = logoPosition === "top-left" || logoPosition === "top-center";
// Цвет логотипа — «Заголовок» СХЕМЫ (логотип рисуется SVG на currentColor).
// Было `text-white`: Tailwind 4 печатает его как var(--color-white) — переменная
// есть, а схемы в ней нет, и логотип замирал белым, тогда как САМ бар шапки уже
// едет за схемой (bg-[rgb(var(--color-bg,58_69_48))] на <header>). Замер матрицы
// (схемы-зонды 1 → 4): логотип #fff → #fff против 17,0,0 → 0,17,0 у бара. Роль
// взята у эталона — логотип bloom/rose стоит на --color-heading. Фолбэк
// 255_255_255 = заводской белый vanilla. Сторож: pnpm test:scheme-targets.
const logoInkCls = "text-[rgb(var(--color-heading,255_255_255))]";
// Логотип «по центру» в ОДНОрядной раскладке центрируется КОЛОНКОЙ грида, а не
// `absolute`. Прежний absolute требовал позиционированной строки — и эта же
// строка становилась якорем для плашки «Расширенного» меню: та считала края от
// неё и получалась уже шапки (замер 1700: плашка 1560 из 1700, левый край 70 —
// упирается в `max-w-[1560px]` строки). Пункт 26 документа владельца.
const desktopLogoCls = logoLeft
	? `flex shrink-0 items-center ${logoInkCls}`
	: `col-start-2 flex shrink-0 items-center justify-self-center ${logoInkCls}`;

// Канон activeLinkIndicator: 'underline' (canon-default из blockDefaults vanilla) И
// отсутствие = литерал верстальщика (after:h-px белая полоска под активной ссылкой);
// явный 'none' снимает индикатор (desktop-полоску и полоску бургера).
const activeUnderline = p.activeLinkIndicator !== "none";

// Канон stickiness: шапка верстальщика НЕ sticky — 'none' / отсутствие = литерал.
// 'always' / 'scroll-up' → position:sticky inline-стилем (глобальный
// [data-vanilla-header]{position:relative} перебивается только inline);
// 'scroll-up' дополнительно прячет шапку при скролле вниз (паттерн rose/bloom):
// is:inline скрипт через data-атрибут, идемпотентность — data-hydrated.
const stickiness = typeof p.stickiness === "string" ? p.stickiness : "";
const isSticky = stickiness === "always" || stickiness === "scroll-up";
const rootCls =
	stickiness === "scroll-up"
		? "flex w-full flex-col transition-transform duration-300"
		: "flex w-full flex-col";
const stickyStyle = isSticky ? "position:sticky;top:0;z-index:50;" : undefined;
const SCROLL_UP_JS = [
	"(function(){",
	"var root=document.querySelector('[data-vanilla-sticky=\"scroll-up\"]');",
	"if(!root||root.getAttribute('data-hydrated')==='true')return;",
	"root.setAttribute('data-hydrated','true');",
	"var last=window.scrollY;",
	"window.addEventListener('scroll',function(){",
	"var y=window.scrollY;",
	"if(y>last&&y>root.offsetHeight){root.style.transform='translateY(-100%)';}else{root.style.transform='';}",
	"last=y;",
	"},{passive:true});",
	"})();",
].join("");

// Канон padding {top,bottom} — clamp ≤64 на носителе высоты верстальщика
// (desktop-ряд h-20; мобильная строка h-14 фиксированная). {32,32} = canon-default
// blockDefaults vanilla (его же пишет seed) → ЛИТЕРАЛ h-20 (32+28 ≈ те же 80px);
// иное значение снимает h-20 и ведёт высоту inline-отступами.
const pad = p.padding && typeof p.padding === "object" ? p.padding : undefined;
const isCanonPad = pad && Number(pad.top) === 32 && Number(pad.bottom) === 32;
const headerPad =
	pad && !isCanonPad
		? { top: Math.min(Number(pad.top) || 0, 64), bottom: Math.min(Number(pad.bottom) || 0, 64) }
		: undefined;
const headerPadStyle = headerPad
	? `padding-top:${headerPad.top}px;padding-bottom:${headerPad.bottom}px;`
	: undefined;
// ОДНОрядная раскладка с логотипом по центру раскладывается гридом
// [1fr auto 1fr]; позиционированной строка не становится ни в одном положении —
// иначе она перехватывает края у плашки «Расширенного» меню (см. desktopLogoCls).
const singleRowCentered = !isTwoRow && !logoLeft;
const desktopWrapCls = isTwoRow
	? (headerPad
		? "vanilla-pad mx-auto hidden w-full max-w-[1560px] flex-col md:flex min-[1920px]:max-w-[1920px] min-[1920px]:px-[300px]"
		: "vanilla-pad mx-auto hidden w-full max-w-[1560px] flex-col py-5 md:flex min-[1920px]:max-w-[1920px] min-[1920px]:px-[300px]")
	: singleRowCentered
		? (headerPad
			? "vanilla-pad mx-auto hidden w-full max-w-[1560px] grid-cols-[1fr_auto_1fr] items-center md:grid min-[1920px]:max-w-[1920px] min-[1920px]:px-[300px]"
			: "vanilla-pad mx-auto hidden h-20 w-full max-w-[1560px] grid-cols-[1fr_auto_1fr] items-center md:grid min-[1920px]:max-w-[1920px] min-[1920px]:px-[300px]")
		: (headerPad
			? "vanilla-pad mx-auto hidden w-full max-w-[1560px] items-center justify-between md:flex min-[1920px]:max-w-[1920px] min-[1920px]:px-[300px]"
			: "vanilla-pad mx-auto hidden h-20 w-full max-w-[1560px] items-center justify-between md:flex min-[1920px]:max-w-[1920px] min-[1920px]:px-[300px]");

// Канон menuType: 'dropdown' (по умолчанию) / 'mega-menu' (Расширенное) / 'sidebar' (Боковое).
// Для mega-menu добавляем uppercase + tracking к десктопным ссылкам нав-меню.
// Для sidebar — десктопный inline-nav скрыт, показывается hamburger → правая шторка.
const menuType = typeof p.menuType === "string" ? p.menuType : "dropdown";
const isMegaMenu = menuType === "mega-menu";
const isSidebar = menuType === "sidebar";
const megaLinkCls = isMegaMenu ? "tracking-[0.06em] font-medium" : "";
// Класс десктоп-ссылки nav и подчёркивание активного пункта — вынесены из трёх
// одинаковых мест разметки, чтобы пункт с подменю и без него рисовались одним и
// тем же NavItem и выглядели одинаково.
const navLinkCls = [
	"relative pb-1 font-vanilla-arsenal text-[length:var(--size-nav-link,16px)] font-normal leading-none tracking-normal text-[rgb(var(--color-text,255_255_255))] transition-all duration-200 hover:opacity-70",
	megaLinkCls,
]
	.filter(Boolean)
	.join(" ");
const navUnderlineCls =
	"after:pointer-events-none after:absolute after:bottom-0 after:left-0 after:h-px after:w-full after:bg-[rgb(var(--color-text,255_255_255))] after:content-['']";

// Канон menuColorScheme: опциональная отдельная цветовая схема для десктопного <nav>.
// При задании — добавляем класс color-scheme-<X> к обёртке <nav>.
// Схему платформа отдаёт строкой ("scheme-1") ИЛИ числом (1): нормализатор
// `page-blocks` приводит к числу только `colorScheme`, а `menuColorScheme`
// доезжает как есть. Проверка «только строка» молча не срабатывала на числе —
// и один и тот же магазин получал <nav> со схемой на внутренних страницах и без
// неё на главной (замер flux 2026-09-13). Канон взят из satin (Header.astro:103).
const _menuSchemeStr = (v: unknown): string =>
	typeof v === "number" ? String(v) : typeof v === "string" ? v : "";
const menuColorScheme = _menuSchemeStr(p.menuColorScheme);
const menuSchemeClass = menuColorScheme ? `color-scheme-${menuColorScheme.replace("scheme-", "")}` : "";

// Поиск по магазину ведёт в КАТАЛОГ, а не на демо-страницу темы.
// Вёрстка верстальщиков искала внутри своей категории (/catalog/textile),
// но у настоящего магазина таких страниц нет: запрос уходил мимо каталога,
// и поиск не фильтровал ничего (баг тестера, перепроверено 20.09).
// Каталог умеет ?q= — см. порты Catalog и /api/store/products.
const catalogSearchAction = "/catalog";

// Магазин для живого поиска: build.service патчит `const shopId = ""` → siteId на
// публикации (patchShopIdInDist), ровно как у подвала и корзины темы.
const shopId = "";

const isActive = (link: NavLink) => (link.match ? link.match(Astro.url) : Astro.url.pathname === link.href);
---

<div
	class={rootCls}
	data-vanilla-header
	data-puck-component-id={id}
	data-vanilla-sticky={stickiness === "scroll-up" ? "scroll-up" : undefined}
	style={stickyStyle}
>
	{
		/* Встроенная полоса объявления — ТОЛЬКО статик-режим (без props.id):
		   в канон-композиции полоса = отдельная секция PromoBanner, иначе дубль. */
		!id && (
			<a
				href="/catalog/textile"
				data-vanilla-announcement
				class="m-0 flex h-11 w-full shrink-0 items-center justify-center border-0 bg-[var(--vanilla-announcement-bg)] px-4 text-center font-vanilla-arsenal text-[14px] font-normal uppercase leading-none tracking-normal text-white md:h-12 md:text-base"
			>
				<span class="min-w-0 shrink">Бесплатная доставка на весь ассортимент</span>
			</a>
		)
	}

	<header class="relative m-0 shrink-0 border-0 w-full overflow-visible bg-[rgb(var(--color-bg,58_69_48))] pb-[3px] -mb-[3px] text-[rgb(var(--color-text,255_255_255))]" data-nt="vanilla-header">
		<div class="relative z-[60] flex h-14 items-center justify-between px-4 md:hidden">
			<button
				type="button"
				id="vanilla-burger-btn"
				data-burger-toggle
				class="flex size-9 items-center justify-center transition-opacity hover:opacity-70"
				aria-label="Меню"
				aria-expanded="false"
				aria-controls="vanilla-burger"
			>
				<span class="burger-icon" data-icon="open">
					<SchemeIcon svgs={VANILLA_ICON_SVGS} name="menu-burger" sizeClass="size-6" />
				</span>
				<span class="burger-icon hidden" data-icon="close">
					<SchemeIcon svgs={VANILLA_ICON_SVGS} name="menu-close" sizeClass="size-6" />
				</span>
			</button>
			<a href="/" class={`flex shrink-0 items-center ${logoInkCls}`} aria-label={siteTitle}>
				{logo ? <img src={logo} alt={siteTitle} class={logoImgMobileCls} /> : designParity ? <VanilaLogoDesigners class={VANILA_LOGO_MOBILE_CLS} /> : <VanilaLogo class={VANILA_LOGO_MOBILE_CLS} />}
			</a>
			<div class="flex items-center gap-3">
				<button
					type="button"
					data-action="toggle-search"
					class="flex size-6 items-center justify-center"
					aria-label="Поиск"
					aria-expanded="false"
					aria-controls="vanilla-search-panel"
				>
					<SchemeIcon svgs={VANILLA_ICON_SVGS} name="search-sm" sizeClass="size-6" />
				</button>
				<a
					href="/wishlist"
					class="relative flex size-6 items-center justify-center transition-opacity hover:opacity-80"
					aria-label="Избранное"
				>
					<SchemeIcon svgs={VANILLA_ICON_SVGS} name="favourite" sizeClass="size-4" />
					<span
						data-wishlist-count
						data-empty="true"
						class="absolute -right-2 -top-2 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-white px-1 font-manrope text-[10px] font-normal leading-none text-[var(--vanilla-dark)] data-[empty=true]:hidden"
					>0</span>
				</a>
				<a
					href="/cart"
					class="relative flex size-6 items-center justify-center"
					aria-label="Корзина"
				>
					<SchemeIcon svgs={VANILLA_ICON_SVGS} name="cart-sm" sizeClass="size-4" />
					<span
						data-cart-count
						data-empty="true"
						class="absolute -right-2 -top-2 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-white px-1 font-manrope text-[10px] font-normal leading-none text-[var(--vanilla-dark)] data-[empty=true]:hidden"
					>0</span>
				</a>
				<button
					type="button"
					data-login-open
					class="flex size-6 items-center justify-center transition-opacity hover:opacity-80"
					aria-label="Аккаунт"
					aria-haspopup="dialog"
				>
					<SchemeIcon svgs={VANILLA_ICON_SVGS} name="user-sm" sizeClass="size-4" />
				</button>
			</div>
		</div>

		<div class={desktopWrapCls} style={headerPadStyle}>
			{isTwoRow ? (
				/* ── TWO-ROW LAYOUTS: top-left / top-center ── */
				logoPosition === "top-left" ? (
					/* top-left: Row1=[logo LEFT + actions RIGHT], Row2=[nav LEFT] */
					<>
						<div class="flex w-full items-center justify-between">
							<a href="/" class={`flex shrink-0 items-center ${logoInkCls}`} aria-label={siteTitle}>
								{logo ? <img src={logo} alt={siteTitle} class={logoImgDesktopCls} /> : designParity ? <VanilaLogoDesigners class={VANILA_LOGO_DESKTOP_CLS} /> : <VanilaLogo class={VANILA_LOGO_DESKTOP_CLS} />}
							</a>
							<div class="flex items-center gap-5">
								<button
									type="button"
									data-action="toggle-search"
									class="flex size-8 items-center justify-center transition-opacity hover:opacity-80"
									aria-label="Поиск"
									aria-expanded="false"
									aria-controls="vanilla-search-panel"
								>
									<SchemeIcon svgs={VANILLA_ICON_SVGS} name="search-lg" sizeClass="size-6" />
								</button>
								<a
									href="/wishlist"
									class="relative flex size-8 items-center justify-center transition-opacity hover:opacity-80"
									aria-label="Избранное"
								>
									<SchemeIcon svgs={VANILLA_ICON_SVGS} name="favourite" sizeClass="size-6" />
									<span
										data-wishlist-count
										data-empty="true"
										class="absolute -right-1 -top-1 inline-flex h-5 min-w-[20px] items-center justify-center rounded-full bg-white px-1.5 font-manrope text-[10px] font-bold leading-none text-[var(--vanilla-dark)] data-[empty=true]:hidden"
									>0</span>
								</a>
								<a
									href="/cart"
									class="relative flex size-8 items-center justify-center transition-opacity hover:opacity-80"
									aria-label="Корзина"
								>
									<SchemeIcon svgs={VANILLA_ICON_SVGS} name="cart" sizeClass="size-6" />
									<span
										data-cart-count
										data-empty="true"
										class="absolute -right-1 -top-1 inline-flex h-5 min-w-[20px] items-center justify-center rounded-full bg-white px-1.5 font-manrope text-[10px] font-bold leading-none text-[var(--vanilla-dark)] data-[empty=true]:hidden"
									>0</span>
								</a>
								<button
									type="button"
									data-login-open
									class="flex size-8 items-center justify-center transition-opacity hover:opacity-80"
									aria-label="Аккаунт"
									aria-haspopup="dialog"
								>
									<SchemeIcon svgs={VANILLA_ICON_SVGS} name="user" sizeClass="size-6" />
								</button>
								{isSidebar && (
									<button
										type="button"
										data-burger-toggle
										class="flex size-6 items-center justify-center transition-opacity hover:opacity-80"
										aria-label="Меню"
										aria-expanded="false"
										aria-controls="vanilla-burger"
									>
										<span class="burger-icon" data-icon="open">
											<SchemeIcon svgs={VANILLA_ICON_SVGS} name="menu-burger" sizeClass="size-5" />
										</span>
										<span class="burger-icon hidden" data-icon="close">
											<SchemeIcon svgs={VANILLA_ICON_SVGS} name="menu-close" sizeClass="size-5" />
										</span>
									</button>
								)}
							</div>
						</div>
						<nav
							class:list={["mt-3 flex w-full items-center justify-start gap-[40px]", menuSchemeClass, isSidebar && "md:!hidden"]}
							data-nav-inline
							aria-label="Основная навигация"
							data-puck-subsection-parent={id}
							data-puck-subsection-index="997"
							data-puck-subsection-field="navigationLinks"
						>
							{nav.map((link) => (
								<NavItem
