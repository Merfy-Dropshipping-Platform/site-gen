{
  "sdk": 1,
  "name": "catalog",
  "kind": "section",
  "title": "Каталог",
  "uses": ["theme", "favorites"],
  "themeSettings": ["wishlist-enabled"],
  "settings": [
    { "id": "collection", "label": "Выбор коллекции", "setting": { "kind": "collection" } },
    { "id": "per-page", "label": "Карточки", "setting": { "kind": "range", "default": 12, "min": 2, "max": 24, "step": 1 } },
    { "id": "columns", "label": "Колонки", "setting": { "kind": "range", "default": 3, "min": 1, "max": 6, "step": 1 } },
    {
      "id": "columns-mobile",
      "label": "Колонки на телефоне",
      "setting": {
        "kind": "radio",
        "default": "2",
        "options": [
          { "value": "1", "label": "Одна" },
          { "value": "2", "label": "Две" }
        ]
      }
    },
    {
      "id": "paging",
      "label": "Как листать",
      "setting": {
        "kind": "select",
        "default": "more",
        "options": [
          { "value": "pages", "label": "Номера страниц" },
          { "value": "more", "label": "Показать ещё" },
          { "value": "scroll", "label": "Бесконечная прокрутка" }
        ]
      }
    },
    { "id": "heading", "label": "Заголовок", "section": "Содержание", "setting": { "kind": "string", "default": "Каталог", "ai": "title" } },
    {
      "id": "button-style",
      "label": "Стиль кнопки",
      "section": "Карточка товара",
      "setting": {
        "kind": "select",
        "default": "primary",
        "options": [
          { "value": "primary", "label": "Основная" },
          { "value": "secondary", "label": "Дополнительная" },
          { "value": "link", "label": "Ссылка" }
        ]
      }
    },
    {
      "id": "aspect-ratio",
      "label": "Вид изображения",
      "setting": {
        "kind": "select",
        "default": "square",
        "options": [
          { "value": "portrait", "label": "Портрет" },
          { "value": "square", "label": "Квадрат" },
          { "value": "landscape", "label": "Широкий" },
          { "value": "auto", "label": "Авто" }
        ]
      }
    },
    {
      "id": "image-fit",
      "label": "Подгонка фото",
      "setting": {
        "kind": "select",
        "default": "cover",
        "options": [
          { "value": "cover", "label": "Заполнить рамку" },
          { "value": "contain", "label": "Целиком" }
        ]
      }
    },
    {
      "id": "next-photo",
      "label": "Следующее фото при наведении",
      "setting": { "kind": "toggle", "default": false, "labels": { "on": "Вкл", "off": "Выкл" } }
    },
    {
      "id": "quick-add",
      "label": "Быстрое добавление",
      "setting": {
        "kind": "select",
        "default": "standard",
        "options": [
          { "value": "none", "label": "Нет" },
          { "value": "standard", "label": "Стандарт" },
          { "value": "count", "label": "Количество" },
          { "value": "hover", "label": "На фото при наведении" },
          { "value": "button", "label": "Плюс на фото" }
        ]
      }
    },
    {
      "id": "swatches",
      "label": "Образцы цветов",
      "setting": {
        "kind": "select",
        "default": "square",
        "options": [
          { "value": "none", "label": "Нет" },
          { "value": "square", "label": "Квадраты" },
          { "value": "circle", "label": "Кружки" }
        ]
      }
    },
    {
      "id": "caption-case",
      "label": "Регистр подписи",
      "setting": {
        "kind": "select",
        "default": "normal",
        "options": [
          { "value": "normal", "label": "Как набрано" },
          { "value": "uppercase", "label": "Заглавные" }
        ]
      }
    },
    {
      "id": "favorite",
      "label": "Избранное",
      "setting": { "kind": "toggle", "default": true, "labels": { "on": "Показать", "off": "Скрыть" } }
    }
  ],
  "blocks": {
    "subheading": {
      "title": "Подзаголовок",
      "limit": 1,
      "settings": [{ "id": "heading", "label": "Подзаголовок", "setting": { "kind": "string", "default": "", "ai": "description" } }]
    },
    "filters": {
      "title": "Фильтры",
      "limit": 1,
      "settings": [
        {
          "id": "filter-position",
          "label": "Вид фильтра",
          "setting": {
            "kind": "radio",
            "default": "side",
            "options": [
              { "value": "top", "label": "Сверху" },
              { "value": "side", "label": "Сбоку" }
            ]
          }
        }
      ]
    },
    "sort": { "title": "Сортировка", "addTitle": "сортировку", "limit": 1, "settings": [] }
  },
  "defaultBlocks": [
    { "type": "filters", "settings": {} },
    { "type": "sort", "settings": {} }
  ]
}
