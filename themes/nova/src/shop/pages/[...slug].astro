---
// Своя страница магазина (блок 1 «Секций и SDK», часть 4) и страница записи (блок 8, часть 8б): /o-nas,
// /product/<адрес>, /blogs/<блог>/<статья> и другие адреса из сборщика. Адрес страницы считает сборщик — это
// канонический адрес в head; другой адрес — 404: у темы такой страницы нет (page-unknown). Кириллица в каноническом
// адресе закодирована, поэтому адреса сравниваются раскодированными.
import ShopPage from "../ShopPage.astro";

const page = Astro.locals.merfy;
if (page === undefined) throw new Error("Страницу магазина рендерит только сборщик: нет Astro.locals.merfy");
const samePath = (left: string, right: string): boolean => decodeURI(left) === decodeURI(right);
if (!samePath(new URL(page.head.canonical).pathname, `/${Astro.params.slug ?? ""}`)) {
	return new Response(null, { status: 404 });
}
---

<ShopPage />
