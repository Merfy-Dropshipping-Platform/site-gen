---
const { settings, blocks } = Astro.props;
---
<div class="mx-auto flex max-w-page flex-col items-center gap-4 px-4 text-center font-body">
  {blocks.map((block) => (
    <div class="flex flex-col items-center">
      {block.type === 'heading' && <h2 class:list={['m-0 font-heading weight-heading text-heading', { 'text-3xl': settings['heading-size'] === 'medium', 'text-5xl': settings['heading-size'] === 'large' }]}>{block.settings.heading}</h2>}
      {block.type === 'text' && <p class="m-0 text-lg text-foreground">{block.settings.text}</p>}
      {block.type === 'button' && <a class="rounded-button bg-primary px-4 py-2 text-primary-foreground no-underline" href={block.settings.link}>{block.settings.label}</a>}
    </div>
  ))}
</div>
