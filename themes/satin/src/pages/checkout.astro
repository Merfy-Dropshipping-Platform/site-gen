---
// Checkout page (satin theme, Live Per-Theme Checkout).
//
// Composes the SHARED theme-base mega-blocks CheckoutForm + CheckoutSummary.
// Those blocks carry ALL live logic via inline scripts (DaData autocomplete in
// CheckoutDeliveryForm, СДЭК delivery in CheckoutDeliveryMethod, YooKassa in
// CheckoutPayment, submit-chain in CheckoutSubmit). They are token-driven, so
// they inherit satin's colors. NO checkout-JS is rewritten here.
//
// Import mechanism: DIRECT relative import from packages/theme-base/blocks/.
// The block tree is fully self-contained (only sibling .astro + .classes value
// imports + type-only .puckConfig imports), so a relative path resolves the
// whole tree. astro.config.mjs adds vite.server.fs.allow = [workspaceRoot] so
// Vite can read files outside the themes/satin project root.
//
// Plumbing: the block inline-scripts need window.cartStore + window.__MERFY_CONFIG__
// (+ optional window.__DADATA_TOKEN__). themes/satin's native NtCart system does
// NOT expose window.cartStore, so we load the templates' cart-api.js + cart-store.js
// (copied into public/scripts/) and inject config on this page only — keeping the
// rest of the satin theme on its native cart.
import Layout from "../layouts/Layout.astro";
import CheckoutForm from "../../../../packages/theme-base/blocks/CheckoutForm/CheckoutForm.astro";
import CheckoutSummary from "../../../../packages/theme-base/blocks/CheckoutSummary/CheckoutSummary.astro";
import { SITE_TITLE } from "../consts";
import CheckoutSplit from "../../../../packages/theme-base/blocks/CheckoutLayout/CheckoutSplit.astro";
import CheckoutHeader from "../../../../packages/theme-base/blocks/CheckoutHeader/CheckoutHeader.astro";

// Pilot defaults. In production build.service.ts string-patches shopId and
// injects DADATA_API_KEY; here we hardcode the apiUrl and leave shopId/dadataToken
// to be patched at build/deploy time (the injection script below reads them).
const shopId = "";
const apiUrl = import.meta.env.PUBLIC_MERFY_API_URL ?? "https://gateway.merfy.ru/api";
const dadataToken = "";
---
<Layout title="Оформление заказа" description="Оформление заказа" header="checkout">
  {/* Figma 1:13398 — checkout is always the light scheme regardless of theme default. */}
  <div class="color-scheme-2">
    <main class="flex-1 w-full" style="background: rgb(var(--color-bg)); color: rgb(var(--color-text));">
      {/* Эталон владельца (п.4, третий круг): схема красит КОЛОНКУ целиком —
          сплошной цвет до низа окна и до правого края, текст из той же схемы.
          Центрированная сетка `max-w-[1280px]` это не умела: колонка сводки
          обрывалась на 1079px из 1280 и справа оставалась полоса фона страницы
          (замер прода 2026-09-13). Разметка и стили — общие с остальными
          темами и с превью (packages/theme-base/.../CheckoutSplit.astro). */}
      <CheckoutSplit>
        {/* Шапка — ОТДЕЛЬНАЯ полоса над обеими колонками (владелец, 14.09,
            п.3: «отделить от левой и правой части и придать свои размеры»).
            Пропсы те же, что раньше отдавал Layout: сборка витрины всё равно
            подменяет эту шапку мерчантской по регулярке
            `<header data-checkout-slot="header">`
            (chrome-assembler.injectChromeIntoHtml), а регулярке безразлично,
            в каком месте документа она лежит. */}
        <CheckoutHeader
          slot="header"
          siteTitle={SITE_TITLE}
          logoMode="text"
          logoImage={null}
          rightIcon="cart"
          accountLink="/account"
          backLink="/cart"
          cartLink="/cart"
          padding={{ top: 24, bottom: 24 }}
        />
        <CheckoutForm slot="form" />
        <CheckoutSummary slot="summary" />
      </CheckoutSplit>
    </main>
  </div>

  {/* Баг-репорт 17: «Правая часть чекаута статична. Ожидаемый: прокручивается
      вместе с левой при скролле». Сводка стояла в самом верху растянутой
      колонки: первый же оборот колеса уводил её за кромку, и правая половина
      экрана превращалась в пустое неподвижное полотно — покупатель заполняет
      форму и не видит, за что платит. Теперь сводка едет вместе с ним.

      `align-self: start` обязателен: в grid/flex колонка по умолчанию
      растянута на всю высоту строки, и `sticky` внутри неё «прилипать» негде.
      Баг-репорт 18-Б (доработка): «Правая часть чекаута не до конца скролится.
      Ожидаемый: прокручивается вместе с левой, позиции видны даже в самом
      низу». Страховкой стоял `max-height` + свой скролл — он и РЕЗАЛ колонку:
      на 30 позициях за кромкой оставалось +2420…+2548px, прокрутка страницы до
      них не доставала (замер 2026-09-13: видно 9-10 из 30 у всех пяти тем), а
      собственную полосу прокрутки внутри колонки покупатель не ищет. Теперь
      колонку не режем: сводка ниже экрана липнет НИЗОМ (отрицательный
      `--checkout-summary-top`) и едет со страницей до последней позиции;
      помещающаяся в экран ведёт себя как прежде (24px). Высоту меряет общий
      инлайн-скрипт блока «Сводка заказа» (packages/theme-base/blocks/
      CheckoutSummary) — один на пять тем и на превью.

      До 1024px колонки идут одна под другой — там липкость не нужна и вредна.
      Зеркало: `preview.service.ts → wrapCheckoutGrid` (правки дублировать). */}
  {/* Липкость сводки переехала в общий CheckoutSplit — одна копия на пять тем
      и на превью (была шестью, и три темы отставали). */}

  {/* --- Live checkout plumbing (checkout page only) --- */}
  {/* Config injection (templates pattern). build.service.ts patches shopId +
      DADATA_API_KEY at deploy; for the local pilot the script just has to exist. */}
  <script is:inline define:vars={{ shopId, apiUrl, dadataToken }}>
    // НЕ клоббер: превью (preview.controller.injectPreviewGlobals) может выставить
    // window.__MERFY_CONFIG__.checkout ДО этого скрипта. Создаём объект при
    // отсутствии и лишь дозаполняем shopId/apiUrl, сохраняя .checkout.
    window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || {};
    if (!window.__MERFY_CONFIG__.shopId) window.__MERFY_CONFIG__.shopId = shopId || "";
    if (!window.__MERFY_CONFIG__.apiUrl)
      window.__MERFY_CONFIG__.apiUrl = apiUrl || "https://gateway.merfy.ru/api";
    if (dadataToken) {
      window.__DADATA_TOKEN__ = dadataToken;
    }
  </script>
  {/* Рантайм-канал настроек чекаута (Фаза 4a): без ребилда тянем per-store
      настройки формы из gateway и публикуем на window.__MERFY_CONFIG__.checkout
      + событие `checkout:config-ready`. Отказоустойчиво: любой сбой / пустой
      shopId → дефолты (полная форма), событие ВСЁ РАВНО диспатчится (консюмеры
      формы разблокируются). Превью проставляет .checkout сервер-сайд → fetch
      пропускается. is:inline обязателен (как у соседних checkout-скриптов).
      No-flash: настройки тянутся в рантайме, поэтому не-дефолтные магазины на миг
      видят дефолт-форму до `checkout:config-ready`. Принято намеренно; в будущем
      можно повесить лоадер / придержать конфиг-зависимые поля скрытыми до
      события, чтобы убрать мигание (Фаза 4a, no-flash вариант B). */}
  <script is:inline>
    (function () {
      var cfg = (window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || {});
      function fire() {
        try {
          document.dispatchEvent(new CustomEvent("checkout:config-ready"));
        } catch (e) {}
      }
      function apply(s) {
        s = s || {};
        cfg.checkout = {
          contactMethod: s.contactMethod === "email" ? "email" : "email-phone",
          customerNameMode:
            s.customerNameMode === "surname" || s.customerNameMode === "name"
              ? s.customerNameMode
              : "name-surname",
          addressRequired: s.addressRequired === false ? false : true,
          // Блок 1 «Обязательная регистрация»: гость не может оформить заказ, пока
          // не вошёл. Fail-open — фиксируем true ТОЛЬКО при явном флаге; любой сбой
          // fetch / пустой shopId → apply(null) → false → без гейта (гость у
          // магазинов без флага не ломается). Настоящий барьер — серверный гейт
          // в orders (403); клиентский разворот ниже — только UX.
          requireCustomerAuth: s.requireCustomerAuth === true,
        };
        // Gate A (клиентский, ТОЛЬКО live-вкладка): токен-less покупатель на
        // магазине с requireCustomerAuth разворачивается на /login ДО события
        // checkout:config-ready. Значит блоки чекаута не разблокируются и submit
        // не активируется — «держим submit заблокированным до config-ready».
        // Токен читаем из localStorage напрямую: auth-глобал темы на /checkout
        // НЕ инициализирован (persistentAtom кодирует null как '' → пусто = гость).
        // window.self===window.top исключает превью конструктора: iframe не
        // навигируем (там cfg.checkout уже проставлен сервером → ранний выход выше).
        if (window.self === window.top && cfg.checkout.requireCustomerAuth) {
          var token = null;
          try {
            token = localStorage.getItem("merfy_customer_token");
          } catch (e) {}
          if (!token) {
            location.href = "/login?redirect=" + encodeURIComponent("/checkout");
            return;
          }
        }
        fire();
      }
      // Превью уже проставило cfg.checkout сервер-сайд — чтим его, без fetch.
      if (cfg.checkout) {
        fire();
        return;
      }
      var shopId = cfg.shopId;
      var apiUrl = cfg.apiUrl || "https://gateway.merfy.ru/api";
      if (!shopId) {
        apply(null);
        return;
      }
      try {
        fetch(apiUrl + "/public/sites/" + encodeURIComponent(shopId) + "/settings", {
          headers: { Accept: "application/json" },
        })
          .then(function (r) {
            return r && r.ok ? r.json() : null;
          })
          .then(function (j) {
            apply(j && j.settings);
          })
          .catch(function () {
            apply(null);
          });
      } catch (e) {
        apply(null);
      }
    })();
  </script>
  {/* `is:inline` is REQUIRED — without it Astro bundles these through Vite, can't
      resolve `/scripts/...` (public dir) and SILENTLY drops the tag, leaving
      window.cartStore undefined → empty checkout. cart-store.js imports cart-api.js,
      so both are loaded as ES modules. */}
  <script is:inline type="module" src="/scripts/cart-api.js"></script>
  <script is:inline type="module" src="/scripts/cart-store.js"></script>
  <script is:inline>
    // Чекаут наполняет серверную корзину (cartStore) из nt-cart (satin:cart:v1) —
    // источника истины того, что в корзине у пользователя. Товар виден при ЛЮБОМ
    // входе: «Купить сейчас»→/checkout, корзина→/checkout, прямой /checkout. Всё в
    // try/catch: при сбое деградирует к cartStore.init() (прежнее поведение).
    document.addEventListener("DOMContentLoaded", function () {
      var cs = window.cartStore;
      if (!cs) return;
      function fallbackInit() { try { if (cs.init) cs.init(); } catch (e) {} }
      var lines = [];
      // Express «Купить сейчас»: товар лежит в sessionStorage (НЕ в URL, НЕ в корзине
      // покупателя). Есть — оформляем ТОЛЬКО его; иначе — корзину (satin:cart:v1).
      var bn = null;
      try { bn = JSON.parse(sessionStorage.getItem("satin:buynow") || "null"); } catch (e) { bn = null; }
      if (bn && bn.productId) {
        lines = [{ productId: bn.productId, variant: { variantCombinationId: bn.variantCombinationId || null }, quantity: bn.quantity || 1 }];
      } else {
        try { lines = JSON.parse(localStorage.getItem("satin:cart:v1") || "[]"); } catch (e) { lines = []; }
      }
      if (!Array.isArray(lines) || !lines.length || !cs.syncLinesToServer) { fallbackInit(); return; }
      (async function () {
        // ОДНО действие вместо цикла. Раньше здесь шёл cs.addItem по каждой
        // позиции, и на каждую прилетал cart:updated: сводка перестраивалась
        // столько раз, сколько товаров (список рос 1→2→3→4→5→6, фотографии
        // перекладывались), а расчёт доставки перезапускался и мигал лоудером.
        // syncLinesToServer собирает серверную корзину целиком и шлёт событие
        // ОДИН раз — в конце.
        try {
          await cs.syncLinesToServer(lines, { notify: true });
        } catch (e) { fallbackInit(); return; }
      })();
    });
  </script>
</Layout>
