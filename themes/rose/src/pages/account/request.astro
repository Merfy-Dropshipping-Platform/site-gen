---
// «Мои заявки» (спека 118, T014). По образцу account/order.astro этой темы:
// тот же Layout и классы кабинета (account-*), логика — общая в
// packages/theme-base/runtime/requests-mine.ts. Вход — ссылка из письма
// (?token=<mineToken> → localStorage merfy_requests_token, из URL убирается);
// без токена — пустое состояние, БЕЗ редиректа на логин.
import Layout from '../../layouts/Layout.astro';

const shopId = "";
const apiUrl = import.meta.env.PUBLIC_MERFY_API_URL ?? "https://gateway.merfy.ru/api";
---
<Layout title="Заявка" promo={false}>
  <script is:inline define:vars={{ shopId, apiUrl }}>
    window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || {
      shopId: shopId || "",
      apiUrl: apiUrl || "https://gateway.merfy.ru/api",
    };
  </script>

  <div class="account-page-container">
    <a href="/account/requests" class="account-back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Вернуться назад
    </a>

    <div class="account-title">
      <h1>Заявка</h1>
      <span class="account-subtitle" id="request-subtitle"></span>
    </div>

    <div id="request-loading" style="color: rgb(var(--color-muted, 153 153 153)); font-family: var(--font-body);">Загрузка...</div>
    <div id="request-not-found" class="hidden" style="font-family: var(--font-body); color: rgb(var(--color-muted, 153 153 153));">
      Заявка не найдена. <a href="/account/requests" class="account-text-link" style="font-size: 0.875rem;">Вернуться к заявкам</a>
    </div>

    {/* Карточку (что заполнил, фото, предложение, переписка, ответ) рисует
        общая логика requests-mine.ts — разметка на классах темы. */}
    <div id="request-content" class="hidden" style="display: grid; gap: 1.5rem;"></div>
  </div>

  <script>
    import { initRequestsMineDetail } from '../../../../../packages/theme-base/runtime/requests-mine';

    initRequestsMineDetail();
    document.addEventListener('astro:page-load', initRequestsMineDetail);
  </script>
</Layout>
