---
const { settings, blocks } = Astro.props;
---
<!-- Значки стрелок — Lucide (chevron-left, chevron-right), лицензия ISC, lucide.dev/license.
     Номер слайда — полоски data-part="dot": поведение carousel ставит текущей data-active, по нажатию листает к ней. -->
<div class="mx-auto flex max-w-page flex-col gap-6 px-4 font-body text-foreground" data-behavior="carousel" data-effect="fade" data-change="700" data-autoplay={settings.autoplay ? 3 : 0}>
  <div class="flex items-end justify-between gap-4">
    {settings.heading && (
      <h2 class="m-0 font-heading weight-heading tracking-heading text-3xl text-heading" data-animate="appear">{settings.heading}</h2>
    )}
    <div class="ml-auto flex shrink-0 gap-2">
      <button type="button" data-part="prev" aria-label="Предыдущий слайд" class="inline-flex size-11 cursor-pointer items-center justify-center rounded-button border-width-input border-border bg-background p-0 text-foreground hover:bg-accent hover:text-accent-foreground disabled:cursor-default disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <button type="button" data-part="next" aria-label="Следующий слайд" class="inline-flex size-11 cursor-pointer items-center justify-center rounded-button border-width-input border-border bg-background p-0 text-foreground hover:bg-accent hover:text-accent-foreground disabled:cursor-default disabled:opacity-40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
      </button>
    </div>
  </div>
  <div data-part="viewport" class="overflow-hidden rounded-card">
    <div data-part="container" class="flex">
      {blocks.map((block) => (
        <div data-part="slide" class="flex min-h-64 shrink-0 grow-0 basis-full flex-col justify-end bg-muted p-6 md:min-h-96 md:p-12">
          <div data-part="copy" class="flex max-w-xl flex-col gap-3">
            <h3 class="m-0 font-heading weight-heading tracking-heading text-2xl text-heading md:text-4xl">{block.settings.subheading}</h3>
            <p class="m-0 text-base text-muted-foreground md:text-lg">{block.settings.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="flex justify-center gap-2">
    {blocks.map((block, index) => (
      <button type="button" data-part="dot" aria-label={`Слайд ${index + 1}: ${block.settings.subheading}`} class="group flex h-11 w-8 cursor-pointer items-center border-0 bg-transparent p-0">
        <span class="h-1 w-full rounded-full bg-border group-data-[active]:bg-foreground"></span>
      </button>
    ))}
  </div>
</div>
