---
import Layout from "../../layouts/Layout.astro";
import { legalPages, type LegalSlug } from "../../data/legal";

export const getStaticPaths = async () => {
	const { legalPages } = await import("../../data/legal");
	return Object.keys(legalPages).map((slug) => ({
		params: { slug },
		props: { slug },
	}));
};

const { slug } = Astro.props as { slug: LegalSlug };
const page = legalPages[slug];
---

<Layout title={page.title} description={page.title}>
	<section
		class="satin-pad w-full bg-[rgb(var(--color-bg,255_255_255))] pb-[120px] pt-16 md:pb-[160px] md:pt-24"
	>
		<div class="satin-container mx-auto flex w-full max-w-[760px] flex-col gap-8">
			<h1 class="font-logo text-[28px] font-normal uppercase leading-[1.115] text-[rgb(var(--color-heading,0_0_0))] md:text-[32px]">
				{page.title}
			</h1>
			<div class="flex flex-col gap-5 font-manrope text-[16px] font-light leading-[1.6] text-[rgb(var(--color-text,0_0_0))]">
				{page.body.map((para) => <p>{para}</p>)}
			</div>
		</div>
	</section>
</Layout>
