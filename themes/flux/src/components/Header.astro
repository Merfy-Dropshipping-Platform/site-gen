	</div>
	</header>

	<!-- Мобильный бургер / Desktop sidebar drawer -->
	<div
		id="flux-burger"
		class:list={[
			// «Цветовая схема меню» красит и шторку, а не только инлайн-навигацию.
			// Баг 24 документа владельца: «панель бокового меню остаётся белой, цвета
			// выбранной схемы меню к ней не применяются». Замер: menuColorScheme
			// доезжал до <nav>, но на корень шторки класс схемы никто не вешал — во
			// ВСЕХ пяти темах, не только в bloom. Пусто, если схема меню не задана —
			// тогда шторка наследует схему секции, как раньше.
			menuSchemeClass,
			"fixed",
			// Боковая панель лежит ПОВЕРХ шапки страницы. Мобильная строка шапки стоит
			// на z-[60] и рисовалась поверх панели: две шапки одна на другой, крестик и
			// иконки дважды (баги 1 и 3 документа «баги бокового меню», 22.09). Нижней
			// шторке — прежний z-[55]: она открывается ПОД строкой шапки.
			isSidebar ? "z-[70]" : "z-[55]",
			// Полотно шторки — «Фон» СХЕМЫ, а не палитра Tailwind. `bg-white` Tailwind 4
			// печатает как `var(--color-white)`: переменная ЕСТЬ, но её нет ни в одной
			// схеме мерчанта, поэтому шторка замирает белой при любой схеме. Замер
			// (матрица `pnpm scheme-matrix:bad`, схемы-зонды 1 → 4, «Фон» 17,0,0 →
			// 0,17,0): полотно #fff → #fff, пока сама шапка выше уже едет
			// (`bg-[rgb(var(--color-bg,255_255_255))]` на <header>). У bloom это ещё и
			// невидимое меню: на заводской схеме bloom «Фон» розовый, а «Текст» белый —
			// белые пункты лежали на белом полотне. Фолбэк 255_255_255 = прежний вид.
			// Сторож: pnpm test:scheme-targets.
			"hidden overflow-y-auto bg-[rgb(var(--color-bg,255_255_255))]",
			// Боковая панель на телефоне — во весь экран: было 90vw у правого края, и
			// слева полосой просвечивала страница (баг 1). С md — колонка 360px на всю
			// высоту. overscroll-contain: прокрутка панели не утекает на страницу.
			isSidebar
				? "inset-y-0 left-0 right-0 w-full overscroll-contain px-6 pt-6 pb-8 md:left-auto md:w-[360px]"
				: "inset-x-0 top-[80px] bottom-0 w-full px-4 pt-4 pb-8 md:hidden",
		]}
		role="dialog"
		aria-modal="true"
		aria-label="Меню"
		data-header-search
		data-search-layout="drawer"
		data-search-limit="8"
	>
		{isSidebar ? (
			/* Шапка открытой панели: крестик и корзина. На месте логотипа — крестик
			   (пункт 29 документа владельца): логотип рисовался дважды — в панели и в
			   шапке страницы. Избранного здесь нет — остаётся только корзина (баг 4
			   документа «баги бокового меню»). Атрибут data-burger-toggle отдаёт
			   закрытие тому же скрипту темы. */
			<div class="flex items-center justify-between">
				<button
					type="button"
					data-burger-toggle
					data-burger-close
					aria-expanded="true"
					aria-controls="flux-burger"
					aria-label="Закрыть меню"
					class="flex size-10 shrink-0 items-center justify-center transition-opacity hover:opacity-70"
				>
					<SchemeIcon svgs={FLUX_ICON_SVGS} name="menu-close" sizeClass="size-6" />
				</button>
				<div class="flex items-center gap-3">
					{showCart && (
						<button
							type="button"
							data-cart-open
							class="relative flex size-10 shrink-0 items-center justify-center transition-opacity hover:opacity-80"
							aria-label="Корзина"
						>
							<SchemeIcon svgs={FLUX_ICON_SVGS} name="cart" sizeClass="size-6" />
							<span data-cart-count data-empty="true" class={badgeCls}>0</span>
						</button>
					)}
				</div>
			</div>
		) : (
			/* Mobile drawer (эталон): поиск + профиль сверху. Строка поиска — по
			   макету «Бургер» 375: высота 40, только нижняя линия, Roboto Flex 300 14. */
			<div class="flex items-center gap-2">
				{showSearch && (
					<form class="flex h-10 min-h-10 flex-1 items-center justify-between gap-2 border-b border-[rgb(var(--color-heading,0_0_0))]" role="search" action="/catalog" method="get">
						<input
							type="search"
							name="q"
							placeholder="Поиск"
							aria-label="Поиск"
							autocomplete="off"
							class="min-w-0 flex-1 bg-transparent font-roboto-flex text-[14px] font-light leading-4 placeholder:text-[rgb(var(--color-muted,153_153_153))] outline-none"
						/>
						<button type="submit" class="flex h-6 w-6 shrink-0 items-center justify-center" aria-label="Найти">
							<SchemeIcon svgs={FLUX_ICON_SVGS} name="search-sm" sizeClass="size-6" />
						</button>
					</form>
				)}
				{showProfile && (
					/* Заливка — «Кнопка» СХЕМЫ. `bg-black` Tailwind 4 печатает как
					   var(--color-black): переменная есть, схемы в ней нет, поэтому
					   кнопка «Профиль» в шторке замирала чёрной на любой схеме
					   (замер матрицы, схемы-зонды 1 → 4: #000 → #000, при том что
					   полотно шторки теперь едет). Роль та же, что у кнопки слайда
					   flux (fix b19, Slideshow.astro) и у эталона rose. Фолбэк 0_0_0
					   = прежний чёрный. Сторож: pnpm test:scheme-targets. */
					<a
						href="/login" data-auth-link
						class="flex size-11 shrink-0 items-center justify-center rounded-[4px] bg-[rgb(var(--color-button-bg,0_0_0))]"
						aria-label="Профиль"
					>
						<SchemeIcon svgs={FLUX_ICON_SVGS} name="user" sizeClass="size-6" colorClass="text-[rgb(var(--color-button-text,255_255_255))]" />
					</a>
				)}
			</div>
		)}

		{/* Живые результаты поиска шторки: пока они на экране, меню спрятано
		    (`data-search-idle`), как в макете «Бургер» 375 — выдача на месте пунктов. */}
		{!isSidebar && showSearch && (
			<div data-search-results hidden aria-live="polite" class="mt-3.5 aria-busy:opacity-60"></div>
		)}

		<nav class:list={["flex flex-col gap-3", isSidebar ? "mt-6" : "mt-[52px]"]} aria-label="Основное меню" data-nav-drawer data-search-idle>
			{nav.filter((l) => l.href !== "/").map((link) => {
				const active = isActive(link);
				const kids = Array.isArray(link.submenu) ? link.submenu : [];
				return (
					<div class="flex flex-col" data-nav-group={kids.length > 0 ? "" : undefined}>
						{/* Пункт с вложенностью раскрывается ВСЕЙ СТРОКОЙ, и стрелка у него
						    одна — родная стрелка темы «arrow-slide-right» (пункт 28 документа
						    владельца: «две стрелки сразу, а по клику меню закрывается»).
						    Ссылкой такой пункт больше не рисуется: нажатие уводило на
						    страницу и закрывало меню вместо раскрытия. */}
						{kids.length > 0 ? (
							<button
								type="button"
								data-nav-sub-toggle
								aria-expanded="false"
								class:list={[
									"flex h-11 w-full items-center justify-between rounded-[4px] px-3 pr-[10px] text-left font-roboto-flex text-[16px] leading-normal",
									"[&[aria-expanded=true]_img]:rotate-90",
									active
										? "bg-[rgb(var(--color-button-bg,0_0_0))] font-normal text-[rgb(var(--color-button-text,255_255_255))]"
										: "font-light text-[rgb(var(--color-heading,0_0_0))]",
								]}
							>
								<span>{link.label}</span>
								<NtIcon name="arrow-slide-right" sizeClass="size-6" class={active ? "transition-transform invert" : "transition-transform"} />
							</button>
						) : (
						<a
							href={link.href}
							class:list={[
								"flex h-11 items-center justify-between rounded-[4px] px-3 pr-[10px] font-roboto-flex text-[16px] leading-normal",
								// Пункт шторки — те же роли, что у пункта десктопного меню выше
								// (`navActiveCls`): активный/выделенный берёт «Заголовок», а НЕ
								// «Текст», потому что --color-text у flux — вторичный серый
								// #999999. Было `text-black` и `bg-black`+`text-white`: Tailwind 4
								// печатает их как var(--color-black)/var(--color-white) —
								// переменная есть, схемы в ней нет, и пункт замирал (замер
								// матрицы, схемы-зонды 1 → 4: #000 → #000). Активная пилюля
								// переведена той же правкой: она красится на ТОМ ЖЕ элементе, и
								// перекрасить только неактивное состояние значило бы оставить
								// пункт наполовину замершим. Фолбэки = прежние цвета.
								active
									? "bg-[rgb(var(--color-button-bg,0_0_0))] font-normal text-[rgb(var(--color-button-text,255_255_255))]"
									: "font-light text-[rgb(var(--color-heading,0_0_0))]",
							]}
						>
							<span>{link.label}</span>
							{/* В «Боковом» меню стрелка — только у пункта с вложенными: она
							    обещает раскрытие, а обычный пункт уводит на страницу и
							    закрывает меню (баг 6 документа «баги бокового меню»). В нижней
							    шторке стрелка у каждого пункта — это макет «Бургер» flux. */}
							{!isSidebar && <NtIcon name="arrow-slide-right" sizeClass="size-6" class={active ? "invert" : ""} />}
						</a>
						)}
						{/* Подменю в шторке раскрывается нажатием на строку пункта (пункты 25
						    и 28 документа владельца: на телефоне — по нажатию, и нажатие на
						    сам пункт раскрывает уровень, а не закрывает меню). Для «Бокового»
						    типа шторка — единственный путь к вложенным пунктам. */}
						{kids.length > 0 && (
							<div class="ml-3 flex flex-col border-l border-black/10 pl-3" data-nav-sub hidden>
								{kids.map((k) => (
									<a
										href={k.href}
										class="flex h-9 items-center rounded-[4px] px-2 font-roboto-flex text-[14px] font-light leading-normal text-[rgb(var(--color-muted,102_102_102))] transition-colors hover:text-black"
									>
										{k.label}
									</a>
								))}
							</div>
						)}
					</div>
				);
			})}
		</nav>
	</div>

	{/* Вложенные пункты в шторке раскрываются нажатием (пункт 25 документа
	    владельца). Обработчик общий на все пять тем. */}
	<script is:inline set:html={NAV_SUBMENU_TOGGLE_SOURCE} />
	{stickiness === "scroll-up" && <script is:inline set:html={SCROLL_UP_JS} />}
	{/* Магазин для живого поиска шапки: `const shopId = ""` патчит сборка
	    (patchShopIdInDist) — как у подвала и корзины. В превью конструктора id
	    приходит глобалом __MERFY_SITE_ID__, пустая строка здесь ничего не ломает. */}
	<script is:inline define:vars={{ shopId }}>
		window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || { shopId: shopId || "", apiUrl: "https://gateway.merfy.ru/api" };
		if (shopId && !window.__MERFY_CONFIG__.shopId) window.__MERFY_CONFIG__.shopId = shopId;
	</script>
</div>

<script>
	import { focusSearchToggle, initHeaderSearch } from "../../../../packages/theme-base/runtime/header-search";
	import { renderSearchResults, SEARCH_MESSAGE_CLASS } from "../lib/header-search-view";

	// Живой поиск из лупы: панель шапки и шторка бургера (общий модуль на пять тем).
	initHeaderSearch({ render: renderSearchResults, messageClass: SEARCH_MESSAGE_CLASS });

	const setSearchOpen = (open: boolean) => {
		const panel = document.querySelector<HTMLElement>("[data-search-panel]");
		if (!panel) return;
		if (open) {
			panel.removeAttribute("hidden");
			panel.classList.remove("hidden");
			panel.classList.add("block");
			panel.querySelector<HTMLInputElement>("input[type='search']")?.focus();
		} else {
			panel.setAttribute("hidden", "");
			panel.classList.add("hidden");
			panel.classList.remove("block");
		}
	};

	const isSearchPanelOpen = () => {
		const panel = document.querySelector<HTMLElement>("[data-search-panel]");
		return Boolean(panel && !panel.hasAttribute("hidden"));
	};

	const syncBurgerButtonIcons = (open: boolean) => {
		// Update ALL burger toggle buttons (mobile #flux-burger-btn + desktop [data-burger-toggle])
		document.querySelectorAll<HTMLElement>("[data-burger-toggle]").forEach((btn) => {
			btn.setAttribute("aria-expanded", String(open));
			btn.querySelectorAll<HTMLElement>(".burger-icon").forEach((el) => {
				const key = el.dataset.icon;
				if (key === "open") el.classList.toggle("hidden", open);
				else el.classList.toggle("hidden", !open);
			});
		});
	};

	// Мобильная шторка встаёт под ФАКТИЧЕСКИЙ низ шапки. Класс `top-[80px]` —
	// только фолбэк: над шапкой бывает полоса объявления, и тогда верх шторки
	// (строка поиска) уезжал под мобильную строку шапки (замер 375: шапка
	// 48…128, шторка с 80 — 48px поиска закрыты). Так же rose/vanilla/bloom.
	const positionBurger = () => {
		const burger = document.getElementById("flux-burger");
		if (!burger || burger.classList.contains("inset-y-0")) return;
		const header = document.querySelector<HTMLElement>('[data-nt="flux-header"]');
		if (!header) return;
		burger.style.top = `${Math.max(0, Math.round(header.getBoundingClientRect().bottom))}px`;
	};

	const setBurger = (open: boolean) => {
		const burger = document.getElementById("flux-burger");
		if (!burger) return;
		if (open) {
			setSearchOpen(false);
			positionBurger();
		}
		burger.classList.toggle("hidden", !open);
		syncBurgerButtonIcons(open);
		// Страницу под открытым меню запираем на <html>, а не на <body>: пока у
		// <html> overflow «visible», замок <body> доходит до окна, но стоит теме
		// задать `html { overflow-x: clip }` (так у bloom и vanilla) — и страница под
		// панелью уезжает колесом (баг 2 документа «баги бокового меню»), а <body>
		// с overflow:hidden отрывает липкую шапку от окна. Одинаково в пяти темах.
		document.documentElement.style.overflow = open ? "hidden" : "";
	};

	const syncFluxAfterNavigation = () => {
		document.documentElement.style.overflow = "";
		document.body.style.overflow = "";
		setSearchOpen(false);
		const burger = document.getElementById("flux-burger");
		if (burger) burger.classList.add("hidden");
		syncBurgerButtonIcons(false);
	};

	// Гард на WINDOW, а не module-scope: контентные страницы несут две копии этого
	// скрипта (Astro-hoisted и инлайн из renderBlock шапки при сборке хрома), и
	// у каждой свой module-scope. Две привязки = два переключения за клик: панель
	// поиска открывалась и тут же закрывалась (разбор у rose, Header.astro).
	const fluxWin = window as unknown as { __fluxHeaderBound?: boolean };
	const bindFluxDelegatedClicks = () => {
		if (fluxWin.__fluxHeaderBound) return;
		fluxWin.__fluxHeaderBound = true;

		document.addEventListener("click", (event: MouseEvent) => {
			const raw = event.target;
			const el = raw instanceof Element ? raw : null;
			if (!el) return;

			if (el.closest("[data-burger-toggle]")) {
				const burger = document.getElementById("flux-burger");
				if (!burger) return;
				event.preventDefault();
				setBurger(burger.classList.contains("hidden"));
				return;
			}

			if (el.closest("[data-action='toggle-search']")) {
				event.preventDefault();
				setSearchOpen(!isSearchPanelOpen());
				return;
			}

			if (el.closest("#flux-burger a[href]")) {
				setBurger(false);
			}
		});

		// Панель поиска — выпадающая коробка поверх страницы: клик мимо неё закрывает.
		document.addEventListener("click", (event: MouseEvent) => {
			if (!isSearchPanelOpen()) return;
			const target = event.target;
			if (!(target instanceof Node)) return;
			const panel = document.querySelector<HTMLElement>("[data-search-panel]");
			if (panel?.contains(target)) return;
			const tEl = target instanceof Element ? target : null;
			if (tEl?.closest?.("[data-action='toggle-search']")) return;
			setSearchOpen(false);
		});

		// Escape закрывает панель (первый Escape в непустом поле его очищает — модуль поиска).
		document.addEventListener("keydown", (event: KeyboardEvent) => {
			if (event.key !== "Escape" || !isSearchPanelOpen()) return;
			setSearchOpen(false);
			focusSearchToggle();
		});

		window.addEventListener("resize", positionBurger);
	};

	bindFluxDelegatedClicks();
	document.addEventListener("astro:page-load", syncFluxAfterNavigation);
	syncFluxAfterNavigation();
</script>
