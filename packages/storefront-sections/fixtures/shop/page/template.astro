---
const { settings } = Astro.props;
---
<!-- «Страница»: выбрана политика магазина — её название и текст, иначе свои заголовок и текст (правятся прямо в превью).
     Заголовок — h1 страницы; размер — признаком data-heading-size на корне (маленький 20 px, средний 24, большой 32 на
     компьютере, как у Page на проде). Текст — колонкой в ширину строки чтения; блоки текста идут столбцом с отступом. -->
<div class="mx-auto max-w-page px-4 font-body md:px-8" data-heading-size={settings['heading-size']}>
  <div class="flex flex-col gap-4 md:gap-6">
    {settings.policy ? (
      <h1 class="m-0 text-balance font-heading weight-heading tracking-heading text-heading in-data-[heading-size=small]:text-lg in-data-[heading-size=medium]:text-xl in-data-[heading-size=large]:text-2xl">{settings.policy.title}</h1>
    ) : (
      <h1 class="m-0 text-balance font-heading weight-heading tracking-heading text-heading in-data-[heading-size=small]:text-lg in-data-[heading-size=medium]:text-xl in-data-[heading-size=large]:text-2xl">{settings.heading}</h1>
    )}
    {settings.policy ? (
      <div class="flex max-w-2xl flex-col gap-4 text-pretty text-base text-foreground" set:html={settings.policy.html}></div>
    ) : (
      <div class="flex max-w-2xl flex-col gap-4 text-pretty text-base text-foreground" set:html={settings.text}></div>
    )}
  </div>
</div>
