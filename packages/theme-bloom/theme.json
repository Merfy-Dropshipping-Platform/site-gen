{
  "$schema": "https://merfy.ru/schemas/theme-manifest.v2.json",
  "id": "bloom",
  "name": "Bloom",
  "version": "1.0.0",
  "extends": "@merfy/theme-base@workspace:*",
  "category": "beauty",
  "description": "Bloom — soft feminine theme with pink pastel accents (#CF7A8B / #E38E9F), Urbanist headings, pill-shaped buttons for beauty and cosmetics stores.",
  "author": "Merfy",
  "tokens": "./tokens.json",
  "defaults": {
    "--font-heading": "'Urbanist', sans-serif",
    "--font-body": "'Inter', sans-serif",
    "--weight-heading": "400",
    "--weight-body": "400",
    "--container-max-width": "1320px",
    "--radius-button": "100px",
    "--radius-input": "4px",
    "--radius-card": "12px",
    "--radius-media": "12px",
    "--radius-field": "4px",
    "--size-hero-heading": "72px",
    "--size-hero-button-h": "48px",
    "--size-section-heading": "24px",
    "--size-nav-link": "16px",
    "--size-newsletter-form-w": "480px",
    "--size-logo-width": "24px",
    "--size-card-border": "1px",
    "--spacing-section-y": "120px",
    "--spacing-grid-col-gap": "40px",
    "--spacing-grid-row-gap": "40px",
    "--button-style": "solid",
    "--footer-layout": "2-part",
    "--contact-form-layout": "wide",
    "--cart-type": "drawer",
    "--card-style": "standard",
    "--card-alignment": "left",
    "--color-error": "255 148 148",
    "--product-card-padding": "0px"
  },
  "blockDefaults": {
    "PromoBanner": {
      "size": "thin",
      "textTransform": "uppercase",
      "colorScheme": "scheme-1"
    },
    "Header": {
      "siteTitle": "Bloom",
      "logo": null,
      "logoPosition": "top-center",
      "padding": {
        "top": 16,
        "bottom": 16
      },
      "navigationLinks": [
        {
          "label": "Каталог",
          "href": "/catalog"
        },
        {
          "label": "О нас",
          "href": "/about"
        },
        {
          "label": "Доставка",
          "href": "/delivery"
        },
        {
          "label": "Контакты",
          "href": "/contacts"
        }
      ]
    },
    "Hero": {
      "variant": "split-bloom",
      "alignment": "left",
      "size": "large",
      "colorScheme": "scheme-1",
      "overlay": 40,
      "heading": {
        "text": "Изображение"
      },
      "text": {
        "content": "Уходовая косметика, которая дарит здоровье и сияние вашей коже и волосам"
      },
      "position": "bottom-left"
    },
    "Slideshow": {
      "alignment": "left",
      "pagination": "numbers",
      "contentAlign": "left",
      "size": "medium"
    },
    "Collections": {
      "cardCaptionStyle": "uppercase",
      "gridAspect": "1:1",
      "titleAlignment": "left",
      "heading": "Сейчас в тренде"
    },
    "MainText": {
      "buttonStyle": "solid",
      "textStyle": "regular",
      "heading": {
        "text": "Расскажи о своем бренде"
      }
    },
    "Video": {
      "padded": true,
      "align": "container",
      "heading": "Видео",
      "size": "medium"
    },
    "ImageWithText": {
      "imagePosition": "right",
      "ctaPosition": "bottom-pinned",
      "heading": {
        "text": "Изображение с текстом"
      },
      "size": "medium",
      "width": "large"
    },
    "PopularProducts": {
      "cardCaptionStyle": "uppercase",
      "headingAlignment": "left",
      "heading": "Коллекция товаров"
    },
    "Newsletter": {
      "formLayout": "inline-submit",
      "alignment": "left",
      "heading": {
        "text": "Подпишитесь на нашу рассылку"
      },
      "text": {
        "content": "Узнавайте первыми о новых коллекциях и эксклюзивных предложениях.",
        "size": "medium"
      }
    },
    "Catalog": {
      "filterPosition": "side",
      "showFilter": "true",
      "showSort": "true",
      "columns": 3,
      "cards": 12,
      "gridAspect": "1:1",
      "cardCaptionStyle": "uppercase",
      "padding": {
        "top": 80,
        "bottom": 80
      },
      "productCard": {
        "cardStyle": "auto",
        "quickAdd": "none",
        "nextPhotoMode": "simple"
      }
    },
    "Footer": {
      "variant": "2-part",
      "bottomStrip": {
        "enabled": true,
        "text": "© 2026 Bloom Theme. Powered by Merfy"
      }
    },
    "CollapsibleSection": {
      "heading": "Сворачиваемый раздел"
    },
    "ContactForm": {
      "heading": "Контактная форма"
    },
    "Gallery": {
      "heading": "Галерея"
    },
    "MultiColumns": {
      "heading": "Мультиколонны"
    },
    "MultiRows": {
      "heading": "Мультиряды",
      "size": "medium",
      "width": "large",
      "buttonStyle": "primary"
    },
    "Publications": {
      "heading": "Публикации"
    },
    "CartBody": {
      "colorScheme": "scheme-3"
    },
    "CartSummary": {
      "colorScheme": "scheme-3"
    },
    "CartTotals": {
      "colorScheme": "scheme-3"
    },
    "CartCheckoutButton": {
      "colorScheme": "scheme-3"
    }
  },
  "colorSchemes": [
    {
      "id": "scheme-1",
      "name": "1",
      "tokens": {
        "--color-bg": "207 122 139",
        "--color-surface": "207 122 139",
        "--color-heading": "255 255 255",
        "--color-text": "255 255 255",
        "--color-muted": "245 245 245",
        "--color-primary": "255 255 255",
        "--color-accent": "227 142 159",
        "--color-button-bg": "255 255 255",
        "--color-button-text": "207 122 139",
        "--color-button-border": "227 142 159",
        "--color-button-2-bg": "207 122 139",
        "--color-button-2-text": "255 255 255",
        "--color-button-2-border": "247 162 179"
      }
    },
    {
      "id": "scheme-2",
      "name": "2",
      "tokens": {
        "--color-bg": "227 142 159",
        "--color-surface": "227 142 159",
        "--color-heading": "255 255 255",
        "--color-text": "255 255 255",
        "--color-muted": "245 245 245",
        "--color-primary": "255 255 255",
        "--color-accent": "247 162 179",
        "--color-button-bg": "255 255 255",
        "--color-button-text": "227 142 159",
        "--color-button-border": "247 162 179",
        "--color-button-2-bg": "227 142 159",
        "--color-button-2-text": "255 255 255",
        "--color-button-2-border": "255 181 175"
      }
    },
    {
      "id": "scheme-3",
      "name": "3",
      "tokens": {
        "--color-bg": "255 255 255",
        "--color-surface": "255 255 255",
        "--color-heading": "0 0 0",
        "--color-text": "0 0 0",
        "--color-muted": "153 153 153",
        "--color-primary": "0 0 0",
        "--color-accent": "207 122 139",
        "--color-button-bg": "207 122 139",
        "--color-button-text": "255 255 255",
        "--color-button-border": "207 122 139",
        "--color-button-2-bg": "255 255 255",
        "--color-button-2-text": "0 0 0",
        "--color-button-2-border": "217 217 217"
      }
    },
    {
      "id": "scheme-4",
      "name": "4",
      "tokens": {
        "--color-bg": "247 247 249",
        "--color-surface": "247 247 249",
        "--color-heading": "0 0 0",
        "--color-text": "0 0 0",
        "--color-muted": "153 153 153",
        "--color-primary": "0 0 0",
        "--color-accent": "207 122 139",
        "--color-button-bg": "207 122 139",
        "--color-button-text": "255 255 255",
        "--color-button-border": "207 122 139",
        "--color-button-2-bg": "255 255 255",
        "--color-button-2-text": "0 0 0",
        "--color-button-2-border": "217 217 217"
      }
    }
  ],
  "blocks": {
    "Hero": {
      "variant": "split-bloom"
    },
    "Header": {},
    "Footer": {},
    "PopularProducts": {},
    "Collections": {},
    "Product": {},
    "Newsletter": {},
    "ContactForm": {},
    "Catalog": {}
  },
  "features": {
    "newsletter": true,
    "cart-drawer": true,
    "otp-auth": true,
    "wishlist": false,
    "color-swatches": true,
    "filter-sidebar": true,
    "puckDrivenPages": true
  },
  "fonts": [
    {
      "family": "Urbanist",
      "weights": [
        400,
        500,
        600,
        700
      ],
      "source": "google"
    },
    {
      "family": "Inter",
      "weights": [
        300,
        400,
        500,
        600
      ],
      "source": "google"
    },
    {
      "family": "Roboto",
      "weights": [
        400,
        500
      ],
      "source": "google"
    },
    {
      "family": "Manrope",
      "weights": [
        400,
        500
      ],
      "source": "google"
    }
  ],
  "manifestVersion": "2.0",
  "pages": [
    {
      "id": "home",
      "name": "Главная страница",
      "slug": "/",
      "role": "system",
      "contentFile": "pages/home.json",
      "isHome": true
    },
    {
      "id": "page-about",
      "name": "О нас",
      "slug": "/about",
      "role": "system",
      "contentFile": "pages/about.json"
    },
    {
      "id": "page-delivery",
      "name": "Доставка",
      "slug": "/delivery",
      "role": "system",
      "contentFile": "pages/delivery.json"
    },
    {
      "id": "page-contacts",
      "name": "Контакты",
      "slug": "/contacts",
      "role": "system",
      "contentFile": "pages/contacts.json"
    },
    {
      "id": "page-catalog",
      "name": "Коллекции",
      "slug": "/catalog",
      "role": "system",
      "contentFile": "pages/catalog.json"
    },
    {
      "id": "page-collection",
      "name": "Страница коллекции",
      "slug": "/collections/preview",
      "role": "system",
      "contentFile": "pages/collection.json"
    },
    {
      "id": "page-cart",
      "name": "Корзина",
      "slug": "/cart",
      "role": "system",
      "contentFile": "pages/cart.json"
    },
    {
      "id": "page-product",
      "name": "Товар",
      "slug": "/product",
      "role": "system",
      "contentFile": "pages/product.json"
    },
    {
      "id": "page-checkout",
      "name": "Оформление заказа",
      "slug": "/checkout",
      "role": "system",
      "contentFile": "pages/checkout.json"
    },
    {
      "id": "page-checkout-result",
      "name": "Спасибо за заказ",
      "slug": "/checkout-result",
      "role": "system",
      "contentFile": "pages/checkout-result.json"
    }
  ],
  "blockPlaceholders": {
    "Hero": {
      "heading.text": "Изображение"
    },
    "Gallery": {
      "heading": "Галерея"
    },
    "Collections": {
      "heading": "Сейчас в тренде"
    },
    "CollapsibleSection": {
      "heading": "Сворачиваемый раздел"
    },
    "ContactForm": {
      "heading": "Контактная форма"
    },
    "MultiColumns": {
      "heading": "Мультиколонны"
    },
    "MultiRows": {
      "heading": "Мультиряды"
    },
    "Newsletter": {
      "heading.text": "Подпишитесь на нашу рассылку"
    },
    "Video": {
      "heading": "Видео"
    },
    "PopularProducts": {
      "heading": "Коллекция товаров"
    },
    "Publications": {
      "heading": "Публикации"
    },
    "MainText": {
      "heading.text": "Расскажи о своем бренде"
    },
    "ImageWithText": {
      "heading.text": "Изображение с текстом"
    },
    "Catalog": {
      "categoryTitle": "Каталог",
      "categorySubtitle": "Здесь начинается персональный стиль"
    },
    "Footer": {
      "heading.text": "ПОДПИШИТЕСЬ НА РАССЫЛКУ",
      "text.content": "Подпишитесь на наши акции и новости"
    }
  },
  "panelDefaults": {
    "CollapsibleSection": {
      "padding": {
        "top": 120,
        "bottom": 120
      }
    },
    "Collections": {
      "padding": {
        "top": 120,
        "bottom": 120
      }
    },
    "Gallery": {
      "padding": {
        "top": 120,
        "bottom": 120
      }
    },
    "ImageWithText": {
      "padding": {
        "top": 120,
        "bottom": 120
      }
    },
    "MainText": {
      "padding": {
        "top": 120,
        "bottom": 120
      }
    },
    "MultiColumns": {
      "padding": {
        "top": 120,
        "bottom": 120
      }
    },
    "MultiRows": {
      "padding": {
        "top": 120,
        "bottom": 120
      }
    },
    "Newsletter": {
      "padding": {
        "top": 120,
        "bottom": 120
      }
    },
    "PopularProducts": {
      "padding": {
        "top": 120,
        "bottom": 120
      }
    },
    "Publications": {
      "padding": {
        "top": 120,
        "bottom": 120
      }
    },
    "Video": {
      "padding": {
        "top": 120,
        "bottom": 120
      }
    },
    "ContactForm": {
      "padding": {
        "top": 80,
        "bottom": 80
      }
    }
  }
}
