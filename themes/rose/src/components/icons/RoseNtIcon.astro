---
import type { NtIconName } from "@merfy-dropshipping-platform/design-systems-theme/lib/icon-paths";
import { withBase } from "../../lib/with-base";
import { ROSE_ICON_SVGS } from "./rose-icon-svgs";

interface Props {
	// Имена дизайн-системы ПЛЮС иконки темы, которых в DS нет (social-max —
	// мессенджер MAX, просьба владельца 14.09). DS — внешний npm-пакет, дописать
	// его карту нельзя, а имя файла темы читается тем же правилом (ниже).
	name: NtIconName | (string & {});
	class?: string;
	iconBasePath?: string;
	sizeClass?: string;
	/**
	 * Класс цвета. По умолчанию — текст активной схемы. Переопределяется там, где
	 * иконка лежит НЕ на фоне схемы: на залитой кнопке она обязана брать
	 * `--color-button-text`. Раньше для этого висел фильтр `brightness-0 invert`,
	 * который гасил цвет в чёрный и делал схему бессмысленной.
	 */
	colorClass?: string;
}

const {
	name,
	class: className = "",
	iconBasePath: iconBaseProp,
	sizeClass = "size-[24px]",
	colorClass = "text-[rgb(var(--color-text,0_0_0))]",
} = Astro.props as Props;

// Канон Nikita: иконки следуют цвету текста активной схемы (--color-text), не
// хардкод. Старый NtIcon рендерил <img src="/icons/X.svg"> — <img> нельзя
// перекрасить CSS-цветом (схемы не применялись), а SVG'шки экспортнуты с
// preserveAspectRatio="none" (квадратный контейнер искажал бургер с НЕ-квадратным
// viewBox) и stroke/fill="...black" (всегда чёрный). Решение: инлайн SVG с
// currentColor из ROSE_ICON_SVGS. <img>-fallback для иконок не из карты (footer/др.).
const raw = ROSE_ICON_SVGS[name];
const iconCls = `shrink-0 ${colorClass} ${sizeClass} ${className}`.trim();
const inlined = raw ? raw.replace("<svg ", `<svg class="${iconCls}" aria-hidden="true" `) : null;
// Путь = имя иконки + .svg — ровно правило DS (NT_ICON_FILES: 35 из 35 имён
// отображаются как `<name>.svg`), но без её закрытого перечня, поэтому иконки
// темы (social-max) резолвятся так же, как родные.
const iconBase = (iconBaseProp ?? withBase("/icons")).replace(/\/$/, "");
const fallbackSrc = `${iconBase}/${name}.svg`;
---

{
	inlined ? (
		<Fragment set:html={inlined} />
	) : (
		<img
			src={fallbackSrc}
			alt=""
			class={`shrink-0 object-contain pointer-events-none ${sizeClass} ${className}`}
			width="24"
			height="24"
			aria-hidden="true"
		/>
	)
}
