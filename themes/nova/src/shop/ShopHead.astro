---
// Договор рисовальщика (блок 4, SEO): всё индексируемое пишет сборка в HTML — язык (у <html> страницы), заголовок,
// описание, канонический адрес. Конфиг магазина (блок 3) и CSS токенов с правками мерчанта (блок 1) приходят от
// сборщика готовыми строками и встают одним проходом, без правки готового HTML.
// Описание и ключевые слова мерчант может не заполнить — тогда тега нет совсем, как у Dawn (Shopify): пустой тег —
// ошибка договора.
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import type { ShopPageHead } from "../../../../packages/storefront-build/src/locals";

interface Props {
	head: ShopPageHead;
}

const { head } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Fragment set:html={head.configHtml} />
<title>{head.title}</title>
{head.description && <meta name="description" content={head.description} />}
{head.keywords && <meta name="keywords" content={head.keywords} />}
<link rel="canonical" href={head.canonical} />
<style id="merfy-tokens" is:inline set:html={head.tokensCss}></style>
