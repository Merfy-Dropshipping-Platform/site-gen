exports[`снимки секций — flux Newsletter — снимок разметки 1`] = `"<section class="w-full bg-[rgb(var(--color-bg,255_255_255))] px-4 py-10 md:px-20 md:py-16 2xl:px-80" aria-labelledby="Newsletter-1-title" data-puck-component-id="Newsletter-1" style="padding-top:40px;padding-bottom:40px;"> <div class="mx-auto w-full max-w-[1920px]"> <div class="flex w-full max-w-[652px] flex-col gap-6 mr-auto items-start text-left"> <div class="flex w-full flex-col gap-2"> <h2 id="Newsletter-1-title" class="font-roboto-flex text-[19px] md:text-[23px] font-normal leading-normal text-[rgb(var(--color-heading,0_0_0))]" data-puck-subsection-parent="Newsletter-1" data-puck-subsection-index="100" data-puck-subsection-field="heading"> Подписка </h2> <p class="font-roboto-flex text-[16px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))]" data-puck-subsection-parent="Newsletter-1" data-puck-subsection-index="101" data-puck-subsection-field="text"> Описание </p> </div> <form class="flex w-full flex-col gap-4" data-newsletter-form data-puck-subsection-parent="Newsletter-1" data-puck-subsection-index="997" data-puck-subsection-field="placeholder"> <input type="email" name="email" required placeholder="E-mail" aria-label="Email" class="h-14 w-full rounded-[8px] border border-[#FA5109] bg-[rgb(var(--color-bg,255_255_255))] px-4 font-roboto-flex text-[16px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))] placeholder:text-[#cccccc] outline-none md:h-16"> <button type="submit" class="inline-flex h-12 w-auto min-w-[200px] items-center justify-center self-start rounded-[8px] bg-[rgb(var(--color-button-bg,250_81_9))] px-8 font-roboto-flex text-[14px] font-normal leading-normal text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-95 md:text-[16px]"> Отправить </button> </form> <p data-newsletter-status role="status" class="hidden w-full font-roboto-flex text-[12px] font-light text-[#4AD300] md:text-[14px]"></p> </div> </div> </section> <script>(function(){const shopId = ""; const apiUrl = "https://gateway.merfy.ru/api"; // Реальная отправка подписки на gateway. Самодостаточно (не зависит от // скрипта футера): гард __merfyNewsletterWired исключает двойную привязку, // если на странице есть и футер, и эта секция. store_id — из пропатченного // shopId (деплой) либо window.__MERFY_SITE_ID__ (превью конструктора). (function () { window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || { shopId: shopId || "", apiUrl: apiUrl || "https://gateway.merfy.ru/api", }; var cfg = window.__MERFY_CONFIG__; var base = String(cfg.apiUrl || "https://gateway.merfy.ru/api").replace(/\\/+$/, ""); var storeId = cfg.shopId || window.__MERFY_SITE_ID__ || ""; function wire(form) { if (!form || form.__merfyNewsletterWired) return; form.__merfyNewsletterWired = true; var section = form.closest("section") || document; var status = section.querySelector("[data-newsletter-status]"); var btn = form.querySelector('button[type="submit"]'); function show(msg, isError) { if (!status) return; status.textContent = msg; status.style.color = isError ? "#E11D48" : ""; status.classList.remove("hidden"); } form.addEventListener("submit", function (event) { event.preventDefault(); var input = form.querySelector('input[type="email"]'); var email = input ? String(input.value || "").trim() : ""; if (!email) return; if (btn) btn.disabled = true; show("Отправляем…", false); fetch(base + "/storefront/newsletter/subscribe", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ store_id: storeId, email: email }), }) .then(function (res) { return res .json() .catch(function () { return {}; }) .then(function (data) { return { ok: res.ok, code: res.status, data: data }; }); }) .then(function (r) { if (r.ok) { show( r.data && r.data.alreadySubscribed ? "Вы уже подписаны на рассылку." : "Спасибо! Мы отправим вам приветственное письмо.", false, ); form.reset(); } else if (r.code === 429) { show("Слишком много попыток. Попробуйте позже.", true); } else { show("Не удалось подписаться. Попробуйте позже.", true); } }) .catch(function () { show("Не удалось подписаться. Проверьте соединение.", true); }) .finally(function () { if (btn) btn.disabled = false; }); }); } function init() { var forms = document.querySelectorAll("[data-newsletter-form]"); for (var i = 0; i < forms.length; i++) wire(forms[i]); } if (document.readyState === "loading") { document.addEventListener("DOMContentLoaded", init); } else { init(); } })(); })();</script>"`;

