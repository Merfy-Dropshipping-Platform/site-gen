{
  "sdk": 1,
  "name": "collection",
  "kind": "section",
  "title": "Коллекция",
  "uses": ["theme", "favorites"],
  "themeSettings": ["wishlist-enabled"],
  "settings": [
    { "id": "collection", "label": "Выбор коллекции", "setting": { "kind": "collection" } },
    { "id": "columns", "label": "Колонки", "setting": { "kind": "range", "default": 3, "min": 1, "max": 6, "step": 1 } },
    {
      "id": "columns-mobile",
      "label": "Колонки на телефоне",
      "setting": {
        "kind": "radio",
        "default": "2",
        "options": [
          { "value": "1", "label": "Одна" },
          { "value": "2", "label": "Две" }
        ]
      }
    },
    {
      "id": "button-style",
      "label": "Стиль кнопки",
      "section": "Карточка товара",
      "setting": {
        "kind": "select",
        "default": "primary",
        "options": [
          { "value": "primary", "label": "Основная" },
          { "value": "secondary", "label": "Дополнительная" },
          { "value": "link", "label": "Ссылка" }
        ]
      }
    },
    {
      "id": "aspect-ratio",
      "label": "Вид изображения",
      "setting": {
        "kind": "select",
        "default": "square",
        "options": [
          { "value": "portrait", "label": "Портрет" },
          { "value": "square", "label": "Квадрат" },
          { "value": "landscape", "label": "Широкий" },
          { "value": "auto", "label": "Авто" }
        ]
      }
    },
    {
      "id": "image-fit",
      "label": "Подгонка фото",
      "setting": {
        "kind": "select",
        "default": "cover",
        "options": [
          { "value": "cover", "label": "Заполнить рамку" },
          { "value": "contain", "label": "Целиком" }
        ]
      }
    },
    {
      "id": "next-photo",
      "label": "Следующее фото при наведении",
      "setting": { "kind": "toggle", "default": false, "labels": { "on": "Вкл", "off": "Выкл" } }
    },
    {
      "id": "quick-add",
      "label": "Быстрое добавление",
      "setting": {
        "kind": "select",
        "default": "standard",
        "options": [
          { "value": "none", "label": "Нет" },
          { "value": "standard", "label": "Стандарт" },
          { "value": "count", "label": "Количество" },
          { "value": "hover", "label": "На фото при наведении" },
          { "value": "button", "label": "Плюс на фото" }
        ]
      }
    },
    {
      "id": "swatches",
      "label": "Образцы цветов",
      "setting": {
        "kind": "select",
        "default": "square",
        "options": [
          { "value": "none", "label": "Нет" },
          { "value": "square", "label": "Квадраты" },
          { "value": "circle", "label": "Кружки" }
        ]
      }
    },
    {
      "id": "caption-case",
      "label": "Регистр подписи",
      "setting": {
        "kind": "select",
        "default": "normal",
        "options": [
          { "value": "normal", "label": "Как набрано" },
          { "value": "uppercase", "label": "Заглавные" }
        ]
      }
    },
    {
      "id": "favorite",
      "label": "Избранное",
      "setting": { "kind": "toggle", "default": true, "labels": { "on": "Показать", "off": "Скрыть" } }
    }
  ]
}
