{
  "name": "@merfy/storefront-sections",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:workers": "tsx scripts/build-workers.ts",
    "test": "tsx scripts/build-workers.ts && vitest run",
    "test:coverage": "tsx scripts/build-workers.ts && vitest run --coverage",
    "test:stack": "tsx scripts/build-workers.ts && vitest run --coverage --config vitest.stack.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write --no-error-on-unmatched-pattern src __tests__ scripts",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src __tests__ scripts",
    "generate": "tsx scripts/generate.ts",
    "merfy": "tsx scripts/merfy.ts",
    "sections": "tsx scripts/sections.ts"
  },
  "dependencies": {
    "@astrojs/compiler-binding-wasm32-wasi": "0.5.2",
    "@astrojs/compiler-rs": "0.5.2",
    "@merfy/storefront-build": "workspace:*",
    "@merfy/storefront-storage": "workspace:*",
    "@merfy/tokens": "workspace:*",
    "astro": "7.4.0",
    "es-module-lexer": "1.7.0",
    "esbuild": "0.25.12",
    "esbuild-wasm": "0.25.12",
    "jsonc-parser": "3.3.1",
    "pg": "8.16.3",
    "sanitize-html": "2.17.6",
    "tailwindcss": "4.3.2",
    "tsx": "4.21.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.20.1",
    "@types/pg": "8.16.0",
    "@types/sanitize-html": "2.16.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.2",
    "prettier": "3.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0",
    "vitest": "3.2.7"
  }
}
