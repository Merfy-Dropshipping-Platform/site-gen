{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "versions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "lines": {
            "minItems": 1,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "look"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3
                    },
                    "tokens": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                      }
                    },
                    "search": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "kind",
                    "text",
                    "tokens"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "fix"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3
                    },
                    "search": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "shape"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 3
                    },
                    "step": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "search": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "kind",
                    "text",
                    "step"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "version",
          "date",
          "lines"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "versions"
  ],
  "additionalProperties": false
}
