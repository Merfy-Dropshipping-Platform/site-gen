---
import RoseNtIcon from "./icons/RoseNtIcon.astro";
import NavItem from "./NavItem.astro";
import { NAV_SUBMENU_TOGGLE_SOURCE } from "../../../../packages/theme-base/runtime/nav-submenu-toggle";
import { SITE_TITLE } from "../consts";
import { ROSE_RAIL_INNER, ROSE_RAIL_OUTER, ROSE_RAIL_PAD_MOBILE } from "../lib/container";
import { ROSE_HEADER_ACTION_BTN_DESIGNERS, ROSE_HEADER_MOBILE_ROW_DESIGNERS, ROSE_HEADER_SEARCH_BOX_DESIGNERS } from "../lib/design-parity";

interface NavLink {
	label: string;
	href: string;
	submenu?: NavLink[];
	match?: (pathname: string) => boolean;
}

const defaultNav: NavLink[] = [
	{ label: "Главная", href: "/", match: (p) => p === "/" },
	{ label: "Каталог", href: "/catalog", match: (p) => p.startsWith("/catalog") || p.startsWith("/products") },
	{ label: "Контакты", href: "/contacts", match: (p) => p.startsWith("/contacts") },
];

// ОЖИВЛЕНИЕ: канон-схема Header (siteTitle, navigationLinks — Фаза 2;
// logo, logoPosition, stickiness, padding — T12). Дефолтные ветки тернарников =
// прежним строкам классов байт-в-байт; новые элементы не рендерятся без пропсов.
const p = Astro.props as Record<string, any>;
const id = p.id;
// PARITY_DESIGN (владелец 23-24.09: «как у верстальщиков, только стили»):
// иконка мобильного бургера крупнее (Rose-theme @b719c193). Отдельный
// планшетный ярус шапки верстальщиков НЕ переносим — владелец велел его не
// делать. Без признака — прежний размер. Признак ставит sites
// (page-blocks designParityFlag).
const designParity = p.__designParity === true;
const burgerSizeCls = designParity ? "size-6" : "size-5";
// Мобильная строка на планшете (768–1023) — высотой планшетного ряда
// верстальщиков, 56px (py-4 + иконка 24). Раскладка строки прежняя: сам
// планшетный ярус не переносим (решение владельца выше), только высота.
const mobileRowParityCls = designParity ? ` ${ROSE_HEADER_MOBILE_ROW_DESIGNERS}` : "";
// Кнопки-иконки десктопной строки (поиск, избранное, корзина, профиль, бургер
// «Бокового» меню) — 40px, как у верстальщиков (у нас 32): строка шапки
// становится 88px вместо 80. Сами иконки прежние, 24px.
const actionBtnSizeCls = designParity ? ROSE_HEADER_ACTION_BTN_DESIGNERS : "size-8";
// Панель поиска: кнопка «Найти» в 4px от правого края коробки, как у
// верстальщиков (pr-1); у нас было 8 (p-2).
const searchBoxPadCls = designParity ? ROSE_HEADER_SEARCH_BOX_DESIGNERS : "p-2";
// Пустая строка (впрыск коэрсера live-пути) не должна гасить текстовый логотип.
const siteTitle = typeof p.siteTitle === "string" && p.siteTitle.trim() ? p.siteTitle : SITE_TITLE;
// Рекурсивно сохраняем submenu (до 3 уровней) — иначе вложенные меню теряются.
const mapNavLink = (l: any): NavLink => ({
	label: l.label ?? l.text ?? "",
	href: l.href ?? l.link ?? "/",
	submenu: Array.isArray(l.submenu) ? l.submenu.map(mapNavLink) : undefined,
});
const nav: NavLink[] = Array.isArray(p.navigationLinks) && p.navigationLinks.length > 0
	? p.navigationLinks.map(mapNavLink)
	: defaultNav;

// Канон logo (URL картинки; панель «Логотип» пишет в props.logo через
// applyBrandLogoToAllHeaders): непустая строка → <img> вместо текстового
// логотипа в desktop И mobile. Высота = --size-logo-width (семантика канона
// theme-base Header.classes.ts:71 — слайдер «Размер» задаёт ВЫСОТУ лого).
// Дефолтный плейсхолдер «/logo.svg» (и его rewrite до https://<slug>.merfy.ru/logo.svg)
// НЕ существует на сторфронте (404) → не рендерим <img> с битой картинкой. Реальные
// загрузки лежат в /branding/<tenant>/<site>/logo-*.svg (pathname НЕ "/logo.svg"),
// поэтому матчим именно pathname. Иначе — текстовый логотип (siteTitle), как у верстальщика.
const rawLogo = typeof p.logo === "string" ? p.logo.trim() : "";
let logoPath = "";
try {
	logoPath = new URL(rawLogo, "https://_merfy_").pathname;
} catch {
	logoPath = rawLogo;
}
const logo = rawLogo && logoPath !== "/logo.svg" ? rawLogo : undefined;
const logoImgCls = "h-[var(--size-logo-width,24px)] w-auto max-w-[160px] object-contain";

// Канон logoPosition: 'top-left' (canon default) / 'center-left' / отсутствие /
// неизвестное значение → строка верстальщика дословно (лого слева); 'top-center'
// и 'center-absolute' → лого absolute по центру строки (nav остаётся слева).
const logoPosition = typeof p.logoPosition === "string" ? p.logoPosition : "";
const logoCentered = logoPosition === "top-center" || logoPosition === "center-absolute";
// «Слева» (center-left): ОДНОрядно — лого слева, nav по ЦЕНТРУ страницы (равные
// flex-1 фланги logo+иконки → nav auto в центре), иконки справа. Эталон «Слева» (фото №2).
const logoLeft = logoPosition === "center-left";
const desktopLogoCls = logoCentered
	? "absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-comfortaa text-[length:var(--size-logo-width,24px)] font-normal uppercase leading-none tracking-normal text-[rgb(var(--color-heading,0_0_0))] hover:opacity-90"
	: "shrink-0 font-comfortaa text-[length:var(--size-logo-width,24px)] font-normal uppercase leading-none tracking-normal text-[rgb(var(--color-heading,0_0_0))] hover:opacity-90";

// Канон stickiness none/scroll-up/always (классы канона Header.classes.ts:13-16).
// 'none'/отсутствие = как сейчас (корень без sticky-классов).
const stickiness = typeof p.stickiness === "string" ? p.stickiness : "";
const rootCls =
	stickiness === "always"
		? "sticky top-0 z-50 w-full"
		: stickiness === "scroll-up"
			? "sticky top-0 z-50 w-full transition-transform duration-300"
			: "relative z-50 w-full";
// 'scroll-up': прячем хедер при скролле вниз, показываем при скролле вверх.
// is:inline + set:html (компилятор секций не умеет define:vars), параметры не
// нужны — root ищется по data-rose-sticky; идемпотентность через data-hydrated.
const SCROLL_UP_JS = [
	"(function(){",
	"var root=document.querySelector('[data-rose-sticky=\"scroll-up\"]');",
	"if(!root||root.getAttribute('data-hydrated')==='true')return;",
	"root.setAttribute('data-hydrated','true');",
	"var last=window.scrollY;",
	"window.addEventListener('scroll',function(){",
	"var y=window.scrollY;",
	// Режим читается на КАЖДОЙ прокрутке: в конструкторе «Статичность» меняют без
	// перезагрузки превью, и слушатель, повешенный для scroll-up, иначе прятал
	// шапку и после выбора «Всегда» (баг 25.09). Превью переписывает атрибут.
	"if(root.getAttribute('data-rose-sticky')!=='scroll-up'){root.style.transform='';last=y;return;}",
	"if(y>last&&y>root.offsetHeight){root.style.transform='translateY(-100%)';}else{root.style.transform='';}",
	"last=y;",
	"},{passive:true});",
	"})();",
].join("");

// Канон padding {top,bottom} — clamp ≤64 (как theme-base Header.astro:42-43) и
// inline-стиль ТОЛЬКО при заданном пропе на носителе отступов верстальщика
// (desktop-контейнер py-5 lg:py-6; мобильная строка h-11 фиксированная).
const pad = p.padding && typeof p.padding === "object" ? p.padding : undefined;
const headerPad = pad
	? { top: Math.min(Number(pad.top) || 0, 64), bottom: Math.min(Number(pad.bottom) || 0, 64) }
	: undefined;
const headerPadStyle = headerPad
	? `padding-top:${headerPad.top}px;padding-bottom:${headerPad.bottom}px;`
	: undefined;
// Внешний рельс шапки = канон сетки темы (ROSE_RAIL_OUTER: лестница отступов
// + max-w-1920, как у подвала). Вертикальные отступы — прежние.
const desktopRowCls = [
	ROSE_RAIL_OUTER,
	headerPad ? "" : "py-5",
	headerPad ? "" : "lg:py-6",
]
	.filter(Boolean)
	.join(" ");

// Внутренний рельс шапки = ROSE_RAIL_INNER (контент 1320px, центрирован) —
// тот самый второй уровень, которого у шапки не было и из-за которого её края
// на широких экранах не вставали на вертикали секций. `relative` переезжает
// сюда: абсолютно центрируемый логотип должен центрироваться по рельсу
// контента, а не по всей ширине окна (рельс сам центрирован, так что для
// глаза центр тот же).
const desktopRailCls = [
	ROSE_RAIL_INNER,
	"flex items-center justify-between",
	logoCentered ? "relative" : "",
]
	.filter(Boolean)
	.join(" ");
// ОДНОрядная раскладка с логотипом по центру: раньше логотип стоял `absolute`
// внутри позиционированного рельса — и этот же рельс становился якорем для
// плашки «Расширенного» меню. Плашка получалась уже шапки и налезала на строку
// пунктов (замер 1440: лист 1280 из 1440, накрыты ВСЕ пункты верхнего уровня —
// ровно жалоба из пункта 26 документа владельца). Тот же центр даёт грид
// [1fr auto 1fr], и позиционированный предок больше не нужен: якорем плашки
// становится сам <header>.
const singleRowCentered = logoPosition === "center-absolute";
const desktopRailGridCls = [ROSE_RAIL_INNER, "grid grid-cols-[1fr_auto_1fr] items-center"].join(" ");
const desktopCenterLogoCls =
	"col-start-2 shrink-0 justify-self-center font-comfortaa text-[length:var(--size-logo-width,24px)] font-normal uppercase leading-none tracking-normal text-[rgb(var(--color-heading,0_0_0))] hover:opacity-90";

/** Внутренний рельс для двухрядных раскладок (лого/иконки + nav под ними). */
const desktopRailColumnCls = `${ROSE_RAIL_INNER} flex flex-col`;

// Двухрядные раскладки: «Сверху слева» (top-left) и «Сверху в центре» (top-center).
// top-left = лого-слева + иконки-справа (ряд1), nav ПОД лого прижат ВЛЕВО (ряд2,
// justify-start) — эталон дизайнера «Слева сверху» (фото №1). top-center = grid, nav центр.
const isTwoRow = logoPosition === "top-left" || logoPosition === "top-center";

// Канон menuType: 'dropdown' (по умолчанию) / 'mega-menu' (Расширенное) / 'sidebar' (Боковое).
// Для mega-menu добавляем uppercase + tracking к десктопным ссылкам нав-меню.
// Для sidebar — десктопный inline-nav скрыт, показывается hamburger → правая шторка.
const menuType = typeof p.menuType === "string" ? p.menuType : "dropdown";
const isMegaMenu = menuType === "mega-menu";
const isSidebar = menuType === "sidebar";
const megaLinkCls = "";

// Канон menuColorScheme: опциональная отдельная цветовая схема для десктопного <nav>.
// При задании — добавляем класс color-scheme-<X> к обёртке <nav>.
// Схему платформа отдаёт строкой ("scheme-1") ИЛИ числом (1): нормализатор
// `page-blocks` приводит к числу только `colorScheme`, а `menuColorScheme`
// доезжает как есть. Проверка «только строка» молча не срабатывала на числе —
// и один и тот же магазин получал <nav> со схемой на внутренних страницах и без
// неё на главной (замер flux 2026-09-13). Канон взят из satin (Header.astro:103).
const _menuSchemeStr = (v: unknown): string =>
	typeof v === "number" ? String(v) : typeof v === "string" ? v : "";
const menuColorScheme = _menuSchemeStr(p.menuColorScheme);
const menuSchemeClass = menuColorScheme ? `color-scheme-${menuColorScheme.replace("scheme-", "")}` : "";

// Базовый класс десктоп-ссылки nav (общий для всех раскладок). Для mega — uppercase.
const navLinkCls = [
	"font-manrope text-[14px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))] transition-all duration-200 hover:opacity-70 lg:text-[length:var(--size-nav-link,16px)]",
	megaLinkCls,
].filter(Boolean).join(" ");

const pathname = Astro.url.pathname;
const isActive = (link: NavLink) => (link.match ? link.match(pathname) : pathname === link.href);

// Магазин для живого поиска: build.service патчит `const shopId = ""` → siteId на
// публикации (patchShopIdInDist), ровно как у подвала и корзины темы.
const shopId = "";
---

<div class={rootCls} data-puck-component-id={id} data-rose-sticky={stickiness === "scroll-up" ? "scroll-up" : undefined}>
	<div class="overflow-visible bg-[rgb(var(--color-bg,255_255_255))]">
		<header class="relative w-full overflow-visible" data-nt="rose-header">
			<div>
				<!-- Mobile -->
				<div class={`relative z-[60] flex h-11 items-center justify-between ${ROSE_RAIL_PAD_MOBILE} lg:hidden${mobileRowParityCls}`}>
					<button
						type="button"
						id="rose-burger-btn"
						data-burger-toggle
						class={`flex ${burgerSizeCls} shrink-0 items-center justify-center transition-opacity hover:opacity-70`}
						aria-label="Меню"
						aria-expanded="false"
						aria-controls="rose-burger"
					>
						<span class="burger-icon" data-icon="open">
							<RoseNtIcon name="menu-burger" sizeClass={burgerSizeCls} />
						</span>
						<span class="burger-icon hidden" data-icon="close">
							<RoseNtIcon name="menu-close" sizeClass={burgerSizeCls} />
						</span>
					</button>
					<a
						href="/"
						class="font-comfortaa text-[20px] font-normal uppercase leading-none tracking-normal text-[rgb(var(--color-heading,0_0_0))] hover:opacity-80"
					>
						{logo ? <img src={logo} alt={siteTitle} class={logoImgCls} /> : siteTitle}
					</a>
					<div class="flex items-center gap-3">
						<a
							href="/wishlist"
							class="relative flex size-6 shrink-0 items-center justify-center transition-opacity hover:opacity-80"
							aria-label="Избранное"
						>
							<RoseNtIcon name="favourite" sizeClass="size-6" />
							{/* Цифра счётчика — роль схемы «Текст кнопки», а не `text-white`: белым
							   списком матрицы прикрыта только ПЛАШКА (её фирменный цвет —
							   узнаваемый вид темы), а цифра читаема на плашке любого цвета и
							   обязана следовать выбору мерчанта (решение владельца 15.09,
							   сужение исключения `counter-badge`). Фолбэк 255_255_255 —
							   прежний белый, вид без схемы не меняется. Сторож:
							   pnpm test:scheme-matrix. */}
							<span
								data-wishlist-count
								data-empty="true"
								class="absolute -right-2 -top-2 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-[rgb(var(--color-button-bg,0_0_0))] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden"
							>0</span>
						</a>
						<button
							type="button"
							data-cart-open
							class="relative flex size-6 shrink-0 items-center justify-center"
							aria-label="Корзина"
						>
							<RoseNtIcon name="cart-sm" sizeClass="size-6" />
							<span
								data-cart-count
								data-empty="true"
								class="absolute -right-2 -top-2 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-[rgb(var(--color-button-bg,0_0_0))] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden"
							>0</span>
						</button>
					</div>
				</div>

				<!-- Desktop -->
				<div class="hidden w-full lg:block">
					{isTwoRow ? (
						/* ── TWO-ROW LAYOUTS: top-left / top-center ── */
						<div class={desktopRowCls} style={headerPadStyle}>
						<div class={desktopRailColumnCls}>
							{logoPosition === "top-left" ? (
								/* top-left («Сверху слева», фото №1): Row1=[logo LEFT + actions RIGHT], Row2=[nav LEFT, justify-start] */
								<>
									<div class="flex w-full items-center justify-between">
										<div class="flex items-center gap-3 lg:gap-4">
										{isSidebar && (
											<button type="button" data-burger-toggle class={`flex ${actionBtnSizeCls} items-center justify-center transition-opacity hover:opacity-80`} aria-label="Меню" aria-expanded="false" aria-controls="rose-burger">
												<span class="burger-icon" data-icon="open"><RoseNtIcon name="menu-burger" sizeClass="size-6" /></span>
												<span class="burger-icon hidden" data-icon="close"><RoseNtIcon name="menu-close" sizeClass="size-6" /></span>
											</button>
										)}
										<a
											href="/"
											class="shrink-0 font-comfortaa text-[length:var(--size-logo-width,24px)] font-normal uppercase leading-none tracking-normal text-[rgb(var(--color-heading,0_0_0))] hover:opacity-90"
										>
											{logo ? <img src={logo} alt={siteTitle} class={logoImgCls} /> : siteTitle}
										</a>
									</div>
										<div class="flex items-center gap-4 lg:gap-6">
											<button
												type="button"
												data-action="toggle-search"
												class={`flex ${actionBtnSizeCls} items-center justify-center transition-opacity hover:opacity-80`}
												aria-label="Поиск"
												aria-expanded="false"
												aria-controls="rose-search-panel"
											>
												<RoseNtIcon name="search-lg" sizeClass="size-6" />
											</button>
											<a
												href="/wishlist"
												class={`relative flex ${actionBtnSizeCls} items-center justify-center transition-opacity hover:opacity-80`}
												aria-label="Избранное"
											>
												<RoseNtIcon name="favourite" sizeClass="size-6" />
												<span
													data-wishlist-count
													data-empty="true"
													class="absolute right-0 top-0 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-[#000000] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden"
												>0</span>
											</a>
											<button
												type="button"
												data-cart-open
												class={`relative flex ${actionBtnSizeCls} items-center justify-center transition-opacity hover:opacity-80`}
												aria-label="Корзина"
											>
												<RoseNtIcon name="cart" sizeClass="size-6" />
												<span
													data-cart-count
													data-empty="true"
													class="absolute right-0 top-0 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-[#000000] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden"
												>0</span>
											</button>
											<a
												href="/login"
												data-auth-link
												class={`flex ${actionBtnSizeCls} items-center justify-center transition-opacity hover:opacity-80`}
												aria-label="Аккаунт"
											>
												<RoseNtIcon name="user" sizeClass="size-6" />
											</a>
										</div>
									</div>
									<nav
										class:list={["mt-3 flex w-full items-center gap-8 lg:gap-12", logoPosition === "top-left" ? "justify-start" : "justify-center", menuSchemeClass, isSidebar && "lg:!hidden"]}
										aria-label="Основная навигация"
										data-nav-inline
										data-puck-subsection-parent={id}
										data-puck-subsection-index="997"
										data-puck-subsection-field="navigationLinks"
									>
										{nav.map((link) => (
									<NavItem link={link} menuType={menuType} linkClass={navLinkCls} active={isActive(link)} />
								))}
									</nav>
								</>
							) : (
								/* top-center: Row1=[search LEFT | logo CENTER | cart+user RIGHT], Row2=[nav CENTER] */
								<>
									<div class="grid w-full grid-cols-[1fr_auto_1fr] items-center">
						{/* Левая ячейка: бургер бокового меню (владелец, 25.09 — слева на
						    любой ширине). Поиск отсюда убран (жалоба владельца 21.09 «не
						    должно быть поиска слева»): он переехал к остальным иконкам
						    справа, чтобы ряд действий не разрывался; распорка остаётся
						    распоркой, когда бургера нет (menuType≠sidebar). */}
										<div class="flex items-center gap-4 lg:gap-6">
											{isSidebar && (
												<button type="button" data-burger-toggle class={`flex ${actionBtnSizeCls} items-center justify-center transition-opacity hover:opacity-80`} aria-label="Меню" aria-expanded="false" aria-controls="rose-burger">
													<span class="burger-icon" data-icon="open"><RoseNtIcon name="menu-burger" sizeClass="size-6" /></span>
													<span class="burger-icon hidden" data-icon="close"><RoseNtIcon name="menu-close" sizeClass="size-6" /></span>
												</button>
											)}
										</div>
										<div class="flex items-center justify-center">
											<a
												href="/"
