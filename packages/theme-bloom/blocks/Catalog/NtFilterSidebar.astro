---
/**
 * NtFilterSidebar (порт из design-systems-theme/components/ui/NtFilterSidebar.astro).
 * Боковые фильтры — 493:5523 (1920, 294px) и 493:5524 (1280, 172px).
 * Импорты NtFilterPriceRows / NtRadioField — siblings в этой же block-папке (./).
 * Шрифт и жирность текста — из «Настроек темы» (--font-body / --weight-body):
 * их ставит корню панели packages/theme-base/styles/catalog-filters.css, дети
 * наследуют — своих font-* классов у разметки панели нет.
 *
 * Сворачивание групп (владелец: «возможность скрывать и раскрывать список
 * фильтров, все темы»). Заголовок каждой группы — `<button
 * data-nt="filter-group-toggle" aria-expanded>`, список — соседний элемент
 * `data-filter-group-body`: клик переключает aria-expanded + атрибут
 * hidden списка. Обработчик клика — общий делегированный <script is:inline>
 * в Catalog.astro (window.__merfyFilterGroups, рядом с __merfyFilterChips —
 * тот же порт не гейтит его видимостью «Фильтров»/«Сортировки»: боковой блок
 * «Коллекции» стоит рядом с этим компонентом и рисуется независимо от них,
 * поэтому слушатель живёт там, где ГАРАНТИРОВАННО рендерится). Правило
 * видимости `[data-filter-group-body][hidden]` — в общем
 * packages/theme-base/styles/catalog-filters.css (Tailwind `flex` того же
 * узла его не перебивает без этой пары атрибутов). Старт — всегда
 * развёрнуто, состояние между заходами не хранится.
 *
 * ВАЖНО для Catalog.astro каждой темы: заголовок «Цвет» ищется скриптом
 * каталога (`bindColors`) через `:scope > [data-nt="filter-group-toggle"]`
 * (было `:scope > p` — сломалось бы конверсией title в button, чинить там же).
 * Внутренний `<span>` с текстом группы остаётся без детей — так
 * cloneColorFilter находит и переименовывает подпись клона (Оттенок/Размер).
 */
import NtFilterPriceRows from "./NtFilterPriceRows.astro";
import NtRadioField from "./NtRadioField.astro";

interface Props {
  density?: "1920" | "1280";
  class?: string;
  /** Тумблер «Сортировка» из панели секции. Блок «Сортировать» жил в сайдбаре
   *  безусловно — при «Скрыть» каталог выглядел так же, как при «Показать». */
  sortVisible?: boolean;
  /** Окончание имён радио. У шторки «Фильтры и сортировка» на телефоне свой
   *  экземпляр панели (instance="sheet"): с теми же именами его радио слились
   *  бы в одну группу с радио раскладки «Сбоку», и выбор в одной снимал бы
   *  выбор в другой. Скрипт каталога ищет радио по началу имени. */
  instance?: string;
  /** Тумблер «Фильтры» из панели секции: без него остаётся только «Сортировать». */
  filtersVisible?: boolean;
  /** Раздел «Коллекции» (шторка на телефоне). Скрыт, пока скрипт каталога не
   *  найдёт коллекции магазина; опции рисует он же (collectionOptionHtml). В
   *  раскладке «Сбоку» у коллекций свой блок рядом с панелью, там не нужен. */
  collections?: boolean;
}

const {
  density = "1920",
  class: className = "",
  sortVisible = true,
  instance = "",
  filtersVisible = true,
  collections = false,
} = Astro.props;
const is1280 = density === "1280";
const W = is1280 ? "w-[172px]" : "w-[294px]";
const sectionPad = is1280 ? "p-1" : "p-3";
const sectionGap = is1280 ? "gap-2" : "gap-3";
const titleSm = is1280 ? "text-[12px]" : "text-[16px]";
const titlePrice = is1280 ? "text-[14px]" : "text-[16px]";
const sortStackGap = is1280 ? "gap-1" : "gap-3";
const nameSfx = (is1280 ? "-1280" : "") + (instance ? `-${instance}` : "");
/** Заголовок группы — кнопка, а не <p>: та же строка классов для всех пяти
 *  групп, только цвет текста и размер подставляются вызовом. */
const toggleClass = (sizeCls: string) => [
  "flex w-full cursor-pointer items-center justify-between gap-2 border-0 bg-transparent p-0 text-left leading-normal text-[rgb(var(--color-text,0_0_0))]",
  sizeCls,
];
---

<aside
  class:list={["flex max-w-full flex-col gap-4 bg-[rgb(var(--color-bg,255_255_255))]", W, className]}
  data-nt="filter-sidebar"
  data-nt-density={density}
>
  {sortVisible && (
    <div class:list={["flex flex-col rounded-[8px]", sectionPad, sectionGap]}>
      <button
        type="button"
        class:list={toggleClass(titleSm)}
        data-nt="filter-group-toggle"
        aria-expanded="true"
        aria-controls={`nt-fg-sort${nameSfx}`}
      >
        <span>Сортировать</span>
        <svg aria-hidden="true" viewBox="0 0 10 6" class="h-[6px] w-[10px] shrink-0 text-[rgb(var(--color-muted,153_153_153))]" data-nt="filter-group-chevron"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
      </button>
      <div class:list={["flex flex-col", sortStackGap]} data-filter-group-body id={`nt-fg-sort${nameSfx}`}>
        <NtRadioField
          name={`nt-sort-side${nameSfx}`}
          value="popularity"
          label="По популярности"
          checked
          density={density}
        />
        <NtRadioField
          name={`nt-sort-side${nameSfx}`}
          value="new"
          label="По новизне"
          density={density}
        />
        <NtRadioField
          name={`nt-sort-side${nameSfx}`}
          value="price-desc"
          label="По убыванию цены"
          density={density}
        />
        <NtRadioField
          name={`nt-sort-side${nameSfx}`}
          value="price-asc"
          label="По возрастанию цены"
          density={density}
        />
      </div>
    </div>
  )}

  {filtersVisible && (
  <>
  <div class:list={["flex flex-col rounded-[8px]", sectionPad, sectionGap]}>
    <button
      type="button"
      class:list={toggleClass(titleSm)}
      data-nt="filter-group-toggle"
      aria-expanded="true"
      aria-controls={`nt-fg-stock${nameSfx}`}
    >
      <span>Наличие</span>
      <svg aria-hidden="true" viewBox="0 0 10 6" class="h-[6px] w-[10px] shrink-0 text-[rgb(var(--color-muted,153_153_153))]" data-nt="filter-group-chevron"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
    </button>
    <div class:list={["flex flex-col", sortStackGap]} data-filter-group-body id={`nt-fg-stock${nameSfx}`}>
      <NtRadioField name={`nt-stock-side${nameSfx}`} value="all" label="Все" checked density={density} />
      <NtRadioField name={`nt-stock-side${nameSfx}`} value="in" label="В наличии" density={density} />
      <NtRadioField name={`nt-stock-side${nameSfx}`} value="out" label="Распродано" density={density} />
    </div>
  </div>

  <div class:list={["flex flex-col rounded-[8px]", sectionPad, sectionGap]}>
    <button
      type="button"
      class:list={toggleClass(titlePrice)}
      data-nt="filter-group-toggle"
      aria-expanded="true"
      aria-controls={`nt-fg-price${nameSfx}`}
    >
      <span>Стоимость</span>
      <svg aria-hidden="true" viewBox="0 0 10 6" class="h-[6px] w-[10px] shrink-0 text-[rgb(var(--color-muted,153_153_153))]" data-nt="filter-group-chevron"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
    </button>
    <div data-filter-group-body id={`nt-fg-price${nameSfx}`}>
      <NtFilterPriceRows variant={is1280 ? "sidebar1280" : "sidebar"} />
    </div>
  </div>

  <div class:list={["flex flex-col gap-3 rounded-[8px]", sectionPad]}>
    <button
      type="button"
      class:list={toggleClass(titleSm)}
      data-nt="filter-group-toggle"
      aria-expanded="true"
      aria-controls={`nt-fg-color${nameSfx}`}
    >
      <span>Цвет</span>
      <svg aria-hidden="true" viewBox="0 0 10 6" class="h-[6px] w-[10px] shrink-0 text-[rgb(var(--color-muted,153_153_153))]" data-nt="filter-group-chevron"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
    </button>
    <div class="flex flex-col gap-3" data-filter-group-body id={`nt-fg-color${nameSfx}`}>
      <NtRadioField
        name={`nt-color-side${nameSfx}`}
        value="black"
        label="Черный"
        checked
        density={density}
        labelClass={is1280 ? "text-[14px]" : ""}
      />
      <NtRadioField
        name={`nt-color-side${nameSfx}`}
        value="white"
        label="Белый"
        density={density}
        labelClass={is1280 ? "text-[14px]" : ""}
      />
      <NtRadioField
        name={`nt-color-side${nameSfx}`}
        value="gray"
        label="Серый"
        density={density}
        labelClass={is1280 ? "text-[14px]" : ""}
      />
    </div>
  </div>

  {collections && (
    <div
      class:list={["flex flex-col rounded-[8px]", sectionPad, sectionGap]}
      data-nt="catalog-collections-filter"
      data-collections-style="sidebar"
      style="display:none;"
    >
      <button
        type="button"
        class:list={toggleClass(titleSm)}
        data-nt="filter-group-toggle"
        aria-expanded="true"
        aria-controls={`nt-fg-collections${nameSfx}`}
      >
        <span>Коллекции</span>
        <svg aria-hidden="true" viewBox="0 0 10 6" class="h-[6px] w-[10px] shrink-0 text-[rgb(var(--color-muted,153_153_153))]" data-nt="filter-group-chevron"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
      </button>
      <ul data-collections-options data-filter-group-body id={`nt-fg-collections${nameSfx}`} class:list={["m-0 flex list-none flex-col p-0", sortStackGap]}></ul>
    </div>
  )}
  </>
  )}
</aside>
