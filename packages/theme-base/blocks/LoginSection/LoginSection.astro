---
import type { LoginSectionProps } from './LoginSection.puckConfig';
import { LoginSectionClasses as C } from './LoginSection.classes';
import { sanitizeInline } from '../../runtime/rich-text';

interface Props extends LoginSectionProps {
  id?: string;
  button?: { text?: string; href?: string; link?: string | { href?: string } };
}

const {
  id,
  heading = 'Вход в аккаунт',
  text = 'Введите e-mail — пришлём ссылку для входа. Войдём в аккаунт или создадим новый.',
  padding,
  button,
} = Astro.props as Props;

const paddingStyle = padding
  ? `padding-top:${padding.top}px; padding-bottom:${padding.bottom}px;`
  : '';

// Параметр «Кнопка» задаёт надпись на КНОПКЕ ФОРМЫ входа — той, что отправляет
// письмо со ссылкой. Владелец, 2026-09-16: «нужно нижнюю кнопку синхронизировать
// с инпутом, а не верхнюю, и её менять».
// Раньше параметр рисовал ОТДЕЛЬНУЮ ссылку-кнопку над формой (канон
// ImageWithText.button, репорт тестера 15.09 п.[5]) — на странице входа
// получались две кнопки: лишняя сверху и настоящая снизу. Отдельную убрали,
// ссылку из панели убрали там же: кнопка входа ведёт по своей логике.
const SUBMIT_FALLBACK = 'Получить ссылку для входа';
const btnText =
  typeof button?.text === 'string' && button.text.trim() ? button.text.trim() : SUBMIT_FALLBACK;
// Общий скаффолд (зеркало CartSection.astro / WishlistSection.astro): живую
// форму входа рисует ПОРТ темы —
// themes/<t>/src/components/sections/LoginSection.astro. Сюда попадают только
// темы без собственного порта; у всех пяти он есть. Id формы и полей — те же,
// что у портов: клиентский скрипт входа темы ищет их по id.
---
<section
  id="login-section"
  class={C.root}
  data-puck-component-id={id}
  data-block="login-section"
  data-login-page
  style={paddingStyle}
>
  <div class={C.container}>
    <h1 class={C.heading}><Fragment set:html={sanitizeInline(heading)} /></h1>
    {text && <p class={C.text}><Fragment set:html={sanitizeInline(text)} /></p>}
    <form id="magic-form" class={C.form} novalidate>
      <input
        id="login-email"
        type="email"
        name="email"
        placeholder="example@merfy.ru"
        autocomplete="email"
        required
      />
      <div id="login-error" class="hidden text-center" role="alert"></div>
      <button
        id="btn-magic"
        type="submit"
        form="magic-form"
        data-puck-subsection-parent={id}
        data-puck-subsection-index="100"
        data-puck-subsection-field="button"
      >{btnText}</button>
    </form>
  </div>
</section>
