---
import { inlineFormat } from "../../lib/rich-text";
// Фаза B: новая канон-секция Slideshow в манере bloom (см. themes/bloom/MANNER.md;
// процесс-эталон — rose T17 Slideshow). Схема полей = packages/theme-base/blocks/
// Slideshow/Slideshow.puckConfig.ts. Композиция = полотно Hero bloom: контент
// блоком (max-w-[480px], поднято с 330 багом b67 2026-09-17 — своя лестница
// шрифтов у Slideshow, см. slideHeadingCls) в левом нижнем углу, розовая
// pill-CTA (токены кнопки-1), каскад hero-animate-1/2/3 на активном слайде.
// Параметры скрипту — ТОЛЬКО data-атрибуты (define:vars компилятором секций не
// поддерживается); идемпотентность — data-slideshow-hydrated; реинициализация —
// astro:page-load (его шлёт превью-агент после hot-replace).
const p = Astro.props as Record<string, any>;
const id = p.id;
// Своя colorScheme на корне секции: при hot-render одиночного блока в превью
// обёртки композитора НЕТ, и секция берёт :root — соседние секции «перекрашиваются»
// от правки чужой настройки. На live обёртка даёт ту же схему, дубль безвреден
// (паттерн rose Footer / theme-base Video).
// colorScheme приходит строкой ("scheme-4") ИЛИ числом (нормализатор Slideshow
// приводит к номеру) — разбираем оба вида, иначе класс молча не ставится.
const _rawScheme = p.colorScheme;
const _schemeId =
	typeof _rawScheme === "number"
		? String(_rawScheme)
		: typeof _rawScheme === "string" && _rawScheme
			? String(_rawScheme).replace("scheme-", "")
			: "";
const selfSchemeClass = _schemeId ? ` color-scheme-${_schemeId}` : "";

// Канон slides[] 1-5 (item: imageUrl|image, heading(string|{text,size}), subtitle,
// text{content,size}, ctaText/ctaUrl | button{text,link}, container, position,
// alignment, colorScheme).
//
// ПУСТОЕ СОСТОЯНИЕ (Figma 1:19335): когда мерчант НЕ добавил ни одного слайда —
// секция рендерит ПЛЕЙСХОЛДЕР контракта (пустой image-rect #FBFBFB-эквивалент
// surface + заголовок секции + поясняющий текст + Кнопка + точки-навигация), а
// НЕ мок-демо верстальщика (3 слайда-болванки «Ритуал сияния/HYDRO/Бестселлеры»
// + фоллбек-фото /images/hero-background.webp …). Образец гейта — theme-base
// Collections.astro (hasManualCollections → DEMO) и манера пустого rect темы
// bloom — ImageWithText.astro (тот же Figma-контракт: bg surface + заголовок +
// текст + розовый pill). Когда слайды ВЫБРАНЫ (p.slides.length) — рендер
// реальных слайдов БЕЗ изменений; слайд без фото = ПУСТАЯ surface-плитка
// (ветка s.image ? <img> : <div bg-surface> ниже), а НЕ мок-ассет верстальщика;
// клиентский слайдер (prev/next/dots при ≥2 слайдах) не затрагивается.
// Figma 1:19335 — слайд пустого состояния несёт дизайн-ассет landscape-slideshow.png
// (раздаётся на каждой теме из packages/theme-base/public/placeholders, copyPublic),
// а НЕ пустой image-rect (surface) и НЕ ассет верстальщика (контракт картиночных
// секций, эталон rose Slideshow.astro). Текст плейсхолдера дословно по Figma:
// «Слайд-шоу» + «Добавь несколько изображений с информацией о своём бренде» + «Кнопка».
const PLACEHOLDER_SLIDE_IMAGE = "/placeholders/landscape-slideshow.png";
const PLACEHOLDER_SLIDE = {
	id: "placeholder",
	imageUrl: PLACEHOLDER_SLIDE_IMAGE,
	heading: "Слайд-шоу",
	subtitle: "Добавь несколько изображений с информацией о своём бренде",
	ctaText: "Кнопка",
	ctaUrl: "/catalog",
};
const hasSlides = Array.isArray(p.slides) && p.slides.length > 0;
const rawSlides = hasSlides ? p.slides : [PLACEHOLDER_SLIDE];

// Заголовок слайда — жалоба владельца 2026-09-17 (баг b67): заголовок слайд-шоу
// был РОВНО той же лестницей, что вспомогательный hero-подзаголовок Hero.astro
// (§9) — 18/md:20 против текста 14/md:16, то есть заголовок читался как обычный
// текст, а не как заголовок секции. Слайд-шоу — самостоятельная секция (не Hero,
// делить с ним лестницу шрифтов не обязано), поэтому здесь лестница ПОДНЯТА
// отдельно от Hero (Hero не трогаем — его типографику владелец зафиксировал
// коммитом ba285785). Эталон поведения — rose/flux (там заголовок слайд-шоу
// заметно крупнее текста), но без копирования их пиксельных значений — цвета,
// шрифт (font-urbanist) и манера bloom (низ-лево, розовый pill) сохранены.
// large/отсутствие 28/md:34 (было 18/20), medium 22/md:27 (было 15/17),
// small 16/md:19 (было 13/14).
const slideHeadingCls = (s: string | undefined) =>
	s === "small"
		? "font-urbanist text-[16px] font-normal leading-none text-[rgb(var(--color-heading,227_142_159))] md:text-[19px]"
		: s === "medium"
			? "font-urbanist text-[22px] font-normal leading-none text-[rgb(var(--color-heading,227_142_159))] md:text-[27px]"
			: "font-urbanist text-[28px] font-normal leading-none text-[rgb(var(--color-heading,227_142_159))] md:text-[34px]";
// Текст слайда — лестница НЕ трогается жалобой b67 (владелец указал заголовок,
// ширину блока и кнопку; текст-абзац уже читался нормальным текстом, только
// заголовок путался с ним по размеру). large/отсутствие 14/16, medium 12/14,
// small 10/11.
const slideTextCls = (s: string | undefined) =>
	s === "small"
		? "font-inter text-[10px] font-light leading-[1.2] text-[rgb(var(--color-text,227_142_159))] md:text-[11px]"
		: s === "medium"
			? "font-inter text-[12px] font-light leading-[1.2] text-[rgb(var(--color-text,227_142_159))] md:text-[14px]"
			: "font-inter text-[14px] font-light leading-[1.2] text-[rgb(var(--color-text,227_142_159))] md:text-[16px]";

// Мок-фолбэки верстальщика (/images/hero-background.webp …) УБРАНЫ и не
// возвращаются: контракт картиночных секций запрещает выдавать мок за данные.
// Слайд без фото — и в пустом состоянии (!hasSlides), и у мерчанта — несёт
// ДИЗАЙН-АССЕТ landscape-slideshow.png (Figma 1:19335, паритет rose). Прежняя
// пустая surface-карточка в bloom была неотличима от фона: --color-surface
// равен --color-bg во всех четырёх схемах темы.

// Канон position (9 точек сетки 3×3) — РАЗМЕЩЕНИЕ контент-блока на полотне слайда.
// Нормализуем полную строку position в вертикаль + горизонталь (порт rose
// Slideshow:61-90 slideLayoutCls). Раньше рендером парсилась ТОЛЬКО горизонталь, а
// вертикаль была захардкожена items-end (низ). legacy одиночные left/right →
// center-left/center-right (середина по вертикали). Контейнер контента = row-flex
// bloom: вертикаль через items-*, горизонталь через justify-*.
const slidePosCls = (s: any) => {
	const posRaw = typeof s.position === "string" && s.position ? s.position : "";
	const norm = posRaw === "left" ? "center-left" : posRaw === "right" ? "center-right" : posRaw;
	const vPos = norm.startsWith("top")
		? "top"
		: norm.startsWith("bottom")
			? "bottom"
			: norm === "center" || norm.startsWith("center")
				? "middle"
				: "";
	const hPos = norm.endsWith("left")
		? "left"
		: norm.endsWith("right")
			? "right"
			: norm.endsWith("center") || norm === "center"
				? "center"
				: "";
	// Вертикаль (cross-axis row-flex): top → верх, middle → центр, bottom/отсутствие
	// → низ (дефолт манеры — нижний угол героя).
	const vItemsCls = vPos === "top" ? "items-start" : vPos === "middle" ? "items-center" : "items-end";
	// Горизонталь (main-axis): сохраняем дефолт bloom — левый угол (justify-start);
	// top-level contentAlign='center' центрирует при отсутствии явной горизонтали.
	const hJustifyCls =
		hPos === "left" || (!hPos && p.contentAlign !== "center")
			? "justify-start"
			: hPos === "right"
				? "justify-end"
				: "justify-center";
	return `${vItemsCls} ${hJustifyCls}`;
};
// Канон overlay 0-100 — «Затемнение» PER-SLIDE (паритет rose). Читаем s.overlay с
// fallback на section-level p.overlay (backward-compat со старыми данными, где
// overlay был в секции). Хелпер объявлен ВЫШЕ маппинга slides (используется в нём).
const slideOverlayN = (s: any) => Math.max(0, Math.min(100, Number(s.overlay ?? p.overlay) || 0));
const slides = rawSlides.slice(0, 5).map((s: any, i: number) => {
	const ctaText =
		(typeof s.button?.text === "string" && s.button.text.trim() ? s.button.text : undefined) ??
		(typeof s.ctaText === "string" && s.ctaText.trim() ? s.ctaText : undefined);
	return {
		// §11 Контракта секции: видимое поле панели «Изображение» (image) приоритетнее
		// скрытого legacy «Изображение (старое)» (imageUrl). Раньше legacy читался
		// ПЕРВЫМ, а он всегда заполнен дефолтом слайда — из-за этого выбранная
		// мерчантом картинка слайда не применялась вообще.
		// Слот без фото несёт ДИЗАЙН-АССЕТ, а не пустую поверхность (ориентир —
		// rose, владелец 2026-09-15; там же `merchantImage || PLACEHOLDER`).
		// В bloom пустая поверхность вдобавок невидима: --color-surface равен
		// --color-bg во всех четырёх схемах темы, поэтому слайд читался как
		// «сплошная заливка без изображения» (баг-репорт). Внутри самой темы
		// это ещё и рассогласование: пустая плитка «Галереи» и пустое медиа
		// «Изображения с текстом» ассет получают, слайд — нет.
		image:
			(typeof s.image === "string" && s.image.trim()) ||
			(typeof s.imageUrl === "string" && s.imageUrl.trim()) ||
			PLACEHOLDER_SLIDE_IMAGE,
		heading: typeof s.heading === "string" ? s.heading : (s.heading?.text ?? ""),
		headingCls: slideHeadingCls(typeof s.heading === "object" ? s.heading?.size : undefined),
				// Канон панели ПЕРВЫМ, легаси — запасным. Раньше порядок был обратным, а
		// легаси почти всегда заполнено сидом, поэтому ввод мерчанта в «Текст» и
		// «Кнопку» не доезжал до витрины: слайд показывал старые subtitle/ctaText
		// (баг тестера, «Слайд-шоу ▸ Слайд — доезжает только Заголовок»). Тем же
		// приёмом здесь уже чинили «Изображение (старое)».
		subtitle:
			(typeof s.text?.content === "string" && s.text.content.trim() ? s.text.content : undefined) ??
			(typeof s.subtitle === "string" && s.subtitle.trim() ? s.subtitle : undefined),
		textCls: slideTextCls(s.text?.size),
		ctaText,
		ctaHref:
			s.button?.link?.href ??
			(typeof s.button?.link === "string" && s.button.link ? s.button.link : undefined) ??
			(typeof s.ctaUrl === "string" && s.ctaUrl ? s.ctaUrl : undefined) ??
			"/catalog",
		boxed: String(s.container ?? "false") === "true",
		schemeCls:
			typeof s.colorScheme === "string" && s.colorScheme
				? ` color-scheme-${String(s.colorScheme).replace("scheme-", "")}`
				: "",
		// position per-slide — вертикаль + горизонталь (slidePosCls выше). Раньше
		// вертикаль игнорировалась (контент был захардкожен внизу = items-end).
		posCls: slidePosCls(s),
		// alignment per-slide; 'left' (canon-default blockDefaults) и отсутствие =
		// items-start героя.
		alignCls:
			s.alignment === "center"
				? "items-center text-center"
				: s.alignment === "right"
					? "items-end text-right"
					: "items-start text-left",
		overlayN: slideOverlayN(s),
		active: i === 0,
	};
});

// Канон interval (slider 1-20 c, схема до 60) / autoplay: canon-defaults 5 / true.
const intervalMs = String(
	(typeof p.interval === "number" && p.interval >= 1 && p.interval <= 60 ? p.interval : 5) * 1000,
);
const autoplay = p.autoplay === false || p.autoplay === "false" ? "false" : "true";

// Канон size (s/m/l): medium и отсутствие = полотно героя (лестница аспектов
// верстальщика, min-h-[560px]); small/large — фиксированный шаг высоты от него.
const canvasCls =
	p.size === "small"
		? "relative mx-auto w-full overflow-hidden h-[min(60svh,420px)]"
		: p.size === "large"
			? "relative mx-auto w-full overflow-hidden h-[min(80svh,720px)]"
			: "relative mx-auto w-full overflow-hidden min-h-[560px] aspect-[375/812] sm:aspect-[768/968] md:aspect-[1280/968] xl:aspect-[1920/925]";

// Канон imagePosition: fullscreen (canon-default; полотно во всю ширину секции,
// как герой) | contained (+legacy left/right) — внутри контейнера манеры с
// полями секции и радиусом медиа. imageFullBleed=true возвращает full-bleed.
const contained =
	(p.imagePosition === "contained" || p.imagePosition === "left" || p.imagePosition === "right") &&
	p.imageFullBleed !== true &&
	p.imageFullBleed !== "true";

// Канон overlay 0-100 — «Затемнение» PER-SLIDE (хелпер slideOverlayN объявлен ВЫШЕ,
// перед маппингом slides, т.к. используется в нём; overlayN теперь поле слайда).

// Канон pagination: 'numbers' (canon-default из blockDefaults bloom) и
// отсутствие = цифры Inter 14; dots = точки манеры h-2 w-2 rounded-full
// (активная белая на фото, неактивная white/50); counter/lines/none — канон.
const pagination =
	p.pagination === "dots" ||
	p.pagination === "counter" ||
	p.pagination === "lines" ||
	p.pagination === "none"
		? p.pagination
		: "numbers";

// «Кнопка» слайда одна — цвета «Основной кнопки» схемы (Фон → фон, Текст →
// буквы, Обводка → рамка; data-scheme-button, src/themes/scheme-buttons.ts).
// Скрытый buttonStyle=outlined раньше делал её контуром цвета Фона.
const ctaCls =
	"inline-flex h-[52px] min-w-[150px] items-center justify-center rounded-[var(--radius-button,100px)] border border-solid px-6 font-inter text-[16px] font-light leading-none transition-opacity hover:opacity-90 active:scale-95";

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе (паттерн rose T11).
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;
// Картинки слайдов грузятся НЕМЕДЛЕННО (loading="eager"), а не лениво, и это
// касается всех слайдов, а не только первого. Слайды лежат друг на друге
// (absolute inset-0) и переключаются сменой opacity: у скрытого слайда браузер
// ленивую картинку не грузит, а когда слайд показывают — уже не начинает,
// наблюдатель видимости от смены opacity не пересчитывается. Мерчант выбирал
// фото во втором слайде и не видел его до перезагрузки страницы (жалоба
// владельца 18.09, п.26 «не применяется медиафайл»). Слайдов максимум пять —
// экономить на их загрузке нечего. Сторож — slideshow-slide-eager.spec.ts.
---

<section
	class={`relative w-full overflow-hidden bg-[rgb(var(--color-bg,255_255_255))]${selfSchemeClass}`}
	data-puck-component-id={id}
	data-bloom-slideshow
	data-interval={intervalMs}
	data-autoplay={autoplay}
	style={paddingStyle}
>
	<div class={contained ? "w-full px-4 md:px-20 2xl:px-[300px]" : "w-full"}>
		<div class={`${canvasCls}${contained ? " max-w-[1320px] rounded-[var(--radius-media,12px)]" : ""}`}>
			{
				slides.map((s, i) => (
					<div
						data-slide
						class={`!absolute inset-0 transition-opacity duration-700 ease-out ${s.active ? "opacity-100" : "pointer-events-none opacity-0"}${s.schemeCls}`}
						data-puck-subsection-parent={id}
						data-puck-subsection-index={i}
						data-puck-subsection-field="slides"
					>
						{s.image ? (
							<img
								src={s.image}
								alt={s.heading || "Слайд"}
								loading="eager"
								class="absolute inset-0 !h-full !w-full object-cover object-center"
							/>
						) : (
							<div class="absolute inset-0 bg-[rgb(var(--color-surface,245_245_245))]" aria-hidden="true" />
						)}
						{s.overlayN > 0 && s.image && (
							<div
								class="pointer-events-none absolute inset-0 bg-black"
								style={`opacity:${s.overlayN / 100}`}
								aria-hidden="true"
							/>
						)}
						{/* Контент в нижнем углу полотна — манера героя bloom (поля
						    px-4 md:px-20 2xl:px-[300px], pb-8/12/20). Ширина блока —
						    жалоба владельца 2026-09-17 (баг b67): 330px (унаследовано
						    от Hero) зажимало поднятый заголовок (см. slideHeadingCls
						    выше) в узкую колонку — 3-4 переноса строки на десктопе.
						    Поднято до 480px — Слайд-шоу самостоятельная секция, ширина
						    Hero (330) не трогается. Угол (низ-лево) — манера bloom —
						    сохранён, только блок дышит просторнее. */}
						<div
							class={`relative z-10 flex h-full w-full px-4 pb-8 md:px-20 md:pb-12 xl:pb-20 2xl:px-[300px] ${s.posCls}`}
						>
							<div
								class={`flex w-full max-w-[480px] flex-col gap-4 ${s.alignCls}${s.boxed ? " rounded-[var(--radius-card,12px)] bg-[rgb(var(--color-bg,255_255_255))]/90 p-6" : ""}`}
							>
								<div class={`flex flex-col gap-2 ${s.alignCls}`}>
									{s.heading && <h2 class={`hero-animate-1 ${s.headingCls}`} set:html={inlineFormat(s.heading)} />}
									{s.subtitle && <p class={`hero-animate-2 ${s.textCls}`} set:html={inlineFormat(s.subtitle)} />}
								</div>
								{s.ctaText && (
									<a href={s.ctaHref} class={`hero-animate-3 ${ctaCls}`} data-scheme-button="primary">
										{s.ctaText}
									</a>
								)}
							</div>
						</div>
					</div>
				))
			}

			{
				slides.length > 1 && (
					<>
						{/* Стрелок «назад/вперёд» по бокам нет (тестер 24.09: «убери на всех темах
						    стрелки справа и слева»): листают автоинтервал и нумерация. */}
						{pagination !== "none" && (
							// Баг b71 (жалоба владельца 2026-09-17): пагинация была
							// прижата к правому краю (right-4/md:right-20/2xl:right-[300px])
							// вместо центра снизу — уезжала вправо ровно в момент, когда
							// у мерчанта появлялось ≥2 слайда (пустое состояние ниже уже
							// было центрировано, отсюда «нумерация при добавлении медиа
							// уезжает»). Канон — rose Slideshow.astro (left-1/2 + -translate-x-1/2),
							// тот же паттерн уже жил в пустом состоянии этого файла.
							<div class="absolute bottom-5 left-1/2 z-20 flex -translate-x-1/2 items-center gap-2">
								{pagination === "numbers" &&
									slides.map((_, i) => (
										<button
											type="button"
											data-slide-dot
											data-active={i === 0 ? "true" : "false"}
											aria-label={`Слайд ${i + 1}`}
											class="font-inter text-[14px] font-light leading-none !text-white/60 transition-colors data-[active=true]:!text-white"
										>
											{i + 1}
										</button>
									))}
								{pagination === "dots" &&
									slides.map((_, i) => (
										<button
											type="button"
											data-slide-dot
											data-active={i === 0 ? "true" : "false"}
											aria-label={`Слайд ${i + 1}`}
											class="h-2 w-2 !rounded-full !bg-white/50 transition-colors data-[active=true]:!bg-white"
										/>
									))}
								{pagination === "lines" &&
									slides.map((_, i) => (
										<button
											type="button"
											data-slide-dot
											data-active={i === 0 ? "true" : "false"}
											aria-label={`Слайд ${i + 1}`}
											class="h-0.5 w-6 !bg-white/50 transition-colors data-[active=true]:!bg-white"
										/>
									))}
								{pagination === "counter" &&
									slides.map((_, i) => (
										<span
											data-slide-dot
											data-active={i === 0 ? "true" : "false"}
											class="font-inter text-[14px] font-light leading-none text-white data-[active=false]:hidden"
										>
											{/* Разделитель «/» обёрнут в <span> (паритет rose): голый « / »
											    (пробел-слэш-пробел) иначе переписывается preview-rewriter'ом
											    ROOT_URL_RE (whitespace+/ → /__theme/<t>/) → «1 /__theme/bloom/ 3». */}
											{i + 1}<span class="mx-1" aria-hidden="true">/</span>{slides.length}
										</span>
									))}
							</div>
						)}
					</>
				)
			}

			{
				/* ПЛЕЙСХОЛДЕР пустого состояния (Figma 1:19335): точки-навигация —
				   декоративные (3 точки, одна активная) на светлом surface-полотне,
				   тёмный токен heading вместо белого реальных слайдов. JS-логики нет
				   (один слайд) — чисто визуальный контракт пустого состояния. */
				!hasSlides && (
					<div class="absolute bottom-5 left-1/2 z-20 flex -translate-x-1/2 items-center gap-2" aria-hidden="true">
						{[0, 1, 2].map((i) => (
							<span class={`h-2 w-2 !rounded-full ${i === 0 ? "bg-white" : "bg-white/50"}`} />
						))}
					</div>
				)
			}
		</div>
	</div>
</section>

<script is:inline>
	(function () {
		function initOne(root) {
			if (root.dataset.slideshowHydrated === "true") return;
			root.dataset.slideshowHydrated = "true";
			var interval = parseInt(root.dataset.interval || "5000", 10);
			var autoplay = root.dataset.autoplay !== "false";
			var slides = root.querySelectorAll("[data-slide]");
			var dots = root.querySelectorAll("[data-slide-dot]");
			if (slides.length < 2) return;
			var idx = 0,
				timer = null;
			// Каскад hero-animate-1/2/3 на активном слайде — перезапуск CSS-анимации
			// манеры (animation:none → reflow → снятие), как при загрузке героя.
			function replayCascade(slide) {
				var els = slide.querySelectorAll(".hero-animate-1,.hero-animate-2,.hero-animate-3");
				for (var j = 0; j < els.length; j++) {
					els[j].style.animation = "none";
					void els[j].offsetWidth;
					els[j].style.animation = "";
				}
			}
			function show(n) {
				idx = (n + slides.length) % slides.length;
				for (var j = 0; j < slides.length; j++) {
					slides[j].style.opacity = j === idx ? "1" : "0";
					slides[j].style.pointerEvents = j === idx ? "auto" : "none";
				}
				for (var j = 0; j < dots.length; j++) {
					dots[j].setAttribute("data-active", j === idx ? "true" : "false");
				}
				replayCascade(slides[idx]);
			}
			function restart() {
				if (timer) clearInterval(timer);
				if (autoplay)
					timer = setInterval(function () {
						show(idx + 1);
					}, interval);
			}
			dots.forEach(function (d, i) {
				d.addEventListener("click", function () {
					show(i);
					restart();
				});
			});
			show(0);
			restart();
		}
		function initAll() {
			var roots = document.querySelectorAll("[data-bloom-slideshow]");
			for (var k = 0; k < roots.length; k++) initOne(roots[k]);
		}
		initAll();
		// Hot-replace превью вставляет секцию заново (новый узел без флага) и шлёт
		// astro:page-load — реинициализация подхватит свежий слайдер.
		document.addEventListener("astro:page-load", initAll);
	})();
</script>
