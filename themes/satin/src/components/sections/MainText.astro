---
import { inlineFormat } from "../../lib/rich-text";
import { sectionFieldOrder } from "../../../../../packages/theme-base/runtime/field-order";
import { mainTextButtonText } from "../../../../../packages/theme-base/runtime/main-text-button";
// Фаза B (satin): канон-секция MainText — адаптация TextBlock.astro (см.
// themes/satin/MANNER.md §10: TextBlock = заголовок + крупный body-абзац,
// аналог MainText). Тело верстальщика перенесено КОПИЕЙ — TextBlock.astro не
// тронут (его используют index.astro:27 и about.astro:60). Схема полей =
// packages/theme-base/blocks/MainText/MainText.puckConfig.ts; дефолт каждого
// пропса = литерал верстальщика (дефолт-ветка тернарников = прежние строки).
const p = Astro.props as Record<string, any>;
const id = p.id;

// Канон heading: string | { text, size }. Роль = заголовок секции (Kelly Slab
// uppercase, МАННЕРА §1). Лестница §9 «Заголовок секции 20»: medium/отсутствие =
// 20, small 17, large 24.
// Пустое состояние (Figma 1:19335 — НЕ мок-демо верстальщика): когда мерчант не
// задал ни заголовок, ни текст — рендерим контрактный плейсхолдер
// «Расскажи о своем бренде» + поясняющий текст + Кнопку. Любой заданный контент
// → рендер реальных данных без изменений.
// Баг владельца 26.09: "headingSet"/"textSet" считались по trim (пустая строка
// = "не задано"), поэтому стёртый мерчантом текст неотличим от нетронутого
// поля — секция откатывалась в isEmptyState и показывала заглушку темы вместо
// пустоты. Теперь "задано" = пришла СТРОКА (в т.ч. пустая); isEmptyState —
// ТОЛЬКО когда оба поля не заданы вовсе (undefined, старые ревизии).
const headingRaw = typeof p.heading === "string" ? p.heading : typeof p.heading?.text === "string" ? p.heading.text : undefined;
const textRaw = typeof p.text === "string" ? p.text : typeof p.text?.content === "string" ? p.text.content : undefined;
const headingSet = typeof headingRaw === "string";
const textSet = typeof textRaw === "string";
const isEmptyState = !headingSet && !textSet;

const heading = headingSet ? headingRaw : isEmptyState ? "Расскажи о своем бренде" : "";
const headingSize = p.heading?.size ?? p.headingSize;
const headingCls =
	headingSize === "small"
		? "font-logo text-[17px] font-normal leading-[1.15] text-[rgb(var(--color-heading,0_0_0))]"
		: headingSize === "large"
			? "font-logo text-[24px] font-normal leading-[1.15] text-[rgb(var(--color-heading,0_0_0))]"
			: "font-logo text-[20px] font-normal leading-[1.15] text-[rgb(var(--color-heading,0_0_0))]";

// Канон text: string | { content, size }. Пустое состояние → контрактный
// поясняющий текст плейсхолдера (НЕ длинная копия верстальщика).
const text =
	textSet ? textRaw : isEmptyState ? "Расскажи подробнее о своем онлайн-магазине в этом блоке" : "";

// Канон textSize (top-level hidden приоритетнее text.size сабпанели). Роль =
// «Body крупный» .satin-copy md:text-[20px] (Arsenal 300, lh 1.5, muted —
// МАННЕРА §1), классы расписаны явно ради лестницы и токена цвета. Лестница §9:
// medium/отсутствие = литерал 16/20, small 14/17, large 19/24.
// §11 Контракта секции: видимое поле под-панели «Текст → Размер» (text.size)
// приоритетнее СКРЫТОГО top-level textSize. До 25.09 в defaultProps лежал
// textSize:'medium' (в старых ревизиях так и лежит), и при обратном порядке он
// глушил выбор мерчанта наглухо.
const textSize = p.text?.size ?? p.textSize;
// Как у верстальщиков (владелец 24.09: «как у верстальщиков, только стили»): у
// верстальщика (Satin-theme @cb548963, TextBlock.astro:13-16) текст
// `.satin-copy md:text-[20px]`, но .satin-copy (16px, вне слоёв) перебивает
// утилиту — на экране 16px на любой ширине. Так рисуется только
// НЕ заданный «Размер текста» (у «Текст → Размер» в панели нет значения по
// умолчанию, панель его не вписывает); выбранный мерчантом — как раньше.
// Одна версия секции (владелец 25.09): прежняя ветка удалена.
const TEXT_CLS: Record<string, string> = {
	small: "text-[14px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))] md:text-[17px]",
	large: "text-[19px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))] md:text-[24px]",
	medium: "text-[16px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))] md:text-[20px]",
	designers: "text-[16px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))]",
};
const textCls =
	TEXT_CLS[textSize === "small" || textSize === "large" ? textSize : textSize === undefined ? "designers" : "medium"];

// Канон position/alignment: canon-default обоих = 'center' (его пишет коэрсер)
// И отсутствие = ЛИТЕРАЛ верстальщика — всё СЛЕВА во всю ширину satin-container
// (НЕ центр как у bloom; правило canon-default → пиксель верстальщика).
// Двигают только отличные значения: position left/right сужает колонку до
// текстовой ширины манеры max-w-[600px] (CollectionRows.astro:65) и прижимает
// auto-margin'ом; alignment right выравнивает содержимое вправо.
// Владелец 25.09 «что в панели — то и на витрине»: не заданная «Позиция»
// рисует значение панели по умолчанию — «По центру». Вид верстальщиков
// (блок во всю ширину 1320, прижат
// влево) не совпадает ни с одним вариантом панели: «Слева» — колонка 600
// (замер Chromium 25.09), поэтому ветки «не задано → вид верстальщиков» нет.
const position = p.position === "left" || p.position === "right" ? p.position : "center";
const POSITION_CLS: Record<string, { pos: string; align: string }> = {
	left: { pos: " max-w-[600px] mr-auto", align: " items-start text-left" },
	right: { pos: " max-w-[600px] ml-auto", align: " items-end text-right" },
	center: { pos: " mx-auto", align: " items-center text-center" },
};
const posCls = POSITION_CLS[position].pos;
const alignCls = POSITION_CLS[position].align;

// Канон textStyle (hidden): italic → курсив заголовка и текста.
const italicCls = p.textStyle === "italic" ? " italic" : "";

// Кнопка — одно правило для всех тем (theme-base runtime/main-text-button.ts):
// текст из поля панели «Кнопка → Текст», пусто — кнопки нет, заглушки «Кнопка»
// нет; старое скрытое cta — только пока поля «Кнопка» в секции нет вовсе.
// Ссылка-фоллбек /catalog.
const btnText = mainTextButtonText(p);
const btnHref =
	p.button?.link?.href ??
	(typeof p.button?.link === "string" && p.button.link ? p.button.link : undefined) ??
	(typeof p.cta?.href === "string" && p.cta.href ? p.cta.href : undefined) ??
	(typeof p.cta?.link === "string" && p.cta.link ? p.cta.link : undefined) ??
	"/catalog";
// «Кнопка» секции одна — цвета «Основной кнопки» схемы (Фон → фон, Текст →
// буквы, Обводка → рамка; data-scheme-button, src/themes/scheme-buttons.ts).
// Задача владельца 25.09: скрытый buttonStyle=outlined раньше делал её
// контуром «Дополнительной» с рамкой из поля «Текст».
// Метрики .satin-button-md (g:106-126): min-h 48, px-24, 16 400, hover 0.78.
const btnCls =
	"inline-flex min-h-12 w-fit items-center justify-center rounded-[var(--radius-button,0px)] border border-solid px-6 text-[16px] font-normal leading-none transition-opacity duration-[180ms] hover:opacity-[0.78]";

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе.
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;

// §4 Контракта секции: секция сама ставит свою цветовую схему. В превью
// конструктора блок перерисовывается БЕЗ обёртки композитора и иначе берёт
// :root (базовую палитру) — мерчант видит это как «поменял одну секцию, а
// соседние перекрасились». На live обёртка даёт ту же схему, дубль безвреден.
// Схема приходит строкой ИЛИ числом (нормализатор Slideshow) — разбираем оба.
const _rawScheme = p.colorScheme;
const _schemeId =
	typeof _rawScheme === "number"
		? String(_rawScheme)
		: typeof _rawScheme === "string" && _rawScheme
			? String(_rawScheme).replace("scheme-", "")
			: "";
const selfSchemeClass = _schemeId ? ` color-scheme-${_schemeId}` : "";


// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((p as any).hiddenFields)
	? ((p as any).hiddenFields as unknown[]).filter((x): x is string => typeof x === 'string')
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);
// Порядок заголовка/текста/кнопки из перетаскивания в конструкторе
// (props.fieldOrder, packages/theme-base/runtime/field-order.ts). Заголовок,
// текст и кнопка — плоские соседи одной колонки (gap-4), без общей обёртки —
// достаточно порядка полей. Без fieldOrder — прежняя разметка.
const textOrder = sectionFieldOrder("MainText", p);
---

<section
	class={`satin-pad w-full bg-[rgb(var(--color-bg,255_255_255))] py-12 md:py-16${selfSchemeClass}`}
	aria-label={heading || undefined}
	data-puck-component-id={id}
	style={paddingStyle}
>
	<div class="satin-container">
		<div class={`flex w-full flex-col gap-4${posCls}${alignCls}`}>
			{textOrder.map((field) => (
			<Fragment>
			{
				field === 'heading' && heading && !isFieldHidden('heading') && (
					<h2
						class={headingCls + italicCls}
						data-puck-subsection-parent={id}
						data-puck-subsection-index="100"
						data-puck-subsection-field="heading"
						set:html={inlineFormat(heading)}
					/>
				)
			}
			{field === 'text' && text && !isFieldHidden('text') && (
				<p
					class={textCls + italicCls}
					data-puck-subsection-parent={id}
					data-puck-subsection-index="101"
					data-puck-subsection-field="text"
					set:html={inlineFormat(text)}
				/>
			)}
			{
				field === 'button' && btnText && !isFieldHidden('button') && (
					<a
						href={btnHref}
						class={btnCls}
						data-scheme-button="primary"
						data-puck-subsection-parent={id}
						data-puck-subsection-index="102"
						data-puck-subsection-field="button"
					>
						{btnText}
					</a>
				)
			}
			</Fragment>
			))}
		</div>
	</div>
</section>
