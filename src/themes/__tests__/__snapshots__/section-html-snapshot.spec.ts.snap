roduct-id="\${escapeHtml(p.id)}"\${img2}>\${renderCardHtml(p, cardAspect, qaMode, qaText)}</li>\`; }).join(""); applyQaText(grid); } }; hydratePopular(); document.addEventListener("astro:page-load", hydratePopular); }</script>"`;

