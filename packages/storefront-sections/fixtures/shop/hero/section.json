{
  "sdk": 1,
  "name": "hero",
  "kind": "section",
  "title": "Первый экран",
  "wrapper": ["scheme", "padding"],
  "names": {
    "text-box": {
      "kinds": ["toggle"],
      "label": "Контейнер",
      "about": "Плашка под текстом на картинке: фон схемы, скруглённые углы, тень; выключена — текст прямо на картинке",
      "asks": ["контейнер", "плашка под текстом", "подложка под текстом", "рамка вокруг текста"]
    }
  },
  "settings": [
    {
      "id": "images",
      "label": "Изображения",
      "setting": {
        "kind": "image-pair",
        "default": {
          "url1": "",
          "url2": ""
        },
        "maxBytes": 2097152
      }
    },
    {
      "id": "height",
      "label": "Размер",
      "setting": {
        "kind": "select",
        "default": "large",
        "options": [
          { "value": "small", "label": "Маленький" },
          { "value": "medium", "label": "Средний" },
          { "value": "large", "label": "Большой" }
        ]
      }
    },
    {
      "id": "overlay",
      "label": "Затемнение",
      "setting": {
        "kind": "range",
        "default": 0,
        "min": 0,
        "max": 100,
        "step": 5
      }
    },
    {
      "id": "content-position",
      "label": "Позиция",
      "section": "Содержание",
      "setting": {
        "kind": "select",
        "default": "center-left",
        "options": [
          { "value": "top-left", "label": "Сверху слева" },
          { "value": "top-center", "label": "Сверху в центре" },
          { "value": "top-right", "label": "Сверху справа" },
          { "value": "center-left", "label": "По центру слева" },
          { "value": "center", "label": "По центру" },
          { "value": "center-right", "label": "По центру справа" },
          { "value": "bottom-left", "label": "Снизу слева" },
          { "value": "bottom-center", "label": "Снизу по центру" },
          { "value": "bottom-right", "label": "Снизу справа" }
        ]
      }
    },
    {
      "id": "align",
      "label": "Выравнивание",
      "setting": {
        "kind": "alignment",
        "default": "left"
      }
    },
    {
      "id": "text-box",
      "label": "Контейнер",
      "setting": {
        "kind": "toggle",
        "default": false,
        "labels": { "on": "Показать", "off": "Скрыть" }
      }
    },
    { "wrapper": "scheme" },
    { "wrapper": "padding" },
    {
      "id": "layout",
      "label": "Раскладка",
      "section": "Вид",
      "setting": {
        "kind": "select",
        "default": "overlay",
        "options": [
          { "value": "overlay", "label": "Текст на картинке" },
          { "value": "split", "label": "Текст рядом с картинкой" }
        ]
      }
    },
    {
      "id": "image-position",
      "label": "Картинка",
      "visibleWhen": { "setting": "layout", "equals": "split" },
      "setting": {
        "kind": "radio",
        "default": "right",
        "options": [
          { "value": "left", "label": "Слева" },
          { "value": "right", "label": "Справа" }
        ]
      }
    }
  ],
  "blocks": {
    "heading": {
      "title": "Заголовок",
      "limit": 1,
      "settings": [
        {
          "id": "heading",
          "label": "Заголовок",
          "setting": {
            "kind": "string",
            "default": "Добро пожаловать в наш магазин",
            "ai": "title"
          }
        },
        {
          "id": "heading-size",
          "label": "Размер заголовка",
          "setting": {
            "kind": "select",
            "default": "small",
            "options": [
              { "value": "small", "label": "Маленький" },
              { "value": "medium", "label": "Средний" },
              { "value": "large", "label": "Большой" }
            ]
          }
        }
      ]
    },
    "text": {
      "title": "Текст",
      "limit": 1,
      "settings": [
        {
          "id": "text",
          "label": "Текст",
          "setting": {
            "kind": "text",
            "default": "Собрали товары, которые любим сами. Выберите своё в каталоге — доставим удобным способом.",
            "ai": "description"
          }
        },
        {
          "id": "text-size",
          "label": "Размер текста",
          "setting": {
            "kind": "select",
            "default": "small",
            "options": [
              { "value": "small", "label": "Маленький" },
              { "value": "medium", "label": "Средний" },
              { "value": "large", "label": "Большой" }
            ]
          }
        }
      ]
    },
    "button": {
      "title": "Кнопка основная",
      "limit": 1,
      "settings": [
        {
          "id": "button-label",
          "label": "Текст",
          "setting": {
            "kind": "string",
            "default": "Перейти в каталог"
          }
        },
        {
          "id": "button-link",
          "label": "Ссылка",
          "setting": {
            "kind": "url",
            "default": "/catalog"
          }
        }
      ]
    },
    "button-second": {
      "title": "Кнопка дополнительная",
      "limit": 1,
      "settings": [
        {
          "id": "button-label",
          "label": "Текст",
          "setting": {
            "kind": "string",
            "default": "О нас"
          }
        },
        {
          "id": "button-link",
          "label": "Ссылка",
          "setting": {
            "kind": "url",
            "default": "/o-nas"
          }
        }
      ]
    }
  },
  "defaultBlocks": [
    {
      "type": "heading",
      "settings": {}
    },
    {
      "type": "text",
      "settings": {}
    },
    {
      "type": "button",
      "settings": {}
    }
  ]
}
