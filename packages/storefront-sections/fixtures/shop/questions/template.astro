---
const { settings, blocks } = Astro.props;
---
<div class="mx-auto flex max-w-page flex-col gap-4 px-4 font-body" data-behavior="accordion" data-animate="appear-group">
  <h2 class="m-0 font-heading weight-heading text-3xl text-heading">{settings.heading}</h2>
  {blocks.map((block, index) => (
    <details class="rounded-button bg-card p-4 text-card-foreground" open={settings['open-first'] && index === 0}>
      <summary class="cursor-pointer text-lg">{block.settings.question}</summary>
      <div data-part="content" class="mt-2" set:html={block.settings.answer}></div>
    </details>
  ))}
</div>
