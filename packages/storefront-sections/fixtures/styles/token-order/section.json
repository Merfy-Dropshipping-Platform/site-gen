    "spacing-custom-gap": { "kind": "spacing", "about": "Расстояние между образцами", "derive": { "rule": "alias", "from": "spacing-section" } },
    "text-custom-note": { "kind": "text", "about": "Размер примечания", "derive": { "rule": "alias", "from": "text-sm" } }
