{
  "$schema": "./generated/rebuild-events.schema.json",
  "events": [
    {
      "id": "merchant-publish",
      "title": "Мерчант публикует магазин",
      "trigger": { "file": "src/sites.microservice.controller.ts", "name": "sites.publish" },
      "themes": "all",
      "scope": "store",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "product-change",
      "title": "Правка товара: сейчас — полная пересборка через 45 с",
      "trigger": { "file": "src/listeners/product-update.listener.ts", "name": "debounceBuild" },
      "themes": "all",
      "scope": "dependent-pages",
      "delayMs": 45000,
      "status": "works"
    },
    {
      "id": "theme-change",
      "title": "Смена темы у опубликованного сайта: перепубликация сразу",
      "trigger": { "file": "src/sites.microservice.controller.ts", "name": "sites.update_site" },
      "themes": "all",
      "scope": "store",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "branding-change",
      "title": "Брендинг у опубликованного сайта: фавиконы, цвета, SEO главной — перепубликация через 8 с",
      "trigger": { "file": "src/sites.service.ts", "name": "scheduleBrandingRepublish" },
      "themes": "all",
      "scope": "store",
      "delayMs": 8000,
      "status": "works"
    },
    {
      "id": "theme-release",
      "title": "Выпуск версии темы волнами: магазин волны получает новую версию (блок 10)",
      "trigger": { "file": "packages/storefront-builder/src/release/kinds.ts", "name": "theme-release" },
      "themes": "new",
      "scope": "theme-stores",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "platform-release",
      "title": "Выпуск кода платформы волнами: новый образ сборщика (блок 10)",
      "trigger": { "file": "packages/storefront-builder/src/release/kinds.ts", "name": "platform-release" },
      "themes": "new",
      "scope": "theme-stores",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "extension-release",
      "title": "Выпуск версии расширения волнами: команда theme-release extension (блок 10)",
      "trigger": { "file": "packages/storefront-builder/src/release/kinds.ts", "name": "extension-release" },
      "themes": "new",
      "scope": "theme-stores",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "section-release",
      "title": "Выпуск нашей секции волнами: команда theme-release section, магазины с её копией (блок 15)",
      "trigger": { "file": "packages/storefront-builder/src/release/kinds.ts", "name": "section-release" },
      "themes": "new",
      "scope": "theme-stores",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "section-rollback",
      "title": "Откат секции с ролью по ошибкам из браузеров: прежняя опубликованная правка снова на витрине (блок 12)",
      "trigger": { "file": "packages/storefront-builder/src/role-rollback.ts", "name": "section-rollback" },
      "themes": "new",
      "scope": "store",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "domain-change",
      "title": "Смена домена магазина: подключение — switchDomain, отключение — restoreFallbackDomain",
      "trigger": { "file": "src/sites.service.ts", "name": "switchDomain" },
      "themes": "new",
      "scope": "store",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "shop-name-change",
      "title": "Смена имени магазина",
      "trigger": { "file": "src/sites.microservice.controller.ts", "name": "sites.update_site" },
      "themes": "new",
      "scope": "store",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "policy-change",
      "title": "Правка политики: страницы /legal/* и ссылки подвала на каждой странице",
      "trigger": { "file": "src/policy/policy.service.ts", "name": "upsert" },
      "themes": "new",
      "scope": "store",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "contacts-change",
      "title": "Правка контактов и реквизитов: подвал на каждой странице",
      "trigger": { "file": "src/policy/contacts.service.ts", "name": "upsert" },
      "themes": "new",
      "scope": "store",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "publication-change",
      "title": "Публикация блога: создана, изменена или удалена",
      "trigger": { "file": "src/publications/publications.service.ts", "name": "triggerRebuild" },
      "themes": "new",
      "scope": "dependent-pages",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "collection-change",
      "title": "Коллекция: создание, имя, slug, описание, порядок товаров, удаление",
      "trigger": {
        "service": "product",
        "description": "CollectionsService: create, update, remove, reorderProducts — событие collection.updated"
      },
      "themes": "new",
      "scope": "dependent-pages",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "payment-settings-change",
      "title": "Настройки оплаты магазина: значок кассы в подвале",
      "trigger": { "service": "billing", "description": "смена кассы магазина" },
      "themes": "new",
      "scope": "store",
      "delayMs": 0,
      "status": "with-sections"
    },
    {
      "id": "stock-change",
      "title": "Остаток товара: только переход «в наличии ↔ нет»",
      "trigger": {
        "service": "product",
        "description": "InventoryService.adjustInventory — событие product.availability_changed на переходе «в наличии ↔ нет»"
      },
      "themes": "new",
      "scope": "dependent-pages",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "extension-toggle",
      "title": "Расширение включили или выключили: его секции, глобальные скрипты и описания ctx.ext — пересборкой (блок 12)",
      "trigger": { "file": "src/extension-sections/extension-sections.controller.ts", "name": "sites.extension.toggled" },
      "themes": "new",
      "scope": "store",
      "delayMs": 0,
      "status": "works"
    },
    {
      "id": "analytics-counters-change",
      "title": "Счётчики и «свой код» мерчанта: добавил, поменял номер, код или отметку согласия, выключил или удалил",
      "trigger": {
        "service": "analytics-collector",
        "description": "RPC analytics.pixels.create, update, delete: событие после успешной правки"
      },
      "themes": "new",
      "scope": "store",
      "delayMs": 0,
      "status": "works"
    }
  ]
}
