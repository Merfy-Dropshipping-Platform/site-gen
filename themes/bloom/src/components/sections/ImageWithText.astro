---
import { inlineFormat } from "../../lib/rich-text";
// Фаза B (bloom): новая канон-секция ImageWithText в манере bloom (см.
// themes/bloom/MANNER.md). Секции нет у верстальщика — композиция из манеры:
// сетка секций §2 (поля px-4 md:px-20 2xl:px-[300px], вертикаль 80/120),
// медиа-паттерны галереи §4 (rounded 12, плейсхолдер #F5F5F5, hover-zoom 1.03,
// зазор грида gap-4), типографика §1, розовый pill §3. Схема полей =
// packages/theme-base/blocks/ImageWithText/ImageWithText.puckConfig.ts.
const p = Astro.props as Record<string, any>;
const id = p.id;
// Своя colorScheme на корне секции: при hot-render одиночного блока в превью
// обёртки композитора НЕТ, и секция берёт :root — соседние секции «перекрашиваются»
// от правки чужой настройки. На live обёртка даёт ту же схему, дубль безвреден
// (паттерн rose Footer / theme-base Video).
// colorScheme приходит строкой ("scheme-4") ИЛИ числом (нормализатор Slideshow
// приводит к номеру) — разбираем оба вида, иначе класс молча не ставится.
const _rawScheme = p.colorScheme;
const _schemeId =
	typeof _rawScheme === "number"
		? String(_rawScheme)
		: typeof _rawScheme === "string" && _rawScheme
			? String(_rawScheme).replace("scheme-", "")
			: "";
const selfSchemeClass = _schemeId ? ` color-scheme-${_schemeId}` : "";

// heading: string | { text, alignment, size }; text: string | { content, size }.
// Figma 1:19335 — ПУСТОЕ состояние секции «Изображение с текстом»: дословные
// плейсхолдеры «Изображение с текстом» / «Покажи и расскажи о своем товаре в одном
// блоке» / кнопка «Кнопка» (НЕ дефолт-копирайт верстальщика «Расскажите о товаре» /
// «Опишите преимущества продукта…»). Мерчант задал свой heading/text/button → его
// и рендерим (ветки union ниже сохраняются).
const heading =
	(typeof p.heading === "string" ? p.heading : p.heading?.text)?.trim() || "Изображение с текстом";
const text =
	(typeof p.text === "string" ? p.text : p.text?.content)?.trim() ||
	"Покажи и расскажи о своем товаре в одном блоке";

// Канон heading.size — роль «заголовок секции» (Urbanist uppercase, розовый на
// белом, МАННЕРА §1). Лестница §9: medium/отсутствие = литерал роли 18/md:20,
// small 15/17, large 22/24.
const headingSize = p.heading?.size ?? p.headingSize;
const headingCls =
	headingSize === "small"
		? "font-urbanist text-[15px] font-normal leading-none text-[rgb(var(--color-heading,227_142_159))] md:text-[17px]"
		: headingSize === "large"
			? "font-urbanist text-[22px] font-normal leading-none text-[rgb(var(--color-heading,227_142_159))] md:text-[24px]"
			: "font-urbanist text-[18px] font-normal leading-none text-[rgb(var(--color-heading,227_142_159))] md:text-[20px]";
// Канон heading.alignment: отсутствие = left (текстовая колонка манеры).
// Панель шлёт видимое поле «Выравнивание» как `alignment` — читаем его ПЕРВЫМ
// (паритет rose ImageWithText), иначе контрол мёртв.
const headingAlignment = p.alignment ?? p.headingAlignment ?? p.heading?.alignment;
const headingAlignCls =
	headingAlignment === "center" ? " text-center" : headingAlignment === "right" ? " text-right" : "";
// «Выравнивание» — поле СЕКЦИИ, а не заголовка: применяется к заголовку, тексту
// И кнопке (паритет rose). До 2026-09-21 порт красил только заголовок — мерчант
// ставил «по центру», текст и кнопка оставались слева (§12 контракта секции:
// видимое поле обязано доезжать целиком, а не наполовину).
const ctaAlignCls =
	headingAlignment === "center" ? " self-center" : headingAlignment === "right" ? " self-end" : "";

// Канон text.size — body-роль (Inter 300, МАННЕРА §1). Лестница §9: medium
// (canon-default) и отсутствие = литерал 16, small 14, large 19.
const textSize = p.textSize ?? p.text?.size;
const textCls =
	textSize === "small"
		? "font-inter text-[14px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))]"
		: textSize === "large"
			? "font-inter text-[19px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))]"
			: "font-inter text-[16px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))]";

// Канон textStyle (hidden): italic → курсив заголовка и текста.
const italicCls = p.textStyle === "italic" ? " italic" : "";

// Канон image {url, alt}: мерчант выбрал фото → рендерим <img>. Плейсхолдер
// (Figma 1:19335): без выбранной картинки = дизайн-ассет /placeholders/landscape-iwt.png
// (раздаётся на каждой теме из packages/theme-base/public/placeholders, copyPublic),
// а НЕ пустая surface и НЕ мок-фото верстальщика (контракт картиночных секций,
// эталон rose ImageWithText.astro). Картинка показывается ВСЕГДА (гард {hasImage &&
// <img>} остаётся, но imageUrl при пустом состоянии = ассет → hasImage всегда true).
const PLACEHOLDER_IWT_IMAGE = "/placeholders/landscape-iwt.png";
const imageUrl =
	typeof p.image?.url === "string" && p.image.url.trim() ? p.image.url : PLACEHOLDER_IWT_IMAGE;
const hasImage = imageUrl !== "";
const imageAlt = typeof p.image?.alt === "string" && p.image.alt.trim() ? p.image.alt : heading;

// Канон imagePosition: canon-default 'right' (theme.json blockDefaults) и
// отсутствие = дефолт-композиция bloom: текст слева, КАРТИНКА СПРАВА. 'left'
// зеркалит. На мобиле картинка всегда сверху (медиа первым в DOM).
const imageLeft = p.imagePosition === "left";

// Канон size (s/m/l) — аспект медиа лестницей манеры §4: medium (дефолт) =
// высокая плитка галереи 652/594 (литерал), small = широкое 16/9, large = квадрат.
const aspectCls =
	p.size === "small" ? "aspect-[16/9]" : p.size === "large" ? "aspect-square" : "aspect-[652/594]";

// Канон width (s/m/l/full): дефолт/large = 1320 (контейнер манеры §2),
// medium 1080, small 780, full — без лимита (поля секции остаются).
const widthCls =
	p.width === "small"
		? "max-w-[780px]"
		: p.width === "medium"
			? "max-w-[1080px]"
			: p.width === "full"
				? "max-w-none"
				: "max-w-[1320px]";

// Владелец 2026-09-17/b79, дословно: «Давай по 22-му назовём не "Раскладка",
// а "Контейнер", как везде. То есть вместо раскладки контейнер. Вот этот,
// который вкл-выкл наш» — тумблер вернул своё имя и вид (Показать/Скрыть),
// поведение (карточка наезжает на фото) не менялось.
// `containerEnabled`: 'false' (дефолт, прежнее поведение — колонки бок о
// бок) | 'true' (карточка наезжает на фото). Легаси `layout` читается как
// fallback в обе стороны обратной совместимости:
//   - сайты, сохранённые ДО 15.09 (или заново после b79) с containerEnabled —
//     читаются напрямую (приоритет №1);
//   - сайты, сохранённые МЕЖДУ 15.09 и 17.09 только с layout='overlap'
//     (containerEnabled тогда не существовал) — фолбэк №2.
// §5 контракта секции: тумблер приходит и строкой ('true'/'false' — формат
// поля toggle), и boolean (панель конструктора шлёт его так). Ветка только на
// строку означала бы «переключатель не даёт эффекта» — гейт
// scripts/section-contract-check.mjs на это и ругался.
const isOverlap =
	p.containerEnabled === true || p.containerEnabled === "true"
		? true
		: p.containerEnabled === false || p.containerEnabled === "false"
			? false
			: p.layout === "overlap";
// Канон position: 'top' | 'middle' (дефолт, прежнее lg:items-center) | 'bottom'
// — вертикальное положение карточки относительно фото (Shopify Position).
const position = p.position === "top" ? "top" : p.position === "bottom" ? "bottom" : "middle";
const positionItemsCls =
	position === "top" ? "lg:items-start" : position === "bottom" ? "lg:items-end" : "lg:items-center";
// Наложение: карточка стоит в потоке и ЗАДАЁТ высоту пары, фото — абсолютный
// слой на всю высоту пары. «Положение» двигает карточку по вертикали тем же
// `positionItemsCls`, что и в раскладке без наложения (карточка — единственный
// элемент потока, значит items-* выравнивает именно её); разница видна, когда
// «Размер» держит медиа выше карточки.

// Карточка с подложкой в режиме наложения (иначе текст нечитаем на фото) —
// тот же surface-класс, что раньше давал тумблер «Контейнер».
// Тени на эталоне нет: карточка и фото стыкуются чистой кромкой (снимки 1-6,
// граница наезда без размытия). shadow-xl был нужен прежней раскладке, где
// карточка лежала ЦЕЛИКОМ на фото и без тени сливалась с ним.
const containerSurfaceCls = isOverlap
	? " rounded-[var(--radius-card,12px)] bg-[rgb(var(--color-surface,255_255_255))] px-6 py-8"
	: "";
const containerSchemeCls =
	isOverlap && typeof p.containerColorScheme === "string" && p.containerColorScheme
		? ` color-scheme-${String(p.containerColorScheme).replace("scheme-", "")}`
		: "";

// Пропорция «карточка / фото» при наложении (эталон владельца 2026-09-21,
// шесть снимков; замер PIL по розовой плашке и кромке фото, вьюпорт снимка
// 1280):
//   Ширина=Большая — карточка 655, фото 287, пара 876, наезд 66
//   Ширина=Средняя — карточка 508  (пара и наезд те же)
//   Ширина=Маленькая — карточка 358, фото 582, пара 875, наезд 65
// В долях пары: карточка 40 / 58 / 75 %, фото 67.5 / 49.5 / 32.5 %. Сумма
// каждой пары — 107.5 %, то есть НАЕЗД РОВНО 7.5 % ширины пары при любой
// «Ширине» (на снимках он и не плавает: 65-67 px из 876).
// Важно: сумма долей > 100 % и даёт наезд сама — отдельного отрицательного
// margin не нужно, фото абсолютное и прижато к своей стороне.
const overlapCardWidthCls =
	p.width === "small" ? "lg:w-[40%]" : p.width === "large" ? "lg:w-[75%]" : "lg:w-[58%]";
const overlapPhotoWidthCls =
	p.width === "small" ? "lg:w-[67.5%]" : p.width === "large" ? "lg:w-[32.5%]" : "lg:w-[49.5%]";
// Фото прижато к своей стороне пары и растянуто на её высоту; карточка стоит
// с противоположной стороны в потоке.
const overlapPhotoSideCls = imageLeft ? "lg:left-0" : "lg:right-0";
const overlapCardSideCls = imageLeft ? "lg:ml-auto" : "lg:mr-auto";
// Вертикальный вылет фото за карточку: на снимках 27-30 px при паре 876, то
// есть 3.3 % её ширины. Наша пара на 1440-м вьюпорте — 1280 px, те же 3.3 %
// дают 40 px (lg:my-10). Считаем от эталонной ДОЛИ, а не от его пикселей:
// снимки владельца сняты в превью конструктора, там пара уже окна.
const overlapCardInsetCls = "lg:my-10";
// «Размер» при наложении держит НИЖНЮЮ границу высоты пары: короткий текст не
// должен схлопывать фото в полоску. Опора — снимок №4 эталона: карточка 248,
// медиа всё равно 430 (49 % ширины пары), то есть высоту там держала именно
// эта граница. 49 % от нашей пары 1280 = 630 px — ступень «Средний»; соседние
// ступени на снимках не встречались, взяты тем же шагом ±20 %.
const overlapMinHCls =
	p.size === "small" ? "lg:min-h-[520px]" : p.size === "large" ? "lg:min-h-[760px]" : "lg:min-h-[630px]";
// Ширина ПАРЫ при наложении постоянна: на всех шести снимках она 875-876 px,
// меняется только доля карточки внутри неё. Поэтому «Ширина» в этом режиме
// правит пропорцию (выше), а не потолок блока — иначе «Маленькая» ужимала бы
// и фото тоже, чего на эталоне нет. Без наложения `width` работает как прежде.
const outerWidthCls = isOverlap ? "max-w-[1320px]" : widthCls;

// Кнопка: canon button {text, href|link} — розовый pill манеры §3. Мерчант задал
// текст → его; пусто → дословный Figma-плейсхолдер «Кнопка» (1:19335). Кнопка
// рендерится всегда (часть дизайна пустого состояния), как «Кнопка» в
// MainText/Slideshow/Hero плейсхолдерах (паритет rose ImageWithText).
const btnText =
	typeof p.button?.text === "string" && p.button.text.trim() ? p.button.text : "Кнопка";
// §11 Контракта секции: ссылку пишет ВИДИМОЕ поле панели «Кнопка → Ссылка»
// (button.link, pagePicker). Legacy button.href лежит в defaultProps темы
// («/about») и при обратном порядке глушил выбор мерчанта наглухо: ссылку в
// под-панели меняешь — на превью остаётся дефолт.
const btnHref =
	p.button?.link?.href ??
	(typeof p.button?.link === "string" && p.button.link ? p.button.link : undefined) ??
	(typeof p.button?.href === "string" && p.button.href ? p.button.href : undefined) ??
	"/catalog";

// Канон ctaPosition (скрытое поле панели): 'inline' (canon-default блока) и
// отсутствие = кнопка сразу под текстом; 'bottom-pinned' — кнопка прижата к
// нижней кромке текстовой колонки (mt-auto, колонка h-full).
// blockDefaults темы держали 'bottom-pinned', и на дефолтных данных между
// текстом и кнопкой зияло 460px (замер Chromium 1440px; rose 32, flux 40).
// Это не особенность порта: с тем же пропом rose даёт 524px, flux 449px —
// значение сняли из theme.json, порт остался прежним.
const inlineCta = p.ctaPosition !== "bottom-pinned";

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе.
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;

const titleId = id ? `${id}-title` : undefined;

// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((p as any).hiddenFields)
	? ((p as any).hiddenFields as unknown[]).filter((x): x is string => typeof x === 'string')
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);
---

<section
	class={`w-full bg-[rgb(var(--color-bg,255_255_255))] px-4 py-20 md:px-20 md:py-[120px] 2xl:px-[300px]${selfSchemeClass}`}
	aria-labelledby={titleId}
	data-puck-component-id={id}
	style={paddingStyle}
>
	<div
		{/* lg:gap-10 — зазор пары по эталону rose (владелец 2026-09-15: «как пример работы можешь брать у розы»). rose держит 40px при всех трёх «Ширинах» в обоих блоках семьи; у bloom было 16px (`gap-4` без lg-ступени).
		    Мобильный `gap-4` не трогаем — на 375px пара стоит в стопку (и при containerEnabled='true' наезда на мобиле НЕТ — карточка идёт обычным блоком под фото). */}
		{/* Порядок как у rose: `lg:items-center`/`positionItemsCls` НЕ последний перед интерполяцией.
		    Класс, приклеенный к `${`, сканер Tailwind не извлекает — утилита не попадает
		    в бандл темы, и правило молча не работает (у bloom так и было после main 4d4a11ce). */}
		class={
			isOverlap
				? `relative mx-auto flex w-full ${outerWidthCls} flex-col gap-4 ${overlapMinHCls} lg:flex-row ${positionItemsCls} lg:gap-0`
				: `mx-auto grid w-full ${outerWidthCls} grid-cols-1 gap-4 lg:grid-cols-2 ${positionItemsCls} lg:gap-10`
		}
		data-animate
	>
		{!isFieldHidden('image') && (
		<div
			class={
				isOverlap
					? `group relative w-full overflow-hidden rounded-[var(--radius-media,12px)] bg-[rgb(var(--color-surface,245_245_245))] ${aspectCls} lg:absolute lg:inset-y-0 lg:aspect-auto ${overlapPhotoWidthCls} ${overlapPhotoSideCls}`
					: `group relative w-full overflow-hidden rounded-[var(--radius-media,12px)] bg-[rgb(var(--color-surface,245_245_245))] ${aspectCls}${imageLeft ? "" : " lg:order-2"}`
			}
			data-puck-subsection-parent={id}
			data-puck-subsection-index="100"
			data-puck-subsection-field="image"
		>
			{hasImage && (
				<img
					src={imageUrl}
					alt={imageAlt}
					loading="lazy"
					class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
				/>
			)}
		</div>
		)}

		<div
			class={
				isOverlap
					? `relative z-10 flex w-full flex-col gap-6 ${overlapCardWidthCls} ${overlapCardSideCls} ${overlapCardInsetCls}${containerSurfaceCls}${containerSchemeCls}`
					: `flex w-full flex-col gap-6${inlineCta ? "" : " h-full"}${imageLeft ? "" : " lg:order-1"}${containerSurfaceCls}${containerSchemeCls}`
			}
		>
			{!isFieldHidden('heading') && (
				<h2
					id={titleId}
					class={headingCls + headingAlignCls + italicCls}
					data-puck-subsection-parent={id}
					data-puck-subsection-index="101"
					data-puck-subsection-field="heading"
					set:html={inlineFormat(heading)}
				></h2>
			)}
			{!isFieldHidden('text') && (
				<div
					class={textCls + italicCls + headingAlignCls}
					data-puck-subsection-parent={id}
					data-puck-subsection-index="102"
					data-puck-subsection-field="text"
					set:html={inlineFormat(text)}
				/>
			)}
			{
				btnText && (
					<div class={(inlineCta ? "mt-2" : "mt-auto") + ctaAlignCls}>
						{!isFieldHidden('button') && (
						<a
							href={btnHref}
							class="inline-flex h-12 items-center justify-center rounded-[var(--radius-button,100px)] bg-[rgb(var(--color-button-bg,227_142_159))] px-6 font-inter text-[16px] font-light leading-none text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-90 active:scale-95"
							data-puck-subsection-parent={id}
							data-puck-subsection-index="103"
							data-puck-subsection-field="button"
						>
							{btnText}
						</a>
						)}
					</div>
				)
			}
		</div>
	</div>
</section>
