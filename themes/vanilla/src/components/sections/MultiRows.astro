---
import { inlineFormat } from "../../lib/rich-text";
import { schemeIdOf } from "../../lib/color-scheme";
// Фаза B (vanilla): новая канон-секция MultiRows в манере vanilla (см.
// themes/vanilla/MANNER.md §10: секции нет у верстальщика — ряды «текст +
// медиа» по паттерну care-бэнда Gallery.astro:82-123 / about-сплита, с
// чередованием сторон). Светлая секция §2, медиа 652/366 без радиуса на тоне
// плейсхолдера §4, типографика §1, solid-CTA §3. Процесс-эталон — bloom
// MultiRows. Схема полей = packages/theme-base/blocks/MultiRows/
// MultiRows.puckConfig.ts.
const p = Astro.props as Record<string, any>;
const id = p.id;

// Канон top-heading: string | { text, alignment, size } (+ legacy
// _headingLegacy). Figma 1:19335 — ПУСТОЕ состояние секции «Мультиряды»:
// дословный заголовок «Мультиряды» (а НЕ отсутствие шапки / дефолт-копирайт
// верстальщика). Мерчант задал свой heading → его и рендерим (?? срабатывает
// только при пустых данных). Роль = заголовок секции на светлом (Bitter italic
// 20 #26311C, Col:20). Лестница §9: medium/отсутствие = литерал 20, small 17,
// large 24.
const heading =
	(typeof p.heading === "string" ? p.heading : p.heading?.text) ?? p._headingLegacy ?? "Мультиряды";
// Панель пишет размер в top-level `headingSize` (select), `heading` = aiText-строка.
// Читаем top-level ПЕРВЫМ — иначе легаси-объект heading.size из старых ревизий
// перебивает выбор мерчанта и настройка выглядит мёртвой. Тот же механизм, что
// у Collections.headingSize во всех темах и у MultiRows в bloom.
const headingSize = p.headingSize ?? p.heading?.size;
const headingSizeCls =
	headingSize === "small" ? "text-[17px]" : headingSize === "large" ? "text-[24px]" : "text-[20px]";
const headingAlignment = p.headingAlignment ?? p.heading?.alignment;
const headingAlignCls =
	headingAlignment === "center" ? " text-center" : headingAlignment === "right" ? " text-right" : "";
const headingCls = `font-vanilla-bitter ${headingSizeCls} font-normal italic leading-none tracking-normal text-[rgb(var(--color-heading,38_49_28))]${headingAlignCls}`;

// ──────────────────────────────────────────────────────────────────────────
// Гейт пустого состояния (Figma 1:19335 / 1:19953 — empty-state ЗАМЕНЯЕТ мок
// верстальщика). Данные этой секции = массив РЯДОВ. Пока мерчант не наполнил
// rows[] — секция в плейсхолдер-режиме: пустые surface-rect + дефолтные лейблы
// контракта Мультирядов («Изображение с текстом» / «Покажи и расскажи о своём
// товаре в одном блоке» / Кнопка), НЕ дизайнерский мок-бэнд верстальщика
// (текстиль/декор + реальные фото). Как только ряды заданы — рендер реальных
// данных без изменений. Эталон гейта: Collections.astro (hasManualCollections),
// PopularProducts.astro (collectionRef → DEMO_PRODUCTS).
const hasManualRows = Array.isArray(p.rows) && p.rows.length > 0;

// Канон rows[] 1-10 (item: heading|title, text|description, imageUrl|image,
// imagePosition, button {text, href|link}, size per-item, headingSize/textSize).
// Отсутствие массива → ПЛЕЙСХОЛДЕР контракта: 2 пустых ряда-болванки (лейблы
// Мультирядов), чередование лево/право. НЕ реальные заголовки/фото верстальщика.
// Дизайн-ассет фото ряда (Figma 1:19335) — раздаётся на каждой теме как
// /placeholders/landscape-multirows-image.png. Контракт картиночных секций:
// фото показывается ВСЕГДА (НЕ пустой surface-rect, НЕ мок верстальщика).
const PLACEHOLDER_ROW_IMAGE = "/placeholders/landscape-multirows-image.png";
const PLACEHOLDER_ROWS = [
	{
		id: "ph-row-1",
		heading: "Изображение с текстом",
		text: "Покажи и расскажи о своем товаре в одном блоке",
		imageUrl: PLACEHOLDER_ROW_IMAGE,
		imagePosition: "left",
		button: { text: "Кнопка", href: "/catalog" },
	},
	{
		id: "ph-row-2",
		heading: "Изображение с текстом",
		text: "Покажи и расскажи о своем товаре в одном блоке",
		imageUrl: PLACEHOLDER_ROW_IMAGE,
		imagePosition: "right",
		button: { text: "Кнопка", href: "/catalog" },
	},
];
const rawRows = hasManualRows ? p.rows : PLACEHOLDER_ROWS;

// Канон «Позиция рядов»: ряды ВСЕГДА чередуют сторону медиа по индексу. Свитчер
// (Слева/Справа) задаёт сторону ТОЛЬКО первого ряда (i=0). per-item imagePosition
// больше не учитываем (нет в UI).
const firstRowRight = p.rowsPosition === "right";

// Канон size (s/m/l) — аспект медиа ряда (топ-уровень, per-item приоритетнее).
// Лестница как у ImageWithText: medium/отсутствие = фото care-бэнда 652/366
// (литерал §4), small = широкое 16/9, large = квадрат.
const aspectFor = (s: string | undefined) =>
	s === "small" ? "aspect-[16/9]" : s === "large" ? "aspect-square" : "aspect-[652/366]";

// Фоллбек-ассеты дизайнера для РЯДА С ДАННЫМИ, но без выбранного фото (реальный
// ряд мерчанта → красивая болванка, принцип T15 rose). В плейсхолдер-режиме
// (hasManualRows=false) НЕ применяется — там пустой surface-rect по контракту.
// .webp — на диске после images:optimize (под Container API fs-резолв
// VanillaPicture недоступен).
const ROW_FALLBACKS = ["/images/vanilla-collection-textile.webp", "/images/vanilla-collection-decor.webp"];

// Шкалы per-item размеров: заголовок ряда = роль заголовка секции (лестница
// §9: 17/20*/24); текст = body-роль 16 (small 14, large 19).
const rowHeadingSizeCls = (s: string | undefined) =>
	s === "small" ? "text-[17px]" : s === "large" ? "text-[24px]" : "text-[20px]";
const rowTextSizeCls = (s: string | undefined) =>
	s === "small" ? "text-[14px]" : s === "large" ? "text-[19px]" : "text-base";

const rows = rawRows.slice(0, 10).map((r: any, i: number) => {
	const btnText =
		typeof r.button?.text === "string" && r.button.text.trim() ? r.button.text : undefined;
	return {
		heading:
			(typeof r.heading === "string" && r.heading) || (typeof r.title === "string" && r.title) || "",
		text:
			(typeof r.text === "string" && r.text) ||
			(typeof r.description === "string" && r.description) ||
			"",
		image:
			(typeof r.imageUrl === "string" && r.imageUrl.trim()) ||
			(typeof r.image === "string" && r.image.trim()) ||
			// Реальный ряд без фото → дизайнерский фоллбек. Плейсхолдер-ряды уже
			// несут PLACEHOLDER_ROW_IMAGE (берётся первой веткой выше), поэтому
			// сюда в пустом состоянии не попадают.
			(hasManualRows ? ROW_FALLBACKS[i % ROW_FALLBACKS.length] : PLACEHOLDER_ROW_IMAGE),
		right: firstRowRight ? i % 2 === 0 : i % 2 === 1,
		aspectCls: aspectFor(
			// «Как в секции» (inherit) и отсутствие → высота берётся у секции.
			// Раньше собственный размер ряда стоял в дефолтах и молча перебивал
			// общую настройку «Высота» — она выглядела мёртвой.
			r.size && r.size !== "inherit" ? r.size : p.size,
		),
		headingCls: rowHeadingSizeCls(r.headingSize),
		textCls: rowTextSizeCls(r.textSize),
		btnText,
		btnHref:
			(typeof r.button?.href === "string" && r.button.href ? r.button.href : undefined) ??
			r.button?.link?.href ??
			(typeof r.button?.link === "string" && r.button.link ? r.button.link : undefined) ??
			"/catalog",
	};
});

// Канон width (s/m/l/full): large/отсутствие = 1320 (.vanilla-container,
// контейнер манеры §2 без сужения), medium 1080, small 780, full — без лимита.
const widthCls =
	p.width === "small"
		? "max-w-[780px]"
		: p.width === "medium"
			? "max-w-[1080px]"
			: p.width === "full"
				? "max-w-none"
				: "max-w-[1320px]";

// Владелец 2026-09-17 (дословно): «контейнер и медиа соприкасаются, если медиа
// маленького размера, контейнер берёт на себя больше места и так же наоборот».
// Тот же топ-уровневый проп «Ширина» (widthCls выше не трогаем — он держит
// потолок ряда) теперь ДОПОЛНИТЕЛЬНО задаёт ДОЛЮ медиа внутри пары: small —
// медиа уже текста (2:3 ⇒ 40%), medium — примерно половина (1:1, эталон
// владельца), large — медиа шире текста (3:2 ⇒ 60%). Доли — литералы в
// ОБЪЕКТЕ (не конкатенация числа в шаблонной строке): сканер Tailwind ищет
// ЦЕЛЫЙ класс текстом в исходнике, а `grid-cols-[${a}fr_${b}fr]` с
// подставленным числом в бандл не попадёт (тот же класс-призрак, что уже
// ловили на lg:basis-1/2 — см. media-text-pair.spec.ts).
const ROW_SPLIT: Record<"small" | "medium" | "large", { mediaFirst: string; textFirst: string }> = {
	small: { mediaFirst: "lg:grid-cols-[2fr_3fr]", textFirst: "lg:grid-cols-[3fr_2fr]" },
	medium: { mediaFirst: "lg:grid-cols-[1fr_1fr]", textFirst: "lg:grid-cols-[1fr_1fr]" },
	large: { mediaFirst: "lg:grid-cols-[3fr_2fr]", textFirst: "lg:grid-cols-[2fr_3fr]" },
};
// Отсутствие значения ведёт себя как «Большая» — ровно так же, как потолок
// ряда выше (widthCls: без width = max-w-[1320px], то есть large). Раньше доля
// при отсутствии падала в "medium", и секция без настройки брала потолок
// большой ширины с долей средней — два разных ответа на один и тот же «проп не
// задан». Гард дефолтов панели это и поймал: рендер со значением и без него
// расходился (pnpm test:panel-defaults, MultiRows.width).
const rowSplitKey: "small" | "medium" | "large" =
	p.width === "small" ? "small" : p.width === "medium" ? "medium" : "large";

// Канон alignment — выравнивание текстовой колонки рядов (отсутствие = left,
// манера vanilla — всё слева, items-start).
const alignCls =
	p.alignment === "center"
		? "items-center text-center"
		: p.alignment === "right"
			? "items-end text-right"
			: "items-start text-left";

// Канон buttonStyle: solid/primary/black/отсутствие = solid-CTA манеры §3
// (bg полотна №2 #3A4530, белый текст, h-12 px-4 Arsenal 16 uppercase);
// outlined = бордер цвета заливки на прозрачном; white = кнопка-2 (белая
// заливка, текст цвета полотна №2). Радиус 0 ≡ var(--radius-button,0px);
// active:scale в манере НЕ используется (§3).
const btnBase =
	"inline-flex h-12 min-h-12 items-center justify-center rounded-[var(--radius-button,0px)] px-4 font-vanilla-arsenal text-base font-normal leading-none tracking-normal transition-opacity hover:opacity-90";
const btnCls =
	p.buttonStyle === "outlined"
		? `${btnBase} border border-[rgb(var(--color-button-bg,58_69_48))] bg-transparent text-[rgb(var(--color-button-bg,58_69_48))]`
		: p.buttonStyle === "white"
			? `${btnBase} bg-[rgb(var(--color-button-2-bg,255_255_255))] text-[rgb(var(--color-button-2-text,58_69_48))]`
			: `${btnBase} bg-[rgb(var(--color-button-bg,58_69_48))] text-[rgb(var(--color-button-text,255_255_255))]`;

// Канон containerEnabled (toggle; puckConfig готов). ИСПРАВЛЕНИЕ (per-element,
// эталон bloom MultiColumns): ВКЛ → surface-бокс манеры vanilla (#ECEBE7,
// плоский — radius-card 0) на КАЖДЫЙ ряд (<li>); класс схемы — на ОБЁРТКЕ
// СПИСКА (<ul>), внешний div с заголовком без бокса/схемы. ВЫКЛ — без бокса/
// схемы (работает основная секционная схема). Canon-default отсутствует → false.
const containerEnabled = String(p.containerEnabled ?? "false") === "true";
// Схема КОНТЕЙНЕРА (п.2 тестировщика 2026-09-13). «Контейнер» мультирядов — это
// ВСЯ половина ряда напротив медиа, поэтому класс висит на текстовой колонке, а
// не на <ul>: на <ul> он красил заодно и подложку картинки.
// Тоггла «Контейнер» в панели мультирядов НЕТ (`containerEnabled` — hidden-поле,
// см. MultiRows.puckConfig.ts), поэтому схема им НЕ гейтится: иначе видимый
// контрол «Цветовая схема контейнера» не делал бы ничего. Значение принимаем и
// строкой, и числом — см. lib/color-scheme.ts.
const containerSchemeId = schemeIdOf(p.containerColorScheme);
// Один класс схемы только переопределяет CSS-переменные. Чтобы мерчант увидел
// цвет, на том же узле нужны фон/текст, читающие их; h-full + justify-center
// растягивают контейнер на высоту ряда, радиус/отступ — манера контейнера темы
// (те же, что у rowBoxCls ниже).
// Шов НЕ скругляется (владелец 2026-09-17, перепроверка): сторона СТЫКА
// текстового контейнера с медиа всегда rounded-*-none, скругление темы — на
// внешней стороне ряда (зеркально медиа-скруглению, см. rowBoxCls/медиа ниже).
const containerSchemeCls = (right: boolean) =>
	containerSchemeId
		? ` color-scheme-${containerSchemeId} bg-[rgb(var(--color-bg,238_238_238))] text-[rgb(var(--color-text,38_49_28))] h-full justify-center rounded-[var(--radius-card,0px)] p-6 md:p-10 ${right ? "lg:rounded-r-none lg:rounded-l-[var(--radius-card,0px)]" : "lg:rounded-l-none lg:rounded-r-[var(--radius-card,0px)]"}`
		: "";
// per-item: surface-бокс на КАЖДЫЙ ряд при ВКЛ; ВЫКЛ — голый ряд.
const rowBoxCls = containerEnabled
	? " rounded-[var(--radius-card,0px)] bg-[rgb(var(--color-surface,236_235_231))] p-6 md:p-10"
	: "";

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе.
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;

// colorScheme навешивает обёрткой composeV2Page; фон секции — токен с
// фоллбеком родного светлого фона (#EEEEEE = 238 238 238, МАННЕРА §7).
const titleId = id && heading ? `${id}-title` : undefined;
// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((Astro.props as any).hiddenFields)
	? ((Astro.props as any).hiddenFields as unknown[]).filter(
			(x): x is string => typeof x === 'string',
		)
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);

---

<section
	class="vanilla-pad w-full bg-[rgb(var(--color-bg,238_238_238))] py-20 md:py-28"
	aria-labelledby={titleId}
	data-puck-component-id={id}
	style={paddingStyle}
>
	{/* Контейнер ширины. Класс темы `.vanilla-container` не лежит ни в одном
	   @layer, поэтому его `max-width: var(--vanilla-max)` (1320px) перебивал
	   утилиту `max-w-[780px]`/`max-w-[1080px]` из @layer utilities — настройка
	   «Ширина» была мертва (замер: 1320px на всех трёх значениях, и в превью, и в
	   живом бандле). Тот же результат утилитами: `.vanilla-container` = width:100%
	   + max-width:1320 + margin-inline:auto ≡ `mx-auto w-full max-w-[1320px]`,
	   значит на «Ширина»=large вид не меняется, а small/medium оживают. */}
	<div class={`mx-auto flex w-full ${widthCls} flex-col gap-8`}>
		{
			heading && !isFieldHidden('heading') && (
				<h2
					id={titleId}
					class={headingCls}
					data-animate
					data-puck-subsection-parent={id}
					data-puck-subsection-index="100"
					data-puck-subsection-field="heading"
				>
					<Fragment set:html={inlineFormat(heading)} />
				</h2>
			)
		}
		{/* Зазор МЕЖДУ рядами — канон владельца 2026-09-17 (Shopify Row): ряды
		    ВПЛОТНУЮ, зазор РОВНО ноль на lg: (там же, где ряд становится
		    двухколоночным — media-text-pair.spec.ts). На мобильном (одна колонка)
		    зазор оставлен, иначе ряды сливаются в кашу (multirows-row-gap.spec.ts). */}
		<ul class="flex w-full flex-col gap-8 lg:gap-0" role="list">
			{
				rows.map((r, i) => (
					<li
						class={`grid w-full grid-cols-1 gap-4 md:gap-10 ${ROW_SPLIT[rowSplitKey][r.right ? "textFirst" : "mediaFirst"]} lg:gap-0${rowBoxCls}`}
						data-animate
						data-puck-subsection-parent={id}
						data-puck-subsection-index={i}
						data-puck-subsection-field="rows"
					>
						<div
							class={`group relative w-full overflow-hidden rounded-[var(--radius-media,0px)] bg-[rgb(var(--color-surface,236_235_231))] ${r.aspectCls}${r.right ? " lg:order-2 lg:rounded-l-none lg:rounded-r-[var(--radius-media,0px)]" : " lg:rounded-r-none lg:rounded-l-[var(--radius-media,0px)]"}`}
							aria-hidden={r.image ? undefined : "true"}
						>
							{r.image && (
								<img
									src={r.image}
									alt={r.heading || "Ряд"}
									loading="lazy"
									decoding="async"
									class="absolute inset-0 size-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
								/>
							)}
						</div>
						{/* ВНИМАНИЕ: класс, стоящий в шаблонной строке ВПЛОТНУЮ перед
						    подстановкой, до CSS не доезжает — сканер Tailwind берёт
						    кандидата вместе с долларом и отбрасывает его. Проба на двух
						    уникальных классах: поставленный перед подстановкой дал 0
						    правил в обоих бандлах, поставленный в конце литерала — по
						    одному. Так класс вертикального центрирования этой колонки жил
						    в разметке с нулём правил, и текст ряда никогда не
						    центрировался. Поэтому подстановки идут ПЕРЕД хвостом из
						    литеральных классов. Имена классов в комментариях НЕ писать:
						    сканер берёт их как кандидатов и маскирует такую пропажу. */}
						{/* Владелец 2026-09-17 (баг «раскладка ломается»): `lg:self-center`
						    снимал дефолтное растяжение ТОЛЬКО у текстовой колонки (медиа без
						    оверрайда и так растягивалось grid'ом) — на ЛЮБОЙ комбинации
						    Высота/Ширина/per-row size текст оставался высотой по контенту, а
						    медиа тянулось на всю высоту ряда: два разных ответа на «высота
						    ряда» у соседних колонок. Без self-center обе колонки растягиваются
						    (align-items:normal ⇒ stretch), паритет rose/flux/bloom/satin.
						    Сторож: multirows-row-stretch.spec.ts. */}
						<div class={`flex w-full flex-col ${alignCls}${r.right ? " lg:order-1" : ""}${containerSchemeCls(!!r.right)}`}>
							{r.heading && (
								<h3
									class={`font-vanilla-bitter ${r.headingCls} font-normal italic leading-none tracking-normal text-[rgb(var(--color-heading,38_49_28))]`}
								>
									<Fragment set:html={inlineFormat(r.heading)} />
								</h3>
							)}
							{r.text && (
								<div
									class={`mt-5 w-full font-vanilla-arsenal ${r.textCls} font-normal leading-[1.45] text-[rgb(var(--color-muted,68_68_68))]`}
									set:html={inlineFormat(r.text)}
								/>
							)}
							{r.btnText && (
								<a href={r.btnHref} class={`mt-10 ${btnCls}`}>
									{r.btnText}
								</a>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
