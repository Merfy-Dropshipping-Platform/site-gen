---
const { settings, blocks } = Astro.props;
---
<div class="mx-auto flex max-w-page flex-col gap-4 px-4 font-body">
  <h2 class="m-0 font-heading weight-heading text-3xl text-heading">{settings.heading}</h2>
  <div class="flex gap-4">
    <button type="button" class="rounded-button bg-card px-4 py-2 text-card-foreground" data-ref="coat" data-coat="grey" data-action="pick">Серое</button>
    <button type="button" class="rounded-button bg-card px-4 py-2 text-card-foreground" data-ref="coat" data-coat="black" data-action="pick">Чёрное</button>
  </div>
  <ul class="m-0 flex list-none flex-col gap-4 p-0">
    {blocks.map((block) => (
      <li class="flex justify-between rounded-button bg-card p-4 text-card-foreground" data-ref="scarf" data-goes-with={block.settings.caption}>
        <span>{block.settings.label}</span>
        <button type="button" class="rounded-button bg-primary px-4 py-2 text-primary-foreground" data-action="cart.add" data-product-id="p12">В корзину</button>
      </li>
    ))}
  </ul>
  <p class="m-0 text-lg text-foreground" data-ref="clock">Подбор открыт 0 с</p>
</div>
