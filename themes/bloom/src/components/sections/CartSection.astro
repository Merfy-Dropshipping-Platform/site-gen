---
// Секция «Корзина» (V2-порт bloom). Вынесена из themes/bloom/src/pages/cart.astro
// БЕЗ изменения логики — та же ванильная корзина (getCart/render + мост checkout +
// cart-store.js/cart-api.js). Теперь это Puck-секция: page-cart редактируема как
// главная, корзину можно двигать/настраивать, добавлять другие секции вокруг.
// Корзина одна на странице (maxInstances:1) → document.querySelector безопасен
// (first-match не ловит дубль). Резолвится раньше theme-base скаффолда (resolveV2Section).
import { DEFAULT_CATEGORY_HREF } from "../../data/categories";

interface Props {
	id?: string;
	padding?: { top: number; bottom: number };
	colorScheme?: number | string;
}
const { id, padding, colorScheme } = Astro.props as Props;

// Мост корзины → checkout: build.service.ts патчит `const shopId = ""` → siteId на деплое.
const shopId = "";
const apiUrl = "https://gateway.merfy.ru/api";
// Проп «Отступы» из конструктора (px). Если не задан — дефолтные адаптивные классы.
const padStyle = padding
	? `padding-top:${Math.min(Number(padding.top) || 0, 160)}px;padding-bottom:${Math.min(Number(padding.bottom) || 0, 160)}px;`
	: undefined;
// Цветовая схема секции: пусто → наследует :root сайта.
const schemeClass = `color-scheme-${String(colorScheme ?? 2).replace("scheme-", "")}`;
---

<section
	data-puck-component-id={id}
	data-block="cart-section"
	class:list={[
		// Фон секции — «Фон» СХЕМЫ (эталон rose: bg-[rgb(var(--color-bg,255_255_255))]).
		// Было `bg-white`: Tailwind 4 печатает его как var(--color-white) — переменная
		// есть, схемы в ней нет, и полотно «Корзины» замирало белым, хотя на корне
		// секции ВИСИТ класс схемы (schemeClass ниже). Замер матрицы (схемы-зонды
		// 1 → 4, «Фон» 17,0,0 → 0,17,0): #fff → #fff. Фолбэк 255_255_255 = прежний
		// вид. Сторож: pnpm test:cart-scheme, pnpm test:scheme-targets.
		"w-full bg-[rgb(var(--color-bg,255_255_255))] px-4 md:px-20 2xl:px-[300px]",
		schemeClass,
		padStyle ? "" : "pb-[60px] pt-16 md:pb-[80px] md:pt-20",
	]}
	style={padStyle}
	aria-labelledby="cart-title"
>
	<div class="mx-auto flex w-full max-w-[1320px] flex-col gap-16">
		<!-- Пустое состояние -->
		<div
			data-cart-page-empty
			class="flex flex-col items-center gap-4 py-10"
		>
			<h1
				id="cart-title"
				class="font-comfortaa text-[28px] font-normal uppercase leading-[1.115] text-[rgb(var(--color-heading,0_0_0))] md:text-[32px]"
			>
				Корзина
			</h1>
			<p class="font-manrope text-[14px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))] md:text-[16px]">
				Вы пока не добавили товар в корзину.
			</p>
			{/* Кнопки секции — «Кнопка» СХЕМЫ (эталон rose, CartSection.astro:54).
			    Надпись стояла на `text-white`: Tailwind 4 печатает его как
			    var(--color-white) — переменная ЕСТЬ, а схемы в ней нет, и надпись
			    замирала белой при любой схеме (замер матрицы, схемы-зонды 1 → 4:
			    #fff → #fff). Заливка `bg-[#000000]` переведена ТОЙ ЖЕ правкой: увести
			    в схему одну половину пары значит завести новый дефект — на схеме с
			    тёмным «Текстом кнопки» вышло бы чёрное на чёрном. Обе кнопки секции
			    (пустая корзина и «Оформить заказ») правятся одинаково. Фолбэки
			    0_0_0 / 255_255_255 = прежний вид.
			    Сторож: pnpm test:cart-scheme, pnpm test:scheme-targets. */}
			<a
				href={DEFAULT_CATEGORY_HREF}
				class="inline-flex h-12 items-center justify-center rounded-[6px] bg-[rgb(var(--color-button-bg,0_0_0))] px-6 font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-90 active:scale-95"
			>
				Продолжить покупки
			</a>
			<p class="font-manrope text-[14px] font-normal leading-normal text-[rgb(var(--color-muted,153_153_153))] md:text-[16px]">
				Есть аккаунт?
				<a href="/auth/sign-in" class="text-[rgb(var(--color-text,0_0_0))] hover:opacity-80">Войти</a>
			</p>
		</div>

		<!-- Наполненная корзина -->
		<div
			data-cart-page-filled
			class="hidden flex-col gap-10"
		>
			<h1 class="font-comfortaa text-[28px] font-normal uppercase leading-[1.115] text-[rgb(var(--color-heading,0_0_0))] md:text-[32px]">
				Корзина
			</h1>
			<ul
				data-cart-page-items
				role="list"
				class="flex flex-col gap-6"
			></ul>
			<div class="flex items-center justify-end gap-6 border-t border-[rgb(var(--color-muted,153_153_153)/0.3)] pt-6">
				<span class="font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))]">Итого</span>
				<span data-cart-page-total class="font-manrope text-[20px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))]">0 ₽</span>
			</div>
			<div class="flex justify-end">
				<button
					type="button"
					data-action="checkout"
					class="inline-flex h-12 items-center justify-center rounded-[6px] bg-[rgb(var(--color-button-bg,0_0_0))] px-6 font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-90 active:scale-95"
				>
					Оформить заказ
				</button>
			</div>
		</div>
	</div>
</section>

<script>
	import { getCart, getCartTotal, formatCartPrice, updateQuantity, removeFromCart } from "../../lib/cart";
	import { cartLineThumbPictureHtml } from "../../lib/cart-thumb-html";

	const emptyBlock = document.querySelector<HTMLElement>("[data-cart-page-empty]");
	const filledBlock = document.querySelector<HTMLElement>("[data-cart-page-filled]");
	const itemsEl = document.querySelector<HTMLElement>("[data-cart-page-items]");
	const totalEl = document.querySelector<HTMLElement>("[data-cart-page-total]");

	const render = () => {
		const lines = getCart();
		if (!emptyBlock || !filledBlock || !itemsEl || !totalEl) return;
		if (lines.length === 0) {
			emptyBlock.classList.remove("hidden");
			emptyBlock.classList.add("flex");
			filledBlock.classList.add("hidden");
			filledBlock.classList.remove("flex");
			return;
		}
		emptyBlock.classList.add("hidden");
		emptyBlock.classList.remove("flex");
		filledBlock.classList.remove("hidden");
		filledBlock.classList.add("flex");

		itemsEl.innerHTML = lines
			.map((line) => {
				const variant = [line.variant?.color, line.variant?.size].filter(Boolean).join(", ");
				const totalCurrent = formatCartPrice(line.price * line.quantity);
				// Старая (зачёркнутая) цена — жалоба владельца 17.09: «не отображается
				// цена без скидки». Эталон rose/flux CartSection.astro: line.oldPrice
				// сравнивается с line.price (сумма на количество, как totalCurrent),
				// красится --color-muted (та же роль, что у варианта/«Удалить»).
				const totalOld =
					typeof line.oldPrice === "number" && line.oldPrice > line.price
						? formatCartPrice(line.oldPrice * line.quantity)
						: "";
				return `
					<li class="flex flex-col gap-4 border-b border-[rgb(var(--color-muted,153_153_153)/0.3)] pb-6 md:flex-row md:items-start md:justify-between" data-line-id="${line.id}">
						<div class="flex gap-4">
							<a href="/products/${line.productId}" class="group block size-24 shrink-0 overflow-hidden bg-[#F5F5F5]">
								${cartLineThumbPictureHtml(line.image, line.name)}
							</a>
							<div class="flex flex-col gap-2">
								<a href="/products/${line.productId}" class="font-manrope text-[16px] font-normal text-[rgb(var(--color-text,0_0_0))] transition-opacity hover:opacity-70 md:text-[20px]">${line.name}</a>
								${variant ? `<span class="font-manrope text-[14px] font-light text-[rgb(var(--color-muted,153_153_153))]">${variant}</span>` : ""}
								<button type="button" data-cart-remove data-id="${line.id}" class="w-fit font-manrope text-[14px] font-normal text-[rgb(var(--color-muted,153_153_153))] transition-colors hover:text-[rgb(var(--color-text,0_0_0))]">Удалить</button>
							</div>
						</div>
						<div class="flex items-center justify-between gap-6 md:flex-col md:items-end md:justify-start md:gap-3">
							<div class="inline-flex h-10 items-center rounded-[4px] border border-[rgb(var(--color-muted,153_153_153)/0.3)]">
								<button type="button" data-cart-dec data-id="${line.id}" class="flex h-10 w-10 items-center justify-center text-[rgb(var(--color-text,0_0_0))] transition-opacity hover:opacity-70" aria-label="Уменьшить">−</button>
								<span class="min-w-[28px] text-center font-manrope text-[14px] text-[rgb(var(--color-text,0_0_0))]">${line.quantity}</span>
								<button type="button" data-cart-inc data-id="${line.id}" class="flex h-10 w-10 items-center justify-center text-[rgb(var(--color-text,0_0_0))] transition-opacity hover:opacity-70" aria-label="Увеличить">+</button>
							</div>
							<div class="flex items-baseline gap-2">
								<span class="font-manrope text-[16px] font-normal text-[rgb(var(--color-text,0_0_0))] md:text-[20px]">${totalCurrent}</span>
								${totalOld ? `<span class="font-manrope text-[13px] font-light text-[rgb(var(--color-muted,153_153_153))] line-through md:text-[16px]">${totalOld}</span>` : ""}
							</div>
						</div>
					</li>
				`;
			})
			.join("");

		totalEl.textContent = formatCartPrice(getCartTotal(lines));
	};

	render();
	window.addEventListener("bloom:cart:updated", render);

	document.addEventListener("click", (event) => {
		const target = event.target as HTMLElement;
		const inc = target.closest<HTMLButtonElement>("[data-cart-inc]");
		if (inc) {
			const id = inc.dataset.id ?? "";
			const line = getCart().find((l) => l.id === id);
			if (line) updateQuantity(id, line.quantity + 1);
			return;
		}
		const dec = target.closest<HTMLButtonElement>("[data-cart-dec]");
		if (dec) {
			const id = dec.dataset.id ?? "";
			const line = getCart().find((l) => l.id === id);
			if (line) updateQuantity(id, line.quantity - 1);
			return;
		}
		const remove = target.closest<HTMLButtonElement>("[data-cart-remove]");
		if (remove) removeFromCart(remove.dataset.id ?? "");
		const checkout = target.closest<HTMLButtonElement>("[data-action='checkout']");
		if (checkout) {
			// Мост NtCart → backend cart: строим серверную корзину из локальных линий,
			// чтобы checkout (cartStore) показал товары и submit/оплата работали.
			void (async () => {
				const cs = (window as any).cartStore;
				const lines = getCart();
				if (!cs) {
					window.alert("Корзина ещё загружается. Обновите страницу и попробуйте снова.");
					return;
				}
				if (lines.length) {
					let ok = true;
					try {
						cs.clear();
						for (const l of lines) {
							if ((await cs.addItem(l.productId, l.variant?.variantCombinationId ?? null, l.quantity)) === false) ok = false;
						}
					} catch (e) {
						ok = false;
					}
					// Не уходить в пустой /checkout: cs.clear() уже очистил серверную корзину,
					// при сбое addItem остаёмся на /cart с сообщением (иначе чекаут пуст).
					if (!ok) {
						window.alert("Не удалось перенести товары в оформление. Обновите страницу и попробуйте снова.");
						return;
					}
				}
				window.location.href = "/checkout"; // full load = VT-safe (checkout-скрипты стартуют свежими)
			})();
		}
	});
</script>

{/* Мост корзины → backend cart: грузим cartStore + конфиг, чтобы «Оформить заказ»
    создал серверную корзину из локальных NtCart-линий (shopId патчится на деплое). */}
<script is:inline define:vars={{ shopId, apiUrl }}>
	window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || {
		shopId: shopId || "",
		apiUrl: apiUrl || "https://gateway.merfy.ru/api",
	};
</script>
<script is:inline type="module" src="/scripts/cart-api.js"></script>
<script is:inline type="module" src="/scripts/cart-store.js"></script>
