{
  "sdk": 1,
  "name": "promo-banner",
  "kind": "section",
  "title": "Промо-баннер",
  "groups": ["header", "page"],
  "wrapper": ["scheme", "padding"],
  "wrapperSpec": {
    "scheme": { "default": "scheme-4" },
    "padding": { "default": { "top": 0, "bottom": 0 } }
  },
  "settings": [
    { "wrapper": "scheme" },
    { "wrapper": "padding" },
    {
      "id": "capitals",
      "label": "Заглавные буквы",
      "section": "Вид",
      "setting": {
        "kind": "toggle",
        "default": true,
        "labels": { "on": "Показать", "off": "Скрыть" }
      }
    }
  ],
  "blocks": {
    "announcement": {
      "title": "Объявление",
      "limit": 1,
      "settings": [
        {
          "id": "text",
          "label": "Текст",
          "setting": {
            "kind": "text",
            "default": "Бесплатная доставка на весь ассортимент до конца года.",
            "ai": "title"
          }
        },
        {
          "id": "text-size",
          "label": "Размер текста",
          "setting": {
            "kind": "select",
            "default": "large",
            "options": [
              { "value": "small", "label": "Маленький" },
              { "value": "medium", "label": "Средний" },
              { "value": "large", "label": "Большой" }
            ]
          }
        },
        {
          "id": "link",
          "label": "Ссылка",
          "setting": {
            "kind": "url",
            "default": "/catalog"
          }
        },
        {
          "id": "label",
          "label": "Название ссылки",
          "setting": {
            "kind": "string",
            "default": "Смотреть больше"
          }
        }
      ]
    }
  },
  "defaultBlocks": [
    {
      "type": "announcement",
      "settings": {}
    }
  ]
}
