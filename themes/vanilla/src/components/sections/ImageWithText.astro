---
import { inlineFormat } from "../../lib/rich-text";
import { orderTextFields, TEXT_COLUMN_FIELDS } from "../../../../../packages/theme-base/lib/field-order";
// Фаза B (vanilla): канон-секция ImageWithText — адаптация care-бэнда
// sections/Gallery.astro:82-123 («Ваш дом — наша забота», см. themes/vanilla/
// MANNER.md §10). Тело верстальщика перенесено КОПИЕЙ — Gallery.astro НЕ
// тронут (его используют страницы). Схема полей = packages/theme-base/blocks/
// ImageWithText/ImageWithText.puckConfig.ts.
//
// ДВА РЕЖИМА (Figma 1:19335):
//   • ФОТО ВЫБРАНО (image.url задан) = реальные данные → дефолты = литералы
//     care-бэнда верстальщика VERBATIM, цвета → токены с пиксель-фоллбеком
//     родных (МАННЕРА §7). Этот путь НЕ ломаем.
//   • ФОТО НЕ ВЫБРАНО = пустое состояние → ПЛЕЙСХОЛДЕР контракта (пустой
//     surface-rect + лейблы «Расскажите о товаре» / «Опишите преимущества…» /
//     «Подробнее»), НЕ мок-демо верстальщика. Эталон гейта: theme-base
//     PopularProducts (collectionRef) / Collections (hasManualCollections).
const p = Astro.props as Record<string, any>;
const id = p.id;

// Field-order 24.09 (тестер: «слетели дрэг-н-дропы»): порядок заголовка/
// текста/кнопки из перетаскивания в конструкторе. Колонка ниже держит зазор
// МАРЖИНОМ на каждом поле (TEXT_MT_CLS/ctaMtCls), а не `gap` — переставленный
// набор рисуется отдельным путём (ниже, у самой разметки).
const fieldOrder = orderTextFields(p);
const isDefaultOrder = fieldOrder.every((f, i) => f === TEXT_COLUMN_FIELDS[i]);

// ──────────────────────────────────────────────────────────────────────────
// Гейт пустого состояния (Figma 1:19335 — empty-state ЗАМЕНЯЕТ мок верстальщика).
// Данные этой секции = ИЗОБРАЖЕНИЕ. Пока мерчант не выбрал фото — секция в
// плейсхолдер-режиме: пустой surface-rect + дефолтные лейблы контракта
// («Расскажите о товаре» / «Опишите преимущества…» / «Подробнее»), НЕ care-бэнд
// верстальщика. Как только фото выбрано — рендер реальных данных без изменений
// (heading/text/button мерчанта остаются), эталон гейта см. PopularProducts
// (collectionRef) / Collections (hasManualCollections).
const hasImage = typeof p.image?.url === "string" && p.image.url.trim().length > 0;

// Канон heading: string | { text, alignment, size }. Дефолт зависит от режима:
// есть фото → литерал care-бэнда VERBATIM (реальный контент); нет фото →
// ДОСЛОВНЫЙ Figma-плейсхолдер (1:19335, тип ImageWithText) «Изображение с текстом»
// (НЕ дефолт-копирайт верстальщика «Расскажите о товаре»). Роль = заголовок секции
// (Bitter italic 20 white на полотне №2, Gal:92). Лестница §9: medium/отсутствие
// = литерал 20, small 17, large 24.
const headingDefault = hasImage ? "Ваш дом — наша забота" : "Изображение с текстом";
const heading =
	(typeof p.heading === "string" ? p.heading : p.heading?.text)?.trim() || headingDefault;
const headingSize = p.heading?.size ?? p.headingSize;
const headingCls =
	headingSize === "small"
		? "font-vanilla-bitter text-[17px] font-normal leading-none tracking-normal text-[rgb(var(--color-heading,255_255_255))]"
		: headingSize === "large"
			? "font-vanilla-bitter text-[24px] font-normal leading-none tracking-normal text-[rgb(var(--color-heading,255_255_255))]"
			: "font-vanilla-bitter text-[20px] font-normal leading-none tracking-normal text-[rgb(var(--color-heading,255_255_255))]";
// Канон «Выравнивание» (Figma 1:17086) — секция-уровневый контрол (puckConfig
// alignment, type:'alignment'), применяется к заголовку + тексту + кнопке.
// Раньше vanilla читал только heading.alignment / headingAlignment и вешал класс
// ЛИШЬ на <h2> → top-level `alignment` конструктора был мёртв, а текст/кнопка не
// выравнивались (паритет rose ImageWithText). Back-compat: старые ревизии хранили
// выключку в заголовке → читаем headingAlignment / heading.alignment как fallback.
const alignment = p.alignment ?? p.headingAlignment ?? p.heading?.alignment;
const alignCls =
	alignment === "center" ? " text-center" : alignment === "right" ? " text-right" : "";
// Колонка контента = flex-col items-start по манере верстальщика; при center/right
// двигаем И cross-axis (блок-элементы: заголовок, кнопка), чтобы выключка была
// цельной, а не только у текста. Кнопка (self-start в btnCls) — отдельный selfCls.
const itemsCls =
	alignment === "center" ? "items-center" : alignment === "right" ? "items-end" : "items-start";
const selfCls =
	alignment === "center" ? "self-center" : alignment === "right" ? "self-end" : "self-start";

// Канон text: string | { content, size }. Дефолт зависит от режима: есть фото →
// careTextLead + careTextTail двумя <p> VERBATIM (реальный контент); нет фото →
// ДОСЛОВНЫЙ Figma-плейсхолдер (1:19335, тип ImageWithText) «Покажи и расскажи о
// своем товаре в одном блоке» (НЕ дефолт-копирайт верстальщика «Опишите
// преимущества продукта…»). Шрифтовые классы — на обёртке (абзацы наследуют),
// зазор между абзацами даёт gap-4 обёртки, как у верстальщика (Gal:95). Роль =
// текст полотна 14 (Gal:96; лестница §9): large/отсутствие = литерал 14, medium 12, small 10.
const textDefault = hasImage
	? "<p>Мы уверены: дом должен быть красивым не только на фотографиях, но и на ощупь. Бренд Vanila создан для тех, кто ценит эстетику и качество в каждом квадратном метре своего пространства. Мы собираем для вас самые вдохновляющие предметы текстиля и декора, чтобы ваш интерьер обрел индивидуальность.</p><p>В ассортименте Vanila вы не найдете случайных вещей. Только то, что действительно достойно стать частью вашего дома</p>"
	: "<p>Покажи и расскажи о своем товаре в одном блоке</p>";
const text =
	(typeof p.text === "string" ? p.text : p.text?.content)?.trim() || textDefault;
const textSize = p.textSize ?? p.text?.size;
// PARITY_DESIGN (владелец 24.09: «как у верстальщиков, только размеры»):
// бэнд «Ваш дом — наша забота» Vanilla-theme @c65d9e1c (sections/Gallery.astro,
// [data-gallery-care]) — абзац под заголовком mt-3; на lg колонка текста 352 и
// фото 652×366 стоят по краям (justify-between, обе не сжимаются). Раскладка —
// только в ветке «Ширина не задана»: выбранная мерчантом ширина работает как
// прежде. Без признака — прежние классы байт-в-байт.
const designParity = p.__designParity === true;
const designLayout = designParity && p.width === undefined;
const TEXT_MT_CLS = designParity ? "mt-3" : "mt-5";
const LAYOUT = designLayout
	? { justify: "lg:items-start lg:justify-between", textCol: "lg:w-[352px] lg:shrink-0", media: "lg:w-[652px] lg:shrink-0" }
	: { justify: "lg:justify-center", textCol: "lg:min-w-0 lg:shrink lg:grow-0", media: "lg:min-w-0 lg:max-w-none lg:shrink lg:grow-0" };
// Field-order: тело класса БЕЗ отступа-от-соседа — нужно custom-порядку
// (там отступ не «text-специфичный», а позиционный, см. ниже у разметки).
const textClsBody =
	textSize === "small"
		? `flex w-full flex-col gap-4 font-vanilla-arsenal text-[10px] font-normal leading-[1.5] text-[rgb(var(--color-text,240_240_240))]`
		: textSize === "medium"
			? `flex w-full flex-col gap-4 font-vanilla-arsenal text-[12px] font-normal leading-[1.5] text-[rgb(var(--color-text,240_240_240))]`
			: `flex w-full flex-col gap-4 font-vanilla-arsenal text-[14px] font-normal leading-[1.5] text-[rgb(var(--color-text,240_240_240))]`;
const textCls = `${TEXT_MT_CLS} ${textClsBody}`;

// Канон textStyle: blockDefaults-литерал 'italic' = курсив верстальщика —
// снимается только явным 'normal'.
const italicCls = p.textStyle === "normal" ? "" : " italic";

// Канон image {url, alt}: фото мерчанта (реальные данные). Пусто → плейсхолдер-
// режим: дизайн-ассет Figma 1:19335 (landscape-iwt.png из placeholders), НЕ мок
// верстальщика (vanilla-chair) и НЕ пустой surface-rect. Ассет раздаётся на
// каждой теме как /placeholders/landscape-iwt.png (контракт картиночных секций:
// картинка показывается всегда — фолбэк = соответствующий landscape-*).
const imageUrl = hasImage ? p.image.url : "/placeholders/landscape-iwt.png";
const imageAlt =
	typeof p.image?.alt === "string" && p.image.alt.trim() ? p.image.alt : "Стул Vanilla";

// Канон imagePosition: 'right' (canon-default из theme.json blockDefaults) и
// отсутствие = литерал care-бэнда — текст слева, ФОТО СПРАВА; 'left' зеркалит
// через order (на мобиле текст всегда сверху, как у верстальщика).
const imageLeft = p.imagePosition === "left";

// Канон size — аспект медиа лестницей манеры §4: medium/отсутствие = фото
// care-бэнда 652/366 (литерал, Gal:111), small = широкое 16/9, large = квадрат.
const aspectCls =
	p.size === "small" ? "aspect-[16/9]" : p.size === "large" ? "aspect-square" : "aspect-[652/366]";

// Канон width (s/m/l/full): large/отсутствие = 1280 (контейнер care-бэнда,
// Gal:89), medium 1080, small 780, full — без лимита (поля .vanilla-pad остаются).
const widthCls =
	p.width === "small"
		? "max-w-[780px]"
		: p.width === "medium"
			? "max-w-[1080px]"
			: p.width === "full"
				? "max-w-none"
				: "max-w-[1280px]";

// Канон containerColorScheme (hidden): класс схемы на внутреннем контейнере.
const containerSchemeCls =
	typeof p.containerColorScheme === "string" && p.containerColorScheme
		? ` color-scheme-${String(p.containerColorScheme).replace("scheme-", "")}`
		: "";

// Кнопка: canon button {text, href|link}. Дефолт (проп не задан) зависит от
// режима: есть фото → CTA care-бэнда VERBATIM «Смотреть больше» (реальный
// контент); нет фото → ДОСЛОВНЫЙ Figma-плейсхолдер (1:19335, тип ImageWithText)
// «Кнопка» (часть дизайна пустого состояния, как «Кнопка» в MainText/Slideshow/
// Hero). Пустой текст заданного пропа СКРЫВАЕТ кнопку.
const btnProvided = p.button !== undefined;
const btnTextProp =
	typeof p.button?.text === "string" && p.button.text.trim() ? p.button.text : undefined;
const btnDefault = hasImage ? "Смотреть больше" : "Кнопка";
const btnText = btnTextProp ?? (btnProvided ? undefined : btnDefault);
const btnHref =
	(typeof p.button?.href === "string" && p.button.href ? p.button.href : undefined) ??
	p.button?.link?.href ??
	(typeof p.button?.link === "string" && p.button.link ? p.button.link : undefined) ??
	"/about";

// Канон buttonStyle: 'outlined' и отсутствие = контур care-бэнда ДОСЛОВНО
// (border 1.3px white, Gal:105; button-2 токены); 'solid' = заливка кнопки-2.
// Радиус 0 ≡ var(--radius-button,0px); active:scale в манере НЕ используется.
const btnCls =
	p.buttonStyle === "solid"
		? "inline-flex h-12 min-h-12 items-center justify-center rounded-[var(--radius-button,0px)] bg-[rgb(var(--color-button-2-bg,255_255_255))] px-4 font-vanilla-arsenal text-base font-normal leading-none tracking-normal text-[rgb(var(--color-button-2-text,58_69_48))] transition-opacity hover:opacity-80"
		: "inline-flex h-12 min-h-12 items-center justify-center rounded-[var(--radius-button,0px)] border-[1.3px] border-[rgb(var(--color-button-2-bg,255_255_255))] bg-transparent px-4 font-vanilla-arsenal text-base font-normal leading-none tracking-normal text-[rgb(var(--color-button-2-bg,255_255_255))] transition-opacity hover:opacity-80";

// Канон ctaPosition: 'bottom-pinned' (canon-default из theme.json blockDefaults)
// и отсутствие = литерал care-бэнда (кнопка mt-10 self-start под текстом);
// 'inline' — компактнее, в ритме зазора заголовок→текст (mt-5).
const ctaMtCls = p.ctaPosition === "inline" ? "mt-5" : "mt-10";

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе.
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;

// Фон секции — токен с фоллбеком родного полотна №2 (#3A4530, МАННЕРА §7).
const titleId = id && heading ? `${id}-title` : undefined;

// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((p as any).hiddenFields)
	? ((p as any).hiddenFields as unknown[]).filter((x): x is string => typeof x === 'string')
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);
---

<section
	class="vanilla-pad w-full bg-[rgb(var(--color-bg,58_69_48))] py-16 lg:py-[120px]"
	aria-labelledby={titleId}
	data-puck-component-id={id}
	style={paddingStyle}
>
	<div
		class={`mx-auto flex w-full ${widthCls} flex-col items-center gap-10 lg:flex-row ${LAYOUT.justify} lg:gap-10${containerSchemeCls}`}
		data-animate
	>
		{/* Текстовая колонка = РОВНО ПОЛОВИНА пары, как у rose (владелец
		   2026-09-15: «как пример работы можешь брать у розы»). Эталон rose держит
		   доли медиа:текст = 1.000 при всех трёх «Ширинах» (370/370, 520/520,
		   640/640 — замер Chromium 1920). У vanilla текст стоял в max-w-[352px], а
		   медиа несла lg:flex-1 и одна отдавала/забирала весь остаток: «Ширина»=small
		   давала 388/352, medium и large — 652/352. Это и есть жалоба «если медиа
		   маленького размера, контейнер берёт на себя больше места». Типографская
		   мера care-бэнда (352px) НЕ потеряна — она ушла на внутреннюю обёртку,
		   как это сделано у satin (колонка-половина + max-w-[420px] внутри).
		   Равный базис даёт `w-full` на ОБЕИХ колонках: flex-basis:auto берёт
		   width:100%, базисы равны, значит нехватку места на `lg:shrink` они
		   делят поровну. Классы `basis-*` в этой сборке НЕ генерируются вовсе
		   (в бандле ноль вхождений «basis») — на них опираться нельзя. */}
		<div class={`flex w-full flex-col ${itemsCls}${imageLeft ? " lg:order-2" : ""} ${LAYOUT.textCol}`}>
		<div class={`flex w-full max-w-[352px] flex-col ${itemsCls}`}>
			{isDefaultOrder && (
				heading && !isFieldHidden('heading') && (
					<h2
						id={titleId}
						class={headingCls + alignCls + italicCls}
						data-puck-subsection-parent={id}
						data-puck-subsection-index="100"
						data-puck-subsection-field="heading"
					>
						<Fragment set:html={inlineFormat(heading)} />
					</h2>
				)
			)}
			{isDefaultOrder && !isFieldHidden('text') && (
				<div
					class={textCls + italicCls + alignCls}
					data-puck-subsection-parent={id}
					data-puck-subsection-index="101"
					data-puck-subsection-field="text"
					set:html={inlineFormat(text)}
				/>
			)}
			{
				isDefaultOrder && btnText && !isFieldHidden('button') && (
					<a
						href={btnHref}
						class={`${ctaMtCls} ${selfCls} ${btnCls}`}
						data-puck-subsection-parent={id}
						data-puck-subsection-index="102"
						data-puck-subsection-field="button"
					>
						{btnText}
					</a>
				)
			}
			{/* Field-order: колонка держит зазор МАРЖИНОМ на поле (не `gap`), поэтому
			   отступ считаем ПОЗИЦИОННО — GAP_AT[i] воспроизводит тот же отступ,
			   что сейчас стоит между heading→text (TEXT_MT_CLS) и text→button
			   (ctaMtCls), первому месту отступ не даём. */}
			{!isDefaultOrder && fieldOrder.map((field, i) => {
				const GAP_AT = ["", TEXT_MT_CLS, ctaMtCls];
				const gapCls = GAP_AT[i];
				// Без TS-аннотации типа объекта: `Record<...>` в теле шаблона Astro
				// читает как открывающий тег и рвёт разметку молча.
				const nodes = {
					heading: heading && !isFieldHidden('heading') && (
						<h2
							id={titleId}
							class={`${gapCls} ${headingCls}${alignCls}${italicCls}`}
							data-puck-subsection-parent={id}
							data-puck-subsection-index="100"
							data-puck-subsection-field="heading"
						>
							<Fragment set:html={inlineFormat(heading)} />
						</h2>
					),
					text: !isFieldHidden('text') && (
						<div
							class={`${gapCls} ${textClsBody}${italicCls}${alignCls}`}
							data-puck-subsection-parent={id}
							data-puck-subsection-index="101"
							data-puck-subsection-field="text"
							set:html={inlineFormat(text)}
						/>
					),
					button: btnText && !isFieldHidden('button') && (
						<a
							href={btnHref}
							class={`${gapCls} ${selfCls} ${btnCls}`}
							data-puck-subsection-parent={id}
							data-puck-subsection-index="102"
							data-puck-subsection-field="button"
						>
							{btnText}
						</a>
					),
				};
				return nodes[field];
			})}
		</div>
		</div>
		{!isFieldHidden('image') && (
		<div
			class={`relative ${aspectCls} w-full max-w-[652px] overflow-hidden rounded-[var(--radius-media,0px)] bg-[rgb(var(--color-surface,236_235_231))]${imageLeft ? " lg:order-1" : ""} ${LAYOUT.media}`}
			data-puck-subsection-parent={id}
			data-puck-subsection-index="103"
			data-puck-subsection-field="image"
		>
			<img
				src={imageUrl}
				alt={imageAlt}
				width="652"
				height="366"
				loading="lazy"
				decoding="async"
				class="absolute inset-0 size-full object-cover"
			/>
		</div>
		)}
	</div>
</section>
