---
import { inlineFormat } from "../../lib/rich-text";
import { schemeIdOf } from "../../lib/color-scheme";
// Фаза B (satin, группа content): канон-секция MultiRows — адаптация
// src/components/sections/CollectionRows.astro (тело КОПИЕЙ; оригинал не
// тронут — index.astro:26 и about.astro:62 его используют, включая
// compact-вариант). Схема полей = packages/theme-base/blocks/MultiRows/
// MultiRows.puckConfig.ts; манера — themes/satin/MANNER.md (эталон процесса —
// bloom MultiRows). Пустое/некурированное состояние (без rows[]) = ПЛЕЙСХОЛДЕР
// по контракту Figma 1:19335 (НЕ мок-демо верстальщика «Женская/Мужская
// коллекция»): ряды «пустой rect + "Изображение с текстом" + текст + Кнопка».
// Когда мерчант задал rows[] — рендер реальных данных без изменений.
import SatinPicture from "../img/SatinPicture.astro";

const p = Astro.props as Record<string, any>;
const id = p.id;
const merfy = p.__merfy as { fields?: Record<string, { set?: boolean }> } | undefined;
function contentSet(keys: string | string[], raw: unknown): boolean {
	const ks = Array.isArray(keys) ? keys : [keys];
	for (const key of ks) {
		const f = merfy?.fields?.[key];
		if (f && typeof f.set === "boolean") return f.set;
	}
	if (typeof raw !== "string") return false;
	const t = raw.trim();
	if (!t || t.includes("/placeholders/") || t.includes("/images/4x/")) return false;
	return true;
}
function slotImage(url: unknown): string {
	if (typeof url !== "string") return "";
	const u = url.trim();
	if (!u || u.includes("/placeholders/") || u.includes("/images/4x/")) return "";
	return u;
}
function slotSet(raw: unknown): boolean {
	if (typeof raw !== "string") return false;
	const t = raw.trim();
	if (!t || t.includes("/placeholders/") || t.includes("/images/4x/")) return false;
	return true;
}

// Канон top-heading: string | { text, alignment, size } (+ legacy
// _headingLegacy). Роль = заголовок секции §1 (font-logo 20 uppercase
// leading-[1.15], токен heading). Лестница §9: medium/отсутствие = литерал 20,
// small 17, large 24. В ПУСТОМ состоянии — дословный Figma-лейбл «Мультиряды»
// (контракт 1:19335, эталон rose MultiRows.astro), а не отсутствие шапки. С
// данными мерчанта (hasRealRows ниже) — его заголовок (пусто → без шапки).
const hasRealRows =
	Array.isArray(p.rows) &&
	p.rows.some((r: any) => {
		const heading = (typeof r?.heading === "string" && r.heading) || (typeof r?.title === "string" && r.title) || "";
		const image = (typeof r?.imageUrl === "string" && r.imageUrl) || (typeof r?.image === "string" && r.image) || "";
		const btn = typeof r?.button?.text === "string" ? r.button.text : typeof r?.ctaLabel === "string" ? r.ctaLabel : "";
		return !!slotImage(image) || slotSet(heading) || slotSet(btn);
	});
const headingRaw =
	(typeof p.heading === "string" ? p.heading : p.heading?.text) ?? p._headingLegacy ?? "";
const heading = hasRealRows
	? contentSet("heading", headingRaw)
		? headingRaw
		: ""
	: contentSet("heading", headingRaw) && headingRaw.trim()
		? headingRaw
		: headingRaw || "Мультиряды";
// Панель пишет размер в top-level `headingSize` (select), `heading` = aiText-строка.
// Читаем top-level ПЕРВЫМ — иначе легаси-объект heading.size из старых ревизий
// перебивает выбор мерчанта и настройка выглядит мёртвой. Тот же механизм, что
// у Collections.headingSize во всех темах и у MultiRows в bloom.
const headingSize = p.headingSize ?? p.heading?.size;
const headingSizeCls =
	headingSize === "small" ? "text-[17px]" : headingSize === "large" ? "text-[24px]" : "text-[20px]";
const headingAlignment =
	p.headingAlignment ?? (typeof p.heading === "object" ? p.heading?.alignment : undefined);
const headingAlignCls =
	headingAlignment === "center" ? " text-center" : headingAlignment === "right" ? " text-right" : "";
const headingCls = `font-logo ${headingSizeCls} font-normal leading-[1.15] text-[rgb(var(--color-heading,0_0_0))]${headingAlignCls}`;

// Канон rows[] 1-10 (item: heading|title, text|description, imageUrl|image,
// imagePosition, button {text, href|link}, size/headingSize/textSize
// per-item); legacy flat-Row верстальщика {title, paragraphs[], image, alt,
// ctaLabel, ctaHref, imageRight} поддержан алиасами.
//
// КОНТРАКТ ПЛЕЙСХОЛДЕРОВ (Figma 1:19335 — пустое состояние секции, ЗАМЕНЯЕТ
// мок-демо верстальщика). Эталон: theme-base MultiRows.astro + порт bloom
// MultiRows. Пустое/некурированное состояние (мерчант НЕ задал rows) =
// ПЛЕЙСХОЛДЕР: ряды «пустой rect + "Изображение с текстом" + "Покажи и расскажи
// о своем товаре в одном блоке" + Кнопка» с чередованием лево/право. Без фото
// (imageUrl пуст → пустой surface-rect), нейтральные лейблы — НЕ мок-демо
// верстальщика (Женская/Мужская коллекция, /images/4x/*.png, полные абзацы).
// Лейблы выровнены по satin ImageWithText (тот же контракт «+ Кнопка»).
// Контракт картиночных секций (правило 2): фолбэк-картинка ряда пустого
// состояния = дизайн-ассет landscape-multirows-image.png
// (/placeholders/landscape-multirows-image.png, раздаётся на каждой теме) —
// картинка показывается ВСЕГДА, НЕ пустой surface-rect. Эталон theme-base
// MultiRows.astro (PLACEHOLDER_ASSETS.landscape.multirows).
const PLACEHOLDER_MULTIROWS_IMAGE = "/placeholders/landscape-multirows-image.png";
const PLACEHOLDER_ROWS = [
	{
		id: "ph-row-1",
		heading: "Изображение с текстом",
		paragraphs: ["Покажи и расскажи о своем товаре в одном блоке"],
		imageUrl: PLACEHOLDER_MULTIROWS_IMAGE,
		alt: "",
		imagePosition: "left",
		button: { text: "Кнопка", href: "/catalog" },
	},
	{
		id: "ph-row-2",
		heading: "Изображение с текстом",
		paragraphs: ["Покажи и расскажи о своем товаре в одном блоке"],
		imageUrl: PLACEHOLDER_MULTIROWS_IMAGE,
		alt: "",
		imagePosition: "right",
		button: { text: "Кнопка", href: "/catalog" },
	},
];
// Курировано? — мерчант задал ряды (есть массив rows с длиной, hasRealRows
// объявлен выше для дефолт-заголовка). Тогда рендерим реальные данные без
// изменений; иначе — плейсхолдер выше.
const rawRows = hasRealRows ? p.rows : PLACEHOLDER_ROWS;

// Канон «Позиция рядов»: ряды ВСЕГДА чередуют сторону медиа по индексу. Свитчер
// (Слева/Справа) задаёт сторону ТОЛЬКО первого ряда (i=0). per-item imagePosition/
// imageRight больше не учитываем (нет в UI).
const firstRowRight = p.rowsPosition === "right";

// Канон size (s/m/l) — аспект медиа ряда (per-item приоритетнее top-level):
// medium/отсутствие = aspect-square ЛИТЕРАЛ (CollectionRows.astro:55), small =
// md:aspect-[652/360] (литерал compact-варианта About,
// CollectionRows.astro:56), large = портрет 430/564 манеры карточек §4.
const aspectFor = (s: string | undefined) =>
	s === "small"
		? "aspect-square md:aspect-[652/360]"
		: s === "large"
			? "aspect-[430/564]"
			: "aspect-square";

// Ряд без фото → пустой rect (контракт плейсхолдера Figma 1:19335). НЕ
// подставляем мок-ассеты верстальщика (/images/4x/*.png): пустое состояние =
// пустой surface-rect, а не демо-фото. Реальный ряд без своей картинки тоже
// получает пустой rect (секция рендерит подложку, когда image пуст).

// Шкалы per-item (лестницы §9): заголовок ряда = роль «заголовок секции» 20 —
// литерал CollectionRows.astro:63 (small 17, large 24); абзацы = body крупный
// .satin-copy md:text-[20px] + max-w-[600px] — литерал CollectionRows.astro:65
// (small 14/17, large 19/24; классы расписаны явно ради лестницы и токена).
const rowHeadingCls = (s: string | undefined) =>
	s === "small"
		? "font-logo text-[17px] font-normal leading-[1.15] text-[rgb(var(--color-heading,0_0_0))]"
		: s === "large"
			? "font-logo text-[24px] font-normal leading-[1.15] text-[rgb(var(--color-heading,0_0_0))]"
			: "font-logo text-[20px] font-normal leading-[1.15] text-[rgb(var(--color-heading,0_0_0))]";
//
// PARITY_DESIGN (владелец 24.09: «как у верстальщиков, только стили»): у
// верстальщика абзац ряда `.satin-copy md:text-[20px]`, но его .satin-copy
// (16px, вне слоёв) перебивает утилиту — на экране 16px на любой ширине. Под
// признаком так рисуется только «размер текста не задан»; выбранный — как раньше.
const designParity = p.__designParity === true;
const ROW_TEXT_CLS: Record<string, string> = {
	small: "max-w-[600px] text-[14px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))] md:text-[17px]",
	large: "max-w-[600px] text-[19px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))] md:text-[24px]",
	medium: "max-w-[600px] text-[16px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))] md:text-[20px]",
	designers: "max-w-[600px] text-[16px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))]",
};
const rowTextCls = (s: string | undefined) =>
	ROW_TEXT_CLS[s === "small" || s === "large" ? s : s === undefined && designParity ? "designers" : "medium"];

// «Высота» секции и «Размер» ряда — две ЖИВЫЕ настройки, и ни одна из них не
// угадывается по данным. Ряд со своим размером всегда главнее; секция задаёт
// высоту тем рядам, у которых своего размера нет. Саму «Высоту» конструктор
// при изменении прописывает во ВСЕ ряды (CustomFieldsPanel.updateProp) —
// поэтому секционный регулятор виден сразу, а выбор ряда больше не отменяется
// сам собой.
//
// До 20.09 здесь стояла эвристика perRowSizesDiffer: одинаковый размер у всех
// рядов считался признаком «мерчант не выбирал» и уступал секции. Она чинила
// одну сторону монеты и ломала другую — владелец 20.09: «при размерах в рядах
// большой они становятся маленькие». Мерчант ставил medium второму ряду,
// размеры снова совпадали, признак гас, и ОБА ряда падали на секционный
// фолбэк; а у секции с ОДНИМ рядом per-row размер не работал никогда.

const rows = rawRows.slice(0, 10).map((r: any, i: number) => {
	// Абзацы: legacy paragraphs[] рендерятся отдельными <p> (литерал);
	// канон text|description — одним <p> через set:html.
	const paragraphs: string[] = Array.isArray(r.paragraphs)
		? r.paragraphs.filter((x: any) => typeof x === "string" && x.trim())
		: String(
				(typeof r.description === "string" && r.description) ||
				(typeof r.text === "string" && r.text) ||
					"",
			)
				.split(/\n\n+/)
				.map((x) => x.trim())
				.filter(Boolean);
	const headingText =
		// §11 Контракта секции: панель ряда показывает и пишет title/description/image,
		// а heading/text/imageUrl — legacy из сидов и старых ревизий. Читать legacy
		// ПЕРВЫМ нельзя: он есть почти в каждой ревизии и наглухо глушит правки
		// мерчанта — заголовок ряда меняешь, на превью остаётся старый.
		(typeof r.title === "string" && r.title) || (typeof r.heading === "string" && r.heading) || "";
	const btnText =
		(typeof r.button?.text === "string" && r.button.text.trim() ? r.button.text : undefined) ??
		(typeof r.ctaLabel === "string" && r.ctaLabel.trim() ? r.ctaLabel : undefined);
	return {
		heading: headingText,
		paragraphs,
		image: (() => {
			const raw =
				(typeof r.image === "string" && r.image.trim()) ||
				(typeof r.imageUrl === "string" && r.imageUrl.trim()) ||
				"";
			return raw && !raw.includes("/images/4x/") ? raw : PLACEHOLDER_MULTIROWS_IMAGE;
		})(),
		alt: (typeof r.alt === "string" && r.alt.trim()) || headingText || "Ряд",
		right: firstRowRight ? i % 2 === 0 : i % 2 === 1,
		aspectCls: aspectFor(
			// «Как в секции» (inherit) и отсутствие размера → высоту берёт секция.
			// Пустая «Высота» ≡ дефолт панели: гард panel-default-is-noop требует,
			// чтобы дефолт был неотличим от отсутствия значения.
			r.size && r.size !== "inherit" ? r.size : (p.size ?? "medium"),
		),
		headingCls: rowHeadingCls(r.headingSize),
		textCls: rowTextCls(r.textSize),
		btnText,
		btnHref:
			(typeof r.button?.href === "string" && r.button.href ? r.button.href : undefined) ??
			r.button?.link?.href ??
			(typeof r.button?.link === "string" && r.button.link ? r.button.link : undefined) ??
			(typeof r.ctaHref === "string" && r.ctaHref ? r.ctaHref : undefined) ??
			"/catalog",
	};
});

// Канон width (s/m/l/full): large/отсутствие = .satin-container 1320 (литерал
// CollectionRows.astro:50); medium 1080, small 780, full — на всю ширину
// (поля .satin-pad секции остаются).
const widthCls =
	p.width === "small"
		? "mx-auto w-full max-w-[780px]"
		: p.width === "medium"
			? "mx-auto w-full max-w-[1080px]"
			: p.width === "large"
				? "mx-auto w-full max-w-[1320px]"
				: p.width === "full"
					? "w-full"
					: "satin-container";

// Владелец 2026-09-17 (дословно): «контейнер и медиа соприкасаются, если медиа
// маленького размера, контейнер берёт на себя больше места и так же наоборот».
// Тот же топ-уровневый проп «Ширина» (widthCls выше не трогаем — он держит
// потолок ряда) теперь ДОПОЛНИТЕЛЬНО задаёт ДОЛЮ медиа внутри пары: small —
// медиа уже текста (2:3 ⇒ 40%), medium — примерно половина (1:1, эталон
// владельца), large — медиа шире текста (3:2 ⇒ 60%). Доли — литералы в
// ОБЪЕКТЕ (не конкатенация числа в шаблонной строке): сканер Tailwind ищет
// ЦЕЛЫЙ класс текстом в исходнике, а `grid-cols-[${a}fr_${b}fr]` с
// подставленным числом в бандл не попадёт (тот же класс-призрак, что уже
// ловили на lg:basis-1/2 — см. media-text-pair.spec.ts). satin переходит на
// две колонки на md: (не lg:, как остальные темы) — паритет CollectionRows.
const ROW_SPLIT: Record<"small" | "medium" | "large", { mediaFirst: string; textFirst: string }> = {
	small: { mediaFirst: "md:grid-cols-[2fr_3fr]", textFirst: "md:grid-cols-[3fr_2fr]" },
	medium: { mediaFirst: "md:grid-cols-[1fr_1fr]", textFirst: "md:grid-cols-[1fr_1fr]" },
	large: { mediaFirst: "md:grid-cols-[3fr_2fr]", textFirst: "md:grid-cols-[2fr_3fr]" },
};
// Отсутствие значения ведёт себя как «Большая» — ровно так же, как потолок
// ряда выше (widthCls: без width = max-w-[1320px], то есть large). Раньше доля
// при отсутствии падала в "medium", и секция без настройки брала потолок
// большой ширины с долей средней — два разных ответа на один и тот же «проп не
// задан». Гард дефолтов панели это и поймал: рендер со значением и без него
// расходился (pnpm test:panel-defaults, MultiRows.width).
const rowSplitKey: "small" | "medium" | "large" =
	p.width === "small" ? "small" : p.width === "medium" ? "medium" : "large";

// РЕГРЕСС 24.09 (7c87010e) — под признаком без «Ширины» сюда подставлялась
// геометрия верстальщика (md:grid-cols-2 md:gap-10, ряды gap-12 md:gap-20, текст
// без md:p-8), и она перебивала решения владельца 17–20.09 (f3ffa73e, ed711995,
// b68871f1, ebd40ea0, a01dfd7a, ae55ded6, 4287e8ae): пара ряда впритык, у
// текстовой колонки свои поля 32px, доля медиа по ROW_SPLIT (незаданная
// «Ширина» = large), между рядами 32px. Решение владельца главнее вёрстки
// верстальщика — ветки под designParity здесь больше нет ни при каком
// значении «Ширины». ROW_TEXT_CLS.designers (размер текста ряда) — другая
// настройка, эта задача её не трогает.

// Канон alignment текст-колонки: left/отсутствие = ЛИТЕРАЛ (без классов —
// контент слева, CollectionRows.astro:62); center/right двигают содержимое.
const alignCls =
	p.alignment === "center"
		? " items-center text-center"
		: p.alignment === "right"
			? " items-end text-right"
			: "";

// Канон buttonStyle — цвета кнопки ИЗ СХЕМЫ секции, как в остальных темах:
// «Основная» (primary, дефолт панели) и «Чёрная» — роль «Основная кнопка»
// схемы (--color-button-*), «Белая» — «Дополнительная кнопка»
// (--color-button-2-*). Раньше «Основная» рисовалась светлым контуром
// (литерал верстальщика CollectionRows.astro:67), и заливка основной кнопки
// из схемы до секции не доходила (тестер 24.09: «в схеме основная кнопка
// чёрная, а рисуется с бордером»). Без значения — как «Основная»: панель
// показывает её же. Метрики .satin-button-md (g:106-126); mt-auto w-fit —
// кнопка прижата к низу ряда (литерал).
const btnBase =
	"mt-auto inline-flex min-h-12 w-fit items-center justify-center rounded-[var(--radius-button,0px)] border border-solid px-6 text-[16px] font-normal leading-none transition-opacity duration-[180ms] hover:opacity-[0.78]";
const BTN_PRIMARY_CLS =
	"border-[rgb(var(--color-button-border,0_0_0))] bg-[rgb(var(--color-button-bg,0_0_0))] text-[rgb(var(--color-button-text,255_255_255))]";
const BTN_SECONDARY_CLS =
	"border-[rgb(var(--color-button-2-border,255_255_255))] bg-[rgb(var(--color-button-2-bg,255_255_255))] text-[rgb(var(--color-button-2-text,0_0_0))]";
const BTN_STYLE_CLS: Record<string, string> = {
	primary: BTN_PRIMARY_CLS,
	black: BTN_PRIMARY_CLS,
	solid: BTN_PRIMARY_CLS,
	white: BTN_SECONDARY_CLS,
	secondary: BTN_SECONDARY_CLS,
};
const btnCls = `${btnBase} ${BTN_STYLE_CLS[String(p.buttonStyle)] ?? BTN_PRIMARY_CLS}`;

// Канон containerEnabled (toggle «Контейнер»; canon-default ВЫКЛ — паритет
// rose/MultiColumns). ИСПРАВЛЕНИЕ канона Nikita: ВКЛ рисует surface-бокс §4
// (245_245_245 + p-6, БЕЗ радиуса) на КАЖДЫЙ ряд (per-element, эталон bloom
// MultiColumns), НЕ один общий. ВЫКЛ — ряды голо на фоне секции, без бокса/схемы.
const containerEnabled = String(p.containerEnabled ?? "false") === "true";
// Схема КОНТЕЙНЕРА (п.2 тестировщика 2026-09-13). «Контейнер» мультирядов — это
// ВСЯ половина ряда напротив медиа, поэтому класс висит на текстовой колонке, а
// не на обёртке рядов: там он красил заодно и подложку картинки. Схема НЕ
// гейтится тогглом «Контейнер» — это независимые контролы (в панели satin поле
// `containerColorScheme` скрыто, но рендер обязан честно отработать значение из
// ревизии). Значение принимаем и строкой, и числом — см. lib/color-scheme.ts.
const containerSchemeId = schemeIdOf(p.containerColorScheme);
// Один класс схемы только переопределяет CSS-переменные. Чтобы мерчант увидел
// цвет, на том же узле нужны фон/текст, читающие их; h-full + justify-center
// растягивают контейнер на высоту ряда, отступ — манера контейнера темы (§4:
// p-6 без радиуса, те же, что у rowBoxCls ниже).
// Текст ряда прижат к ВЕРХУ, а не центрирован (владелец 19.09: «надо чтобы у
// нижнего был отступ как у верхнего»). Замер в его конструкторе: у низкого ряда
// заголовок отбит от верха на 32px, у высокого — на 71px, потому что
// `justify-center` делит остаток поровну, и чем выше ряд, тем больше отбивка.
// Соседние ряды с разными размерами выглядели по-разному при одинаковых
// настройках текста. `h-full` остаётся: он и растягивает контейнер на высоту
// ряда, ради чего колонка вообще получает класс схемы.
const containerSchemeCls = containerSchemeId
	? ` color-scheme-${containerSchemeId} bg-[rgb(var(--color-bg,255_255_255))] text-[rgb(var(--color-text,0_0_0))] h-full p-6`
	: "";
// Per-element подложка ряда (satin §4: surface 245_245_245 + p-6, БЕЗ радиуса) при ВКЛ.
const rowBoxCls = containerEnabled ? "bg-[rgb(var(--color-surface,245_245_245))] p-6" : "";

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе.
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;

const titleId = id && heading ? `${id}-title` : undefined;

// §4 Контракта секции: секция сама ставит свою цветовую схему. В превью
// конструктора блок перерисовывается БЕЗ обёртки композитора и иначе берёт
// :root (базовую палитру) — мерчант видит это как «поменял одну секцию, а
// соседние перекрасились». На live обёртка даёт ту же схему, дубль безвреден.
// Схема приходит строкой ИЛИ числом (нормализатор Slideshow) — разбираем оба.
const _rawScheme = p.colorScheme;
const _schemeId =
	typeof _rawScheme === "number"
		? String(_rawScheme)
		: typeof _rawScheme === "string" && _rawScheme
			? String(_rawScheme).replace("scheme-", "")
			: "";
const selfSchemeClass = _schemeId ? ` color-scheme-${_schemeId}` : "";

// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((Astro.props as any).hiddenFields)
	? ((Astro.props as any).hiddenFields as unknown[]).filter(
			(x): x is string => typeof x === 'string',
		)
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);

---

{/* Секция: вертикаль-просторно §2 (py-12 md:py-16 — литерал CollectionRows.astro:49), поля .satin-pad. */}
<section
	class={`satin-pad w-full bg-[rgb(var(--color-bg,255_255_255))] py-12 md:py-16${selfSchemeClass}`}
	aria-labelledby={titleId}
	aria-label={heading ? undefined : "Коллекции"}
	data-puck-component-id={id}
	style={paddingStyle}
>
	<div class={`${widthCls} flex flex-col gap-8`}>
		{
			heading && !isFieldHidden('heading') && (
				<h2
					id={titleId}
					class={headingCls}
					data-puck-subsection-parent={id}
					data-puck-subsection-index="100"
					data-puck-subsection-field="heading"
					set:html={inlineFormat(heading)}
				/>
			)
		}
		{/* Ряд: grid items-stretch gap-8 md:grid-cols-2 md:gap-10 (литерал
		    CollectionRows.astro:50-52). Зазор МЕЖДУ рядами — канон владельца
		    2026-09-17 (Shopify Row): ряды ВПЛОТНУЮ, зазор РОВНО ноль на md:
		    (satin переходит на двухколоночную раскладку ряда на md:, а не lg:,
		    как остальные темы — media-text-pair.spec.ts). На мобильном (одна
		    колонка) зазор оставлен, иначе ряды сливаются в кашу
		    (multirows-row-gap.spec.ts). */}
		<div class="flex flex-col gap-8">
			{
				rows.map((row, i) => (
					<div
						class:list={[
							"grid grid-cols-1 items-stretch gap-8 md:gap-0",
							ROW_SPLIT[rowSplitKey][row.right ? "textFirst" : "mediaFirst"],
							rowBoxCls,
						]}
						data-puck-subsection-parent={hasRealRows ? id : undefined}
						data-puck-subsection-index={hasRealRows ? i : undefined}
						data-puck-subsection-field={hasRealRows ? "rows" : undefined}
					>
						{/* Реальное фото ИЛИ дизайн-ассет ряда пустого состояния
						    (landscape-multirows-image.png) — на тёмной подложке #111111
						    (cover, full-bleed фото §4). Контракт картиночных секций
						    (правило 2): картинка показывается ВСЕГДА, surface-rect не остаётся. */}
						<div
							class:list={[
								// `w-full` обязателен рядом с `md:h-full`: без него `aspect-*` считает ШИРИНУ
								// от высоты, и медиа вылезает за свою колонку сетки. Замер живого
								// стенда satin 20.09: дорожка 312px, медиа 357px — текстовый блок
								// наезжал на фото на 45px. У остальных четырёх тем класс был с самого
								// начала, поэтому там этого не было.
								"relative w-full overflow-hidden rounded-[var(--radius-media,0px)] md:h-full",
								row.image ? "bg-[#111111]" : "bg-[#FBFBFB]",
								row.aspectCls,
								row.right && "md:order-2",
							]}
							aria-hidden={row.image ? undefined : "true"}
						>
							{row.image &&
								(row.image.startsWith("/") && !row.image.startsWith("/placeholders/") ? (
									<SatinPicture
										src={row.image}
										alt={row.alt}
										loading="lazy"
										class="absolute inset-0 size-full object-cover"
									/>
								) : (
									<img
										src={row.image}
										alt={row.alt}
										loading="lazy"
										class="absolute inset-0 size-full object-cover"
									/>
								))}
						</div>
						<div class:list={[`flex flex-col gap-5 md:p-8${alignCls}${containerSchemeCls}`, row.right && "md:order-1"]}>
							{row.heading && <h3 class={row.headingCls} set:html={inlineFormat(row.heading)} />}
							{row.paragraphs.length > 0 && (
								<div class="flex flex-col gap-3">
									{row.paragraphs.map((para) => (
										<p class={row.textCls} set:html={inlineFormat(para)} />
									))}
								</div>
							)}
							{row.btnText && (
								<a href={row.btnHref} class={btnCls}>
									{row.btnText}
								</a>
							)}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
