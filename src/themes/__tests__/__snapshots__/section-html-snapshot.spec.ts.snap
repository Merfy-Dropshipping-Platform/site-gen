exports[`снимки секций — bloom Slideshow — снимок разметки 1`] = `"<section class="relative w-full overflow-hidden bg-[rgb(var(--color-bg,255_255_255))] color-scheme-1" data-puck-component-id="Slideshow-1" data-bloom-slideshow data-interval="5000" data-autoplay="false" style="padding-top:40px;padding-bottom:40px;"> <div class="w-full"> <div class="relative mx-auto w-full overflow-hidden min-h-[560px] aspect-[375/812] sm:aspect-[768/968] md:aspect-[1280/968] xl:aspect-[1920/925]"> <div data-slide class="!absolute inset-0 transition-opacity duration-700 ease-out opacity-100" data-puck-subsection-parent="Slideshow-1" data-puck-subsection-index="0" data-puck-subsection-field="slides"> <img src="/placeholders/landscape-slideshow.png" alt="Слайд" loading="eager" class="absolute inset-0 !h-full !w-full object-cover object-center"> <div class="relative z-10 flex h-full w-full px-4 pb-8 md:px-20 md:pb-12 xl:pb-20 2xl:px-[300px] items-end justify-start"> <div class="flex w-full max-w-[480px] flex-col gap-4 items-start text-left"> <div class="flex flex-col gap-2 items-start text-left"> <h2 class="hero-animate-1 font-urbanist text-[28px] font-normal leading-none text-[rgb(var(--color-heading,227_142_159))] md:text-[34px]">Слайд</h2> <p class="hero-animate-2 font-inter text-[14px] font-light leading-[1.2] text-[rgb(var(--color-text,227_142_159))] md:text-[16px]">Подзаголовок</p> </div> <a href="/catalog" class="hero-animate-3 inline-flex h-[52px] min-w-[150px] items-center justify-center rounded-[var(--radius-button,100px)] bg-[rgb(var(--color-button-bg,227_142_159))] px-6 font-inter text-[16px] font-light leading-none text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-90 active:scale-95"> Кнопка </a> </div> </div> </div> </div> </div> </section> <script> (function () { function initOne(root) { if (root.dataset.slideshowHydrated === "true") return; root.dataset.slideshowHydrated = "true"; var interval = parseInt(root.dataset.interval || "5000", 10); var autoplay = root.dataset.autoplay !== "false"; var slides = root.querySelectorAll("[data-slide]"); var dots = root.querySelectorAll("[data-slide-dot]"); if (slides.length < 2) return; var idx = 0, timer = null; // Каскад hero-animate-1/2/3 на активном слайде — перезапуск CSS-анимации // манеры (animation:none → reflow → снятие), как при загрузке героя. function replayCascade(slide) { var els = slide.querySelectorAll(".hero-animate-1,.hero-animate-2,.hero-animate-3"); for (var j = 0; j < els.length; j++) { els[j].style.animation = "none"; void els[j].offsetWidth; els[j].style.animation = ""; } } function show(n) { idx = (n + slides.length) % slides.length; for (var j = 0; j < slides.length; j++) { slides[j].style.opacity = j === idx ? "1" : "0"; slides[j].style.pointerEvents = j === idx ? "auto" : "none"; } for (var j = 0; j < dots.length; j++) { dots[j].setAttribute("data-active", j === idx ? "true" : "false"); } replayCascade(slides[idx]); } function restart() { if (timer) clearInterval(timer); if (autoplay) timer = setInterval(function () { show(idx + 1); }, interval); } root.querySelectorAll("[data-slide-prev]").forEach(function (b) { b.addEventListener("click", function () { show(idx - 1); restart(); }); }); root.querySelectorAll("[data-slide-next]").forEach(function (b) { b.addEventListener("click", function () { show(idx + 1); restart(); }); }); dots.forEach(function (d, i) { d.addEventListener("click", function () { show(i); restart(); }); }); show(0); restart(); } function initAll() { var roots = document.querySelectorAll("[data-bloom-slideshow]"); for (var k = 0; k < roots.length; k++) initOne(roots[k]); } initAll(); // Hot-replace превью вставляет секцию заново (новый узел без флага) и шлёт // astro:page-load — реинициализация подхватит свежий слайдер. document.addEventListener("astro:page-load", initAll); })(); </script>"`;

