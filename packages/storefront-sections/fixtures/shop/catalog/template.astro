---
const { settings, blocks, page, theme } = Astro.props;
---
<!-- Значки — Lucide (image, plus, minus, heart, chevron-down, sliders-horizontal, search-x), лицензия ISC, lucide.dev/license. -->
<div
  class="mx-auto grid max-w-page gap-6 px-4 font-body text-foreground data-[filters-side=true]:md:grid-cols-4 md:gap-8"
  data-behavior="catalog"
  data-paging={settings.paging}
  data-filters-side={blocks.some((item) => item.type === 'filters' && item.settings['filter-position'] === 'side')}
>
  {(settings.heading || page.list) && (
    <div class="col-span-full flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      {settings.heading && page.id === 'catalog' && (
        <h1 class="m-0 font-heading weight-heading tracking-heading text-3xl text-heading md:text-4xl" set:html={settings.heading} />
      )}
      {settings.heading && page.id !== 'catalog' && (
        <h2 class="m-0 font-heading weight-heading tracking-heading text-2xl text-heading md:text-3xl" set:html={settings.heading} />
      )}
      {page.list && page.list.total > 0 && <p class="m-0 text-sm text-muted-foreground">Товаров: {page.list.total}</p>}
    </div>
  )}
  {page.list && page.list.query.q && (
    <p class="col-span-full m-0 text-base text-muted-foreground">Результаты поиска: «{page.list.query.q}»</p>
  )}
  {page.list && blocks.length > 0 && (
    <form
      class="m-0 flex min-w-0 flex-col gap-4 border-b border-border pb-5 md:flex-row md:flex-wrap md:items-center md:in-data-[filters-side=true]:col-span-1 md:in-data-[filters-side=true]:flex-col md:in-data-[filters-side=true]:items-stretch md:in-data-[filters-side=true]:self-start md:in-data-[filters-side=true]:border-b-0 md:in-data-[filters-side=true]:pb-0"
      data-part="filters"
      method="get"
      action={page.list.url}
    >
      {page.list.query.q && <input type="hidden" name="q" value={page.list.query.q} />}
      {blocks.map((block) => (
        <div
          class="flex min-w-0 flex-col gap-3 data-[type=filters]:md:flex-1 data-[type=filters]:md:flex-row data-[type=filters]:md:flex-wrap data-[type=filters]:md:items-center data-[type=sort]:md:ml-auto data-[type=subheading]:w-full md:in-data-[filters-side=true]:data-[type=filters]:flex-none md:in-data-[filters-side=true]:data-[type=filters]:flex-col md:in-data-[filters-side=true]:data-[type=filters]:items-stretch md:in-data-[filters-side=true]:data-[type=sort]:ml-0"
          data-type={block.type}
        >
          {block.type === 'subheading' && block.settings.heading && (
            <p class="m-0 text-lg text-heading" set:html={block.settings.heading} />
          )}
          {block.type === 'sort' && (
            <div class="relative md:min-w-56">
              <select
                class="h-11 w-full cursor-pointer appearance-none rounded-input border-width-input border-input bg-background pl-4 pr-11 text-sm text-foreground shadow-input focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                name="sort"
                aria-label="Сортировка"
              >
                {page.list.sorts.map((sort) => <option value={sort.value} selected={sort.selected}>{sort.label}</option>)}
              </select>
              <svg class="pointer-events-none absolute right-4 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </div>
          )}
          {block.type === 'filters' && page.list.facets && (
            <Fragment>
              {page.list.facets.collections.length > 0 && (
                <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 md:mx-0 md:flex-wrap md:overflow-visible md:px-0 md:pb-0 md:in-data-[filters-side=true]:flex-col md:in-data-[filters-side=true]:items-start" role="group" aria-label="Разделы">
                  <a
                    class="inline-flex h-11 shrink-0 items-center rounded-button border-width-input border-border bg-background px-4 text-sm text-foreground no-underline hover:bg-accent hover:text-accent-foreground aria-[current=page]:border-primary-border aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground"
                    href={page.list.url}
                    aria-current={page.list.facets.collections.some((collection) => collection.selected) ? undefined : 'page'}
                  >Все</a>
                  {page.list.facets.collections.map((collection) => (
                    <label class="relative inline-flex shrink-0 cursor-pointer">
                      <input class="peer sr-only" type="checkbox" name="collection" value={collection.slug} checked={collection.selected} />
                      <span class="inline-flex h-11 items-center rounded-button border-width-input border-border bg-background px-4 text-sm text-foreground hover:bg-accent hover:text-accent-foreground peer-checked:border-primary-border peer-checked:bg-primary peer-checked:text-primary-foreground peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ring">{collection.title}</span>
                    </label>
                  ))}
                </div>
              )}
              <div class="flex flex-wrap items-center gap-3 md:ml-auto md:in-data-[filters-side=true]:ml-0 md:in-data-[filters-side=true]:flex-col md:in-data-[filters-side=true]:items-start">
                <label class="group inline-flex h-11 cursor-pointer items-center gap-3 text-sm text-foreground">
                  <input class="peer sr-only" type="checkbox" name="availability" value="in_stock" checked={page.list.query.availability === 'in_stock'} />
                  <span class="flex h-6 w-10 shrink-0 items-center rounded-full bg-border p-0.5 peer-checked:bg-primary peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ring">
                    <span class="size-5 rounded-full bg-background transition-transform group-has-checked:translate-x-4 motion-reduce:transition-none"></span>
                  </span>
                  Только в наличии
                </label>
                {page.list.facets.price && (
                  <fieldset class="m-0 flex items-center gap-2 border-0 p-0">
                    <legend class="sr-only">Цена, ₽</legend>
                    <input class="h-11 w-28 rounded-input border-width-input border-input bg-background px-3 text-sm text-foreground shadow-input focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" type="number" inputmode="numeric" min="0" name="min_price" value={page.list.query.minPrice ?? ''} placeholder={`от ${Math.floor(page.list.facets.price.min.amount / 100)}`} aria-label="Цена от, ₽" />
                    <input class="h-11 w-28 rounded-input border-width-input border-input bg-background px-3 text-sm text-foreground shadow-input focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" type="number" inputmode="numeric" min="0" name="max_price" value={page.list.query.maxPrice ?? ''} placeholder={`до ${Math.ceil(page.list.facets.price.max.amount / 100)}`} aria-label="Цена до, ₽" />
                  </fieldset>
                )}
              </div>
              {page.list.facets.groups.length > 0 && (
                <div class="flex flex-col gap-5 md:flex-row md:flex-wrap md:items-start md:in-data-[filters-side=true]:flex-col">
                  {page.list.facets.groups.map((group) => (
                    <fieldset class="m-0 flex flex-col gap-3 border-0 border-t border-border p-0 pt-4 md:border-t-0 md:pt-0 md:in-data-[filters-side=true]:border-t md:in-data-[filters-side=true]:pt-4">
                      <legend class="float-left mb-3 w-full p-0 text-sm text-heading">{group.name}</legend>
                      <div class="flex flex-wrap gap-2">
                        {group.values.map((value) => (
                          <label class="relative inline-flex cursor-pointer">
                            <input class="peer sr-only" type="checkbox" name={`filter.${group.key}`} value={value.value} checked={value.selected} />
                            <span class="inline-flex h-11 items-center rounded-button border-width-input border-border px-4 text-sm hover:bg-accent hover:text-accent-foreground peer-checked:border-primary-border peer-checked:bg-primary peer-checked:text-primary-foreground peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-ring">{value.value}</span>
                          </label>
                        ))}
                      </div>
                    </fieldset>
                  ))}
                </div>
              )}
            </Fragment>
          )}
        </div>
      ))}
    </form>
  )}
  {page.list && (
    <div class="flex min-w-0 flex-col gap-8 md:in-data-[filters-side=true]:col-span-3">
      {page.list.prev && (
        <a class="inline-flex h-11 items-center justify-center self-center rounded-button border-width-input border-border px-6 text-sm text-foreground no-underline hover:bg-accent hover:text-accent-foreground" data-part="prev" href={page.list.prev}>Показать предыдущие</a>
      )}
      {page.list.items.length === 0 && (
        <div class="flex flex-col items-center gap-4 rounded-card bg-muted px-6 py-16 text-center" data-part="empty">
          <svg class="size-10 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13.5 8.5-5 5" /><path d="m8.5 8.5 5 5" /><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
          <p class="m-0 font-heading weight-heading text-xl text-heading">Ничего не нашли</p>
          <p class="m-0 max-w-sm text-sm text-muted-foreground">Попробуйте убрать часть фильтров или посмотрите все товары.</p>
          <a class="inline-flex h-11 items-center justify-center rounded-button border-width-button border-primary-border bg-primary px-6 text-sm text-primary-foreground no-underline shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground" href={page.list.url}>Показать все товары</a>
        </div>
      )}
      <ul
        class="m-0 grid list-none gap-x-grid-column gap-y-grid-row p-0 data-[columns-mobile=1]:grid-cols-1 data-[columns-mobile=2]:grid-cols-2 md:data-[columns=1]:grid-cols-1 md:data-[columns=2]:grid-cols-2 md:data-[columns=3]:grid-cols-3 md:data-[columns=4]:grid-cols-3 md:data-[columns=5]:grid-cols-3 md:data-[columns=6]:grid-cols-3 lg:data-[columns=4]:grid-cols-4 lg:data-[columns=5]:grid-cols-5 lg:data-[columns=6]:grid-cols-6"
        data-part="list"
        data-page={page.list.page}
        data-columns={settings.columns}
        data-columns-mobile={settings['columns-mobile']}
        data-aspect-ratio={settings['aspect-ratio']}
        data-image-fit={settings['image-fit']}
        data-button-style={settings['button-style']}
        data-swatches={settings.swatches}
      >
        {page.list.items.map((card) => (
          <li class="group/card relative flex h-full min-w-0 flex-col gap-3 border-border card-style-card:rounded-card card-style-card:border-width-card card-style-card:bg-card card-style-card:p-card card-style-card:text-card-foreground card-style-card:shadow-card card-align-center:text-center card-align-right:text-right motion-hover-lift:transition-transform motion-hover-lift:hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0" data-available={card.available} data-ref="card">
            <div class="relative">
              <a
                class="block overflow-hidden rounded-media border-width-media border-border bg-muted shadow-media in-data-[aspect-ratio=portrait]:aspect-3/4 in-data-[aspect-ratio=square]:aspect-square in-data-[aspect-ratio=landscape]:aspect-4/3"
                href={card.url}
                tabindex="-1"
                aria-hidden="true"
              >
                {card.image ? (
                  <div class="size-full" data-behavior="card-photos" data-photos={card.images.join(' ')} data-hover-next={settings['next-photo']}>
                    <img class="size-full in-data-[image-fit=contain]:object-contain in-data-[image-fit=cover]:object-cover" data-part="image" src={card.image} alt={card.title} loading="lazy" />
                  </div>
                ) : (
                  <span class="flex size-full items-center justify-center text-muted-foreground">
                    <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /></svg>
                  </span>
                )}
              </a>
              {card.compareAtPrice && card.compareAtPrice.amount > card.price.amount && (
                <span class="absolute left-2 top-2 rounded-badge bg-sale px-2 py-1 text-xs text-sale-foreground md:left-3 md:top-3">−{Math.round((1 - card.price.amount / card.compareAtPrice.amount) * 100)} %</span>
              )}
              <span class="absolute bottom-2 left-2 rounded-badge bg-background px-2 py-1 text-xs text-foreground in-data-[available=true]:hidden md:bottom-3 md:left-3">Нет в наличии</span>
              {theme['wishlist-enabled'] !== false && settings.favorite && (
                <button
                  type="button"
                  class="group/heart absolute right-1 top-1 inline-flex size-11 items-center justify-center rounded-full border-0 bg-transparent p-0 text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:right-2 md:top-2"
                  aria-pressed="false"
                  aria-label="В избранное"
                  data-action="favorites.toggle"
                  data-product-id={card.id}
                  data-ref="heart"
                >
                  <span class="inline-flex size-9 items-center justify-center rounded-full bg-background/90 shadow-media">
                    <svg class="size-5 group-aria-[pressed=true]/heart:fill-current group-aria-[pressed=true]/heart:text-sale" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" /></svg>
                  </span>
                </button>
              )}
              {settings['quick-add'] === 'button' && (
                <button
                  type="button"
                  class="absolute bottom-2 right-2 inline-flex size-11 items-center justify-center rounded-button border-width-button border-primary-border bg-primary p-0 text-primary-foreground shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring in-data-[available=false]:hidden md:bottom-3 md:right-3"
                  data-action="cart.add"
                  data-product-id={card.id}
                  data-variant-id={card.variantId ?? undefined}
                  aria-label={`В корзину: ${card.title}`}
                >
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                </button>
              )}
              {settings['quick-add'] === 'hover' && (
                <button
                  type="button"
                  class="absolute inset-x-2 bottom-2 inline-flex h-11 items-center justify-center rounded-button border-width-button border-primary-border bg-primary px-4 text-sm uppercase text-primary-foreground shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring in-data-[available=false]:hidden md:inset-x-3 md:bottom-3 md:opacity-0 md:group-hover/card:opacity-100"
                  data-action="cart.add"
                  data-product-id={card.id}
                  data-variant-id={card.variantId ?? undefined}
                >В корзину</button>
              )}
            </div>
            <div class="flex flex-1 flex-col gap-2">
              {settings.swatches !== 'none' && card.colors.length > 0 && (
                <div class="flex flex-wrap items-center gap-1" role="list" aria-label="Цвета">
                  {card.colors.map((color) => (
                    <span class="inline-flex size-5 overflow-hidden border border-border in-data-[swatches=circle]:rounded-full in-data-[swatches=square]:rounded-badge" role="listitem" title={color.title}>
                      <svg class="size-full" viewBox="0 0 20 20" role="img" aria-label={color.title}><rect width="20" height="20" fill={color.swatch} /></svg>
                    </span>
                  ))}
                </div>
              )}
              <a class="line-clamp-2 text-sm text-foreground no-underline hover:underline md:text-base" href={card.url}>{card.title}</a>
              <p class="m-0 flex flex-wrap items-baseline gap-x-2 card-align-center:justify-center card-align-right:justify-end">
                <span class:list={['text-base weight-heading md:text-lg', card.compareAtPrice ? 'text-sale' : 'text-price']}>{card.price.text}</span>
                {card.compareAtPrice && <s class="text-sm text-price-old">{card.compareAtPrice.text}</s>}
              </p>
              {(settings['quick-add'] === 'standard' || settings['quick-add'] === 'count') && (
                <div class="mt-auto flex flex-col gap-2 in-data-[available=false]:hidden">
                  {settings['quick-add'] === 'count' && (
                    <div class="flex h-11 items-center justify-between rounded-input border-width-input border-input bg-background text-foreground">
                      <button type="button" class="inline-flex size-11 items-center justify-center border-0 bg-transparent p-0 text-foreground disabled:opacity-40" aria-label="Меньше" data-action="less" data-ref="less" disabled>
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /></svg>
                      </button>
                      <span class="min-w-8 text-center text-base tabular-nums" data-ref="quantity" aria-live="polite">1</span>
                      <button type="button" class="inline-flex size-11 items-center justify-center border-0 bg-transparent p-0 text-foreground disabled:opacity-40" aria-label="Больше" data-action="more" data-ref="more">
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                      </button>
                    </div>
                  )}
                  <button
                    type="button"
                    class="inline-flex h-11 w-full items-center justify-center rounded-button border-width-button px-4 text-sm uppercase focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring in-data-[button-style=primary]:border-primary-border in-data-[button-style=primary]:bg-primary in-data-[button-style=primary]:text-primary-foreground in-data-[button-style=primary]:shadow-button in-data-[button-style=primary]:hover:bg-primary-hover in-data-[button-style=primary]:hover:text-primary-hover-foreground in-data-[button-style=secondary]:border-foreground in-data-[button-style=secondary]:bg-background in-data-[button-style=secondary]:text-foreground in-data-[button-style=secondary]:hover:bg-foreground in-data-[button-style=secondary]:hover:text-background in-data-[button-style=link]:border-transparent in-data-[button-style=link]:bg-transparent in-data-[button-style=link]:text-foreground in-data-[button-style=link]:underline in-data-[button-style=link]:underline-offset-4"
                    data-action="cart.add"
                    data-product-id={card.id}
                    data-variant-id={card.variantId ?? undefined}
                    data-quantity="1"
                    data-ref="buy"
                  >В корзину</button>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
      {page.list.items.length > 0 && (
        <div class="flex flex-col items-center gap-4 pt-4 text-center">
          <p class="m-0 text-sm text-muted-foreground">Показано <span data-part="count">{page.list.items.length}</span> из {page.list.total}</p>
          {page.list.next && (
            <a class="inline-flex h-12 items-center justify-center rounded-button border-width-input border-foreground bg-background px-8 text-sm text-foreground no-underline hover:bg-foreground hover:text-background focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" data-part="next" href={page.list.next}>Показать ещё</a>
          )}
          {page.list.pages > 1 && (
            <nav class="flex flex-wrap justify-center gap-1" data-part="pages" aria-label="Страницы">
              {page.list.links.map((link) => link.url ? (
                <a class="inline-flex size-11 items-center justify-center rounded-button text-sm text-foreground no-underline hover:bg-accent hover:text-accent-foreground aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground" href={link.url} aria-current={link.current ? 'page' : undefined}>{link.page}</a>
              ) : (
                <span class="inline-flex size-11 items-center justify-center text-sm text-muted-foreground">…</span>
              ))}
            </nav>
          )}
          {settings.collection && settings.collection.url && page.list.url !== settings.collection.url && (
            <a class="text-sm text-foreground underline underline-offset-4" href={settings.collection.url}>Смотреть все</a>
          )}
        </div>
      )}
      <p class="sr-only" data-part="status" aria-live="polite"></p>
    </div>
  )}
</div>
