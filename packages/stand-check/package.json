{
  "name": "@merfy/stand-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write --no-error-on-unmatched-pattern src __tests__ scripts",
    "format:check": "prettier --check --no-error-on-unmatched-pattern src __tests__ scripts",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "stand:run": "tsx src/cli/run.ts",
    "stand:baseline": "tsx src/cli/baseline.ts",
    "stand:compare": "tsx src/cli/compare.ts"
  },
  "dependencies": {
    "@merfy/tokens": "workspace:*",
    "playwright": "1.59.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "22.20.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.2",
    "prettier": "3.8.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0",
    "vitest": "3.2.7"
  }
}
