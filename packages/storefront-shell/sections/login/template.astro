---
const { settings } = Astro.props;
---

<!-- «Вход» — страница /login и /verify пяти старых тем, вид по умолчанию flux: узкая колонка по центру (w-96),
     центрированные заголовок и текст, поле e-mail с обязательной меткой, ошибка под полем, широкая кнопка с блеском
     «Отправляем...». Между блоками колонки один зазор 80 px (gap-20 flux): заголовок → поле → кнопка. Код из письма —
     на той же странице; шаги переключает script.ts (часть 10в, Р10в-11). Стёртые заголовок и текст не рисуются.
     Строки согласия с политикой нет — на проде «Вход» её не выводит (согласие — только в оформлении заказа). -->
<div class="mx-auto flex w-96 max-w-full flex-col items-center gap-20 px-5 font-body text-foreground">
  {(settings.heading || settings.text) && (
    <div class="flex flex-col items-center gap-2 text-center">
      {settings.heading && <h1 class="m-0 font-heading weight-heading text-xl uppercase text-heading" set:html={settings.heading} />}
      {settings.text && <p class="m-0 text-pretty text-base text-muted-foreground" set:html={settings.text} />}
    </div>
  )}
  <div data-ref="email-step" class="flex w-full flex-col gap-6">
    <div class="flex w-full flex-col gap-2">
      <label class="text-base text-muted-foreground" for="login-email">
        E-mail<span class="text-destructive" aria-hidden="true"> *</span>
      </label>
      <input
        id="login-email"
        data-ref="email"
        type="email"
        autocomplete="email"
        placeholder="example@merfy.ru"
        class="h-14 w-full rounded-input border-width-input border-input bg-background px-4 text-base text-foreground placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
      />
    </div>
    <p data-ref="email-error" role="alert" class="m-0 text-center text-sm text-destructive" hidden></p>
  </div>
  <div class="flex w-full flex-col items-center">
    <button
      type="button"
      data-ref="request"
      data-action="request"
      class="inline-flex h-14 w-full cursor-pointer items-center justify-center rounded-button border-width-button border-primary-border bg-primary px-4 text-base text-primary-foreground shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
    >
      <span data-ref="request-loading" class="inline-flex items-center gap-2" hidden>
        <svg class="size-5 motion-safe:animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle class="opacity-30" cx="12" cy="12" r="9" stroke-width="2" /><path d="M21 12a9 9 0 0 0-9-9" stroke-width="2" stroke-linecap="round" /></svg>
        Отправляем...
      </span>
      <span data-ref="request-text">{settings['button-label'] || 'Получить ссылку для входа'}</span>
    </button>
  </div>
  <div data-ref="code-step" class="flex w-full flex-col gap-6" hidden>
    <p class="m-0 text-center text-base text-muted-foreground">
      Мы отправили письмо на <span data-ref="sent-to"></span>. Перейдите по ссылке из письма или введите код из него
    </p>
    <input
      data-ref="code"
      inputmode="numeric"
      autocomplete="one-time-code"
      maxlength="6"
      placeholder="000000"
      class="h-14 w-full rounded-input border-width-input border-input bg-background px-4 text-center text-base text-foreground placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
    />
    <p data-ref="code-error" role="alert" class="m-0 text-center text-sm text-destructive" hidden></p>
    <button
      type="button"
      data-ref="verify"
      data-action="verify"
      class="inline-flex h-14 w-full cursor-pointer items-center justify-center rounded-button border-width-button border-primary-border bg-primary px-4 text-base text-primary-foreground shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
    >
      <span data-ref="verify-loading" class="inline-flex items-center gap-2" hidden>
        <svg class="size-5 motion-safe:animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><circle class="opacity-30" cx="12" cy="12" r="9" stroke-width="2" /><path d="M21 12a9 9 0 0 0-9-9" stroke-width="2" stroke-linecap="round" /></svg>
        Проверяем...
      </span>
      <span data-ref="verify-text">Войти</span>
    </button>
    <button
      type="button"
      data-action="change-email"
      class="inline-flex h-11 w-full cursor-pointer items-center justify-center rounded-button bg-transparent p-0 text-base text-muted-foreground underline underline-offset-4 hover:text-heading"
    >Изменить e-mail</button>
  </div>
  <p data-ref="checking" class="m-0 text-base text-muted-foreground" hidden>Входим…</p>
</div>
