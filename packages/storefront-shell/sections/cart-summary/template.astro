---
const { blocks } = Astro.props;
---
<div class="mx-auto flex max-w-page flex-col gap-6 px-4 font-body">
  {blocks.map((block) => (
    <div class="flex flex-col gap-3">
      {block.type === 'total' ? (
        <div class="flex flex-col gap-3">
          <p class="m-0">Сумма <span data-ref="subtotal"></span></p>
          <p data-ref="discount" class="m-0" hidden>
            <span data-ref="discount-name">Скидка</span> <span data-ref="discount-value"></span>
          </p>
          <p class="m-0">Итого <span data-ref="total"></span></p>
          <p class="m-0 text-sm text-muted-foreground">Налоги, скидки и стоимость доставки рассчитываются при оформлении заказа.</p>
        </div>
      ) : (
        <a href="/checkout" data-action="cart.checkout" data-ref="checkout" class="no-underline">Оформить заказ</a>
      )}
    </div>
  ))}
</div>
