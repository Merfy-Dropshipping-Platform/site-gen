exports[`стили записей в заказах: без data-look — прежний вид байт в байт вычисленные правила без атрибута не меняются 1`] = `".xo, .xo-row { box-sizing: border-box; font-family: var(--font-body, system-ui, sans-serif); font-weight: 300; color: #141414; } .xo *, .xo-row * { box-sizing: border-box; } .xo-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px; border: 1px solid #ECECEC; border-radius: 12px; background: #FFFFFF; text-decoration: none; } .xo-row-main { display: flex; flex-direction: column; gap: 4px; min-width: 0; } .xo-row-title { font-size: 15px; line-height: 1.35; } .xo-row-date { font-size: 12px; color: #8A8A8A; } .xo-badge { flex: none; padding: 3px 9px; border-radius: 11px; font-size: 12px; font-weight: 400; line-height: 16px; white-space: nowrap; background: #F1F1F3; color: #6B6B70; } .xo-badge[data-tone="info"] { background: #E7F3FE; color: #2472B8; } .xo-badge[data-tone="warning"] { background: #FDF2E2; color: #8F520A; } .xo-badge[data-tone="success"] { background: #E6F4EA; color: #2E7D46; } .xo-badge[data-tone="danger"] { background: #FDECEA; color: #B3261E; } .xo { display: flex; flex-direction: column; gap: 12px; font-size: 13.5px; line-height: 1.45; } .xo-back { align-self: flex-start; font-size: 13px; color: #6A6A6A; text-decoration: none; } .xo-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; } .xo-number { margin: 0; font-size: 20px; font-weight: 300; line-height: 1.2; } .xo-meta { font-size: 12px; color: #9A9A9A; } .xo-blocks { display: flex; flex-direction: column; gap: 12px; } .xo-text { margin: 0; } .xo-line { display: block; } .xo-lines { display: flex; flex-direction: column; } .xo-lines-row, .xo-lines-total, .xo-pair { display: flex; justify-content: space-between; gap: 12px; } .xo-lines-row { padding: 8px 0; border-bottom: 1px solid #ECECEC; } .xo-lines-total { padding-top: 10px; font-size: 17px; } .xo-lines-total .xo-value { font-weight: 400; } .xo-value { flex: none; text-align: right; } .xo-pairs { display: flex; flex-direction: column; gap: 4px; } .xo-pair { justify-content: flex-start; } .xo-pair .xo-label { flex: 0 0 50%; color: #8A8A8A; } .xo-pair .xo-value { text-align: left; } .xo-button { display: flex; align-items: center; justify-content: center; height: 46px; border-radius: 9px; background: #141414; color: #FFFFFF; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; } .xo-state { margin: 0; color: #9A9A9A; }"`;

exports[`стили формы покупки: без data-look — прежний вид байт в байт вычисленные правила без атрибута не меняются 1`] = `".xp { display: flex; flex-direction: column; gap: 12px; box-sizing: border-box; padding: 12px; border: 1px solid #ECECEC; border-radius: 14px; font-family: var(--font-body, system-ui, sans-serif); font-size: 13.5px; font-weight: 300; line-height: 1.45; color: #141414; /* Экран ответа прокручивается к началу формы: отступ — под липкую шапку темы (у flux 80 px). */ scroll-margin-top: 96px; } .xp[hidden] { display: none; } .xp *, .xp *::before, .xp *::after { box-sizing: border-box; } .xp.done { gap: 10px; padding: 0; border: 0; } .xp button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; } .xp .sf-h b { font-size: 15px; font-weight: 500; } .xp .sf-f { display: flex; flex-direction: column; gap: 5px; min-width: 0; } .xp .sf-l { display: flex; justify-content: space-between; gap: 8px; font-size: 12.5px; color: #222222; } .xp .sf-l small { color: #A0A0A0; font-size: 11px; white-space: nowrap; } .xp .sf-in { width: 100%; min-height: 38px; padding: 8px 10px; border: 1px solid #E2E2E2; border-radius: 9px; background: #FFFFFF; font: inherit; font-size: 14px; line-height: 1.3; color: #141414; outline: none; } .xp .sf-in:focus { border-color: #141414; } .xp textarea.sf-in { min-height: 64px; resize: vertical; } .xp .sf-in.bad, .xp .sf-up.bad { border-color: #E5483C; } .xp .err { font-size: 11.5px; color: #D9473B; } .xp .sf-num { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; } .xp .sf-seg { display: flex; flex-wrap: wrap; gap: 6px; } .xp .sf-seg button { padding: 8px 12px; border: 1px solid #E2E2E2; border-radius: 9px; font-size: 13px; } .xp .sf-seg button.on { border-color: #141414; box-shadow: inset 0 0 0 1px #141414; } .xp .sf-up { position: relative; display: flex; align-items: center; gap: 10px; padding: 9px 10px; border: 1px dashed #CFCFCF; border-radius: 9px; background: #FFFFFF; cursor: pointer; } .xp .sf-up input { position: absolute; width: 1px; height: 1px; opacity: 0; } .xp .sf-up .ic { display: grid; place-items: center; flex: none; width: 30px; height: 30px; border-radius: 8px; background: #F2F2F2; font-size: 15px; } .xp .sf-up b { display: block; font-size: 13px; font-weight: 400; } .xp .sf-up small { font-size: 11px; color: #9A9A9A; } .xp .sf-th { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 5px; } .xp .sf-thumb { position: relative; display: grid; place-items: center; aspect-ratio: 1; overflow: hidden; border-radius: 8px; background: #F2F2F2; font-size: 10px; color: #9A9A9A; } .xp .sf-thumb img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; } .xp .sf-thumb.loading img { opacity: .5; } .xp .sf-thumb.failed { box-shadow: inset 0 0 0 1px #E5483C; } .xp .sf-thumb small { position: absolute; left: 3px; right: 3px; bottom: 3px; border-radius: 4px; background: rgba(255, 255, 255, .85); font-size: 9px; line-height: 1.3; text-align: center; color: #141414; } .xp .sf-thumb button { position: absolute; top: 3px; right: 3px; width: 18px; height: 18px; border-radius: 50%; background: rgba(0, 0, 0, .6); color: #FFFFFF; font-size: 11px; line-height: 18px; } .xp .sf-fl { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 9px; background: #F6F6F6; font-size: 12.5px; } .xp .sf-fl span { min-width: 0; overflow-wrap: anywhere; } .xp .sf-fl.failed { color: #D9473B; } .xp .sf-fl button { flex: none; color: #9A9A9A; } .xp .sf-cb { display: flex; align-items: flex-start; gap: 9px; font-size: 12.5px; cursor: pointer; } .xp .sf-cb input { flex: none; width: 17px; height: 17px; margin: 1px 0 0; accent-color: #141414; } .xp .sf-btn { display: flex; align-items: center; justify-content: center; width: 100%; height: 46px; border-radius: 9px; background: #141414; color: #FFFFFF; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; cursor: pointer; } .xp .sf-btn.light { background: #FFFFFF; color: #141414; border: 1px solid #141414; } .xp .sf-btn:disabled { opacity: .6; cursor: default; } .xp .sf-note { font-size: 11.5px; color: #9A9A9A; } .xp .okbox { display: flex; flex-direction: column; gap: 8px; padding: 16px; border-radius: 14px; background: #F2F8F3; } .xp .okbox b { font-size: 17px; font-weight: 500; } [data-extension-purchase-note] { margin-left: 6px; font-size: 12px; color: #8A8A8A; }"`;
