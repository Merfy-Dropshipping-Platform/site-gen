						{active && activeUnderline && <div class="h-px w-[54px] bg-[var(--vanilla-header-bg)]" aria-hidden="true"></div>}
						{subs.length > 0 && (
							<div class="flex flex-col gap-2 border-l border-[var(--vanilla-line)] pl-4" data-nav-sub hidden>
								{subs.map((c2) => {
									const kids2 = Array.isArray(c2.submenu)
