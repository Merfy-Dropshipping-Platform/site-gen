          {
            "value": "medium",
            "label": "Средняя"
          },
          {
            "value": "large",
            "label": "Большая"
          }
        ]
      }
    },
    {
      "id": "overlay",
      "label": "Затемнение",
      "setting": {
        "kind": "range",
        "default": 30,
        "min": 0,
        "max": 100,
        "step": 5
