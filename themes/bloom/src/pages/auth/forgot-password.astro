---
/**
 * Страница верстальщика (forgot-password) была отдельной формой с паролем и заглушкой
 * `alert("Демо-вход: авторизация ещё не подключена")`. Платформа перешла на вход
 * по ссылке из письма (passwordless), живые страницы — /login и /register,
 * поэтому здесь остаётся только перенаправление: две разные формы входа сбивали
 * покупателя, а нерабочая — тем более.
 */
const target = "/login";
---

<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<title>Восстановление доступа — Bloom</title>
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<link rel="canonical" href={target} />
		<meta name="robots" content="noindex" />
	</head>
	<body>
		<p>Переходим на страницу входа… <a href={target}>Открыть вручную</a></p>
		<script is:inline define:vars={{ target }}>
			window.location.replace(target);
		</script>
	</body>
</html>
