										<div class="flex flex-col gap-2" data-nav-group={kids2.length > 0 ? "" : undefined}>
											{kids2.length > 0 ? (
												<button
													type="button"
													data-nav-sub-toggle
													aria-expanded="false"
													class="flex w-full items-center justify-between gap-2 text-left text-[13px] font-normal leading-normal text-[var(--vanilla-muted)] transition-colors hover:text-[var(--vanilla-green)] [&[aria-expanded=true]>svg]:rotate-90"
												>
													<span>{c2.label}</span>
													<svg class="size-3 shrink-0 transition-transform" viewBox="0 0 8 8" fill="none" aria-hidden="true">
														<path d="M2.5 1 5.5 4 2.5 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
													</svg>
												</button>
											) : (
												<a
													href={c2.href}
													class="text-[13px] font-normal leading-normal text-[var(--vanilla-muted)] transition-colors hover:text-[var(--vanilla-green)]"
												>
													{c2.label}
												</a>
											)}
											{kids2.length > 0 && (
												<div class="flex flex-col gap-2 pl-4" data-nav-sub hidden>
													{kids2.map((k) => (
														<a
															href={k.href}
															class="text-[12px] font-normal leading-normal text-[var(--vanilla-muted)] transition-colors hover:text-[var(--vanilla-green)]"
														>
															{k.label}
														</a>
													))}
												</div>
											)}
										</div>
									);
								})}
							</div>
						)}
					</div>
				);
			})}
			{/* Здесь стояли ДВА зашитых пункта — «Корзина» и «Регистрация» — дописанных
			    после цикла по меню мерчанта, то есть остатки демо-вёрстки, а не его
			    настройка. «Регистрация» вела на страницу, которой нет: в сидах темы
			    есть только `login`. На витрине nginx отдавал на этот адрес заглушку
			    (200 с чужим содержимым), а в превью конструктора — 404 бэкенда
			    («Cannot GET /register»), ровно тот, что попал в отчёт тестера.
			    Меню шторки теперь показывает только пункты мерчанта. */}
		</nav>
	</div>

	{/* Вложенные пункты в шторке раскрываются нажатием (пункт 25 документа
	    владельца). Обработчик общий на все пять тем. */}
	<script is:inline set:html={NAV_SUBMENU_TOGGLE_SOURCE} />
	{stickiness === "scroll-up" && <script is:inline set:html={SCROLL_UP_JS} />}
	{/* Магазин для живого поиска шапки: `const shopId = ""` патчит сборка
	    (patchShopIdInDist) — как у подвала и корзины. В превью конструктора id
	    приходит глобалом __MERFY_SITE_ID__, пустая строка здесь ничего не ломает. */}
	<script is:inline define:vars={{ shopId }}>
		window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || { shopId: shopId || "", apiUrl: "https://gateway.merfy.ru/api" };
		if (shopId && !window.__MERFY_CONFIG__.shopId) window.__MERFY_CONFIG__.shopId = shopId;
	</script>
</div>

<script>
	import { focusSearchToggle, initHeaderSearch } from "../../../../packages/theme-base/runtime/header-search";
	import { renderSearchResults, SEARCH_MESSAGE_CLASS } from "../lib/header-search-view";

	// Живой поиск из лупы: панель шапки и шторка бургера (общий модуль на пять тем).
	initHeaderSearch({ render: renderSearchResults, messageClass: SEARCH_MESSAGE_CLASS });

	// Шторка встаёт под ФАКТИЧЕСКИЙ низ шапки. Сумма «промо + шапка» врала в двух
	// случаях: полосы объявления нет (брался фолбэк 48px — щель, сквозь которую
	// видна страница над строкой поиска шторки) и страница прокручена под липкой
	// шапкой (промо уже уехало вверх). Сумма осталась фолбэком, если шапки нет.
	const headerOffsetBelowPromo = () => {
		const headerEl = document.querySelector<HTMLElement>('[data-nt="vanilla-header"]');
		if (headerEl) return Math.max(0, Math.round(headerEl.getBoundingClientRect().bottom));
		const promo = document.querySelector<HTMLElement>("[data-vanilla-announcement]");
		return (promo?.offsetHeight ?? 48) + 80;
	};

	// Под шапку встаёт только нижняя шторка. Боковая панель стоит от верха экрана
	// и сама накрывает шапку, а ресайз окна (адресная строка телефона, смена
	// ширины в конструкторе) звал эту функцию без разбора — и панель съезжала под
	// верхнее меню (баг 5 документа «баги бокового меню»). Так же у flux и satin.
	const positionBurger = () => {
		const burger = document.getElementById("vanilla-burger");
		if (!burger || isSidebarDrawer()) return;
		burger.style.top = `${headerOffsetBelowPromo()}px`;
	};

	const setSearchOpen = (open: boolean) => {
		const panel = document.querySelector<HTMLElement>("[data-search-panel]");
		if (!panel) return;
		panel.setAttribute("aria-hidden", String(!open));
		if (open) {
			panel.style.maxHeight = `${panel.scrollHeight}px`;
			queueMicrotask(() => {
				panel.querySelector<HTMLInputElement>("input[type='search']")?.focus();
			});
		} else {
			panel.style.maxHeight = "0px";
		}
		document.querySelectorAll<HTMLElement>("[data-action='toggle-search']").forEach((btn) => {
			btn.setAttribute("aria-expanded", String(open));
		});
	};

	const isSearchPanelOpen = () => {
		const panel = document.querySelector<HTMLElement>("[data-search-panel]");
		if (!panel) return false;
		const h = panel.style.maxHeight;
		return Boolean(h && h !== "0px" && h !== "0");
	};

	const syncSearchPanelHeight = () => {
		const panel = document.querySelector<HTMLElement>("[data-search-panel]");
		if (!panel || !isSearchPanelOpen()) return;
		panel.style.maxHeight = `${panel.scrollHeight}px`;
	};

	const isSidebarDrawer = () => {
		const burger = document.getElementById("vanilla-burger");
		// Sidebar right-panel has inset-y-0 — detect via right-side positioning
		return burger ? burger.classList.contains("inset-y-0") : false;
	};

	const syncBurgerButtonIcons = (open: boolean) => {
		// Update ALL burger toggle buttons (mobile #vanilla-burger-btn + desktop [data-burger-toggle])
		document.querySelectorAll<HTMLElement>("[data-burger-toggle]").forEach((burgerBtn) => {
			burgerBtn.setAttribute("aria-expanded", String(open));
			burgerBtn.querySelectorAll<HTMLElement>(".burger-icon").forEach((el) => {
				const key = el.dataset.icon;
				if (key === "open") el.classList.toggle("hidden", open);
				else el.classList.toggle("hidden", !open);
			});
		});
	};

	const setBurger = (open: boolean) => {
		const burger = document.getElementById("vanilla-burger");
		if (!burger) return;
		if (open) setSearchOpen(false);
		burger.classList.toggle("hidden", !open);
		syncBurgerButtonIcons(open);
		// Страницу под открытым меню запираем на <html>, а не на <body>. У vanilla
		// `html { overflow-x: clip }` (global.css): overflow <body> тогда до окна не
		// доходит, и страница под панелью уезжала колесом (замер: 0 → 1400px, баг 2
		// документа «баги бокового меню»). Хуже того, <body> с overflow:hidden сам
		// становится прокручиваемым контейнером и отрывает липкую шапку от окна.
		// Замок на <html> запирает само окно — одинаково во всех пяти темах.
		document.documentElement.style.overflow = open ? "hidden" : "";
		// positionBurger only for mobile bottom-sheet (not right-side panel)
		if (open && !isSidebarDrawer()) positionBurger();
	};

	const syncHeaderChromeAfterNavigation = () => {
		document.documentElement.style.overflow = "";
		document.body.style.overflow = "";
		window.dispatchEvent(new CustomEvent("vanilla:login:close"));
		setSearchOpen(false);
		const burgerEl = document.getElementById("vanilla-burger");
		if (burgerEl) burgerEl.classList.add("hidden");
		syncBurgerButtonIcons(false);
		if (!isSidebarDrawer()) positionBurger();
	};

	// На телефоне поиск живёт в шторке бургера (макет «Бургер» 375): лупа
	// мобильной строки открывает шторку и ставит курсор в поле, а не выдвигает
	// десктопную панель. «Боковое» меню поля не несёт — тогда, как раньше, панель.
	const MOBILE_QUERY = "(max-width: 767.98px)";
	const openDrawerSearch = (): boolean => {
		if (!window.matchMedia(MOBILE_QUERY).matches) return false;
		const burgerEl = document.getElementById("vanilla-burger");
		const input = burgerEl?.querySelector<HTMLInputElement>("input[type='search']");
		if (!burgerEl || !input) return false;
		if (burgerEl.classList.contains("hidden")) setBurger(true);
		input.focus();
		return true;
	};

	// Гард на WINDOW, а не module-scope: контентные страницы несут две копии этого
	// скрипта (Astro-hoisted и инлайн из renderBlock шапки при сборке хрома), у
	// каждой свой module-scope — две привязки дают два переключения за клик
	// (панель открывалась и тут же закрывалась; разбор у rose, Header.astro).
	const vanillaWin = window as unknown as { __vanillaHeaderBound?: boolean };
	const bindHeaderDelegatedClicks = () => {
		if (vanillaWin.__vanillaHeaderBound) return;
		vanillaWin.__vanillaHeaderBound = true;

		document.addEventListener(
			"click",
			(event: MouseEvent) => {
				const raw = event.target;
				const el = raw instanceof Element ? raw : null;
				if (!el?.closest("[data-login-open]")) return;
				setSearchOpen(false);
				setBurger(false);
			},
			true
		);

		document.addEventListener("click", (event: MouseEvent) => {
			const raw = event.target;
			const el = raw instanceof Element ? raw : null;
			if (!el) return;

			if (el.closest("[data-burger-toggle]")) {
				const b = document.getElementById("vanilla-burger");
				if (!b) return;
				event.preventDefault();
				setBurger(b.classList.contains("hidden"));
				return;
			}

			if (el.closest("[data-action='toggle-search']")) {
				event.preventDefault();
				event.stopPropagation();
				if (openDrawerSearch()) return;
				const willOpen = !isSearchPanelOpen();
				const burger = document.getElementById("vanilla-burger");
				if (willOpen && burger && !burger.classList.contains("hidden")) {
					setBurger(false);
				}
				setSearchOpen(willOpen);
				return;
			}

			if (el.closest("#vanilla-burger a[href]")) {
				setBurger(false);
			}
		});

		document.addEventListener("click", (event: MouseEvent) => {
			if (!isSearchPanelOpen()) return;
			const target = event.target;
			if (!(target instanceof Node)) return;
			const panel = document.querySelector<HTMLElement>("[data-search-panel]");
			if (panel?.contains(target)) return;
			const tEl = target instanceof Element ? target : null;
			if (tEl?.closest?.("[data-action='toggle-search']")) return;
			setSearchOpen(false);
		});

		window.addEventListener("resize", () => {
			syncSearchPanelHeight();
			positionBurger();
		});

		// Панель выезжает анимацией max-height: после ответа поиска её высота
		// меняется — подгоняем, иначе список обрезался бы по старой высоте.
		document.addEventListener("merfy:header-search", syncSearchPanelHeight);

		// Escape закрывает панель (первый Escape в непустом поле его очищает — модуль поиска).
		document.addEventListener("keydown", (event: KeyboardEvent) => {
			if (event.key !== "Escape" || !isSearchPanelOpen()) return;
			setSearchOpen(false);
			focusSearchToggle();
		});
	};

	bindHeaderDelegatedClicks();
	document.addEventListener("astro:page-load", syncHeaderChromeAfterNavigation);
	syncHeaderChromeAfterNavigation();
</script>
