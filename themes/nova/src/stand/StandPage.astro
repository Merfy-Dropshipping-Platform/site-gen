---
// Страница стенда (design.md блока 2, 5.2): служебная, покупателю не видна. Лежит вне src/pages — адрес /theme-stand
// даёт интеграция standRoute, и только при сборке с MERFY_THEME_STAND=1.
// Образцы — общий компонент src/shop/stand/StandBody.astro: его же рисует стенд в превью конструктора (блок 8). Здесь —
// токены темы без правок мерчанта (tokensCss из @merfy/tokens по theme.json темы) и умолчания настроек из схемы панели
// платформы. Атрибуты выборов (стиль и выравнивание карточек) — у <html>, как у страниц магазина.
import "@fontsource/manrope/400.css";
import "@fontsource/manrope/600.css";
import {
	choiceAttributes,
	panelForTheme,
	parsePanel,
	parseTheme,
	resolveSettings,
	resolveTokens,
	tokensCss,
} from "../../../../packages/tokens/src/index";
import themeJson from "../../../../packages/theme-nova/theme.json";
import panelJson from "../../../../packages/theme-contract/panel/theme-panel.json";
import StandBody from "../shop/stand/StandBody.astro";
import "../shop/stand/stand.css";
import { buildStorefrontConfig, configTag } from "../../../../packages/storefront-config/src/index";
import standInput from "../../../../packages/storefront-config/fixtures/stand-input.json";
import { STAND_PATH } from "../../../../packages/stand-check/src/stand-path.mjs";

const theme = parseTheme(themeJson.tokens);
const tokens = tokensCss(theme.dictionary, theme.tokens, {});
const attributes = choiceAttributes(theme.dictionary, resolveTokens(theme.dictionary, theme.tokens, {}));
const panel = panelForTheme(parsePanel(panelJson, theme.dictionary), undefined);
const settings = resolveSettings(panel, {});

// Конфиг магазина (design.md блока 3, 5.6): писатель зовётся при сборке страницы, тег — первым делом в <head>.
// Адрес API — из окружения сборки, команда stand задаёт его сама. Переменной нет — сборка падает и называет её.
const apiUrl = import.meta.env.PUBLIC_MERFY_API_URL;
if (!apiUrl) throw new Error("Стенду нужна переменная окружения PUBLIC_MERFY_API_URL — адрес API стенда");
const storefrontConfig = buildStorefrontConfig({
	site: standInput.site,
	theme: { id: themeJson.name, version: themeJson.version },
	env: { apiUrl },
	page: { id: "theme-stand", path: STAND_PATH },
	mode: "preview",
});
const configHtml = configTag(storefrontConfig);
---

<html lang="ru" {...attributes}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<Fragment set:html={configHtml} />
		<title>Стенд темы</title>
		<style id="merfy-tokens" is:inline set:html={tokens}></style>
	</head>
	<body class="bg-background">
		<StandBody schemes={Object.keys(theme.tokens.schemes)} settings={settings} shopName={standInput.site.name}>
			<section data-stand="config" class="flex flex-col gap-4">
				<h2 class="text-xl font-heading weight-heading text-heading">Конфиг магазина</h2>
				<dl class="grid grid-cols-[max-content_1fr] gap-x-6 gap-y-2 text-sm">
					<dt class="text-muted-foreground">Магазин</dt>
					<dd data-config-field="shop.name">—</dd>
					<dt class="text-muted-foreground">Режим</dt>
					<dd data-config-field="mode">—</dd>
					<dt class="text-muted-foreground">Версия темы</dt>
					<dd data-config-field="theme.version">—</dd>
					<dt class="text-muted-foreground">Страница</dt>
					<dd data-config-field="page.id">—</dd>
				</dl>
				<p data-config-error class="text-destructive" hidden></p>
				<script>
					import { renderConfigSection } from "./config-section";

					const section = document.querySelector('[data-stand="config"]');
					if (section !== null) renderConfigSection(section);
				</script>
			</section>
		</StandBody>
	</body>
</html>
