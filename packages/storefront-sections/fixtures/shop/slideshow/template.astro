---
const { settings, blocks } = Astro.props;
---
<!-- Листает поведение carousel: data-autoplay — секунды между слайдами (0 — не листать), data-part="dot" — нумерация
     (нажатие листает к слайду, текущий получает data-active), data-part="counter" — номер текущего слайда в счётчике.
     Вид нумерации — по data-numbering на корне: у каждой кнопки три значка, виден один. Позиция текста слайда: «сверху /
     по центру / снизу» — по началу значения, «слева / справа» — по концу, остальное — по центру. -->
<div
  class="relative font-body data-[image-frame=contained]:mx-auto data-[image-frame=contained]:max-w-page data-[image-frame=contained]:px-4 md:data-[image-frame=contained]:px-8"
  data-behavior="carousel"
  data-effect="fade"
  data-change="700"
  data-autoplay={settings.autoplay ? settings.interval : 0}
  data-image-frame={settings['image-frame']}
  data-height={settings.height}
  data-numbering={settings.numbering}
>
  <div data-part="viewport" class="overflow-hidden in-data-[image-frame=contained]:rounded-card">
    <div data-part="container" class="flex">
      {blocks.map((block) => (
        <div
          data-part="slide"
          class:list={['relative flex shrink-0 grow-0 basis-full flex-col overflow-hidden bg-muted in-data-[height=small]:min-h-80 md:in-data-[height=small]:min-h-112 in-data-[height=medium]:min-h-96 md:in-data-[height=medium]:min-h-136 lg:in-data-[height=medium]:min-h-152 in-data-[height=large]:min-h-112 md:in-data-[height=large]:min-h-160 lg:in-data-[height=large]:min-h-180', block.settings['color-scheme'] && `color-${block.settings['color-scheme']}`]}
          data-position={block.settings['content-position']}
          data-align={block.settings.align}
          data-text-box={block.settings['text-box']}
        >
          {block.settings.image !== '' && (
            <Fragment>
              <img src={block.settings.image} alt="" class="absolute inset-0 size-full object-cover" />
              <div class={`absolute inset-0 bg-foreground opacity-${block.settings.overlay}`}></div>
            </Fragment>
          )}
          <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-4 pb-16 pt-10 in-data-[position^=top]:justify-start in-data-[position^=bottom]:justify-end in-data-[position$=left]:items-start in-data-[position$=right]:items-end md:px-12 lg:px-20">
            <div
              data-part="copy"
              class={`flex w-fit max-w-xl flex-col gap-3 text-${block.settings.align} in-data-[align=left]:items-start in-data-[align=center]:items-center in-data-[align=right]:items-end in-data-[text-box=true]:rounded-card in-data-[text-box=true]:bg-background in-data-[text-box=true]:p-6 in-data-[text-box=true]:shadow-card md:in-data-[text-box=true]:p-8`}
            >
              {block.settings.heading && (
                <h2
                  class="m-0 text-balance font-heading weight-heading tracking-heading text-heading data-[heading-size=small]:text-xl md:data-[heading-size=small]:text-2xl data-[heading-size=medium]:text-2xl md:data-[heading-size=medium]:text-4xl data-[heading-size=large]:text-4xl md:data-[heading-size=large]:text-5xl"
                  data-heading-size={block.settings['heading-size']}
                  set:html={block.settings.heading}
                />
              )}
              {block.settings.text && (
                <p
                  class="m-0 text-pretty text-foreground data-[text-size=small]:text-sm data-[text-size=medium]:text-base data-[text-size=large]:text-lg md:data-[text-size=large]:text-xl"
                  data-text-size={block.settings['text-size']}
                  set:html={block.settings.text}
                />
              )}
              {block.settings['button-label'] && (
                <a
                  class="inline-flex h-12 items-center justify-center rounded-button border-width-button border-primary-border bg-primary px-8 text-base text-primary-foreground no-underline shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                  href={block.settings['button-link']}
                >
                  {block.settings['button-label']}
                </a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
  {blocks.length > 1 && (
    <div class="absolute inset-x-0 bottom-3 z-20 flex justify-center in-data-[numbering=none]:hidden">
      <div class="flex h-11 items-center rounded-full bg-background/80 px-3 text-foreground">
        <div class="flex items-center in-data-[numbering=counter]:hidden">
          {blocks.map((_, index) => (
            <button type="button" data-part="dot" aria-label={`Слайд ${index + 1}`} class="group flex h-11 min-w-8 cursor-pointer items-center justify-center border-0 bg-transparent p-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
              <span class="hidden size-2 rounded-full bg-border group-data-[active]:bg-foreground in-data-[numbering=dots]:block"></span>
              <span class="hidden h-0.5 w-6 bg-border group-data-[active]:bg-foreground in-data-[numbering=lines]:block"></span>
              <span class="hidden text-sm text-muted-foreground group-data-[active]:text-foreground in-data-[numbering=numbers]:block">{index + 1}</span>
            </button>
          ))}
        </div>
        <p class="m-0 hidden text-sm in-data-[numbering=counter]:block"><span data-part="counter">1</span> / {blocks.length}</p>
      </div>
    </div>
  )}
</div>
