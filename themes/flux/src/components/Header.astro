---
import NtPromoBanner from "@merfy-dropshipping-platform/design-systems-theme/components/ui/NtPromoBanner.astro";
import NtIcon from "@merfy-dropshipping-platform/design-systems-theme/components/ui/NtIcon.astro";
import SchemeIcon from "../../../../packages/theme-base/primitives/SchemeIcon.astro";
import { FLUX_ICON_SVGS } from "./icons/flux-icon-svgs";
import { SITE_TITLE } from "../consts";
import FluxNavItem from "./FluxNavItem.astro";
import { NAV_SUBMENU_TOGGLE_SOURCE } from "../../../../packages/theme-base/runtime/nav-submenu-toggle";
import FluxWishlistLink from "./FluxWishlistLink.astro";

interface NavLink {
	label: string;
	href: string;
	match?: (pathname: string) => boolean;
	submenu?: NavLink[];
}

const defaultNav: NavLink[] = [
	{ label: "Главная", href: "/", match: (path) => path === "/" },
	{ label: "Смартфоны", href: "/catalog?collection=%D0%A1%D0%BC%D0%B0%D1%80%D1%82%D1%84%D0%BE%D0%BD%D1%8B", match: (path) => path.startsWith("/catalog") || path.startsWith("/products") },
	{ label: "Наушники", href: "/catalog?collection=%D0%9D%D0%B0%D1%83%D1%88%D0%BD%D0%B8%D0%BA%D0%B8" },
	{ label: "Ноутбуки", href: "/catalog?collection=%D0%9D%D0%BE%D1%83%D1%82%D0%B1%D1%83%D0%BA%D0%B8" },
	{ label: "Аксессуары", href: "/catalog?collection=%D0%90%D0%BA%D1%81%D0%B5%D1%81%D1%81%D1%83%D0%B0%D1%80%D1%8B" },
];

// ОЖИВЛЕНИЕ натянуто на ВЁРСТКУ ВЕРСТАЛЬЩИКОВ (эталон /tmp/flux-header-ref.astro):
// дефолтный Header (мерчант ничего не настроил) = two-tier верстальщика 1:1
// (Roboto Flex, py-6/gap-5/gap-8, size-11 desktop actions, bg-white без border-b,
// промо-бар сверху); каждая настройка конструктора (logoPosition×4, menuType×3,
// stickiness, padding, nav, logo, colorScheme, wishlist) работает поверх этой
// вёрстки. Канон-схема theme-base Header.puckConfig — siteTitle, navigationLinks,
// logo, logoPosition, stickiness, padding, menuType, menuColorScheme.
// Размер ИКОНОК десктопных действий — 24px (size-6), кнопка остаётся 44px
// (size-11, требование эталона и контракта scripts/__tests__/flux-header-
// reference-contract.test.mjs — его не трогаем). Было 32px: жалоба владельца
// 20.09 «иконки большие», та же по смыслу, что и по bloom. Замер: flux был
// единственной темой с иконкой крупнее 24px (rose 24, bloom 20, satin/vanilla
// 24), и крупнее собственного мобильного ряда flux, где всегда было size-6.
// Кликабельная область не уменьшилась — менялось только содержимое кнопки.
// Сторож: src/themes/__tests__/flux-header-icon-size.spec.ts.

const p = Astro.props as Record<string, any>;
const id = p.id;
// Пустая строка (впрыск коэрсера live-пути) не должна гасить название магазина.
const siteTitle = typeof p.siteTitle === "string" && p.siteTitle.trim() ? p.siteTitle : SITE_TITLE;
// submenu сохраняется рекурсивно (до 3 уровней): раньше маппинг его выбрасывал,
// и «Тип меню» (dropdown/mega) не имел данных для раскрытия.
const mapNavLink = (l: any, depth = 0): NavLink => ({
	label: l.label ?? l.text ?? "",
	href: l.href ?? l.link ?? "/",
	...(depth < 2 && Array.isArray(l.submenu) && l.submenu.length > 0
		? { submenu: l.submenu.map((c: any) => mapNavLink(c, depth + 1)) }
		: {}),
});
const nav: NavLink[] =
	Array.isArray(p.navigationLinks) && p.navigationLinks.length > 0
		? p.navigationLinks.map((l: any) => mapNavLink(l))
		: defaultNav;

// Канон logo (URL картинки; панель «Логотип» пишет в props.logo): непустая строка →
// <img src={logo}> высотой var(--size-logo-width) в mobile И desktop. Дефолт flux
// (мерчант НЕ задал logo) = барчарт-SVG `/icons/logo-flux.svg` (эталон верстальщиков,
// 81×24, рендер h-6/24px). Текст-лого {siteTitle} остаётся ТОЛЬКО крайним фоллбэком —
// через alt дефолтного img (ассет не загрузился → браузер покажет alt = название).
const logo = typeof p.logo === "string" && p.logo.trim() ? p.logo : undefined;
const logoImgCls = "h-[var(--size-logo-width,24px)] w-auto max-w-[160px] object-contain";

// Канон actionButtons {showCart, showSearch, showProfile} (строки "true"/"false";
// панель «Кнопки действий»): show/hide трёх иконок шапки. Отсутствие/иное → показаны
// (дефолт = эталон верстальщиков: поиск + корзина + профиль).
const showSearch = String(p.actionButtons?.showSearch ?? "true") !== "false";
const showCart = String(p.actionButtons?.showCart ?? "true") !== "false";
const showProfile = String(p.actionButtons?.showProfile ?? "true") !== "false";

// Канон logoPosition: 'top-left' (canon-default = two-tier эталона) / 'top-center' /
// 'center-left' / 'center-absolute' (+ 'top-right' из enum → single-row). Отсутствие /
// неизвестное → 'top-left'. isTwoRow: два ряда (top-left, top-center); single-row:
// center-left / center-absolute / top-right.
const logoPosition = typeof p.logoPosition === "string" ? p.logoPosition : "";
const isTwoRow = logoPosition === "top-left" || logoPosition === "top-center";
// center-absolute: лого absolute по центру single-row
const isAbsoluteCenter = logoPosition === "center-absolute";
// center-left («Слева»): лого в потоке слева, nav центрируется ПО СТРАНИЦЕ через
// равные flex-1 фланги (лого + блок иконок), nav (auto) садится по центру.
const logoLeft = logoPosition === "center-left";

// Канон stickiness: 'always' / отсутствие → обычный sticky (= эталон верстальщика
// `sticky top-0 z-50`); 'scroll-up' → прячем при скролле вниз, показываем при скролле
// вверх (is:inline скрипт через data-атрибут — компилятор секций не умеет define:vars,
// идемпотентность через data-hydrated); 'none' → «Никогда», шапка НЕ липнет.
// Раньше 'none' давал тот же sticky, что и 'always': из трёх значений панели
// работали два, а подпись «Никогда» вводила мерчанта в заблуждение.
const stickiness = typeof p.stickiness === "string" ? p.stickiness : "";
const rootCls =
	stickiness === "none"
		? "relative w-full"
		: stickiness === "scroll-up"
			? "sticky top-0 z-50 w-full transition-transform duration-300"
			: "sticky top-0 z-50 w-full";
const SCROLL_UP_JS = [
	"(function(){",
	"var root=document.querySelector('[data-flux-sticky=\"scroll-up\"]');",
	"if(!root||root.getAttribute('data-hydrated')==='true')return;",
	"root.setAttribute('data-hydrated','true');",
	"var last=window.scrollY;",
	"window.addEventListener('scroll',function(){",
	"var y=window.scrollY;",
	"if(y>last&&y>root.offsetHeight){root.style.transform='translateY(-100%)';}else{root.style.transform='';}",
	"last=y;",
	"},{passive:true});",
	"})();",
].join("");

// Канон padding {top,bottom} — носитель отступов десктопного ряда. Дефолт puckConfig =
// {12,12} → рендерим ЛИТЕРАЛ верстальщика py-6 (как и отсутствие padding); inline-стиль
// только при ином значении (clamp ≤64). Мобильная строка фиксирована h-20.
const pad = p.padding && typeof p.padding === "object" ? p.padding : undefined;
const isCanonPad = pad && Number(pad.top) === 12 && Number(pad.bottom) === 12;
const headerPad =
	pad && !isCanonPad
		? { top: Math.min(Number(pad.top) || 0, 64), bottom: Math.min(Number(pad.bottom) || 0, 64) }
		: undefined;
const headerPadStyle = headerPad
	? `padding-top:${headerPad.top}px;padding-bottom:${headerPad.bottom}px;`
	: undefined;

// Канон menuType: 'dropdown' (по умолчанию) / 'mega-menu' (Расширенное) / 'sidebar'
// (Боковое). mega-menu → uppercase tracking к десктопным ссылкам. sidebar → десктопный
// inline-nav скрыт, hamburger открывает правую шторку.
const menuType = typeof p.menuType === "string" ? p.menuType : "dropdown";
const isMegaMenu = menuType === "mega-menu";
const isSidebar = menuType === "sidebar";
const megaLinkCls = isMegaMenu ? "tracking-[0.06em] font-medium" : "";

// Канон menuColorScheme: опциональная отдельная цветовая схема десктопного <nav>.
// Схему платформа отдаёт строкой ("scheme-1") ИЛИ числом (1): нормализатор
// `page-blocks` приводит к числу только `colorScheme`, а `menuColorScheme`
// доезжает как есть. Проверка «только строка» молча не срабатывала на числе —
// и один и тот же магазин получал <nav> со схемой на внутренних страницах и без
// неё на главной (замер flux 2026-09-13). Канон взят из satin (Header.astro:103).
const _menuSchemeStr = (v: unknown): string =>
	typeof v === "number" ? String(v) : typeof v === "string" ? v : "";
const menuColorScheme = _menuSchemeStr(p.menuColorScheme);
const menuSchemeClass = menuColorScheme ? `color-scheme-${menuColorScheme.replace("scheme-", "")}` : "";

const pathname = Astro.url.pathname;
const isActive = (link: NavLink) => (link.match ? link.match(pathname) : pathname === link.href);

// Магазин для живого поиска: build.service патчит `const shopId = ""` → siteId на
// публикации (patchShopIdInDist), ровно как у подвала и корзины темы.
const shopId = "";

// Бейдж счётчика (корзина и избранное) — эталон верстальщика: -right-1 -top-1,
// h-[18px] min-w-[18px], bg-[#1e2952], Roboto Flex 11px.
// ЦИФРА — роль схемы «Текст кнопки», а не `text-white`: белым списком матрицы
// прикрыта только ПЛАШКА (фирменный #1e2952 — узнаваемый цвет темы), а цифра
// читаема на плашке любого цвета и обязана следовать выбору мерчанта
// (решение владельца 15.09, сужение исключения `counter-badge`).
// Фолбэк 255_255_255 = прежний белый — вид без схемы не меняется.
const badgeCls =
	"absolute -right-1 -top-1 inline-flex h-[18px] min-w-[18px] items-center justify-center rounded-full bg-[#1e2952] px-1 font-roboto-flex text-[11px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden";

// Лого всегда рендерится как <img> (мерчантский logo ИЛИ дефолтный барчарт-SVG) →
// якорь = img-ветка эталона h-6 (24px). isAbsoluteCenter центрирует лого в single-row.
// «По центру» БЕЗ absolute: absolute-лого выпадало из потока и ложилось ПОВЕРХ
// длинного меню вёрстки (пункт №4 читался сквозь лого). Вместо этого single-row
// становится сеткой [1fr_auto_1fr]: меню слева (может переноситься), лого в
// средней ячейке (центр, пока фланги не шире 1fr), действия справа. Перекрытие
// невозможно по построению.
const desktopLogoCls = `flex h-6 shrink-0 items-center hover:opacity-90${isAbsoluteCenter ? " md:order-2 md:col-start-2 md:justify-self-center" : ""}`;
const mobileLogoCls = "flex items-center hover:opacity-80";

// Десктопный flux-container эталона → носитель темы (как Footer/секции flux): 1920 + px-20/px-80.
const deskContainerBase = "mx-auto w-full max-w-[1920px] px-4 md:px-20 2xl:px-80";
// py-6 = вертикальный отступ верстальщика (дефолт); inline-стиль перебивает при настройке padding.
const deskPadCls = headerPad ? "" : "py-6";
const twoRowContainerCls = [deskContainerBase, "hidden flex-col gap-5 md:flex", deskPadCls].filter(Boolean).join(" ");
// «По центру» (center-absolute) строит сетку [1fr auto 1fr]. Колонки закреплены
// ЯВНО (md:col-start-1/2/3), а не самораскладкой: при «Боковом» меню навигация
// скрывается через display:none и ВЫПАДАЕТ из сетки — логотип с иконками
// съезжали на колонку влево, третья оставалась пустой (жалоба владельца 20.09,
// замер: отступ справа 498px вместо 80). Сторож:
// src/themes/__tests__/header-layout-menu-matrix.spec.ts.
const singleRowContainerCls = [deskContainerBase, deskPadCls, isAbsoluteCenter ? "hidden items-center gap-6 md:grid md:grid-cols-[1fr_auto_1fr]" : "hidden items-center justify-between md:flex"].filter(Boolean).join(" ");

// Пункт nav эталона: Roboto Flex 16px light; active чёрный, inactive #cccccc → hover чёрный.
// active/hover токенизированы (дефолт чёрный = эталон) → menuColorScheme их перекрашивает.
// lg:text-[length:var(--size-nav-link,16px)] — «Кегль пунктов меню» темы
// (паритет rose Header.astro:132); фоллбэк 16px = вёрстка.
const navLinkBase = "font-roboto-flex text-[16px] font-light leading-normal transition-colors lg:text-[length:var(--size-nav-link,16px)]";
// Активный/hover пункт берёт --color-heading, а НЕ --color-text: в вёрстке это
// чёрный (`text-black`), тогда как --color-text у flux — вторичный серый #999999
// (им набраны абзацы). На --color-text активный пункт выцветал до серого и
// переставал отличаться от неактивных. menuColorScheme по-прежнему их перекрашивает.
const navActiveCls = "text-[rgb(var(--color-heading,0_0_0))]";
// Idle-цвет: канон #cccccc. Перекраску при явной «Цветовой схеме меню» делает
// CSS-правило в global.css ([data-nav-inline][class*=color-scheme] a) — схему
// на контейнер вешает и ПАТЧЕР превью без пере-рендера, поэтому чисто классами
// в разметке это не решается (ловля theme-registry 2026-08-06).
const navIdleCls = "text-[rgb(var(--color-muted,204_204_204))] hover:text-[rgb(var(--color-heading,0_0_0))]";
---

<div
	class={rootCls}
	data-flux-header
	data-puck-component-id={id}
	data-flux-sticky={stickiness === "scroll-up" ? "scroll-up" : undefined}
>
	{
		/* Встроенная полоса объявления — ТОЛЬКО статик-режим (без props.id):
		   в канон-композиции полоса = отдельная секция PromoBanner, иначе дубль.
		   Паритет с Rose (577648f7/eb8c8bd3): системные/account-страницы (login,
		   register, verify*, wishlist, auth/*, account/*) зовут Header БЕЗ id
		   (не Puck-композиция) → полоса торчала там всегда. Layout.astro шлёт
		   promo={false} на этих страницах — здесь просто уважаем флаг. */
		!id && p.promo !== false && (
			<NtPromoBanner
				text="Бесплатная доставка на весь ассортимент до 30.06.2026."
				link="/catalog"
				linkText="Смотреть больше"
			/>
		)
	}

	<header
		class="relative w-full bg-[rgb(var(--color-bg,255_255_255))]"
		data-nt="flux-header"
	>
	<!-- Mobile (h-20): бургер слева | лого по центру (absolute) | wishlist+корзина справа -->
	<div class="relative z-[60] flex h-20 items-center justify-between bg-[rgb(var(--color-bg,255_255_255))] px-4 md:hidden">
		<button
			type="button"
			id="flux-burger-btn"
			data-burger-toggle
			class="flex size-11 items-center justify-center transition-opacity hover:opacity-70"
			aria-label="Меню"
			aria-expanded="false"
			aria-controls="flux-burger"
		>
			<span class="burger-icon" data-icon="open">
				<SchemeIcon svgs={FLUX_ICON_SVGS} name="menu-burger" sizeClass="size-6" />
			</span>
			<span class="burger-icon hidden" data-icon="close">
				<SchemeIcon svgs={FLUX_ICON_SVGS} name="menu-close" sizeClass="size-6" />
			</span>
		</button>
		<a href="/" class:list={["absolute left-1/2 -translate-x-1/2", mobileLogoCls]} aria-label={siteTitle}>
			{logo ? <img src={logo} alt={siteTitle} class={logoImgCls} /> : <img src="/icons/logo-flux.svg" alt={siteTitle} width="81" height="24" class={logoImgCls} />}
		</a>
		<div class="flex items-center gap-3">
			<FluxWishlistLink badgeCls={badgeCls} boxCls="size-11" iconSize="size-6" />
			{showCart && (
				<button
					type="button"
					data-cart-open
					class="relative flex size-11 items-center justify-center"
					aria-label="Корзина"
				>
					<SchemeIcon svgs={FLUX_ICON_SVGS} name="cart" sizeClass="size-6" />
					<span data-cart-count data-empty="true" class={badgeCls}>0</span>
				</button>
			)}
		</div>
	</div>

	<!-- Desktop -->
	{isTwoRow ? (
		<div class={twoRowContainerCls} style={headerPadStyle}>
			{logoPosition === "top-center" ? (
				/* top-center: Row1=[распорка | logo CENTER | search+actions RIGHT], Row2=[nav CENTER] */
				<>
					<div class="grid w-full grid-cols-[1fr_auto_1fr] items-center">
						{/* Левая ячейка — распорка: она держит логотип ровно по центру грида.
						    Поиск отсюда убран (жалоба владельца 21.09 «не должно быть поиска
						    слева»): он переехал к остальным иконкам справа, чтобы ряд действий
						    не разрывался. */}
						<div class="flex items-center"></div>
						<div class="flex items-center justify-center">
							<a href="/" class={desktopLogoCls} aria-label={siteTitle}>
								{logo ? <img src={logo} alt={siteTitle} class={logoImgCls} /> : <img src="/icons/logo-flux.svg" alt={siteTitle} width="81" height="24" class={logoImgCls} />}
							</a>
						</div>
						<div class="flex items-center justify-end gap-4">
							{showSearch && (
								<button
									type="button"
									data-action="toggle-search"
									class="flex size-11 items-center justify-center transition-opacity hover:opacity-80"
									aria-label="Поиск"
								>
									<SchemeIcon svgs={FLUX_ICON_SVGS} name="search-lg" sizeClass="size-6" />
								</button>
							)}
							<FluxWishlistLink badgeCls={badgeCls} />
							{showCart && (
								<button
									type="button"
									data-cart-open
									class="relative flex size-11 items-center justify-center transition-opacity hover:opacity-80"
									aria-label="Корзина"
								>
									<SchemeIcon svgs={FLUX_ICON_SVGS} name="cart" sizeClass="size-6" />
									<span data-cart-count data-empty="true" class={badgeCls}>0</span>
								</button>
							)}
							{showProfile && (
								<a
									href="/login" data-auth-link
									class="flex size-11 items-center justify-center transition-opacity hover:opacity-80"
									aria-label="Аккаунт"
								>
									<SchemeIcon svgs={FLUX_ICON_SVGS} name="user" sizeClass="size-6" />
								</a>
							)}
							{isSidebar && (
								<button
									type="button"
									data-burger-toggle
									class="flex size-11 items-center justify-center transition-opacity hover:opacity-80"
									aria-label="Меню"
									aria-expanded="false"
									aria-controls="flux-burger"
								>
									<span class="burger-icon" data-icon="open">
										<SchemeIcon svgs={FLUX_ICON_SVGS} name="menu-burger" sizeClass="size-6" />
									</span>
									<span class="burger-icon hidden" data-icon="close">
										<SchemeIcon svgs={FLUX_ICON_SVGS} name="menu-close" sizeClass="size-6" />
									</span>
								</button>
							)}
						</div>
					</div>
					<nav
						class:list={["flex h-6 w-full items-center justify-center gap-8", menuSchemeClass, isSidebar && "md:!hidden"]}
						aria-label="Основная навигация" data-nav-inline
						data-puck-subsection-parent={id}
						data-puck-subsection-index="997"
						data-puck-subsection-field="navigationLinks"
					>
						{nav.map((link) => (
							<FluxNavItem
								link={link}
								menuType={menuType}
								active={isActive(link)}
								linkClass={[navLinkBase, isActive(link) ? navActiveCls : navIdleCls, megaLinkCls].filter(Boolean).join(" ")}
							/>
						))}
					</nav>
				</>
			) : (
				/* top-left (designer default = two-tier эталона): Row1=[logo LEFT + actions RIGHT], Row2=[nav LEFT] */
				<>
					<div class="flex w-full items-center justify-between">
						<a href="/" class={desktopLogoCls} aria-label={siteTitle}>
							{logo ? <img src={logo} alt={siteTitle} class={logoImgCls} /> : <img src="/icons/logo-flux.svg" alt={siteTitle} width="81" height="24" class={logoImgCls} />}
						</a>
						<div class="flex items-center gap-4">
							{showSearch && (
								<button
									type="button"
									data-action="toggle-search"
									class="flex size-11 items-center justify-center transition-opacity hover:opacity-80"
									aria-label="Поиск"
								>
									<SchemeIcon svgs={FLUX_ICON_SVGS} name="search-lg" sizeClass="size-6" />
								</button>
							)}
							<FluxWishlistLink badgeCls={badgeCls} />
							{showCart && (
