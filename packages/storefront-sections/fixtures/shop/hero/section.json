      "setting": {
        "kind": "select",
        "default": "large",
        "options": [
          {
            "value": "small",
            "label": "Маленький"
          },
          {
            "value": "medium",
            "label": "Средний"
          },
          {
            "value": "large",
            "label": "Большой"
          }
        ]
      }
    }
