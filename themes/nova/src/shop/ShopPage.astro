---
// Страница магазина (блок 4; шапка, страница и подвал — блок 1 «Секций и SDK», часть 4). Её рендерит только
// рисовальщик: данные — только из Astro.locals.merfy, без сети, окружения, часов и случайного (сторож блока 4).
// Секции — разметкой от сборщика по порядку мерчанта: шапка — до <main>, секции страницы — в <main>, подвал — после;
// их скрипты загружает ядро по списку модулей в <head>. Заголовка страницы и подвала у темы нет — их выводят секции.
import ShopHead from "./ShopHead.astro";

const page = Astro.locals.merfy;
if (page === undefined) throw new Error("Страницу магазина рендерит только сборщик: нет Astro.locals.merfy");
---

<html lang={page.head.lang} {...page.head.attributes}>
	<head>
		<ShopHead head={page.head} />
	</head>
	<body>
		{page.header.map((html) => <Fragment set:html={html} />)}
		<main>
			{page.sections.map((html) => <Fragment set:html={html} />)}
		</main>
		{page.footer.map((html) => <Fragment set:html={html} />)}
	</body>
</html>
