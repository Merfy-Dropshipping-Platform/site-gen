---
const { settings } = Astro.props;
---
<!-- Значок заглушки фото — Lucide (image), лицензия ISC, lucide.dev/license. -->
<div class="mx-auto flex max-w-page flex-col gap-6 px-4 font-body text-foreground md:gap-8">
  {settings.collection && (settings.collection.title || settings.collection.description) && (
    <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      <div class="flex max-w-2xl flex-col gap-2">
        {settings.collection.title && (
          <h1 class="m-0 font-heading weight-heading tracking-heading text-3xl text-heading md:text-4xl">{settings.collection.title}</h1>
        )}
        {settings.collection.description && <p class="m-0 text-base text-muted-foreground">{settings.collection.description}</p>}
      </div>
      {settings.collection.productsCount > 0 && (
        <p class="m-0 text-sm text-muted-foreground">
          {settings.collection.productsCount}{' '}
          {settings.collection.productsCount % 10 === 1 && settings.collection.productsCount % 100 !== 11
            ? 'товар'
            : settings.collection.productsCount % 10 >= 2 && settings.collection.productsCount % 10 <= 4 && (settings.collection.productsCount % 100 < 12 || settings.collection.productsCount % 100 > 14)
              ? 'товара'
              : 'товаров'}
        </p>
      )}
    </div>
  )}
  {settings.collection && settings.collection.products.length === 0 && (
    <p class="m-0 rounded-card bg-muted px-6 py-12 text-center text-muted-foreground">В этой коллекции пока нет товаров</p>
  )}
  {settings.collection && settings.collection.products.length > 0 && (
    <ul class="m-0 grid list-none grid-cols-2 gap-x-grid-column gap-y-grid-row p-0 md:grid-cols-3 lg:grid-cols-4">
      {settings.collection.products.map((card) => (
        <li class="flex min-w-0 flex-col gap-3 border-border card-style-card:rounded-card card-style-card:border-width-card card-style-card:bg-card card-style-card:p-card card-style-card:text-card-foreground card-style-card:shadow-card card-align-center:text-center card-align-right:text-right motion-hover-lift:transition-transform motion-hover-lift:hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0">
          <div class="relative">
            <a class="block aspect-4/5 overflow-hidden rounded-media border-width-media border-border bg-muted shadow-media" href={card.url} tabindex="-1" aria-hidden="true">
              {card.image ? (
                <img class="size-full object-cover" src={card.image} alt={card.title} loading="lazy" />
              ) : (
                <span class="flex size-full items-center justify-center text-muted-foreground">
                  <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /></svg>
                </span>
              )}
            </a>
            {card.compareAtPrice && card.compareAtPrice.amount > card.price.amount && (
              <span class="absolute left-2 top-2 rounded-badge bg-sale px-2 py-1 text-xs text-sale-foreground md:left-3 md:top-3">−{Math.round((1 - card.price.amount / card.compareAtPrice.amount) * 100)} %</span>
            )}
            {!card.available && (
              <span class="absolute bottom-2 left-2 rounded-badge bg-background px-2 py-1 text-xs text-foreground md:bottom-3 md:left-3">Нет в наличии</span>
            )}
          </div>
          <div class="flex flex-col gap-1">
            <a class="line-clamp-2 text-sm text-foreground no-underline hover:underline md:text-base" href={card.url}>{card.title}</a>
            <p class="m-0 flex flex-wrap items-baseline gap-x-2 card-align-center:justify-center card-align-right:justify-end">
              <span class:list={['text-base weight-heading md:text-lg', card.compareAtPrice ? 'text-sale' : 'text-price']}>{card.price.text}</span>
              {card.compareAtPrice && <s class="text-sm text-price-old">{card.compareAtPrice.text}</s>}
            </p>
          </div>
        </li>
      ))}
    </ul>
  )}
</div>
