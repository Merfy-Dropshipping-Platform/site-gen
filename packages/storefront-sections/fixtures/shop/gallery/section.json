{
  "sdk": 1,
  "name": "gallery",
  "kind": "section",
  "title": "Галерея",
  "wrapper": [
    "scheme",
    "padding"
  ],
  "wrapperSpec": {
    "padding": {
      "default": {
        "top": 80,
        "bottom": 80
      }
    }
  },
  "names": {
    "item-type": {
      "kinds": [
        "radio"
      ],
      "label": "Тип",
      "about": "Что показывает элемент галереи: своё изображение, товар магазина (фото, название, цена) или коллекцию",
      "asks": [
        "тип элемента",
        "товар в галерее",
        "коллекция в галерее",
        "что показать в плитке"
      ]
    }
  },
  "settings": [
    {
      "id": "heading",
      "label": "Заголовок",
      "section": "Содержание",
      "setting": {
        "kind": "string",
        "default": "Галерея",
        "ai": "title"
      }
    },
    {
      "id": "heading-size",
      "label": "Размер заголовка",
      "setting": {
        "kind": "select",
        "default": "medium",
        "options": [
          {
            "value": "small",
            "label": "Маленький"
          },
          {
            "value": "medium",
            "label": "Средний"
          },
          {
            "value": "large",
            "label": "Большой"
          }
        ]
      }
    },
    {
      "id": "text",
      "label": "Текст",
      "setting": {
        "kind": "text",
        "default": "",
        "ai": "description"
      }
    },
    {
      "id": "text-size",
      "label": "Размер текста",
      "setting": {
        "kind": "select",
        "default": "medium",
        "options": [
          {
            "value": "small",
            "label": "Маленький"
          },
          {
            "value": "medium",
            "label": "Средний"
          },
          {
            "value": "large",
            "label": "Большой"
          }
        ]
      }
    },
    {
      "id": "image-position",
      "label": "Положение изображения",
      "setting": {
        "kind": "radio",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Слева"
          },
          {
            "value": "right",
            "label": "Справа"
          }
        ]
      }
    },
    {
      "wrapper": "scheme"
    },
    {
      "wrapper": "padding"
    },
    {
      "id": "layout",
      "label": "Раскладка",
      "section": "Вид",
      "setting": {
        "kind": "select",
        "default": "featured",
        "options": [
          {
            "value": "featured",
            "label": "Крупная плитка и стопка"
          },
          {
            "value": "row",
            "label": "Плитки в ряд"
          }
        ]
      }
    }
  ],
  "blocks": {
    "tile": {
      "title": "Элемент",
      "limit": 3,
      "settings": [
        {
          "id": "item-type",
          "label": "Тип",
          "setting": {
            "kind": "radio",
            "default": "image",
            "options": [
              {
                "value": "image",
                "label": "Изображение"
              },
              {
                "value": "product",
                "label": "Товар"
              },
              {
                "value": "collection",
                "label": "Коллекция"
              }
            ]
          }
        },
        {
          "id": "image",
          "label": "Изображение",
          "visibleWhen": {
            "setting": "item-type",
            "equals": "image"
          },
          "setting": {
            "kind": "image",
            "default": "",
            "maxBytes": 31457280
          }
        },
        {
          "id": "label",
          "label": "Название",
          "sublabel": "Оставьте пустым, чтобы скрыть",
          "visibleWhen": {
            "setting": "item-type",
            "equals": "image"
          },
          "setting": {
            "kind": "string",
            "default": ""
          }
        },
        {
          "id": "caption",
          "label": "Вторая строка",
          "sublabel": "Например, цена. Оставьте пустой, чтобы скрыть",
          "visibleWhen": {
            "setting": "item-type",
            "equals": "image"
          },
          "setting": {
            "kind": "string",
            "default": ""
          }
        },
        {
          "id": "link",
          "label": "Ссылка",
          "visibleWhen": {
            "setting": "item-type",
            "equals": "image"
          },
          "setting": {
            "kind": "url",
            "default": "/catalog"
          }
        },
        {
          "id": "product",
          "label": "Выбор товара",
          "visibleWhen": {
            "setting": "item-type",
            "equals": "product"
          },
          "setting": {
            "kind": "product"
          }
        },
        {
          "id": "collection",
          "label": "Выбор коллекции",
          "visibleWhen": {
            "setting": "item-type",
            "equals": "collection"
          },
          "setting": {
            "kind": "collection"
          }
        }
      ]
    }
  },
  "defaultBlocks": [
    {
      "type": "tile",
      "settings": {}
    },
    {
      "type": "tile",
      "settings": {
        "item-type": "product"
      }
    },
    {
      "type": "tile",
      "settings": {
        "item-type": "collection"
      }
    }
  ]
}
