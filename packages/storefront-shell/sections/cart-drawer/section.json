{
  "sdk": 1,
  "name": "cart-drawer",
  "kind": "section",
  "title": "Корзина-панель",
  "role": "cart-drawer",
  "wrapper": [],
  "uses": ["cart"],
  "names": {
    "side": {
      "kinds": ["radio"],
      "label": "Позиция",
      "about": "С какой стороны экрана выезжает панель корзины",
      "asks": ["позиция", "сторона", "слева", "справа", "side"]
    },
    "checkout": {
      "kinds": ["toggle"],
      "label": "Кнопка оформления",
      "about": "Кнопка «Оформить заказ» внизу панели корзины",
      "asks": ["оформление", "кнопка оформления", "checkout"]
    },
    "note": {
      "kinds": ["toggle"],
      "label": "Пояснение",
      "about": "Строка «Налоги, скидки и стоимость доставки рассчитываются при оформлении заказа» под «Итого»: есть у vanilla и satin, у flux нет",
      "asks": ["налоги", "пояснение", "доставка рассчитывается", "note"]
    }
  },
  "settings": [
    {
      "id": "side",
      "label": "Позиция",
      "section": "Вид",
      "setting": {
        "kind": "radio",
        "default": "right",
        "options": [
          { "value": "left", "label": "Слева" },
          { "value": "right", "label": "Справа" }
        ]
      }
    },
    {
      "id": "checkout",
      "label": "Кнопка оформления",
      "setting": {
        "kind": "toggle",
        "default": true,
        "labels": { "on": "Показать", "off": "Скрыть" }
      }
    },
    {
      "id": "note",
      "label": "Пояснение",
      "setting": {
        "kind": "toggle",
        "default": false,
        "labels": { "on": "Показать", "off": "Скрыть" }
      }
    }
  ]
}
