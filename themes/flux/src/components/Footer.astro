---
import { inlineFormat } from "../lib/rich-text";
// Иконки соцсетей — через обёртку темы: карта имён дизайн-системы закрыта, а
// MAX (просьба владельца 14.09) лежит только в themes/flux/public/icons.
// Правило пути у обёртки то же (<имя>.svg), поэтому разметка соседних иконок
// не меняется.
import FluxNtIcon from "./icons/FluxNtIcon.astro";
import { withBase } from "../lib/with-base";
import { footerOwnLogo } from "../../../../packages/theme-base/runtime/footer-logo";
import { schemeIdOf } from "../lib/color-scheme";

// Live-конфиг подписки: shopId патчит build.service (patchShopIdInDist) → siteId
// на деплое (заменяет `const shopId = ""` в HTML); apiUrl — публичный gateway.
const shopId = "";
const apiUrl = import.meta.env.PUBLIC_MERFY_API_URL ?? "https://gateway.merfy.ru/api";

const today = new Date();

// Дефолтные ссылки навигации = литерал верстальщика flux-theme/src/components/Footer.astro (F:7-12).
const navColumnDefault = [
	{ label: "Смартфоны", href: "/catalog?collection=Смартфоны" },
	{ label: "Наушники", href: "/catalog?collection=Наушники" },
	{ label: "Ноутбуки", href: "/catalog?collection=Ноутбуки" },
	{ label: "Аксессуары", href: "/catalog?collection=Аксессуары" },
];

// ВЁРСТКА = flux-theme/src/components/Footer.astro (verstal'shchik) точь-в-точь:
//   Roboto Flex (копирайт — Inter, фикс-роль Figma flux); newsletter «Подпишитесь на нашу
//   рассылку»; 3 колонки НАВИГАЦИЯ / ИНФОРМАЦИЯ / СОЦИАЛЬНЫЕ СЕТИ (flex, по 318px,
//   justify-between); чёрная копирайт-полоса 80/100px.
// НАСТРОЙКИ = как оживлены в rose Footer (themes/rose/.../Footer.astro): siteTitle, phone,
//   email/socialColumn.email, newsletter(enabled/heading/description/placeholder),
//   navigationColumn, informationColumn, socialColumn(socialLinks/contactFields), copyright,
//   bottomStrip, padding, paymentEnabled, colorScheme — rgb(var(--color-*)) с пиксель-фоллбеком.
// Демо-данные репо (хардкод /legal/*, flux@example.ru, фейк-соцсети) НЕ хардкодим — по rose
//   их заполняет build (site_policy / контакты) и Theme Settings; info/social-колонки
//   гейтятся по контенту (пустое состояние = колонка скрыта, без битых ссылок/фейк-данных).
const p = Astro.props as Record<string, any>;
const id = p.id;
// Пустая строка (canon default Puck / коэрсер) не должна ронять «Flux».
// Запасное имя магазина — нейтральное, НЕ название темы. Владелец 18.09: «в
// подвал должна идти лого из настроек темы, если загружена, или, если нет, то
// как в шапке браться с админки, а не отображаться название темы». Имя темы
// приезжало сюда ЧЕТВЁРТЫМ путём (после сидов, copyright.companyName и
// siteTitle в ревизии): порт сам подставлял SITE_TITLE из consts.ts, и подвал
// печатал «Bloom» при магазине «Bloom Pilot». Название магазина подставляет
// сборка (build.service) и миграция ревизии; сюда управление доходит, только
// если магазин безымянный.
const siteTitle = typeof p.siteTitle === "string" && p.siteTitle.trim() ? p.siteTitle : "Мой магазин";
// «Логотип» подвала — своя картинка из панели секции (владелец 26.09).
// Пусто — подвал как был. Правило: packages/theme-base/runtime/footer-logo.ts.
// Высота — настройка «Размер» логотипа, тем же классом, что у картинки в шапке.
// В вёрстке flux логотипа в подвале нет: он встаёт над колонкой навигации,
// как у satin/vanilla/bloom (32px до ссылок), только когда загружен.
const ownLogo = footerOwnLogo(p);
const OWN_LOGO_CLS = "block h-[var(--size-logo-width,24px)] w-auto max-w-[160px] object-contain";
const phone = typeof p.phone === "string" && p.phone.trim() ? p.phone.trim() : "";
const rawEmail = p.socialColumn?.email ?? p.email ?? "";
const email = typeof rawEmail === "string" ? rawEmail.trim() : "";

// Платёжные бейджи — только при подключённой кассе (build ставит paymentEnabled).
const paymentEnabled = p.paymentEnabled === true || p.paymentEnabled === "true";

// «Информация о компании» (адрес/часы/ИНН/любая инфа) — build кладёт сюда поля КРОМЕ
// телефона/почты. Выводим label/value в социальной колонке.
const contactFields: Array<{ label: string; value: string }> = Array.isArray(p.socialColumn?.contactFields)
	? p.socialColumn.contactFields.filter((f: any) => f && typeof f.value === "string" && f.value.trim())
	: [];

// newsletter.enabled — скрыть блок ТОЛЬКО при явном false/'false' (булево может прийти
// строкой). blockDefaults flux {enabled:true, heading/description/placeholder} == литералу
// верстальщика → проп-с-фолбэком на литерал даёт пиксель без canon-стриппинга.
const newsletterEnabled = !(
	p.newsletter && (p.newsletter.enabled === false || p.newsletter.enabled === "false")
);
// Панель пишет heading.text / text.content (общий puckConfig, как rose b71bd733);
// старые пути newsletter.heading/description — legacy fallback. Порт читал ТОЛЬКО
// legacy → панельные поля были мертвы (ловля theme-registry 2026-08-06).
const nlHeading =
	(typeof p.heading?.text === "string" && p.heading.text.trim() ? p.heading.text : undefined) ??
	(typeof p.newsletter?.heading === "string" && p.newsletter.heading.trim()
		? p.newsletter.heading
		: "Подпишитесь на нашу рассылку");
const nlDescription =
	(typeof p.text?.content === "string" && p.text.content.trim() ? p.text.content : undefined) ??
	(typeof p.newsletter?.description === "string" && p.newsletter.description.trim()
		? p.newsletter.description
		: "Введите электронную почту и получайте информацию нашего бренда");
// Кегли из сабпанелей (лестницы в масштабе flux; дефолт = вёрстка как была:
// заголовок 18/20, текст 14/16)
const nlHeadingSizeCls =
	p.heading?.size === "small"
		? "text-[16px] md:text-[18px]"
		: p.heading?.size === "large"
			? "text-[20px] md:text-[24px]"
			: "text-[18px] md:text-[20px]";
const nlTextSizeCls =
	p.text?.size === "small"
		? "text-[12px] md:text-[14px]"
		: p.text?.size === "large"
			? "text-[16px] md:text-[18px]"
			: "text-[14px] md:text-[16px]";
const nlPlaceholder =
	typeof p.newsletter?.placeholder === "string" && p.newsletter.placeholder.trim()
		? p.newsletter.placeholder
		: "flux@example.ru";

// Канон-колонки {title, links[]}: ссылки из пропсов с fallback на литерал верстальщика.
// blockDefaults flux nav (href '/catalog') трактуем как «не задано» → литерал верстальщика
// (href '/catalog?collection=…') — правило canon-default → пиксель.
const coerceColumnLinks = (
	col: any,
	fallback: Array<{ label: string; href: string }>,
): Array<{ label: string; href: string }> =>
	Array.isArray(col?.links) && col.links.length > 0
		? col.links.map((l: any) => ({ label: String(l?.label ?? ""), href: String(l?.href ?? "/") }))
		: fallback;
const isCanonColumn = (
	links: Array<{ label: string; href: string }>,
	canon: Array<[string, string]>,
): boolean =>
	links.length === canon.length &&
	canon.every(([label, href], i) => links[i]?.label === label && links[i]?.href === href);
const CANON_NAV: Array<[string, string]> = [
	["Смартфоны", "/catalog"],
	["Наушники", "/catalog"],
	["Ноутбуки", "/catalog"],
	["Аксессуары", "/catalog"],
];
const navLinksRaw = coerceColumnLinks(p.navigationColumn, navColumnDefault);
const navLinks = isCanonColumn(navLinksRaw, CANON_NAV) ? navColumnDefault : navLinksRaw;
const infoLinks = coerceColumnLinks(p.informationColumn, []);

// Заголовки колонок: дефолт = литерал верстальщика (репо ВСЕГДА показывает «Навигация» /
// «Информация» / «Социальные сети»). Непустой title пропа перебивает.
const columnTitleOf = (col: any): string | undefined =>
	typeof col?.title === "string" && col.title.trim() ? col.title : undefined;
const navColTitle = columnTitleOf(p.navigationColumn) ?? "Навигация";
const infoColTitle = columnTitleOf(p.informationColumn) ?? "Информация";
const socialColTitle = columnTitleOf(p.socialColumn) ?? "Социальные сети";

const columnTitleCls =
	"font-roboto-flex text-[16px] font-normal uppercase leading-normal text-[rgb(var(--color-heading,0_0_0))]";
// Ссылка футера (нав/инфо/email/телефон): Roboto Flex 16 light, muted → hover чёрный
// (репо #cccccc→black; токенизировано в --color-muted/--color-text для colorScheme как rose).
const linkCls =
	"font-roboto-flex text-[16px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))] transition-colors hover:text-[rgb(var(--color-text,0_0_0))]";

// socialColumn.socialLinks (enum платформ) → подписи + NtIcon-глифы верстальщика; пустой
// массив → пусто (без фейк-демо, как rose). Порядок верстальщика: Telegram VK YouTube Дзен TikTok.
const SOCIAL_PLATFORMS: Record<string, { platform: string; icon: string }> = {
	telegram: { platform: "Telegram", icon: "social-telegram" },
	vk: { platform: "VK", icon: "social-vk" },
	youtube: { platform: "YouTube", icon: "social-youtube" },
	dzen: { platform: "Дзен", icon: "social-yandex-dzen" },
	tiktok: { platform: "TikTok", icon: "social-tiktok" },
	max: { platform: "MAX", icon: "social-max" },
};
const socials = (Array.isArray(p.socialColumn?.socialLinks) ? p.socialColumn.socialLinks : [])
	.map((s: any) => {
		const meta = SOCIAL_PLATFORMS[String(s?.platform ?? "")];
		const href = String(s?.href ?? "").trim();
		return meta && href && href !== "#" ? { ...meta, href } : null;
	})
	.filter((s: any) => s !== null);

// Социальная колонка показывается ТОЛЬКО при контенте (контакты/соцсети/оплата) — rose-стиль
// пустого состояния (без одинокого заголовка и фейк-данных верстальщика).
const socialColumnHasContent =
	Boolean(phone) || Boolean(email) || contactFields.length > 0 || socials.length > 0 || paymentEnabled;

// copyright {companyName, poweredBy, showYear} (+ legacy-строка целиком). Дефолт = литерал
// чёрной полосы верстальщика байт-в-байт: «© {год} {siteTitle} Все права защищены.
// Powered by Merfy» (F:142) — формула rose (без точки после companyPart).
const copyrightProp = p.copyright;
const copyrightOverride =
	typeof copyrightProp === "string" && copyrightProp.trim() ? copyrightProp : undefined;
const copyrightObj = copyrightProp && typeof copyrightProp === "object" ? copyrightProp : {};
const showYear = !(copyrightObj.showYear === false || copyrightObj.showYear === "false");
const companyPart =
	typeof copyrightObj.companyName === "string" && copyrightObj.companyName.trim()
		? copyrightObj.companyName
		: siteTitle;
// Подпись платформы. Владелец 20.09: во всех темах по умолчанию «Разработано
// на Merfy», текст задаёт мерчант в админке («Редактировать содержимое темы»).
// Стандартный текст — ссылка на https://merfy.ru/ (владелец 20.09 поправил
// сам себя: «ссылку всё таки надо оставлять»). Прежнее «Powered by
// Merfy» в старых ревизиях считаем не тронутым и заменяем новым текстом.
const poweredBy =
	typeof copyrightObj.poweredBy === "string" && copyrightObj.poweredBy.trim() && copyrightObj.poweredBy.trim() !== "Powered by Merfy"
		? copyrightObj.poweredBy.trim()
		: "Разработано на Merfy";
const copyrightText =
	copyrightOverride ??
	// Копирайт из тем убран (владелец 20.09: «удалить во всех темах»).
	// Он показывается только как строка, которую мерчант сам завёл в
	// «Блоках информации о компании» — она и так выводится в контактах.
	// Здесь остаётся ровно подпись платформы.
	poweredBy;

// bottomStrip {enabled, text} — чёрная копирайт-полоса = носитель (отдельной полосы у
// верстальщика нет). enabled false/'false' скрывает; непустой text перебивает собранный copyright.
const strip = p.bottomStrip && typeof p.bottomStrip === "object" ? p.bottomStrip : undefined;
const bottomStripVisible = !(strip && (strip.enabled === false || strip.enabled === "false"));
// Подпись платформы ведёт на лендинг (владелец 20.09: «сделать именно
// ссылкой на https://merfy.ru/»). Ссылка только у стандартного текста: вписал
// мерчант своё — остаётся просто текст.
const PLATFORM_URL = "https://merfy.ru/";
const stripText = typeof strip?.text === "string" && strip.text.trim() ? strip.text : copyrightText;
const stripIsDefault = stripText === "Разработано на Merfy";

// padding {top,bottom} — inline-стиль ТОЛЬКО при не-canon пропе. canon {64,64} (theme.json
// flux, впрыск коэрсера) → литерал py-12 md:py-16 верстальщика (правило canon-default → пиксель).
const pad = p.padding && typeof p.padding === "object" ? p.padding : undefined;
const isCanonPad = pad && Number(pad.top) === 64 && Number(pad.bottom) === 64;
const footerPadStyle =
	pad && !isCanonPad
		? `padding-top:${Number(pad.top) || 0}px;padding-bottom:${Number(pad.bottom) || 0}px;`
		: undefined;
// Контейнер — по актуальной вёрстке flux-theme@be32556d
// (src/styles/global.css:30 .flux-container: 1480, поля 1/2.5/5rem; владелец
// 23-24.09: «как у верстальщиков, только стили») при любых «Отступах».
// Подвал верстальщика (Footer.astro@be32556d:39): py-12 md:py-[80px], gap-10
// md:gap-[80px] — ТОЛЬКО в ветке значения по умолчанию «Отступов»
// (canon/isCanonPad, footerPadStyle не задан); у нестандартных отступов
// мерчанта (footerPadStyle) вертикаль задаёт инлайн-стиль.
const FOOTER_CONTAINER_CLS = {
	custom: "mx-auto flex w-full max-w-[1480px] flex-col gap-10 px-4 md:px-10 lg:px-20",
	default:
		"mx-auto flex w-full max-w-[1480px] flex-col gap-10 md:gap-[80px] px-4 py-12 md:px-10 md:py-[80px] lg:px-20",
};
const footerContainerCls = FOOTER_CONTAINER_CLS[footerPadStyle ? "custom" : "default"];
// Размеры элементов подвала по той же вёрстке (Footer.astro@be32556d): поле
// рассылки h-14 шириной до 429px, текст в нём 16, кнопка-стрелка 44×44; иконки
// соцсетей в кнопках 44×44 через gap-2; полоса подписи высотой 64px, кегль
// 14 → md:16. Цвета не трогаются.
const FOOTER_GEOMETRY = {
	form: "flex h-14 w-full max-w-[429px] items-center justify-between gap-2 rounded-[var(--radius-input,8px)] border border-[rgb(var(--color-surface,245_245_245))] bg-[rgb(var(--color-bg,255_255_255))] px-4",
	input: "min-w-0 flex-1 bg-transparent font-roboto-flex text-[16px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))] placeholder:text-[rgb(var(--color-text))] outline-none",
	submit: "flex size-11 shrink-0 items-center justify-center text-[rgb(var(--color-text,0_0_0))] transition-opacity hover:opacity-80",
	socialRow: "flex items-center gap-2",
	socialLink: "flex size-11 items-center justify-center transition-opacity hover:opacity-70",
	strip: "flex h-[64px] w-full items-center justify-center bg-[rgb(var(--color-bg,251_251_251))]",
	stripText: "px-4 text-center font-inter text-[14px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))] md:text-[16px]",
};

// Паритет с Rose (rose Footer.astro, 8 коммитов 80f57884/a39fcb8a/79b14bb9/97d31708/
// 107c3ea2/c60f6206/b71bd733): поле «Выравнивание» уже показывается в сайдбаре (общий
// puckConfig), но flux его не читал — dead control. Одна настройка на десктоп И
// адаптив (не разные для mobile/desktop — так решил владелец в rose).
// ⚠️ puckConfig-имя поля СЕЙЧАС — `alignment` (Footer.puckConfig.ts:129), НЕ
// `contentAlign` — в origin/main Rose до сих пор читает `p.contentAlign` (видимо,
// поле переименовали ПОСЛЕ июльского rose-фикса, и сама Rose сейчас на него тоже не
// реагирует). Читаем актуальное имя — цель «настройка реально работает», не
// «повторить чужой баг».
const contentAlign = ["left", "center", "right"].includes(p.alignment) ? p.alignment : "left";
const nlAlignCls = contentAlign === "center" ? "items-center text-center" : contentAlign === "right" ? "items-end text-right" : "";
const linksJustifyCls = contentAlign === "center" ? "md:justify-center md:gap-16" : contentAlign === "right" ? "md:justify-end md:gap-16" : "md:justify-between";
const navGroupAlignCls = contentAlign === "center" ? "items-center text-center" : contentAlign === "right" ? "items-end text-right" : "";
// Соц-колонка в вёрстке уже прижата вправо (md:items-end) — при center выравниваем к
// центру вместе с остальным контентом, при left/right оставляем родное поведение вёрстки.
const socialAlignCls = contentAlign === "center" ? "md:items-center" : "md:items-end";

// Rose Footer.astro: своя colorScheme на <footer>, иначе hot-render одиночного блока в
// превью конструктора (без scheme-обёртки композитора) берёт :root = тёмный дефолт →
// чёрный футер. На live обёртка композитора даёт ту же схему — дубль безвреден.
// п.9 тестировщика (2026-09-13): на ЖИВОМ пути класс не печатался — живая
// нормализация ревизии отдаёт схему ЧИСЛОМ ("scheme-3" → 3), а здесь стояла
// сверка `typeof === "string"`. См. lib/color-scheme.ts.
const footerSchemeId = schemeIdOf(p.colorScheme);
const footerSchemeClass = footerSchemeId ? `color-scheme-${footerSchemeId}` : "";
---

{/* ФОН ПОДВАЛА — «Фон» СХЕМЫ, как у rose/bloom/vanilla.
    Жалобы тестировщика 15.09 [10, 36]: «подвал красится не тем цветом». Замер
    (Chromium 1440, схемы мерчанта scheme-2 → scheme-3): подвал 251,251,251 →
    90,175,255, то есть он шёл за `--color-surface`, а «Фон» схемы в это время
    255,255,255 → 113,192,255.
    Токен `--color-surface` за схемой ИДЁТ (это поле `surfaceBg`), но поля для
    него в редакторе схем НЕТ и не будет — состав настроек канон. Мерчанту
    доступен ровно один фон, «Фон»; поверхность ему достаётся из легаси-сида
    (src/themes/legacy-seed-schemes.ts) и на его выбор не реагирует. Поэтому
    подвал садится на «Фон», как у эталона rose (Footer.astro) и у bloom с
    vanilla — 3 темы из 5 уже так и делают.
    Дизайнерский оттенок #fbfbfb сохранён ФОЛБЭКОМ: магазин без схемы выглядит
    ровно как в вёрстке. Сторож: pnpm test:scheme-targets. */}
<footer class:list={["w-full bg-[rgb(var(--color-bg,251_251_251))]", footerSchemeClass]} data-puck-component-id={id}>
	<div class={footerContainerCls} style={footerPadStyle}>
		<!-- Newsletter «Подпишитесь на нашу рассылку» -->
		{newsletterEnabled && (
		<section class={`flex w-full flex-col gap-6 ${nlAlignCls}`} aria-labelledby="newsletter-heading">
			<div class={`flex flex-col gap-2 ${nlAlignCls}`}>
				<h2
					id="newsletter-heading"
					class={`font-roboto-flex ${nlHeadingSizeCls} font-normal leading-normal text-[rgb(var(--color-heading,0_0_0))]`}
					data-puck-subsection-parent={id}
					data-puck-subsection-index="100"
					data-puck-subsection-field="newsletter"
				>
					<Fragment set:html={inlineFormat(nlHeading)} />
				</h2>
				<p class={`font-roboto-flex ${nlTextSizeCls} font-light leading-normal text-[rgb(var(--color-muted,153_153_153))]`}>
					<Fragment set:html={inlineFormat(nlDescription)} />
				</p>
			</div>

			{/* Поле подписки — «Фон» СХЕМЫ. Было `bg-white`: Tailwind 4 печатает его как
			    var(--color-white) — переменная ЕСТЬ, а схемы в ней нет, и поле замирало
			    белым, пока полотно подвала вокруг уже ехало (замер матрицы, схемы-зонды
			    1 → 4: #fff → #fff против 17,0,0 → 0,17,0). Роль та же, что у поля
			    промокода «Сводки заказа» (fix b19). Фолбэк 255_255_255 = прежний вид.
			    Сторож: pnpm test:scheme-targets. */}
			<form
				class={FOOTER_GEOMETRY.form}
				data-newsletter-form
				data-puck-subsection-parent={id}
				data-puck-subsection-index="997"
				data-puck-subsection-field="newsletter"
			>
				<input
					type="email"
					name="email"
					required
					placeholder={nlPlaceholder}
					aria-label="Email"
					class={FOOTER_GEOMETRY.input}
				/>
				<button
					type="submit"
					aria-label="Подписаться"
					class={FOOTER_GEOMETRY.submit}
				>
					{/* arrow-right.svg viewBox 17.4×10.2. NtIcon <img class="size-8"> +
					    preserveAspectRatio="none" растягивает шеврон в квадрат — «сломанная»
					    стрелка. Не <img>: инлайн + meet, как RoseNtIcon (currentColor). */}
					<svg class="h-[19px] w-8" viewBox="0 0 17.4 10.2" fill="none" aria-hidden="true">
						<path
							d="M16.8 5.1L12.3 0.6M16.8 5.1L12.3 9.6M16.8 5.1H0.6"
							stroke="currentColor"
							stroke-width="1.2"
							stroke-linecap="round"
							stroke-linejoin="round"
						/>
					</svg>
				</button>
			</form>
			<p
				data-newsletter-status
				role="status"
				class="hidden font-roboto-flex text-[12px] font-light text-[#4AD300] md:text-[14px]"
			></p>
		</section>
		)}

		<!-- Links: НАВИГАЦИЯ / ИНФОРМАЦИЯ / СОЦИАЛЬНЫЕ СЕТИ -->
		<section
			class={`flex w-full flex-col gap-10 md:flex-row md:items-start ${linksJustifyCls}`}
			aria-label="Навигация по сайту"
		>
			<div class={`flex flex-col gap-10 sm:flex-row sm:gap-4 ${navGroupAlignCls}`}>
				<div
					class={`flex flex-col gap-4 md:w-[318px] ${navGroupAlignCls}`}
					data-puck-subsection-parent={id}
					data-puck-subsection-index="996"
					data-puck-subsection-field="navigationColumn"
				>
					{ownLogo && (
						<a href="/" class="mb-4 inline-flex w-fit transition-opacity hover:opacity-80">
							<img src={ownLogo} alt={siteTitle} class={OWN_LOGO_CLS} decoding="async" />
						</a>
					)}{navColTitle && <h3 class={columnTitleCls}>{navColTitle}</h3>}
					<ul class="flex flex-col gap-3" role="list">
						{navLinks.map((link) => (
							<li>
								<a href={link.href} class={linkCls}>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>

				{infoLinks.length > 0 && (
				<div
					class={`flex flex-col gap-4 md:w-[318px] ${navGroupAlignCls}`}
					data-puck-subsection-parent={id}
					data-puck-subsection-index="995"
					data-puck-subsection-field="informationColumn"
				>
					{infoColTitle && <h3 class={columnTitleCls}>{infoColTitle}</h3>}
					<ul class="flex flex-col gap-3" role="list">
						{infoLinks.map((link) => (
							<li>
								<a href={link.href} class={linkCls}>
									{link.label}
								</a>
							</li>
						))}
					</ul>
				</div>
				)}
			</div>

			{socialColumnHasContent && (
			<div
				class={`flex flex-col gap-4 md:w-[318px] ${socialAlignCls}`}
				data-puck-subsection-parent={id}
				data-puck-subsection-index="994"
				data-puck-subsection-field="socialColumn"
			>
				{socialColTitle && <h3 class={columnTitleCls}>{socialColTitle}</h3>}
				<div class="flex flex-1 flex-col items-start gap-6 md:items-end">
					{(phone || email || contactFields.length > 0) && (
					<div class="flex flex-col gap-3 md:items-end">
						{phone && (
						<a href={`tel:${phone.replace(/[^+\d]/g, "")}`} class={`${linkCls} md:text-right`}>
							{phone}
						</a>
						)}
						{email && (
						<a href={`mailto:${email}`} class={`${linkCls} md:text-right`}>
							{email}
						</a>
						)}
						{contactFields.map((f) => (
						<div class="font-roboto-flex text-[16px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))] md:text-right">
							<span class="text-[rgb(var(--color-heading,0_0_0))]">{f.label}:</span> {f.value}
						</div>
						))}
					</div>
					)}
					{socials.length > 0 && (
					<div class={FOOTER_GEOMETRY.socialRow}>
						{socials.map((s: any) => (
							<a
								href={s.href}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={s.platform}
								class={FOOTER_GEOMETRY.socialLink}
							>
								<FluxNtIcon name={s.icon} sizeClass="size-6" />
							</a>
						))}
					</div>
					)}
					{paymentEnabled && (
					<div class="flex flex-wrap items-center gap-3 md:justify-end" aria-label="Способы оплаты">
						<img src={withBase("/icons/MasterCard.svg")} alt="Mastercard" class="h-6 w-auto shrink-0" decoding="async" />
						<img src={withBase("/icons/Visa.png")} alt="Visa" class="h-6 w-auto shrink-0" decoding="async" />
						<img src={withBase("/icons/MIR.png")} alt="МИР" class="h-6 w-auto shrink-0" decoding="async" />
					</div>
					)}
				</div>
			</div>
			)}
		</section>
	</div>

	<!-- Copyright — полоса Powered by (Inter, фикс-роль Figma flux) -->
	{/* п.9/п.10 тестировщика (2026-09-13): полоса копирайта обязана жить по ТОЙ ЖЕ
	    схеме, что и вся секция (тело подвала flux стоит на «Фоне» схемы —
	    полоса берёт ТОТ ЖЕ токен). Раньше фон брался из --color-heading, то есть
	    инвертировался: у любой тёмной схемы heading светлый (merchant-сид
	    scheme-1: bg #000000, heading #FFFFFF) — и внизу КАЖДОЙ страницы магазина
	    появлялась белая полоса. */}
	{bottomStripVisible && (
		<div
			class={FOOTER_GEOMETRY.strip}
			data-puck-subsection-parent={id}
			data-puck-subsection-index="992"
			data-puck-subsection-field="bottomStrip"
		>
			<p
				class={FOOTER_GEOMETRY.stripText}
				data-puck-subsection-parent={id}
				data-puck-subsection-index="993"
				data-puck-subsection-field="copyright"
			>
				{stripIsDefault ? (
					<a href={PLATFORM_URL} target="_blank" rel="noopener noreferrer" class="hover:opacity-70">{stripText}</a>
				) : (
					stripText
				)}
			</p>
		</div>
	)}
</footer>

<script is:inline define:vars={{ shopId, apiUrl }}>
	// Реальная отправка подписки на gateway (была demo-заглушка — фейковое «Спасибо» без
	// запроса). store_id — из пропатченного shopId (деплой) либо window.__MERFY_SITE_ID__
	// (превью). Гард __merfyNewsletterWired исключает двойную привязку, если на странице
	// есть и эта форма, и секция Newsletter; статус ищем в пределах своей секции.
	(function () {
		window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || {
			shopId: shopId || "",
			apiUrl: apiUrl || "https://gateway.merfy.ru/api",
		};
		var cfg = window.__MERFY_CONFIG__;
		var base = String(cfg.apiUrl || "https://gateway.merfy.ru/api").replace(/\/+$/, "");
		var storeId = cfg.shopId || window.__MERFY_SITE_ID__ || "";

		function wire(form) {
			if (!form || form.__merfyNewsletterWired) return;
			form.__merfyNewsletterWired = true;
			var section = form.closest("section") || document;
			var status = section.querySelector("[data-newsletter-status]");
			var btn = form.querySelector('button[type="submit"]');

			function show(msg, isError) {
				if (!status) return;
				status.textContent = msg;
				status.style.color = isError ? "#E11D48" : "";
				status.classList.remove("hidden");
			}

			form.addEventListener("submit", function (event) {
				event.preventDefault();
				var input = form.querySelector('input[type="email"]');
				var email = input ? String(input.value || "").trim() : "";
				if (!email) return;
				if (btn) btn.disabled = true;
				show("Отправляем…", false);

				fetch(base + "/storefront/newsletter/subscribe", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ store_id: storeId, email: email }),
				})
					.then(function (res) {
						return res
							.json()
							.catch(function () { return {}; })
							.then(function (data) { return { ok: res.ok, code: res.status, data: data }; });
					})
					.then(function (r) {
						if (r.ok) {
							show(
								r.data && r.data.alreadySubscribed
									? "Вы уже подписаны на рассылку."
									: "Спасибо! Мы отправим вам приветственное письмо.",
								false,
							);
							form.reset();
						} else if (r.code === 429) {
							show("Слишком много попыток. Попробуйте позже.", true);
						} else {
							show("Не удалось подписаться. Попробуйте позже.", true);
						}
					})
					.catch(function () {
						show("Не удалось подписаться. Проверьте соединение.", true);
					})
					.finally(function () {
						if (btn) btn.disabled = false;
					});
			});
		}

		function init() {
			var forms = document.querySelectorAll("[data-newsletter-form]");
			for (var i = 0; i < forms.length; i++) wire(forms[i]);
		}
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init);
		} else {
			init();
		}
	})();
</script>
