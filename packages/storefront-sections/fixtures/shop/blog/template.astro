---
const { settings } = Astro.props;
---
<div class="mx-auto flex max-w-page flex-col gap-8 px-4 font-body">
  {settings.posts && settings.posts.title && (
    <h1 class="m-0 font-heading weight-heading text-3xl text-heading">{settings.posts.title}</h1>
  )}
  {settings.posts && (
    <ul class="m-0 grid list-none gap-8 p-0 md:grid-cols-3">
      {settings.posts.articles.map((post) => (
        <li class="flex flex-col gap-2">
          {post.cover && <img class="h-auto w-full rounded-button" src={post.cover} alt={post.title} />}
          <a class="font-heading text-xl text-heading no-underline" href={post.url}>{post.title}</a>
          {post.excerpt && <p class="m-0 text-foreground">{post.excerpt}</p>}
        </li>
      ))}
    </ul>
  )}
</div>
