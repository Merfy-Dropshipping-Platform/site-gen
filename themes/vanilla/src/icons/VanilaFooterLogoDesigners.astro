---
/**
 * Вордмарк «Vanilla» для тёмного футера — тот же SVG верстальщиков, что и в
 * шапке (см. VanilaLogoDesigners.astro), «Vanilla» двумя «l» вместо прежней
 * «Vanila». С 25.09 подвал рисует только его (одна версия секции).
 */
import { withBase } from "../lib/with-base";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<img
	src={withBase("/icons/Vanila-designers.svg")}
	alt=""
	width="98"
	height="28"
	loading="lazy"
	decoding="async"
	draggable={false}
	class:list={["block shrink-0 object-contain object-center", className]}
/>
