---
import { inlineFormat } from "../../lib/rich-text";
import { sectionFieldOrder } from "../../../../../packages/theme-base/runtime/field-order";
import { pickText, textOf, hasText } from "../../../../../packages/theme-base/runtime/merchant-text";
// Фаза 3 (T17): новая канон-секция Newsletter в манере rose (см. themes/rose/MANNER.md).
// Схема полей = packages/theme-base/blocks/Newsletter/Newsletter.puckConfig.ts.
// Дизайн = блок подписки подвала верстальщика (Footer.astro:132-176, перенесён
// КОПИЕЙ — подвал не тронут): заголовок rose-title, подзаголовок Manrope muted,
// форма-рамка radius-input/border-input с инпутом; сетка секций §2.
const p = Astro.props as Record<string, any>;
const id = p.id;

// Live-конфиг подписки: shopId патчит build.service (patchShopIdInDist) → siteId
// на деплое (заменяет `const shopId = ""` в HTML); apiUrl — публичный gateway.
const shopId = "";
const apiUrl = import.meta.env.PUBLIC_MERFY_API_URL ?? "https://gateway.merfy.ru/api";

// Канон heading: string | { text, alignment, size }. Figma 1:19335 — ДОСЛОВНЫЙ
// плейсхолдер пустого состояния Newsletter: «Подпишитесь на нашу рассылку»
// (дефолт-текст верстальщика «Подпишись на новости» заменён на Figma-текст).
// pickText: строка панели (в т.ч. пустая — мерчант стёр) рендерится КАК ЕСТЬ;
// заглушка — ТОЛЬКО когда поле не задано вовсе (SECTION-CONTRACT.md §2).
const heading = pickText(p.heading, "Подпишитесь на нашу рассылку");
// Размер — через --size-section-heading (её читает .rose-title); !text-[ не работает.
const headingSize = p.heading?.size ?? p.headingSize;
const headingSizeCls =
	headingSize === "small"
		? " [--size-section-heading:17px] [--size-section-heading-m:12px]"
		: headingSize === "large"
			? " [--size-section-heading:24px] [--size-section-heading-m:17px]"
			: "";
const headingCls = `rose-title${headingSizeCls}`;

// Канон description (string) + text {content,size} (pupa-дубль). Figma 1:19335 —
// ДОСЛОВНЫЙ плейсхолдер: «Узнавайте первыми о новых коллекциях и эксклюзивных
// предложениях.» (дефолт-текст верстальщика «Узнавай о новинках и акциях первым»
// заменён на Figma-текст). Манера = подзаголовок подписки подвала (Manrope 16 muted).
// `p.text` приходит СТРОКОЙ: adaptLegacyProps разворачивает конверт
// {content,size} (page-blocks.ts unwrapEnvelopes) ещё до рендера, поэтому
// ветка `p.text?.content` на живом сайте не срабатывала никогда и «Текст»
// секции молча показывал дефолт вместо ввода мерчанта.
// textOf берёт первое заданное поле панели (строку или пустую строку, если
// мерчант стёр) — приоритет `text`, легаси `description` — фолбэк; заглушка
// подставляется, только если оба поля не заданы вовсе (SECTION-CONTRACT.md §2).
const description = textOf(p.text) ?? textOf(p.description) ?? "Узнавайте первыми о новых коллекциях и эксклюзивных предложениях.";
// Размер берётся из top-level `textSize`, а конверт — только фолбэк. Конвейер
// разворачивает `text: {content, size}` в строку ещё до рендера и поднимает
// размер в `textSize` (page-blocks: TEXT_SIZE_ENVELOPES), поэтому `p.text?.size`
// на живой витрине не существует НИКОГДА — «Размер текста» подписки не работал
// во всех пяти темах. Фолбэк оставлен для путей, где конверт доезжает целым.
const descSize = p.textSize ?? p.text?.size;
const descSizeCls =
	descSize === "small" ? " !text-[14px]" : descSize === "large" ? " !text-[19px]" : "";

// Канон placeholder/buttonText. Figma 1:19335 — ДОСЛОВНЫЙ плейсхолдер пустого
// состояния: input «email@example.com», кнопка «Кнопка» (дефолты верстальщика
// «Твой email» / «Подписаться» заменены на Figma-текст). Мерчант задал свои
// placeholder/buttonText → рендерим ИХ (fallback лишь при пустых данных).
const placeholder =
	typeof p.placeholder === "string" && p.placeholder.trim() ? p.placeholder : "email@example.com";
const buttonText =
	typeof p.buttonText === "string" && p.buttonText.trim() ? p.buttonText : "Кнопка";

// Канон formLayout: stacked (canon-default) — поле + чёрная CTA манеры §3 под ним;
// inline-submit — форма подвала верстальщика дословно (кнопка-стрелка в рамке).
const inlineSubmit = p.formLayout === "inline-submit";

// Канон agreement (toggle 'true'/'false', default 'false'): при 'true' — чекбокс
// согласия под формой (манера rose: Manrope мелкий muted); иначе ничего.
const showAgreement = p.agreement === true || p.agreement === "true";
// Текст согласия и «Сделать ссылкой» из панели (agreementText / agreementLink) —
// раньше порт печатал захардкоженную строку, тумблер выглядел мёртвым.
const agreeText =
	typeof p.agreementText === "string" && p.agreementText.trim()
		? p.agreementText
		: "Согласен на обработку персональных данных";
const agreeLink = typeof p.agreementLink === "string" ? p.agreementLink.trim() : "";

// Тогл «Скрыть заголовок и текст» (toggle 'true'/'false', default 'false'): при
// 'true' блок heading+description не рендерится (форма/согласие остаются).
const hideTitle = p.hideTitle === "true";

// Канон «Выравнивание» = ЕДИНЫЙ контрол (конструктор пишет position): рулит И
// позицией блока в контейнере (posCls), И выключкой содержимого внутри
// (alignCls: заголовок/текст/форма), И выравниванием stacked-кнопки (selfCls).
// «слева-слева», «центр-по центру», «право-право». Раньше alignCls читал
// отдельный heading.alignment (конструктор его не пишет) → блок двигался, а
// текст и кнопка застревали слева = «выравнивается только часть».
const position = p.position === "center" || p.position === "right" ? p.position : "left";
const posCls = position === "center" ? "mx-auto" : position === "right" ? "ml-auto" : "mr-auto";
const alignCls =
	position === "center"
		? "items-center text-center"
		: position === "right"
			? "items-end text-right"
			: "items-start text-left";
const selfCls = position === "center" ? "self-center" : position === "right" ? "self-end" : "self-start";

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе (паттерн T11).
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;

// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((p as any).hiddenFields)
	? ((p as any).hiddenFields as unknown[]).filter((x): x is string => typeof x === 'string')
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);
// SECTION-CONTRACT.md §2: стёртый заголовок/текст не рисует пустой <h2>/<p>, а
// их обёртка не рисуется вовсе, если в ней не осталось ничего видимого (иначе
// на её месте остаётся gap-2).
const headingWillRender = hasText(heading) && !isFieldHidden('heading');
const textWillRender = hasText(description) && !isFieldHidden('text');
const titleId = id && !hideTitle && headingWillRender ? `${id}-title` : undefined;
// Порядок из перетаскивания в конструкторе (props.fieldOrder,
// packages/theme-base/runtime/field-order.ts): `heading` — блок заголовка с
// текстом, `buttonText` — форма подписки вместе с согласием под ней. Строка
// статуса всегда последняя. Без fieldOrder — прежняя разметка.
const newsletterOrder = sectionFieldOrder("Newsletter", p);
// ФОН И ТЕКСТ ПОЛЯ ПОДПИСКИ — роли СХЕМЫ. Было `bg-white` + `text-[#000000]`:
// Tailwind 4 печатает `bg-white` как var(--color-white) — переменная ЕСТЬ, а
// схемы в ней нет, поэтому поле замирало белым, пока корень секции вокруг уже
// ехал (замер матрицы, схемы-зонды 1 → 4: #fff → #fff против 17,0,0 → 0,17,0).
// Пара «фон + надпись» переводится целиком: увести один фон значит получить
// чёрное на тёмном. Роль та же, что у поля промокода «Сводки заказа» (fix b19).
// Фолбэки = прежний вид. Сторож: pnpm test:scheme-targets.
---

<section
	class="w-full bg-[rgb(var(--color-bg,255_255_255))] px-4 pb-14 pt-14 sm:px-5 sm:pb-16 sm:pt-16 md:px-10 md:pb-[100px] md:pt-[100px] lg:px-16 lg:pb-[120px] lg:pt-[120px] xl:px-20 xl:pb-[140px] xl:pt-[140px] 2xl:px-[280px]"
	aria-labelledby={titleId}
	data-puck-component-id={id}
	style={paddingStyle}
>
	<div class="mx-auto w-full max-w-[1320px]">
		<div class={`flex w-full max-w-[430px] flex-col gap-5 ${posCls} ${alignCls}`} data-animate>
			{newsletterOrder.map((field) => (
			<Fragment>
			{
				field === 'heading' && !hideTitle && (headingWillRender || textWillRender) && (
					<div class="flex w-full flex-col gap-2">
						{headingWillRender && (
							<h2
								id={titleId}
								class={headingCls}
								data-puck-subsection-parent={id}
								data-puck-subsection-index="100"
								data-puck-subsection-field="heading"
								set:html={inlineFormat(heading)}
							></h2>
						)}
						{textWillRender && (
							<p
								class={`font-manrope !text-[16px] font-normal !leading-none tracking-normal text-[rgb(var(--color-muted,153_153_153))]${descSizeCls}`}
								data-puck-subsection-parent={id}
								data-puck-subsection-index="101"
								data-puck-subsection-field="text"
								set:html={inlineFormat(description)}
							></p>
						)}
					</div>
				)
			}

			{
				field === 'buttonText' && (inlineSubmit ? (
					<form
						class="flex h-14 w-full items-center gap-2 rounded-[var(--radius-input,4px)] border border-[rgb(var(--color-input-border,153_153_153))] bg-[rgb(var(--color-bg,255_255_255))] pl-[18px] pr-4 transition-colors focus-within:border-[#000000]"
						data-newsletter-form
						data-puck-subsection-parent={id}
						data-puck-subsection-index="997"
						data-puck-subsection-field="placeholder"
					>
						<input
							type="email"
							name="email"
							required
							placeholder={placeholder}
							aria-label="Email"
							class="min-w-0 flex-1 bg-transparent font-manrope text-[16px] font-normal leading-none text-[rgb(var(--color-text,0_0_0))] placeholder:text-[color-mix(in_srgb,rgb(var(--color-text))_40%,rgb(var(--color-bg)))] outline-none"
						/>
						{!isFieldHidden('buttonText') && (
						<button
							type="submit"
							aria-label={buttonText}
							class="flex size-9 shrink-0 items-center justify-center font-manrope text-[16px] font-normal leading-none text-[#000000] active:scale-95"
						>
							<span aria-hidden="true" class="block translate-y-px">
								→
							</span>
						</button>
						)}
					</form>
				) : (
					<form
						class="flex w-full flex-col gap-4"
						data-newsletter-form
						data-puck-subsection-parent={id}
						data-puck-subsection-index="997"
						data-puck-subsection-field="placeholder"
					>
						<input
							type="email"
							name="email"
							required
							placeholder={placeholder}
							aria-label="Email"
							class="h-14 w-full !rounded-[var(--radius-input,4px)] border border-[rgb(var(--color-input-border,153_153_153))] bg-[rgb(var(--color-bg,255_255_255))] px-[18px] font-manrope text-[16px] font-normal leading-none text-[rgb(var(--color-text,0_0_0))] outline-none transition-colors placeholder:text-[color-mix(in_srgb,rgb(var(--color-text))_40%,rgb(var(--color-bg)))] focus-visible:border-[#000000]"
						/>
						{!isFieldHidden('buttonText') && (
						<button
							type="submit"
							class={`inline-flex h-12 w-auto min-w-[200px] items-center justify-center ${selfCls} border border-solid !rounded-[var(--radius-button,6px)] px-8 font-manrope text-[16px] font-normal leading-normal transition-opacity hover:opacity-90`}
							data-scheme-button="primary"
						>
							{buttonText}
						</button>
						)}
					</form>
				))
			}
			{
				field === 'buttonText' && showAgreement && (
					<label class="flex w-full cursor-pointer items-start gap-2 font-manrope text-[13px] font-normal leading-snug text-[rgb(var(--color-muted,153_153_153))]">
						<input
							type="checkbox"
							required
							class="mt-0.5 size-4 shrink-0 accent-[rgb(var(--color-button-bg,0_0_0))]"
						/>
						{
							agreeLink ? (
								<a href={agreeLink} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 transition-opacity hover:opacity-70"><Fragment set:html={inlineFormat(agreeText)} /></a>
							) : (
								<span><Fragment set:html={inlineFormat(agreeText)} /></span>
							)
						}
					</label>
				)
			}
			</Fragment>
			))}
			<p
				data-newsletter-status
				role="status"
				class="hidden w-full font-manrope text-[14px] font-normal leading-none text-[#4AD300]"
			></p>
		</div>
	</div>
</section>

<script is:inline define:vars={{ shopId, apiUrl }}>
	// Реальная отправка подписки на gateway. Самодостаточно (не зависит от
	// скрипта футера): гард __merfyNewsletterWired исключает двойную привязку,
	// если на странице есть и футер, и эта секция. store_id — из пропатченного
	// shopId (деплой) либо window.__MERFY_SITE_ID__ (превью конструктора).
	(function () {
		window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || {
			shopId: shopId || "",
			apiUrl: apiUrl || "https://gateway.merfy.ru/api",
		};
		var cfg = window.__MERFY_CONFIG__;
		var base = String(cfg.apiUrl || "https://gateway.merfy.ru/api").replace(/\/+$/, "");
		var storeId = cfg.shopId || window.__MERFY_SITE_ID__ || "";

		function wire(form) {
			if (!form || form.__merfyNewsletterWired) return;
			form.__merfyNewsletterWired = true;
			var section = form.closest("section") || document;
			var status = section.querySelector("[data-newsletter-status]");
			var btn = form.querySelector('button[type="submit"]');

			function show(msg, isError) {
				if (!status) return;
				status.textContent = msg;
				status.style.color = isError ? "#E11D48" : "";
				status.classList.remove("hidden");
			}

			form.addEventListener("submit", function (event) {
				event.preventDefault();
				var input = form.querySelector('input[type="email"]');
				var email = input ? String(input.value || "").trim() : "";
				if (!email) return;
				if (btn) btn.disabled = true;
				show("Отправляем…", false);

				fetch(base + "/storefront/newsletter/subscribe", {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify({ store_id: storeId, email: email }),
				})
					.then(function (res) {
						return res
							.json()
							.catch(function () { return {}; })
							.then(function (data) { return { ok: res.ok, code: res.status, data: data }; });
					})
					.then(function (r) {
						if (r.ok) {
							show(
								r.data && r.data.alreadySubscribed
									? "Вы уже подписаны на рассылку."
									: "Спасибо! Мы отправим вам приветственное письмо.",
								false,
							);
							form.reset();
						} else if (r.code === 429) {
							show("Слишком много попыток. Попробуйте позже.", true);
						} else {
							show("Не удалось подписаться. Попробуйте позже.", true);
						}
					})
					.catch(function () {
						show("Не удалось подписаться. Проверьте соединение.", true);
					})
					.finally(function () {
						if (btn) btn.disabled = false;
					});
			});
		}

		function init() {
			var forms = document.querySelectorAll("[data-newsletter-form]");
			for (var i = 0; i < forms.length; i++) wire(forms[i]);
		}
		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init);
		} else {
			init();
		}
	})();
</script>
