{
  "$comment": "Сгенерировано из схемы zod командой pnpm generate — руками не править.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "events": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 3
          },
          "trigger": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string",
                        "pattern": "^(src|packages)\\/[\\w./-]+\\.ts$"
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "file",
                      "name"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "service": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 3
                      }
                    },
                    "required": [
                      "service",
                      "description"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "themes": {
            "type": "string",
            "enum": [
              "all",
              "new"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "store",
              "dependent-pages",
              "theme-stores"
            ]
          },
          "delayMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "enum": [
              "works",
              "block-10",
              "with-sections"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "trigger",
          "themes",
          "scope",
          "delayMs",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "events"
  ],
  "additionalProperties": false
}
