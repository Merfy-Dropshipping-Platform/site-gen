{
  "tokens": {
    "extend": {
      "theme-gold": { "kind": "color", "about": "Золото для акций и бейджа «Хит»" },
      "theme-gold-foreground": { "kind": "color", "about": "Текст на золоте", "derive": { "rule": "contrast", "from": "theme-gold" }, "on": ["theme-gold"] },
      "radius-theme-pill": { "kind": "radius", "about": "Капсула для тегов", "default": 999 },
      "shadow-theme-glow": { "kind": "shadow", "about": "Золотое свечение карточки акции", "default": { "x": 0, "y": 0, "blur": 24, "spread": 0, "opacity": 0.35, "color": "theme-gold" } },
      "choice-theme-ribbon": { "kind": "choice", "about": "Лента «Хит» на карточке", "values": ["off", "on"], "default": "off" }
    },
    "root": {
      "font-body": "Manrope, system-ui, sans-serif",
      "weight-body": 400,
      "weight-heading": 600,
      "text-xs": { "min": 12, "max": 12, "leading": 1.5 },
      "text-sm": { "min": 14, "max": 14, "leading": 1.5 },
      "text-base": { "min": 16, "max": 16, "leading": 1.6 },
      "text-lg": { "min": 18, "max": 20, "leading": 1.5 },
      "text-xl": { "min": 20, "max": 24, "leading": 1.4 },
      "text-2xl": { "min": 24, "max": 32, "leading": 1.25 },
      "text-3xl": { "min": 28, "max": 40, "leading": 1.2 },
      "text-4xl": { "min": 32, "max": 48, "leading": 1.15 },
      "text-5xl": { "min": 40, "max": 64, "leading": 1.1 },
      "radius-button": 8,
      "radius-card": 12,
      "spacing-section": { "min": 48, "max": 96 },
      "width-page": 1280
    },
    "schemes": {
      "scheme-1": { "background": "#ffffff", "foreground": "#111111", "primary": "#111111", "destructive": "#dc2626", "theme-gold": "#c9a227" },
      "scheme-2": { "background": "#111111", "foreground": "#f5f5f5", "primary": "#ffffff", "destructive": "#f87171", "theme-gold": "#e0b93a" }
    }
  }
}
