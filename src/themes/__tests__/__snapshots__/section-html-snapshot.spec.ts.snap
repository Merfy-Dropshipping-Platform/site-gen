исьмо.", false, ); form.reset(); } else if (r.code === 429) { show("Слишком много попыток. Попробуйте позже.", true); } else { show("Не удалось подписаться. Попробуйте позже.", true); } }) .catch(function () { show("Не удалось подписаться. Проверьте соединение.", true); }) .finally(function () { if (btn) btn.disabled = false; }); }); } function init() { var forms = document.querySelectorAll("[data-newsletter-form]"); for (var i = 0; i < forms.length; i++) wire(forms[i]); } if (document.readyState === "loading") { document.addEventListener("DOMContentLoaded", init); } else { init(); } })(); })();</script>"`;

