exports[`снимки секций — flux Slideshow — снимок разметки 1`] = `"<section class="relative w-full overflow-hidden bg-[rgb(var(--color-bg,255_255_255))]" data-puck-component-id="Slideshow-1" data-flux-slideshow data-interval="5000" data-autoplay="false" style="padding-top:40px;padding-bottom:40px;"> <div class="w-full"> <div class="relative mx-auto w-full overflow-hidden" style="min-height:clamp(500px, 80vh, 1080px)"> <div data-slide class="!absolute inset-0 transition-opacity duration-500 ease-out opacity-100" data-puck-subsection-parent="Slideshow-1" data-puck-subsection-index="0" data-puck-subsection-field="slides"> <div class="absolute inset-0 bg-[rgb(var(--color-surface,245_245_245))]" aria-hidden="true"></div> <div class="relative z-10 flex h-full w-full flex-col items-start justify-end px-4 pb-14 pt-8 md:px-20 md:pb-16 md:pt-10 2xl:px-80"> <div class="flex max-w-[432px] flex-col gap-6 items-center text-center"> <div class="flex flex-col gap-2 items-center text-center"> <h2 class="font-roboto-flex text-[20px] font-normal leading-normal text-[rgb(var(--color-heading,255_255_255))] md:text-[24px]">Слайд</h2> <p class="font-roboto-flex text-[14px] font-light leading-normal text-[rgb(var(--color-text,255_255_255))] md:text-[16px]">Подзаголовок</p> </div> <a href="/catalog" class="inline-flex h-14 w-fit items-center justify-center rounded-[var(--radius-button,6px)] bg-[rgb(var(--color-button-bg,0_0_0))] px-4 font-roboto-flex text-[16px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-90"> Кнопка </a> </div> </div> </div> </div> </div> </section> <script> (function () { function initOne(root) { if (root.dataset.slideshowHydrated === "true") return; root.dataset.slideshowHydrated = "true"; var interval = parseInt(root.dataset.interval || "5000", 10); var autoplay = root.dataset.autoplay !== "false"; var slides = root.querySelectorAll("[data-slide]"); var dots = root.querySelectorAll("[data-slide-dot]"); if (slides.length < 2) return; var idx = 0, timer = null; // Простой fade (transition-opacity на слайде) — каскадных анимаций // в манере flux нет (MANNER §6). function show(n) { idx = (n + slides.length) % slides.length; for (var j = 0; j < slides.length; j++) { slides[j].style.opacity = j === idx ? "1" : "0"; slides[j].style.pointerEvents = j === idx ? "auto" : "none"; } for (var k = 0; k < dots.length; k++) { dots[k].setAttribute("data-active", k === idx ? "true" : "false"); } } function restart() { if (timer) clearInterval(timer); if (autoplay) timer = setInterval(function () { show(idx + 1); }, interval); } root.querySelectorAll("[data-slide-prev]").forEach(function (b) { b.addEventListener("click", function () { show(idx - 1); restart(); }); }); root.querySelectorAll("[data-slide-next]").forEach(function (b) { b.addEventListener("click", function () { show(idx + 1); restart(); }); }); dots.forEach(function (d, i) { d.addEventListener("click", function () { show(i); restart(); }); }); show(0); restart(); } function initAll() { var roots = document.querySelectorAll("[data-flux-slideshow]"); for (var k = 0; k < roots.length; k++) initOne(roots[k]); } initAll(); // Hot-replace превью вставляет секцию заново (новый узел без флага) и // шлёт astro:page-load — реинициализация подхватит свежий слайдер. document.addEventListener("astro:page-load", initAll); })(); </script>"`;

