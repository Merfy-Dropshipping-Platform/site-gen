      "contacts": { "name": "Анна", "email": "anna@mail.ru", "social": "tg:@anna", "consent": true },
      "filesCounts": {},
      "expected": { "items": { "x5": "От 1 до 10" } }
    },
    {
      "name": "всё заполнено верно — ошибок нет",
