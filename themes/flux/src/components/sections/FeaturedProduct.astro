---
/**
 * FeaturedProduct — секция «Товар» на главной (spec 111-flux-constructor-live-
 * markup, Task 5). Отсутствовала на локальной главной — оживлена с нуля.
 *
 * Источник DOM/классов (SOURCE.lock.json, pinned upstream commit
 * e29b70920ffe4469744386b51b9c8ee0fcf68bd0):
 *   - src/components/sections/FeaturedProduct.astro — тонкая обёртка
 *     `<section id="featured">` вокруг `<ProductConfigurator product={demo} />`;
 *   - src/components/products/ProductConfigurator.astro — РЕАЛЬНАЯ разметка
 *     (галерея слева/инфо справа desktop `hidden md:flex`, карусель mobile
 *     `flex md:hidden`, счётчик, кнопки «Добавить в корзину»/«Купить сейчас»,
 *     аккордеон «Описание», «Поделиться»). Файл не существовал в этом
 *     репозитории как отдельный компонент — тело ProductConfigurator слито
 *     СЮДА (та же разметка/классы 1:1), т.к. бриф Task 5 просит создать ровно
 *     один новый файл, а не пару.
 *
 * Что ИЗМЕНЕНО относительно пина (принцип «Оживление секции» — только точки
 * данных, не разметка):
 *   - demo `catalogProducts[0]` заменён на канонический `Product` (theme-base
 *     `packages/theme-base/blocks/Product/Product.puckConfig.ts`): productId/
 *     layout/photoPosition/text/title/price/quantity/buttons/description/
 *     share/dynamicButton/colorScheme/padding;
 *   - добавлена подсекция «Варианты» (variants) — ЕЁ НЕ БЫЛО в пине
 *     (комментарий верстальщиков: «Без выбора цвета/памяти — цвет задаётся
 *     товаром»), но канонический контракт Product требует variants. Взята
 *     разметка/стиль установленного flux-паттерна PDP
 *     (`FluxProductDetail.astro` + `lib/storefront-hydrate.ts`
 *     `renderVariantGroupsHtml`), НЕ придумана заново — переиспользована
 *     готовая функция (чёрно-белые чипы, font-manrope — тот же вид, что уже
 *     на живом PDP).
 *   - плейсхолдер пустого состояния = Figma 1:19335 (ТОТ ЖЕ контракт, что
 *     `FluxProductDetail.astro`: /placeholders/sweater-blue-large.svg,
 *     «Новая коллекция!», «Товар», «2 500 ₽») — НЕ upstream demo-товар
 *     («M Phone 17» и т.п.), это установленный flux-паттерн gating.
 *   - quantity/add-to-cart используют существующий cart runtime
 *     (`data-add-to-cart` → глобальный делегат `initCartUI` из
 *     `lib/cart.ts` → `lib/nt-cart-flux.ts`, подключён в Layout.astro — сам
 *     клик обрабатывать не нужно).
 *   - аккордеон описания (upstream: GSAP, затем простой class-toggle) СНЯТ:
 *     жалоба тестировщика 14.09 02:07 — «в секции товар везде убрать слово
 *     ОПИСАНИЕ, это только название секции, все данные тянутся с админки».
 *     Подпись аккордеона и была этим словом; без неё кнопка-раскрывашка ведёт
 *     в никуда, поэтому текст товара печатается открытым — как в общем порте
 *     theme-base. Напомним: у flux описание и так скрыто дефолтом темы
 *     (`packages/theme-flux/theme.json` → blockDefaults.Product.visualConfig
 *      .showDescription = false), эта ветка разметки на витрине спит.
 *     Scroll-reveal `[data-reveal]` секция по-прежнему получает бесплатно от
 *     глобального `lib/animations.ts`, без импорта gsap.
 *   - "uid" проп ProductConfigurator (никогда не читался скриптом по
 *     значению, только как маркер-селектор) убран как мёртвый — заменён на
 *     обычные boolean data-атрибуты.
 *
 * SSR-резолв реального товара (siteId+productId → sites-service
 * storefront-data) — паритет Popular/Collections/theme-base Product.astro:
 * Astro Container (превью-рендер `/preview/block`) не исполняет клиентскую
 * module-гидрацию ниже, поэтому без SSR превью выбранного товара показывало
 * бы плейсхолдер даже при реальном productId. Живой сайт освежает данные
 * клиентским скриптом (loadRealProducts, тот же каскад источников, что
 * Popular/FluxProductDetail).
 */
import { inlineFormat } from "../../lib/rich-text";
import FluxPicture from "../img/FluxPicture.astro";
import {
	deriveVariantGroups,
	findCombination,
	renderVariantsHtml,
	formatPrice,
	productHref,
	resolveComboPricing,
	toPriceNumber,
} from "../../lib/storefront-hydrate";

// Иконки счётчика/стрелок/«Поделиться» — ИНЛАЙН SVG, не <NtIcon> (жалоба
// владельца, пункт 5: «иконки»). `NtIcon` рендерит `<img src="/icons/X.svg">`
// — сам файл несёт `stroke="var(--stroke-0, black)"`, задуман перекрашиваемым,
// но у внешне подключённого через <img> SVG нет доступа к CSS-переменным
// страницы: `var()` внутри такого файла ВСЕГДА берёт свой фолбэк (`black`),
// сколько бы схему ни меняли. На тёмной схеме («Фон»/«Кнопка» близки к
// чёрному) это буквально чёрная иконка на чёрном — невидима. Инлайн + `stroke:
// currentColor` возвращает иконку в обычный каскад: `color` берёт цвет с
// класса кнопки/обёртки, тот — с роли схемы. `NtIcon` (design-systems-theme,
// общий на ВСЕ пять тем) не тронут — правка узкая, только эта секция.
const MINUS_ICON_SVG =
	'<svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
	'<path d="M5 12h14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>';
const PLUS_ICON_SVG =
	'<svg viewBox="0 0 13.2 13.2" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
	'<path d="M6.60004 6.6H0.6M6.60004 6.6H12.6M6.60004 6.6V12.6M6.60004 6.6V0.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>';
const SHARE_ICON_SVG =
	'<svg viewBox="0 0 14.5333 17.2" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
	'<path d="M4.76667 3.26667L7.26667 0.6M7.26667 0.6L9.76667 3.26667M7.26667 0.6V9.48889M3.10019 6.82222C2.32362 6.82222 1.93534 6.82222 1.62905 6.95755C1.22067 7.13798 0.896024 7.48427 0.726868 7.91988C0.6 8.24658 0.6 8.66055 0.6 9.48889V13.7556C0.6 14.7512 0.6 15.2487 0.781656 15.629C0.941445 15.9635 1.19623 16.236 1.50983 16.4064C1.866 16.6 2.3325 16.6 3.26409 16.6H11.2696C12.2012 16.6 12.6671 16.6 13.0232 16.4064C13.3368 16.236 13.5921 15.9635 13.7519 15.629C13.9333 15.2491 13.9333 14.752 13.9333 13.7583V9.48889C13.9333 8.66055 13.9332 8.24658 13.8064 7.91988C13.6372 7.48427 13.3129 7.13798 12.9045 6.95755C12.5982 6.82222 12.2099 6.82222 11.4333 6.82222" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const ARROW_LEFT_ICON_SVG =
	'<svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
	'<path d="M15 7l-6 5 6 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const ARROW_RIGHT_ICON_SVG =
	'<svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
	'<path d="M9 7l6 5-6 5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

const p = Astro.props as Record<string, any>;
const id = p.id;
const siteId = typeof p.siteId === "string" ? p.siteId : "";

// Figma 1:19335 — ТОТ ЖЕ контракт пустого состояния, что FluxProductDetail.astro
// (PDP). Товар не выбран мерчантом / не резолвится → рендерим ЭТОТ дизайн, а не
// upstream demo-товар верстальщиков.
const PLACEHOLDER_IMAGE = "/placeholders/sweater-blue-large.svg";
const PLACEHOLDER_BRAND = "Новая коллекция!";
const PLACEHOLDER_NAME = "Товар";
const PLACEHOLDER_PRICE = "2 500 ₽";

const productIdRef = typeof p.productId === "string" ? p.productId.trim() : "";

// Layout switch (Figma 648:55733 семантика, канон theme-base Product.puckConfig).
// Все четыре значения панели работают (галерейные ветки ниже):
//   carousel/дефолт — вёрстка как есть (главное фото + ряд миниатюр снизу);
//   stacked — миниатюры СЕТКОЙ 2×N (канон theme-base ProductGallery, правка
//   16.09 — было самодельных 3×N); split — миниатюры КОЛОНКОЙ слева;
//   two-columns — все фото равной сеткой 2×N без главного.
// Ранее layout нормализовался до stacked|carousel — «Макет» молчал на 2 из 4
// значений, и настройка выглядела мёртвой.
const layoutRaw = typeof p.layout === "string" ? p.layout : "";
const layout =
	layoutRaw === "stacked" || layoutRaw === "split" || layoutRaw === "two-columns"
		? layoutRaw
		: "carousel";
const photoPosition = p.photoPosition === "right" ? "right" : "left";
const photoOnLeft = photoPosition !== "right";

// — Размер (canon "size", theme-base Product.puckConfig "Размер"). Пин фиксирует
//   ОДИН масштаб: главное фото 652×652 desktop + миниатюра 120px. «Размер» не
//   переструктурирует DOM/классы (принцип файла — 1:1 разметка из пина) — он
//   параметризует ИМЕННО эти два уже существующих utility-класса (lg:w-[…] /
//   md:size-[…]) через CSS-переменную на корне секции (паттерн theme-base
//   Product.astro sizeVarsStyle). medium сохраняет пиновые 652/120 БЕЗ
//   изменений — нулевая регрессия дефолтного рендера.
const sizeRaw = typeof p.size === "string" ? p.size : "";
const productSize: "small" | "medium" | "large" =
	sizeRaw === "small" || sizeRaw === "large" ? sizeRaw : "medium";
const MAIN_IMAGE_PX = { small: 520, medium: 652, large: 760 } as const;
const THUMB_PX = { small: 96, medium: 120, large: 144 } as const;
const sizeVarsStyle = `--product-main-image-size:${MAIN_IMAGE_PX[productSize]}px;--product-thumb-size:${THUMB_PX[productSize]}px;`;

// — Увеличение (canon "zoomMode": click/hover/none). В пиновом источнике
//   (ProductConfigurator.astro верстальщиков) и в PDP-паттерне
//   FluxProductDetail.astro zoom-механизма нет как класса — поэтому долгое
//   время значение только прокидывалось на корень секции «для будущей
//   проводки». Тестировщик (2026-09-13, п.1) поймал это как мёртвую настройку:
//   атрибут меняется, читать его некому. Теперь проводка есть и переиспользует
//   ровно то, что уже лежало в файле: hover-зум внутри рамки и
//   openProductLightbox (полноэкранный просмотр, портированный 1:1 с
//   theme-base) — ничего нового не изобретается, разметка не трогается.
//   См. wireGalleryZoom ниже и гард product-zoom-wiring.spec.ts.
const zoomModeRaw = typeof p.zoomMode === "string" ? p.zoomMode : "";
const zoomMode: "click" | "hover" | "none" =
	zoomModeRaw === "click" || zoomModeRaw === "none" ? zoomModeRaw : "hover";

// SSR-резолв: товар ВЫБРАН мерчантом → именно он. Пикер пуст → макет секции,
// без автоподстановки первого товара магазина.
let realProduct: any = null;
if (productIdRef && siteId) {
	try {
		const base = (import.meta as any).env?.SITES_INTERNAL_BASE ?? "http://localhost:3114";
		const qs = `?product=${encodeURIComponent(productIdRef)}`;
		const res = await fetch(`${base}/api/sites/${siteId}/storefront-data${qs}`).catch(() => null);
		if (res && res.ok) {
			const data: any = await res.json();
			realProduct =
				data?.product ??
				(Array.isArray(data?.products)
					? data.products.find(
							(x: any) => x && (x.id === productIdRef || x.slug === productIdRef || x.handle === productIdRef),
						) ?? null
					: null);
		}
	} catch {
		realProduct = null;
	}
}
const isPlaceholder = !realProduct;

// — Текст (canon "text" — брендлайн над названием). Мерчантский текст ВСЕГДА
//   приоритетнее плейсхолдера/реального brand (паритет theme-base Product.astro
//   textContent ?? badge?.text, brandText = textContent || view.brand). —
const textContent = (typeof p.text === "string" ? p.text : p.text?.content) ?? p.badge?.text ?? "";
const displayBrand =
	textContent || (isPlaceholder ? PLACEHOLDER_BRAND : realProduct.collection || realProduct.brand || realProduct.vendor || "");

const displayName = isPlaceholder ? PLACEHOLDER_NAME : realProduct.name || realProduct.title || PLACEHOLDER_NAME;

// Сабпанели «Название»/«Текст» → размер кегля (общий puckConfig title.size /
// text.size; лестница в масштабе flux-вёрстки, дефолт = канон верстальщиков
// как был: title 20/24, text 14/16). Порт не читал эти поля — настройки были
// мертвы (ловля theme-registry 2026-08-06, паритет с theme-base Product).
const titleSizeProp = p.title?.size;
const titleSizeCls =
	titleSizeProp === "small"
		? "text-[16px] md:text-[20px]"
		: titleSizeProp === "large"
			? "text-[23px] md:text-[29px]"
			: "text-[20px] md:text-[24px]";
const textSizeProp = p.text?.size;
const textSizeCls =
	textSizeProp === "small"
		? "text-[12px] md:text-[14px]"
		: textSizeProp === "large"
			? "text-[16px] md:text-[18px]"
			: "text-[14px] md:text-[16px]";

// — Варианты: peреиспользуем storefront-hydrate.ts (без дублирования логики).
const combos: any[] = isPlaceholder
	? []
	: Array.isArray(realProduct.variantCombinations)
		? realProduct.variantCombinations
		: Array.isArray(realProduct.variants)
			? realProduct.variants
			: [];
const hasVariants = combos.length > 0;
const variantGroups = hasVariants ? deriveVariantGroups(combos) : [];
let selectedOptions: Record<string, string> = {};
if (hasVariants) {
	const firstAvailable = combos.find((c: any) => c && c.available !== false) ?? combos[0];
	selectedOptions = { ...(firstAvailable.options || {}) };
}
const activeCombo = hasVariants ? findCombination(combos, selectedOptions) : null;
// Figma 1:21431 — «Стиль» (variants.displayStyle): button = чипы (дефолт),
// list = выпадающий <select>. «Вариации» (variants.shape): circle/square —
// значение-цвет рендерится свотчем этой формы (renderVariantGroupsHtml, паритет
// theme-base ProductVariants); none/'' — текст-чипы (канон flux). Реестр
// 2026-08-10: прежний комментарий «shape не применима» был неверен — rose
// рисует свотчи, flux обязан тоже (гейт variants.shape).
const variantsDisplayStyle = p.variants?.displayStyle === "list" ? "list" : "button";
const variantsShapeRaw = typeof p.variants?.shape === "string" ? p.variants.shape : "";
const variantsShape = variantsShapeRaw === "circle" || variantsShapeRaw === "square" ? variantsShapeRaw : "";
// «Стиль» и «Вариации» НЕЗАВИСИМЫ. Раньше ветка «Списка» звала выпадашку, у
// которой в сигнатуре формы нет вовсе, — и «Круг/Квадрат» пропадал вместе с
// образцами (баг тестировщика 2026-09-14). Список + форма = закрытый список с
// образцами (паритет theme-base ProductVariants, ветка isListShaped); голая
// выпадашка остаётся только там, где формы нет («Вариации: Нет»). Развилка
// одна на оба пути порта (этот серверный рендер и живой рефреш в скрипте).
const variantsHtml = hasVariants
	? renderVariantsHtml(variantGroups, selectedOptions, variantsDisplayStyle, variantsShape)
	: "";

function pickOpt(opts: Record<string, string> | undefined, keys: string[]): string {
	for (const k of keys) if (opts && opts[k] != null) return opts[k];
	return "";
}
const cartColor = pickOpt(selectedOptions, ["Цвет", "Color"]);
const cartSize = pickOpt(selectedOptions, ["Размер", "Size"]);

// — Цена: активная комбинация (если положительная) перебивает базовую цену
//   товара (паритет theme-base/FluxProductDetail applyCombo). Единая формула —
//   `resolveComboPricing` (storefront-hydrate.ts), импортируется И сюда (SSR),
//   И в клиентский `<script>` applyCombo() ниже (review Task 5, Finding 3a:
//   раньше формула была продублирована чуть по-разному в двух местах). —
const { price: comboPriceRaw, oldPrice: comboOldRaw } = resolveComboPricing(activeCombo, realProduct);

const displayPrice = isPlaceholder ? PLACEHOLDER_PRICE : formatPrice(comboPriceRaw) || PLACEHOLDER_PRICE;
const displayOldPrice = isPlaceholder ? "" : formatPrice(comboOldRaw);

const priceNumForBadge = toPriceNumber(comboPriceRaw);
const oldNumForBadge = toPriceNumber(comboOldRaw);
const salePercentText =
	!isPlaceholder && oldNumForBadge && priceNumForBadge && oldNumForBadge > priceNumForBadge
		? `-${Math.round(((oldNumForBadge - priceNumForBadge) / oldNumForBadge) * 100)}%`
		: "";
const showBadges = !!salePercentText;

// — Галерея. thumbs = первые 5 фото ВКЛЮЧАЯ главное (буквально как в пине:
//   `const [mainImage] = gallery; const thumbs = gallery.slice(0, 5);`). —
const realImages: string[] = isPlaceholder
	? []
	: Array.isArray(realProduct.images)
		? realProduct.images.filter((x: unknown) => typeof x === "string" && x)
		: [];
const galleryImages = realImages.length > 0 ? realImages : [PLACEHOLDER_IMAGE];
const [mainImage] = galleryImages;
const thumbs = galleryImages.slice(0, 5);
const href = isPlaceholder ? "/catalog" : productHref(realProduct);

// «Макет» — семантика theme-base Product (Figma 648:55733), натянутая на
// вёрстку flux. Раньше работал только stacked (сетка миниатюр); split и
// two-columns не отличались от дефолта — настройка на 2 из 4 значений молчала.
//   carousel/дефолт — вёрстка как есть: главное фото + ряд миниатюр снизу;
//   stacked        — главное фото + СЕТКА миниатюр снизу;
//   split          — миниатюры КОЛОНКОЙ слева от главного фото;
//   two-columns    — все фото равной сеткой 2×N, без главного.
const isSplit = layout === "split";
const isTwoCols = layout === "two-columns";
// «Сложенный» — СЕТКА на ВСЮ ширину колонки-галереи, плитки тянутся по ячейке.
// Было `grid grid-cols-3 gap-3` у плиток с ФИКСИРОВАННОЙ стороной
// `size-[…var(--product-thumb-size,120px)]`: сетка внутри flex-строки
// сжималась по содержимому, и лента занимала 384px из 652 (59 %), а на
// планшете (768–1023px, колонка на всю ширину) — 384 из 736 (52 %). Замер
// 15.09, Chromium: у остальных четырёх тем «Сложенный» — 552 из 552 (100 %),
// и у самого flux «Карусель» 596/652 (91 %), «2 колонки» — сетка во всю
// ширину. То есть из четырёх макетов не заполнял колонку ровно «Сложенный».
//
// КОЛОНОК — ДВЕ, не три (жалоба владельца 16.09, пункт 5: «макет „Сложенный“
// отображается неверно»). `grid-cols-3` был собственным изобретением порта —
// канон «Сложенного» задаёт `packages/theme-base/blocks/Product/
// ProductGallery.astro` (rose/bloom/satin/vanilla заходят сюда все через один
// компонент): `data-thumbs-axis="grid"` → `grid grid-cols-2 gap-3 w-full`.
// Три колонки делали плитку у flux заметно МЕЛЬЧЕ и ряд другой высоты, чем на
// остальных четырёх темах при ОДНОЙ и той же настройке «Макет: Сложенный» —
// разъехавшийся паритет, а не альтернативный дизайн (эталон платформы —
// theme-base/rose, «Товара» напрямую в rose нет, но сетка миниатюр — общий
// компонент). Сторож: pnpm test:scheme-targets («flux · Товар · Сложенный»).
const thumbsTrackCls =
	layout === "stacked"
		? "grid w-full grid-cols-2 gap-3"
		: isSplit
			? "flex flex-col items-start gap-3"
			: "no-scrollbar flex flex-1 items-center gap-3 overflow-x-auto";
/**
 * Сторона миниатюры. В «Сложенном» её задаёт ЯЧЕЙКА сетки (плитка квадратная
 * и растягивается), в остальных макетах — фиксированный размер из «Размера»
 * секции: там лента прокручивается или стоит колонкой, и тянуть плитку не по
 * чему.
 */
const thumbSizeCls =
	layout === "stacked"
		? "aspect-square w-full"
		: "size-[88px] md:size-[var(--product-thumb-size,120px)]";
const galleryColCls = isSplit
	? "flex w-full flex-row-reverse items-start gap-4 lg:w-[var(--product-main-image-size,652px)] lg:min-w-0"
	: "flex w-full flex-col gap-4 lg:w-[var(--product-main-image-size,652px)] lg:min-w-0";

// — Количество: canon quantity.enabled (object) + плоский legacy-алиас
//   showQuantity (dual-support паттерн, единый для секций flux). —
const quantityEnabledRaw =
	p.quantity && typeof p.quantity === "object" ? p.quantity.enabled : (p.showQuantity ?? p.quantity);
const quantityVisible = quantityEnabledRaw !== false && quantityEnabledRaw !== "false";

// — Кнопки: «Основная» (buttons.addToCart.text, пусто = скрыть) + «Динамическая»
//   (dynamicButton toggle, дефолт показана) — канон theme-base Product.astro. —
const addBtnTextRaw = p.buttons?.addToCart?.text;
const addBtnText = addBtnTextRaw === undefined ? "Добавить в корзину" : addBtnTextRaw;
const showAddToCart = String(addBtnText).trim() !== "";
// Подпись «Динамической кнопки» редактируется в подпанели «Кнопки»
// (buttons.buyNow.text, канон theme-base Product.astro). Здесь лейбл был вбит
// строкой — жалоба тестировщика 13.09: «КУПИТЬ В 1 КЛИК» сохранялся, а на
// витрине оставалось «Купить сейчас». Пусто = дефолтный лейбл; видимость —
// отдельный тоггл dynamicButton.
const buyBtnTextRaw = p.buttons?.buyNow?.text;
const buyBtnText = String(buyBtnTextRaw ?? "").trim() || "Купить сейчас";
const dynRaw = p.dynamicButton && typeof p.dynamicButton === "object" ? p.dynamicButton.enabled : p.dynamicButton;
const showBuyNow = dynRaw !== "false" && dynRaw !== false;

// — Описание: canon disabledHint-поле (контент ТОЛЬКО из реального товара,
//   мерчант его не редактирует) + visualConfig.showDescription/showDescription
//   плоский алиас (дефолт true — DEFAULT_VISUAL_CONFIG.showDescription). —
const showDescRaw =
	p.visualConfig && typeof p.visualConfig.showDescription === "boolean" ? p.visualConfig.showDescription : p.showDescription;
const descriptionEnabled = showDescRaw !== false;
const description = isPlaceholder ? "" : realProduct.description || realProduct.metaDescription || "";
const hasDescription = descriptionEnabled && !isPlaceholder && !!description.trim();

const shareText = typeof p.share?.text === "string" && p.share.text.trim() ? p.share.text : "Поделиться";

// — Cart-атрибуты (declarative, глобальный делегат initCartUI/lib/cart.ts). —
const cartProductId = (realProduct && realProduct.id) || productIdRef || "";
const addToCartAttrs = {
	"data-add-to-cart": true,
	"data-product-id": cartProductId,
	"data-name": displayName,
	"data-price": displayPrice,
	"data-old-price": displayOldPrice || "",
	"data-image": mainImage,
	"data-variant-color": cartColor,
	"data-variant-size": cartSize,
	"data-variant-combination-id": activeCombo?.id || "",
	"data-quantity": "1",
};

// — Цветовая схема + отступы (канон Product.puckConfig colorScheme/padding,
//   паттерн CartSection.astro/Footer flux). —
const paddingStyle = p.padding
	? `padding-top:${Math.min(Number(p.padding.top) || 0, 160)}px;padding-bottom:${Math.min(Number(p.padding.bottom) || 0, 160)}px;`
	: undefined;
const schemeClass = `color-scheme-${String(p.colorScheme ?? 2).replace("scheme-", "")}`;
// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((Astro.props as any).hiddenFields)
	? ((Astro.props as any).hiddenFields as unknown[]).filter(
			(x): x is string => typeof x === 'string',
		)
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);

---

<section
	id="featured"
	class:list={["w-full bg-[rgb(var(--color-bg,255_255_255))]", schemeClass]}
	aria-label={displayName}
	data-puck-component-id={id}
	data-block="featured-product"
	data-site-id={siteId}
	data-product-id={cartProductId}
	data-zoom-mode={zoomMode}
	data-product-slug={typeof (realProduct as { slug?: string } | null)?.slug === "string" ? (realProduct as { slug: string }).slug : productIdRef}
	style={sizeVarsStyle}
>
	{!isPlaceholder && (
		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "Product",
				name: displayName,
				image: mainImage || undefined,
				offers: {
					"@type": "Offer",
					priceCurrency: "RUB",
					price: String(priceNumForBadge || ""),
					availability: "https://schema.org/InStock",
				},
			})}
		/>
	)}
	<div class:list={["flux-container", paddingStyle ? "" : "py-10 md:py-16"]} style={paddingStyle} data-reveal>
		<!-- ============================= DESKTOP (≥768px) ============================= -->
		<div
			class:list={[
				"hidden w-full flex-col items-start gap-8 md:flex lg:flex-row lg:justify-between lg:gap-10",
				photoOnLeft ? "" : "lg:flex-row-reverse",
			]}
			data-nt="product-configurator"
		>
			<!-- Изображения -->
			<div class={galleryColCls}>
				{isTwoCols ? (
					/* two-columns: все фото равной сеткой, главного нет. Первому
					   оставляем data-cfg-main — так смена товара обновляет и эту
					   раскладку. Плитки НЕ помечаем data-cfg-thumb: переключать
					   тут нечего (все кадры уже на экране), а раньше клик по ним
					   гонял свап и файлы меняли места. */
					<div class="grid w-full grid-cols-2 gap-4">
						{galleryImages.map((img, i) => (
							<div data-cfg-hero={i === 0 ? "" : undefined} data-media-index={i} data-image={img} class="relative block aspect-square w-full overflow-hidden rounded-[var(--radius-media,8px)] bg-[rgb(var(--color-surface,245_245_245))]" aria-label={displayName}>
								{i === 0 ? (
									<FluxPicture src={img} alt={displayName} width="326" height="326" loading="eager" class="absolute inset-0 h-full w-full object-cover" data-cfg-main />
								) : (
									<FluxPicture src={img} alt={displayName} width="326" height="326" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
								)}
							</div>
						))}
					</div>
				) : (
				<>
				<div data-cfg-hero class:list={["relative block aspect-square w-full overflow-hidden rounded-[var(--radius-media,8px)] bg-[rgb(var(--color-surface,245_245_245))]", isSplit && "min-w-0 flex-1"]} aria-label={displayName}>
					{isPlaceholder ? (
						<img src={mainImage} alt={displayName} width="652" height="652" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" data-cfg-main />
					) : (
						<FluxPicture src={mainImage} alt={displayName} width="652" height="652" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" data-cfg-main />
					)}
				</div>
				{thumbs.length > 1 && !isTwoCols && (
					<div class:list={[isSplit ? "flex flex-col gap-3" : "flex w-full items-center gap-3"]}>
						<div class={thumbsTrackCls} data-cfg-thumbs-track>
							{thumbs.map((img, i) => (
								<button
									type="button"
									class:list={[
										thumbSizeCls,
										"shrink-0 overflow-hidden rounded-[var(--radius-media,8px)] bg-[rgb(var(--color-surface,245_245_245))] transition-opacity hover:opacity-90",
										i === 0 ? "border border-solid border-[rgb(var(--color-button-bg,30_41_82))]/50" : "",
									]}
									data-cfg-thumb
									data-media-index={i}
									data-image={img}
									aria-current={i === 0 ? "true" : "false"}
									aria-label="Показать изображение"
								>
									<FluxPicture src={img} alt={displayName} width="120" height="120" loading="eager" class="h-full w-full object-cover" />
								</button>
							))}
						</div>
						{thumbs.length >= 5 && layout !== "stacked" && !isSplit && (
							<button type="button" class="flex size-11 shrink-0 items-center justify-center text-[rgb(var(--color-heading,0_0_0))] transition-opacity hover:opacity-70" data-cfg-thumbs-next aria-label="Следующие изображения">
								<span class="block size-6" set:html={ARROW_RIGHT_ICON_SVG} />
							</button>
						)}
					</div>
				)}
				</>
				)}
			</div>

			<!-- Блок -->
			<div class="flex w-full flex-col gap-10 lg:w-[628px] lg:min-w-0">
				<!-- Текст -->
				<div class="flex flex-col gap-2">
					{displayBrand && !isFieldHidden('text') && (
						<p
							class={`font-roboto-flex ${textSizeCls} font-light leading-normal text-[rgb(var(--color-muted,153_153_153))]`}
							data-puck-subsection-parent={id}
							data-puck-subsection-index="100"
							data-puck-subsection-field="text"
							set:html={inlineFormat(displayBrand)}
						></p>
					)}
					{!isFieldHidden('title') && (
					<h1
						class={`font-roboto-flex ${titleSizeCls} font-light leading-normal text-[rgb(var(--color-heading,0_0_0))]`}
						data-cfg-name
						data-puck-subsection-parent={id}
						data-puck-subsection-index="101"
						data-puck-subsection-field="title"
					>
						{displayName}
					</h1>
					)}
					{!isFieldHidden('price') && (
					<div class="flex items-center gap-2" data-puck-subsection-parent={id} data-puck-subsection-index="102" data-puck-subsection-field="price">
						<span class="font-roboto-flex text-[18px] font-light leading-normal text-[rgb(var(--color-heading,0_0_0))] md:text-[20px]" data-cfg-price>
							{displayPrice}
						</span>
						<span class="font-roboto-flex text-[15px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))] line-through md:text-[16px]" data-cfg-oldprice hidden={!displayOldPrice}>
							{displayOldPrice}
						</span>
					</div>
					)}
				</div>

				<!-- Варианты (НЕ было в pin — добавлено по канон-контракту Product, стиль
				     переиспользован из установленного PDP-паттерна renderVariantGroupsHtml). -->
				{!isFieldHidden('variants') && (
				<div
					class="flex flex-col gap-4"
					data-cfg-variants
					data-variants-style={variantsDisplayStyle}
					data-variants-shape={variantsShape}
					data-puck-subsection-parent={id}
					data-puck-subsection-index="103"
					data-puck-subsection-field="variants"
					hidden={!hasVariants}
					set:html={variantsHtml}
				/>
				)}

				<!-- Счётчик -->
				{quantityVisible && !isFieldHidden('quantity') && (
					<div class="inline-flex w-fit items-center gap-3" data-cfg-qty data-puck-subsection-parent={id} data-puck-subsection-index="104" data-puck-subsection-field="quantity">
						<button type="button" class="flex size-11 items-center justify-center text-[rgb(var(--color-heading,0_0_0))] transition-opacity hover:opacity-60" aria-label="Уменьшить количество" data-cfg-qty-dec>
							<span class="block size-4" set:html={MINUS_ICON_SVG} />
						</button>
						<span class="min-w-6 text-center font-roboto-flex text-[16px] font-light leading-none text-[rgb(var(--color-button-bg,30_41_82))]" data-cfg-qty-value>1</span>
						<button type="button" class="flex size-11 items-center justify-center text-[rgb(var(--color-heading,0_0_0))] transition-opacity hover:opacity-60" aria-label="Увеличить количество" data-cfg-qty-inc>
							<span class="block size-4" set:html={PLUS_ICON_SVG} />
						</button>
					</div>
				)}

				<!-- Кнопки -->
				{(showAddToCart || showBuyNow) && !isFieldHidden('buttons') && (
					<div class="flex flex-col gap-3" data-puck-subsection-parent={id} data-puck-subsection-index="105" data-puck-subsection-field="buttons">
						{showAddToCart && (
							<button
								type="button"
								data-cfg-add
								{...addToCartAttrs}
								class="inline-flex h-14 w-full items-center justify-center rounded-[4px] border border-solid border-[rgb(var(--color-button-bg,30_41_82))] bg-[rgb(var(--color-bg,255_255_255))] px-6 font-roboto-flex text-[16px] font-light leading-none text-[rgb(var(--color-button-bg,30_41_82))] transition-colors hover:bg-[rgb(var(--color-button-bg,30_41_82))] hover:text-[rgb(var(--color-button-text,255_255_255))]"
							>
								{addBtnText}
							</button>
						)}
						{showBuyNow && (
							<button
								type="button"
								data-cfg-buy
								class="inline-flex h-14 w-full items-center justify-center rounded-[4px] bg-[rgb(var(--color-button-bg,30_41_82))] px-6 font-roboto-flex text-[16px] font-light leading-none text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-90"
							>
								{buyBtnText}
							</button>
						)}
					</div>
				)}

				<!-- Описание (текст товара из админки, без служебной подписи) -->
				{hasDescription && !isFieldHidden('description') && (
					<div class="flex flex-col" data-cfg-spec data-puck-subsection-parent={id} data-puck-subsection-index="106" data-puck-subsection-field="description">
						<div data-cfg-spec-body>
							<p class="font-roboto-flex text-[14px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))] md:text-[15px]">{description}</p>
						</div>
					</div>
				)}

				<!-- Поделиться -->
				{!isFieldHidden('share') && (
				<button
					type="button"
					data-cfg-share
					data-puck-subsection-parent={id}
					data-puck-subsection-index="107"
					data-puck-subsection-field="share"
					class="inline-flex min-h-11 w-fit items-center gap-2 font-roboto-flex text-[14px] font-light leading-normal text-[rgb(var(--color-heading,0_0_0))] transition-opacity hover:opacity-70"
					aria-label={shareText}
				>
					<span class="block size-6" set:html={SHARE_ICON_SVG} />
					<span>{shareText}</span>
				</button>
				)}
			</div>
		</div>

		<!-- ============================= MOBILE (<768px) ============================= -->
		<div class="flex w-full flex-col gap-6 md:hidden" data-nt="product-configurator">
			<!-- Фото: карусель + бейджи -->
			<div class="relative w-full" data-cfg-carousel data-cfg-images={galleryImages.join("|")}>
				<div data-cfg-hero class="relative block aspect-square w-full overflow-hidden rounded-[var(--radius-media,8px)] bg-[rgb(var(--color-surface,245_245_245))]" aria-label={displayName}>
					{isPlaceholder ? (
						<img src={mainImage} alt={displayName} width="343" height="343" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" data-cfg-main />
					) : (
						<FluxPicture src={mainImage} alt={displayName} width="343" height="343" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" data-cfg-main />
					)}
				</div>

				{showBadges && (
					<div class="absolute left-[18px] top-1 flex flex-col items-start gap-1">
						<span class="inline-flex items-center justify-center rounded-[2px] bg-[rgb(var(--color-button-bg,30_41_82))] px-1.5 py-1 font-roboto-flex text-[12px] font-light leading-none text-[rgb(var(--color-button-text,255_255_255))]">{salePercentText}</span>
					</div>
				)}

				{galleryImages.length > 1 && (
					<>
						<button type="button" class="absolute left-2 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center text-[rgb(var(--color-heading,0_0_0))] transition-opacity hover:opacity-70" data-cfg-prev aria-label="Предыдущее изображение">
							<span class="block size-6" set:html={ARROW_LEFT_ICON_SVG} />
						</button>
						<button type="button" class="absolute right-2 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center text-[rgb(var(--color-heading,0_0_0))] transition-opacity hover:opacity-70" data-cfg-next aria-label="Следующее изображение">
							<span class="block size-6" set:html={ARROW_RIGHT_ICON_SVG} />
						</button>
					</>
				)}
			</div>

			<!-- Текст -->
			<div class="flex flex-col gap-2">
				{displayBrand && !isFieldHidden('text') && (
					<p class="font-roboto-flex text-[14px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))]" data-puck-subsection-parent={id} data-puck-subsection-index="100" data-puck-subsection-field="text" set:html={inlineFormat(displayBrand)}></p>
				)}
				{!isFieldHidden('title') && (
				<h1 class="font-roboto-flex text-[19px] font-light leading-normal text-[rgb(var(--color-heading,0_0_0))]" data-cfg-name data-puck-subsection-parent={id} data-puck-subsection-index="101" data-puck-subsection-field="title">
					{displayName}
				</h1>
				)}
				{!isFieldHidden('price') && (
				<div class="flex items-center gap-2" data-puck-subsection-parent={id} data-puck-subsection-index="102" data-puck-subsection-field="price">
					<span class="font-roboto-flex text-[18px] font-light leading-normal text-[rgb(var(--color-heading,0_0_0))]" data-cfg-price>{displayPrice}</span>
					<span class="font-roboto-flex text-[15px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))] line-through" data-cfg-oldprice hidden={!displayOldPrice}>{displayOldPrice}</span>
				</div>
				)}
			</div>

			<!-- Варианты -->
			{!isFieldHidden('variants') && (
			<div
				class="flex flex-col gap-4"
				data-cfg-variants
				data-variants-style={variantsDisplayStyle}
					data-variants-shape={variantsShape}
				data-puck-subsection-parent={id}
				data-puck-subsection-index="103"
				data-puck-subsection-field="variants"
				hidden={!hasVariants}
				set:html={variantsHtml}
			/>
			)}

			<!-- Счётчик -->
			{quantityVisible && !isFieldHidden('quantity') && (
				<div class="inline-flex w-fit items-center gap-3" data-cfg-qty data-puck-subsection-parent={id} data-puck-subsection-index="104" data-puck-subsection-field="quantity">
					<button type="button" class="flex size-8 items-center justify-center text-[rgb(var(--color-heading,0_0_0))] transition-opacity hover:opacity-60" aria-label="Уменьшить количество" data-cfg-qty-dec>
						<span class="block size-4" set:html={MINUS_ICON_SVG} />
					</button>
					<span class="min-w-6 text-center font-roboto-flex text-[16px] font-light leading-none text-[rgb(var(--color-button-bg,30_41_82))]" data-cfg-qty-value>1</span>
					<button type="button" class="flex size-8 items-center justify-center text-[rgb(var(--color-heading,0_0_0))] transition-opacity hover:opacity-60" aria-label="Увеличить количество" data-cfg-qty-inc>
						<span class="block size-4" set:html={PLUS_ICON_SVG} />
					</button>
				</div>
			)}

			<!-- Кнопки -->
			{(showAddToCart || showBuyNow) && !isFieldHidden('buttons') && (
				<div class="flex flex-col gap-3" data-puck-subsection-parent={id} data-puck-subsection-index="105" data-puck-subsection-field="buttons">
					{showAddToCart && (
						<button
							type="button"
							data-cfg-add
							{...addToCartAttrs}
							class="inline-flex h-14 w-full items-center justify-center rounded-[4px] border border-solid border-[rgb(var(--color-button-bg,30_41_82))] bg-[rgb(var(--color-bg,255_255_255))] px-4 font-roboto-flex text-[16px] font-light leading-none text-[rgb(var(--color-button-bg,30_41_82))] transition-colors hover:bg-[rgb(var(--color-button-bg,30_41_82))] hover:text-[rgb(var(--color-button-text,255_255_255))]"
						>
							{addBtnText}
						</button>
					)}
					{showBuyNow && (
						<button type="button" data-cfg-buy class="inline-flex h-14 w-full items-center justify-center rounded-[4px] bg-[rgb(var(--color-button-bg,30_41_82))] px-4 font-roboto-flex text-[16px] font-light leading-none text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-90">
							{buyBtnText}
						</button>
					)}
				</div>
			)}

			<!-- Описание (текст товара из админки, без служебной подписи) -->
			{hasDescription && !isFieldHidden('description') && (
				<div class="flex flex-col" data-cfg-spec data-puck-subsection-parent={id} data-puck-subsection-index="106" data-puck-subsection-field="description">
					<div data-cfg-spec-body>
						<p class="font-roboto-flex text-[14px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))]">{description}</p>
					</div>
				</div>
			)}

			<!-- Поделиться -->
			{!isFieldHidden('share') && (
			<button
				type="button"
				data-cfg-share
				data-puck-subsection-parent={id}
				data-puck-subsection-index="107"
				data-puck-subsection-field="share"
				class="inline-flex min-h-11 w-fit items-center gap-2 font-roboto-flex text-[14px] font-light leading-normal text-[rgb(var(--color-heading,0_0_0))] transition-opacity hover:opacity-70"
				aria-label={shareText}
			>
				<span class="block size-6" set:html={SHARE_ICON_SVG} />
				<span>{shareText}</span>
			</button>
			)}
		</div>
	</div>
</section>

<script>
	// Оживление секции (общее для desktop+mobile деревьев, каждое своё —
	// паттерн 1:1 с upstream ProductConfigurator: forEach по
	// [data-nt="product-configurator"], счётчик/галерея/аккордеон/поделиться
	// независимы в каждом дереве). ЖИВОЙ рефреш данных (loadRealProducts) —
	// тот же каскад источников, что Popular.astro/FluxProductDetail.astro;
	// вызывается ОДИН раз на секцию (siteId у секции только один инстанс,
	// maxInstances:1), затем применяется к обоим деревьям.
	import {
		loadRealProducts,
		formatPrice,
		deriveVariantGroups,
		findCombination,
		renderVariantsHtml,
		resolveComboPricing,
	} from "../../lib/storefront-hydrate";

	function pick(opts: Record<string, string> | undefined, keys: string[]): string {
		for (const k of keys) if (opts && opts[k] != null) return opts[k];
		return "";
	}
	function resolveHeroImg(el: Element | null): HTMLImageElement | null {
		if (!el) return null;
		if (el.tagName === "IMG") return el as HTMLImageElement;
		return el.querySelector("img");
	}
	/**
	 * Клик по миниатюре → меняется ТОЛЬКО фото, которое показывает герой.
	 * Позиция каждого медиафайла в ленте неизменна.
	 *
	 * Было (баг тестировщика 2026-09-13 п.3): свап hero ↔ миниатюра плюс
	 * перезапись `data-image` у плитки. Лента flux и так содержит главное фото
	 * (`thumbs = galleryImages.slice(0, 5)`), поэтому свап не спасал ничего —
	 * он только раскидывал файлы по чужим слотам и плодил дубль главного кадра.
	 *
	 * `data-image` — стабильный источник плитки, скрипт его НЕ переписывает.
	 * Зеркалит одноимённую функцию общего блока
	 * packages/theme-base/blocks/Product/Product.astro; гард на оба порта —
	 * src/themes/__tests__/product-media-order.spec.ts.
	 */
	function wireGalleryMediaSwitch(
		galleryRoot: HTMLElement,
		getHero: () => HTMLImageElement | null,
	): void {
		if (!galleryRoot) return;
		const thumbs = galleryRoot.querySelectorAll<HTMLElement>("[data-cfg-thumb]");
		thumbs.forEach((thumb) => {
			thumb.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				const src = thumb.getAttribute("data-image");
				const hero = getHero();
				if (!src || !hero) return;
				hero.setAttribute("src", src);
				galleryRoot.querySelectorAll<HTMLElement>("[data-cfg-thumb]").forEach((t) => {
					const isActive = t === thumb;
					t.setAttribute("aria-current", isActive ? "true" : "false");
					if (isActive) t.classList.add("border", "border-solid", "border-[rgb(var(--color-button-bg,30_41_82))]/50");
					else t.classList.remove("border", "border-solid", "border-[rgb(var(--color-button-bg,30_41_82))]/50");
				});
			});
		});
	}

	function collectGalleryUrls(cfg: HTMLElement, hero: HTMLImageElement | null): string[] {
		const urls: string[] = [];
		const add = (s: string) => {
			if (s && urls.indexOf(s) === -1) urls.push(s);
		};
		if (hero) add(hero.currentSrc || hero.src || hero.getAttribute("src") || "");
		// Лента миниатюр (Сложенный/Карусель/Миниатюрный) И плитки сетки «2
		// колонки» — там ленты нет, фото лежат плитками [data-media-index].
		cfg.querySelectorAll<HTMLElement>("[data-cfg-thumb], [data-media-index]").forEach((t) => {
			const im = t.querySelector<HTMLImageElement>("img");
			add(t.getAttribute("data-image") || im?.currentSrc || im?.src || im?.getAttribute("src") || "");
		});
		return urls;
	}

	/**
	 * Оживляет КАЖДЫЙ кадр галереи по режиму «Увеличения» (canon zoomMode).
	 * Кадр — самостоятельное фото: герой [data-cfg-hero] либо плитка сетки «2
	 * колонки» [data-media-index]. Миниатюры-переключатели [data-cfg-thumb]
	 * кадрами не являются: их клик меняет фото героя. Возвращает число
	 * оживлённых кадров.
	 *
	 * Зеркалит одноимённую функцию общего блока
	 * packages/theme-base/blocks/Product/Product.astro; гард на оба порта —
	 * src/themes/__tests__/product-zoom-wiring.spec.ts.
	 */
	function wireGalleryZoom(
		galleryRoot: HTMLElement,
		mode: string,
		openLightbox: (startSrc: string) => void,
	): number {
		if (!galleryRoot) return 0;
		const candidates = galleryRoot.querySelectorAll<HTMLElement>(
			"[data-cfg-hero], [data-media-index]",
		);
		const frames: HTMLElement[] = [];
		for (let i = 0; i < candidates.length; i++) {
			if (!candidates[i].hasAttribute("data-cfg-thumb")) frames.push(candidates[i]);
		}
		let wired = 0;
		for (let i = 0; i < frames.length; i++) {
			const frame = frames[i];
			const img = frame.querySelector<HTMLElement>("img");
			if (!img) continue;
			const already = frame.getAttribute("data-zoom-wired");

			if (mode !== "hover" && mode !== "click") {
				// «Нет» — поведение выключено. Метку снимаем: по ней замолкают уже
				// навешенные обработчики (анонимные, снять их нечем), курсор и
				// масштаб возвращаем к исходным.
				if (already !== null) {
					frame.removeAttribute("data-zoom-wired");
					frame.style.cursor = "";
					img.style.transform = "";
					img.style.transformOrigin = "";
				}
				continue;
			}

			// Метка режима переживает hot-replace конструктора и смену значения:
			// второй раз слушателей не вешаем, обработчики прошлого режима сами
			// выходят по несовпадению метки.
			frame.setAttribute("data-zoom-wired", mode);
			wired++;
			if (already === mode) continue;
			frame.style.cursor = "zoom-in";

			if (mode === "hover") {
				img.style.transition = "transform 0.2s ease, transform-origin 0.05s linear";
				frame.addEventListener("mouseenter", function () {
					if (frame.getAttribute("data-zoom-wired") !== "hover") return;
					img.style.transform = "scale(2)";
				});
				frame.addEventListener("mousemove", function (e: any) {
					if (frame.getAttribute("data-zoom-wired") !== "hover") return;
					const rect = frame.getBoundingClientRect();
					const x = ((e.clientX - rect.left) / rect.width) * 100;
					const y = ((e.clientY - rect.top) / rect.height) * 100;
					img.style.transformOrigin = x + "% " + y + "%";
				});
				frame.addEventListener("mouseleave", function () {
					if (frame.getAttribute("data-zoom-wired") !== "hover") return;
					img.style.transform = "";
					img.style.transformOrigin = "";
				});
			} else {
				frame.addEventListener("click", function () {
					if (frame.getAttribute("data-zoom-wired") !== "click") return;
					openLightbox(
						frame.getAttribute("data-media-src") ||
							frame.getAttribute("data-image") ||
							img.getAttribute("src") ||
							"",
					);
				});
			}
		}
		return wired;
	}

	// Lightbox: полноэкранный попап с большим фото + лентой миниатюр. Портирован
	// 1:1 с theme-base Product.astro (то, что реально рендерит Rose) — canon
	// zoomMode="click". Разметка/поведение дословно (overlay/closeBtn/strip/
	// стрелки-клавиши/Esc), меняется только источник URL (readCfgImages ниже,
	// под структуру Flux-конфигуратора).
	function openProductLightbox(urls: string[], startIdx = 0) {
		if (urls.length === 0) return;
		let activeIdx = Math.max(0, Math.min(startIdx, urls.length - 1));

		const overlay = document.createElement("div");
		overlay.setAttribute("data-product-lightbox", "");
		overlay.style.cssText = [
			"position:fixed", "inset:0", "z-index:100",
			"background:rgba(0,0,0,0.92)",
			"display:flex", "flex-direction:column",
			"align-items:center", "justify-content:center",
			"padding:32px", "gap:16px",
		].join(";");

		const closeBtn = document.createElement("button");
		closeBtn.setAttribute("type", "button");
		closeBtn.setAttribute("aria-label", "Закрыть");
		closeBtn.style.cssText = [
			"position:absolute", "top:16px", "right:16px",
			"width:40px", "height:40px", "border:none",
			"background:rgba(255,255,255,0.1)", "color:#fff",
			"border-radius:50%", "cursor:pointer",
			"font-size:24px", "line-height:1",
			"display:flex", "align-items:center", "justify-content:center",
		].join(";");
		closeBtn.innerHTML = "×";
		overlay.appendChild(closeBtn);

		const mainImgEl = document.createElement("img");
		mainImgEl.style.cssText = [
			"max-width:100%", "max-height:calc(100vh - 200px)",
			"object-fit:contain", "display:block",
			"border-radius:8px",
		].join(";");
		mainImgEl.src = urls[activeIdx];
		overlay.appendChild(mainImgEl);

		const strip = document.createElement("div");
		strip.style.cssText = [
			"display:flex", "gap:8px",
			"overflow-x:auto", "max-width:100%",
			"padding:8px",
		].join(";");

		const thumbBtns = urls.map((url, idx) => {
			const btn = document.createElement("button");
			btn.setAttribute("type", "button");
			btn.style.cssText = [
				"width:80px", "height:80px", "flex-shrink:0",
				"border:2px solid " + (idx === activeIdx ? "#fff" : "transparent"),
				"border-radius:6px", "overflow:hidden",
				"cursor:pointer", "padding:0", "background:transparent",
				"transition:border-color 0.15s",
			].join(";");
			const img = document.createElement("img");
			img.src = url;
			img.style.cssText = "width:100%;height:100%;object-fit:cover;display:block;";
			btn.appendChild(img);
			btn.addEventListener("click", () => {
				activeIdx = idx;
				mainImgEl.src = url;
				thumbBtns.forEach((b, i) => {
					b.style.borderColor = i === idx ? "#fff" : "transparent";
				});
			});
			strip.appendChild(btn);
			return btn;
		});
		overlay.appendChild(strip);

		function close() {
			overlay.remove();
			document.removeEventListener("keydown", onKey);
		}
		function onKey(e: KeyboardEvent) {
			if (e.key === "Escape") close();
			if (e.key === "ArrowRight" && activeIdx < urls.length - 1) {
				activeIdx++;
				mainImgEl.src = urls[activeIdx];
				thumbBtns.forEach((b, i) => {
					b.style.borderColor = i === activeIdx ? "#fff" : "transparent";
				});
			}
			if (e.key === "ArrowLeft" && activeIdx > 0) {
				activeIdx--;
				mainImgEl.src = urls[activeIdx];
				thumbBtns.forEach((b, i) => {
					b.style.borderColor = i === activeIdx ? "#fff" : "transparent";
				});
			}
		}
		closeBtn.addEventListener("click", close);
		overlay.addEventListener("click", (e) => {
			if (e.target === overlay) close();
		});
		document.addEventListener("keydown", onKey);
		document.body.appendChild(overlay);
	}

	async function hydrateFeaturedProduct() {
		const section = document.querySelector<HTMLElement>('[data-block="featured-product"]');
		if (!section) return;

		const pdpRefFromUrl = () => {
			try {
				const m = location.pathname.match(/\/product\/([^/]+)\/?$/);
				if (m) return decodeURIComponent(m[1]);
				return new URLSearchParams(location.search).get("id") || "";
			} catch {
				return "";
			}
		};
		const ref =
			section.getAttribute("data-product-id") ||
			section.getAttribute("data-product-slug") ||
			pdpRefFromUrl() ||
			"";
		// «Увеличение» (canon zoomMode: hover/click/none) — паритет с Rose
		// (packages/theme-base/blocks/Product/Product.astro: hover = tracking-zoom
		// scale(2) с transform-origin за курсором; click = lightbox на весь экран +
		// лента миниатюр + стрелки/Esc). Раньше был ЗАДОКУМЕНТИРОВАННЫМ no-op —
		// вывод «зума в теме нет» сверялся со СТАТИЧНОЙ закреплённой вёрсткой
		// (там правда нет), а не с ЖИВЫМ поведением Rose (которая рендерит эту же
		// секцию через theme-base и реально его показывает) — вывод был неверным
		// применительно к принципу «логика конструктора как у Rose».
		const zoomMode = section.getAttribute("data-zoom-mode") || "hover";

		// UI-интерактивность (счётчик/миниатюры/карусель/аккордеон/поделиться)
		// работает НЕЗАВИСИМО от живых данных — вешаем всегда, на то, что уже
		// отрендерил SSR (плейсхолдер или SSR-резолв превью).
		const cfgs = Array.from(section.querySelectorAll<HTMLElement>('[data-nt="product-configurator"]'));

		let liveProduct: any = null;
		if (ref) {
			try {
				const products = await loadRealProducts();
				if (products) {
					liveProduct = products.find((x: any) => x && (x.id === ref || x.slug === ref || x.handle === ref)) ?? null;
				}
			} catch {
				liveProduct = null;
			}
		}

		for (const cfg of cfgs) {
			const mainImg = cfg.querySelector<HTMLImageElement>("[data-cfg-main]");
			const nameEl = cfg.querySelector<HTMLElement>("[data-cfg-name]");
			const priceEl = cfg.querySelector<HTMLElement>("[data-cfg-price]");
			const oldPriceEl = cfg.querySelector<HTMLElement>("[data-cfg-oldprice]");
			const addBtn = cfg.querySelector<HTMLButtonElement>("[data-cfg-add]");
			const buyBtn = cfg.querySelector<HTMLButtonElement>("[data-cfg-buy]");
			const variantsWrap = cfg.querySelector<HTMLElement>("[data-cfg-variants]");
			const qtyValEl = cfg.querySelector<HTMLElement>("[data-cfg-qty-value]");

			// ── Живой рефреш (только если реальный товар найден клиентским фетчем). ──
			let combos: any[] = [];
			let groups: { name: string; values: string[] }[] = [];
			let selected: Record<string, string> = {};

			if (liveProduct) {
				if (nameEl) nameEl.textContent = liveProduct.name || nameEl.textContent || "";
				if (mainImg && Array.isArray(liveProduct.images) && liveProduct.images[0]) {
					mainImg.setAttribute("src", liveProduct.images[0]);
				}
				combos = Array.isArray(liveProduct.variantCombinations) ? liveProduct.variantCombinations : [];
				if (combos.length) {
					groups = deriveVariantGroups(combos);
					const firstAvailable = combos.find((c: any) => c && c.available !== false) ?? combos[0];
					selected = { ...(firstAvailable.options || {}) };
				}
			}

			function activeCombo() {
				return combos.length ? findCombination(combos, selected) : null;
			}

			function variantImageFor(sel: Record<string, string>): string | null {
				const vgs = liveProduct && Array.isArray(liveProduct.variantGroups) ? liveProduct.variantGroups : [];
				for (const g of vgs) {
					const val = sel[g.name];
					if (!val || !Array.isArray(g.options)) continue;
					const opt = g.options.find((o: { value?: string; name?: string }) => o && (o.value === val || o.name === val));
					if (opt && Array.isArray(opt.images) && opt.images.length) {
						const im = opt.images[0];
						return typeof im === "string" ? im : (im && im.url) || null;
					}
				}
				const combo = activeCombo();
				if (combo) {
					if (typeof combo.image === "string" && combo.image) return combo.image;
					if (Array.isArray(combo.images) && combo.images[0]) {
						const im = combo.images[0];
						return typeof im === "string" ? im : (im && im.url) || null;
					}
				}
				return null;
			}

			function applyCombo() {
				const combo = activeCombo();
				// Единая формула резолва цены — resolveComboPricing (storefront-hydrate.ts),
				// та же, что зовёт SSR-фронтматтер этого файла (review Task 5, Finding 3a:
				// раньше здесь была слегка другая копия той же формулы).
				const { price: priceVal, oldPrice: oldVal } = resolveComboPricing(combo, liveProduct);
				const vimg = variantImageFor(selected);
				if (mainImg && vimg) {
					mainImg.setAttribute("src", vimg);
					if (addBtn) addBtn.setAttribute("data-image", vimg);
				}
				if (liveProduct) {
					const priceStr = formatPrice(priceVal);
					const oldStr = formatPrice(oldVal);
					if (priceEl) priceEl.textContent = priceStr;
					if (oldPriceEl) {
						oldPriceEl.textContent = oldStr;
						oldPriceEl.hidden = !oldStr;
					}
					if (addBtn) {
						addBtn.setAttribute("data-price", priceStr);
						addBtn.setAttribute("data-old-price", oldStr);
						addBtn.setAttribute("data-name", liveProduct.name || "");
						addBtn.setAttribute("data-product-id", liveProduct.id || ref);
						if (mainImg?.getAttribute("src")) addBtn.setAttribute("data-image", mainImg.getAttribute("src")!);
					}
				}
				const available = combo ? combo.available !== false && (combo.quantity == null || Number(combo.quantity) > 0) : true;
				for (const btn of [addBtn, buyBtn]) {
					if (!btn) continue;
					btn.disabled = !available;
					btn.classList.toggle("opacity-50", !available);
					btn.classList.toggle("pointer-events-none", !available);
				}
				if (addBtn) {
					addBtn.setAttribute("data-variant-combination-id", (combo && combo.id) || "");
					addBtn.setAttribute("data-variant-color", pick(selected, ["Цвет", "Color"]));
					addBtn.setAttribute("data-variant-size", pick(selected, ["Размер", "Size"]));
				}
			}

			// displayStyle (variants.displayStyle, canon Product.puckConfig "Стиль")
			// проставлен на wrap SSR-стороной — читаем, чтобы живой рефреш
			// перерисовывал ТЕМ ЖЕ режимом (чипы или <select>), а не молча
			// переключался на дефолт.
			const isListStyle = variantsWrap?.getAttribute("data-variants-style") === "list";
			const wrapShape = variantsWrap?.getAttribute("data-variants-shape") ?? "";
			// Развилка ОДНА на оба пути (SSR-фронтматтер и этот живой рефреш) —
			// `renderVariantsHtml` из storefront-hydrate: раньше она была
			// продублирована, и правка одной ветки оставляла вторую со старым
			// поведением — так форма и терялась после первого же клика.
			const renderVariants = (gs: { name: string; values: string[] }[], sel: Record<string, string>) =>
				renderVariantsHtml(gs, sel, isListStyle ? "list" : "button", wrapShape);

			if (variantsWrap && groups.length) {
				variantsWrap.hidden = false;
				variantsWrap.innerHTML = renderVariants(groups, selected);
				variantsWrap.onclick = (e) => {
					const target = e.target as HTMLElement;
					const btn = target.closest<HTMLElement>("[data-variant-value]");
					if (!btn) return;
					const groupEl = btn.closest<HTMLElement>("[data-pdp-variant-group]");
					const group = groupEl?.getAttribute("data-pdp-variant-group");
					const value = btn.getAttribute("data-variant-value");
					if (!group || value == null) return;
					selected[group] = value;
					variantsWrap.innerHTML = renderVariants(groups, selected);
					applyCombo();
				};
				variantsWrap.onchange = (e) => {
					const target = e.target as HTMLElement;
					const select = target.closest<HTMLSelectElement>("[data-variant-select]");
					if (!select) return;
					const group = select.getAttribute("data-variant-key");
					if (!group) return;
					selected[group] = select.value;
					applyCombo();
				};
			}
			if (combos.length || liveProduct) applyCombo();

			wireGalleryMediaSwitch(cfg, () => resolveHeroImg(mainImg));

			// Стрелка ленты миниатюр (шаг = миниатюра 120px + gap 12px).
			const track = cfg.querySelector<HTMLElement>("[data-cfg-thumbs-track]");
			cfg.querySelector<HTMLButtonElement>("[data-cfg-thumbs-next]")?.addEventListener("click", () => {
				if (!track) return;
				const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
				track.scrollTo({ left: atEnd ? 0 : track.scrollLeft + 132, behavior: "smooth" });
			});

			// Мобильная карусель (prev/next меняют главное фото).
			const carousel = cfg.querySelector<HTMLElement>("[data-cfg-carousel]");
			if (carousel) {
				const slides = (carousel.dataset.cfgImages || "").split("|").filter(Boolean);
				let idx = 0;
				const go = (delta: number) => {
					if (slides.length < 2) return;
					idx = (idx + delta + slides.length) % slides.length;
					if (mainImg) mainImg.setAttribute("src", slides[idx]);
				};
				carousel.querySelector<HTMLButtonElement>("[data-cfg-prev]")?.addEventListener("click", () => go(-1));
				carousel.querySelector<HTMLButtonElement>("[data-cfg-next]")?.addEventListener("click", () => go(1));
			}

			// Счётчик количества → синкаем data-quantity на кнопки корзины.
			const syncQty = (n: number) => {
				if (qtyValEl) qtyValEl.textContent = String(n);
				if (addBtn) addBtn.setAttribute("data-quantity", String(n));
			};
			cfg.querySelector<HTMLButtonElement>("[data-cfg-qty-dec]")?.addEventListener("click", () => {
				syncQty(Math.max(1, Number(qtyValEl?.textContent || 1) - 1));
			});
			cfg.querySelector<HTMLButtonElement>("[data-cfg-qty-inc]")?.addEventListener("click", () => {
				syncQty(Number(qtyValEl?.textContent || 1) + 1);
			});

			// «Купить сейчас» — как в пине: добавляем в корзину (клик по добавить),
			// затем переходим в /cart (упрощённый upstream-путь, НЕ express-чекаут
			// FluxProductDetail — это ДРУГАЯ секция/страница со своим контрактом).
			cfg.querySelector<HTMLButtonElement>("[data-cfg-buy]")?.addEventListener("click", () => {
				if (addBtn && !addBtn.disabled) addBtn.dispatchEvent(new MouseEvent("click", { bubbles: true }));
				try { sessionStorage.removeItem("flux:buynow"); } catch {}
				const inIframe = window.parent && window.parent !== window;
				if (inIframe) {
					try { window.parent.postMessage({ type: "navigate", path: "/checkout" }, "*"); } catch {}
				} else {
					window.location.href = "/checkout";
				}
			});

			// Аккордеона описания больше нет: служебная подпись «Описание» с витрины
			// убрана (жалоба тестировщика 14.09), а сворачивать без подписи нечего —
			// текст товара из админки печатается открытым. Прежний class-toggle снят
			// как мёртвый: единственным его триггером был [data-cfg-spec-toggle].

			// Поделиться: clipboard/navigator.share + временная подпись.
			const shareBtn = cfg.querySelector<HTMLButtonElement>("[data-cfg-share]");
			const shareLabel = shareBtn?.querySelector<HTMLElement>("span");
			shareBtn?.addEventListener("click", async () => {
				const url = location.href;
				try {
					if (navigator.share) {
						await navigator.share({ title: document.title, url });
						return;
					}
					await navigator.clipboard.writeText(url);
				} catch {
					/* пользователь отменил / нет доступа к clipboard */
				}
				if (shareLabel) {
					const orig = shareLabel.textContent;
					shareLabel.textContent = "Ссылка скопирована!";
					setTimeout(() => {
						shareLabel.textContent = orig;
					}, 1500);
				}
			});

			// Увеличение — «Нет»/«Наведение»/«Нажатие», см. константу zoomMode выше.
			// «Нажатие» открывает уже имевшийся в файле полноэкранный просмотр
			// (openProductLightbox) — раньше он лежал мёртвым кодом, его никто не
			// вызывал, и настройка «Нажатие» не делала ничего (баг тестировщика
			// 2026-09-13, п.1).
			wireGalleryZoom(cfg, zoomMode, (startSrc: string) => {
				const urls = collectGalleryUrls(cfg, resolveHeroImg(mainImg));
				const idx = urls.indexOf(startSrc);
				openProductLightbox(urls, idx < 0 ? 0 : idx);
			});
		}
	}

	hydrateFeaturedProduct();
	document.addEventListener("astro:page-load", hydrateFeaturedProduct);
</script>
