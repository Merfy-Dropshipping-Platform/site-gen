---
import NtTextField from "@merfy-dropshipping-platform/design-systems-theme/components/ui/NtTextField.astro";
import NtSectionHeading from "../ui/RoseSectionHeading.astro";
import { resolveRoseHeadingSize, roseHeadingStyle } from "../../lib/heading-size";
import { pickText, textOf, hasText } from "../../../../../packages/theme-base/runtime/merchant-text";

// ОЖИВЛЕНИЕ: канон-схема ContactForm. Секция рендерит форму обратной связи.
// Схема описывает поля ФОРМЫ. Когда мерчант настроил поля (fields-проп) —
// рендерим ИХ канон-семантикой; пустое состояние = ДОСЛОВНЫЙ Figma-плейсхолдер
// (см. ниже), а не форма-демо верстальщика.
const p = Astro.props as Record<string, any>;
const id = p.id;

// Figma 1:19335 — ДОСЛОВНЫЙ плейсхолдер ПУСТОГО состояния ContactForm: заголовок
// «Контактная форма» + поля «Имя» / «Email» / «Номер телефона» / «Комментарий» +
// кнопка «Отправить». Заголовок берём из пропса (heading), если мерчант задал свой,
// иначе — дословный Figma-литерал.
// «Размер заголовка» из панели: NtSectionHeading не принимает размер и не
// пробрасывает class на h2, поэтому секция всегда рисовала 20px — настройка
// выглядела мёртвой. Отдаём размер CSS-переменной, её читает правило в
// global.css темы (scoped-<style> секции в сборку CSS темы не попадает).
const headingSizeRaw = p.heading?.size ?? p.headingSize;
const headingFontSize =
	headingSizeRaw === "small" ? "17px" : headingSizeRaw === "large" ? "24px" : "20px";
// pickText: строка панели (heading.text / легаси heading-строка) рендерится
// КАК ЕСТЬ, даже пустая (мерчант стёр) — заглушка «Контактная форма» только
// когда поле не задано вовсе (undefined/null, старые ревизии).
const placeholderHeading = pickText(p.heading, "Контактная форма");

// «Текст» панели (`description`) — просьба владельца 2026-09-15. Порт его НЕ
// рендерил вовсе: замер живой цепочкой 2026-09-15 давал `absent` у rose и
// bloom при `ok` у satin/flux/vanilla, то есть поле молча пропадало у двух тем
// из пяти. Рисуем ТОЛЬКО при непустом значении (манера соседей: нет текста —
// нет абзаца), начертания «Ж»/«К» доезжают разметкой через RoseSectionHeading
// (там же inlineFormat + allow-list), подзаголовок он рисует ровно теми же
// классами, что у «Коллекций» и «Галереи» — своя манера не выдумывается.
// «Размер текста» (`textSize`) — просьба владельца 2026-09-16: «под инпутом
// добавить список размер текста, как сверху с размером заголовка». Механика та
// же, что у заголовка строкой выше: NtSectionHeading размера не принимает,
// поэтому кегль уезжает CSS-переменной, а правило живёт в global.css темы.
// Средняя ступень = 16px — ровно то, что секция рисовала до просьбы.
const textSizeRaw = p.textSize ?? p.text?.size ?? p.subtitleSize;
const textFontSize =
	textSizeRaw === "small" ? "14px" : textSizeRaw === "large" ? "19px" : "16px";

const description = textOf(p.description) ?? "";

// Канон fields {name,email,phone,message} (каждое {enabled,required,label}) —
// проп-ветка рендерит поля канон-семантикой (фоллбеки частичного объекта =
// канон-дефолты puckConfig: phone disabled, name/email required) В МАНЕРЕ
// DS-полей верстальщика: тот же грид/обёртки/классы NtTextField, textarea
// «Ваш вопрос» дословно по классам. Отсутствие fields = форма верстальщика
// ДОСЛОВНО (NtTextField-компоненты, без required/subsection-тегов).
const toBool = (v: any, fb: boolean): boolean =>
	typeof v === "boolean" ? v : v === "true" ? true : v === "false" ? false : fb;
const CANON_FIELDS = {
	name: { enabled: true, required: true, label: "Имя" },
	email: { enabled: true, required: true, label: "Email" },
	phone: { enabled: false, required: false, label: "Телефон" },
	message: { enabled: true, required: false, label: "Сообщение" },
};
const fieldsProp =
	p.fields && typeof p.fields === "object" && !Array.isArray(p.fields) ? p.fields : undefined;
const resolveField = (key: "name" | "email" | "phone" | "message") => {
	const def = (CANON_FIELDS as any)[key];
	const f = fieldsProp?.[key];
	return {
		enabled: toBool(f?.enabled, def.enabled),
		required: toBool(f?.required, def.required),
		label: typeof f?.label === "string" ? f.label : def.label,
	};
};
const formFields = fieldsProp
	? {
			name: resolveField("name"),
			email: resolveField("email"),
			phone: resolveField("phone"),
			message: resolveField("message"),
		}
	: undefined;

// Канон buttonText: текст кнопки с фоллбеком на литерал верстальщика.
const buttonText =
	typeof p.buttonText === "string" && p.buttonText.length > 0 ? p.buttonText : "Отправить";

const headingSize = resolveRoseHeadingSize(p.headingSize, p.heading?.size, "nested");
const headingSizeStyle = roseHeadingStyle("contacts", headingSize);

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе (паттерн T11).
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;
// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((Astro.props as any).hiddenFields)
	? ((Astro.props as any).hiddenFields as unknown[]).filter(
			(x): x is string => typeof x === 'string',
		)
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);
// SECTION-CONTRACT.md §2: оба текста стёрты → шапку не рисуем вовсе (иначе
// узел остаётся пустой обёрткой с отступом на её месте).
const headingBlockWillRender = !isFieldHidden('heading') && (hasText(placeholderHeading) || hasText(description));
const headingWillRender = headingBlockWillRender && hasText(placeholderHeading);

---

<section
	class="w-full bg-[rgb(var(--color-bg,255_255_255))] px-4 pb-[60px] pt-12 sm:px-5 md:px-10 md:pb-[80px] md:pt-20 lg:px-16 xl:px-20 2xl:px-[280px]"
	aria-labelledby={headingWillRender ? "contacts-title" : undefined}
	data-puck-component-id={id}
	style={`${paddingStyle ?? ""};--contacts-title-size:${headingFontSize};--contacts-text-size:${textFontSize}`}
>
	<div class="mx-auto flex w-full max-w-[1320px] flex-col gap-8 md:gap-10">
		{/* Figma 1:19335: дословный заголовок секции «Контактная форма» (раньше шапки
		    не было). Мерчант задал свой heading → рендерим ЕГО (placeholderHeading).
		    Оба текста стёрты → узел не рисуем вовсе (без пустого <h2> с отступами). */}
		{headingBlockWillRender && (
		<div class="flex w-full justify-center" data-puck-subsection-parent={id} data-puck-subsection-index="100" data-puck-subsection-field="heading" style={headingSizeStyle}>
			<NtSectionHeading variant="rose" titleId="contacts-title" title={placeholderHeading} subtitle={description} />
		</div>
		)}
		<div class="flex flex-col">
			<form
				class="grid grid-cols-1 gap-6 lg:grid-cols-[430px_1fr] lg:items-start lg:gap-10"
				data-contacts-form
				novalidate
			>
				{formFields ? (
					<div class="flex flex-col gap-4">
						{formFields.name.enabled && (
							<div
								class="flex w-full max-w-[430px] flex-col gap-2"
								data-nt="text-field"
								data-puck-subsection-parent={id}
								data-puck-subsection-index={0}
								data-puck-subsection-field="fields"
							>
								<label for="nt-field-name" class="font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))]">
									{formFields.name.label}{formFields.name.required && <span class="ml-1 text-[rgb(var(--color-error,255_148_148))]">*</span>}
								</label>
								<div class="relative w-full">
									<input
										id="nt-field-name"
										name="name"
										type="text"
										autocomplete="name"
										required={formFields.name.required}
										class="box-border h-14 w-full min-h-[56px] rounded-[var(--radius-input,8px)] border border-solid bg-[rgb(var(--color-bg,255_255_255))] px-4 font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))] outline-none placeholder:text-[#999999] focus-visible:border-[#000000] border-[#000000]"
									/>
								</div>
							</div>
						)}
						{formFields.email.enabled && (
							<div
								class="flex w-full max-w-[430px] flex-col gap-2"
								data-nt="text-field"
								data-puck-subsection-parent={id}
								data-puck-subsection-index={1}
								data-puck-subsection-field="fields"
							>
								<label for="nt-field-email" class="font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))]">
									{formFields.email.label}{formFields.email.required && <span class="ml-1 text-[rgb(var(--color-error,255_148_148))]">*</span>}
								</label>
								<div class="relative w-full">
									<input
										id="nt-field-email"
										name="email"
										type="email"
										autocomplete="email"
										required={formFields.email.required}
										class="box-border h-14 w-full min-h-[56px] rounded-[var(--radius-input,8px)] border border-solid bg-[rgb(var(--color-bg,255_255_255))] px-4 font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))] outline-none placeholder:text-[#999999] focus-visible:border-[#000000] border-[#000000]"
									/>
								</div>
							</div>
						)}
						{formFields.phone.enabled && (
							<div
								class="flex w-full max-w-[430px] flex-col gap-2"
								data-nt="text-field"
								data-puck-subsection-parent={id}
								data-puck-subsection-index={2}
								data-puck-subsection-field="fields"
							>
								<label for="nt-field-phone" class="font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))]">
									{formFields.phone.label}{formFields.phone.required && <span class="ml-1 text-[rgb(var(--color-error,255_148_148))]">*</span>}
								</label>
								<div class="relative w-full">
									<input
										id="nt-field-phone"
										name="phone"
										type="tel"
										autocomplete="tel"
										required={formFields.phone.required}
										class="box-border h-14 w-full min-h-[56px] rounded-[var(--radius-input,8px)] border border-solid bg-[rgb(var(--color-bg,255_255_255))] px-4 font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))] outline-none placeholder:text-[#999999] focus-visible:border-[#000000] border-[#000000]"
									/>
								</div>
							</div>
						)}
					</div>
				) : (
				<div class="flex flex-col gap-4">
					<NtTextField label="Имя" name="name" autocomplete="name" />
					<NtTextField label="Email" name="email" type="email" autocomplete="email" />
					<NtTextField label="Номер телефона" name="phone" type="tel" autocomplete="tel" />
				</div>
				)}

				{formFields ? (
					formFields.message.enabled && (
						<div
							class="flex flex-col gap-2"
							data-puck-subsection-parent={id}
							data-puck-subsection-index={3}
							data-puck-subsection-field="fields"
						>
							<label for="contacts-question" class="font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))]">
								{formFields.message.label}{formFields.message.required && <span class="ml-1 text-[rgb(var(--color-error,255_148_148))]">*</span>}
							</label>
							{/* Фон поля — «Фон» СХЕМЫ, надпись в нём — «Текст» СХЕМЫ. Было `bg-white` и
							    `text-[#000000]`: Tailwind 4 печатает `bg-white` как var(--color-white) —
							    переменная ЕСТЬ, схемы в ней нет, и поле замирало белым, пока корень
							    секции вокруг уже ехал (замер матрицы, схемы-зонды 1 → 4: #fff → #fff
							    против 17,0,0 → 0,17,0). Надпись переводим ТОЙ ЖЕ правкой: увести в схему
							    один фон значит получить чёрное на тёмном. Фолбэки = прежний вид.
							    Сторож: pnpm test:scheme-targets. */}
							<textarea
								id="contacts-question"
								name="question"
								rows={8}
								required={formFields.message.required}
								class="min-h-[232px] w-full rounded-[var(--radius-input,8px)] border border-[#000000] bg-[rgb(var(--color-bg,255_255_255))] p-4 font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))] outline-none placeholder:text-[#999999] focus-visible:border-[#000000]"
							></textarea>
						</div>
					)
				) : (
				<div class="flex flex-col gap-2">
					<label for="contacts-question" class="font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))]">
						Комментарий
					</label>
					<textarea
						id="contacts-question"
						name="question"
						rows={8}
						class="min-h-[232px] w-full rounded-[var(--radius-input,8px)] border border-[#000000] bg-[rgb(var(--color-bg,255_255_255))] p-4 font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))] outline-none placeholder:text-[#999999] focus-visible:border-[#000000]"
					></textarea>
				</div>
				)}

				<div class="lg:col-start-2 lg:flex lg:justify-end">
					<button
						type="submit"
						class="rose-btn-primary inline-flex h-[var(--size-hero-button-h,48px)] min-w-[200px] items-center justify-center rounded-[var(--radius-button,6px)] px-8 font-manrope text-[16px] font-normal leading-normal"
					>
						{buttonText}
					</button>
				</div>

				<p
					data-contacts-status
					role="status"
					class="hidden lg:col-span-2 font-manrope text-[16px] font-normal leading-normal text-[#4AD300]"
				></p>
			</form>
		</div>
	</div>
</section>

<style>
	:global(#contacts-title) {
		font-size: var(--contacts-heading-size, 20px) !important;
	}

	/* Figma 375: section title Comfortaa 14 на мобиле (как Collections/Popular).
	   NtSectionHeading не пробрасывает class на h2 — задаём через ID-правило. */
	@media (max-width: 639.98px) {
		:global(#contacts-title) {
			font-size: var(--contacts-heading-size-mobile, 14px) !important;
			line-height: 1 !important;
		}

		:global([data-nt="section-heading"]) {
			max-width: 100% !important;
			width: 100% !important;
		}
	}
</style>
