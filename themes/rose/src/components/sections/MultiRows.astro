---
// Фаза 3 (T16): новая канон-секция MultiRows в манере rose (см. themes/rose/MANNER.md).
// Схема полей = packages/theme-base/blocks/MultiRows/MultiRows.puckConfig.ts.
// Секции нет у верстальщика — ряд «картинка + текст» в чередующейся раскладке;
// сетка/зазоры/медиа/кнопки — из манеры §2-4 (паттерн ImageWithText T15).
import { inlineFormat } from "../../lib/rich-text";
import { normalizeRoseMultiRowsButtonStyle } from "../../lib/section-settings";
import { schemeIdOf } from "../../lib/color-scheme";
const p = Astro.props as Record<string, any>;
const id = p.id;

// Канон top-heading: string | { text, alignment, size } (+ legacy _headingLegacy).
// Figma 1:19335 — ПУСТОЕ состояние секции «Мультиряды»: дословный заголовок
// «Мультиряды» (а НЕ отсутствие шапки/дефолт-копирайт верстальщика). Мерчант задал
// свой heading → его и рендерим.
const heading =
	(typeof p.heading === "string" ? p.heading : p.heading?.text) ?? p._headingLegacy ?? "Мультиряды";
// Размер — через --size-section-heading (её читает .rose-title); !text-[ не работает.
// Панель пишет размер в top-level `headingSize` (select), `heading` = aiText-строка.
// Читаем top-level ПЕРВЫМ — иначе легаси-объект heading.size из старых ревизий
// перебивает выбор мерчанта и настройка выглядит мёртвой. Тот же механизм, что
// у Collections.headingSize во всех темах и у MultiRows в bloom.
const headingSize = p.headingSize ?? p.heading?.size;
const headingSizeCls =
	headingSize === "small"
		? " [--size-section-heading:17px] [--size-section-heading-m:12px]"
		: headingSize === "large"
			? " [--size-section-heading:24px] [--size-section-heading-m:17px]"
			: "";
const headingAlignment = p.headingAlignment ?? p.heading?.alignment;
const headingAlignCls =
	headingAlignment === "center"
		? " !text-center"
		: headingAlignment === "right"
			? " !text-right"
			: "";
const headingCls = `rose-title${headingSizeCls}${headingAlignCls}`;

// Канон rows[] 1-10 (item: heading|title, text|description, imageUrl|image,
// imagePosition, button{text,href|link}, size/width, headingSize/textSize).
// Figma 1:19335 — ПУСТОЕ состояние секции: ряды-плейсхолдеры (дизайн-ассет
// /placeholders/landscape-multirows-image.png в плитке + дословный текст
// «Изображение с текстом» / «Покажи и расскажи о своем товаре в одном блоке» +
// кнопка «Кнопка»), а НЕ дефолт-контент верстальщика («Первый/Второй ряд»,
// «Описание…», «Подробнее»/«Узнать больше») и НЕ пустая surface. Ассет раздаётся
// на каждой теме из packages/theme-base/public/placeholders (copyPublic). Мерчант
// задал rows → его и рендерим (поведение ниже не меняется).
const PLACEHOLDER_ROW_IMAGE = "/placeholders/landscape-multirows-image.png";
const PLACEHOLDER_ROWS = [
	{
		id: "row-1",
		heading: "Изображение с текстом",
		text: "Покажи и расскажи о своем товаре в одном блоке",
		imageUrl: PLACEHOLDER_ROW_IMAGE,
		button: { text: "Кнопка", href: "/catalog" },
	},
	{
		id: "row-2",
		heading: "Изображение с текстом",
		text: "Покажи и расскажи о своем товаре в одном блоке",
		imageUrl: PLACEHOLDER_ROW_IMAGE,
		button: { text: "Кнопка", href: "/catalog" },
	},
];
const rawRows = Array.isArray(p.rows) && p.rows.length ? p.rows : PLACEHOLDER_ROWS;

// Канон «Позиция рядов»: ряды ВСЕГДА чередуют сторону медиа по индексу. Свитчер
// (Слева/Справа) задаёт сторону ТОЛЬКО первого ряда (i=0): «Справа» → ряд 0 фото
// справа, иначе (Слева/умолчание/legacy 'alternate') → ряд 0 слева. Дальше строгое
// чередование 0,1,0,1… — per-item imagePosition больше не учитываем (нет в UI).
const firstRowRight = p.rowsPosition === "right";

// Канон size (s/m/l) — высота/аспект медиа ряда (топ-уровень, per-item size
// приоритетнее). Аспекты — литералы манеры §4 (паттерн T15 ImageWithText).
const aspectFor = (s: string | undefined) =>
	s === "small" ? "aspect-[429/309]" : s === "large" ? "aspect-[430/500]" : "aspect-[429/444]";

// Плейсхолдер пустого состояния (Figma 1:19335): ряд без выбранной картинки несёт
// дизайн-ассет landscape-multirows-image.png (PLACEHOLDER_ROWS выше), а реальный ряд
// мерчанта без картинки → пустая surface-плитка (image='' → <img> не рендерится,
// контейнер ниже имеет bg-surface). На live мерчант грузит своё фото.
// «Высота» секции не работала (владелец 19.09 по bloom: «высота настройка
// вообще не работает»): у КАЖДОГО ряда в сиде лежит свой `size`, а per-row
// значение приоритетнее секционного — секционный регулятор не менял ничего.
// Правило то же, что уже стоит в общем блоке `packages/theme-base/blocks/
// MultiRows/MultiRows.astro` (починено там 18.09, в порты тем не доехало):
// отличить «мерчант выбрал ряду свой размер» от «так лёг дефолт сида» в данных
// нельзя, но если у ВСЕХ рядов размер ОДИНАКОВ — переопределять нечего, и
// высотой правит секция. Стоит рядам разойтись — выбор мерчанта снова главнее.
const rowSizes = rawRows.map((r: any) => r?.size);
const perRowSizesDiffer = rowSizes.some((s: unknown) => s !== rowSizes[0]);

const rows = rawRows.slice(0, 10).map((r: any, i: number) => {
	const btnText =
		typeof r.button?.text === "string" && r.button.text.trim() ? r.button.text : undefined;
	return {
		heading:
			(typeof r.heading === "string" && r.heading) || (typeof r.title === "string" && r.title) || "",
		text:
			(typeof r.text === "string" && r.text) ||
			(typeof r.description === "string" && r.description) ||
			"",
		image:
			(typeof r.imageUrl === "string" && r.imageUrl.trim()) ||
			(typeof r.image === "string" && r.image.trim()) ||
			PLACEHOLDER_ROW_IMAGE,
		right: firstRowRight ? i % 2 === 0 : i % 2 === 1,
		aspectCls: aspectFor(
			// «Как в секции» (inherit) и отсутствие → высота берётся у секции.
			// Раньше собственный размер ряда стоял в дефолтах и молча перебивал
			// общую настройку «Высота» — она выглядела мёртвой.
						// Пустая «Высота» ≡ дефолт панели ('small'): пока секцией правили ряды,
			// оба случая давали один вид, а теперь разошлись бы — гард
			// panel-default-is-noop ловит ровно это. 'small' держит прежнюю
			// картину: у рядов в сидах лежит именно он.
			perRowSizesDiffer && r.size && r.size !== "inherit" ? r.size : (p.size ?? "small"),
		),
		headingSizeCls:
			(r.headingSize ?? undefined) === "small"
				? " [--size-section-heading:17px] [--size-section-heading-m:12px]"
				: r.headingSize === "large"
					? " [--size-section-heading:24px] [--size-section-heading-m:17px]"
					: "",
		textSizeCls:
			r.textSize === "small" ? " !text-[14px]" : r.textSize === "large" ? " !text-[19px]" : "",
		btnText,
		btnHref:
			(typeof r.button?.href === "string" && r.button.href ? r.button.href : undefined) ??
			r.button?.link?.href ??
			(typeof r.button?.link === "string" && r.button.link ? r.button.link : undefined) ??
			"/catalog",
	};
});

// Канон width (s/m/l/full): small 780, medium 1080, large/отсутствие 1320
// (контейнер манеры; canon-defaults width не пишут), full — без лимита.
const widthCls =
	p.width === "small"
		? "max-w-[780px]"
		: p.width === "medium"
			? "max-w-[1080px]"
			: p.width === "full"
				? "max-w-none"
				: "max-w-[1320px]";

// Владелец 2026-09-17 (дословно): «контейнер и медиа соприкасаются, если медиа
// маленького размера, контейнер берёт на себя больше места и так же наоборот».
// Тот же топ-уровневый проп «Ширина» (widthCls выше не трогаем — он держит
// потолок ряда) теперь ДОПОЛНИТЕЛЬНО задаёт ДОЛЮ медиа внутри пары: small —
// медиа уже текста (2:3 ⇒ 40%), medium — примерно половина (1:1, ровно как на
// эталоне владельца), large — медиа шире текста (3:2 ⇒ 60%). Доли — литералы
// в ОБЪЕКТЕ (не строятся конкатенацией числа в шаблонной строке): сканер
// Tailwind ищет ЦЕЛЫЙ класс текстом в исходнике, а `grid-cols-[${a}fr_${b}fr]`
// с подставленным числом в бандл не попадёт (тот же класс призраков, что уже
// ловили на lg:basis-1/2 — см. media-text-pair.spec.ts).
const ROW_SPLIT: Record<"small" | "medium" | "large", { mediaFirst: string; textFirst: string }> = {
	small: { mediaFirst: "lg:grid-cols-[2fr_3fr]", textFirst: "lg:grid-cols-[3fr_2fr]" },
	medium: { mediaFirst: "lg:grid-cols-[1fr_1fr]", textFirst: "lg:grid-cols-[1fr_1fr]" },
	large: { mediaFirst: "lg:grid-cols-[3fr_2fr]", textFirst: "lg:grid-cols-[2fr_3fr]" },
};
// Отсутствие значения ведёт себя как «Большая» — ровно так же, как потолок
// ряда выше (widthCls: без width = max-w-[1320px], то есть large). Раньше доля
// при отсутствии падала в "medium", и секция без настройки брала потолок
// большой ширины с долей средней — два разных ответа на один и тот же «проп не
// задан». Гард дефолтов панели это и поймал: рендер со значением и без него
// расходился (pnpm test:panel-defaults, MultiRows.width).
const rowSplitKey: "small" | "medium" | "large" =
	p.width === "small" ? "small" : p.width === "medium" ? "medium" : "large";

// Канон alignment — выравнивание текстовой колонки рядов.
// Мобилка (<sm=640): тема форсит заголовки по центру (global.css .rose-title
// @≤639.98px), поэтому весь контент ряда центрируем (иначе кнопка/текст слева
// «криво» под центрированным заголовком). Настройка выравнивания уважается с sm:+
// (desktop) — эмитим sm:-варианты; base — центр.
const alignCls =
	p.alignment === "center"
		? "sm:items-center sm:text-center"
		: p.alignment === "right"
			? "sm:items-end sm:text-right"
			: "sm:items-start sm:text-left";

// Канон buttonStyle (primary/black/white): primary|black/отсутствие = чёрная
// заливка манеры §3 (габариты Contacts CTA); white = белая (button-2 токены,
// манера hero CTA).
const btnBase =
	"inline-flex h-12 w-auto min-w-[200px] items-center justify-center rounded-[var(--radius-button,6px)] px-8 font-manrope text-[16px] font-normal leading-normal transition-opacity hover:opacity-90";
const buttonStyle = normalizeRoseMultiRowsButtonStyle(p.buttonStyle);
const btnCls =
	buttonStyle === "white"
		? `${btnBase} bg-[rgb(var(--color-button-2-bg,255_255_255))] text-[rgb(var(--color-button-2-text,0_0_0))]`
		: `${btnBase} bg-[rgb(var(--color-button-bg,0_0_0))] text-[rgb(var(--color-button-text,255_255_255))]`;

// Канон containerEnabled (toggle; puckConfig готов) — per-element: surface-бокс
// (#F5F5F5 / радиус / паддинг) на КАЖДЫЙ ряд (паттерн MultiColumns/Сворачиваемый),
// НЕ один общий бокс вокруг секции. Дефолт ВЫКЛ; бокс по явному включению тоггла.
const containerEnabled = String(p.containerEnabled ?? "false") === "true";
// Бокс РЯДА: ВКЛ → surface-карточка манеры на каждом <li>; ВЫКЛ → голый ряд.
const rowSurfaceCls = containerEnabled
	? " rounded-[var(--radius-card,8px)] bg-[rgb(var(--color-surface,245_245_245))] p-6 md:p-8"
	: "";
// Схема КОНТЕЙНЕРА (п.2 тестировщика 2026-09-13). «Контейнер» мультирядов — это
// ВСЯ половина ряда напротив медиа, поэтому класс висит на текстовой колонке, а
// не на <ul>: на <ul> он красил заодно и подложку картинки.
// Тоггла «Контейнер» в панели мультирядов НЕТ (`containerEnabled` — hidden-поле,
// см. MultiRows.puckConfig.ts), поэтому схема им НЕ гейтится: иначе видимый
// контрол «Цветовая схема контейнера» не делал бы ничего. Значение принимаем и
// строкой, и числом — см. lib/color-scheme.ts.
const containerSchemeId = schemeIdOf(p.containerColorScheme);
// Один класс схемы только переопределяет CSS-переменные. Чтобы мерчант увидел
// цвет, на том же узле нужны фон/текст, читающие их; h-full + justify-center
// растягивают контейнер на высоту ряда, радиус/отступ — манера контейнера темы
// (те же, что у rowSurfaceCls выше).
// Шов НЕ скругляется (владелец 2026-09-17, перепроверка): текстовый контейнер
// стоит впритык к медиа (lg:gap-0, см. ниже) зеркально медиа-скруглению —
// сторона СТЫКА всегда rounded-*-none, скругление темы только на ВНЕШНЕЙ
// стороне ряда. Раньше был один класс на все ряды без учёта r.right — отсюда
// щель в форме скругления на стыке (media-text-pair.spec.ts §5 ловил только
// медиа, не контейнер).
const containerSchemeCls = (right: boolean) =>
	containerSchemeId
		? ` color-scheme-${containerSchemeId} bg-[rgb(var(--color-bg,255_255_255))] text-[rgb(var(--color-text,0_0_0))] h-full justify-center rounded-[var(--radius-card,8px)] p-6 md:p-8 ${right ? "lg:rounded-r-none lg:rounded-l-[var(--radius-card,8px)]" : "lg:rounded-l-none lg:rounded-r-[var(--radius-card,8px)]"}`
		: "";

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе (паттерн T11).
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;

const titleId = id && heading ? `${id}-title` : undefined;
// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((Astro.props as any).hiddenFields)
	? ((Astro.props as any).hiddenFields as unknown[]).filter(
			(x): x is string => typeof x === 'string',
		)
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);

---

<section
	class="w-full bg-[rgb(var(--color-bg,255_255_255))] px-4 pb-14 pt-14 sm:px-5 sm:pb-16 sm:pt-16 md:px-10 md:pb-[100px] md:pt-[100px] lg:px-16 lg:pb-[120px] lg:pt-[120px] xl:px-20 xl:pb-[140px] xl:pt-[140px] 2xl:px-[280px]"
	aria-labelledby={titleId}
	data-puck-component-id={id}
	style={paddingStyle}
>
	<div class={`mx-auto flex w-full ${widthCls} flex-col gap-8 md:gap-10`}>
		{
			heading && !isFieldHidden('heading') && (
				<h2
					id={titleId}
					class={headingCls}
					data-animate
					data-puck-subsection-parent={id}
					data-puck-subsection-index="100"
					data-puck-subsection-field="heading"
				>
					<Fragment set:html={inlineFormat(heading)} />
				</h2>
			)
		}
		{/* Зазор МЕЖДУ рядами — канон владельца 2026-09-17 (Shopify Row): ряды
		    ВПЛОТНУЮ, зазор РОВНО ноль на lg: (там же, где ряд становится
		    двухколоночным — media-text-pair.spec.ts). На мобильном (одна колонка)
		    зазор оставлен, иначе ряды сливаются в кашу (multirows-row-gap.spec.ts).
		    Владелец 2026-09-17 (баг «раскладка ломается»): `lg:items-center` СНИМАЛ
		    дефолтное растяжение grid-элементов на высоту ряда — медиа (фикс-аспект)
		    и текст (высота по контенту) переставали совпадать по высоте на ЛЮБОЙ
		    ширине ≥lg и ЛЮБОЙ комбинации Высота/Ширина/per-row size, не только на
		    промежуточных ширинах окна. Без items-center grid растягивает оба узла
		    (align-items:normal ⇒ stretch), img внутри — object-cover (!h-full
		    !w-full), поэтому просто обрезается по новой высоте без искажений.
		    Эталон — bloom/satin (там items-center на ряду никогда не было).
		    Сторож: multirows-row-stretch.spec.ts (несколько ширин + сочетаний
		    настроек — три прежних гарда проверяли одно состояние на одной ширине
		    и пропустили баг). */}
		<ul class="flex w-full flex-col gap-8 lg:gap-0" role="list">
			{
				rows.map((r, i) => (
					<li
						class={`grid w-full grid-cols-1 gap-6 md:gap-8 ${ROW_SPLIT[rowSplitKey][r.right ? "textFirst" : "mediaFirst"]} lg:gap-0${rowSurfaceCls}`}
						data-animate
						data-puck-subsection-parent={id}
						data-puck-subsection-index={i}
						data-puck-subsection-field="rows"
					>
						<div
							class={`w-full overflow-hidden rounded-[var(--radius-media,8px)] bg-[rgb(var(--color-surface,245_245_245))] ${r.aspectCls}${r.right ? " lg:order-2 lg:rounded-l-none lg:rounded-r-[var(--radius-media,8px)]" : " lg:rounded-r-none lg:rounded-l-[var(--radius-media,8px)]"}`}
							aria-hidden={r.image ? undefined : "true"}
						>
							{r.image && (
								<img src={r.image} alt={r.heading || "Ряд"} loading="lazy" class="!h-full !w-full object-cover" />
							)}
						</div>
						<div class={`flex w-full flex-col gap-6 items-center text-center ${alignCls}${r.right ? " lg:order-1" : ""}${containerSchemeCls(!!r.right)}`}>
							{r.heading && <h3 class={`rose-title${r.headingSizeCls}`} set:html={inlineFormat(r.heading)} />}
							{r.text && (
								<div
									class={`font-manrope text-[16px] font-normal leading-[1.6] text-[rgb(var(--color-text,0_0_0))]${r.textSizeCls}`}
									set:html={inlineFormat(r.text)}
								/>
							)}
							{r.btnText && (
								<div class="mt-2">
									<a href={r.btnHref} class={btnCls}>
										{r.btnText}
									</a>
								</div>
							)}
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
