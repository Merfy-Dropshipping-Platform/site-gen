---
// Catalog — РОДНОЙ каталог верстальщика vanilla как per-theme override блока
// Catalog (порт из themes/vanilla/src/components/catalog/VanillaCatalogSection.astro).
// Заменяет generic theme-base/blocks/Catalog/Catalog.astro на пиксель-перфектную
// вёрстку vanilla: top-раскладка (details-дропдауны) + side-раскладка
// (VanillaCatalogFilterSidebar), переключение через data-catalog-layout, гидрация
// реальных товаров (фильтры наличие/цена/коллекция + сортировка + пагинация).
//
// Рендерится ОДИНАКОВО:
//   • Live build — assemble-from-packages.ts (THEME PASS, overwrite=true)
//     копирует этот файл + siblings плоско в <scaffold>/src/components/,
//     перезаписывая base. astro build собирает client.
//   • Превью конструктора — compile-astro-blocks.mjs (Container API) компилит
//     этот .astro в dist/astro-blocks/theme-vanilla__Catalog__Catalog.mjs.
//
// Все импорты — siblings (./), без bare-NPM и ../../ (компилятор превью их не
// резолвит). Корневой <section> чистый: оркестратор превью штампует на него
// data-puck-component-id для выделяемости.
//
// ⚠️ Клиент — ТОЛЬКО is:inline (НЕ module-script): module client-<script> блока НЕ
// компилится в live build (generatePuckCatalogPage импортит блок, но ESM-script не
// попадает в bundle → 404 на проде). Поэтому весь клиент инлайн телами (без import).
// У vanilla НЕТ фильтра по цвету (в отличие от rose) — секции «Цвет» нет.
// Заголовок/подзаголовок каталога мерчант вводит кнопками «Ж»/«К» — Astro
// экранирует {value}, и начертание печаталось сырыми тегами в тексте
// (баг-репорт тестера 2026-09-13, K4). Рендерим через XSS-safe inlineFormat.
import { inlineFormat } from "./rich-text";
import VanillaCatalogFilterSidebar from "./VanillaCatalogFilterSidebar.astro";
import VanillaFiltersSheet from "./VanillaFiltersSheet.astro";
import {
	CATALOG_PRICE_ROW,
	CATALOG_PRICE_VALUE,
	CATALOG_PRICE_WRAP,
	CATALOG_RADIO_CIRCLE,
	CATALOG_RADIO_TEXT,
} from "./filter-classes";

// Совместимый с theme-base/blocks/Catalog/Catalog.puckConfig props-минимум.
// Лишние поля puckConfig (cards/productCard/colorScheme и т.п.) принимаем, но
// родная вёрстка использует только заголовок/подзаголовок/раскладку фильтра.
interface Props {
	id?: string;
	siteId?: string;
	categoryTitle?: string | { text?: string };
	categorySubtitle?: string | { text?: string };
	subtitle?: boolean | "true" | "false";
	filterPosition?: "top" | "side";
	showFilter?: boolean | "true" | "false";
	showSort?: boolean | "true" | "false";
	columns?: number;
	/** «Карточки» — сколько товаров на одну «страницу» пагинации (2..24). */
	cards?: number;
	/** «Отступы» секции. Нет пропа = отступы вёрстки (py-16 md:py-20). */
	padding?: { top?: number; bottom?: number };
	colorScheme?: string;
	/** «Цветовая схема контейнера» — схема внутренней обёртки каталога. */
	containerColorScheme?: string;
	/** Под-настройки «Карточка товара» конструктора (общая Puck-схема). */
	productCard?: {
		cardBackground?: boolean | "true" | "false";
		/** «Стиль (аспект фото)»: square 1:1 · portrait 318/444 · landscape 4/3. */
		cardStyle?: string;
		/** «Быстрое добавление»: none — кнопки нет; standard/cart — кнопка в карточке. */
		quickAdd?: string;
		quickAddText?: string;
		/** «Стиль кнопки» быстрого добавления: primary (заливка) · outlined (обводка). */
		buttonStyle?: string;
		/** «Следующее фото при наведении»: наведение на карточку показывает images[1]. */
		nextPhoto?: boolean | "true" | "false";
	};
	/** Настройка «Выбор коллекции» конструктора (страница page-collection).
	    Приходит как slug/id выбранной коллекции; null/пусто → весь каталог. */
	collectionSlug?: string | null;
}

const {
	id,
	siteId,
	categoryTitle,
	categorySubtitle,
	subtitle,
	filterPosition,
	showFilter,
	showSort,
	columns,
	cards,
	padding,
	colorScheme,
	productCard,
	collectionSlug,
} = Astro.props as Props;

// «Контейнер» карточки (Figma 1:34185-34635, productCard.cardBackground,
// дефолт 'false'). true → контент с внутренним отступом 12px (фото/текст inset),
// карточка получает собственный фон (--vanilla-card). false (дефолт) → флеш к
// краям (фото full-bleed, текст у левого края) — текущая родная вёрстка vanilla.
// Нормализуем рядом с прочими настройками карточки, как в base Catalog.astro.
const _cardBgRaw = productCard?.cardBackground;
// «Контейнер» карточки убран из панели (владелец 23.09) — «С контейнером» больше не включается; прошлое значение из ревизии не читаем.
// Не задано → фирменный вид темы (cardContainerAuto), как и раньше.
const cardContainerOn = false;
// Трёхпозиционность (как в theme-base): блок явно выключил → плашки нет; явно
// включил → плашка блока; НЕ ЗАДАНО → решает ТЕМА («Настрой свою тему» →
// «Карточка: стиль»), то есть токены --product-card-*. Без них токены равны
// нулю/прозрачному, поэтому вид вёрстки не меняется.
const cardContainerAuto = _cardBgRaw === undefined || _cardBgRaw === null || _cardBgRaw === "";
// Клиентская карточка: arbitrary-классы Tailwind в строках JS не компилируются
// (см. гочу у cardChromeStyle), поэтому темовый хром и радиус фото идут inline.
const cardThemeChromeStyle = cardContainerAuto
	? "border-radius:var(--product-card-radius,0px);background:var(--product-card-bg,transparent);padding:var(--product-card-padding,0px);"
	: "";
const cardMediaRadiusStyle = "border-radius:var(--product-card-media-radius,0px);";
// Класс-обёртка карточки (article): с контейнером добавляем фон+скругление+
// padding 12px → весь контент (фото, заголовок, цена) уезжает inset. У vanilla
// нет кнопки «В корзину» в карточке, поэтому единственная разница состояний —
// внутренний отступ 12px. Без контейнера — только flex-колонка (флеш, дефолт).
const cardWrapClass = cardContainerOn
	? "group flex flex-col gap-3 rounded-[12px] bg-[var(--vanilla-card)] p-3"
	: cardContainerAuto
		? "group flex flex-col gap-3 rounded-[var(--product-card-radius,0px)] bg-[var(--product-card-bg,transparent)] p-[var(--product-card-padding,0px)]"
		: "group flex flex-col gap-3";

// Кол-во товаров на «страницу» пагинации: настройка «Карточки» (cards, 2..24).
// Без пропа — прежнее поведение вёрстки: columns*3 (3 ряда) или 12.
const colsNum = Number(columns);
const cardsNum = Number(cards);
const pageSize = Number.isFinite(cardsNum) && cardsNum > 0
	? Math.max(2, Math.min(24, cardsNum))
	: Number.isFinite(colsNum) && colsNum > 0
		? colsNum * 3
		: 12;

// «Колонки» (desktop ≥1280) — числом через CSS-переменную, как у flux: Tailwind
// arbitrary-класс `lg:grid-cols-[repeat(var())]` не генерится @source-сканом
// превью, поэтому правило живёт в <style> секции и читает --vanilla-cols.
// Mobile/планшет остаются на классах вёрстки (1/2/3 колонки).
const colCount = Math.max(2, Math.min(6, Number.isFinite(colsNum) && colsNum > 0 ? colsNum : 3));

// «Отступы» секции. Проп отсутствует = отступы вёрстки (py-16 md:py-20 классами);
// заданное значение применяется честно инлайном и перебивает классы.
const containerStyle =
	(padding ? `padding-top:${padding.top ?? 0}px;padding-bottom:${padding.bottom ?? 0}px;` : "") +
	`--vanilla-cols:${colCount};`;

// Отдельной «цветовой схемы контейнера» больше нет: тестировщик 14.09
// (санкционировано владельцем) — «цветовая схема одна для всей секции».
// Проп containerColorScheme остаётся в Props ради старых ревизий, но в
// разметку не попадает: обёртка наследует схему секции.

// «Стиль (аспект фото)» карточки: square 1:1 (канон vanilla) · portrait 318/444 ·
// landscape 4/3. Нет пропа = канон вёрстки.
// Скругление фото карточки — токен темы («Медиа → Скругление» / «Карточка: стиль»).
// Фолбэк 0px = прямые углы вёрстки vanilla.
const cardMediaRadiusCls = "rounded-[var(--product-card-media-radius,0px)]";
const cardAspectClass =
	productCard?.cardStyle === "portrait" || productCard?.cardStyle === "auto"
		? "aspect-[318/444]"
		: productCard?.cardStyle === "wide"
			? "aspect-[4/3]"
			: "aspect-square";

// «Следующее фото при наведении» (productCard.nextPhoto). Панель показывает эту
// настройку во всех пяти темах, а vanilla её не читала вовсе — переключатель
// ничего не делал (аудит 22.09: 0 упоминаний в порте против 8–14 у остальных).
const nextPhotoOn = productCard?.nextPhoto === "true" || productCard?.nextPhoto === true;
// Как именно листается фото — черта ТЕМЫ, не настройка. Владелец 23.09: bloom
// и vanilla листают, как на Авито (курсор по ширине фото перебирает ВСЕ фото
// товара), остальные темы показывают второе фото. Так же устроена карточка в
// вёрстке vanilla (VanillaProductCard: зоны по ширине фото). Выбора режима в
// панели нет, поэтому `productCard.nextPhotoMode` из ревизии не читается: там
// лежит подставленный конструктором дефолт, а не выбор мерчанта.
const nextPhotoMode = "zones";

// «Быстрое добавление»: 'none' (или отсутствие пропа) = канон вёрстки vanilla —
// кнопки в карточке нет. Любое другое значение показывает кнопку.
const quickAddMode = typeof productCard?.quickAdd === "string" ? productCard.quickAdd : "none";
const quickAddOn = quickAddMode !== "none" && quickAddMode !== "false";
const quickAddLabel =
	typeof productCard?.quickAddText === "string" && productCard.quickAddText.trim()
		? productCard.quickAddText
		: "В КОРЗИНУ";
// «Стиль кнопки»: secondary/outlined — обводка на белом; primary (дефолт) — заливка.
const quickAddOutlined =
	productCard?.buttonStyle === "secondary" || productCard?.buttonStyle === "outlined";
const quickAddClass = quickAddOutlined
	? "mt-1 inline-flex h-11 min-h-11 w-full items-center justify-center rounded-[var(--radius-button,0px)] border border-[var(--vanilla-header-bg)] bg-white px-4 font-vanilla-arsenal text-sm font-normal uppercase leading-none text-[var(--vanilla-header-bg)] transition-opacity hover:opacity-70"
	: "mt-1 inline-flex h-11 min-h-11 w-full items-center justify-center rounded-[var(--radius-button,0px)] bg-[var(--vanilla-header-bg)] px-4 font-vanilla-arsenal text-sm font-normal uppercase leading-none text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-90";

// Заголовок/подзаголовок: aiText в puck может быть строкой или { text }.
function pickText(v: unknown, fallback: string): string {
	if (typeof v === "string" && v.trim()) return v;
	if (v && typeof v === "object") {
		const t = (v as { text?: string }).text;
		if (typeof t === "string" && t.trim()) return t;
	}
	return fallback;
}
const title = pickText(categoryTitle, "Каталог");
const subtitleText = pickText(categorySubtitle, "");
const subtitleVisible = subtitle !== "false" && subtitle !== false && subtitleText.trim().length > 0;
const filterVisible = showFilter !== "false" && showFilter !== false;
const sortVisible = showSort !== "false" && showSort !== false;

// Родная раскладка vanilla = side. filterPosition='top' переключает на top.
const defaultLayout = filterPosition === "top" ? "top" : "side";

// Цветовая схема секции (hot-swap токенов как у остальных блоков).
const schemeClass =
	typeof colorScheme === "string" && colorScheme
		? `color-scheme-${colorScheme.replace("scheme-", "")}`
		: "";

// Demo-товары vanilla (родные моки). Больше НЕ в видимом гриде — видимый грид
// стартует со СКЕЛЕТОН-лоадером (skeletons ниже), а demo уходит в
// <template data-nt="catalog-demo"> и подставляется is:inline-клиентом ТОЛЬКО если
// магазин реально пуст / API недоступен (rose-канон). На published-сайте клиент
// (renderCatalog → ЖИВОЙ /api/store/products) заменяет скелетон реальными товарами.
// Заглушки ПЛАТФОРМЫ для пустого магазина (свитеры из packages/theme-base/public/
// placeholders — те же, что показывает эталонный theme-base/blocks/Catalog).
// Демо-товаров верстальщика в каталоге больше нет ни в каком состоянии: витрина
// показывает либо реальные товары, либо эти заглушки, либо текстовое сообщение.
const PLACEHOLDER_IMAGES = [
	"/placeholders/sweater-blue.svg",
	"/placeholders/sweater-yellow.svg",
	"/placeholders/sweater-red.svg",
	"/placeholders/sweater-green.svg",
];
const placeholderCards = Array.from({ length: pageSize }, (_, i) => ({
	image: PLACEHOLDER_IMAGES[i % PLACEHOLDER_IMAGES.length],
}));
// Лоадер: число скелетон-карточек, показываемых пока идёт fetch живого API (одна
// «страница» пагинации). Demo-моки больше НЕ в видимом гриде — они уходят в
// <template data-nt="catalog-demo"> и подставляются клиентом ТОЛЬКО если магазин
// реально пуст (rose-канон). Сами гриды стартуют с opacity:0 (loading-гейт);
// renderCatalog раскрывает их (opacity:1) после рендера скелетон→реальные/demo.
const skeletonCount = pageSize;
const skeletons = Array.from({ length: skeletonCount });

function pluralizeProducts(count: number): string {
	const mod10 = count % 10;
	const mod100 = count % 100;
	if (mod100 >= 11 && mod100 <= 14) return `${count} товаров`;
	if (mod10 === 1) return `${count} товар`;
	if (mod10 >= 2 && mod10 <= 4) return `${count} товара`;
	return `${count} товаров`;
}
// Счётчик до гидрации: пока идёт первый запрос показывать выдуманное число
// нельзя — начинаем с нуля, клиент подставит настоящий total.
const productCountLabel = pluralizeProducts(0);

// Summary/панель дропдаунов top-вида (манера vanilla: плоские панели, фон страницы).
// Шрифт строки — из «Настроек темы» (catalog-filters.css ставит его корню строки).
const rowSummaryClass =
	"flex cursor-pointer list-none items-center gap-2 text-base leading-none text-[rgb(var(--color-text,0_0_0))] transition-opacity hover:opacity-70 [&::-webkit-details-marker]:hidden";
const rowPanelClass =
	"absolute top-full z-30 mt-2 flex w-[240px] flex-col gap-3 border border-[rgb(var(--color-muted,153_153_153))] bg-[rgb(var(--color-bg,238_238_238))] p-4";

interface RadioOption {
	value: string;
	label: string;
	checked?: boolean;
}
const rowSortOptions: RadioOption[] = [
	{ value: "popularity", label: "По популярности", checked: true },
	{ value: "new", label: "По новизне" },
	{ value: "price-desc", label: "По убыванию цены" },
	{ value: "price-asc", label: "По возрастанию цены" },
];
const rowStockOptions: RadioOption[] = [
	{ value: "all", label: "Все", checked: true },
	{ value: "in", label: "В наличии" },
	{ value: "out", label: "Распродано" },
];

// Разметка SSR-карточки демо-товара — зеркалит renderCardHtml клиента (vanilla card:
// aspect-square, font-vanilla-arsenal). Плоский <img> (без VanillaPicture/carousel —
// избегаем ../../ резолв-барьера компилятора превью; на live грид перерисует клиент).
// КРАСКА КАТАЛОГА — роли СХЕМЫ вместо палитры Tailwind. Было `text-black` у
// заголовка, счётчика товаров и имени/цены карточек и `text-white` у надписи
// кнопки «Показать ещё». Tailwind 4 печатает эти классы как
// var(--color-black)/var(--color-white): переменная ЕСТЬ, но её нет ни в одной
// схеме мерчанта, поэтому мишени замирали при любой схеме. Замер матрицы
// (`pnpm scheme-matrix:bad`, схемы-зонды 1 → 4): #000 → #000 и #fff → #fff.
// Роли: заголовок → «Заголовок», счётчик и карточка → «Текст» (тот же токен и
// тот же фолбэк 38_49_28, что у карточки Popular.astro этой темы после fix
// b19), надпись кнопки → «Текст кнопки» (заливка кнопки сидит на алиасе темы
// --vanilla-header-bg — вердикт theme-var, чужой срез; надпись и заливка
// поедут парой, когда алиас переведут). Фолбэки = прежний вид.
// Сторож: pnpm test:scheme-targets.
---

<section
	class={schemeClass}
	data-block="catalog"
	data-catalog-page
	data-puck-component-id={id}
	data-site-id={siteId}
	data-nt="vanilla-catalog-section"
	aria-labelledby="catalog-title"
	data-catalog-layout={defaultLayout}
	data-card-bg={cardContainerOn ? "true" : "false"}
	data-next-photo-mode={nextPhotoMode}
	data-collection-slug={collectionSlug ?? ""}
	data-page-size={pageSize}
>
	{/* Раскладка каталога из настройки конструктора: платформа (превью-контроллер и
	    билд) инжектит window.__MERFY_CATALOG_LAYOUT__. Скрипт ДО вариантов, чтобы
	    переключение не мигало; без глобала остаётся раскладка из props. */}
	<script is:inline>var l=window.__MERFY_CATALOG_LAYOUT__; if(l==='top'||l==='side'){document.currentScript.parentElement.setAttribute('data-catalog-layout',l);}</script>

	{/* Заглушки темы для ПУСТОГО магазина (0 товаров) и для каталога коллекции,
	    где коллекция ещё не выбрана. НЕ в видимом гриде (там скелетон-лоадер),
	    хранятся скрытыми и подставляются клиентом ТОЛЬКО в этих двух случаях.
	    Это платформенные карточки (свитер + «Товар» + «2 500 ₽»), а НЕ демо-товары
	    верстальщика: как только у магазина появляется хотя бы один товар, в каталоге
	    не должно быть ни одной заглушки ни при каких фильтрах. */}
	<template data-nt="catalog-placeholder">
		{placeholderCards.map((card) => (
			<li data-nt="catalog-placeholder-card" aria-hidden="true">
				<div class="flex flex-col gap-3">
					<div class={`relative ${cardAspectClass} ${cardMediaRadiusCls} w-full overflow-hidden bg-[var(--vanilla-card)]`}>
						<img src={card.image} alt="" loading="lazy" style="position:absolute;left:20%;top:20%;width:60%;height:60%;object-fit:contain;" />
					</div>
					<div class="flex flex-col gap-1">
						<span class="font-vanilla-arsenal text-base font-normal leading-none text-[rgb(var(--color-text,38_49_28))]">Товар</span>
						<span class="font-vanilla-arsenal text-base font-normal leading-none text-[rgb(var(--color-text,38_49_28))]">2 500 ₽</span>
					</div>
				</div>
			</li>
		))}
	</template>

	<div class="vanilla-pad w-full bg-[var(--vanilla-surface)] py-16 md:py-20" style={containerStyle}>
		{/* Контейнер каталога схемы не имеет: секция красится ОДНОЙ схемой
		    (тестировщик 14.09, санкционировано владельцем). Обёртка прозрачная —
		    заливку держит vanilla-pad выше. */}
		<div class="vanilla-container flex flex-col gap-10">
			<header class="flex flex-col gap-2">
				<h1
					id="catalog-title"
					class="font-vanilla-bitter text-[20px] font-normal italic leading-none tracking-normal text-[rgb(var(--color-heading,10_10_10))]"
					set:html={inlineFormat(title)}
				></h1>
				{subtitleVisible && (
					<p class="font-vanilla-arsenal text-base font-normal leading-none text-[#444444]" set:html={inlineFormat(subtitleText)}></p>
				)}
			</header>

			{/* ── Раскладка «top»: фильтры/сортировка строкой над гридом ── */}
			<div class="flex flex-col gap-10" data-catalog-variant="top">
				{/* Телефон и планшет (< lg), как в вёрстке vanilla: кнопка «Фильтры и
				    сортировка» и шторка с сайдбаром. Строку сверху там прячет общий
				    catalog-filters.css по data-filters-sheet-below="lg". */}
