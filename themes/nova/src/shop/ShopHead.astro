---
// Договор рисовальщика (блок 4, SEO): всё индексируемое пишет сборка в HTML — язык (у <html> страницы), заголовок,
// описание, канонический адрес. Конфиг магазина (блок 3) и CSS токенов с правками мерчанта (блок 1) приходят от
// сборщика готовыми строками и встают одним проходом, без правки готового HTML.
// Описание и ключевые слова мерчант может не заполнить — тогда тега нет совсем, как у Dawn (Shopify): пустой тег —
// ошибка договора. Теги для соцсетей (блок 9) — по тем же правилам: описания или логотипа нет — нет og:description
// или og:image. Код секций (блок 7) приходит так же, готовой строкой: после токенов — стили секций, список
// модулей, import map, подсказки и ядро (поле codeHtml головы).
import type { ShopPageHead } from "../../../../packages/storefront-build/src/locals";

interface Props {
	head: ShopPageHead;
}

const { head } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Fragment set:html={head.configHtml} />
<title>{head.title}</title>
{head.description && <meta name="description" content={head.description} />}
{head.keywords && <meta name="keywords" content={head.keywords} />}
<link rel="canonical" href={head.canonical} />
<meta property="og:type" content={head.social.type} />
<meta property="og:title" content={head.title} />
{head.description && <meta property="og:description" content={head.description} />}
<meta property="og:url" content={head.canonical} />
<meta property="og:site_name" content={head.social.siteName} />
<meta property="og:locale" content={head.social.locale} />
{head.social.image && <meta property="og:image" content={head.social.image} />}
<meta name="twitter:card" content={head.social.card} />
{head.fontPreload && <link rel="preload" href={head.fontPreload} as="font" type="font/woff2" crossorigin />}
<style id="merfy-base" is:inline set:html={head.baseCss}></style>
<style id="merfy-fonts" is:inline set:html={head.fontsCss}></style>
<style id="merfy-tokens" is:inline set:html={head.tokensCss}></style>
<Fragment set:html={head.codeHtml} />
