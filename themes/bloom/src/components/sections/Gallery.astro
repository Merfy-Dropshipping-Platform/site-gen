---
import { inlineFormat } from "../../lib/rich-text";
// ОЖИВЛЕНИЕ (Фаза B, контракт rose Gallery T13): конструкторная схема
// theme-base Gallery.puckConfig поверх разметки верстальщика. Тело + канон-
// дефолты (headingSize/textSize medium, imagePosition left) → пиксель
// верстальщика. Плитка БЕЗ выбора рендерит ПЛЕЙСХОЛДЕР СВОЕГО ТИПА по контракту
// Figma 1:19335 (паритет theme-base PopularProducts/Collections): изображение —
// landscape-gallery, товар — куртка blue + «Товар»/«2 500 ₽», коллекция — пустой
// бокс + «Выбери коллекцию» (НЕ мок-демо верстальщика). Данные ВЫБРАНЫ →
// реальный рендер + гидрация по коллекции БЕЗ изменений.
const p = Astro.props as Record<string, any>;
const id = p.id;
// Своя colorScheme на корне секции: при hot-render одиночного блока в превью
// обёртки композитора НЕТ, и секция берёт :root — соседние секции «перекрашиваются»
// от правки чужой настройки. На live обёртка даёт ту же схему, дубль безвреден
// (паттерн rose Footer / theme-base Video).
// colorScheme приходит строкой ("scheme-4") ИЛИ числом (нормализатор Slideshow
// приводит к номеру) — разбираем оба вида, иначе класс молча не ставится.
const _rawScheme = p.colorScheme;
const _schemeId =
	typeof _rawScheme === "number"
		? String(_rawScheme)
		: typeof _rawScheme === "string" && _rawScheme
			? String(_rawScheme).replace("scheme-", "")
			: "";
const selfSchemeClass = _schemeId ? ` color-scheme-${_schemeId}` : "";
// Пустая строка = «мерчант не задал» (так же трактует платформа,
// render/empty-state.ts) → показываем заглушку, а не пустой заголовок.
const sectionTitle =
	((typeof p.heading === "string" ? p.heading : p.heading?.text) ?? p.title)?.trim() ||
	"Галерея";
// Подзаголовка у верстальщика НЕТ — рендер ТОЛЬКО при непустом пропе.
const rawSubtitle =
	(typeof p.text === "string" ? p.text : p.text?.content) ??
	(typeof p.subtitle === "string" ? p.subtitle : undefined);
const sectionSubtitle =
	typeof rawSubtitle === "string" && rawSubtitle.trim() ? rawSubtitle : undefined;

// Куртка-плейсхолдер empty-state доступна на live как /placeholders/sweater-blue.svg
// (copyPublic theme-base/public в assemble-from-packages.ts; bloom уже ссылается
// на этот путь — BloomProductDetail.astro). object-contain + padding, паритет
// theme-base PopularProducts DEMO_PRODUCTS.
const PLACEHOLDER_SWEATER_BLUE = "/placeholders/sweater-blue.svg";
// Большая плитка галереи в пустом состоянии (Figma 1:19335): дизайн-ассет
// landscape-gallery.png (раздаётся на каждой теме из packages/theme-base/public/
// placeholders, copyPublic) — НЕ пустая surface и НЕ мок-фото верстальщика
// (контракт картиночных секций, эталон rose/vanilla Gallery.astro).
const PLACEHOLDER_GALLERY_IMAGE = "/placeholders/landscape-gallery.png";

// Канон headingSize (top-level приоритетнее legacy heading.size): 'medium'
// (canon-default) и отсутствие = роль «заголовок секции» верстальщика дословно
// (18/md:20). Лестница §9: small 15/17, large 22/24.
// Панель пишет размер в top-level `headingSize` (select), поле `heading` = aiText-строка.
// Читаем top-level ПЕРВЫМ: в старых ревизиях мог остаться legacy-объект heading.size,
// и nested-first молча глушил живой селект панели. Паритет rose (precedence "top-level").
const headingSize = p.headingSize ?? p.heading?.size;
const headingCls =
	headingSize === "small"
		? "font-urbanist text-[15px] font-normal leading-none text-[rgb(var(--color-heading,227_142_159))] md:text-[17px]"
		: headingSize === "large"
			? "font-urbanist text-[22px] font-normal leading-none text-[rgb(var(--color-heading,227_142_159))] md:text-[24px]"
			: "font-urbanist text-[18px] font-normal leading-none text-[rgb(var(--color-heading,227_142_159))] md:text-[20px]";
// Канон textSize: 'medium' (canon-default) и отсутствие = body-роль манеры
// (Inter 300 16px, §9: small 14, large 19).
const textSize = p.textSize ?? p.text?.size;
const subtitleCls =
	textSize === "small"
		? "font-inter text-[14px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))]"
		: textSize === "large"
			? "font-inter text-[19px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))]"
			: "font-inter text-[16px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))]";

// Канон imagePosition left/right: 'left' (canon-default) и отсутствие = большая
// квадратная плитка слева (пиксель верстальщика); 'right' → зеркало раскладки
// lg:grid-cols-2 через order.
const mirror = p.imagePosition === "right";
const heroOrderCls = mirror ? " lg:order-2" : "";
const sideOrderCls = mirror ? " lg:order-1" : "";

// Канон items[] (≤3, типы image/product/collection): плитки из пропсов с
// fallback на две плитки верстальщика ДОСЛОВНО. SSR рендерит канон-плейсхолдеры
// («Товар» 2 500 ₽ / «Выбери коллекцию»); резолв productId/collectionId→имя/
// цена/картинка делает гидрация ниже (data-gallery-product/-collection):
// live — /data/{products,collections}.json, превью — storefront-data.
type GalleryTile = {
	kind: "image" | "product" | "collection";
	url: string;
	alt: string;
	label: string;
	price: string;
	href: string;
	ref: string | null;
	placeholder?: boolean;
};
const galleryTiles: GalleryTile[] = (Array.isArray(p.items) ? p.items : [])
	.filter((x: any) => x && typeof x === "object")
	// Канон — три плитки (владелец, 2026-09-13). Режем ЗДЕСЬ, а не в zod-схеме:
	// ревизия с четырьмя и больше (данные суток с поднятым потолком c46a9d9e)
	// обязана разбираться целиком, лишние плитки просто не рисуются.
	.slice(0, 3)
	.map((it: any): GalleryTile => {
		if (it.type === "product") {
			const pid = typeof it.productId === "string" && it.productId ? it.productId : null;
			return {
				kind: "product",
				url: "",
				alt: "Товар",
				label: "Товар",
				price: "2 500 ₽",
				href: pid ? `/product?id=${encodeURIComponent(pid)}` : "/catalog",
				ref: pid,
			};
		}
		if (it.type === "collection") {
			const cid = typeof it.collectionId === "string" && it.collectionId ? it.collectionId : null;
			return {
				kind: "collection",
				url: "",
				alt: "Коллекция",
				label: "Выбери коллекцию",
				price: "",
				href: cid ? `/catalog?collection=${encodeURIComponent(cid)}` : "/catalog",
				ref: cid,
			};
		}
		return {
			kind: "image",
			url: typeof it.url === "string" ? it.url : "",
			alt: typeof it.alt === "string" ? it.alt : "",
			label: "",
			price: "",
			href: "/catalog",
			ref: null,
		};
	});
// Items-path (мерчант ДОБАВИЛ плитки в конструкторе = «данные выбраны»):
// плитка без url служит SSR-якорем под гидрацию реальной сущности
// (data-gallery-product/-collection → имя/цена/картинка из products/collections).
// Этот путь рендера/гидрации НЕ трогаем.
const TILE_FALLBACKS = ["/images/balaklava.webp", "/images/milk.webp", "/images/trend-1.webp"];
// Плитки рендерятся ПО ПРОПСАМ, а не по гейту «есть контент / нет контента»: у
// плитки без выбора свой плейсхолдер по типу. Поэтому удаление и добавление
// параметра сразу видно и в конструкторе, и на витрине (баг-репорт владельца);
// при дефолтных трёх элементах картинка та же, что у прежнего захардкоженного
// пустого состояния (Figma 1:19335).
galleryTiles.forEach((t) => {
	if (t.url) return;
	if (t.kind === "image") {
		t.url = PLACEHOLDER_GALLERY_IMAGE;
		t.placeholder = true;
	} else if (t.kind === "product") {
		t.url = PLACEHOLDER_SWEATER_BLUE;
		t.placeholder = true;
	}
});
// Куртка-плейсхолдер вписывается в бокс (object-contain), реальное фото — кроп.
const fitCls = (t: GalleryTile, hover: string) =>
	t.placeholder && t.kind === "product" ? "object-contain p-[12%]" : `object-cover ${hover}`;
// Плитка с выбранной коллекцией: адрес фото приходит только с гидрацией
// (data-gallery-collection), поэтому <img> рисуется заранее скрытым — гидрации
// есть куда положить фото. Без него фото коллекции не вставало (тестер 24.09).
const awaitsCover = (t: GalleryTile) => t.kind === "collection" && Boolean(t.ref) && !t.url;
const heroTile = galleryTiles[0];
const sideTiles = galleryTiles.slice(1);
// Одна видимая плитка занимает всю ширину секции — иначе она жмётся в свою
// половину рядом с пустотой.
const soloTile = galleryTiles.length === 1;
// Колонки НЕ пополам (ориентир — rose, владелец 2026-09-15). Справа стопка из
// почти квадратных плиток 652/594 с подписями: при `lg:grid-cols-2` она вдвое
// выше квадратной большой плитки, и под большой зияла дыра (замер Chromium
// 1440px: разбег низов 656px против 0 у rose и flux). Узкая боковая колонка
// (rose: minmax(280px,429px)) выравнивает высоты: большая плитка тянется по
// строке и остаётся почти квадратной.
// PARITY_DESIGN (владелец 23.09: «как у верстальщиков, только стили»): отступы,
// зазоры и раскладка по актуальной вёрстке Bloom-theme @5aae2ad6. Признак ставит
// sites; без него — прежние классы.
const designParity = p.__designParity === true;
// Две плитки у верстальщиков: колонки пополам (lg:grid-cols-2), большая —
// квадрат по своей ширине, справа фото 652/594 с подписью. Три плитки
// (наш канон) — прежняя раскладка.
const pairLikeDesigners = designParity && sideTiles.length === 1;
const gridColsCls = mirror
	? "lg:grid-cols-[minmax(280px,429px)_minmax(0,1fr)]"
	: "lg:grid-cols-[minmax(0,1fr)_minmax(280px,429px)]";
// Владелец 25.09: «выравниваем» — низы обеих плиток пары на одной линии на
// всех ширинах, где они стоят рядом (было: items-start, боковая плитка
// короче квадрата на 38–58px, под ней пустое место). lg:items-stretch тянет
// боковую колонку до высоты строки (её задаёт квадрат — heroSizeCls ниже);
// SIDE_TILE.photo ниже забирает добавленную высоту ФОТО (flex-1,
// object-cover), а не пустотой под подписью.
const GRID_LAYOUT = {
	solo: { cols: "lg:grid-cols-1", stretch: " lg:items-stretch" },
	pair: { cols: "lg:grid-cols-2", stretch: " lg:items-stretch" },
	legacy: { cols: gridColsCls, stretch: " lg:items-stretch" },
}[soloTile ? "solo" : pairLikeDesigners ? "pair" : "legacy"];
const gridLayoutCls = GRID_LAYOUT.cols;
// Растянутая на всю ширину плитка не должна быть квадратом во весь экран.
// В паре с колонкой высоту большой плитке задаёт СТРОКА (`lg:h-full`), а не
// собственный аспект — иначе низы колонок не сходятся ни при каких данных
// (паритет rose `lg:min-h-0 lg:h-full`, flux `lg:aspect-auto lg:h-full`).
const heroSizeCls = soloTile
	? "aspect-[16/9]"
	: pairLikeDesigners
		? "aspect-square"
		: "aspect-square lg:aspect-auto lg:h-full lg:min-h-0";
// Подпись под фото плитки: у верстальщиков колонка gap-4 (16), у нас mt-5.
const captionMtCls = designParity ? "mt-4" : "mt-5";

// Боковая плитка ПАРЫ (pairLikeDesigners): низ обязан лечь на низ квадрата
// (владелец 25.09). Ссылка становится flex-колонкой во всю высоту строки
// (lg:h-full — высоту дал items-stretch на гриде выше), фото-бокс внутри
// растёт (lg:flex-1 lg:min-h-0, без своего аспекта) и забирает добавленную
// высоту ФОТО через object-cover (крой, не сплющивание) — подпись остаётся
// своего размера. Три плитки (LEGACY) и мобильная раскладка — байт-в-байт
// прежние: аспект-бокс 652/594, ссылка обычным block.
const SIDE_TILE = {
	pair: {
		anchor: " lg:flex lg:h-full lg:flex-col",
		photo:
			"relative aspect-[652/594] w-full lg:aspect-auto lg:min-h-0 lg:flex-1 overflow-hidden rounded-[var(--radius-media,12px)] bg-[rgb(var(--color-surface,245_245_245))]",
	},
	legacy: {
		anchor: "",
		photo:
			"relative aspect-[652/594] w-full overflow-hidden rounded-[var(--radius-media,12px)] bg-[rgb(var(--color-surface,245_245_245))]",
	},
}[pairLikeDesigners ? "pair" : "legacy"];

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе (паттерн rose T11).
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;
// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((Astro.props as any).hiddenFields)
	? ((Astro.props as any).hiddenFields as unknown[]).filter(
			(x): x is string => typeof x === 'string',
		)
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);

// PARITY_DESIGN (владелец 23.09: «как у верстальщиков, только стили»): отступы,
// зазоры и высота строк по актуальной вёрстке Bloom-theme @5aae2ad6. Настройки и
// цвета не меняются; без признака — прежние классы. Признак ставит sites.
---

<section
	id="gallery"
	class={`w-full bg-[rgb(var(--color-bg,255_255_255))] px-4 py-20 md:px-20 md:py-[120px] 2xl:px-[300px]${selfSchemeClass}`}
	aria-labelledby="gallery-title"
	data-puck-component-id={id}
	style={paddingStyle}
>
	<div class="mx-auto flex w-full max-w-[1320px] flex-col gap-10">
		{!isFieldHidden('heading') && (sectionSubtitle ? (
			<div
				data-animate
				class="flex flex-col gap-2"
				data-puck-subsection-parent={id}
				data-puck-subsection-index="100"
				data-puck-subsection-field="heading"
			>
				<h2 id="gallery-title" class={headingCls} set:html={inlineFormat(sectionTitle)}></h2>
				<p class={subtitleCls} set:html={inlineFormat(sectionSubtitle)} />
			</div>
		) : (
			<h2
				id="gallery-title"
				data-animate
				class={headingCls}
				data-puck-subsection-parent={id}
				data-puck-subsection-index="100"
				data-puck-subsection-field="heading"
				set:html={inlineFormat(sectionTitle)}
			></h2>
		))}

		<div class={`grid min-h-0 min-w-0 grid-cols-1 items-start gap-4${GRID_LAYOUT.stretch} ${gridLayoutCls}`} data-animate data-animate-delay="0.1s">
			{heroTile && (
				<a
					href={heroTile.href}
					class={`group relative block ${heroSizeCls} w-full min-w-0 overflow-hidden rounded-[var(--radius-media,12px)] bg-[rgb(var(--color-surface,245_245_245))]${heroOrderCls}`}
					aria-label={heroTile.alt || heroTile.label || "Перейти в каталог"}
					data-gallery-product={heroTile.kind === "product" ? (heroTile.ref ?? undefined) : undefined}
					data-gallery-collection={heroTile.kind === "collection" ? (heroTile.ref ?? undefined) : undefined}
					data-puck-subsection-parent={id}
					data-puck-subsection-index={0}
					data-puck-subsection-field="items"
				>
					{(heroTile.url || awaitsCover(heroTile)) && (
						<img
							src={heroTile.url || undefined}
							hidden={!heroTile.url}
							alt={heroTile.alt}
							loading="lazy"
							class={`absolute inset-0 size-full ${fitCls(heroTile, "transition-transform duration-500 ease-out group-hover:scale-[1.03]")}`}
						/>
					)}
				</a>
			)}

			{sideTiles.length > 0 && (
				<div class={`flex w-full min-h-0 min-w-0 flex-col ${designParity ? "gap-4" : "gap-5"}${sideOrderCls}`}>
					{sideTiles.map((tile, i) => (
						<a
							href={tile.href}
							class={`group block${SIDE_TILE.anchor}`}
							aria-label={tile.label || tile.alt || "Изображение"}
							data-gallery-product={tile.kind === "product" ? (tile.ref ?? undefined) : undefined}
							data-gallery-collection={tile.kind === "collection" ? (tile.ref ?? undefined) : undefined}
							data-puck-subsection-parent={id}
							data-puck-subsection-index={i + 1}
							data-puck-subsection-field="items"
						>
							<div class={SIDE_TILE.photo}>
								{(tile.url || awaitsCover(tile)) && (
									<img
										src={tile.url || undefined}
										hidden={!tile.url}
										alt={tile.alt}
										loading="lazy"
										class={`absolute inset-0 size-full ${fitCls(tile, "transition-transform duration-500 ease-out group-hover:scale-[1.05]")}`}
									/>
								)}
							</div>
							{(tile.label || tile.price) && (
								<div class={`${captionMtCls} flex flex-col gap-1`}>
									{tile.label && (
										<span
											class={
												tile.kind === "collection"
													? "gallery-collection-title font-inter text-[16px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))] transition-opacity group-hover:opacity-70"
													: "gallery-product-title font-inter text-[16px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))] transition-opacity group-hover:opacity-70"
											}
										>
											{tile.label}
										</span>
									)}
									{tile.price && (
										<span class="gallery-product-price font-inter text-[16px] font-light leading-normal text-[rgb(var(--color-text,0_0_0))]">
											{tile.price}
										</span>
									)}
								</div>
							)}
						</a>
					))}
				</div>
			)}
		</div>
	</div>
</section>

<script>
	import {
		loadRealProducts,
		loadRealCollections,
		findCollection,
		formatPrice,
		productHref,
		productImage,
	} from "../../lib/storefront-hydrate";

	// Резолв выбранных в конструкторе товара/коллекции на плитках галереи
	// (data-gallery-product / data-gallery-collection). SSR несёт канон-плейсхолдеры;
	// здесь подставляем имя/цену/картинку/ссылку реальной сущности. Без данных
	// (demo-сборка) — no-op.
	const hydrateGalleryTiles = async () => {
		const prodTiles = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-product]"));
		const colTiles = Array.from(document.querySelectorAll<HTMLElement>("[data-gallery-collection]"));
		if (prodTiles.length === 0 && colTiles.length === 0) return;
		const [products, collections] = await Promise.all([
			prodTiles.length ? loadRealProducts() : Promise.resolve(null),
			colTiles.length ? loadRealCollections() : Promise.resolve(null),
		]);
		for (const tile of prodTiles) {
			const ref = tile.getAttribute("data-gallery-product");
			const product = products?.find((x) => x.id === ref || x.slug === ref) ?? null;
			if (!product) continue;
			const title = tile.querySelector(".gallery-product-title");
			if (title && product.name) title.textContent = product.name;
			const price = tile.querySelector(".gallery-product-price");
			if (price) price.textContent = formatPrice(product.price);
			const img = tile.querySelector("img");
			const cover = productImage(product);
			if (img && cover) {
				img.setAttribute("src", cover);
				img.removeAttribute("hidden");
				img.parentElement?.removeAttribute("aria-hidden");
				if (product.name) img.setAttribute("alt", product.name);
			}
			tile.setAttribute("href", productHref(product));
			if (product.name) tile.setAttribute("aria-label", product.name);
		}
		for (const tile of colTiles) {
			const col = findCollection(collections, tile.getAttribute("data-gallery-collection"));
			if (!col) continue;
			const title = tile.querySelector(".gallery-collection-title");
			if (title && col.name) title.textContent = col.name;
			const cover = col.image || (Array.isArray(col.images) ? col.images[0] : "");
			const img = tile.querySelector("img");
			if (img && cover) {
				img.setAttribute("src", cover);
				img.removeAttribute("hidden");
				img.parentElement?.removeAttribute("aria-hidden");
				if (col.name) img.setAttribute("alt", col.name);
			}
			if (col.name) tile.setAttribute("aria-label", col.name);
			if (col.slug) tile.setAttribute("href", `/catalog?collection=${encodeURIComponent(col.slug)}`);
		}
	};

	hydrateGalleryTiles();
	document.addEventListener("astro:page-load", hydrateGalleryTiles);
</script>

