<!-- «Избранное» — страница /wishlist пяти старых тем, вид по умолчанию flux: заголовок с подзаголовком, скелетон на
     время чтения, сетка карточек на подложке (светлый фон поверхности, скругление карточки, внутренний отступ 12 px,
     название и цена внутри под фото — как замерено на проде), пустое состояние с кнопкой в каталог. Кнопки «В корзину»
     на карточке нет — ни у одной из пяти тем на проде. Карточки наполняет script.ts из ctx.favorites.$products;
     удаление из избранного — залитое сердце на карточке (favorites.toggle). Отступы и схема — обёртка секции. -->
<!-- Значки — Lucide (image, heart), лицензия ISC, lucide.dev/license. -->
<div class="mx-auto flex max-w-page flex-col gap-8 px-4 font-body text-foreground">
  <div class="flex flex-col gap-2">
    <h1 class="m-0 font-heading weight-heading tracking-heading text-3xl uppercase text-heading">Избранное</h1>
    <p class="m-0 text-base font-light text-muted-foreground md:text-lg" data-ref="subtitle">Товары, которые вам понравились</p>
  </div>
  <ul
    data-ref="skeleton"
    aria-hidden="true"
    class="m-0 grid list-none grid-cols-2 gap-x-grid-column gap-y-grid-row p-0 sm:grid-cols-3 lg:grid-cols-4"
  >
    <li class="flex flex-col gap-3">
      <div class="aspect-square w-full animate-pulse rounded-media bg-muted motion-reduce:animate-none"></div>
      <div class="h-5 w-2/3 animate-pulse rounded-input bg-muted motion-reduce:animate-none"></div>
      <div class="h-5 w-1/3 animate-pulse rounded-input bg-muted motion-reduce:animate-none"></div>
    </li>
    <li class="flex flex-col gap-3">
      <div class="aspect-square w-full animate-pulse rounded-media bg-muted motion-reduce:animate-none"></div>
      <div class="h-5 w-2/3 animate-pulse rounded-input bg-muted motion-reduce:animate-none"></div>
      <div class="h-5 w-1/3 animate-pulse rounded-input bg-muted motion-reduce:animate-none"></div>
    </li>
    <li class="hidden flex-col gap-3 sm:flex">
      <div class="aspect-square w-full animate-pulse rounded-media bg-muted motion-reduce:animate-none"></div>
      <div class="h-5 w-2/3 animate-pulse rounded-input bg-muted motion-reduce:animate-none"></div>
      <div class="h-5 w-1/3 animate-pulse rounded-input bg-muted motion-reduce:animate-none"></div>
    </li>
    <li class="hidden flex-col gap-3 lg:flex">
      <div class="aspect-square w-full animate-pulse rounded-media bg-muted motion-reduce:animate-none"></div>
      <div class="h-5 w-2/3 animate-pulse rounded-input bg-muted motion-reduce:animate-none"></div>
      <div class="h-5 w-1/3 animate-pulse rounded-input bg-muted motion-reduce:animate-none"></div>
    </li>
  </ul>
  <ul
    data-ref="cards"
    role="list"
    hidden
    class="m-0 grid list-none grid-cols-2 gap-x-grid-column gap-y-grid-row p-0 sm:grid-cols-3 lg:grid-cols-4"
  >
    <template>
      <li
        class="group/card relative flex h-full min-w-0 flex-col gap-3 rounded-card bg-muted p-3 md:gap-4"
      >
        <div class="contents" data-ref="card" data-available="true">
        <div class="relative">
          <a
            class="block aspect-square overflow-hidden rounded-media border-width-media border-border bg-muted shadow-media"
            href="/catalog"
            tabindex="-1"
            aria-hidden="true"
            data-ref="photo-link"
          >
            <img data-ref="image" alt="" class="size-full object-cover" />
            <span data-ref="no-image" class="flex size-full items-center justify-center text-muted-foreground" hidden>
              <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /></svg>
            </span>
          </a>
          <span data-ref="sale" class="absolute left-2 top-2 rounded-badge bg-sale px-2 py-1 text-xs text-sale-foreground md:left-3 md:top-3" hidden></span>
          <span data-ref="unavailable" class="absolute bottom-2 left-2 hidden rounded-badge bg-background px-2 py-1 text-xs text-foreground in-data-[available=false]:block md:bottom-3 md:left-3">Нет в наличии</span>
          <button
            type="button"
            class="group/heart absolute right-2 top-2 inline-flex size-11 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0 text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
            aria-pressed="true"
            aria-label="Убрать из избранного"
            data-ref="remove"
            data-action="favorites.toggle"
          >
            <span class="inline-flex size-9 items-center justify-center rounded-full bg-background/90 shadow-media">
              <svg class="size-5 fill-current text-sale" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" /></svg>
            </span>
          </button>
        </div>
        <div class="flex flex-1 flex-col gap-1">
          <a class="line-clamp-2 min-h-11 text-sm text-foreground no-underline hover:underline md:min-h-0 md:text-base" href="/catalog" data-ref="link">
            <span data-ref="title"></span>
          </a>
          <p class="m-0 flex flex-wrap items-baseline gap-x-2">
            <span class="text-sm text-price data-[discount=true]:text-sale md:text-base" data-ref="price"></span>
            <s data-ref="old-price" class="text-sm text-price-old" hidden></s>
          </p>
        </div>
        </div>
      </li>
    </template>
  </ul>
  <div data-ref="empty" class="flex flex-col items-center gap-4 py-10 text-center md:py-16" hidden>
    <p class="m-0 text-base text-muted-foreground md:text-lg">В избранном пока пусто</p>
    <a class="inline-flex h-12 items-center justify-center rounded-button border-width-button border-primary-border bg-primary px-6 text-sm text-primary-foreground no-underline shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground" href="/catalog">Перейти в каталог</a>
  </div>
</div>
