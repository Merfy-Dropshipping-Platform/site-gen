---
// Checkout page (bloom theme — Live Per-Theme Checkout).
//
// Composes the SHARED theme-base mega-blocks CheckoutForm + CheckoutSummary.
// Those blocks carry ALL live logic via inline scripts (DaData autocomplete in
// CheckoutDeliveryForm, СДЭК delivery in CheckoutDeliveryMethod, YooKassa in
// CheckoutPayment, submit-chain in CheckoutSubmit). They are token-driven, so
// they inherit bloom's colors. NO checkout-JS is rewritten here.
//
// Import mechanism: DIRECT relative import from packages/theme-base/blocks/.
// The block tree is fully self-contained (only sibling .astro + .classes value
// imports + type-only .puckConfig imports), so a relative path resolves the
// whole tree. astro.config.mjs adds vite.server.fs.allow = [workspaceRoot] so
// Vite can read files outside the themes/bloom project root.
//
// Plumbing: the block inline-scripts need window.cartStore + window.__MERFY_CONFIG__
// (+ optional window.__DADATA_TOKEN__). We load the templates' cart-api.js +
// cart-store.js (copied into public/scripts/) and inject config on this page only.
import Layout from "../layouts/Layout.astro";
import CheckoutForm from "../../../../packages/theme-base/blocks/CheckoutForm/CheckoutForm.astro";
import CheckoutSummary from "../../../../packages/theme-base/blocks/CheckoutSummary/CheckoutSummary.astro";

// Pilot defaults. In production build.service.ts string-patches shopId and
// injects DADATA_API_KEY; here we hardcode the apiUrl and leave shopId/dadataToken
// to be patched at build/deploy time (the injection script below reads them).
const shopId = "";
const apiUrl = "https://gateway.merfy.ru/api";
const dadataToken = "";
---
<Layout title="Оформление заказа" description="Оформление заказа" header="checkout">
  {/* Figma 1:13398 — оформление заказа ВСЕГДА на светлой палитре, независимо от
      схемы темы. Раньше здесь стояла `color-scheme-2`, но у темы это розовая
      акцентная схема — чекаут (и панель сводки) заливались розовым. Поэтому
      светлые токены задаём локально: правки цветов темы страницу не ломают, а
      кнопки/акценты продолжают брать `--color-button-*` из схемы магазина.
      Тот же приём применён к формам входа (AuthShell). */}
  <div
    class="checkout-scheme"
    style="
      --color-bg: 255 255 255;
      --color-text: 0 0 0;
      --color-heading: 0 0 0;
      --color-surface: 246 246 247;
      --color-muted: 138 138 138;
    "
  >
    <main class="flex-1 w-full" style="background: rgb(var(--color-bg)); color: rgb(var(--color-text));">
      {/* Figma 1:19998 — две панели: форма на фоне страницы, сводка на тонированной
          панели (--color-surface), которая уходит до правого края экрана. Обе панели
          в общем потоке, поэтому страница скроллится целиком, без отдельного скролла
          у сводки. Разметка/CSS — зеркало `wrapCheckoutGrid` в preview.service.ts,
          правки дублировать там же (live ↔ превью паритет). */}
      <div class="bloom-checkout-split">
        <div class="bloom-checkout-pane bloom-checkout-pane--form">
          <div class="bloom-checkout-pane__inner" data-checkout-column="form">
            <CheckoutForm />
          </div>
        </div>
        <div class="bloom-checkout-pane bloom-checkout-pane--summary">
          <div class="bloom-checkout-pane__inner" data-checkout-column="summary">
            <CheckoutSummary />
          </div>
        </div>
      </div>
    </main>
  </div>

  {/* --- Live checkout plumbing (checkout page only) --- */}
  {/* Config injection (templates pattern). build.service.ts patches shopId +
      DADATA_API_KEY at deploy; for the local pilot the script just has to exist. */}
  <script is:inline define:vars={{ shopId, apiUrl, dadataToken }}>
    window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || {
      shopId: shopId || "",
      apiUrl: apiUrl || "https://gateway.merfy.ru/api",
    };
    if (dadataToken) {
      window.__DADATA_TOKEN__ = dadataToken;
    }
  </script>
  {/* `is:inline` is REQUIRED — without it Astro bundles these through Vite, can't
      resolve `/scripts/...` (public dir) and SILENTLY drops the tag, leaving
      window.cartStore undefined → empty checkout. cart-store.js imports cart-api.js,
      so both are loaded as ES modules. */}
  <script is:inline type="module" src="/scripts/cart-api.js"></script>
  <script is:inline type="module" src="/scripts/cart-store.js"></script>
  <script is:inline>
    // Чекаут наполняет серверную корзину (cartStore) из nt-cart (bloom:cart:v1) —
    // источника истины того, что в корзине у пользователя. Товар виден при ЛЮБОМ
    // входе: «Купить сейчас»→/checkout, корзина→/checkout, прямой /checkout. Всё в
    // try/catch: при сбое деградирует к cartStore.init() (прежнее поведение).
    document.addEventListener("DOMContentLoaded", function () {
      var cs = window.cartStore;
      if (!cs) return;
      function fallbackInit() { try { if (cs.init) cs.init(); } catch (e) {} }
      var lines = [];
      // Express «Купить сейчас»: товар лежит в sessionStorage (НЕ в URL, НЕ в корзине
      // покупателя). Есть — оформляем ТОЛЬКО его; иначе — корзину (bloom:cart:v1).
      var bn = null;
      try { bn = JSON.parse(sessionStorage.getItem("bloom:buynow") || "null"); } catch (e) { bn = null; }
      if (bn && bn.productId) {
        lines = [{ productId: bn.productId, variant: { variantCombinationId: bn.variantCombinationId || null }, quantity: bn.quantity || 1 }];
      } else {
        try { lines = JSON.parse(localStorage.getItem("bloom:cart:v1") || "[]"); } catch (e) { lines = []; }
      }
      if (!Array.isArray(lines) || !lines.length || !cs.clear || !cs.addItem) { fallbackInit(); return; }
      (async function () {
        try {
          await cs.clear();
          for (var i = 0; i < lines.length; i++) {
            var l = lines[i];
            try { await cs.addItem(l.productId, (l.variant && l.variant.variantCombinationId) || null, l.quantity); } catch (e) {}
          }
        } catch (e) { fallbackInit(); return; }
        try { document.dispatchEvent(new CustomEvent("cart:updated")); } catch (e) {}
      })();
    });
  </script>
</Layout>

<style is:global>
	/* Сплит-раскладка оформления заказа. На узких экранах — стек (форма, затем
	   сводка), на десктопе — две панели во всю ширину: сводка тонирована и уходит
	   до правого края, контент обеих колонок сходится к центру. */
	.bloom-checkout-split {
		display: flex;
		flex-direction: column;
		width: 100%;
		background: rgb(var(--color-bg));
	}
	.bloom-checkout-pane {
		width: 100%;
		box-sizing: border-box;
	}
	.bloom-checkout-pane__inner {
		width: 100%;
		max-width: 540px;
		margin: 0 auto;
		padding: 32px 16px;
		min-width: 0;
		box-sizing: border-box;
	}
	.bloom-checkout-pane--summary {
		background: rgb(var(--color-surface));
	}
	@media (min-width: 1024px) {
		.bloom-checkout-split {
			flex-direction: row;
			align-items: stretch;
		}
		.bloom-checkout-pane {
			width: 50%;
			display: flex;
		}
		.bloom-checkout-pane--form {
			justify-content: flex-end;
		}
		.bloom-checkout-pane--summary {
			justify-content: flex-start;
		}
		.bloom-checkout-pane--form .bloom-checkout-pane__inner {
			margin: 0 0 0 auto;
			max-width: 446px;
			padding: 64px 28px 64px 24px;
		}
		.bloom-checkout-pane--summary .bloom-checkout-pane__inner {
			margin: 0 auto 0 0;
			max-width: 556px;
			padding: 64px 40px 64px 48px;
		}
	}
</style>
