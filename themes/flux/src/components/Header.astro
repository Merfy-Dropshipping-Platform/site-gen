	<!-- Поиск (Figma «Поиск» 1320×232): коробка выпадает ПОВЕРХ страницы под шапкой,
	     а не раздвигает её. Сверху строка поиска с линией, ниже — живые результаты
	     (общий модуль theme-base/runtime/header-search, вид — lib/header-search-view).
	     Цвета: строка поиска — Схема 1 (правило form[role="search"], решение
	     владельца 15.09 про поле и кнопку), коробка и выдача — схема шапки, как у
	     выпадающих меню. «Найти» и Enter по-прежнему ведут в каталог ?q=. -->
	<div
		data-search-panel
		class="absolute left-0 right-0 top-full z-40 hidden w-full"
		hidden
	>
		<div class={deskContainerBase}>
			<div
				data-header-search
				data-search-layout="panel"
				data-search-limit="9"
				class="flex w-full flex-col bg-[rgb(var(--color-bg,255_255_255))] shadow-[0_8px_24px_rgba(0,0,0,0.08)]"
			>
				<form role="search" action="/catalog" method="get" class="flex h-12 items-center justify-between gap-2 border-b border-[rgb(var(--color-button-bg,30_41_82))] pl-3 pr-1">
					<input
						type="search"
						name="q"
						placeholder="Поиск..."
						aria-label="Поиск"
						autocomplete="off"
						class="min-w-0 flex-1 bg-transparent font-roboto-flex text-[16px] font-light leading-[19px] placeholder:text-[rgb(var(--color-text,0_0_0)/0.4)] outline-none"
