---
const { settings, blocks, page, theme } = Astro.props;
---
<!-- Значки — Lucide (image, plus, minus, heart, chevron-down, sliders-horizontal, search-x), лицензия ISC, lucide.dev/license. -->
<!-- Фильтры — сворачиваемые группы (details и поведение accordion), вид flux: заголовок с шевроном и пункты-радио. Сбоку
     группы раскрыты, столбцом; сверху (rose, satin, bloom) — свёрнуты в ряд, раскрытая открывается панелью под заголовком,
     вне панели нажатие её закрывает (поведение catalog). В шторке телефона группы идут столбцом, как сбоку. -->
<div
  class="mx-auto grid max-w-page gap-6 px-4 font-body text-foreground data-[filters-side=true]:md:grid-cols-4 md:gap-8"
  data-behavior="catalog"
  data-paging={settings.paging}
  data-filters-side={blocks.some((item) => item.type === 'filters' && item.settings['filter-position'] === 'side') ? 'true' : 'false'}
>
  {(settings.heading || page.list) && (
    <div class="col-span-full flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
      {settings.heading && page.id === 'catalog' && (
        <h1 class="m-0 font-heading weight-heading tracking-heading text-3xl text-heading md:text-4xl" set:html={settings.heading} />
      )}
      {settings.heading && page.id !== 'catalog' && (
        <h2 class="m-0 font-heading weight-heading tracking-heading text-2xl text-heading md:text-3xl" set:html={settings.heading} />
      )}
      {page.list && page.list.total > 0 && <p class="m-0 text-sm text-muted-foreground">Товаров: {page.list.total}</p>}
    </div>
  )}
  {page.list && page.list.query.q && (
    <p class="col-span-full m-0 text-base text-muted-foreground">Результаты поиска: «{page.list.query.q}»</p>
  )}
  {page.list && blocks.some((item) => item.type === 'filters' || item.type === 'sort') && (
    <form class="m-0 min-w-0 md:in-data-[filters-side=true]:col-span-1 md:in-data-[filters-side=true]:self-start" data-part="filters" method="get" action={page.list.url}>
    <div class="contents" data-behavior="dialog" data-transition="drawer" data-side="left">
      <button type="button" data-part="open" class="inline-flex h-11 w-fit cursor-pointer items-center gap-2 bg-transparent p-0 text-sm text-foreground md:hidden">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 4h-7" /><path d="M10 4H3" /><path d="M21 12h-9" /><path d="M8 12H3" /><path d="M21 20h-5" /><path d="M12 20H3" /><path d="M14 2v4" /><path d="M8 10v4" /><path d="M16 18v4" /></svg>
        Фильтры и сортировка
      </button>
      <dialog
        class="my-0 ml-0 mr-auto h-full max-h-none w-5/6 max-w-none overflow-hidden border-0 bg-background p-0 font-body text-foreground shadow-drawer md:static md:m-0 md:block md:h-auto md:w-auto md:overflow-visible md:bg-transparent md:shadow-none"
        data-part="content"
      >
        <div class="flex h-full min-w-0 flex-col md:block md:h-auto">
          <div class="flex items-center justify-between gap-4 border-b border-border py-3 pl-4 pr-2 md:hidden">
            <h2 class="m-0 font-heading weight-heading text-lg text-heading">Фильтры и сортировка</h2>
            <button type="button" data-part="close" class="inline-flex size-11 cursor-pointer items-center justify-center rounded-button bg-transparent p-0 text-foreground hover:bg-accent hover:text-accent-foreground">
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
              <span class="sr-only">Закрыть</span>
            </button>
          </div>
          <div class="flex min-h-0 min-w-0 flex-1 flex-col gap-2 overflow-y-auto p-4 md:flex-none md:flex-row md:flex-wrap md:items-start md:gap-x-8 md:gap-y-4 md:overflow-visible md:border-b md:border-border md:p-0 md:pb-5 md:in-data-[filters-side=true]:flex-col md:in-data-[filters-side=true]:gap-y-6 md:in-data-[filters-side=true]:border-b-0 md:in-data-[filters-side=true]:pb-0">
      {page.list.query.q && <input type="hidden" name="q" value={page.list.query.q} />}
      <div class="contents" data-behavior="accordion">
      {blocks.map((block) => (
        <div
          class="flex min-w-0 flex-col gap-2 data-[type=subheading]:order-first data-[type=subheading]:w-full data-[type=sort]:-order-1 md:in-data-[filters-side=true]:gap-6 md:in-data-[filters-side=false]:data-[type=filters]:flex-row md:in-data-[filters-side=false]:data-[type=filters]:flex-wrap md:in-data-[filters-side=false]:data-[type=filters]:items-start md:in-data-[filters-side=false]:data-[type=filters]:gap-x-8 md:in-data-[filters-side=false]:data-[type=filters]:gap-y-4 md:in-data-[filters-side=false]:data-[type=sort]:order-last md:in-data-[filters-side=false]:data-[type=sort]:ml-auto"
          data-type={block.type}
        >
          {block.type === 'subheading' && block.settings.heading && (
            <p class="m-0 text-lg text-heading" set:html={block.settings.heading} />
          )}
          {block.type === 'sort' && (
            <details
              class="group/filter relative min-w-0"
              data-group="sort"
              open={blocks.some((item) => item.type === 'filters' && item.settings['filter-position'] === 'side')}
            >
              <summary class="flex h-11 cursor-pointer list-none items-center justify-between gap-2 text-base text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:h-auto md:min-h-6 md:in-data-[filters-side=false]:h-11 md:in-data-[filters-side=false]:justify-start">
                <span>Сортировать</span>
                <svg class="size-4 shrink-0 -rotate-90 text-muted-foreground transition-transform group-open/filter:rotate-0 motion-reduce:transition-none md:in-data-[filters-side=false]:rotate-0 md:in-data-[filters-side=false]:group-open/filter:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </summary>
              <div class="flex flex-col gap-1 pb-3 md:gap-3 md:pb-0 md:pt-3 md:in-data-[filters-side=false]:absolute md:in-data-[filters-side=false]:right-0 md:in-data-[filters-side=false]:top-full md:in-data-[filters-side=false]:z-20 md:in-data-[filters-side=false]:mt-1 md:in-data-[filters-side=false]:w-64 md:in-data-[filters-side=false]:rounded-card md:in-data-[filters-side=false]:border md:in-data-[filters-side=false]:border-border md:in-data-[filters-side=false]:bg-background md:in-data-[filters-side=false]:p-4 md:in-data-[filters-side=false]:shadow-drawer" data-part="content">
                {page.list.sorts.map((sort) => (
                  <label class="group/option flex min-h-11 cursor-pointer items-center gap-2 text-base text-muted-foreground has-checked:text-foreground md:min-h-6">
                    <input class="sr-only" type="radio" name="sort" value={sort.value} checked={sort.selected} />
                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full border-2 border-muted-foreground group-has-checked/option:border-foreground group-has-focus-visible/option:outline-2 group-has-focus-visible/option:outline-offset-2 group-has-focus-visible/option:outline-ring" aria-hidden="true">
                      <span class="size-2.5 rounded-full bg-foreground opacity-0 group-has-checked/option:opacity-100"></span>
                    </span>
                    <span>{sort.label}</span>
                  </label>
                ))}
              </div>
            </details>
          )}
          {block.type === 'filters' && page.list.facets && [block.settings['filter-position'] === 'side'].map((side) => (
            <Fragment>
              <details class="group/filter relative min-w-0" data-group="availability" open={side}>
                <summary class="flex h-11 cursor-pointer list-none items-center justify-between gap-2 text-base text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:h-auto md:min-h-6 md:in-data-[filters-side=false]:h-11 md:in-data-[filters-side=false]:justify-start">
                  <span>Наличие</span>
                  <svg class="size-4 shrink-0 -rotate-90 text-muted-foreground transition-transform group-open/filter:rotate-0 motion-reduce:transition-none md:in-data-[filters-side=false]:rotate-0 md:in-data-[filters-side=false]:group-open/filter:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                </summary>
                <div class="flex flex-col gap-1 pb-3 md:gap-3 md:pb-0 md:pt-3 md:in-data-[filters-side=false]:absolute md:in-data-[filters-side=false]:left-0 md:in-data-[filters-side=false]:top-full md:in-data-[filters-side=false]:z-20 md:in-data-[filters-side=false]:mt-1 md:in-data-[filters-side=false]:w-64 md:in-data-[filters-side=false]:rounded-card md:in-data-[filters-side=false]:border md:in-data-[filters-side=false]:border-border md:in-data-[filters-side=false]:bg-background md:in-data-[filters-side=false]:p-4 md:in-data-[filters-side=false]:shadow-drawer" data-part="content">
                  <label class="group/option flex min-h-11 cursor-pointer items-center gap-2 text-base text-muted-foreground has-checked:text-foreground md:min-h-6">
                    <input class="sr-only" type="radio" name="availability" value="" checked={!page.list.query.availability} />
                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full border-2 border-muted-foreground group-has-checked/option:border-foreground group-has-focus-visible/option:outline-2 group-has-focus-visible/option:outline-offset-2 group-has-focus-visible/option:outline-ring" aria-hidden="true">
                      <span class="size-2.5 rounded-full bg-foreground opacity-0 group-has-checked/option:opacity-100"></span>
                    </span>
                    <span>Все</span>
                  </label>
                  <label class="group/option flex min-h-11 cursor-pointer items-center gap-2 text-base text-muted-foreground has-checked:text-foreground md:min-h-6">
                    <input class="sr-only" type="radio" name="availability" value="in_stock" checked={page.list.query.availability === 'in_stock'} />
                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full border-2 border-muted-foreground group-has-checked/option:border-foreground group-has-focus-visible/option:outline-2 group-has-focus-visible/option:outline-offset-2 group-has-focus-visible/option:outline-ring" aria-hidden="true">
                      <span class="size-2.5 rounded-full bg-foreground opacity-0 group-has-checked/option:opacity-100"></span>
                    </span>
                    <span>В наличии</span>
                  </label>
                  <label class="group/option flex min-h-11 cursor-pointer items-center gap-2 text-base text-muted-foreground has-checked:text-foreground md:min-h-6">
                    <input class="sr-only" type="radio" name="availability" value="sold_out" checked={page.list.query.availability === 'sold_out'} />
                    <span class="flex size-6 shrink-0 items-center justify-center rounded-full border-2 border-muted-foreground group-has-checked/option:border-foreground group-has-focus-visible/option:outline-2 group-has-focus-visible/option:outline-offset-2 group-has-focus-visible/option:outline-ring" aria-hidden="true">
                      <span class="size-2.5 rounded-full bg-foreground opacity-0 group-has-checked/option:opacity-100"></span>
                    </span>
                    <span>Распродано</span>
                  </label>
                </div>
              </details>
              {page.list.facets.price && (
                <details class="group/filter relative min-w-0" data-group="price" open={side}>
                  <summary class="flex h-11 cursor-pointer list-none items-center justify-between gap-2 text-base text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:h-auto md:min-h-6 md:in-data-[filters-side=false]:h-11 md:in-data-[filters-side=false]:justify-start">
                    <span>Стоимость</span>
                    <svg class="size-4 shrink-0 -rotate-90 text-muted-foreground transition-transform group-open/filter:rotate-0 motion-reduce:transition-none md:in-data-[filters-side=false]:rotate-0 md:in-data-[filters-side=false]:group-open/filter:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                  </summary>
                  <div class="flex flex-col pb-3 md:pb-0 md:pt-3 md:in-data-[filters-side=false]:absolute md:in-data-[filters-side=false]:left-0 md:in-data-[filters-side=false]:top-full md:in-data-[filters-side=false]:z-20 md:in-data-[filters-side=false]:mt-1 md:in-data-[filters-side=false]:w-64 md:in-data-[filters-side=false]:rounded-card md:in-data-[filters-side=false]:border md:in-data-[filters-side=false]:border-border md:in-data-[filters-side=false]:bg-background md:in-data-[filters-side=false]:p-4 md:in-data-[filters-side=false]:shadow-drawer" data-part="content">
                    <label class="flex h-11 items-center justify-between gap-2 border-b border-border text-base text-muted-foreground md:h-10">
                      <span>от</span>
                      <span class="flex h-full items-center gap-2">
                        <input class="h-full w-24 border-0 bg-transparent p-0 text-right text-base text-foreground placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" name="min_price" value={page.list.query.minPrice ?? ''} placeholder={`${Math.floor(page.list.facets.price.min.amount / 100)}`} aria-label="Цена от, ₽" />
                        <span aria-hidden="true">₽</span>
                      </span>
                    </label>
                    <label class="flex h-11 items-center justify-between gap-2 border-b border-border text-base text-muted-foreground md:h-10">
                      <span>до</span>
                      <span class="flex h-full items-center gap-2">
                        <input class="h-full w-24 border-0 bg-transparent p-0 text-right text-base text-foreground placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" type="text" inputmode="numeric" pattern="[0-9]*" autocomplete="off" name="max_price" value={page.list.query.maxPrice ?? ''} placeholder={`${Math.ceil(page.list.facets.price.max.amount / 100)}`} aria-label="Цена до, ₽" />
                        <span aria-hidden="true">₽</span>
                      </span>
                    </label>
                  </div>
                </details>
              )}
              {page.list.facets.groups.map((group) => (
                <details class="group/filter relative min-w-0" data-group={`filter.${group.key}`} open={side}>
                  <summary class="flex h-11 cursor-pointer list-none items-center justify-between gap-2 text-base text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:h-auto md:min-h-6 md:in-data-[filters-side=false]:h-11 md:in-data-[filters-side=false]:justify-start">
                    <span>{group.name}</span>
                    <svg class="size-4 shrink-0 -rotate-90 text-muted-foreground transition-transform group-open/filter:rotate-0 motion-reduce:transition-none md:in-data-[filters-side=false]:rotate-0 md:in-data-[filters-side=false]:group-open/filter:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                  </summary>
                  <div class="flex flex-col gap-1 pb-3 md:gap-3 md:pb-0 md:pt-3 md:in-data-[filters-side=false]:absolute md:in-data-[filters-side=false]:left-0 md:in-data-[filters-side=false]:top-full md:in-data-[filters-side=false]:z-20 md:in-data-[filters-side=false]:mt-1 md:in-data-[filters-side=false]:w-64 md:in-data-[filters-side=false]:rounded-card md:in-data-[filters-side=false]:border md:in-data-[filters-side=false]:border-border md:in-data-[filters-side=false]:bg-background md:in-data-[filters-side=false]:p-4 md:in-data-[filters-side=false]:shadow-drawer" data-part="content">
                    {group.values.map((value) => (
                      <label class="group/option flex min-h-11 cursor-pointer items-center gap-2 text-base text-muted-foreground has-checked:text-foreground md:min-h-6">
                        <input class="sr-only" type="checkbox" name={`filter.${group.key}`} value={value.value} checked={value.selected} />
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full border-2 border-muted-foreground group-has-checked/option:border-foreground group-has-focus-visible/option:outline-2 group-has-focus-visible/option:outline-offset-2 group-has-focus-visible/option:outline-ring" aria-hidden="true">
                          <span class="size-2.5 rounded-full bg-foreground opacity-0 group-has-checked/option:opacity-100"></span>
                        </span>
                        <span>{value.value}</span>
                      </label>
                    ))}
                  </div>
                </details>
              ))}
              {page.list.facets.collections.length > 0 && (
                <details class="group/filter relative min-w-0" data-group="collections" open={side}>
                  <summary class="flex h-11 cursor-pointer list-none items-center justify-between gap-2 text-base text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:h-auto md:min-h-6 md:in-data-[filters-side=false]:h-11 md:in-data-[filters-side=false]:justify-start">
                    <span>Коллекции</span>
                    <svg class="size-4 shrink-0 -rotate-90 text-muted-foreground transition-transform group-open/filter:rotate-0 motion-reduce:transition-none md:in-data-[filters-side=false]:rotate-0 md:in-data-[filters-side=false]:group-open/filter:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                  </summary>
                  <div class="flex flex-col gap-1 pb-3 md:gap-3 md:pb-0 md:pt-3 md:in-data-[filters-side=false]:absolute md:in-data-[filters-side=false]:left-0 md:in-data-[filters-side=false]:top-full md:in-data-[filters-side=false]:z-20 md:in-data-[filters-side=false]:mt-1 md:in-data-[filters-side=false]:w-64 md:in-data-[filters-side=false]:rounded-card md:in-data-[filters-side=false]:border md:in-data-[filters-side=false]:border-border md:in-data-[filters-side=false]:bg-background md:in-data-[filters-side=false]:p-4 md:in-data-[filters-side=false]:shadow-drawer" data-part="content">
                    <label class="group/option flex min-h-11 cursor-pointer items-center gap-2 text-base text-muted-foreground has-checked:text-foreground md:min-h-6">
                      <input class="sr-only" type="radio" name="collection" value="" checked={!page.list.facets.collections.some((collection) => collection.selected)} />
                      <span class="flex size-6 shrink-0 items-center justify-center rounded-full border-2 border-muted-foreground group-has-checked/option:border-foreground group-has-focus-visible/option:outline-2 group-has-focus-visible/option:outline-offset-2 group-has-focus-visible/option:outline-ring" aria-hidden="true">
                        <span class="size-2.5 rounded-full bg-foreground opacity-0 group-has-checked/option:opacity-100"></span>
                      </span>
                      <span>Все</span>
                    </label>
                    {page.list.facets.collections.map((collection) => (
                      <label class="group/option flex min-h-11 cursor-pointer items-center gap-2 text-base text-muted-foreground has-checked:text-foreground md:min-h-6">
                        <input class="sr-only" type="radio" name="collection" value={collection.slug} checked={collection.selected} />
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full border-2 border-muted-foreground group-has-checked/option:border-foreground group-has-focus-visible/option:outline-2 group-has-focus-visible/option:outline-offset-2 group-has-focus-visible/option:outline-ring" aria-hidden="true">
                          <span class="size-2.5 rounded-full bg-foreground opacity-0 group-has-checked/option:opacity-100"></span>
                        </span>
                        <span>{collection.title}</span>
                      </label>
                    ))}
                  </div>
                </details>
              )}
            </Fragment>
          ))}
        </div>
      ))}
      </div>
          </div>
          <div class="border-t border-border p-4 md:hidden">
            <button type="submit" class="inline-flex h-12 w-full cursor-pointer items-center justify-center rounded-button border-width-button border-primary-border bg-primary px-6 text-sm text-primary-foreground shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">Показать</button>
          </div>
        </div>
      </dialog>
    </div>
    </form>
  )}
  {page.list && (
    <div class="flex min-w-0 flex-col gap-8 md:in-data-[filters-side=true]:col-span-3">
      {page.list.prev && (
        <a class="inline-flex h-11 items-center justify-center self-center rounded-button border-width-input border-border px-6 text-sm text-foreground no-underline hover:bg-accent hover:text-accent-foreground" data-part="prev" href={page.list.prev}>Показать предыдущие</a>
      )}
      {page.list.items.length === 0 && (
        <div class="flex flex-col items-center gap-4 rounded-card bg-muted px-6 py-16 text-center" data-part="empty">
          <svg class="size-10 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m13.5 8.5-5 5" /><path d="m8.5 8.5 5 5" /><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
          <p class="m-0 font-heading weight-heading text-xl text-heading">Ничего не нашли</p>
          <p class="m-0 max-w-sm text-sm text-muted-foreground">Попробуйте убрать часть фильтров или посмотрите все товары.</p>
          <a class="inline-flex h-11 items-center justify-center rounded-button border-width-button border-primary-border bg-primary px-6 text-sm text-primary-foreground no-underline shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground" href={page.list.url}>Показать все товары</a>
        </div>
      )}
      <ul
        class="m-0 grid list-none gap-x-grid-column gap-y-grid-row p-0 data-[columns-mobile=1]:grid-cols-1 data-[columns-mobile=2]:grid-cols-2 md:data-[columns=1]:grid-cols-1 md:data-[columns=2]:grid-cols-2 md:data-[columns=3]:grid-cols-3 md:data-[columns=4]:grid-cols-3 md:data-[columns=5]:grid-cols-3 md:data-[columns=6]:grid-cols-3 lg:data-[columns=4]:grid-cols-4 lg:data-[columns=5]:grid-cols-5 lg:data-[columns=6]:grid-cols-6"
        data-part="list"
        data-page={page.list.page}
        data-columns={settings.columns}
        data-columns-mobile={settings['columns-mobile']}
        data-aspect-ratio={settings['aspect-ratio']}
        data-image-fit={settings['image-fit']}
        data-button-style={settings['button-style']}
        data-caption-case={settings['caption-case']}
        data-swatches={settings.swatches}
      >
        {page.list.items.map((card) => (
          <li class="group/card relative flex h-full min-w-0 flex-col gap-3 border-border card-style-card:rounded-card card-style-card:border-width-card card-style-card:bg-card card-style-card:p-card card-style-card:text-card-foreground card-style-card:shadow-card card-align-center:text-center card-align-right:text-right motion-hover-lift:transition-transform motion-hover-lift:hover:-translate-y-1 motion-reduce:transition-none motion-reduce:hover:translate-y-0" data-available={card.available} data-ref="card">
            <div class="relative">
              <a
                class="block overflow-hidden rounded-media border-width-media border-border bg-muted shadow-media in-data-[aspect-ratio=portrait]:aspect-3/4 in-data-[aspect-ratio=square]:aspect-square in-data-[aspect-ratio=landscape]:aspect-4/3"
                href={card.url}
                tabindex="-1"
                aria-hidden="true"
              >
                {card.image ? (
                  <div class="size-full" data-behavior="card-photos" data-photos={card.images.join(' ')} data-hover-next={settings['next-photo']}>
                    <img class="size-full in-data-[image-fit=contain]:object-contain in-data-[image-fit=cover]:object-cover" data-part="image" src={card.image} alt={card.title} loading="lazy" />
                  </div>
                ) : (
                  <span class="flex size-full items-center justify-center text-muted-foreground in-data-[aspect-ratio=auto]:aspect-square">
                    <svg class="size-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /></svg>
                  </span>
                )}
              </a>
              {card.compareAtPrice && card.compareAtPrice.amount > card.price.amount && (
                <span class="absolute left-2 top-2 rounded-badge bg-sale px-2 py-1 text-xs text-sale-foreground md:left-3 md:top-3">−{Math.round((1 - card.price.amount / card.compareAtPrice.amount) * 100)} %</span>
              )}
              <span class="absolute bottom-2 left-2 rounded-badge bg-background px-2 py-1 text-xs text-foreground in-data-[available=true]:hidden md:bottom-3 md:left-3">Нет в наличии</span>
              {theme['wishlist-enabled'] !== false && settings.favorite && (
                <button
                  type="button"
                  class="group/heart absolute right-1 top-1 inline-flex size-11 items-center justify-center rounded-full border-0 bg-transparent p-0 text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring md:right-2 md:top-2"
                  aria-pressed="false"
                  aria-label="В избранное"
                  data-action="favorites.toggle"
                  data-product-id={card.id}
                  data-ref="heart"
                >
                  <span class="inline-flex size-9 items-center justify-center rounded-full bg-background/90 shadow-media">
                    <svg class="size-5 group-aria-[pressed=true]/heart:fill-current group-aria-[pressed=true]/heart:text-sale" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5" /></svg>
                  </span>
                </button>
              )}
              {settings['quick-add'] === 'button' && (
                <button
                  type="button"
                  class="absolute bottom-2 right-2 inline-flex size-11 items-center justify-center rounded-button border-width-button p-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring in-data-[available=false]:hidden in-data-[button-style=primary]:border-primary-border in-data-[button-style=primary]:bg-primary in-data-[button-style=primary]:text-primary-foreground in-data-[button-style=primary]:shadow-button in-data-[button-style=primary]:hover:bg-primary-hover in-data-[button-style=primary]:hover:text-primary-hover-foreground in-data-[button-style=secondary]:border-foreground in-data-[button-style=secondary]:bg-background in-data-[button-style=secondary]:text-foreground in-data-[button-style=secondary]:hover:bg-foreground in-data-[button-style=secondary]:hover:text-background in-data-[button-style=link]:border-transparent in-data-[button-style=link]:bg-background/90 in-data-[button-style=link]:text-foreground in-data-[button-style=link]:hover:bg-background md:bottom-3 md:right-3"
                  data-action="cart.add"
                  data-product-id={card.id}
                  data-variant-id={card.variantId ?? undefined}
                  aria-label={`В корзину: ${card.title}`}
                >
                  <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                </button>
              )}
              {settings['quick-add'] === 'hover' && (
                <button
                  type="button"
                  class="absolute inset-x-2 bottom-2 inline-flex h-11 items-center justify-center rounded-button border-width-button px-4 text-sm uppercase focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring in-data-[available=false]:hidden in-data-[button-style=primary]:border-primary-border in-data-[button-style=primary]:bg-primary in-data-[button-style=primary]:text-primary-foreground in-data-[button-style=primary]:shadow-button in-data-[button-style=primary]:hover:bg-primary-hover in-data-[button-style=primary]:hover:text-primary-hover-foreground in-data-[button-style=secondary]:border-foreground in-data-[button-style=secondary]:bg-background in-data-[button-style=secondary]:text-foreground in-data-[button-style=secondary]:hover:bg-foreground in-data-[button-style=secondary]:hover:text-background in-data-[button-style=link]:border-transparent in-data-[button-style=link]:bg-background/90 in-data-[button-style=link]:text-foreground in-data-[button-style=link]:underline in-data-[button-style=link]:underline-offset-4 in-data-[button-style=link]:hover:bg-background md:inset-x-3 md:bottom-3 md:opacity-0 md:group-hover/card:opacity-100"
                  data-action="cart.add"
                  data-product-id={card.id}
                  data-variant-id={card.variantId ?? undefined}
                >В корзину</button>
              )}
            </div>
            <div class="flex flex-1 flex-col gap-2">
              {settings.swatches !== 'none' && card.colors.length > 0 && (
                <div class="flex flex-wrap items-center gap-1" role="list" aria-label="Цвета">
                  {card.colors.map((color) => (
                    <span class="inline-flex size-5 overflow-hidden border border-border in-data-[swatches=circle]:rounded-full" role="listitem" title={color.title}>
                      <svg class="size-full" viewBox="0 0 20 20" role="img" aria-label={color.title}><rect width="20" height="20" fill={color.swatch} /></svg>
                    </span>
                  ))}
                </div>
              )}
              <a class="line-clamp-2 min-h-11 text-sm text-foreground no-underline hover:underline in-data-[caption-case=uppercase]:uppercase md:min-h-0 md:text-base" href={card.url}>{card.title}</a>
              <p class="m-0 flex flex-wrap items-baseline gap-x-2 card-align-center:justify-center card-align-right:justify-end">
                <span class:list={['text-base weight-heading md:text-lg', card.compareAtPrice ? 'text-sale' : 'text-price']}>{card.price.text}</span>
                {card.compareAtPrice && <s class="text-sm text-price-old">{card.compareAtPrice.text}</s>}
              </p>
              {(settings['quick-add'] === 'standard' || settings['quick-add'] === 'count') && (
                <div class="mt-auto flex flex-col gap-2 in-data-[available=false]:hidden">
                  {settings['quick-add'] === 'count' && (
                    <div class="flex h-11 items-center justify-between rounded-input border-width-input border-input bg-background text-foreground">
                      <button type="button" class="inline-flex size-11 items-center justify-center border-0 bg-transparent p-0 text-foreground disabled:opacity-40" aria-label="Меньше" data-action="less" data-ref="less" disabled>
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /></svg>
                      </button>
                      <span class="min-w-8 text-center text-base tabular-nums" data-ref="quantity" aria-live="polite">1</span>
                      <button type="button" class="inline-flex size-11 items-center justify-center border-0 bg-transparent p-0 text-foreground disabled:opacity-40" aria-label="Больше" data-action="more" data-ref="more">
                        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
                      </button>
                    </div>
                  )}
                  <button
                    type="button"
                    class="inline-flex h-11 w-full items-center justify-center rounded-button border-width-button px-4 text-sm uppercase focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring in-data-[button-style=primary]:border-primary-border in-data-[button-style=primary]:bg-primary in-data-[button-style=primary]:text-primary-foreground in-data-[button-style=primary]:shadow-button in-data-[button-style=primary]:hover:bg-primary-hover in-data-[button-style=primary]:hover:text-primary-hover-foreground in-data-[button-style=secondary]:border-foreground in-data-[button-style=secondary]:bg-background in-data-[button-style=secondary]:text-foreground in-data-[button-style=secondary]:hover:bg-foreground in-data-[button-style=secondary]:hover:text-background in-data-[button-style=link]:border-transparent in-data-[button-style=link]:bg-transparent in-data-[button-style=link]:text-foreground in-data-[button-style=link]:underline in-data-[button-style=link]:underline-offset-4"
                    data-action="cart.add"
                    data-product-id={card.id}
                    data-variant-id={card.variantId ?? undefined}
                    data-quantity="1"
                    data-ref="buy"
                  >В корзину</button>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
      {page.list.items.length > 0 && (
        <div class="flex flex-col items-center gap-4 pt-4 text-center">
          <p class="m-0 text-sm text-muted-foreground">Показано <span data-part="count">{page.list.items.length}</span> из {page.list.total}</p>
          {page.list.next && (
            <a class="inline-flex h-12 items-center justify-center rounded-button border-width-input border-foreground bg-background px-8 text-sm text-foreground no-underline hover:bg-foreground hover:text-background focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" data-part="next" href={page.list.next}>Показать ещё</a>
          )}
          {page.list.pages > 1 && (
            <nav class="flex flex-wrap justify-center gap-1" data-part="pages" aria-label="Страницы">
              {page.list.links.map((link) => link.url ? (
                <a class="inline-flex size-11 items-center justify-center rounded-button text-sm text-foreground no-underline hover:bg-accent hover:text-accent-foreground aria-[current=page]:bg-primary aria-[current=page]:text-primary-foreground" href={link.url} aria-current={link.current ? 'page' : undefined}>{link.page}</a>
              ) : (
                <span class="inline-flex size-11 items-center justify-center text-sm text-muted-foreground">…</span>
              ))}
            </nav>
          )}
          {settings.collection && settings.collection.url && page.list.url !== settings.collection.url && (
            <a class="text-sm text-foreground underline underline-offset-4" href={settings.collection.url}>Смотреть все</a>
          )}
        </div>
      )}
      <p class="sr-only" data-part="status" aria-live="polite"></p>
    </div>
  )}
</div>
