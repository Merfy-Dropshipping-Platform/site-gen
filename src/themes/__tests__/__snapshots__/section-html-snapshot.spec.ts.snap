exports[`снимки секций — satin CollapsibleSection — снимок разметки 1`] = `"<section class="satin-pad w-full bg-[rgb(var(--color-bg,255_255_255))] py-10 md:py-14 color-scheme-1" aria-labelledby="Collapsible-1-title" data-puck-component-id="Collapsible-1" style="padding-top:40px;padding-bottom:40px;"> <div class="satin-container flex flex-col gap-8"> <h2 id="Collapsible-1-title" class="font-logo text-[20px] font-normal leading-[1.15] text-[rgb(var(--color-heading,0_0_0))]" data-puck-subsection-parent="Collapsible-1" data-puck-subsection-index="100" data-puck-subsection-field="heading">Вопросы</h2> <div class="flex flex-col divide-y divide-[rgb(var(--color-text,0_0_0)/13%)]"> <details class="group py-5" open data-faq-item data-puck-subsection-parent="Collapsible-1" data-puck-subsection-index="0" data-puck-subsection-field="sections"> <summary class="cursor-pointer list-none [&::-webkit-details-marker]:hidden"> <div class="flex w-full items-center justify-between gap-4 font-logo text-[18px] md:text-[20px] font-normal leading-[1.2] text-[rgb(var(--color-heading,0_0_0))]"> <span class="min-w-0 flex-1 break-words">Вопрос</span> <img src="/icons/plus.svg" alt="" class="shrink-0 object-contain pointer-events-none size-8 shrink-0 group-open:hidden" width="24" height="24" aria-hidden="true"> <img src="/icons/minus.svg" alt="" class="shrink-0 object-contain pointer-events-none size-8 hidden shrink-0 group-open:block" width="24" height="24" aria-hidden="true"> </div> </summary> <div class="overflow-hidden" data-faq-answer> <div class="satin-copy mt-3 max-w-[1100px]">Ответ</div> </div> </details> </div> </div> </section>"`;

