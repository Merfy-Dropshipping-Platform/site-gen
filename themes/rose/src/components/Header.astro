				: "inset-x-0 bottom-0 w-full px-4 pt-4 pb-8 sm:px-5 md:px-10 lg:hidden [clip-path:inset(0)] transition-[clip-path,display] transition-discrete duration-300 ease-out starting:[clip-path:inset(0_0_100%_0)] [&.hidden]:[clip-path:inset(0_0_100%_0)] motion-reduce:transition-none",
		]}
