{
  "$comment": "Сгенерировано из схемы zod командой pnpm generate — руками не править.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "preview"
      ]
    },
    "shop": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "url"
      ],
      "additionalProperties": false
    },
    "currency": {
      "type": "string",
      "const": "RUB"
    },
    "locale": {
      "type": "string",
      "const": "ru-RU"
    },
    "api": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": ".*\\/api$"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
        },
        "settings": {
          "type": "object",
          "properties": {
            "logo-image": {
              "type": "string",
              "maxLength": 2048
            },
            "social-telegram": {
              "type": "string",
              "maxLength": 2048
            },
            "social-vk": {
              "type": "string",
              "maxLength": 2048
            },
            "social-dzen": {
              "type": "string",
              "maxLength": 2048
            },
            "social-youtube": {
              "type": "string",
              "maxLength": 2048
            },
            "social-tiktok": {
              "type": "string",
              "maxLength": 2048
            },
            "social-max": {
              "type": "string",
              "maxLength": 2048
            },
            "cart-type": {
              "type": "string",
              "enum": [
                "drawer",
                "page"
              ]
            },
            "cookie-banner-enabled": {
              "type": "boolean"
            },
            "wishlist-enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^\\/.*"
        },
        "record": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "product",
                "collection",
                "blog",
                "article",
                "policy"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "type",
            "id"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "path"
      ],
      "additionalProperties": false
    },
    "analytics": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "counters": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "metrika",
                      "vk",
                      "google"
                    ]
                  },
                  "number": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "number"
                ],
                "additionalProperties": false
              }
            },
            "custom": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "consent": {
                    "type": "string",
                    "enum": [
                      "required",
                      "none"
                    ]
                  }
                },
                "required": [
                  "code",
                  "consent"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "url",
            "counters"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{2,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "stores": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "fn": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                },
                "by": {
                  "type": "string",
                  "const": "product"
                },
                "customer": {
                  "type": "boolean",
                  "const": true
                },
                "refreshOn": {
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^merfy:[a-z]+(?:-[a-z]+)*:[a-z]+(?:-[a-z]+)*$"
                  }
                }
              },
              "required": [
                "fn"
              ],
              "additionalProperties": false
            }
          },
          "methods": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z][a-zA-Z0-9]{0,31}$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "fn": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                },
                "customer": {
                  "type": "boolean",
                  "const": true
                },
                "params": {
                  "maxItems": 10,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                  }
                }
              },
              "required": [
                "fn"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "stores",
          "methods"
        ],
        "additionalProperties": false
      }
    },
    "extPoints": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{2,31}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cart": {
            "type": "object",
            "properties": {
              "note": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "when": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "note"
            ],
            "additionalProperties": false
          },
          "account": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "source": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              "fields": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    "input": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    "required": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "key"
                  ],
                  "additionalProperties": false
                }
              },
              "copy": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "key"
                ],
                "additionalProperties": false
              },
              "list": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                  },
                  "columns": {
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    }
                  }
                },
                "required": [
                  "source",
                  "columns"
                ],
                "additionalProperties": false
              },
              "form": {
                "type": "object",
                "properties": {
                  "fn": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
                  },
                  "fields": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "kind": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 32
                        },
                        "input": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 32
                        },
                        "required": {
                          "type": "boolean",
                          "const": true
                        }
                      },
                      "required": [
                        "key"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "fn"
                ],
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "orders": {
            "type": "object",
            "properties": {
              "list": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              },
              "get": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              }
            },
            "required": [
              "list",
              "get"
            ],
            "additionalProperties": false
          },
          "product": {
            "type": "object",
            "properties": {
              "form": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
              }
            },
            "required": [
              "form"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "mode",
    "shop",
    "currency",
    "locale",
    "api",
    "theme",
    "page",
    "analytics"
  ],
  "additionalProperties": false
}
