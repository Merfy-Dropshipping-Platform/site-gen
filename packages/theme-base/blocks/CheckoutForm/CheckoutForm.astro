---
// CheckoutForm — мега-блок «Оформление заказа» (Figma 1:19998).
// Консолидирует 6 inner sections (Contact / Delivery / DeliveryMethod /
// Payment / Submit / Terms) в один Puck блок. Каждая inner-секция импортируется
// как Astro component → сохраняет data-checkout-slot markers (React Island
// CheckoutFlow.tsx находит их через querySelectorAll и Portals interactive
// content без изменений).
//
// Защищает merchant'a от 6 отдельных sidebar configs — per Figma тут только
// Цветовая схема. Дефолты для inner blocks hardcoded ниже (matches миграцию
// migrateCheckoutPage из 080 phase 6).
import type { CheckoutFormProps } from './CheckoutForm.puckConfig';
import { CheckoutFormClasses as C } from './CheckoutForm.classes';

import CheckoutContactForm from '../CheckoutContactForm/CheckoutContactForm.astro';
import CheckoutDeliveryForm from '../CheckoutDeliveryForm/CheckoutDeliveryForm.astro';
import CheckoutDeliveryMethod from '../CheckoutDeliveryMethod/CheckoutDeliveryMethod.astro';
import CheckoutPayment from '../CheckoutPayment/CheckoutPayment.astro';
import CheckoutSubmit from '../CheckoutSubmit/CheckoutSubmit.astro';
import CheckoutTerms from '../CheckoutTerms/CheckoutTerms.astro';

interface Props extends CheckoutFormProps {
  id?: string;
}

const { id, padding, colorScheme } = Astro.props as Props;

const paddingStyle = padding
  ? `padding-top:${padding.top}px; padding-bottom:${padding.bottom}px;`
  : '';

// «Цветовая схема» этой секции НЕ красит левую колонку и НЕ красит саму
// секцию. Уточнение владельца после третьего круга: «левая часть от нас, там
// только меняется цвет кнопки и юр инфа цвет; всё остальное наше». Поэтому
// класс схемы едет ВНИЗ, на «Кнопку оплаты» (CheckoutSubmit) — единственный
// элемент формы, который владелец отдал схеме; правовую полосу внизу красит
// её собственная схема (секция «Подвал» страницы чекаута, CheckoutFooterStrip).
//
// Корень секции остаётся на палитре страницы (`C.root` несёт
// `bg-[rgb(var(--color-bg))]`): без класса схемы это фон ТЕМЫ — ровно то, что
// было до cb182717. Класс на корне красил бы «пятно» под всей формой: замер
// собранных витрин (пять тем, Chromium, 1440×900, 13-14.09) — колонка формы
// 0..720 заливалась 0,0,0 (rose scheme-4, flux scheme-1), 8,2,0 (satin
// scheme-4), 207,122,139 (bloom scheme-1).
//
// Значение приходит строкой "scheme-2", голой "1" ИЛИ числом (живая
// нормализация ревизии) — нормализует `schemeClassOf` уже в CheckoutSubmit,
// которому это значение и передаётся ниже.
---
<section
  class={C.root}
  data-puck-component-id={id}
  data-block="checkout-form"
  style={paddingStyle}
>
  {/*
    Spec 102: каждый интерактивный под-блок ОБЯЗАН получить стабильный id —
    он рендерится как data-puck-component-id, по которому инлайн-скрипт находит
    свой корень через window.__merfyRoot(blockId). Без id (как было) __merfyRoot
    на отложенном init (DOMContentLoaded/astro:page-load, где currentScript=null)
    возвращает null → скрипт выходит рано, и DaData-подсказки/расчёт тарифов/
    кнопка оплаты НЕ навешиваются. Чекаут — синглтон, поэтому фиксированные id
    безопасны. НЕ удалять.
  */}
  <CheckoutContactForm
    id="checkout-contact"
    heading="Контакты"
    showAuthLink={true}
    authLinkText="Войти в аккаунт"
    authLinkHref="/login?next=/checkout"
    emailLabel="E-mail"
    phoneLabel="Номер телефона"
    phoneFormat="ru"
    padding={{ top: 0, bottom: 0 }}
  />

  <CheckoutDeliveryForm
    id="checkout-delivery"
    heading="Доставка"
    country={{ enabled: true, default: 'Российская Федерация', selectable: true }}
    nameField={{ enabled: true, splitFirstLast: true }}
    cityDadata={true}
    addressDadata={true}
    indexAutoFill={true}
    requiredFields={['email', 'phone', 'name', 'address', 'index']}
    padding={{ top: 0, bottom: 0 }}
  />

  <CheckoutDeliveryMethod
    id="checkout-delivery-method"
    heading="Способ доставки"
    cdekEnabled={true}
    cdekDoorLabel="Курьер СДЭК до двери"
    cdekPvzLabel="Пункт выдачи СДЭК"
    cdekPostamatLabel="Постамат СДЭК"
    pickupEnabled={true}
    pickupLabel="Самовывоз"
    customMethods={[]}
    freeShippingThresholdCents={null}
    padding={{ top: 0, bottom: 0 }}
  />

  <CheckoutPayment
    id="checkout-payment"
    heading="Платёжная система"
    subheading="Все транзакции безопасны и зашифрованы"
    methods={[
      { key: 'bank_card', enabled: true, label: 'Банковская карта' },
      { key: 'sbp', enabled: true, label: 'СБП (Система быстрых платежей)' },
      { key: 'sberbank', enabled: false, label: 'Sber Pay' },
      { key: 'tinkoff_bank', enabled: false, label: 'T-Pay' },
    ]}
    cardForm={{ cvvHelpEnabled: true, nameOnCardEnabled: true, warningText: 'Счёт будет выставлен по вашему адресу' }}
    padding={{ top: 0, bottom: 0 }}
  />

  {/*
    Единственный получатель «Цветовой схемы» формы (см. шапку файла). Корень
    «Кнопки оплаты» ничего не красит (`w-full`), поэтому класс схемы на нём
    меняет ровно цвет кнопки: она берёт `--color-button-bg`/`--color-button-text`
    — тот же механизм, что у кнопки в любой обычной секции витрины.
    На live-витрине тема рендерит мега-блок БЕЗ пропсов, и тот же класс сюда
    дописывает сборка (chrome-assembler.patchCheckoutBlockScheme, цель
    `checkout-submit`). Пути совпадают по построению.
  */}
  <CheckoutSubmit
    id="checkout-submit"
    colorScheme={colorScheme}
    buttonText="Оплатить {total}"
    buttonStyle="fill"
    loadingText="Обработка платежа…"
    successRedirectUrl="/checkout-result"
    padding={{ top: 0, bottom: 0 }}
  />

  <CheckoutTerms
    text="Размещая заказ, вы соглашаетесь с [Условиями обслуживания](/legal/terms), [Политикой конфиденциальности](/legal/privacy) и [Политикой использования файлов cookie](/legal/cookies)."
    links={[
      { label: 'Условия обслуживания', url: '/legal/terms' },
      { label: 'Политика конфиденциальности', url: '/legal/privacy' },
      { label: 'Политика использования файлов cookie', url: '/legal/cookies' },
    ]}
    padding={{ top: 0, bottom: 0 }}
  />
</section>
