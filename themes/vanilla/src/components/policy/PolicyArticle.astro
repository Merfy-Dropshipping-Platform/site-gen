---
/**
 * Типовая страница юридического документа (политики / условия).
 * Оформление повторяет типографику темы Vanilla (см. about.astro).
 */
interface PolicySection {
	title?: string;
	paragraphs: string[];
}

interface Props {
	heading: string;
	updated?: string;
	sections: PolicySection[];
}

const { heading, updated, sections } = Astro.props;
---

<section
	class="vanilla-pad w-full bg-[var(--vanilla-surface)] py-16 lg:py-[120px]"
	aria-labelledby="policy-title"
>
	<div class="mx-auto flex w-full max-w-[900px] flex-col gap-10">
		<header class="flex flex-col gap-3">
			<h1
				id="policy-title"
				class="font-vanilla-bitter text-2xl font-normal italic leading-none tracking-normal text-[var(--vanilla-dark)]"
			>
				{heading}
			</h1>
			{
				updated && (
					<p class="font-vanilla-arsenal text-base font-normal leading-none text-[var(--vanilla-muted)]">
						{updated}
					</p>
				)
			}
		</header>

		<div class="flex flex-col gap-8">
			{
				sections.map((section) => (
					<div class="flex flex-col gap-3">
						{section.title && (
							<h2 class="font-vanilla-arsenal text-[20px] font-normal uppercase leading-none tracking-normal text-[var(--vanilla-dark)]">
								{section.title}
							</h2>
						)}
						{section.paragraphs.map((paragraph) => (
							<p class="font-vanilla-arsenal text-base font-normal leading-[1.5] text-[#444444]">
								{paragraph}
							</p>
						))}
					</div>
				))
			}
		</div>
	</div>
</section>
