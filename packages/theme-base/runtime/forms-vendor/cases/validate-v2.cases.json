  "cases": [
    {
      "name": "пустая форма — все обязательные, почта и согласие",
      "form": "photobook",
      "values": {},
      "contacts": {},
      "filesCounts": {},
      "expected": {
        "items": {
          "f1": "Приложите хотя бы один файл",
          "f2": "Выберите вариант",
          "c-email": "Проверьте почту",
          "c-phone": "Нужен телефон"
        },
        "consent": "Без согласия заявку не отправить"
      }
    },
    {
      "name": "обязательный checkbox не отмечен",
      "form": "extras",
      "values": { "x1": "Телеграм", "x2": "PROMO2026", "x3": false, "x4": "A4" },
      "contacts": { "name": "Анна", "email": "anna@mail.ru", "social": "tg:@anna", "consent": true },
      "filesCounts": {},
      "expected": { "items": { "x3": "Отметьте, чтобы продолжить" } }
    },
    {
      "name": "обязательный select пуст",
      "form": "extras",
      "values": { "x1": "Телеграм", "x2": "PROMO2026", "x3": true, "x4": "" },
      "contacts": { "name": "Анна", "email": "anna@mail.ru", "social": "tg:@anna", "consent": true },
      "filesCounts": {},
      "expected": { "items": { "x4": "Выберите вариант" } }
    },
