---
import SchemeIcon from "../../../../packages/theme-base/primitives/SchemeIcon.astro";
import { FLUX_ICON_SVGS } from "./icons/flux-icon-svgs";

interface Props {
	badgeCls: string;
	boxCls?: string;
	iconSize?: string;
}

const { badgeCls, boxCls = "size-11", iconSize = "size-6" } = Astro.props;
---

<a
	href="/wishlist"
	class:list={["relative flex items-center justify-center transition-opacity hover:opacity-80", boxCls]}
	aria-label="Избранное"
>
	<SchemeIcon svgs={FLUX_ICON_SVGS} name="favourite" sizeClass={iconSize} />
	<span data-wishlist-count data-empty="true" class={badgeCls}>0</span>
</a>
