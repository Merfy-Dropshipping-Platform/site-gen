exports[`снимки секций — satin Publications — снимок разметки 1`] = `"<section class="satin-pad w-full bg-[rgb(var(--color-bg,255_255_255))] py-10 md:py-14 color-scheme-1" aria-labelledby="Publications-1-title" data-puck-component-id="Publications-1" style="padding-top:40px;padding-bottom:40px;"> <div class="satin-container flex flex-col gap-8"> <h2 id="Publications-1-title" class="font-logo text-[20px] font-normal uppercase leading-[1.15] text-[rgb(var(--color-heading,0_0_0))]" data-puck-subsection-parent="Publications-1" data-puck-subsection-index="100" data-puck-subsection-field="heading">Публикации</h2> <ul class="grid grid-cols-1 gap-4 sm:grid-cols-[repeat(var(--pub-cols),minmax(0,1fr))]" style="--pub-cols:2;" role="list"> <li class="flex flex-col gap-6 bg-[rgb(var(--color-surface,245_245_245))] p-4" data-publication-index="0"> <div class="relative aspect-square w-full overflow-hidden bg-[rgb(var(--color-surface,245_245_245))]"> <img src="/placeholders/publication-card.png" alt="" loading="eager" class="absolute inset-0 size-full object-cover"> </div> <div class="flex flex-col gap-2"> <p class="font-manrope text-[14px] font-light uppercase tracking-[0.04em] text-[rgb(var(--color-muted,153_153_153))]"> 15 марта 2025 </p> <h3 class="font-logo text-[16px] font-normal uppercase leading-[1.15] text-[rgb(var(--color-heading,0_0_0))]">Новая коллекция весна 2025</h3> <p class="font-manrope text-[14px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))]"> Сочетай текст, чтобы подчеркнуть плюсы товара или коллекции. </p> </div> <a href="/catalog" class="inline-flex items-center gap-2 font-manrope text-[14px] font-normal uppercase leading-normal text-[rgb(var(--color-text,0_0_0))] transition-opacity hover:opacity-70"> <span>Кнопка</span> <img src="/icons/arrow-right.svg" alt="" class="shrink-0 object-contain pointer-events-none size-5 " width="24" height="24" aria-hidden="true"> </a> </li><li class="flex flex-col gap-6 bg-[rgb(var(--color-surface,245_245_2