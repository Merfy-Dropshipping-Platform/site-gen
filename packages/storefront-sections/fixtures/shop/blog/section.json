{
  "sdk": 1,
  "name": "blog",
  "kind": "section",
  "title": "Блог",
  "wrapper": ["padding", "scheme"],
  "wrapperSpec": { "padding": { "default": { "top": 80, "bottom": 80 } } },
  "names": {
    "date": {
      "kinds": ["toggle"],
      "label": "Дата и время",
      "about": "Дата публикации над названием записи в карточке",
      "asks": ["дата", "дата и время", "дата публикации", "date", "published"]
    },
    "excerpt": {
      "kinds": ["toggle"],
      "label": "Анонс",
      "about": "Короткий текст записи под названием в карточке",
      "asks": ["анонс", "краткое описание", "отрывок", "excerpt", "summary"]
    }
  },
  "settings": [
    { "wrapper": "padding" },
    { "wrapper": "scheme" },
    {
      "id": "per-page",
      "label": "Карточки",
      "section": "Содержание",
      "setting": { "kind": "range", "default": 12, "min": 2, "max": 24, "step": 1 }
    },
    {
      "id": "date",
      "label": "Дата и время",
      "setting": { "kind": "toggle", "default": true, "labels": { "on": "Показать", "off": "Скрыть" } }
    },
    {
      "id": "excerpt",
      "label": "Анонс",
      "setting": { "kind": "toggle", "default": true, "labels": { "on": "Показать", "off": "Скрыть" } }
    },
    {
      "id": "columns",
      "label": "Колонки",
      "section": "Вид",
      "setting": { "kind": "range", "default": 3, "min": 1, "max": 4, "step": 1 }
    },
    { "id": "align", "label": "Выравнивание заголовка", "setting": { "kind": "alignment", "default": "left" } }
  ]
}
