---
const { settings, shop } = Astro.props;
---
<!-- Значки — Lucide (image, search, chevron-down, x), лицензия ISC, lucide.dev/license. -->
<!-- «Оформление заказа» — страница /checkout пяти старых тем, вид по умолчанию flux: одностраничная форма (контакты →
     доставка → способ доставки → платёжная система → «Оплатить» и юридическая строка) и сводка заказа (строки,
     промокод, доставка, «Итого»). Телефон — сверху вниз: на телефоне сводка под формой, на компьютере — справа.
     Полей карты нет: покупатель выбирает способ оплаты, карту вводит на странице платёжки. Что видно и что выбрано —
     пишет script.ts по сторам ctx.checkout; запросы — у модуля оформления. -->
<div class="mx-auto grid max-w-page gap-12 px-4 font-body text-foreground md:grid-cols-2 md:gap-16 lg:gap-20">
  <form data-ref="form" data-action="submit:pay" novalidate class="flex min-w-0 flex-col gap-10 md:ml-auto md:w-full md:max-w-100">
    <section class="flex flex-col gap-4" aria-labelledby="checkout-contacts">
      <div class="flex items-center justify-between gap-4">
        <h2 id="checkout-contacts" class="m-0 font-heading weight-heading tracking-heading text-xl text-heading">Контакты</h2>
        <a data-ref="sign-in" href="/login?redirect=%2Fcheckout" class="inline-flex min-h-11 items-center text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground">Войти в аккаунт</a>
      </div>
      <div class="flex flex-col gap-1.5">
        <label class="text-sm text-muted-foreground" for="checkout-email">E-mail</label>
        <input id="checkout-email" data-ref="field-email" name="email" type="email" autocomplete="email" spellcheck="false" data-action="field focusout:leave" class="h-12 w-full rounded-input border-width-input border-input bg-background px-4 text-base text-foreground aria-invalid:border-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" />
        <p data-ref="error-email" role="alert" class="m-0 text-sm text-destructive" hidden></p>
      </div>
      <div data-ref="phone" class="flex flex-col gap-1.5" hidden>
        <label class="text-sm text-muted-foreground" for="checkout-phone">Номер телефона</label>
        <input id="checkout-phone" data-ref="field-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="+7 (" data-action="field focusout:leave" class="h-12 w-full rounded-input border-width-input border-input bg-background px-4 text-base text-foreground placeholder:text-muted-foreground aria-invalid:border-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" />
        <p data-ref="error-phone" role="alert" class="m-0 text-sm text-destructive" hidden></p>
      </div>
    </section>

    <section class="flex flex-col gap-4" aria-labelledby="checkout-delivery">
      <h2 id="checkout-delivery" class="m-0 font-heading weight-heading tracking-heading text-xl text-heading">Доставка</h2>
      <div data-ref="country" class="flex flex-col gap-1.5">
        <label class="text-sm text-muted-foreground" for="checkout-country">Страна/Регион</label>
        <select id="checkout-country" data-ref="field-country" name="country" autocomplete="country-name" data-action="field" class="h-12 w-full cursor-pointer rounded-input border-width-input border-input bg-background px-4 text-base text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
          <option>Российская Федерация</option>
          <option>Беларусь</option>
          <option>Казахстан</option>
          <option>Армения</option>
          <option>Киргизия</option>
          <option>Узбекистан</option>
        </select>
      </div>
      <div class="grid gap-4 md:grid-cols-2">
        <div data-ref="first-name" class="flex flex-col gap-1.5">
          <label class="text-sm text-muted-foreground" for="checkout-first-name">Имя</label>
          <input id="checkout-first-name" data-ref="field-firstName" name="firstName" type="text" autocomplete="given-name" data-action="field focusout:leave" class="h-12 w-full rounded-input border-width-input border-input bg-background px-4 text-base text-foreground aria-invalid:border-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" />
          <p data-ref="error-firstName" role="alert" class="m-0 text-sm text-destructive" hidden></p>
        </div>
        <div data-ref="last-name" class="flex flex-col gap-1.5">
          <label class="text-sm text-muted-foreground" for="checkout-last-name">Фамилия</label>
          <input id="checkout-last-name" data-ref="field-lastName" name="lastName" type="text" autocomplete="family-name" data-action="field focusout:leave" class="h-12 w-full rounded-input border-width-input border-input bg-background px-4 text-base text-foreground aria-invalid:border-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" />
          <p data-ref="error-lastName" role="alert" class="m-0 text-sm text-destructive" hidden></p>
        </div>
      </div>
      <div data-ref="address-fields" class="flex flex-col gap-4">
        <div class="relative flex flex-col gap-1.5">
          <label class="text-sm text-muted-foreground" for="checkout-city">Город</label>
          <input id="checkout-city" data-ref="field-city" name="city" type="text" autocomplete="address-level2" aria-autocomplete="list" data-action="field focusout:leave" class="h-12 w-full rounded-input border-width-input border-input bg-background px-4 text-base text-foreground aria-invalid:border-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" />
          <ul data-ref="hints-city" class="absolute inset-x-0 top-full z-10 m-0 mt-1 flex list-none flex-col overflow-hidden rounded-input border-width-input border-input bg-background p-0 shadow-drawer" hidden>
            <template>
              <li><button type="button" data-ref="hint" data-action="pointerdown:checkout.pickHint" class="block min-h-11 w-full cursor-pointer bg-transparent px-4 py-2 text-left text-base text-foreground hover:bg-muted"></button></li>
            </template>
          </ul>
          <p data-ref="error-city" role="alert" class="m-0 text-sm text-destructive" hidden></p>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          <div class="relative flex flex-col gap-1.5 md:col-span-2">
            <label class="text-sm text-muted-foreground" for="checkout-address">Полный адрес</label>
            <input id="checkout-address" data-ref="field-address" name="address" type="text" autocomplete="street-address" aria-autocomplete="list" data-action="field focusout:leave" class="h-12 w-full rounded-input border-width-input border-input bg-background px-4 text-base text-foreground aria-invalid:border-destructive focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" />
            <ul data-ref="hints-address" class="absolute inset-x-0 top-full z-10 m-0 mt-1 flex list-none flex-col overflow-hidden rounded-input border-width-input border-input bg-background p-0 shadow-drawer" hidden>
              <template>
                <li><button type="button" data-ref="hint" data-action="pointerdown:checkout.pickHint" class="block min-h-11 w-full cursor-pointer bg-transparent px-4 py-2 text-left text-base text-foreground hover:bg-muted"></button></li>
              </template>
            </ul>
            <p data-ref="error-address" role="alert" class="m-0 text-sm text-destructive" hidden></p>
          </div>
          <div class="flex flex-col gap-1.5">
            <label class="text-sm text-muted-foreground" for="checkout-postal">Индекс</label>
            <input id="checkout-postal" data-ref="field-postalCode" name="postalCode" type="text" inputmode="numeric" autocomplete="postal-code" data-action="field focusout:leave" class="h-12 w-full rounded-input border-width-input border-input bg-background px-4 text-base text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" />
          </div>
        </div>
      </div>
    </section>

    <section data-ref="delivery" class="flex flex-col gap-4" aria-labelledby="checkout-methods">
      <h2 id="checkout-methods" class="m-0 font-heading weight-heading tracking-heading text-xl text-heading">Способ доставки</h2>
      <p data-ref="delivery-status" class="m-0 text-sm text-muted-foreground">Считаем варианты доставки…</p>
      <div data-ref="delivery-options" role="radiogroup" aria-label="Способ доставки" class="flex flex-col gap-3" hidden>
        <template>
          <button type="button" role="radio" data-ref="option" data-action="checkout.selectDelivery" class="flex w-full cursor-pointer items-start gap-3 rounded-input border-width-input border-input bg-background p-4 text-left text-foreground aria-checked:border-foreground">
            <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full border-width-input border-input in-aria-checked:border-foreground in-aria-checked:bg-foreground" aria-hidden="true"><span class="size-2 rounded-full bg-background"></span></span>
            <span class="flex min-w-0 flex-1 flex-col gap-1">
              <span class="flex flex-wrap items-center gap-2">
                <span data-ref="option-title" class="text-base text-heading"></span>
                <span data-ref="option-cheapest" class="rounded-full bg-muted px-2 text-xs text-muted-foreground" hidden>дешевле всего</span>
              </span>
              <span data-ref="option-about" class="text-sm text-muted-foreground"></span>
            </span>
            <span data-ref="option-price" class="shrink-0 text-base text-heading"></span>
          </button>
        </template>
      </div>
      <p data-ref="error-delivery" role="alert" class="m-0 text-sm text-destructive" hidden></p>
      <div data-ref="points" class="flex flex-col gap-2" hidden>
        <p class="m-0 text-sm text-muted-foreground">Пункт выдачи</p>
        <p data-ref="points-status" class="m-0 text-sm text-muted-foreground"></p>
        <div data-ref="points-list" role="radiogroup" aria-label="Пункт выдачи" class="flex max-h-80 flex-col gap-2 overflow-y-auto">
          <template>
            <button type="button" role="radio" data-ref="point" data-action="checkout.selectPoint" class="flex w-full cursor-pointer flex-col gap-1 rounded-input border-width-input border-input bg-background p-3 text-left text-foreground aria-checked:border-foreground">
              <span data-ref="point-address" class="text-sm text-heading"></span>
              <span data-ref="point-hours" class="text-xs text-muted-foreground"></span>
            </button>
          </template>
        </div>
        <p data-ref="error-point" role="alert" class="m-0 text-sm text-destructive" hidden></p>
      </div>
    </section>

    <section class="flex flex-col gap-4" aria-labelledby="checkout-payment">
      <div class="flex flex-col gap-1">
        <h2 id="checkout-payment" class="m-0 font-heading weight-heading tracking-heading text-xl text-heading">Платёжная система</h2>
        <p class="m-0 text-sm text-muted-foreground">Все транзакции безопасны и зашифрованы. Карту вы введёте на странице оплаты</p>
      </div>
      <div data-ref="payment-methods" role="radiogroup" aria-label="Способ оплаты" class="flex flex-col gap-1">
        <template>
          <button type="button" role="radio" data-ref="method" data-action="checkout.selectPayment" class="flex min-h-12 w-full cursor-pointer items-center gap-3 bg-transparent p-0 text-left text-base text-foreground">
            <span class="flex size-5 shrink-0 items-center justify-center rounded-full border-width-input border-input in-aria-checked:border-foreground in-aria-checked:bg-foreground" aria-hidden="true"><span class="size-2 rounded-full bg-background"></span></span>
            <span data-ref="method-title" class="flex-1"></span>
          </button>
        </template>
      </div>
      <p data-ref="payment-unavailable" role="alert" class="m-0 text-sm text-destructive" hidden>Оплата сейчас недоступна</p>
      <p data-ref="error-payment" role="alert" class="m-0 text-sm text-destructive" hidden></p>
    </section>

    <div class="flex flex-col gap-4">
      <p data-ref="sign-in-note" class="m-0 text-sm text-destructive" hidden>Войдите в аккаунт по ссылке или коду из письма, чтобы оформить заказ.</p>
      <p data-ref="submit-error" role="alert" class="m-0 text-sm text-destructive" hidden></p>
      <button type="submit" data-ref="pay" class="inline-flex h-14 w-full cursor-pointer items-center justify-center gap-2 rounded-button border-width-button border-primary-border bg-primary px-6 text-base text-primary-foreground shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground aria-busy:cursor-wait aria-busy:opacity-70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring">
        <svg data-ref="pay-loading" class="size-5 motion-safe:animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true" hidden><circle class="opacity-30" cx="12" cy="12" r="9" stroke-width="2" /><path d="M21 12a9 9 0 0 0-9-9" stroke-width="2" stroke-linecap="round" /></svg>
        <span data-ref="pay-text">Оплатить</span>
      </button>
      <p class="m-0 text-xs text-muted-foreground">
        Размещая заказ, вы соглашаетесь с
        {shop.policies.some((policy) => policy.type === 'tos') ? <a class="text-muted-foreground underline underline-offset-4 hover:text-foreground" href={shop.policies.find((policy) => policy.type === 'tos')?.url}>Условиями обслуживания</a> : 'Условиями обслуживания'},
        {shop.policies.some((policy) => policy.type === 'privacy') ? <a class="text-muted-foreground underline underline-offset-4 hover:text-foreground" href={shop.policies.find((policy) => policy.type === 'privacy')?.url}>Политикой конфиденциальности</a> : 'Политикой конфиденциальности'}
        и
        {shop.policies.some((policy) => policy.type === 'privacy') ? <a class="text-muted-foreground underline underline-offset-4 hover:text-foreground" href={shop.policies.find((policy) => policy.type === 'privacy')?.url}>Политикой использования файлов cookie</a> : 'Политикой использования файлов cookie'}.
      </p>
    </div>
  </form>

  <aside
    data-ref="summary"
    aria-label="Сводка заказа"
    class:list={['flex min-w-0 flex-col gap-6 md:w-full md:max-w-120', settings['color-scheme'] && `color-${settings['color-scheme']} rounded-card bg-background p-6`]}
  >
    <p data-ref="lines-empty" class="m-0 text-base text-muted-foreground" hidden>В корзине пока пусто. <a class="text-foreground underline underline-offset-4" href="/catalog">Перейти в каталог</a></p>
    <div data-ref="lines" class="flex flex-col gap-4">
      <template>
        <div class="flex items-start gap-4">
          <span class="relative flex size-16 shrink-0 items-center justify-center rounded-media bg-muted text-muted-foreground">
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /></svg>
            <img data-ref="image" alt="" class="absolute inset-0 size-full rounded-media object-cover" />
            <span data-ref="quantity" class="absolute -right-2 -top-2 flex size-5 items-center justify-center rounded-full bg-foreground text-xs text-background tabular-nums"></span>
          </span>
          <span class="flex min-w-0 flex-1 flex-col gap-1">
            <span data-ref="title" class="text-sm text-heading"></span>
            <span data-ref="options" class="text-xs text-muted-foreground"></span>
          </span>
          <span data-ref="price" class="shrink-0 text-sm text-heading"></span>
        </div>
      </template>
    </div>
    <div data-ref="promo" class="flex flex-col gap-2">
      <div data-ref="promo-form" class="flex gap-3">
        <label class="sr-only" for="checkout-promo">Промокод</label>
        <input id="checkout-promo" data-ref="promo-code" type="text" autocomplete="off" placeholder="У меня есть промокод" class="h-12 min-w-0 flex-1 rounded-input border-width-input border-input bg-background px-4 text-base text-foreground placeholder:text-muted-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" />
        <button type="button" data-ref="promo-apply" data-action="promo" class="inline-flex h-12 shrink-0 cursor-pointer items-center justify-center rounded-button border-width-button border-primary-border bg-primary px-5 text-sm text-primary-foreground shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground">Применить</button>
      </div>
      <div data-ref="promo-applied" class="flex items-center justify-between gap-3 text-sm" hidden>
        <span>Промокод <span data-ref="promo-name" class="text-heading"></span></span>
        <button type="button" data-action="checkout.removePromo" class="inline-flex min-h-11 cursor-pointer items-center bg-transparent p-0 text-sm text-muted-foreground underline underline-offset-4 hover:text-foreground">Убрать</button>
      </div>
      <p data-ref="promo-error" role="alert" class="m-0 text-sm text-destructive" hidden></p>
    </div>
    <div class="flex flex-col gap-3 text-base">
      <p data-ref="discount-row" class="m-0 flex justify-between gap-4 text-sale" hidden><span data-ref="discount-name">Скидка</span><span data-ref="discount"></span></p>
      <p class="m-0 flex justify-between gap-4"><span>Доставка</span><span data-ref="shipping" class="text-heading">—</span></p>
      <p class="m-0 flex items-baseline justify-between gap-4 font-heading text-2xl text-heading"><span>Итого</span><span data-ref="total" class="tabular-nums">—</span></p>
    </div>
  </aside>
</div>
