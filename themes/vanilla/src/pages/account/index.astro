---
import Layout from '../../layouts/Layout.astro';

const shopId = "";
const apiUrl = import.meta.env.PUBLIC_MERFY_API_URL ?? "https://gateway.merfy.ru/api";
---
<Layout title="Учётная запись">
  <script is:inline define:vars={{ shopId, apiUrl }}>
    window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || {
      shopId: shopId || "",
      apiUrl: apiUrl || "https://gateway.merfy.ru/api",
    };
  </script>

  <div class="account-page-container" style="padding-top: 7rem;">
    <div class="account-title">
      <h1>Учётная запись</h1>
      <span class="account-subtitle" id="account-email">Загрузка...</span>
    </div>

    <nav class="account-nav-links" id="account-nav">
      <a href="/account/profile" class="active">Основные данные</a>
      <a href="/account/orders">Мои заказы</a>
    </nav>

    <button type="button" class="account-text-link" id="btn-logout">Выйти из аккаунта</button>

    {/* PR-19 — точка расширений «Личный кабинет» (модуль расширения
        магазина). AccountLayout (theme-base) сегодня ни к одной странице не
        подключён — разметку кабинета несёт эта страница, поэтому во всех
        пяти темах здесь стоит ОДНА И ТА ЖЕ строка монтирования. */}
    <div id="account-extensions" data-ext-point="account"></div>
  </div>

  <script>
    import { navTo, fetchMe, logout, getToken } from '../../lib/auth';

    async function initAccountPage() {
      const root = document.getElementById('account-nav');
      if (!root || root.dataset.bound === 'true') return;
      root.dataset.bound = 'true';

      if (!getToken()) {
        navTo('/login');
        return;
      }

      const emailEl = document.getElementById('account-email');
      const logoutBtn = document.getElementById('btn-logout');

      const customer = await fetchMe();
      if (!customer) {
        navTo('/login');
        return;
      }
      if (emailEl) emailEl.textContent = customer.email || '';

      logoutBtn?.addEventListener('click', async () => {
        await logout();
        navTo('/login');
      });
    }

    initAccountPage();
    document.addEventListener('astro:page-load', initAccountPage);
  </script>

  <script>
    // PR-19 — точка расширений «Личный кабинет» (см. runtime/extension-points.ts,
    // тот же mountExtensionPoint, что у theme-base блоков; themes/<t> напрямую
    // импортирует theme-base по прецеденту checkout.astro/cart.astro).
    import { mountExtensionPoint } from '../../../../../packages/theme-base/runtime/extension-points';
    import { getToken } from '../../lib/auth';

    function mountAccountExtensions(): void {
      const el = document.getElementById('account-extensions');
      if (!el) return;
      const w = window as unknown as { __MERFY_CONFIG__?: { shopId?: string; storeId?: string } };
      const storeId = (w.__MERFY_CONFIG__ && (w.__MERFY_CONFIG__.shopId || w.__MERFY_CONFIG__.storeId)) || '';
      void mountExtensionPoint(el, { point: 'account', storeId, authToken: getToken() || '' });
    }

    mountAccountExtensions();
    document.addEventListener('astro:page-load', mountAccountExtensions);
  </script>
</Layout>
