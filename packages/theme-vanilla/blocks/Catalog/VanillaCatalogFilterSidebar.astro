---
/**
 * Боковые фильтры каталога Vanilla (Figma Vanila / textile) — sibling блока Catalog.
 * Разметка фильтров; гидрация (is:inline в Catalog.astro) вешает обработчики на
 * radio наличия/сортировки и значения «Стоимости», поэтому здесь только UI.
 *
 * Классы радио/заголовков/«Стоимости» — общие с рядом дропдаунов top-вида
 * (./filter-classes); цвета — токены схем конструктора rgb(var(--color-*))
 * с фолбэками на родную палитру vanilla.
 *
 * Порт из themes/vanilla/src/components/catalog/VanillaCatalogFilterSidebar.astro.
 *
 * Сворачивание групп (владелец: «возможность скрывать и раскрывать список
 * фильтров, все темы»). Заголовок каждой группы — `<button
 * data-nt="filter-group-toggle" aria-expanded>`, список — соседний элемент
 * `data-filter-group-body`: клик переключает aria-expanded + атрибут
 * hidden списка. Обработчик клика — общий делегированный <script is:inline>
 * в Catalog.astro (window.__merfyFilterGroups, тот же текст у всех пяти тем).
 * Правило видимости `[data-filter-group-body][hidden]` — в общем
 * packages/theme-base/styles/catalog-filters.css. Старт — всегда развёрнуто,
 * состояние между заходами не хранится.
 *
 * ВАЖНО: внутренний текст группы остаётся в отдельном <span> без детей —
 * Catalog.astro (cloneColorBox) находит его по тексту и переименовывает в
 * клонах групп параметров товара (Оттенок/Размер).
 */
import {
	CATALOG_FILTER_TITLE,
	CATALOG_PRICE_ROW,
	CATALOG_PRICE_VALUE,
	CATALOG_PRICE_WRAP,
	CATALOG_RADIO_CIRCLE,
	CATALOG_RADIO_TEXT,
} from "./filter-classes";

interface RadioOption {
	value: string;
	label: string;
	checked?: boolean;
}

interface Props {
	class?: string;
	/**
	 * Приставка имён и id радио. У шторки «Фильтры и сортировка» на телефоне
	 * свой экземпляр сайдбара: с теми же именами его радио слились бы в одну
	 * группу с радио раскладки «Сбоку», а подписи кликали бы чужие поля.
	 */
	namePrefix?: string;
	/** Показывать «Сортировать» (настройка секции «Сортировка»). */
	showSort?: boolean;
	/** Показывать фильтры: коллекции, наличие, стоимость, цвет (настройка «Фильтры»). */
	showFilters?: boolean;
}

const {
	class: className = "",
	namePrefix = "vanilla",
	showSort = true,
	showFilters = true,
} = Astro.props;

// «Сортировать» — 4 пункта, как в макете боковых фильтров (493:5523 / 493:5524):
// «По популярности» первым и выбрано. Скрипт каталога понимает popularity.
const sortOptions: RadioOption[] = [
	{ value: "popularity", label: "По популярности", checked: true },
	{ value: "new", label: "По новизне" },
	{ value: "price-desc", label: "По убыванию цены" },
	{ value: "price-asc", label: "По возрастанию цены" },
];

const stockOptions: RadioOption[] = [
	{ value: "all", label: "Все", checked: true },
	{ value: "in", label: "В наличии" },
	{ value: "out", label: "Распродано" },
];

const groupToggleClass = `${CATALOG_FILTER_TITLE} flex w-full cursor-pointer items-center justify-between gap-2 border-0 bg-transparent p-0 text-left`;
const chevronClass = "h-[6px] w-[10px] shrink-0 text-[rgb(var(--color-muted,153_153_153))]";
---

<aside
	class:list={["flex w-full max-w-full shrink-0 flex-col gap-3 lg:w-[294px]", className]}
	data-nt="filter-sidebar"
>
	{/* Фильтр по коллекциям: скрыт на demo-сборке, гидрация (Catalog.astro)
	    показывает его при наличии коллекций магазина и уважает ?collection= из
	    ссылок тайлов Collections/Gallery. Манера = radio-секции сайдбара ниже. */}
	{showFilters && (
	<div class="flex flex-col gap-3 py-3" data-nt="catalog-collections-filter" style="display:none;">
		<button type="button" class={groupToggleClass} data-nt="filter-group-toggle" aria-expanded="true" aria-controls={`${namePrefix}-fg-collections`}>
			<span>Коллекции</span>
			<svg aria-hidden="true" viewBox="0 0 10 6" class={chevronClass} data-nt="filter-group-chevron"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
		</button>
		<div data-collections-options data-filter-group-body id={`${namePrefix}-fg-collections`} class="flex flex-col gap-3"></div>
	</div>
	)}

	{showSort && (
	<div class="flex flex-col gap-3 py-3">
		<button type="button" class={groupToggleClass} data-nt="filter-group-toggle" aria-expanded="true" aria-controls={`${namePrefix}-fg-sort`}>
			<span>Сортировать</span>
			<svg aria-hidden="true" viewBox="0 0 10 6" class={chevronClass} data-nt="filter-group-chevron"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
		</button>
		<div class="flex flex-col gap-3" data-filter-group-body id={`${namePrefix}-fg-sort`}>
			{
				sortOptions.map((option) => {
					const id = `${namePrefix}-sort-${option.value}`;
					return (
						<label for={id} class="group flex cursor-pointer items-center gap-2">
							<input
								id={id}
								type="radio"
								name={`${namePrefix}-sort`}
								value={option.value}
								checked={option.checked}
								class="peer sr-only"
							/>
							<span aria-hidden="true" class={CATALOG_RADIO_CIRCLE} />
							<span class={CATALOG_RADIO_TEXT}>{option.label}</span>
						</label>
					);
				})
			}
		</div>
	</div>
	)}

	{showFilters && (
	<>
	<div class="flex flex-col gap-3 py-3">
		<button type="button" class={groupToggleClass} data-nt="filter-group-toggle" aria-expanded="true" aria-controls={`${namePrefix}-fg-stock`}>
			<span>Наличие</span>
			<svg aria-hidden="true" viewBox="0 0 10 6" class={chevronClass} data-nt="filter-group-chevron"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
		</button>
		<div class="flex flex-col gap-3" data-filter-group-body id={`${namePrefix}-fg-stock`}>
			{
				stockOptions.map((option) => {
					const id = `${namePrefix}-stock-${option.value}`;
					return (
						<label for={id} class="group flex cursor-pointer items-center gap-2">
							<input
								id={id}
								type="radio"
								name={`${namePrefix}-stock`}
								value={option.value}
								checked={option.checked}
								class="peer sr-only"
							/>
							<span aria-hidden="true" class={CATALOG_RADIO_CIRCLE} />
							<span class={CATALOG_RADIO_TEXT}>{option.label}</span>
						</label>
					);
				})
			}
		</div>
	</div>

	<div class="flex flex-col gap-3 py-3">
		<button type="button" class={groupToggleClass} data-nt="filter-group-toggle" aria-expanded="true" aria-controls={`${namePrefix}-fg-price`}>
			<span>Стоимость</span>
			<svg aria-hidden="true" viewBox="0 0 10 6" class={chevronClass} data-nt="filter-group-chevron"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
		</button>
		{/* data-nt="catalog-price" — по нему скрипт каталога (bindPrice) меняет
		    «0 / 5 990» на поля ввода. У боковой панели метки не было: при виде
		    фильтра «Сбоку» цену нельзя было ввести (владелец 23.09: «фильтрам и
		    сортировке…»; замер превью — полей ввода 0, у остальных тем 2). */}
		<div class={CATALOG_PRICE_WRAP} data-nt="catalog-price" data-filter-group-body id={`${namePrefix}-fg-price`}>
			<div class={CATALOG_PRICE_ROW}>
				<span>от</span>
				<div class={CATALOG_PRICE_VALUE}>
					<span>0</span>
					<span>₽</span>
				</div>
			</div>
			<div class={CATALOG_PRICE_ROW}>
				<span>до</span>
				<div class={CATALOG_PRICE_VALUE}>
					<span>5 990</span>
					<span>₽</span>
				</div>
			</div>
		</div>
	</div>

	{/* Фильтр по цвету (макет «Фильтры/Сбоку» 493:5523): скрыт, пока нет данных.
	    Гидрация (Catalog.astro) показывает его, если у товаров магазина есть
	    группа «Цвет» (/api/store/filters), и рисует радио «Все» + цвета. */}
	<div class="flex flex-col gap-3 py-3" data-nt="catalog-color-filter" style="display:none;">
		<button type="button" class={groupToggleClass} data-nt="filter-group-toggle" aria-expanded="true" aria-controls={`${namePrefix}-fg-color`}>
			<span>Цвет</span>
			<svg aria-hidden="true" viewBox="0 0 10 6" class={chevronClass} data-nt="filter-group-chevron"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
		</button>
		<div data-color-options data-filter-group-body id={`${namePrefix}-fg-color`} class="flex flex-col gap-3"></div>
	</div>
	</>
	)}
</aside>
