{
  "sdk": 1,
  "name": "slideshow",
  "kind": "section",
  "title": "Слайд-шоу",
  "settings": [
    { "id": "heading", "label": "Заголовок", "setting": { "kind": "string", "default": "Подборки" } },
    {
      "id": "autoplay",
      "label": "Листать сами",
      "setting": { "kind": "toggle", "default": true, "labels": { "on": "Листать", "off": "Не листать" } }
    }
  ],
  "blocks": {
    "slide": {
      "title": "Слайд",
      "limit": 6,
      "settings": [
        { "id": "subheading", "label": "Заголовок слайда", "setting": { "kind": "string", "default": "Новый слайд" } },
        { "id": "text", "label": "Текст слайда", "setting": { "kind": "text", "default": "Коротко о слайде" } }
      ]
    }
  },
  "defaultBlocks": [
    { "type": "slide", "settings": { "subheading": "Новинки", "text": "Свежие поступления — первыми в каталоге." } },
    { "type": "slide", "settings": { "subheading": "Любимое покупателей", "text": "Товары, которые чаще всего берут в подарок и для себя." } },
    { "type": "slide", "settings": { "subheading": "Доставка", "text": "Способ и срок доставки выберете при оформлении заказа." } }
  ]
}
