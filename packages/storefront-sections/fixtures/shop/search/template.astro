---
const { shop } = Astro.props;
---
<!-- Значки — Lucide (search, x, image), лицензия ISC, lucide.dev/license. -->
<!-- Окно открывает событие поиска (лупа «Шапки» — data-action="search.open"), ставится под шапкой страницы, где бы ни стояла секция. -->
<div data-behavior="dialog" data-transition="drop" data-modal="false" data-anchor="header" data-open-on="search-open">
  <dialog class="m-0 w-full max-w-none border-0 border-b border-border bg-popover px-4 py-5 text-popover-foreground shadow-popover" data-part="content" aria-label="Поиск">
    <div class="mx-auto flex max-w-page items-start gap-2 font-body">
      <div class="flex min-w-0 flex-1 flex-col gap-4" data-behavior="search" data-limit="8">
        <form class="relative m-0" method="get" action={shop.catalogUrl ?? undefined} role="search">
          <svg class="pointer-events-none absolute left-4 top-1/2 size-5 -translate-y-1/2 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
          <input class="h-12 w-full rounded-input border-width-input border-input bg-background pl-12 pr-4 text-base text-foreground shadow-input focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" data-part="input" type="search" name="q" placeholder="Поиск" aria-label="Поиск по магазину" autocomplete="off" />
        </form>
        <ul class="m-0 grid list-none gap-1 p-0 md:grid-cols-2" data-part="results"></ul>
        <template data-part="item">
          <li>
            <a class="flex min-h-11 items-center gap-4 rounded-card p-2 text-foreground no-underline hover:bg-accent hover:text-accent-foreground" data-part="link">
              <span class="relative flex size-14 shrink-0 items-center justify-center overflow-hidden rounded-media bg-muted text-muted-foreground">
                <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /></svg>
                <img class="absolute inset-0 size-full object-cover" data-part="image" alt="" />
              </span>
              <span class="flex min-w-0 flex-1 flex-col gap-1">
                <span class="line-clamp-2 text-sm" data-part="title"></span>
                <span class="flex flex-wrap items-baseline gap-x-2">
                  <span class="text-sm weight-heading text-price" data-part="price"></span>
                  <s class="text-xs text-price-old" data-part="compare"></s>
                </span>
              </span>
            </a>
          </li>
        </template>
        <p class="m-0 py-4 text-center text-sm text-muted-foreground" data-part="empty" hidden>Ничего не нашли. Попробуйте другое слово.</p>
        {shop.catalogUrl && (
          <a class="inline-flex h-11 items-center justify-center self-center rounded-button border-width-input border-border px-6 text-sm text-foreground no-underline hover:bg-accent hover:text-accent-foreground" data-part="all" href={shop.catalogUrl} hidden>Все результаты</a>
        )}
      </div>
      <button type="button" class="inline-flex size-12 shrink-0 items-center justify-center rounded-button bg-transparent p-0 text-foreground hover:bg-accent hover:text-accent-foreground" data-part="close" aria-label="Закрыть поиск">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg>
      </button>
    </div>
  </dialog>
</div>
