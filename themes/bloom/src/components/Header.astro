---
import NtIcon from "@merfy-dropshipping-platform/design-systems-theme/components/ui/NtIcon.astro";
import SchemeIcon from "../../../../packages/theme-base/primitives/SchemeIcon.astro";
import { BLOOM_ICON_SVGS } from "./icons/bloom-icon-svgs";
import NtPromoBanner from "@merfy-dropshipping-platform/design-systems-theme/components/ui/NtPromoBanner.astro";
import NavItem from "./NavItem.astro";
import { NAV_SUBMENU_TOGGLE_SOURCE } from "../../../../packages/theme-base/runtime/nav-submenu-toggle";
import { SITE_TITLE } from "../consts";
import { DEFAULT_CATEGORY_HREF, categoryPages, getCategoryBySlug } from "../data/categories";
import { getProductById } from "../data/products";

interface NavLink {
	label: string;
	href: string;
	submenu?: NavLink[];
	match?: (pathname: string) => boolean;
}

function pathnameBase(pathname: string): string {
	const base = pathname.replace(/\/+$/, "");
	return base === "" ? "/" : base;
}

function categoryHrefFromProduct(pathname: string): string | null {
	const match = pathname.match(/^\/products\/([^/]+)$/);
	if (!match?.[1]) return null;
	const product = getProductById(match[1]);
	return product ? (getCategoryBySlug(product.category)?.href ?? null) : null;
}

const defaultNav: NavLink[] = [
	...categoryPages.map((category) => ({
		label: category.label,
		href: category.href,
		match: (path: string) => path === category.href || categoryHrefFromProduct(path) === category.href,
	})),
	{ label: "О нас", href: "/about", match: (path) => path.startsWith("/about") },
];

// ОЖИВЛЕНИЕ (Фаза B, объём rose Header): канон-схема theme-base Header.puckConfig —
// siteTitle, navigationLinks, logo, logoPosition, stickiness, padding. Тело ниже —
// verbatim верстальщика; дефолтные ветки тернарников = прежним строкам байт-в-байт.
interface Props {
	promo?: boolean;
}
const { promo = true } = Astro.props as Props & Record<string, unknown>;
const p = Astro.props as Record<string, any>;
const id = p.id;
// Своя colorScheme на корне: при hot-render одиночного блока в превью обёртки
// композитора нет → шапка берёт :root и «перекрашивается» от правки чужой
// секции. На live обёртка даёт ту же схему, дубль безвреден.
// colorScheme приходит строкой ("scheme-4") ИЛИ числом (нормализатор Slideshow
// приводит к номеру) — разбираем оба вида, иначе класс молча не ставится.
const _rawScheme = p.colorScheme;
const _schemeId =
	typeof _rawScheme === "number"
		? String(_rawScheme)
		: typeof _rawScheme === "string" && _rawScheme
			? String(_rawScheme).replace("scheme-", "")
			: "";
const selfSchemeClass = _schemeId ? ` color-scheme-${_schemeId}` : "";
// Пустая строка (впрыск коэрсера live-пути) не должна гасить название магазина.
const siteTitle = typeof p.siteTitle === "string" && p.siteTitle.trim() ? p.siteTitle : SITE_TITLE;
const mapNavLink = (l: any): NavLink => ({
	label: l.label ?? l.text ?? "",
	href: l.href ?? l.link ?? "/",
	submenu: Array.isArray(l.submenu) ? l.submenu.map(mapNavLink) : undefined,
});
const nav: NavLink[] =
	Array.isArray(p.navigationLinks) && p.navigationLinks.length > 0
		? p.navigationLinks.map(mapNavLink)
		: defaultNav;

// Канон promoBar (как theme-base Header / flux Header.puckConfig).
const promoBar = p.promoBar as
	| { enabled?: boolean | string; text?: string; linkText?: string; linkHref?: string }
	| undefined;
const promoEnabled = promoBar?.enabled === true || promoBar?.enabled === "true";
const promoText = (promoBar?.text || "").trim();
const promoLinkText = (promoBar?.linkText || "").trim();
const promoLinkHref = promoBar?.linkHref || "/";
const showPromoBar = promo && promoEnabled && promoText.length > 0;

// Канон logo: placeholder «/logo.svg» не существует на сторфронте (404) → не рендерим
// битую картинку; реальные загрузки лежат в /branding/.../logo-*.svg.
const rawLogo = typeof p.logo === "string" ? p.logo.trim() : "";
let logoPath = "";
try {
	logoPath = new URL(rawLogo, "https://_merfy_").pathname;
} catch {
	logoPath = rawLogo;
}
// Без загруженного логотипа показываем НАЗВАНИЕ МАГАЗИНА (siteTitle), а не
// картинку темы: логотип «Bloom» — это имя шаблона, у магазина мерчанта своё.
// Так же поступает rose (текстовый логотип, как у верстальщика).
// Логотипом магазина считаем только загруженный мерчантом файл (лежит в
// /branding/…). Плейсхолдер «/logo.svg» и картинки самой темы (/icons/…,
// например /icons/Bloom.svg) — это НЕ бренд магазина: с ними в шапке у
// любого мерчанта стояло чужое имя «Bloom». Без своего файла показываем
// siteTitle текстом (так же поступает rose).
const isThemeAsset = logoPath === "/logo.svg" || logoPath.startsWith("/icons/");
const logo = rawLogo && !isThemeAsset ? rawLogo : undefined;
const logoImgCls = "h-[var(--size-logo-width,19px)] w-auto max-w-[160px] object-contain";

// Канон logoPosition: 'top-center' (canon-default) → TWO rows: row1=grid [распорка|logo|search+icons],
// row2=nav centered (ЛИТЕРАЛ верстальщика, пиксель-перфект).
// 'top-left' → TWO rows: row1=flex [logo LEFT + icons RIGHT], row2=nav LEFT.
// 'center-left' → ONE row: [logo LEFT] [nav CENTER] [icons RIGHT].
// 'center-absolute' → ONE row: nav LEFT, logo ABSOLUTE-center, icons RIGHT.
const logoPosition = typeof p.logoPosition === "string" ? p.logoPosition : "";
const isTwoRow = logoPosition === "top-left" || logoPosition === "top-center";

// Канон stickiness none/scroll-up/always (паритет rose Header.classes.ts:13-16).
// 'always' → sticky; 'scroll-up' → sticky + прячем при скролле вниз/показываем
// вверх; 'none'/отсутствие/неизвестное → НЕ sticky (корень w-full без sticky).
// 'scroll-up' скрипт: is:inline через data-атрибут (компилятор секций не умеет
// define:vars), идемпотентность через data-hydrated.
const stickiness = typeof p.stickiness === "string" ? p.stickiness : "";
const rootCls =
	stickiness === "always"
		? "sticky top-0 z-50 w-full"
		: stickiness === "scroll-up"
			? "sticky top-0 z-50 w-full transition-transform duration-300"
			: "relative z-50 w-full";
const SCROLL_UP_JS = [
	"(function(){",
	"var root=document.querySelector('[data-bloom-sticky=\"scroll-up\"]');",
	"if(!root||root.getAttribute('data-hydrated')==='true')return;",
	"root.setAttribute('data-hydrated','true');",
	"var last=window.scrollY;",
	"window.addEventListener('scroll',function(){",
	"var y=window.scrollY;",
	"if(y>last&&y>root.offsetHeight){root.style.transform='translateY(-100%)';}else{root.style.transform='';}",
	"last=y;",
	"},{passive:true});",
	"})();",
].join("");

// Канон padding {top,bottom} — clamp ≤64 на носителе отступов верстальщика
// (desktop-контейнер py-6; мобильная строка h-16 фиксированная). blockDefaults
// {16,16} = canon-default → ЛИТЕРАЛ py-6; inline-стиль только при ином значении.
const pad = p.padding && typeof p.padding === "object" ? p.padding : undefined;
const isCanonPad = pad && Number(pad.top) === 16 && Number(pad.bottom) === 16;
const headerPad =
	pad && !isCanonPad
		? { top: Math.min(Number(pad.top) || 0, 64), bottom: Math.min(Number(pad.bottom) || 0, 64) }
		: undefined;
const headerPadStyle = headerPad
	? `padding-top:${headerPad.top}px;padding-bottom:${headerPad.bottom}px;`
	: undefined;
// Two-row outer wrapper (top-left / top-center): flex-col, same padding as original.
const desktopTwoRowWrapCls = headerPad
	? "relative mx-auto hidden w-full max-w-[1920px] px-20 md:flex 2xl:px-[300px]"
	: "relative mx-auto hidden w-full max-w-[1920px] px-20 py-6 md:flex 2xl:px-[300px]";
// Single-row outer wrapper (center-left / center-absolute): single flex row.
// Позиционированного предка здесь больше нет НИ В ОДНОМ положении: плашка
// «Расширенного» меню считает края от ближайшего позиционированного предка, и с
// ним она получалась уже шапки и налезала на строку пунктов (замер 1440: лист
// 1280 при шапке 1440, накрыты все пункты верхнего уровня — ровно жалоба из
// пункта 26 документа владельца). Логотип «по центру» центрируется гридом
// [1fr auto 1fr], а не `absolute`, поэтому якорем плашки остаётся сам <header>.
const needsPositionedRow = logoPosition === "center-absolute";
const desktopSingleRowWrapCls = headerPad
	? "mx-auto hidden w-full max-w-[1920px] items-center px-20 md:flex 2xl:px-[300px]"
	: "mx-auto hidden w-full max-w-[1920px] items-center px-20 py-6 md:flex 2xl:px-[300px]";

const pathname = pathnameBase(Astro.url.pathname);
// Поиск по магазину ведёт в КАТАЛОГ, а не на демо-страницу темы.
// Вёрстка верстальщиков искала внутри своей категории (/skin-care и т.п.),
// но у настоящего магазина таких страниц нет: запрос уходил мимо каталога,
// и поиск не фильтровал ничего (баг тестера, перепроверено 20.09).
// Каталог умеет ?q= — см. порты Catalog и /api/store/products.
const categorySearchAction = "/catalog";
const isActive = (link: NavLink) => (link.match ? link.match(pathname) : pathname === link.href);

// Канон menuType: 'dropdown' (по умолчанию) / 'mega-menu' (Расширенное) / 'sidebar' (Боковое).
// Для mega-menu добавляем uppercase + tracking к десктопным ссылкам нав-меню.
// Для sidebar — десктопный inline-nav скрыт, показывается hamburger → правая шторка.
const menuType = typeof p.menuType === "string" ? p.menuType : "dropdown";
const isMegaMenu = menuType === "mega-menu";
const isSidebar = menuType === "sidebar";
const megaLinkCls = "";

// Канал var(--size-nav-link) СНЯТ (владелец, 16.09 — «верни типографику»).
// 21473d98 подключил ползунок «Кегль пунктов меню» к рендеру; на тестовом
// стенде f7593c5f8f8f настройка уже стояла нештатно (14px) — после подключения
// живые пункты меню поехали на неё, хотя дефолт темы (16px) не менялся ни на
// пиксель. Пункт меню снова читает ТОЛЬКО литерал вёрстки (16px), как у
// flux/satin/vanilla — их «Кегль пунктов меню» тоже не подключён к рендеру.
const navLinkCls = [
	"font-inter text-[16px] font-light leading-[100%] text-[rgb(var(--color-text,0_0_0))] transition-opacity hover:opacity-70",
	megaLinkCls,
]
	.filter(Boolean)
	.join(" ");

// Канон menuColorScheme: опциональная отдельная цветовая схема для десктопного <nav>.
// При задании — добавляем класс color-scheme-<X> к обёртке <nav>.
// Схему платформа отдаёт строкой ("scheme-1") ИЛИ числом (1): нормализатор
// `page-blocks` приводит к числу только `colorScheme`, а `menuColorScheme`
// доезжает как есть. Проверка «только строка» молча не срабатывала на числе —
// и один и тот же магазин получал <nav> со схемой на внутренних страницах и без
// неё на главной (замер flux 2026-09-13). Канон взят из satin (Header.astro:103).
const _menuSchemeStr = (v: unknown): string =>
	typeof v === "number" ? String(v) : typeof v === "string" ? v : "";
const menuColorScheme = _menuSchemeStr(p.menuColorScheme);
const menuSchemeClass = menuColorScheme ? `color-scheme-${menuColorScheme.replace("scheme-", "")}` : "";

// Размер иконок десктопной шапки = ЭТАЛОН ВЕРСТАЛЬЩИКОВ: кнопка-обёртка size-8
// (32px), иконка внутри size-5 (20px) — сверено с canon-sections/header.html,
// где Поиск/Корзина/Аккаунт несут ровно `size-5`. Было size-6 (24px): жалоба
// владельца 20.09 «иконки большие». Мобильная строка (md:hidden) свой размер
// не меняет. Сторож: src/themes/__tests__/bloom-header-canon.spec.ts.

// Outline-сердце избранного в шапке (SSR-дефолт). Геометрия = универсальный heart-path
// (как rose public/icons/favourite.svg), зеркалит wishlist.ts heartSvg(false). Инлайн-SVG
// (НЕ <img> NtIcon) — глобальный делегат initWishlistUI (Layout) переключает fill на filled
// если есть избранное. Размер несёт обёртка [data-wishlist-icon] (size-5, как иконка корзины).
const headerHeartSvg =
	'<svg viewBox="0 0 17.4 15.4" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block">' +
	'<path d="M7.428 14.2615C5.172 12.5239 0.7 8.55212 0.7 4.97729C0.7 2.61547 2.384 0.7 4.7 0.7C5.9 0.7 7.1 1.11175 8.7 2.75876C10.3 1.11175 11.5 0.7 12.7 0.7C15.016 0.7 16.7 2.61547 16.7 4.97729C16.7 8.5513 12.228 12.5239 9.972 14.2615C9.212 14.8462 8.188 14.8462 7.428 14.2615Z" ' +
	'fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>' +
	"</svg>";
---

<div
	class={rootCls + selfSchemeClass}
	data-bloom-header
	data-puck-component-id={id}
	data-bloom-sticky={stickiness === "scroll-up" ? "scroll-up" : undefined}
>
	{
		showPromoBar && (
			<div data-bloom-announcement>
				<NtPromoBanner
					text={promoText}
					link={promoLinkHref}
					linkText={promoLinkText || undefined}
				/>
			</div>
		)
	}

	<header class="relative w-full overflow-visible border-b border-[#F5F5F5] bg-[rgb(var(--color-bg,255_255_255))]" data-nt="bloom-header">
		<!-- Mobile -->
		<div class="relative z-[60] flex h-16 items-center justify-between bg-[rgb(var(--color-bg,255_255_255))] px-4 md:hidden">
			<button
				type="button"
				id="bloom-burger-btn"
				data-burger-toggle
				class="flex size-8 items-center justify-center transition-opacity hover:opacity-70"
				aria-label="Меню"
				aria-expanded="false"
				aria-controls="bloom-burger"
			>
				<span class="burger-icon" data-icon="open">
					<SchemeIcon svgs={BLOOM_ICON_SVGS} iconBasePath="/icons" name="menu-burger" sizeClass="size-5" />
				</span>
				<span class="burger-icon hidden" data-icon="close">
					<SchemeIcon svgs={BLOOM_ICON_SVGS} iconBasePath="/icons" name="menu-close" sizeClass="size-5" />
				</span>
			</button>
			<a href="/" class="flex items-center hover:opacity-80" aria-label={siteTitle}>
				{
					logo ? (
						<img src={logo} alt={siteTitle} class={logoImgCls} />
					) : (
						<span class="shrink-0 font-comfortaa text-[length:var(--size-logo-width,19px)] font-normal leading-none tracking-normal text-[rgb(var(--color-heading,227_142_159))] hover:opacity-90">{siteTitle}</span>
					)
				}
			</a>
			<div class="flex items-center gap-4">
				<button
					type="button"
					data-action="toggle-search"
					class="flex size-8 items-center justify-center rounded-[8px] transition-opacity hover:opacity-80"
					aria-label="Поиск"
					aria-expanded="false"
					aria-controls="bloom-search-panel"
				>
					<SchemeIcon svgs={BLOOM_ICON_SVGS} iconBasePath="/icons" name="search-sm" sizeClass="size-5" />
				</button>
				<a
					href="/wishlist"
					class="relative flex size-8 items-center justify-center rounded-[8px] transition-opacity hover:opacity-80"
					aria-label="Избранное"
				>
					<span data-wishlist-icon class="block size-5 text-[rgb(var(--color-text,0_0_0))]" set:html={headerHeartSvg}></span>
					{/* Цифра счётчика — роль схемы «Текст кнопки», а не `text-white`: белым
					   списком матрицы прикрыта только ПЛАШКА (её фирменный цвет —
					   узнаваемый вид темы), а цифра читаема на плашке любого цвета и
					   обязана следовать выбору мерчанта (решение владельца 15.09,
					   сужение исключения `counter-badge`). Фолбэк 255_255_255 —
					   прежний белый, вид без схемы не меняется. Сторож:
					   pnpm test:scheme-matrix. */}
					<span
						data-wishlist-count
						data-empty="true"
						class="absolute -right-2 -top-2 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-[#e38e9f] px-1 font-inter text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden"
					>0</span>
				</a>
				<button
					type="button"
					data-cart-open
					class="relative flex size-8 items-center justify-center rounded-[8px] transition-opacity hover:opacity-80"
					aria-label="Корзина"
				>
					<SchemeIcon svgs={BLOOM_ICON_SVGS} iconBasePath="/icons" name="cart" sizeClass="size-5" />
					<span
						data-cart-count
						data-empty="true"
						class="absolute -right-2 -top-2 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-[#e38e9f] px-1 font-inter text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden"
					>0</span>
				</button>
				<a href="/login" data-auth-link class="flex size-8 items-center justify-center rounded-[8px] transition-opacity hover:opacity-80" aria-label="Аккаунт">
					<SchemeIcon svgs={BLOOM_ICON_SVGS} iconBasePath="/icons" name="user" sizeClass="size-5" />
				</a>
			</div>
		</div>

		<!-- Desktop -->
		{isTwoRow ? (
			/* ── TWO-ROW LAYOUTS: top-left / top-center ── */
			<div class={desktopTwoRowWrapCls} style={headerPadStyle}>
				<div class="mx-auto flex w-full max-w-[1320px] flex-col gap-4">
					{logoPosition === "top-left" ? (
						/* top-left: Row1=[logo LEFT + icons RIGHT], Row2=[nav LEFT] */
						<>
							<div class="flex w-full items-center justify-between">
								<a href="/" class="flex items-center hover:opacity-90" aria-label={siteTitle}>
									{
										logo ? (
											<img src={logo} alt={siteTitle} class={logoImgCls} />
										) : (
											<span class="shrink-0 font-comfortaa text-[length:var(--size-logo-width,19px)] font-normal leading-none tracking-normal text-[rgb(var(--color-heading,227_142_159))] hover:opacity-90">{siteTitle}</span>
										)
									}
								</a>
								<div class="flex items-center gap-4">
									<button
										type="button"
										data-action="toggle-search"
										class="flex size-8 items-center justify-center rounded-[8px] transition-opacity hover:opacity-80"
										aria-label="Поиск"
										aria-expanded="false"
										aria-controls="bloom-search-panel"
									>
										<SchemeIcon svgs={BLOOM_ICON_SVGS} iconBasePath="/icons" name="search-sm" sizeClass="size-5" />
									</button>
									<a
										href="/wishlist"
										class="relative flex size-8 items-center justify-center rounded-[8px] transition-opacity hover:opacity-80"
										aria-label="Избранное"
									>
										<span data-wishlist-icon class="block size-5 text-[rgb(var(--color-text,0_0_0))]" set:html={headerHeartSvg}></span>
										<span
											data-wishlist-count
											data-empty="true"
											class="absolute -right-1 -top-1 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-[#E38E9F] px-1 font-inter text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden"
										>0</span>
									</a>
									<button
										type="button"
										data-cart-open
										class="relative flex size-8 items-center justify-center rounded-[8px] transition-opacity hover:opacity-80"
										aria-label="Корзина"
									>
										<SchemeIcon svgs={BLOOM_ICON_SVGS} iconBasePath="/icons" name="cart" sizeClass="size-5" />
										<span
											data-cart-count
											data-empty="true"
											class="absolute -right-1 -top-1 inline-flex h-4 min-w-[16px] items-center justify-center rounded-full bg-[#E38E9F] px-1 font-inter text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden"
										>0</span>
									</button>
									<a
										href="/login" data-auth-link
										class="flex size-8 items-center justify-center rounded-[8px] transition-opacity hover:opacity-80"
										aria-label="Аккаунт"
									>
										<SchemeIcon svgs={BLOOM_ICON_SVGS} iconBasePath="/icons" name="user" sizeClass="size-5" />
									</a>
									{isSidebar && (
										<button
											type="button"
											data-burger-toggle
											class="flex size-8 items-center justify-center rounded-[8px] transition-opacity hover:opacity-80"
											aria-label="Меню"
											aria-expanded="false"
											aria-controls="bloom-burger"
										>
											<span class="burger-icon" data-icon="open">
												<SchemeIcon svgs={BLOOM_ICON_SVGS} iconBasePath="/icons" name="menu-burger" sizeClass="size-5" />
											</span>
											<span class="burger-icon hidden" data-icon="close">
