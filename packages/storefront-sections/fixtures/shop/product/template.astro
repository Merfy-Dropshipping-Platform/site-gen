---
const { settings } = Astro.props;
---
<!-- Значки — Lucide (image, chevron-right, minus, plus, shopping-bag), лицензия ISC, lucide.dev/license. -->
<div class="mx-auto max-w-page px-4 font-body text-foreground">
  {settings.product && (
    <div class="flex flex-col gap-6">
      <nav class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground" aria-label="Хлебные крошки">
        <a class="text-muted-foreground no-underline hover:text-foreground" href="/">Главная</a>
        <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        {settings.product.collections && settings.product.collections.length > 0 ? (
          <a class="text-muted-foreground no-underline hover:text-foreground" href={settings.product.collections[0].url}>{settings.product.collections[0].title}</a>
        ) : (
          <a class="text-muted-foreground no-underline hover:text-foreground" href="/catalog">Каталог</a>
        )}
        <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        <span class="line-clamp-1 min-w-0 text-foreground" aria-current="page">{settings.product.title}</span>
      </nav>
      <div class="grid gap-8 md:grid-cols-2 md:items-start lg:gap-12">
        <div class="flex min-w-0 flex-col gap-3">
          <div
            class="relative aspect-4/5 overflow-hidden rounded-media border-width-media border-border bg-muted shadow-media"
            data-behavior="zoom"
            data-mode={settings.zoom}
            data-photos={settings.product.images.join(' ')}
          >
            <span class="absolute inset-0 flex items-center justify-center text-muted-foreground">
              <svg class="size-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="3" rx="2" ry="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" /></svg>
            </span>
            <img class="relative size-full object-cover" data-part="image" data-ref="photo" src={settings.product.images[0]} alt={settings.product.title} hidden={settings.product.images.length === 0} />
            {settings.product.compareAtPrice && settings.product.compareAtPrice.amount > settings.product.price.amount && (
              <span class="absolute left-3 top-3 rounded-badge bg-sale px-2 py-1 text-sm text-sale-foreground">−{Math.round((1 - settings.product.price.amount / settings.product.compareAtPrice.amount) * 100)} %</span>
            )}
          </div>
          {settings.product.images.length > 1 && (
            <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-1 md:mx-0 md:grid md:grid-cols-5 md:overflow-visible md:px-0 md:pb-0">
              {settings.product.images.map((src, index) => (
                <button
                  type="button"
                  class="aspect-square w-18 shrink-0 cursor-pointer overflow-hidden rounded-media border-2 border-transparent bg-muted p-0 hover:border-border aria-[current=true]:border-primary-border md:w-auto"
                  data-ref="thumb"
                  data-action="pick"
                  data-src={src}
                  aria-label={`Фото ${index + 1}`}
                  aria-current={index === 0 ? 'true' : 'false'}
                >
                  <img class="size-full object-cover" src={src} alt="" loading="lazy" />
                </button>
              ))}
            </div>
          )}
        </div>
        <div class="flex min-w-0 flex-col gap-6">
          <div class="flex flex-col gap-3">
            <h1 class="m-0 font-heading weight-heading tracking-heading text-2xl text-heading md:text-3xl">{settings.product.title}</h1>
            <p class="m-0 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <span class:list={['text-2xl weight-heading', settings.product.compareAtPrice ? 'text-sale' : 'text-price']} data-ref="price">{settings.product.price.text}</span>
              {settings.product.compareAtPrice && <s class="text-lg text-price-old">{settings.product.compareAtPrice.text}</s>}
            </p>
            <p class="m-0 flex items-center gap-2 text-sm text-muted-foreground">
              <span class="size-2 shrink-0 rounded-full bg-current" aria-hidden="true"></span>
              <span data-ref="stock">{settings.product.available ? 'В наличии' : 'Нет в наличии'}</span>
            </p>
          </div>
          {settings.product.options.length > 0 && (
            <div class="flex flex-col gap-5 border-t border-border pt-6">
              {settings.product.options.map((option) => (
                <div class="flex flex-col gap-3" role="group" aria-label={option.name}>
                  <p class="m-0 text-sm text-heading">{option.name}</p>
                  <div class="flex flex-wrap gap-2">
                    {option.values.map((value) => (
                      <button
                        type="button"
                        class="min-h-11 min-w-11 cursor-pointer rounded-button border-width-input border-border bg-background px-4 text-sm text-foreground hover:border-foreground aria-[pressed=true]:border-primary-border aria-[pressed=true]:bg-primary aria-[pressed=true]:text-primary-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring"
                        data-ref="value"
                        data-action="variants.pick"
                        data-product-id={settings.product.id}
                        data-group={option.id}
                        data-value={value.id}
                        aria-pressed="false"
                      >{value.value}</button>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )}
          <div class="flex items-start gap-3">
            <div class="inline-flex h-12 shrink-0 items-center rounded-input border-width-input border-input bg-background shadow-input" role="group" aria-label="Количество">
              <button type="button" class="inline-flex size-12 cursor-pointer items-center justify-center rounded-input bg-transparent p-0 text-foreground hover:bg-accent hover:text-accent-foreground disabled:cursor-not-allowed disabled:opacity-40" data-ref="less" data-action="less" aria-label="Меньше" disabled>
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /></svg>
              </button>
              <span class="min-w-8 text-center text-base tabular-nums" data-ref="quantity" aria-live="polite">1</span>
              <button type="button" class="inline-flex size-12 cursor-pointer items-center justify-center rounded-input bg-transparent p-0 text-foreground hover:bg-accent hover:text-accent-foreground disabled:cursor-not-allowed disabled:opacity-40" data-ref="more" data-action="more" aria-label="Больше">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="M12 5v14" /></svg>
              </button>
            </div>
            <div class="flex flex-1 flex-col gap-3" data-ext-point="product" data-product-id={settings.product.id}>
              <button
                type="button"
                class="inline-flex h-12 w-full cursor-pointer items-center justify-center gap-2 rounded-button border-width-button border-primary-border bg-primary px-6 text-base text-primary-foreground shadow-button hover:bg-primary-hover hover:text-primary-hover-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring disabled:cursor-not-allowed disabled:opacity-50"
                data-ref="buy"
                data-action="cart.add"
                data-product-id={settings.product.id}
                data-quantity="1"
                disabled={!settings.product.available}
              >
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><path d="M3 6h18" /><path d="M16 10a4 4 0 0 1-8 0" /></svg>
                В корзину
              </button>
            </div>
          </div>
          {settings.product.description && (
            <div class="flex flex-col gap-3 border-t border-border pt-6">
              <h2 class="m-0 font-heading weight-heading text-lg text-heading">Описание</h2>
              <p class="m-0 max-w-prose whitespace-pre-line text-base text-foreground">{settings.product.description}</p>
            </div>
          )}
        </div>
      </div>
    </div>
  )}
</div>
