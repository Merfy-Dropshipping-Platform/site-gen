	/* Переключение раскладок каталога (top ⇄ side) — ЕДИНЫЙ источник:
	   packages/theme-base/styles/catalog-layout.css (подключён из
	   themes/vanilla/src/styles/global.css). Копия правила ЗДЕСЬ не нужна и
	   вредна: у портов тем лежала вторая, без @media, и на узком экране
	   обе вместе прятали ОБА варианта — каталог был пустой. */
</style>

<script is:inline>
	// Чипы выбранных фильтров над товарами — один текст на пять тем (сторож:
	// no-second-implementation.spec.ts, «чипы фильтров»). Владелец: выбрал
	// параметр — над товарами чип «Фильтр: значение ⊗», нажатие снимает его,
	// «Очистить всё» — все. Порт отдаёт снимок выбранного и функцию снятия,
	// здесь — подписи, разметка и нажатия. Классы — в общем catalog-filters.css:
	// сборка витрины не видит классов из строк скрипта.
	window.__merfyFilterChips = (function () {
		var STOCK = { in: "В наличии", out: "Распродано" };
		var ICON =
			'<svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"><circle cx="8" cy="8" r="7.2"/><path d="M5.6 5.6l4.8 4.8M10.4 5.6l-4.8 4.8"/></svg>';
		var CLEAR_ALL =
			'<button type="button" class="nt-filter-chip nt-filter-chip--clear" data-chip-kind="all" data-chip-value=""><span>Очистить всё</span>' +
			ICON +
			"</button>";
		var rub = function (n) {
			return new Intl.NumberFormat("ru-RU").format(n);
		};
		var esc = function (s) {
			return String(s).replace(/[&<>"']/g, function (c) {
				return "&#" + c.charCodeAt(0) + ";";
			});
		};
		var price = function (min, max) {
			if (min != null && max != null) return "от " + rub(min) + " до " + rub(max) + " ₽";
			return min != null ? "от " + rub(min) + " ₽" : "до " + rub(max) + " ₽";
		};
		// Порядок — как фильтры в строке: наличие, стоимость, цвет, остальные
		// параметры товара, коллекции.
		function chips(state) {
			var list = [];
			if (STOCK[state.stock]) list.push({ kind: "stock", value: state.stock, label: "Наличие: " + STOCK[state.stock] });
			if (state.priceMin != null || state.priceMax != null)
				list.push({ kind: "price", value: "", label: "Стоимость: " + price(state.priceMin, state.priceMax) });
			(state.colors || []).forEach(function (color) {
				list.push({ kind: "color", value: color, label: "Цвет: " + color });
			});
			(state.groups || []).forEach(function (group) {
				group.values.forEach(function (value) {
					list.push({ kind: "variant", group: group.name, value: value, label: group.name + ": " + value });
				});
			});
			(state.collections || []).forEach(function (col) {
				list.push({ kind: "collection", value: col.ref, label: "Коллекция: " + col.name });
			});
			return list;
		}
		function chipHtml(chip) {
			return (
				'<button type="button" class="nt-filter-chip" data-chip-kind="' +
				esc(chip.kind) +
				'" data-chip-value="' +
				esc(chip.value) +
				'" data-chip-group="' +
				esc(chip.group || "") +
				'" aria-label="Убрать фильтр ' +
				esc(chip.label) +
				'"><span>' +
				esc(chip.label) +
				"</span>" +
				ICON +
				"</button>"
			);
		}
		// Рисует чипы во все контейнеры каталога (раскладки «сверху» и «сбоку»);
		// нажатие — remove({ kind, value, group }), «Очистить всё» — kind "all".
		function render(boxes, state, remove) {
			var list = chips(state);
			var html = list.length ? list.map(chipHtml).join("") + CLEAR_ALL : "";
			Array.prototype.forEach.call(boxes, function (box) {
				box.innerHTML = html;
				box.hidden = list.length === 0;
				box.__merfyChipsRemove = remove;
				if (box.hasAttribute("data-chips-bound")) return;
				box.setAttribute("data-chips-bound", "");
				box.addEventListener("click", function (ev) {
					var btn = ev.target.closest("[data-chip-kind]");
					if (!btn || !box.__merfyChipsRemove) return;
					box.__merfyChipsRemove({
						kind: btn.getAttribute("data-chip-kind"),
						value: btn.getAttribute("data-chip-value") || "",
						group: btn.getAttribute("data-chip-group") || "",
					});
				});
			});
		}
		return { chips: chips, render: render };
	})();
</script>

<script is:inline define:vars={{ siteId, pageSize, cardContainerOn, cardThemeChromeStyle, cardMediaRadiusStyle, cardAspectClass, quickAddOn, quickAddLabel, quickAddClass, nextPhotoOn }}>
	// is:inline (НЕ module-script): module client-<script> блока НЕ компилится в live
	// build → 404 на проде. Поэтому весь клиент инлайн: функции storefront-hydrate.ts
	// перенесены телами 1:1 (без import/типов), данные frontmatter — через define:vars.
	// Фильтр по цвету — как у rose: значения из /api/store/filters (группа «Цвет»).
	(function () {
		const PLACEHOLDER_IMAGE = "/placeholders/sweater-blue.svg";
		let cachedCollections;

		// Классы фильтров (зеркало ./filter-classes — is:inline не поддерживает import).
		// Радио — СТРОКА В СТРОКУ как CATALOG_RADIO_CIRCLE / CATALOG_RADIO_TEXT: те
		// классы сканируют и превью, и живая витрина (filter-classes.ts в @source
		// темы). Своя версия с `after:h-[10px]` в CSS витрины не попадала — у
		// выбранной коллекции на сайте не было точки (локальная сцена 23.09).
		const OPT_ACTIVE = "text-[rgb(var(--color-text,0_0_0))]";
		const OPT_IDLE = "text-[rgb(var(--color-muted,153_153_153))] hover:text-[rgb(var(--color-text,0_0_0))]";
		const RADIO_CIRCLE =
			"relative flex h-6 w-6 shrink-0 items-center justify-center rounded-full border-2 border-[rgb(var(--color-muted,153_153_153))] after:pointer-events-none after:absolute after:h-[14px] after:w-[14px] after:rounded-full after:bg-[rgb(var(--color-text,0_0_0))] after:opacity-0 after:content-[''] peer-checked:border-[rgb(var(--color-text,0_0_0))] peer-checked:after:opacity-100 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-[rgb(var(--color-text,0_0_0))]";
		const RADIO_TEXT =
			"text-base leading-none text-[rgb(var(--color-muted,153_153_153))] peer-checked:text-[rgb(var(--color-text,0_0_0))]";

		// ЖИВОЙ storefront API (спек 098, rose-канон — «не products.json»). store_id
		// (shopId) = siteId (storefront-data.controller: «Products are stored with
		// shopId = siteId»). apiBase: на live (*.merfy.ru) cross-origin к gateway
		// (CORS пропускает *.merfy.ru); в превью iframe на gateway-origin → same-origin.
		const apiBase =
			(typeof window !== "undefined" && window.__MERFY_API_BASE__) || "https://gateway.merfy.ru";
		const storeId =
			(typeof window !== "undefined" && window.__MERFY_SITE_ID__) || siteId || undefined;

		// Цена из API — в КОПЕЙКАХ (basePrice "79000.00" / variant.price 79000).
		function toCents(v) {
			const n = typeof v === "string" ? parseFloat(v) : v;
			return Number.isFinite(n) ? n : null;
		}
		function variantMinCents(p) {
			const vc = p.variantCombinations;
			if (Array.isArray(vc) && vc.length) {
				const ps = vc.map((v) => toCents(v.price)).filter((n) => n !== null && n > 0);
				if (ps.length) return Math.min.apply(null, ps);
			}
			return null;
		}
		// mapApiProduct: товар /api/store/products → форма vanilla-карточки
		// (name/price-в-рублях/slug/images/collections). Цены КОПЕЙКИ→рубли (/100);
		// title→name; handle→slug; productCollections→collections.
		function mapApiProduct(p) {
			const cents =
				(p.hasVariants ? variantMinCents(p) : null) ??
				toCents(p.basePrice) ??
				variantMinCents(p) ??
				0;
			const oldCents = toCents(p.compareAtPrice);
			const coll = Array.isArray(p.productCollections)
				? p.productCollections.map((pc) => ({
						id: (pc && (pc.collectionId || pc.id || (pc.collection && pc.collection.id))) || undefined,
						slug: (pc && (pc.slug || (pc.collection && pc.collection.slug))) || undefined,
					}))
				: [];
			return {
				id: p.id,
				name: p.title || p.name || "",
				price: cents,
				oldPrice: oldCents && oldCents > 0 ? oldCents : null,
				slug: p.handle || p.slug,
				images: Array.isArray(p.images) ? p.images : [],
				hasVariants: !!p.hasVariants,
				variantCombinations: Array.isArray(p.variantCombinations) ? p.variantCombinations : [],
				collections: coll,
			};
		}

		// loadRealCollections: ЖИВОЙ API /api/store/collections (rose-канон). Нормализуем
		// в форму vanilla {id, name, slug, productIds}. Фолбэк — статичный collections.json.
		async function loadRealCollections() {
			if (cachedCollections !== undefined) return cachedCollections;
			if (storeId) {
				try {
					const res = await fetch(
						`${apiBase}/api/store/collections?store_id=${encodeURIComponent(storeId)}&limit=100`,
					);
					if (res.ok) {
						const json = await res.json();
						const cols = Array.isArray(json.collections) ? json.collections : [];
						if (cols.length > 0) {
							cachedCollections = cols.map((c) => ({
								id: c.id,
								name: c.title || c.name,
								slug: c.slug || c.handle,
								productIds: Array.isArray(c.productIds) ? c.productIds : undefined,
							}));
							return cachedCollections;
						}
					}
				} catch {}
			}
			try {
				const res = await fetch("/data/collections.json");
				if (res.ok) {
					const data = await res.json();
					if (Array.isArray(data) && data.length > 0) { cachedCollections = data; return cachedCollections; }
				}
			} catch {}
			cachedCollections = null;
			return cachedCollections;
		}

		// findCollection: резолв ссылки (slug/id/name) в объект коллекции из кэша —
		// используется buildProductsQuery для slug→collection_id серверного фильтра.
		function findCollection(collections, ref) {
			if (!ref || !collections) return null;
			return collections.find((c) => c && (c.id === ref || c.slug === ref || c.name === ref)) ?? null;
		}

		function formatPrice(value) {
			if (value === null || value === undefined || value === "") return "";
			if (typeof value === "string") return value;
			return `${value.toLocaleString("ru-RU")} ₽`;
		}
		function productHref(p) { return `/product?id=${encodeURIComponent(p.id)}`; }
		function productImageRaw(p) {
			return (Array.isArray(p.images) && typeof p.images[0] === "string" && p.images[0]) || "";
		}
		function escapeHtml(value) {
			return String(value ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
		}

		// Surface-плейсхолдер медиа карточки (товар без фото / битый URL).
		const CARD_MEDIA_FALLBACK_HTML =
			'<div class="absolute inset-0 flex items-center justify-center" style="background:rgb(var(--color-surface,245 245 245))" aria-hidden="true">' +
			'<svg class="size-10" style="color:rgb(var(--color-muted,153 153 153))" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
			'<rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>' +
			"</svg></div>";
		const CARD_IMG_ONERROR_ATTR = ` onerror="this.onerror=null;this.outerHTML='${CARD_MEDIA_FALLBACK_HTML.replace(/"/g, "&quot;")}'"`;

		// Outline-сердце избранного — фолбэк, когда глобал window.__vanillaWishlist ещё
		// не готов (превью Container API без Layout-скрипта, либо ранний рендер).
		// Зеркалит wishlist.ts heartSvg(false) + SSG demo-карточку выше (parity).
		// Геометрия = public/icons/favourite.svg (тот же path, что rose/PDP). SVG-строка
		// дублируется здесь — block-папка override-темы автономна (компилятор превью не
		// резолвит импорты наружу).
		const WISHLIST_OUTLINE_SVG =
			'<svg viewBox="0 0 17.4 15.4" width="100%" height="100%" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="display:block">' +
			'<path d="M7.428 14.2615C5.172 12.5239 0.7 8.55212 0.7 4.97729C0.7 2.61547 2.384 0.7 4.7 0.7C5.9 0.7 7.1 1.11175 8.7 2.75876C10.3 1.11175 11.5 0.7 12.7 0.7C15.016 0.7 16.7 2.61547 16.7 4.97729C16.7 8.5513 12.228 12.5239 9.972 14.2615C9.212 14.8462 8.188 14.8462 7.428 14.2615Z" ' +
			'fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>' +
			"</svg>";

		// «Контейнер» карточки (parity с SSG cardWrapClass / base Catalog.astro
		// cardChrome): cardContainerOn → фон+скругление+padding 12px (контент inset).
		// ГОЧА: arbitrary Tailwind (rounded-[12px]/bg-[var()]) в client-JS строках НЕ
		// компилится previewTailwind → даём через inline-style (визуально 1:1 с
		// Tailwind `rounded-[12px] bg-[var(--vanilla-card)] p-3`, p-3 = 12px). Без
		// контейнера — пустая строка (флеш, дефолт). Базовые flex-классы карточки —
		// core-utility (group flex flex-col gap-3), компилятся всегда.
		const cardChromeStyle = cardContainerOn
			? "border-radius:12px;background:var(--vanilla-card);padding:12px;"
			: cardThemeChromeStyle;

		// ─────────── nt-cart (vanilla:cart:v1) — инлайн-запись как lib/nt-cart-vanilla.ts ───────────
		// is:inline НЕ резолвит `import { addToCart }`, поэтому тело перенесено 1:1:
		// тот же storageKey ("vanilla:cart:v1") и событие ("vanilla:cart:updated"),
		// которые читают шапка-дровер (initCartUI) и страница корзины. Единый стор
		// витрины → быстрое добавление из каталога сразу видно везде. cartStore
		// (бэкенд) не трогаем — он наполняется из nt-cart при оформлении.
		const NT_CART_KEY = "vanilla:cart:v1";
		const NT_CART_EVENT = "vanilla:cart:updated";
		function ntPriceAttr(raw) {
			if (typeof raw === "number") return Number.isFinite(raw) ? raw : "";
			const digits = String(raw == null ? "" : raw).replace(/[^\d]/g, "");
			return digits ? Number(digits) : "";
		}
		function ntReadCart() {
			try {
				const parsed = JSON.parse(window.localStorage.getItem(NT_CART_KEY) || "[]");
				return Array.isArray(parsed) ? parsed : [];
			} catch (e) {
				return [];
			}
		}
		function ntAddToCart(opts) {
			const lines = ntReadCart();
			const id = String(opts.productId);
			const quantity = Math.max(1, opts.quantity || 1);
			const price = Number(ntPriceAttr(opts.price)) || 0;
			const oldPriceRaw = ntPriceAttr(opts.oldPrice);
			const existing = lines.find((l) => l.id === id);
			if (existing) {
				existing.quantity += quantity;
			} else {
				lines.push({
					id: id,
					productId: id,
					name: opts.name || "",
					price: price,
					oldPrice: oldPriceRaw === "" ? undefined : Number(oldPriceRaw),
					image: opts.image || "",
					quantity: quantity,
					variant: {},
				});
			}
			window.localStorage.setItem(NT_CART_KEY, JSON.stringify(lines));
			window.dispatchEvent(new CustomEvent(NT_CART_EVENT, { detail: lines }));
		}
		// Делегат «быстрого добавления»: один слушатель на документ, поэтому
		// переживает перерисовку грида (renderCatalog заменяет <li> целиком).
		function bindQuickAdd() {
			if (document.body.getAttribute("data-vn-quick-add") === "1") return;
			document.body.setAttribute("data-vn-quick-add", "1");
			document.addEventListener("click", (event) => {
				const btn = event.target.closest("button[data-quick-add-id]");
				if (!btn) return;
				if (!btn.closest('[data-nt="catalog-grid"]')) return;
				event.preventDefault();
				event.stopPropagation();
				ntAddToCart({
					productId: btn.getAttribute("data-quick-add-id"),
					name: btn.getAttribute("data-name") || "",
					price: btn.getAttribute("data-price"),
					oldPrice: btn.getAttribute("data-old-price"),
					image: btn.getAttribute("data-image") || "",
					quantity: 1,
				});
			});
		}
		bindQuickAdd();

		// «Следующее фото при наведении» — листание, как на Авито: ширина фото
		// делится на столько равных полос, сколько у товара фото; курсор в полосе
		// N — фото N (три фото: левая треть — первое, середина — второе, правая
		// треть — третье), уход — снова первое. Ширину берём у видимой рамки (<a>
		// с overflow-hidden), а не у самой картинки: при наведении она увеличена
		// на 5% и её края обрезаны. Делегат на документ (грид перерисовывается
		// целиком), один раз на страницу.
		function bindNextPhoto() {
			if (!nextPhotoOn) return;
			if (document.body.getAttribute("data-vn-next-photo") === "1") return;
			document.body.setAttribute("data-vn-next-photo", "1");
			const cardPhotos = (img) => {
				const photos = [img.getAttribute("data-img-primary")];
				for (let n = 2; img.hasAttribute("data-img-" + n); n++) photos.push(img.getAttribute("data-img-" + n));
				return photos.filter(Boolean);
			};
			// Остальные фото грузим при первом наведении, чтобы листание не ждало сеть.
			const preloaded = new WeakSet();
			document.addEventListener("mousemove", (event) => {
				const img = event.target.closest("img[data-img-primary]");
				if (!img || !img.closest('[data-nt="catalog-grid"]')) return;
				const photos = cardPhotos(img);
				if (photos.length < 2) return;
				if (!preloaded.has(img)) {
					preloaded.add(img);
					photos.slice(1).forEach((src) => { new Image().src = src; });
				}
				const frame = img.parentElement.getBoundingClientRect();
				const share = (event.clientX - frame.left) / frame.width;
				const n = Math.min(photos.length - 1, Math.max(0, Math.floor(share * photos.length)));
				if (img.getAttribute("src") !== photos[n]) img.setAttribute("src", photos[n]);
			});
			document.addEventListener("mouseout", (event) => {
				const img = event.target.closest("img[data-img-primary]");
				if (!img || !img.closest('[data-nt="catalog-grid"]')) return;
				const prim = img.getAttribute("data-img-primary");
				if (prim && img.getAttribute("src") !== prim) img.setAttribute("src", prim);
			});
		}
		bindNextPhoto();

		// renderCardHtml — зеркалит vanilla-карточку (aspect-square, font-vanilla-arsenal).
		function renderCardHtml(p) {
			const href = escapeHtml(productHref(p));
			const name = escapeHtml(p.name);
			const rawImage = productImageRaw(p);
			// Листанию нужны ВСЕ остальные фото товара — data-img-2, data-img-3, …
			// без потолка: сколько фото, столько полос по ширине картинки.
			const zoneImgs =
				nextPhotoOn && Array.isArray(p.images)
					? p.images.slice(1).filter((src) => typeof src === "string" && src)
					: [];
			const imgDataAttrs =
				' data-img-primary="' + escapeHtml(rawImage) + '"' +
				zoneImgs.map((src, i) => ' data-img-' + (i + 2) + '="' + escapeHtml(src) + '"').join("");
			const media = rawImage
				? `<img src="${escapeHtml(rawImage)}"${imgDataAttrs} alt="${name}" width="429" height="429" loading="eager" class="absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"${CARD_IMG_ONERROR_ATTR} />`
				: CARD_MEDIA_FALLBACK_HTML;
			const price = escapeHtml(formatPrice(p.price));
			const oldRaw = formatPrice(p.oldPrice || p.compareAtPrice || null);
			const oldPrice = oldRaw
				? `<span class="font-vanilla-arsenal text-[14px] font-normal leading-none text-[rgb(var(--color-text,0_0_0))] line-through">${escapeHtml(oldRaw)}</span>`
				: "";
			// Сердце избранного (overlay top-right) — зеркалит SSG demo-карточку выше
			// (parity SSG↔client). Начальное состояние читаем из глобала
			// window.__vanillaWishlist (initWishlistUI выставляет его в Layout) → карточка
			// рисуется уже с правильным filled/outline без мигания; делегат всё равно
			// перерисует на событие. Кнопка СНАРУЖИ <a> (button-in-anchor невалиден).
			// Манера vanilla: квадратная плашка (острые углы), а не круглая (как rose).
			const wished =
				(typeof window !== "undefined" && window.__vanillaWishlist && window.__vanillaWishlist.has(p.id)) || false;
			const heartInner =
				(typeof window !== "undefined" && window.__vanillaWishlist && window.__vanillaWishlist.heartSvg)
					? window.__vanillaWishlist.heartSvg(wished)
					: WISHLIST_OUTLINE_SVG;
			const heartBtn =
				`<button type="button" data-wishlist-toggle data-product-id="${escapeHtml(p.id)}" aria-pressed="${wished ? "true" : "false"}" aria-label="В избранное" ` +
				`class="absolute right-2 top-2 z-20 flex size-9 items-center justify-center bg-white text-[var(--vanilla-dark)] shadow-[0_2px_8px_rgba(0,0,0,0.10)] transition-opacity hover:opacity-80">` +
				`<span data-wishlist-icon class="block size-[18px]">${heartInner}</span></button>`;
			// «Быстрое добавление» (productCard.quickAdd). Канон вёрстки vanilla —
			// кнопки нет; настройка её включает, «Стиль кнопки» задаёт заливку/обводку.
			// Кнопка НЕ внутри <a> (button-in-anchor невалиден) — она в текстовом
			// блоке карточки. data-quick-add-id ловит делегат ниже и кладёт строку
			// в nt-cart (vanilla:cart:v1) — тот же стор, что читают шапка-дровер и
			// страница корзины, поэтому добавленное сразу видно везде.
			const _price = ntPriceAttr(p.price);
			const _oldPrice = ntPriceAttr(p.oldPrice || p.compareAtPrice || null);
			const quickAddBtn = quickAddOn
				? `<button type="button" data-nt="catalog-quick-add" data-quick-add-id="${escapeHtml(p.id)}"` +
					` data-name="${name}" data-price="${escapeHtml(String(_price))}"` +
					(_oldPrice ? ` data-old-price="${escapeHtml(String(_oldPrice))}"` : "") +
					(rawImage ? ` data-image="${escapeHtml(rawImage)}"` : "") +
					` class="${quickAddClass}">${escapeHtml(quickAddLabel)}</button>`
				: "";
			return `<article class="group flex flex-col gap-3" data-nt="vanilla-product-card" aria-label="${name}"${cardChromeStyle ? ` style="${cardChromeStyle}"` : ""}>
	<div class="relative w-full">
	<a href="${href}" class="relative block ${cardAspectClass} w-full overflow-hidden bg-[var(--vanilla-card)]" style="${cardMediaRadiusStyle}" aria-label="${name}">${media}</a>
	${heartBtn}
	</div>
	<div class="flex flex-col gap-1">
		<a href="${href}" class="font-vanilla-arsenal text-base font-normal leading-none text-[rgb(var(--color-text,38_49_28))] transition-opacity hover:opacity-70">${name}</a>
		<div class="flex flex-wrap items-baseline gap-2">
			<span class="font-vanilla-arsenal text-base font-normal leading-none text-[rgb(var(--color-text,38_49_28))]">${price}</span>
			${oldPrice}
		</div>
		${quickAddBtn}
	</div>
</article>`;
		}

		function pluralize(count) {
			const m10 = count % 10, m100 = count % 100;
			if (m100 >= 11 && m100 <= 14) return `${count} товаров`;
			if (m10 === 1) return `${count} товар`;
			if (m10 >= 2 && m10 <= 4) return `${count} товара`;
			return `${count} товаров`;
		}
		function updateCount(n) {
			for (const el of Array.from(document.querySelectorAll('[data-nt="catalog-count"]'))) {
				el.textContent = pluralize(n);
			}
		}

		// ─────────── Скелетон-лоадер (rose-канон) ───────────
		// Снимок скелетон-карточек (<li data-nt="catalog-skeleton">) из SSG-грида —
		// захватывается при первой гидрации, чтобы при replace-загрузке (page=1: смена
		// фильтра/сортировки) показать лоадер вместо устаревшего/пустого грида. Append
		// (page>1) скелетон не трогает — там индикатор на кнопке.
		let skeletonHtml = "";
		function captureSkeleton() {
			if (skeletonHtml) return;
			const grid = document.querySelector('[data-nt="catalog-grid"]');
			if (!grid) return;
			const sk = Array.from(grid.querySelectorAll('[data-nt="catalog-skeleton"]'));
			if (sk.length > 0) skeletonHtml = sk.map((el) => el.outerHTML).join("");
		}
		function showSkeleton() {
			if (!skeletonHtml) return;
			for (const grid of Array.from(document.querySelectorAll('[data-nt="catalog-grid"]'))) {
				grid.innerHTML = skeletonHtml;
			}
		}
		// pickDemo: HTML/число <li> demo-моков из <template data-nt="catalog-demo"> —
		// подставляется ТОЛЬКО когда магазин реально пуст / API недоступен.
		function demoTemplate() {
			return document.querySelector('[data-nt="catalog-demo"]');
		}

		// ─────────────────────── Каталог: state + orchestration ───────────────────────
		// СЕРВЕРНАЯ пагинация (rose-канон): товары грузятся ПОСТРАНИЧНО реальными
		// запросами /api/store/products?page=N с серверными фильтрами (sort/price/
		// availability/collection/цвет). Клиент НЕ держит весь каталог и НЕ слайсит.
		let catalogCollections = null;
		const filters = {
			// Поисковый запрос из шапки: /catalog?q=… . Читается один раз при
			// загрузке — форма шапки делает полный переход, не SPA-навигацию.
			query:
				typeof window !== "undefined"
					? (new URLSearchParams(window.location.search).get("q") || "").trim()
					: "",
			stock: "all",
			priceMin: null,
			priceMax: null,
			// Выбранные цвета ([] — все). Несколько: сервер показывает товары с любым из них.
			colors: [],
			// Остальные параметры товара: { «Размер»: ["M", "L"] } — несколько значений в группе.
			variants: {},
			sort: "popularity",
			page: 1,
		};

		function getPageSize() {
			const root = document.querySelector("[data-catalog-layout]");
			const n = parseInt((root && root.getAttribute("data-page-size")) ?? "", 10);
			if (Number.isFinite(n) && n > 0) return n;
			return Number.isFinite(pageSize) && pageSize > 0 ? pageSize : 12;
		}
		// Коллекции: СНАЧАЛА настройка конструктора (data-collection-slug) — одна,
		// закреплённая; ИНАЧЕ ?collection=a&collection=b — выбор покупателя, их может
		// быть несколько (сервер показывает товары хоть в одной).
		function currentCollectionRefs() {
			const root = document.querySelector("[data-catalog-layout]");
			const fromSetting = root && root.getAttribute("data-collection-slug");
			if (fromSetting && fromSetting.trim()) return [fromSetting.trim()];
			const fromQuery = new URLSearchParams(window.location.search)
				.getAll("collection")
				.map((ref) => ref.trim())
				.filter(Boolean);
			if (fromQuery.length > 0) return fromQuery;
			const fromPath = window.location.pathname.match(/\/collections\/([^/?#]+)/);
			if (fromPath && fromPath[1] && fromPath[1] !== "_placeholder") return [decodeURIComponent(fromPath[1])];
			return [];
		}
		// Выбранные коллекции объектами из списка магазина — для отметок и подписи.
		function selectedCollections() {
			return currentCollectionRefs()
				.map((ref) => findCollection(catalogCollections, ref))
				.filter(Boolean);
		}
		// Отметить значение фильтра или снять отметку — выбор нескольких значений.
		const toggleValue = (list, value) =>
			list.includes(value) ? list.filter((item) => item !== value) : [...list, value];

		// buildProductsQuery: query-строка /api/store/products из текущего filters
		// (rose-канон). min_price/max_price API сравнивает с basePrice в КОПЕЙКАХ →
		// рубли × 100. out-of-stock в API = `sold_out` (DTO enum). Цвет — параметром
		// с именем группы («Цвет=Белый»), как у rose.
		function buildProductsQuery(page) {
			const qp = new URLSearchParams();
			qp.set("store_id", String(storeId ?? ""));
			qp.set("page", String(page));
			qp.set("limit", String(getPageSize()));

			// Поиск из шапки: форма шлёт GET /catalog?q=… . API понимает q сам
			// (проверено live: q=Bloom → 1 товар из 6), витрина его просто не
			// передавала — поиск не фильтровал ничего ни в одной теме (баг тестера #5).
			const searchQ = (filters.query || "").trim();
			if (searchQ) qp.set("q", searchQ);

			const sortMap = {
				popularity: "popular",
				new: "newest",
				"price-asc": "price_asc",
				"price-desc": "price_desc",
			};
			const sort = sortMap[filters.sort];
			if (sort) qp.set("sort", sort);

			if (filters.priceMin !== null && filters.priceMin !== undefined)
				qp.set("min_price", String(Math.round(filters.priceMin)));
			if (filters.priceMax !== null && filters.priceMax !== undefined)
				qp.set("max_price", String(Math.round(filters.priceMax)));

			if (filters.stock === "in") qp.set("availability", "in_stock");
			else if (filters.stock === "out") qp.set("availability", "sold_out");

			// Цвет: ключ на каждое значение (`Цвет=A&Цвет=B`), сервер — товары с любым.
			for (const color of filters.colors) qp.append(COLOR_GROUP_NAME, color);

			// Остальные параметры товара — так же: ключ группы на каждое значение.
			for (const [group, values] of Object.entries(filters.variants)) {
				for (const value of values) qp.append(group, value);
			}

			// Коллекции: slug/id из настройки или ?collection= → серверный collection_id,
			// ключ на каждую выбранную. Резолвим slug→id через кэш; нет резолва — ref как есть.
			for (const ref of currentCollectionRefs()) {
				const col = findCollection(catalogCollections, ref);
				qp.append("collection_id", col && col.id ? col.id : ref);
			}
			return qp.toString();
		}

		// fetchProductsPage: один сетевой запрос за страницей N. Возвращает
		// { items, total, totalPages } либо null (сеть/ошибка) → null прячет грид.
		async function fetchProductsPage(page) {
			if (!storeId) return null;
			try {
				const res = await fetch(`${apiBase}/api/store/products?${buildProductsQuery(page)}`);
				if (!res.ok) return null;
				const json = await res.json();
				const items = Array.isArray(json.products) ? json.products.map(mapApiProduct) : [];
				const total = typeof json.total === "number" ? json.total : 0;
				const totalPages =
					(json.pagination && typeof json.pagination.totalPages === "number"
						? json.pagination.totalPages
						: null) ?? 1;
				return { items, total, totalPages };
			} catch {
				return null;
			}
		}

		// renderCatalog: СЕРВЕРНАЯ пагинация. append=false (page=1) — REPLACE гридов;
		// append=true (page>1) — APPEND карточек в конец (fetch следующей страницы по
		// клику «Смотреть ещё»). Кнопка видна пока page<totalPages.
		async function renderCatalog(append) {
			const grids = Array.from(document.querySelectorAll('[data-nt="catalog-grid"]'));
			const loadMoreBtns = Array.from(document.querySelectorAll("[data-action='load-more']"));

			// Лоадер: при replace (page=1) показываем скелетон, пока идёт сетевой запрос
			// (вместо устаревшего/пустого грида). Грид уже виден (opacity:1 после первой
			// загрузки) либо ещё скрыт (первая загрузка) — раскрываем ниже в любом исходе.
			if (!append) showSkeleton();
			// При append индикатор — на кнопке (блокируем повторный клик во время fetch).
			if (append) for (const btn of loadMoreBtns) btn.disabled = true;

			const res = await fetchProductsPage(filters.page);

			// Append-сбой (page>1, сеть упала): не затираем показанные товары —
			// откатываем счётчик страницы и возвращаем кнопку.
			if (res === null && append && filters.page > 1) {
				filters.page -= 1;
				for (const btn of loadMoreBtns) btn.disabled = false;
				return;
			}

			// API недоступен ИЛИ магазин реально пуст (page=1, total=0): подставляем demo-
			// моки из <template data-nt="catalog-demo"> (rose-канон) — красивая заглушка
			// нового сайта вместо скелетона/пустоты; кнопку прячем.
			if (res === null || (filters.page === 1 && res.total === 0)) {
				const demoTpl = demoTemplate();
				const demoHtml = demoTpl ? demoTpl.innerHTML : "";
				const demoN = demoTpl ? demoTpl.content.querySelectorAll("li").length : 0;
				for (const grid of grids) grid.innerHTML = demoHtml; // скелетон → demo
				updateCount(demoN);
				for (const btn of loadMoreBtns) {
					btn.style.display = "none";
					btn.disabled = false;
				}
				for (const g of grids) g.style.opacity = "1"; // demo отрисованы → раскрываем грид
				return;
			}

			// Реальные товары: рендер страницы (append в конец / replace).
			const html = res.items
				.map((p) => `<li data-product-id="${escapeHtml(p.id)}">${renderCardHtml(p)}</li>`)
				.join("");
			for (const grid of grids) {
				if (append && filters.page > 1) grid.insertAdjacentHTML("beforeend", html);
				else grid.innerHTML = html; // page=1 → replace
			}
			for (const g of grids) g.style.opacity = "1"; // реальные товары отрисованы → раскрываем грид (демо не мелькает)

			updateCount(res.total); // счётчик = total магазина/фильтра
			for (const btn of loadMoreBtns) {
				btn.style.display = filters.page < res.totalPages ? "" : "none";
				btn.disabled = false;
			}
		}

		function resetPageAndRender() {
			filters.page = 1;
			syncFilterChips(); // чипы выбранного — до рендера, не ждут товаров
			renderCatalog(false); // REPLACE — смена фильтра/сортировки начинает с 1-й страницы
		}

		// ─────────── Чипы выбранных фильтров ───────────
		// Над товарами — чип на каждое выбранное значение («Цвет: Синий ⊗»), нажатие
		// снимает его, «Очистить всё» — все (владелец). Подписи, разметка и нажатия —
		// общий __merfyFilterChips (один текст на пять тем); здесь — что выбрано и как
		// это снять: то же состояние, что после снятия отметки в самом фильтре.
		// Сортировка и поиск из шапки — не фильтры, остаются.

		// Коллекции, которые отметил покупатель (?collection=) и каталог применил.
		// Коллекция из настройки секции или из адреса /collections/<slug>
		// закреплена страницей — её не снять, чипа нет.
		function buyerCollectionRefs() {
			const applied = currentCollectionRefs();
			return new URLSearchParams(window.location.search)
				.getAll("collection")
				.map((ref) => ref.trim())
				.filter((ref) => ref && applied.includes(ref));
		}

		function clearPriceInputs() {
			for (const input of Array.from(document.querySelectorAll("[data-price-input]"))) input.value = "";
		}

		// Вид фильтра → как снять значение (undefined — все значения вида;
		// у параметров товара вторым — имя группы).
		const CHIP_REMOVERS = {
			stock: () => {
				filters.stock = "all";
				syncStockUi();
			},
			price: () => {
				filters.priceMin = null;
				filters.priceMax = null;
				clearPriceInputs();
			},
			color: (value) => {
				filters.colors = value === undefined ? [] : filters.colors.filter((color) => color !== value);
				rerenderChoice(COLOR_BOX, renderColorBox, true);
			},
			variant: (value, group) => {
				filters.variants =
					value === undefined ? {} : { ...filters.variants, [group]: variantValues(group).filter((v) => v !== value) };
				rerenderVariantBoxes(value === undefined ? null : group, true);
			},
			collection: (value) =>
				pickCollections(value === undefined ? [] : buyerCollectionRefs().filter((ref) => ref !== value), true),
		};

		function removeFilterChip(chip) {
			const isAll = chip.kind === "all";
			for (const kind of isAll ? Object.keys(CHIP_REMOVERS) : [chip.kind]) {
				if (CHIP_REMOVERS[kind]) CHIP_REMOVERS[kind](isAll ? undefined : chip.value, chip.group);
			}
			resetPageAndRender();
		}

		function syncFilterChips() {
			if (!window.__merfyFilterChips) return;
			window.__merfyFilterChips.render(
				document.querySelectorAll('[data-nt="catalog-chips"]'),
				{
					stock: filters.stock,
					priceMin: filters.priceMin,
					priceMax: filters.priceMax,
					colors: filters.colors,
					groups: Object.entries(filters.variants).map(([name, values]) => ({ name, values })),
					collections: buyerCollectionRefs().map((ref) => {
						const col = findCollection(catalogCollections, ref);
						return { ref, name: (col && col.name) || ref };
					}),
				},
				removeFilterChip,
			);
		}

		// ─────────── Наличие (top: vanilla-top-stock; side: vanilla-stock; шторка: vanilla-sheet-stock) ───────────
		function syncStockUi() {
			for (const input of Array.from(document.querySelectorAll('input[name="vanilla-top-stock"], input[name="vanilla-stock"], input[name="vanilla-sheet-stock"]'))) {
				input.checked = input.value === filters.stock;
			}
		}
		function bindStock() {
			for (const input of Array.from(document.querySelectorAll('input[name="vanilla-top-stock"], input[name="vanilla-stock"], input[name="vanilla-sheet-stock"]'))) {
				if (input.getAttribute("data-cf-stock") === "1") continue;
				input.setAttribute("data-cf-stock", "1");
				input.addEventListener("change", () => {
					if (!input.checked) return;
					const v = input.value;
					filters.stock = v === "in" || v === "out" ? v : "all";
					syncStockUi();
					resetPageAndRender();
				});
			}
		}

		// ─────────── Сортировка (top: vanilla-top-sort; side: vanilla-sort; шторка: vanilla-sheet-sort) ───────────
		const SORT_LABELS = { popularity: "По популярности", new: "По новизне", "price-desc": "По убыванию цены", "price-asc": "По возрастанию цены" };
		function syncSortUi() {
			for (const input of Array.from(document.querySelectorAll('input[name="vanilla-top-sort"], input[name="vanilla-sort"], input[name="vanilla-sheet-sort"]'))) {
				input.checked = input.value === filters.sort;
			}
			// лейбл триггера дропдауна top
			const det = document.querySelector('input[name="vanilla-top-sort"]');
			const summarySpan = det && det.closest("details") && det.closest("details").querySelector("summary > span:first-child");
			if (summarySpan) summarySpan.textContent = SORT_LABELS[filters.sort] ?? "По популярности";
		}
		function bindSort() {
			for (const input of Array.from(document.querySelectorAll('input[name="vanilla-top-sort"], input[name="vanilla-sort"], input[name="vanilla-sheet-sort"]'))) {
				if (input.getAttribute("data-cf-sort") === "1") continue;
				input.setAttribute("data-cf-sort", "1");
				input.addEventListener("change", () => {
					if (!input.checked) return;
					const v = input.value;
					filters.sort = v === "new" || v === "price-asc" || v === "price-desc" ? v : "popularity";
					syncSortUi();
					resetPageAndRender();
					const det = input.closest("details");
					if (det) det.removeAttribute("open");
				});
			}
		}

		// ─────────── Стоимость (от/до) — заменяем <span> значения на <input> ───────────
		function bindPrice() {
			for (const rows of Array.from(document.querySelectorAll('[data-nt="catalog-price"]'))) {
				if (rows.getAttribute("data-cf-price") === "1") continue;
				rows.setAttribute("data-cf-price", "1");
				const lines = Array.from(rows.children); // [0]=от, [1]=до
				lines.forEach((line, idx) => {
					const valueWrap = line.querySelector(":scope > div");
					const valueSpan = valueWrap && valueWrap.querySelector("span");
					if (!valueWrap || !valueSpan) return;
					const input = document.createElement("input");
					input.type = "text";
					input.inputMode = "numeric";
					input.value = "";
					input.placeholder = valueSpan.textContent?.trim() ?? "";
					input.setAttribute("data-price-input", idx === 0 ? "min" : "max");
					input.className = "w-[64px] bg-transparent text-right outline-none";
					input.style.color = "inherit";
					input.style.font = "inherit";
					valueSpan.replaceWith(input);
					input.addEventListener("input", () => {
						const raw = input.value.replace(/[^\d]/g, "");
						const v = raw ? parseInt(raw, 10) : null;
						if (idx === 0) filters.priceMin = Number.isFinite(v) ? v : null;
						else filters.priceMax = Number.isFinite(v) ? v : null;
						for (const other of Array.from(document.querySelectorAll(`[data-price-input="${idx === 0 ? "min" : "max"}"]`))) {
							if (other !== input) other.value = input.value;
						}
						resetPageAndRender();
					});
				});
			}
		}

		// ─────────── Пагинация «Смотреть ещё» (СЕРВЕРНАЯ) ───────────
		// Каждый клик = РЕАЛЬНЫЙ сетевой запрос за следующей страницей с APPEND.
		function bindLoadMore() {
			if (document.body.getAttribute("data-cf-loadmore") === "1") return;
			document.body.setAttribute("data-cf-loadmore", "1");
			document.addEventListener("click", (event) => {
				const button = event.target.closest("[data-action='load-more']");
				if (!button) return;
				if (button.disabled) return; // защита от дабл-клика во время fetch
				filters.page += 1;
				renderCatalog(true); // APPEND следующей страницы
			});
		}

		// ─────────── Выбор «Все» + значения (коллекции, цвет) ───────────
		// Один вид на оба фильтра: в выпадашке строки top — кнопки (активная цветом
		// текста), в сайдбаре и шторке — радио, как «Наличие». Пункты — данными:
		// [{ value, label, active }], первым «Все» (value "").
		const CHOICE = {
			collection: { list: "[data-collections-options]", label: "[data-collections-label]", dropdown: "data-collections-dropdown", attr: "data-collection-option", radio: "vanilla-collection", title: "Коллекции" },
			color: { list: "[data-color-options]", label: "[data-color-label]", dropdown: "data-color-dropdown", attr: "data-color-option", radio: "vanilla-color", title: "Цвет" },
		};
		let radioNameSeq = 0;
		const choiceButtonHtml = (kind, o) =>
			`<button type="button" ${kind.attr}="${escapeHtml(o.value)}" class="cursor-pointer text-left text-base leading-none transition-colors ${o.active ? OPT_ACTIVE : OPT_IDLE}">${escapeHtml(o.label)}</button>`;
		const choiceRadioHtml = (kind, name, o) =>
			`<label class="group flex cursor-pointer items-center gap-2"><input type="checkbox" name="${escapeHtml(name)}" value="${escapeHtml(o.value)}" ${kind.attr}="${escapeHtml(o.value)}"${o.active ? " checked" : ""} class="peer sr-only" /><span aria-hidden="true" class="${RADIO_CIRCLE}"></span><span class="${RADIO_TEXT}">${escapeHtml(o.label)}</span></label>`;
		// Своё имя группы радио у каждого места (сайдбар, шторка): иначе выбор в
		// одном снимал бы выбор в другом.
		function radioNameOf(box, kind) {
			const name = box.getAttribute("data-cf-radio-name") || `${kind.radio}-${++radioNameSeq}`;
			box.setAttribute("data-cf-radio-name", name);
			return name;
		}
		function renderChoice(box, kind, items, currentLabel) {
			const list = box.querySelector(kind.list);
			if (!list) return;
			if (!box.hasAttribute(kind.dropdown)) {
				const name = radioNameOf(box, kind);
				list.innerHTML = items.map((o) => choiceRadioHtml(kind, name, o)).join("");
				return;
			}
			const label = box.querySelector(kind.label);
			if (label) label.textContent = currentLabel || kind.title;
			list.innerHTML = items.map((o) => choiceButtonHtml(kind, o)).join("");
		}
		// Слушатели на списке переживают перерисовку innerHTML.
		function bindChoice(box, kind, pick) {
			const list = box.querySelector(kind.list);
			list.addEventListener("change", (ev) => {
				const input = ev.target.closest(`input[${kind.attr}]`);
				if (input) pick(input.value);
			});
			list.addEventListener("click", (ev) => {
				const btn = ev.target.closest(`button[${kind.attr}]`);
				if (btn) pick(btn.getAttribute(kind.attr) ?? "");
			});
		}
		// Показать фильтр во всех его местах (строка, сайдбар, шторка), один раз на узел.
		function hydrateChoice(selector, kind, render, pick) {
			for (const box of Array.from(document.querySelectorAll(selector))) {
				if (box.getAttribute("data-cf-hydrated") === "true") continue;
				if (!box.querySelector(kind.list)) continue;
				box.setAttribute("data-cf-hydrated", "true");
				box.style.display = "";
				render(box);
				bindChoice(box, kind, pick);
			}
		}
		// После выбора: все места показывают новое значение. Выпадашка остаётся
		// открытой, чтобы отметить ещё (несколько значений), закрывает её «Все».
		function rerenderChoice(selector, render, keepOpen) {
			for (const box of Array.from(document.querySelectorAll(`${selector}[data-cf-hydrated="true"]`))) {
				render(box);
				if (!keepOpen) box.removeAttribute("open");
			}
		}

		// ─────────── Коллекции ───────────
		const COLLECTIONS_BOX = '[data-nt="catalog-collections-filter"]';
		function collectionOptions() {
			return (catalogCollections ?? [])
				.map((c) => {
					const slug = typeof (c && c.slug) === "string" ? c.slug.trim() : "";
					const id = typeof (c && c.id) === "string" ? c.id.trim() : "";
					const label = typeof (c && c.name) === "string" ? c.name.trim() : "";
					return { id, value: slug || id, label };
				})
				.filter((o) => o.value !== "" && o.label !== "");
		}
		function renderCollectionsBox(box) {
			const options = collectionOptions();
			if (options.length === 0) return;
			const selected = selectedCollections();
			const names = selected.map((c) => (typeof c.name === "string" ? c.name.trim() : "")).filter(Boolean);
			renderChoice(box, CHOICE.collection, [
				{ value: "", label: "Все", active: selected.length === 0 },
				...options.map((o) => ({ value: o.value, label: o.label, active: selected.some((c) => c.id === o.id) })),
			], names.join(", "));
		}
		// Записать отмеченные коллекции в адрес (?collection=a&collection=b) и
		// показать выбор во всех местах фильтра — из списка и из чипа.
		function pickCollections(refs, keepOpen) {
			const params = new URLSearchParams(window.location.search);
			params.delete("collection");
			for (const ref of refs) params.append("collection", ref);
			const qs = params.toString();
			window.history.replaceState({}, "", window.location.pathname + (qs ? `?${qs}` : ""));
			rerenderChoice(COLLECTIONS_BOX, renderCollectionsBox, keepOpen);
		}
		function applyCollectionSelection(value) {
			// Несколько коллекций: нажатие отмечает коллекцию или снимает отметку, «Все» — все.
			const picked = new URLSearchParams(window.location.search).getAll("collection");
			pickCollections(value ? toggleValue(picked, value) : [], !!value);
			resetPageAndRender();
		}
		async function initCollectionsFilter() {
			if (!document.querySelector(COLLECTIONS_BOX)) return;
			catalogCollections = await loadRealCollections();
			if (collectionOptions().length === 0) return;
			hydrateChoice(COLLECTIONS_BOX, CHOICE.collection, renderCollectionsBox, applyCollectionSelection);
		}

		// ─────────── Цвет ───────────
		// Значения — из ЖИВОГО /api/store/filters (группа «Цвет»), как у rose:
		// товары грузятся постранично, собрать цвета каталога на клиенте нельзя.
		// Нет группы или сеть упала — фильтр остаётся скрытым. Можно отметить
		// несколько цветов: сервер показывает товары с любым из них; «Все» — сброс.
		const COLOR_GROUP_NAME = "Цвет";
		const COLOR_BOX = '[data-nt="catalog-color-filter"]';
		let availableColors = [];
		// Остальные параметры товара из /api/store/filters: [{ name, values }] без «Цвета».
		let variantGroups = [];
		let colorsRequest = null;
		async function fetchAvailableColors() {
			if (!storeId) return [];
			try {
				const res = await fetch(`${apiBase}/api/store/filters?store_id=${encodeURIComponent(storeId)}`);
				if (!res.ok) return [];
				const json = await res.json();
				const groups =
					(json && json.data && Array.isArray(json.data.groups) && json.data.groups) ||
					(json && Array.isArray(json.groups) && json.groups) ||
					[];
				variantGroups = groupsFrom(groups);
				const group = groups.find((g) => g && typeof g.name === "string" && g.name.trim() === COLOR_GROUP_NAME);
				const values = group && Array.isArray(group.values) ? group.values : [];
				return values
					.map((v) => (typeof v === "string" ? v : v && (v.value ?? v.name)))
					.filter((v) => typeof v === "string" && v !== "");
			} catch {
				return [];
			}
		}
		function loadAvailableColors() {
			colorsRequest = colorsRequest || fetchAvailableColors();
			return colorsRequest;
		}
		function renderColorBox(box) {
			renderChoice(box, CHOICE.color, [
				{ value: "", label: "Все", active: filters.colors.length === 0 },
				...availableColors.map((c) => ({ value: c, label: c, active: filters.colors.includes(c) })),
			], filters.colors.join(", "));
		}
		function applyColorSelection(value) {
			filters.colors = availableColors.includes(value) ? toggleValue(filters.colors, value) : [];
			rerenderChoice(COLOR_BOX, renderColorBox, !!value);
			resetPageAndRender();
		}
		function initColorFilter() {
			if (availableColors.length === 0) return;
			hydrateChoice(COLOR_BOX, CHOICE.color, renderColorBox, applyColorSelection);
		}

		// ─────────── Остальные параметры товара (Размер, Формат, Оттенок…) ───────────
		// Владелец: чипы «Формат: …» над товарами — значит, и фильтр по каждому
		// параметру товара, не только по «Цвету». Группы — из /api/store/filters
		// (fetchAvailableColors); фильтр каждой — копия «Цвета» с именем группы во
		// всех его местах (строка, сайдбар, шторка), та же обвязка выбора. В группе
		// несколько значений (товары с любым), разные группы — через И.
		// Служебные ключи запроса товаров (api-gateway store.controller): группа с
		// таким именем ушла бы в запрос поиском, тегами или страницей, а не
		// фильтром, — её не показываем.
		const QUERY_KEYS = new Set([
			"store_id", "collection_id", "sort", "page", "limit", "offset",
			"min_price", "max_price", "tags", "availability", "q",
		]);
		const groupsFrom = (groups) =>
			groups
				.map((g) => ({
					name: g && typeof g.name === "string" ? g.name.trim() : "",
					values: (g && Array.isArray(g.values) ? g.values : [])
						.map((v) => (typeof v === "string" ? v : v && (v.value ?? v.name)))
						.filter((v) => typeof v === "string" && v),
				}))
				.filter((g) => g.name && g.name !== COLOR_GROUP_NAME && !QUERY_KEYS.has(g.name) && g.values.length > 0);
		const variantValues = (group) => filters.variants[group] || [];
		const VARIANT_BOX = '[data-nt="catalog-variant-filter"]';
		const variantKind = (group) => ({
			list: "[data-variant-options]",
			label: "[data-variant-label]",
			dropdown: "data-variant-dropdown",
			attr: "data-variant-option",
			radio: "vanilla-variant",
			title: group,
		});
		// Атрибуты цвета в копии → атрибуты параметра.
		const COLOR_TO_VARIANT = [
			["data-color-options", "data-variant-options"],
			["data-color-label", "data-variant-label"],
			["data-color-dropdown", "data-variant-dropdown"],
		];
		function cloneColorBox(template, group) {
			const clone = template.cloneNode(true);
			clone.setAttribute("data-nt", "catalog-variant-filter");
			clone.setAttribute("data-variant-group", group);
			clone.removeAttribute("data-cf-hydrated");
			clone.removeAttribute("data-cf-radio-name");
			clone.removeAttribute("open");
			for (const [from, to] of COLOR_TO_VARIANT) {
				for (const el of [clone, ...Array.from(clone.querySelectorAll(`[${from}]`))]) {
					if (!el.hasAttribute(from)) continue;
					el.setAttribute(to, el.getAttribute(from));
					el.removeAttribute(from);
				}
			}
			const title = Array.from(clone.querySelectorAll("span, p")).find(
				(el) => el.children.length === 0 && (el.textContent || "").trim() === COLOR_GROUP_NAME,
			);
			if (title) title.textContent = group;
			// Пункты цвета из копии убираем сразу: их наполнит renderVariantBox.
			for (const list of Array.from(clone.querySelectorAll("[data-variant-options]"))) list.innerHTML = "";
			return clone;
		}
		function variantBoxes(group) {
			return Array.from(document.querySelectorAll(VARIANT_BOX)).filter(
				(box) => group === null || box.getAttribute("data-variant-group") === group,
			);
		}
		function renderVariantBox(box) {
			const name = box.getAttribute("data-variant-group");
			const group = variantGroups.find((g) => g.name === name);
			const values = variantValues(name);
			renderChoice(box, variantKind(name), [
				{ value: "", label: "Все", active: values.length === 0 },
				...(group ? group.values : []).map((v) => ({ value: v, label: v, active: values.includes(v) })),
			], values.join(", "));
		}
		// После выбора: все места группы (null — всех групп) показывают новое значение.
		function rerenderVariantBoxes(group, keepOpen) {
			for (const box of variantBoxes(group).filter((b) => b.getAttribute("data-cf-hydrated") === "true")) {
				renderVariantBox(box);
				if (!keepOpen) box.removeAttribute("open");
			}
		}
		function applyVariantSelection(group, value) {
			filters.variants = { ...filters.variants, [group]: value ? toggleValue(variantValues(group), value) : [] };
			rerenderVariantBoxes(group, !!value);
			resetPageAndRender();
		}
		// Фильтр каждой группы — сразу за «Цветом»; прежние копии убираем:
		// гидрация повторяется при навигации.
		function initVariantFilters() {
			for (const old of variantBoxes(null)) old.remove();
			for (const template of Array.from(document.querySelectorAll(COLOR_BOX))) {
				template.after(...variantGroups.map((g) => cloneColorBox(template, g.name)));
			}
			for (const box of variantBoxes(null)) {
				if (!box.querySelector("[data-variant-options]")) continue;
				const group = box.getAttribute("data-variant-group");
				box.setAttribute("data-cf-hydrated", "true");
				box.style.display = "";
				renderVariantBox(box);
				bindChoice(box, variantKind(group), (value) => applyVariantSelection(group, value));
			}
		}

		// ─────────── Дропдауны верхних (top) фильтров ───────────
		// top-фильтры = нативные <details>: не закрывались по клику вне и не
		// закрывали соседей → открыто несколько панелей разом. single-open +
		// outside-click + Esc.
		function bindFilterDropdowns() {
			for (const bar of Array.from(
				document.querySelectorAll('[data-nt="catalog-filters"]'),
			)) {
				if (bar.getAttribute("data-cf-dropdowns") === "1") continue;
				bar.setAttribute("data-cf-dropdowns", "1");
				for (const d of Array.from(bar.querySelectorAll("details"))) {
					d.addEventListener("toggle", () => {
						if (!d.open) return;
						for (const other of Array.from(bar.querySelectorAll("details"))) {
							if (other !== d) other.open = false;
						}
					});
				}
			}
			if (!window.__merfyCatalogDropdownGlobal) {
				window.__merfyCatalogDropdownGlobal = true;
				document.addEventListener("click", (ev) => {
					for (const d of Array.from(
						document.querySelectorAll('[data-nt="catalog-filters"] details[open]'),
					)) {
						if (!d.contains(ev.target)) d.open = false;
					}
				});
				document.addEventListener("keydown", (ev) => {
					if (ev.key !== "Escape") return;
					for (const d of Array.from(
						document.querySelectorAll('[data-nt="catalog-filters"] details[open]'),
					)) {
						d.open = false;
					}
				});
			}
		}

		// Дедуп (rose-канон): и inline-вызов, и astro:page-load срабатывают на первой
		// загрузке с ОДНИМ url → второй пропускаем (иначе дубль fetch page=1).
		let hydrating = false;
		let lastHydratedUrl = null;

		async function hydrateCatalog() {
			if (hydrating) return; // не запускать две гидрации параллельно (race → дубль-fetch)
			const url = location.pathname + location.search;
			if (url === lastHydratedUrl) return;
			lastHydratedUrl = url;
			hydrating = true;
			try {
				// Снимок скелетон-лоадера из SSG-грида ДО первого fetch (renderCatalog
				// replace затрёт скелетон) — нужен для replace при смене фильтра/сортировки.
				captureSkeleton();
				// Коллекции (для collection_id серверного фильтра) и цвета (фильтр
				// «Цвет») грузим ДО товаров и параллельно — buildProductsQuery резолвит
				// slug→id уже на первой странице.
				[catalogCollections, availableColors] = await Promise.all([loadRealCollections(), loadAvailableColors()]);
				bindStock();
				bindSort();
				bindPrice();
				bindLoadMore();
				bindFilterDropdowns();
				syncStockUi();
				syncSortUi();
				initColorFilter();
				initVariantFilters();
				// Первая страница товаров (REPLACE) — реальный fetch /api/store/products.
				syncFilterChips();
				await renderCatalog(false);
				// UI фильтра коллекций — после товаров (collections уже в кэше, без fetch).
				await initCollectionsFilter();
			} finally {
				hydrating = false;
			}
		}

		hydrateCatalog();
		document.addEventListener("astro:page-load", hydrateCatalog);
	})();
</script>
