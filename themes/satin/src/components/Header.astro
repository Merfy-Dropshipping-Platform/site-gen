---
import NtIcon from "@merfy-dropshipping-platform/design-systems-theme/components/ui/NtIcon.astro";
import SchemeIcon from "../../../../packages/theme-base/primitives/SchemeIcon.astro";
import { SATIN_ICON_SVGS } from "./icons/satin-icon-svgs";
import NavItem from "./header/NavItem.astro";
import { NAV_SUBMENU_TOGGLE_SOURCE } from "../../../../packages/theme-base/runtime/nav-submenu-toggle";
import { SITE_TITLE } from "../consts";

interface NavLink {
	label: string;
	href: string;
	submenu?: NavLink[];
	match?: (pathname: string) => boolean;
}

const defaultNav: NavLink[] = [
	{ label: "Коллекции", href: "/catalog", match: (p) => p === "/" || p.startsWith("/catalog") || p.startsWith("/products") },
	{ label: "История", href: "/about", match: (p) => p.startsWith("/about") },
	{ label: "Контакты", href: "/contacts" },
];

const p = Astro.props as Record<string, any>;
const id = p.id;
const siteTitle = typeof p.siteTitle === "string" && p.siteTitle.trim() ? p.siteTitle : SITE_TITLE;
const mapNavLink = (l: any): NavLink => ({
	label: l.label ?? l.text ?? "",
	href: l.href ?? l.link ?? "/",
	submenu: Array.isArray(l.submenu) ? l.submenu.map(mapNavLink) : undefined,
});
const navFromProps = Array.isArray(p.navigationLinks) && p.navigationLinks.length > 0;
const nav: NavLink[] = navFromProps ? p.navigationLinks.map(mapNavLink) : defaultNav;

const logo = typeof p.logo === "string" && p.logo.trim() ? p.logo : undefined;
const logoImgCls = "h-[var(--size-logo-width,22px)] w-auto max-w-[160px] object-contain";

// Контракт раскладки = rose Header: mobile lg:hidden не зависит от logoPosition;
// desktop hidden lg:block — 4 положения. Пустое/неизвестное → однорядно слева
// (как rose), не абсолютный центр.
const logoPosition = typeof p.logoPosition === "string" ? p.logoPosition : "";
const logoLeft = logoPosition === "center-left";
const isTwoRow = logoPosition === "top-left" || logoPosition === "top-center";
const logoCentered = logoPosition === "top-center" || logoPosition === "center-absolute";
const desktopLogoCls = logoCentered
	? "font-logo absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-[22px] font-normal uppercase leading-none text-[rgb(var(--color-heading,0_0_0))] hover:opacity-90"
	: "font-logo shrink-0 text-[22px] font-normal uppercase leading-none text-[rgb(var(--color-heading,0_0_0))] hover:opacity-90";

const stickiness = typeof p.stickiness === "string" ? p.stickiness : "";
const rootCls =
	stickiness === "always"
		? "sticky top-0 z-50 w-full"
		: stickiness === "scroll-up"
			? "sticky top-0 z-50 w-full transition-transform duration-300"
			: "relative z-50 w-full";
const SCROLL_UP_JS = [
	"(function(){",
	"var root=document.querySelector('[data-satin-sticky=\"scroll-up\"]');",
	"if(!root||root.getAttribute('data-hydrated')==='true')return;",
	"root.setAttribute('data-hydrated','true');",
	"var last=window.scrollY;",
	"window.addEventListener('scroll',function(){",
	"var y=window.scrollY;",
	"if(y>last&&y>root.offsetHeight){root.style.transform='translateY(-100%)';}else{root.style.transform='';}",
	"last=y;",
	"},{passive:true});",
	"})();",
].join("");

const pad = p.padding && typeof p.padding === "object" ? p.padding : undefined;
const headerPad = pad
	? { top: Math.min(Number(pad.top) || 0, 64), bottom: Math.min(Number(pad.bottom) || 0, 64) }
	: undefined;
const headerPadStyle = headerPad
	? `padding-top:${headerPad.top}px;padding-bottom:${headerPad.bottom}px;`
	: undefined;
// ОДНОрядная раскладка. Позиционированного предка здесь больше нет: плашка
// «Расширенного» меню считает края от ближайшего позиционированного предка, и с
// ним она вставала выше низа шапки и накрывала пункт верхнего уровня (замер
// 1280: низ рельса 60 против низа шапки 65, накрыт «TWS-наушники с кейсом») —
// ровно жалоба из пункта 26 документа владельца. Логотип «по центру»
// центрируется гридом [1fr auto 1fr], а не `absolute`, поэтому якорем плашки
// остаётся сам <header>.
const singleRowCentered = logoPosition === "center-absolute";
const desktopRowCls = [
	"satin-pad mx-auto w-full max-w-[1920px] items-center",
	singleRowCentered ? "grid grid-cols-[1fr_auto_1fr]" : "flex",
	headerPad ? "" : "min-h-16",
	logoLeft ? "gap-8" : "justify-between",
]
	.filter(Boolean)
	.join(" ");
const desktopCenterLogoCls =
	"font-logo col-start-2 shrink-0 justify-self-center text-[22px] font-normal uppercase leading-none text-[rgb(var(--color-heading,0_0_0))] hover:opacity-90";
const twoRowCls = [
	"satin-pad mx-auto flex w-full max-w-[1920px] flex-col",
	headerPad ? "" : "py-4",
]
	.filter(Boolean)
	.join(" ");

const menuType = typeof p.menuType === "string" ? p.menuType : "dropdown";
const isMegaMenu = menuType === "mega-menu";
const isSidebar = menuType === "sidebar";
const navLinkCls = [
	// `whitespace-nowrap`: длинный пункт («TWS-наушники с кейсом») в узкой колонке
	// переносился внутри себя на три строки, пункт вырастал до 76px при строке
	// шапки в 64px и вылезал под неё — там его и накрывала плашка «Расширенного»
	// меню (жалоба из пункта 26 документа владельца про наезжающие пункты).
	// Не помещающиеся пункты теперь переносятся ЦЕЛИКОМ (flex-wrap на nav), а
	// строка шапки растёт вместе с ними (min-h вместо жёсткой высоты).
	"group/mega relative inline-flex items-center gap-1 whitespace-nowrap pb-1 font-manrope text-[16px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))] transition-opacity hover:opacity-70",
	isMegaMenu ? " tracking-[0.06em]" : "",
].filter(Boolean).join(" ");

// §4 Контракта секции: платформа отдаёт схему строкой ИЛИ числом (нормализатор
// Slideshow приводит к номеру) — проверка только на string молча не срабатывала.
const _schemeStr = (v: unknown): string =>
	typeof v === "number" ? String(v) : typeof v === "string" ? v : "";
const menuColorScheme = _schemeStr(p.menuColorScheme);
const menuSchemeClass = menuColorScheme ? `color-scheme-${menuColorScheme.replace("scheme-", "")}` : "";
const colorScheme = _schemeStr(p.colorScheme);
const headerSchemeClass = colorScheme ? `color-scheme-${colorScheme.replace("scheme-", "")}` : "";

const pathname = Astro.url.pathname;
const isActive = (link: NavLink) => (link.match ? link.match(pathname) : pathname === link.href);

// Магазин для живого поиска: build.service патчит `const shopId = ""` → siteId на
// публикации (patchShopIdInDist), ровно как у подвала и корзины темы.
const shopId = "";
---

<div
	class:list={[rootCls, headerSchemeClass]}
	data-puck-component-id={id}
	data-header-wrapper
	data-satin-sticky={stickiness === "scroll-up" ? "scroll-up" : undefined}
>
	{
		!id && (
			<a href="/catalog" class="block bg-black py-2 text-center font-manrope text-[11px] font-normal uppercase tracking-[0.04em] text-white transition-opacity hover:opacity-80 md:text-[14px]">
				Скидка 10% на общую сумму заказа от 9 000₽. Перейти
			</a>
		)
	}

	<div class="overflow-visible bg-[rgb(var(--color-bg,255_255_255))]">
	<header class:list={["relative w-full overflow-visible border-b border-[rgb(var(--color-text,0_0_0)/13%)] bg-[rgb(var(--color-bg,255_255_255))]", headerSchemeClass]} data-nt="satin-header">
		{/* Mobile — как rose: lg:hidden, logoPosition не трогает эту полосу. */}
		<div class="relative z-[60] flex h-14 items-center justify-between bg-[rgb(var(--color-bg,255_255_255))] px-4 lg:hidden">
			<button
				type="button"
				id="satin-burger-btn"
				data-burger-toggle
				class="flex h-10 w-10 items-center justify-center transition-opacity hover:opacity-70"
				aria-label="Меню"
				aria-expanded="false"
				aria-controls="satin-burger"
			>
				<span class="burger-icon" data-icon="open"><SchemeIcon svgs={SATIN_ICON_SVGS} name="menu-burger" sizeClass="size-6" /></span>
				<span class="burger-icon hidden" data-icon="close"><SchemeIcon svgs={SATIN_ICON_SVGS} name="menu-close" sizeClass="size-6" /></span>
			</button>
			<a href="/" class="font-logo text-lg font-normal uppercase leading-none text-[rgb(var(--color-heading,0_0_0))] hover:opacity-80">
				{logo ? <img src={logo} alt={siteTitle} class={logoImgCls} /> : siteTitle}
			</a>
			<div class="flex items-center gap-4">
				<button type="button" data-action="toggle-search" class="flex h-6 w-6 items-center justify-center" aria-label="Поиск">
					<SchemeIcon svgs={SATIN_ICON_SVGS} name="search-sm" sizeClass="size-6" />
				</button>
				<a href="/wishlist" class="relative flex h-6 w-6 items-center justify-center transition-opacity hover:opacity-80" aria-label="Избранное">
					<SchemeIcon svgs={SATIN_ICON_SVGS} name="favourite" sizeClass="size-6" />
					{/* Цифра счётчика — роль схемы «Текст кнопки», а не `text-white`: белым
					   списком матрицы прикрыта только ПЛАШКА (её фирменный цвет —
					   узнаваемый вид темы), а цифра читаема на плашке любого цвета и
					   обязана следовать выбору мерчанта (решение владельца 15.09,
					   сужение исключения `counter-badge`). Фолбэк 255_255_255 —
					   прежний белый, вид без схемы не меняется. Сторож:
					   pnpm test:scheme-matrix. */}
					<span data-wishlist-count data-empty="true" class="absolute -right-2 -top-2 inline-flex h-4 min-w-4 items-center justify-center bg-[#000000] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden">0</span>
				</a>
				<button type="button" data-cart-open class="relative flex h-6 w-6 items-center justify-center" aria-label="Корзина">
					<SchemeIcon svgs={SATIN_ICON_SVGS} name="cart-sm" sizeClass="size-6" />
					<span data-cart-count data-empty="true" class="absolute -right-2 -top-2 inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-[#000000] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden">0</span>
				</button>
			</div>
		</div>

		{/* Desktop — как rose: hidden lg:block. Конструктор 1280px → эта ветка. */}
		<div class="hidden w-full lg:block">
			{isTwoRow ? (
				<div class={twoRowCls} style={headerPadStyle}>
					{logoPosition === "top-left" ? (
						<>
							<div class="flex w-full items-center justify-between">
								<div class="flex items-center gap-3">
									<a href="/" class="font-logo text-[22px] font-normal uppercase leading-none text-[rgb(var(--color-heading,0_0_0))] hover:opacity-90">
										{logo ? <img src={logo} alt={siteTitle} class={logoImgCls} /> : siteTitle}
									</a>
								</div>
								<div class="flex items-center gap-5">
									<button type="button" data-action="toggle-search" class="flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Поиск">
										<SchemeIcon svgs={SATIN_ICON_SVGS} name="search-lg" sizeClass="size-6" />
									</button>
									<a href="/wishlist" class="relative flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Избранное">
										<SchemeIcon svgs={SATIN_ICON_SVGS} name="favourite" sizeClass="size-6" />
										<span data-wishlist-count data-empty="true" class="absolute -right-1.5 -top-1.5 inline-flex h-4 min-w-4 items-center justify-center bg-[#000000] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden">0</span>
									</a>
									<button type="button" data-cart-open class="relative flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Корзина">
										<SchemeIcon svgs={SATIN_ICON_SVGS} name="cart" sizeClass="size-6" />
										<span data-cart-count data-empty="true" class="absolute right-0 top-0 inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-[#000000] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden">0</span>
									</button>
									{isSidebar && (
										<button type="button" data-burger-toggle class="flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Меню" aria-expanded="false" aria-controls="satin-burger">
											<span class="burger-icon" data-icon="open"><SchemeIcon svgs={SATIN_ICON_SVGS} name="menu-burger" sizeClass="size-6" /></span>
											<span class="burger-icon hidden" data-icon="close"><SchemeIcon svgs={SATIN_ICON_SVGS} name="menu-close" sizeClass="size-6" /></span>
										</button>
									)}
								</div>
							</div>
							<nav
								class:list={["mt-3 flex w-full items-center justify-start gap-8", menuSchemeClass, isSidebar && "lg:!hidden"]}
								aria-label="Основная навигация"
								data-nav-inline
								data-puck-subsection-parent={id}
								data-puck-subsection-index="997"
								data-puck-subsection-field="navigationLinks"
							>
								{nav.map((link) => (
									<NavItem link={link} menuType={menuType} linkClass={navLinkCls} active={isActive(link)} />
								))}
							</nav>
						</>
					) : (
						<>
							<div class="grid w-full grid-cols-[1fr_auto_1fr] items-center">
						{/* Левая ячейка — распорка: она держит логотип ровно по центру грида.
						    Поиск отсюда убран (жалоба владельца 21.09 «не должно быть поиска
						    слева»): он переехал к остальным иконкам справа, чтобы ряд действий
						    не разрывался. */}
								<div class="flex items-center gap-4">
								</div>
								<div class="flex items-center justify-center">
									<a href="/" class="font-logo text-[22px] font-normal uppercase leading-none text-[rgb(var(--color-heading,0_0_0))] hover:opacity-90">
										{logo ? <img src={logo} alt={siteTitle} class={logoImgCls} /> : siteTitle}
									</a>
								</div>
								<div class="flex items-center justify-end gap-5">
									<button type="button" data-action="toggle-search" class="flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Поиск">
										<SchemeIcon svgs={SATIN_ICON_SVGS} name="search-lg" sizeClass="size-6" />
									</button>
									<a href="/wishlist" class="relative flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Избранное">
										<SchemeIcon svgs={SATIN_ICON_SVGS} name="favourite" sizeClass="size-6" />
										<span data-wishlist-count data-empty="true" class="absolute -right-1.5 -top-1.5 inline-flex h-4 min-w-4 items-center justify-center bg-[#000000] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden">0</span>
									</a>
									<button type="button" data-cart-open class="relative flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Корзина">
										<SchemeIcon svgs={SATIN_ICON_SVGS} name="cart" sizeClass="size-6" />
										<span data-cart-count data-empty="true" class="absolute right-0 top-0 inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-[#000000] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden">0</span>
									</button>
									{isSidebar && (
										<button type="button" data-burger-toggle class="flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Меню" aria-expanded="false" aria-controls="satin-burger">
											<span class="burger-icon" data-icon="open"><SchemeIcon svgs={SATIN_ICON_SVGS} name="menu-burger" sizeClass="size-6" /></span>
											<span class="burger-icon hidden" data-icon="close"><SchemeIcon svgs={SATIN_ICON_SVGS} name="menu-close" sizeClass="size-6" /></span>
										</button>
									)}
								</div>
							</div>
							<nav
								class:list={["mt-3 flex w-full items-center justify-center gap-8", menuSchemeClass, isSidebar && "lg:!hidden"]}
								aria-label="Основная навигация"
								data-nav-inline
								data-puck-subsection-parent={id}
								data-puck-subsection-index="997"
								data-puck-subsection-field="navigationLinks"
							>
								{nav.map((link) => (
									<NavItem link={link} menuType={menuType} linkClass={navLinkCls} active={isActive(link)} />
								))}
							</nav>
						</>
					)}
				</div>
			) : (
				<div class={desktopRowCls} style={headerPadStyle}>
					<a href="/" class:list={[singleRowCentered ? desktopCenterLogoCls : desktopLogoCls, logoLeft && "flex-1"]}>
						{logo ? <img src={logo} alt={siteTitle} class={logoImgCls} /> : siteTitle}
					</a>
					<nav
						class:list={["flex flex-wrap items-center gap-8", singleRowCentered && "col-start-1", menuSchemeClass, isSidebar && "lg:!hidden"]}
						aria-label="Основная навигация"
						data-nav-inline
						data-puck-subsection-parent={id}
						data-puck-subsection-index="997"
						data-puck-subsection-field="navigationLinks"
					>
						{nav.map((link) => (
							<NavItem link={link} menuType={menuType} linkClass={navLinkCls} active={isActive(link)} />
						))}
					</nav>
					<div class:list={["flex items-center gap-5", singleRowCentered && "col-start-3 justify-self-end", logoLeft && "flex-1 justify-end"]}>
						<button type="button" data-action="toggle-search" class="flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Поиск">
							<SchemeIcon svgs={SATIN_ICON_SVGS} name="search-lg" sizeClass="size-6" />
						</button>
						<a href="/wishlist" class="relative flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Избранное">
							<SchemeIcon svgs={SATIN_ICON_SVGS} name="favourite" sizeClass="size-6" />
							<span data-wishlist-count data-empty="true" class="absolute -right-1.5 -top-1.5 inline-flex h-4 min-w-4 items-center justify-center bg-[#000000] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden">0</span>
						</a>
						<button type="button" data-cart-open class="relative flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Корзина">
							<SchemeIcon svgs={SATIN_ICON_SVGS} name="cart" sizeClass="size-6" />
							<span data-cart-count data-empty="true" class="absolute right-0 top-0 inline-flex h-4 min-w-4 items-center justify-center rounded-full bg-[#000000] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden">0</span>
						</button>
											{isSidebar && (
							<button type="button" data-burger-toggle class="flex h-8 w-8 items-center justify-center transition-opacity hover:opacity-80" aria-label="Меню" aria-expanded="false" aria-controls="satin-burger">
								<span class="burger-icon" data-icon="open"><SchemeIcon svgs={SATIN_ICON_SVGS} name="menu-burger" sizeClass="size-6" /></span>
								<span class="burger-icon hidden" data-icon="close"><SchemeIcon svgs={SATIN_ICON_SVGS} name="menu-close" sizeClass="size-6" /></span>
							</button>
						)}
					</div>
				</div>
			)}
		</div>

		{/* Поиск (макет «Поиск» 1320×374): коробка выпадает ПОВЕРХ страницы под
		    шапкой — строка поиска и ряд карточек с прокруткой вбок. Живые результаты —
		    общий модуль theme-base/runtime/header-search, вид — lib/header-search-view
		    (раньше подсказки строились из демо-товаров сборки темы и у настоящего
		    магазина показывали чужой ассортимент). Цвета: строка поиска — Схема 1
		    (правило form[role="search"], решение владельца 15.09 про поле и кнопку),
		    выдача — «Поверхность» схемы шапки (#F5F5F5 макета). Сторож фона выдачи:
		    pnpm test:scheme-targets. «Найти» по-прежнему ведёт в каталог. */}
		<div data-search-panel class="absolute left-0 right-0 top-full z-40 hidden w-full" hidden>
			<div class="satin-pad">
				<div
					data-header-search
					data-search-layout="panel"
					data-search-limit="12"
					class="satin-container flex flex-col shadow-[0_8px_24px_rgba(0,0,0,0.08)]"
				>
					<form role="search" action="/catalog" method="get" class="flex h-12 items-center justify-between gap-2 bg-white pl-3 pr-1">
						<input type="search" name="q" placeholder="Поиск..." aria-label="Поиск" autocomplete="off" class="min-w-0 flex-1 bg-transparent font-manrope text-[16px] font-normal uppercase leading-5 text-[#000000] placeholder:text-[#999999] outline-none" />
						<button type="submit" class="flex h-10 shrink-0 items-center justify-center bg-[#000000] px-3 font-manrope text-[14px] font-normal uppercase leading-[19px] text-white transition-opacity hover:opacity-95">Найти</button>
					</form>
					<div data-search-results hidden aria-live="polite" class="bg-[rgb(var(--color-surface,245_245_245))] p-3 aria-busy:opacity-60"></div>
				</div>
			</div>
		</div>
	</header>
	</div>

	<div
		id="satin-burger"
		class:list={[
			// «Цветовая схема меню» красит и шторку, а не только инлайн-навигацию.
			// Баг 24 документа владельца: «панель бокового меню остаётся белой, цвета
			// выбранной схемы меню к ней не применяются». Замер: menuColorScheme
			// доезжал до <nav>, но на корень шторки класс схемы никто не вешал — во
			// ВСЕХ пяти темах, не только в bloom. Пусто, если схема меню не задана —
			// тогда шторка наследует схему секции, как раньше.
			menuSchemeClass,
			"fixed",
			// Боковая панель лежит ПОВЕРХ шапки страницы. Мобильная строка шапки стоит
			// на z-[60] и рисовалась поверх панели: две шапки одна на другой, крестик и
			// иконки дважды (баги 1 и 3 документа «баги бокового меню», 22.09). Нижней
			// шторке — прежний z-[55]: она открывается ПОД строкой шапки.
			isSidebar ? "z-[70]" : "z-[55]",
			"hidden overflow-y-auto bg-[rgb(var(--color-bg,255_255_255))]",
			// Боковая панель, пока видна мобильная строка шапки (до lg), — во весь
			// экран: было 90vw у правого края, и слева полосой просвечивала страница
			// (баг 1). С lg — колонка 360px на всю высоту. overscroll-contain:
			// прокрутка панели не утекает на страницу.
			// Выезд за 300 мс и обратно (баг 1 документа «баги пунктов меню»:
			// панель появлялась и пропадала за один кадр) — с той стороны, где
			// иконка меню: на телефоне бургер слева, и панель выезжает слева; с lg
			// панель — колонка у правого края, кнопка справа, и выезд справа.
			// Скрипт темы по-прежнему переключает `hidden`; переход через display: none дают
			// `transition-discrete` и `starting:` (@starting-style) — без них
			// display не анимируется, и панель прыгала бы. Где их не поддерживает
			// браузер — панель просто появляется, как раньше.
			// Нижняя шторка других типов меню (на телефоне) спадает из-под шапки
			// за 300 мс и так же уходит: clip-path сверху вниз на том же `hidden`
			// (пункт 2 той же пачки — раньше открывалась рывком).
			isSidebar
				? "inset-y-0 left-0 right-0 w-full overscroll-contain px-6 pt-6 pb-8 lg:left-auto lg:w-[360px] transition-[translate,display] transition-discrete duration-300 ease-out starting:-translate-x-full [&.hidden]:-translate-x-full lg:starting:translate-x-full lg:[&.hidden]:translate-x-full motion-reduce:transition-none"
				: "inset-x-0 top-[56px] bottom-0 w-full px-4 pt-4 pb-8 lg:hidden [clip-path:inset(0)] transition-[clip-path,display] transition-discrete duration-300 ease-out starting:[clip-path:inset(0_0_100%_0)] [&.hidden]:[clip-path:inset(0_0_100%_0)] motion-reduce:transition-none",
		]}
		role="dialog"
		aria-modal="true"
		aria-label="Меню"
		data-header-search
		data-search-layout="drawer"
		data-search-limit="8"
	>
		{isSidebar ? (
			<div class="flex items-center justify-between">
				{/* Шапка открытой панели: крестик и корзина. Крестик на месте логотипа
				    (пункт 29 документа владельца) — логотип рисовался и в панели, и в
				    шапке страницы. Избранного здесь нет — остаётся только корзина
				    (баг 4 документа «баги бокового меню»). */}
				<button
					type="button"
					data-burger-toggle
					data-burger-close
					aria-expanded="true"
					aria-controls="satin-burger"
					aria-label="Закрыть меню"
					class="flex h-10 w-10 shrink-0 items-center justify-center transition-opacity hover:opacity-70"
				>
					<SchemeIcon svgs={SATIN_ICON_SVGS} name="menu-close" sizeClass="size-6" />
				</button>
				<div class="flex items-center gap-4">
					<button type="button" data-cart-open class="relative flex h-8 w-8 shrink-0 items-center justify-center transition-opacity hover:opacity-80" aria-label="Корзина">
						<SchemeIcon svgs={SATIN_ICON_SVGS} name="cart" sizeClass="size-6" />
						<span data-cart-count data-empty="true" class="absolute right-0 top-0 inline-flex h-4 min-w-4 items-center justify-center bg-[#000000] px-1 font-manrope text-[10px] font-normal leading-none text-[rgb(var(--color-button-text,255_255_255))] data-[empty=true]:hidden">0</span>
					</button>
				</div>
			</div>
		) : (
			<>
				{/* Строка поиска шторки — по макету «Бургер» 375: 40px, кнопка «Найти»
				    52×32 справа, текст Arsenal 14 прописными. */}
				<div class="flex items-center gap-2">
					<form class="flex h-10 min-h-10 flex-1 items-center justify-between gap-2 pl-2 pr-1" role="search" action="/catalog" method="get">
						<input type="search" name="q" placeholder="Поиск..." aria-label="Поиск" autocomplete="off" class="min-w-0 flex-1 bg-transparent font-manrope text-[14px] font-normal uppercase leading-[18px] text-[#000000] placeholder:text-[#999999] outline-none" />
						<button type="submit" class="flex h-8 shrink-0 items-center justify-center bg-[rgb(var(--color-button-bg,0_0_0))] px-2 font-manrope text-[12px] font-normal uppercase leading-[15px] text-[rgb(var(--color-button-text,255_255_255))]" aria-label="Найти">
							Найти
						</button>
					</form>
					{/* Иконка — цветом «Текст кнопки»: без colorClass она красилась
					    «Текстом» и на чёрной заливке кнопки пропадала (замер живой
					    витрины 22.09: чёрный квадрат без значка). Так же rose и flux. */}
					<a href="/login" data-auth-link class="flex h-10 w-10 shrink-0 items-center justify-center bg-[rgb(var(--color-button-bg,0_0_0))]" aria-label="Профиль">
						<SchemeIcon svgs={SATIN_ICON_SVGS} name="user" sizeClass="size-6" colorClass="text-[rgb(var(--color-button-text,255_255_255))]" />
					</a>
				</div>
				{/* Живые результаты поиска шторки: пока они на экране, меню спрятано
				    (`data-search-idle`) — выдача встаёт на место пунктов. Фон — роль
				    «Поверхность», как у выдачи панели (сторож pnpm test:scheme-targets). */}
				<div data-search-results hidden aria-live="polite" class="mt-4 bg-[rgb(var(--color-surface,245_245_245))] p-2 aria-busy:opacity-60"></div>
			</>
		)}

		<nav class:list={["flex flex-col gap-4", isSidebar ? "mt-10" : "mt-8"]} aria-label="Основное меню" data-nav-drawer data-search-idle>
			{nav.map((link) => {
				const active = isActive(link);
				const subs = Array.isArray(link.submenu)
					? link.submenu.filter((s) => s && typeof s.label === "string" && s.label.trim() !== "")
					: [];
				return (
					<div class="flex flex-col gap-1.5" data-nav-group={subs.length > 0 ? "" : undefined}>
						{/* Пункт с вложенностью раскрывается ВСЕЙ СТРОКОЙ, стрелка одна
						    (пункт 28 документа владельца). Ссылкой он не рисуется: нажатие
						    уводило на страницу и закрывало меню вместо раскрытия. */}
						{subs.length > 0 ? (
							<button
								type="button"
								data-nav-sub-toggle
								aria-expanded="false"
								class:list={[
									"flex w-full items-center justify-between gap-2 text-left font-manrope text-xs font-normal leading-normal transition-colors",
									"[&[aria-expanded=true]>svg]:rotate-90",
									active ? "text-[rgb(var(--color-text,0_0_0))]" : "text-[rgb(var(--color-muted,96_96_96))] hover:text-[rgb(var(--color-text,0_0_0))]",
								]}
							>
								<span>{link.label}</span>
								<svg class="size-3 shrink-0 transition-transform" viewBox="0 0 8 8" fill="none" aria-hidden="true">
									<path d="M2.5 1 5.5 4 2.5 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</button>
						) : (
							<a href={link.href} class:list={["font-manrope text-xs font-normal leading-normal", active ? "text-[rgb(var(--color-text,0_0_0))]" : "text-[rgb(var(--color-muted,96_96_96))]"]}>{link.label}</a>
						)}
						{active && <div class="h-0.5 w-12 bg-[rgb(var(--color-text,0_0_0))]" aria-hidden="true"></div>}
						{/* Вложенные пункты раскрываются нажатием на строку пункта (пункты
						    25 и 28 документа владельца). */}
						{subs.length > 0 && (
							<div class="flex flex-col gap-1.5" data-nav-sub hidden>
								{subs.map((s) => (
									<a href={s.href} class="pl-3 font-manrope text-xs font-light leading-normal text-[rgb(var(--color-muted,153_153_153))]">{s.label}</a>
								))}
							</div>
						)}
					</div>
				);
			})}
			{/* Здесь стояли ДВА зашитых пункта — «Корзина» и «Регистрация» — дописанных
			    после цикла по меню мерчанта, то есть остатки демо-вёрстки, а не его
			    настройка. «Регистрация» вела на страницу, которой нет: в сидах темы
			    есть только `login`. На витрине nginx отдавал на этот адрес заглушку
			    (200 с чужим содержимым), а в превью конструктора — 404 бэкенда
			    («Cannot GET /register»), ровно тот, что попал в отчёт тестера.
			    Меню шторки теперь показывает только пункты мерчанта. */}
		</nav>
	</div>

	{/* Вложенные пункты в шторке раскрываются нажатием (пункт 25 документа
	    владельца). Обработчик общий на все пять тем. */}
	<script is:inline set:html={NAV_SUBMENU_TOGGLE_SOURCE} />
	{stickiness === "scroll-up" && <script is:inline set:html={SCROLL_UP_JS} />}
	{/* Магазин для живого поиска шапки: `const shopId = ""` патчит сборка
	    (patchShopIdInDist) — как у подвала и корзины. В превью конструктора id
	    приходит глобалом __MERFY_SITE_ID__, пустая строка здесь ничего не ломает. */}
	<script is:inline define:vars={{ shopId }}>
		window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || { shopId: shopId || "", apiUrl: "https://gateway.merfy.ru/api" };
		if (shopId && !window.__MERFY_CONFIG__.shopId) window.__MERFY_CONFIG__.shopId = shopId;
	</script>
</div>

<script>
	import { focusSearchToggle, initHeaderSearch } from "../../../../packages/theme-base/runtime/header-search";
	import { renderSearchResults, SEARCH_MESSAGE_CLASS } from "../lib/header-search-view";

	// Живой поиск из лупы: панель шапки и шторка бургера (общий модуль на пять тем).
	initHeaderSearch({ render: renderSearchResults, messageClass: SEARCH_MESSAGE_CLASS });

	// Шторку ищем при каждом обращении, а не один раз при загрузке: превью
	// конструктора перерисовывает шапку, и запомненный узел устаревал.
	const burgerEl = () => document.getElementById("satin-burger");

	const isSidebarDrawer = () => burgerEl()?.classList.contains("inset-y-0") ?? false;

	// Мобильная шторка встаёт под ФАКТИЧЕСКИЙ низ шапки. Класс `top-[56px]` —
	// только фолбэк: над шапкой бывает полоса объявления, и верх шторки (строка
	// поиска) уезжал под мобильную строку шапки (z-60). Так же rose/vanilla/bloom.
	const positionBurger = () => {
		const burger = burgerEl();
		if (!burger || isSidebarDrawer()) return;
		const header = document.querySelector<HTMLElement>('[data-nt="satin-header"]');
		if (!header) return;
		burger.style.top = `${Math.max(0, Math.round(header.getBoundingClientRect().bottom))}px`;
	};

	const syncBurgerButtonIcons = (open: boolean) => {
		document.querySelectorAll<HTMLElement>("[data-burger-toggle]").forEach((btn) => {
			btn.setAttribute("aria-expanded", String(open));
			btn.querySelectorAll<HTMLElement>(".burger-icon").forEach((el) => {
				const key = el.dataset.icon;
				if (key === "open") el.classList.toggle("hidden", open);
				else el.classList.toggle("hidden", !open);
			});
		});
	};

	const setSearchOpen = (open: boolean) => {
		const panel = document.querySelector<HTMLElement>("[data-search-panel]");
		if (!panel) return;
		if (open) {
			panel.removeAttribute("hidden");
			panel.classList.remove("hidden");
			panel.classList.add("block");
			queueMicrotask(() => panel.querySelector<HTMLInputElement>("input[type='search']")?.focus());
		} else {
			panel.setAttribute("hidden", "");
			panel.classList.add("hidden");
			panel.classList.remove("block");
		}
	};

	const isSearchPanelOpen = () => {
		const panel = document.querySelector<HTMLElement>("[data-search-panel]");
		return Boolean(panel && !panel.hasAttribute("hidden"));
	};

	const setBurger = (open: boolean) => {
		const burger = burgerEl();
		if (!burger) return;
		if (open) {
			setSearchOpen(false);
			positionBurger();
		}
		burger.classList.toggle("hidden", !open);
		syncBurgerButtonIcons(open);
		// Страницу под открытым меню запираем на <html>, а не на <body>: пока у
		// <html> overflow «visible», замок <body> доходит до окна, но стоит теме
		// задать `html { overflow-x: clip }` (так у bloom и vanilla) — и страница под
		// панелью уезжает колесом (баг 2 документа «баги бокового меню»), а <body>
		// с overflow:hidden отрывает липкую шапку от окна. Одинаково в пяти темах.
		document.documentElement.style.overflow = open ? "hidden" : "";
	};

	// На телефоне поиск живёт в шторке бургера: лупа мобильной строки открывает
	// шторку и ставит курсор в поле, а не выдвигает десктопную панель с рядом
	// карточек. «Боковое» меню поля не несёт — тогда, как раньше, панель.
	const MOBILE_QUERY = "(max-width: 1023.98px)";
	const openDrawerSearch = (): boolean => {
		if (!window.matchMedia(MOBILE_QUERY).matches) return false;
		const burger = burgerEl();
		const input = burger?.querySelector<HTMLInputElement>("input[type='search']");
		if (!burger || !input) return false;
		if (burger.classList.contains("hidden")) setBurger(true);
		input.focus();
		return true;
	};

	const syncHeaderChromeAfterNavigation = () => {
		document.documentElement.style.overflow = "";
		document.body.style.overflow = "";
		setSearchOpen(false);
		burgerEl()?.classList.add("hidden");
		syncBurgerButtonIcons(false);
	};

	const headerWin = window as unknown as { __satinHeaderBound?: boolean };
	const bindHeaderDelegatedClicks = () => {
		if (headerWin.__satinHeaderBound) return;
		headerWin.__satinHeaderBound = true;

		document.addEventListener("click", (event: MouseEvent) => {
			const el = event.target instanceof Element ? event.target : null;
			if (!el) return;
			if (el.closest("[data-burger-toggle]")) {
				event.preventDefault();
				setBurger(burgerEl()?.classList.contains("hidden") ?? false);
				return;
			}
			if (el.closest("[data-action='toggle-search']")) {
				event.preventDefault();
				event.stopPropagation();
				if (openDrawerSearch()) return;
				setSearchOpen(!isSearchPanelOpen());
				return;
			}
			if (el.closest("#satin-burger a[href]")) {
				setBurger(false);
			}
		});

		document.addEventListener("click", (event: MouseEvent) => {
			if (!isSearchPanelOpen()) return;
			const target = event.target;
			if (!(target instanceof Node)) return;
			const panel = document.querySelector<HTMLElement>("[data-search-panel]");
			if (panel?.contains(target)) return;
			const tEl = target instanceof Element ? target : null;
			if (tEl?.closest?.("[data-action='toggle-search']")) return;
			setSearchOpen(false);
		});

		document.addEventListener("click", (event: MouseEvent) => {
			const burger = burgerEl();
			if (!burger || burger.classList.contains("hidden")) return;
			const target = event.target;
			if (!(target instanceof Node)) return;
			if (burger.contains(target)) return;
			const tEl = target instanceof Element ? target : null;
			if (tEl?.closest?.("[data-burger-toggle]")) return;
			if (tEl?.closest?.("[data-action='toggle-search']")) return;
			setBurger(false);
		});

		// Escape закрывает панель (первый Escape в непустом поле его очищает — модуль поиска).
		document.addEventListener("keydown", (event: KeyboardEvent) => {
			if (event.key !== "Escape" || !isSearchPanelOpen()) return;
			setSearchOpen(false);
			focusSearchToggle();
		});

		window.addEventListener("resize", positionBurger);
	};

	bindHeaderDelegatedClicks();
	document.addEventListener("astro:page-load", syncHeaderChromeAfterNavigation);
	syncHeaderChromeAfterNavigation();
</script>
