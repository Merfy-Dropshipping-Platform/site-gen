---
/**
 * Секция «Личный кабинет» (bloom). Вынесена из
 * `themes/bloom/src/pages/account/profile.astro` БЕЗ изменения логики — та же
 * разметка, те же id и классы, тот же порядок вызовов `fetchMe → updateProfile
 * → logout`. Теперь это Puck-секция: страницу «Личный кабинет» мерчант
 * редактирует как главную (шапка/подвал/порядок секций), а у самой секции
 * РОВНО ОДИН параметр — «Цветовая схема» (тестировщик 14.09).
 *
 * Почему у секции нет «Отступов». Их не просили, а состав панели — канон.
 * Вертикаль страницы задаёт вёрстка темы (`.account-page-container`:
 * `padding: 3.5rem 18rem 7rem`), одинаково на live и в превью.
 *
 * Секция одна на странице (maxInstances: 1) → `document.getElementById` в
 * клиенте безопасен, как в CartSection/WishlistSection. Резолвится раньше
 * theme-base-скаффолда (resolveV2Section по
 * dist/theme-sections/bloom/manifest.json).
 *
 * Единственная правка вёрстки против исходной страницы: фон секции взят из
 * токена `--color-bg` вместо прозрачного — иначе параметр «Цветовая схема»
 * красил бы текст, но не фон. Без схемы токен даёт тот же белый.
 *
 * Приглушённый текст (тестировщик, пункты 13 и 14: «не применяется цветовая
 * схема к кнопке и тексту»). Раньше он красился через
 * `rgb(var(--color-text-muted))`, а такого токена НЕТ: его не объявляют ни
 * схемы `.color-scheme-N`, ни buildTokensCss (замер live 2026-09-15 по пяти
 * стендам: 18 использований на страницу, 0 объявлений). `rgb(var(--НЕТ))` —
 * invalid at computed-value time: свойство обнуляется, цвет достаётся
 * наследованием, схема на него не влияет. Теперь берётся живой `--color-muted`
 * с тем же фолбэком, что у эталона rose (ProductCard/Footer/Newsletter).
 * Гард: src/themes/__tests__/account-muted-token.spec.ts.
 */
interface Props {
	id?: string;
	colorScheme?: number | string;
}
const { id, colorScheme } = Astro.props as Props;

// Мост к API: build.service.ts патчит `const shopId = ""` → siteId на деплое
// (тот же приём, что cart.astro и WishlistSection.astro).
const shopId = "";
const apiUrl = import.meta.env.PUBLIC_MERFY_API_URL ?? "https://gateway.merfy.ru/api";
// Цветовая схема секции (как CartSection/WishlistSection): класс ставим ВСЕГДА —
// composeV2Page оборачивает только при заданном props.colorScheme, а дефолт
// blockDefaults он не читает.
const schemeClass = `color-scheme-${String(colorScheme ?? 2).replace("scheme-", "")}`;
---

<section
	data-puck-component-id={id}
	data-block="account-section"
	data-account-page
	data-site-id={shopId}
	class:list={["w-full bg-[rgb(var(--color-bg,255_255_255))]", schemeClass]}
>
	<div class="account-page-container">
		<a href="/account" class="account-back-link">
			<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
			Вернуться назад
		</a>

		<div class="account-title">
			<h1>Основные данные</h1>
			<span class="account-subtitle" id="profile-email-display"></span>
		</div>

		<div id="profile-loading" style="color: rgb(var(--color-muted, 153 153 153)); font-family: var(--font-body);">Загрузка...</div>

		<form id="profile-form" class="account-form hidden">
			<div class="account-field">
				<label for="profile-email">E-mail</label>
				<input type="email" id="profile-email" class="auth-input" disabled />
			</div>
			<div class="account-field">
				<label for="profile-phone">Телефон</label>
				<input type="tel" id="profile-phone" class="auth-input" placeholder="+7 (000) 000-00-00" autocomplete="tel" />
			</div>
			<div class="account-field">
				<label>Пароль</label>
				<div class="auth-input" style="display: flex; align-items: center; justify-content: space-between; cursor: default;">
					<span style="letter-spacing: 0.2em; color: rgb(var(--color-muted, 153 153 153));">••••••••••••</span>
				</div>
				<a href="/reset-password" class="account-text-link" style="font-size: 0.875rem;">Изменить</a>
			</div>
		</form>

		<div id="profile-status" class="hidden" style="font-family: var(--font-body); font-size: 0.875rem;"></div>

		<div class="account-actions" id="profile-actions" style="display: none;">
			<button type="submit" form="profile-form" class="account-button" id="btn-save">
				<span class="save-text">Сохранить</span>
				<span class="save-loading hidden">Сохранение...</span>
			</button>
			<button type="button" class="account-text-link" id="btn-logout-profile">Выйти из аккаунта</button>
		</div>
	</div>
</section>

{/* Конфиг для auth-слоя темы (shopId патчится build.service на деплое). */}
<script is:inline define:vars={{ shopId, apiUrl }}>
	window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || {
		shopId: shopId || "",
		apiUrl: apiUrl || "https://gateway.merfy.ru/api",
	};
</script>

<script is:inline>
	/**
	 * Клиент секции «Личный кабинет» (bloom). is:inline (НЕ module): на live
	 * theme dist module-script секции не компилится → 404 (та же причина, что у
	 * WishlistSection). Тело — дословный перенос initProfile() со страницы
	 * account/profile.astro; импорты заменены на глобал auth-слоя темы.
	 */
	(function () {
	/**
	 * Мост к auth-слою темы. Оригинальная страница импортировала
	 * `../../lib/auth` module-скриптом; у СЕКЦИИ такой возможности нет — на live
	 * theme dist module-script секции не компилится (404), поэтому скрипт
	 * `is:inline`, а функции берутся из глобала `window.__bloomAuth`, который
	 * ставит `initAuthUI()` из Layout на каждой странице. Набор вызовов и их
	 * порядок — те же, что были на странице: логика не менялась.
	 */
	function whenAuth(cb) {
		var tries = 0;
		(function poll() {
			var a = window.__bloomAuth;
			if (a) return cb(a);
			if (tries++ > 200) return; // ~10с: auth-бандл темы так и не приехал
			setTimeout(poll, 50);
		})();
	}
	/** navTo из lib/auth — скопирован дословно (превью конструктора = iframe). */
	function navTo(path) {
		if (typeof window === "undefined") return;
		if (window.self !== window.top) {
			try {
				var u = new URL(window.location.href);
				u.searchParams.set("page", path.split("?")[0].split("#")[0]);
				window.location.href = u.toString();
				return;
			} catch (e) {
				/* fallthrough */
			}
		}
		window.location.href = path;
	}

		/**
		 * Заполнить форму данными покупателя. ОДНА функция на оба контекста:
		 * витрина зовёт её ответом `fetchMe`, превью конструктора — демо-
		 * покупателем. Раскладка у мерчанта и у вошедшего покупателя поэтому
		 * совпадает по построению, а не «пока никто не разошёлся».
		 */
		function paintProfile(formEl, c) {
			document.getElementById("profile-loading").classList.add("hidden");
			formEl.classList.remove("hidden");
			document.getElementById("profile-actions").style.display = "";
			document.getElementById("profile-email-display").textContent = c.email || "";
			document.getElementById("profile-email").value = c.email || "";
			document.getElementById("profile-phone").value = c.phone || "";
		}

		function initProfile() {
			var formEl = document.getElementById("profile-form");
			if (!formEl || formEl.dataset.bound === "true") return;
			formEl.dataset.bound = "true";

			// Превью конструктора. Покупательской сессии в iframe мерчанта нет и
			// быть не может, а гость-гейт ниже уводил превью на страницу «Вход»:
			// navTo внутри iframe не идёт на витрину, он переписывает `?page=` у
			// САМОГО превью. Мерчант вместо «Личного кабинета» видел форму входа и
			// не мог настроить секцию (баг владельца 14.09). Глобал ставит ТОЛЬКО
			// превью (injectPreviewAccountGlobal из injectPreviewGlobals) — на витрине
			// его нет,
			// и гейт работает как работал. Разбор безопасности —
			// backend/services/sites/src/common/preview-account-inline.ts.
			var preview = window.__MERFY_PREVIEW_ACCOUNT__;
			if (preview && preview.customer) {
				paintProfile(formEl, preview.customer);
				return;
			}

			whenAuth(async function (A) {
				if (!A.getToken()) {
					navTo("/login?redirect=/account/profile");
					return;
				}

				var statusEl = document.getElementById("profile-status");
				var btn = document.getElementById("btn-save");
				var logoutBtn = document.getElementById("btn-logout-profile");

				var c = await A.fetchMe();
				if (!c) {
					navTo("/login?redirect=/account/profile");
					return;
				}

				paintProfile(formEl, c);

				formEl.addEventListener("submit", async function (e) {
					e.preventDefault();
					statusEl.classList.add("hidden");
					btn.querySelector(".save-text").classList.add("hidden");
					btn.querySelector(".save-loading").classList.remove("hidden");
					btn.disabled = true;
					try {
						var result = await A.updateProfile({
							phone: document.getElementById("profile-phone").value.trim(),
						});
						if (result.success) {
							statusEl.textContent = "Сохранено!";
							statusEl.style.color = "green";
							statusEl.classList.remove("hidden");
							setTimeout(function () { statusEl.classList.add("hidden"); }, 3000);
						} else { throw result; }
					} catch (err) {
						statusEl.textContent = (err && err.message) || "Не удалось сохранить";
						statusEl.style.color = "rgb(var(--color-error))";
						statusEl.classList.remove("hidden");
					} finally {
						btn.querySelector(".save-text").classList.remove("hidden");
						btn.querySelector(".save-loading").classList.add("hidden");
						btn.disabled = false;
					}
				});

				if (logoutBtn) {
					logoutBtn.addEventListener("click", async function () {
						await A.logout();
						navTo("/login");
					});
				}
			});
		}

		initProfile();
		document.addEventListener("astro:page-load", initProfile);
	})();
</script>
