---
import FluxPicture from "../img/FluxPicture.astro";
import { SITE_TITLE } from "../../consts";

// ОЖИВЛЕНИЕ (Фаза B, контракт bloom Hero): читаем канон-схему theme-base
// Hero.puckConfig и раскладываем по разметке верстальщика. Тело ниже — verbatim;
// значения flux = дефолты (index.astro зовёт <Hero title=... /> легаси-пропсами —
// они поддержаны наравне с nested). Полотно — ФИКС-высота h-[280px] sm:h-[360px]
// lg:h-[480px] (эталон Hero.astro:28). Поиск в Hero УБРАН (2026-06-15, баг тестера
// «два поиска на главной» — поиск только в Header, как rose). Анимаций нет (манера flux статична, §6).
const p = Astro.props as Record<string, any>;
const id = p.id;
const nonEmpty = (v: unknown): string | undefined =>
	typeof v === "string" && v.trim() ? v : undefined;
// heading/text принимают И канон-объект ({text}/{content}), И плоскую строку
// (паритет с Collections/Gallery/Popular/Puk/MainText/Newsletter в этой же теме —
// везде `typeof p.heading === "string" ? p.heading : p.heading?.text`). Раньше
// Hero проверял ТОЛЬКО p.heading?.text — плоская строка тихо терялась (rawHeadingText
// ниже её тоже не видел → секция с реальным заголовком мерчанта ошибочно считалась
// isEmpty и рисовала плейсхолдер «Изображение» вместо заданного текста).
// Дефолтное состояние Hero = контент вёрстки дословно (flux-theme Hero.astro:14-18).
// Фолбэк идёт через nonEmpty, а не через `??`: сид и миграции ревизий кладут в эти
// поля ПУСТЫЕ СТРОКИ, а `??` пропускает только null/undefined — из-за этого секция
// рендерилась с пустыми <h1>/<p>/<a> вместо дефолтного текста оригинала.
const REF_TITLE = "Технологии без паузы";
const REF_SUBTITLE = "Будущее — в режиме онлайн.\nВаш новый гаджет — уже в наличии.";
const REF_CTA_TEXT = "Новинки 2026";
const REF_CTA_LINK = "/catalog";
// Вёрстка разбивает подзаголовок по \n на строки через <br> (Hero.astro:20,55).

const title =
	nonEmpty(typeof p.heading === "string" ? p.heading : p.heading?.text) ??
	nonEmpty(p.title) ??
	REF_TITLE;
const subtitle =
	nonEmpty(typeof p.text === "string" ? p.text : p.text?.content) ??
	nonEmpty(p.subtitle) ??
	REF_SUBTITLE;
const ctaText =
	nonEmpty(p.primaryButton?.text) ??
	nonEmpty(p.cta?.text) ??
	nonEmpty(p.ctaText) ??
	REF_CTA_TEXT;
const ctaLink =
	nonEmpty(p.primaryButton?.link?.href) ??
	nonEmpty(typeof p.primaryButton?.link === "string" ? p.primaryButton.link : undefined) ??
	nonEmpty(p.cta?.href) ??
	nonEmpty(p.ctaLink) ??
	REF_CTA_LINK;
// Канон backgroundImages (imagePair) / legacy backgroundImage / image.url. Картинка
// НЕ выбрана → "" (одиночная ветка рендера ниже не рисует фон); ПОЛНОСТЬЮ пустое
// состояние секции (isEmpty) рендерит отдельную ветку с дизайн-ассетом
// /placeholders/landscape-image.png (см. ниже), НЕ мок /images/4x/Главный_экран.png.
const backgroundImageRaw =
	nonEmpty(p.backgroundImages?.url1) ??
	nonEmpty(p.backgroundImage) ??
	nonEmpty(p.image?.url) ??
	"";
// Сплит двух картинок 50/50 ТОЛЬКО когда второе фото задано; иначе одиночный рендер дословно.

// Сплит 50/50 — ТОЛЬКО когда мерчант заполнил ОБА слота. Если задан лишь один
// (в том числе второй), он показывается на всю ширину: раньше заполнение второго
// слота включало сетку из двух колонок, и первая половина оставалась пустой.
const _bg2Raw = nonEmpty(p.backgroundImages?.url2) ?? nonEmpty(p.backgroundImage2);
const _bg1Filled = Boolean(String(backgroundImageRaw ?? "").trim());
const _bg2Filled = Boolean(String(_bg2Raw ?? "").trim());
const backgroundImage = _bg1Filled ? backgroundImageRaw : _bg2Filled ? _bg2Raw : backgroundImageRaw;
const backgroundImage2 = _bg1Filled && _bg2Filled ? _bg2Raw : undefined;


// Figma 1:19335 — ДОСЛОВНЫЙ плейсхолдер ПУСТОГО состояния секции «Изображение»
// (Hero/Image). «Пусто» = мерчант НЕ задал НИ фон-картинку, НИ заголовок, НИ текст,
// НИ кнопку (все значения берутся из flux-дефолтов: SITE_TITLE / «Там, где классика…»
// / «В каталог»). Тогда секция рендерит фон /placeholders/landscape-image.png +
// overlay-лейбл «Изображение» + хелпер «Покажи и расскажи о своем товаре в одном
// блоке» + кнопку «Кнопка» (ветка рендера ниже), а НЕ дефолт-контент верстальщика.
// Проверяем СЫРЫЕ пропсы (heading.text/title, text.content/subtitle, primaryButton.
// text/cta), а не resolved-значения с фолбэками — иначе пустое состояние не отличить
// от заданного. Hero/Image не имеет коллекционных данных → SSR-фетч сюда не относится
// (он для Popular/Collections/Gallery). Когда хоть что-то задано — рендер мерчанта
// дословно (нижняя ветка не трогается). Паттерн эталона rose Hero.astro.
const rawHeadingText =
	typeof p.heading === "string"
		? p.heading
		: typeof p.heading?.text === "string"
			? p.heading.text
			: typeof p.title === "string"
				? p.title
				: "";
const rawSubtitleText =
	typeof p.text === "string"
		? p.text
		: typeof p.text?.content === "string"
			? p.text.content
			: typeof p.subtitle === "string"
				? p.subtitle
				: "";
const rawPrimaryText =
	typeof p.primaryButton?.text === "string"
		? p.primaryButton.text
		: typeof p.cta?.text === "string"
			? p.cta.text
			: typeof p.ctaText === "string"
				? p.ctaText
				: "";
const isEmpty =
	!String(backgroundImage).trim() &&
	!String(backgroundImage2 ?? "").trim() &&
	!rawHeadingText.trim() &&
	!rawSubtitleText.trim() &&
	!rawPrimaryText.trim();
// Дословные тексты Figma-плейсхолдера (тип «Изображение»).
const PH_LABEL = "Изображение";
const PH_HELPER = "Покажи и расскажи о своем товаре в одном блоке";
const PH_BUTTON = "Кнопка";

// ДВА НЕЗАВИСИМЫХ размера у Hero:
//   • p.size — ВЫСОТА полотна (heroHeightCls ниже). НЕ шрифт.
//   • heading.size / text.size — размер ШРИФТА заголовка/текста (поля «Размер
//     заголовка»/«Размер текста»). font-size берётся ТОЛЬКО из heading.size/
//     text.size, БЕЗ фолбэка на p.size (иначе регулятор высоты снова менял бы
//     кегль). Отсутствие → дефолт-ветка large = ЭТАЛОН верстальщика (Hero.astro:43,47):
//     заголовок Roboto Flex uppercase 20/24; текст Roboto Flex 300 14/16; цвета →
//     токены §7 (белый фолбэк = эталонный text-white).
//   заголовок large 20/24 → medium 17/20 → small 14/17 (Roboto Flex uppercase)
//   текст     large 14/16 → medium 12/14 → small 11/12 (Roboto Flex 300)
// Фолбэки цвета = ЛИТЕРАЛЫ вёрстки (#000000 заголовок, #999999 подзаголовок).
// Заданная мерчантом цветосхема по-прежнему перебивает их через токен; но пока
// схема не выбрана, Hero обязан выглядеть ровно как у верстальщиков. Раньше
// фолбэк был белым — на светлом фото текст пропадал.
const headingSize = p.heading?.size;
// lg:text-[length:var(--merchant-hero-heading,…)] — «Кегль заголовка Hero» темы.
// --merchant-hero-heading эмитится ТОЛЬКО когда мерчант двинул слайдер (гейт в
// tokens-css.ts) — иначе живёт леддер вёрстки S/M/L (фоллбэк = md-кегль ветки).
// НЕ --size-hero-heading: та эмитится всегда (theme.json 72px ≠ вёрстка 24px)
// и флаттенила бы леддер у нетронутой темы.
const headingCls =
	headingSize === "small"
		? "font-roboto-flex text-[14px] font-normal uppercase leading-normal text-[rgb(var(--color-heading,0_0_0))] md:text-[17px] lg:text-[length:var(--merchant-hero-heading,17px)]"
		: headingSize === "medium"
			? "font-roboto-flex text-[17px] font-normal uppercase leading-normal text-[rgb(var(--color-heading,0_0_0))] md:text-[20px] lg:text-[length:var(--merchant-hero-heading,20px)]"
			: "font-roboto-flex text-[20px] font-normal uppercase leading-normal text-[rgb(var(--color-heading,0_0_0))] md:text-[24px] lg:text-[length:var(--merchant-hero-heading,24px)]";
// Подзаголовок вёрстки (Hero.astro:52): 12→14px, uppercase, #999999.
// Были 14→16px без uppercase — на ступень крупнее и другим регистром.
const textSize = p.text?.size;
const subtitleCls =
	textSize === "small"
		? "font-roboto-flex text-[10px] font-light uppercase leading-normal text-[rgb(var(--color-text,153_153_153))] md:text-[11px]"
		: textSize === "medium"
			? "font-roboto-flex text-[11px] font-light uppercase leading-normal text-[rgb(var(--color-text,153_153_153))] md:text-[12px]"
			: "font-roboto-flex text-[12px] font-light uppercase leading-normal text-[rgb(var(--color-text,153_153_153))] md:text-[14px]";
// «Размер» → высота полотна. large (дефолт) = вёрстка дословно
// (flux-theme Hero.astro:26 `h-[380px] w-full sm:h-[480px] lg:aspect-[1920/810] lg:h-auto`):
// на десктопе высота задаётся ПРОПОРЦИЕЙ кадра, а не фиксированным числом —
// отсюда замеренные 540px на 1280 и 810px на 1920.
// Прежние значения 280/360/480 были опечаткой переноса (380 записали как 280).
// medium ≈0.82×, small ≈0.64× от large; у них десктоп остаётся фиксированным,
// т.к. пропорция кадра — инвариант дизайна, а не регулируемая величина.
const heroSize = p.size === "small" ? "small" : p.size === "medium" ? "medium" : "large";
const heroHeightCls = {
	large: "h-[380px] sm:h-[480px] lg:aspect-[1920/810] lg:h-auto",
	medium: "h-[310px] sm:h-[395px] lg:h-[445px]",
	small: "h-[245px] sm:h-[305px] lg:h-[345px]",
}[heroSize];
// Мобила = стек (картинка сверху + подложка снизу, паритет rose «Shopify Image
// banner»), десктоп (md+) = прежний оверлей. heroHeightCls (полная лестница
// base/sm/lg) остаётся ТОЛЬКО для isEmpty-плейсхолдера (тот не переходит в стек).
// Для контентной ветки — md-only лестница: высота полотна нужна ТОЛЬКО когда
// картинка становится absolute-оверлеем; на мобиле высота = поток (aspect-[4/3]
// картинки + блок-подложка контента). Старые sm:-значения переезжают на md:.
// Мобильные высоты — КАНОН верстальщиков: полотно 380px с контентом-оверлеем
// (мобстек «медиа сверху, контент ниже» был перенесён из rose и канону
// противоречил — юзер-репорт 2026-08-08, скрин эталона localhost:4321@390).
const heroHeightMdCls = {
	large: "h-[380px] md:h-[480px] lg:aspect-[1920/810] lg:h-auto",
	medium: "h-[315px] md:h-[395px] lg:h-[445px]",
	small: "h-[245px] md:h-[305px] lg:h-[345px]",
}[heroSize];
// B2 (владелец, 2026-08-02): «Размер» менял только высоту полотна — кроп фото
// «плющился»/съезжал. Причина: одиночная ветка ниже кадрирует ЛИТЕРАЛЬНЫМИ
// процентами (top-[-10.8%], w-[200%]/w-[160%]) — это ДОСЛОВНЫЙ Figma-крой
// вёрстки (flux-theme Hero.astro:29,35, node 2060:9675) под ЕДИНСТВЕННУЮ
// высоту вёрстки, которая = ровно heroHeightCls.large. У верстальщиков контрола
// «Размер» вообще нет — medium/small изобретены конструктором. top-% у
// absolute-элемента резолвится от высоты контейнера, а w-% — от ширины
// (ширина от heroSize не зависит) → при medium/small кадр реально смещается
// не пропорционально высоте. Для large крой НЕ трогаем (пиксель-в-пиксель
// эталон); medium/small — паттерн Rose (inset-0 size-full object-cover): сам
// пересчитывается под любую высоту контейнера, без ручной калибровки под каждую.
// #7 (июльский аудит паритета, мобстек): на мобиле картинка теперь ЖИВЁТ ВНУТРИ
// aspect-[4/3]-коробки в потоке (см. imageWrapCls ниже) — калиброванный крой
// «large» (top-[-10.8%]/w-[200%]/…) считался под ЦЕЛИКОМ ДРУГОЙ, широкую
// desktop-пропорцию (1920×810) — внутри 4:3 он даёт мимо. На мобиле просто
// object-cover (сам вписывается в коробку); калиброванный крой включается
// ТОЛЬКО с md: (там картинка снова становится absolute-оверлеем на всю секцию,
// прежняя вёрстка не трогается). Старое sm:w-[160%] переехало на md: (это и
// была первая ступень calibrated-crop, теперь она начинается сразу с md:).
const singleImageCropCls =
	heroSize === "large"
		? "size-full object-cover object-center md:absolute md:left-1/2 md:top-[-10.8%] md:h-auto md:w-[160%] md:max-w-none md:-translate-x-1/2 md:object-cover lg:left-0 lg:w-full lg:translate-x-0"
		: "size-full object-cover object-center md:absolute md:inset-0";

// Вторая кнопка — ТОЛЬКО если мерчант задал (паритет с rose, FR-010): не
// подставляем дефолт «О нас», когда secondaryButton/aboutText не заданы.
// Пустой текст заданного пропа также скрывает. Legacy flat aboutText/aboutLink поддержаны.
const secondaryGiven = p.secondaryButton !== undefined && p.secondaryButton !== null;
const secondaryText = secondaryGiven
	? nonEmpty(p.secondaryButton?.text)
	: nonEmpty(p.aboutText);
const secondaryLink =
	p.secondaryButton?.link?.href ??
	(typeof p.secondaryButton?.link === "string" ? p.secondaryButton.link : undefined) ??
	nonEmpty(p.aboutLink) ??
	"#about";

// Канон overlay 0-100 (число или строка) → чёрный слой между фото (z-0) и контентом (z-10).
const overlayN = Math.max(0, Math.min(100, Number(p.overlay) || 0));

// Канон container (toggle «Контейнер» панели «Изображение») — подложка-плашка
// ТОЛЬКО под текстовым блоком, НЕ затемнение всего экрана (overlay отдельно).
// На светлой плашке белый текст flux не читается → переключаем на тёмный схемы.
const boxed = String(p.container ?? "false") === "true";
const boxedCls = boxed
	? " rounded-[var(--radius-card,8px)] bg-[rgb(var(--color-bg,255_255_255))]/95 p-6 shadow-sm md:p-8 [&_h1]:!text-[rgb(var(--color-heading,0_0_0))] [&_p]:!text-[rgb(var(--color-text,0_0_0))]"
	: "";
// Мобила-обёртка контента ПОД медиа (стек, паритет rose). «Контейнер» ON →
// карточка (boxedCls) сама = плашка, обёртка ПРОЗРАЧНАЯ (только гаттер+зазор) —
// иначе «контейнер в контейнере». «Контейнер» OFF → обёртка = сама подложка
// (фон схемы + паддинги). Десктоп (md+) — всегда absolute-оверлей, прозрачно.
// (мобильная подложка-обёртка удалена вместе с мобстеком — контент снова
// absolute-оверлей на всех вьюпортах; boxed-плашку несёт contentCls/boxedCls)

// Канон position (видимое поле панели) / contentPosition (legacy, те же 9 значений).
// Позиция управляет РАЗМЕЩЕНИЕМ контент-блока по сетке 3×3 (как rose Hero):
//   вертикаль — top / center(=середина) / bottom; горизонталь — left / center / right.
// Выравнивание (alignment) теперь НЕЗАВИСИМО и отвечает только за выравнивание
// КОНТЕНТА внутри блока (заголовок/текст/кнопки), НЕ двигает сам блок.
// Раньше alignment (дефолт center) перебивал горизонталь позиции, а 'center'
// ошибочно не давал середину — это и был баг (см. rose Hero фикс).
//
// СОХРАНЕНИЕ ДЕФОЛТА ВЕРСТАЛЬЩИКА flux: дефолт = position:"left" (defaults/flux.json)
// и пустой проп (легаси-вызов index.astro <Hero title=.../>): оба = контент СЛЕВА
// ПО ЦЕНТРУ ВЕРТИКАЛИ (эталон Hero.astro:38 items-center). 'left' — горизонталь-
// только (нет верт-префикса) → hPos="left", vPos="". Пустой vPos у flux = ВЕРТ-ЦЕНТР
// (justify-center), как у верстальщика; пустой posRaw тоже трактуем как left-center
// (родная раскладка flux). Хром/поиск — в Header (манера flux сохраняется).
const posRaw =
	typeof p.position === "string" && p.position
		? p.position
		: typeof p.contentPosition === "string"
			? p.contentPosition
			: "";
const vPos = posRaw.startsWith("top")
	? "top"
	: posRaw.startsWith("bottom")
		? "bottom"
		: posRaw === "center" || posRaw.startsWith("center")
			? "middle"
			: ""; // пусто = верт-центр (эталон flux, см. vJustifyCls)
const hPos = posRaw.endsWith("left")
	? "left"
	: posRaw.endsWith("right")
		? "right"
		: posRaw === "" // пусто = left (родной дефолт flux, не center как у rose)
			? "left"
			: "center";
// flux ЭТАЛОН (Hero.astro:38 `flex h-full items-center`): дефолт = ВЕРТИКАЛЬНЫЙ
// ЦЕНТР. Пустой vPos (родная раскладка, position:"left") → justify-center, как у
// верстальщика. Явные top/middle/bottom продолжают работать (грид-варианты целы).
const vJustifyCls = vPos === "top" ? "justify-start" : vPos === "middle" ? "justify-center" : vPos === "bottom" ? "justify-end" : "justify-center";
const hItemsCls = hPos === "left" ? "items-start" : hPos === "right" ? "items-end" : "items-center"; // ПОЗИЦИЯ
// alignment — выравнивание КОНТЕНТА внутри блока (НЕ двигает сам блок — это делает
// Позиция через items на внешнем контейнере). items-* выравнивают заголовок/текст/
// кнопки друг относительно друга, text-align — многострочный текст.
// ВАЖНО flux: дефолт выравнивания (нет пропа alignment) = ВЛЕВО (родная раскладка
// верстальщика — контент у левого края блока), НЕ по центру как у rose. Явные
// alignment center/right двигают контент независимо от позиции.
const align = p.alignment === "center" || p.alignment === "right" ? p.alignment : "left";
const alignItemsCls = align === "right" ? "items-end" : align === "center" ? "items-center" : "items-start"; // ВЫРАВНИВАНИЕ
const textAlignCls = align === "right" ? "text-right" : align === "center" ? "text-center" : "text-left";
const buttonsJustifyCls = align === "right" ? "justify-end" : align === "center" ? "justify-center" : "justify-start";
// Паритет rose (equal-width buttons): при заданной secondaryButton — обе
// кнопки РАВНОЙ ширины «по большей» через inline-grid из двух bare `1fr`
// колонок (НЕ Tailwind grid-cols-2 = minmax(0,1fr) — та сожмёт по контенту).
// Кнопки — grid-items с дефолтным justify-self:stretch + w-auto (см. правку
// ctaBtnCls/secondaryBtnCls выше, было w-fit — оно перебивало бы stretch) →
// узкая кнопка подтягивается до ширины широкой. Без второй кнопки — прежняя
// строка дословно (flex-wrap, только один айтем).
const buttonsCls = secondaryText
	? `inline-grid [grid-template-columns:1fr_1fr] items-stretch gap-3`
	: `flex flex-wrap gap-3 ${buttonsJustifyCls}`;
// gap-8 — вёрстка (Hero.astro:46 `gap-8 … lg:gap-10`). Было gap-6: на мобиле и
// планшете контент стоял плотнее эталона.
const contentCls = `flex max-w-[520px] flex-col gap-8 lg:gap-10 ${alignItemsCls}${boxedCls}`;

// Кнопка вёрстки (Hero.astro:64): h-12 (48px), rounded-[4px], bg-[#1e2952],
// белый текст, font-light, uppercase, px-4, text-[16px], leading-none.
// Высота и радиус берутся ТОКЕНАМИ темы — `--size-hero-button-h` уже объявлен в
// theme.json со значением 48px, но раньше не потреблялся (стоял хардкод h-14=56px),
// т.е. у свойства было два владельца и живым был неверный.
// Цвет — токен цветосхемы с фолбэком на литерал вёрстки: пока схема не выбрана,
// кнопка тёмно-синяя как в оригинале.
const ctaBtnCls =
	p.buttonStyle === "outlined"
		? "inline-flex h-[var(--size-hero-button-h,48px)] w-auto items-center justify-center rounded-[var(--radius-button,4px)] border border-[rgb(var(--color-button-bg,30_41_82))] px-4 font-roboto-flex text-[16px] font-light uppercase leading-none text-[rgb(var(--color-button-bg,30_41_82))] transition-colors hover:bg-black/5"
		: "inline-flex h-[var(--size-hero-button-h,48px)] w-auto items-center justify-center rounded-[var(--radius-button,4px)] border border-solid border-[rgb(var(--color-button-border,var(--color-button-bg,30_41_82)))] bg-[rgb(var(--color-button-bg,30_41_82))] px-4 font-roboto-flex text-[16px] font-light uppercase leading-none text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-90";
// Вторая кнопка — согласованная ПАРА с «Стилем кнопки» (паритет rose): solid
// (дефолт) → primary залитая / secondary контурная; outlined → НАОБОРОТ
// (primary контурная / secondary залитая). Раньше secondaryBtnCls был
// фиксированной строкой (всегда контур) — «Стиль кнопки»=outlined на вторую
// кнопку не действовал. Рендерится ТОЛЬКО когда мерчант задал secondaryButton
// (условие ниже).
const secondaryBtnCls =
	p.buttonStyle === "outlined"
		? "inline-flex h-[var(--size-hero-button-h,48px)] w-auto items-center justify-center rounded-[var(--radius-button,4px)] border border-solid border-[rgb(var(--color-button-border,var(--color-button-bg,30_41_82)))] bg-[rgb(var(--color-button-bg,30_41_82))] px-4 font-roboto-flex text-[16px] font-light uppercase leading-none text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-90"
		: "inline-flex h-[var(--size-hero-button-h,48px)] w-auto items-center justify-center rounded-[var(--radius-button,4px)] border border-[rgb(var(--color-button-bg,30_41_82))] px-4 font-roboto-flex text-[16px] font-light uppercase leading-none text-[rgb(var(--color-button-bg,30_41_82))] transition-colors hover:bg-black/5";

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе (паттерн rose
// T14 / bloom Hero). Высота полотна теперь = фикс-классы heroHeightCls на div-полотне
// (эталон), поэтому в rootStyle остаётся ТОЛЬКО padding (section берёт высоту от
// потока полотна); padding не задан → undefined (Astro не печатает style-атрибут).
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;
const rootStyle = paddingStyle;
// Отступы секции («Изображение») и дефолтный gutter Позиции живут на
// КОНТЕНТ-оверлее, не на <section>. Оверлей — `absolute inset-0`, поэтому
// padding на секции не отодвигает кнопку от кромки (containing block =
// padding-box, inset-0 кроет и зону padding). Паритет rose Hero:290
// (pb-10…xl:pb-20). Явный p.padding (дефолт 80/80) — как задал мерчант.
const overlayPadStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;
const overlayPadCls = p.padding ? "" : "py-10 md:py-14 lg:py-16 xl:py-20";

// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((p as any).hiddenFields)
	? ((p as any).hiddenFields as unknown[]).filter((x): x is string => typeof x === 'string')
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);
---

{
	isEmpty ? (
		/* Пустое состояние (Figma 1:19335, тип «Изображение», контракт картиночных
		   секций): фон секции = дизайн-ассет /placeholders/landscape-image.png
		   (картинка показывается ВСЕГДА, НЕ пустой surface и НЕ мок верстальщика) +
		   лёгкий тёмный overlay для читаемости + overlay-лейбл «Изображение» +
		   хелпер-текст + кнопка «Кнопка». Без дефолт-контента верстальщика (SITE_TITLE
		   / «Там, где классика…» / «В каталог» / «О нас»). Манера flux: Roboto Flex
		   uppercase-заголовок и Roboto Flex-хелпер белым на фото (как обычный Hero на
		   картинке), высота полотна = heroHeightCls. Сырой <img> (нет .webp). */
		<section
			class="relative w-full overflow-hidden bg-[rgb(var(--color-surface,245_245_245))]"
			style={rootStyle}
			aria-labelledby="hero-title"
			data-puck-component-id={id}
		>
			<img
				src="/placeholders/landscape-image.png"
				alt=""
				aria-hidden="true"
				loading="eager"
				class="absolute inset-0 z-0 size-full object-cover object-center"
			/>
			<div class="pointer-events-none absolute inset-0 z-[1] bg-black/30" aria-hidden="true" />
			<div class={`relative w-full ${heroHeightCls}`}>
				<div class="absolute inset-0 z-10 flex w-full flex-col items-center justify-center gap-6 px-4 py-8 text-center md:gap-10 md:px-20 md:py-10 2xl:px-80">
					<div class="flex max-w-[432px] flex-col items-center gap-2 text-center">
						{!isFieldHidden('heading') && (
							<h1
								id="hero-title"
								class="font-roboto-flex text-[20px] font-normal uppercase leading-normal text-[rgb(var(--color-heading,255_255_255))] md:text-[24px]"
								data-puck-subsection-parent={id}
								data-puck-subsection-index="100"
								data-puck-subsection-field="heading"
							>
								{PH_LABEL}
							</h1>
						)}
						{!isFieldHidden('text') && (
							<p
								class="font-roboto-flex text-[14px] font-light leading-normal text-[rgb(var(--color-text,255_255_255))] md:text-[16px]"
								data-puck-subsection-parent={id}
								data-puck-subsection-index="101"
								data-puck-subsection-field="text"
							>
								{PH_HELPER}
							</p>
						)}
					</div>
					{!isFieldHidden('buttons') && (
					<div class="flex flex-wrap justify-center gap-3">
						<a
							href={ctaLink}
							class="inline-flex h-14 w-fit items-center justify-center rounded-[var(--radius-button,6px)] bg-black px-4 font-roboto-flex text-[16px] font-normal uppercase leading-none text-white transition-opacity hover:opacity-90"
							data-puck-subsection-parent={id}
							data-puck-subsection-index="102"
							data-puck-subsection-field="primaryButton"
						>
							{PH_BUTTON}
						</a>
					</div>
					)}
				</div>
			</div>
		</section>
	) : (
<section
	class={`relative w-full overflow-hidden bg-[rgb(var(--color-bg,245_245_245))] ${heroHeightMdCls}`}
	aria-labelledby="hero-title"
	data-puck-component-id={id}
>
	{/* Канон верстальщиков: медиа = absolute-оверлей полотна на ВСЕХ вьюпортах
	    (мобстек rose-манеры отменён — юзер-репорт 2026-08-08). Пара фото —
	    Merfy-добавление: на десктопе две колонки, на мобиле только первое
	    (два по 195px в ряд — нечитаемо, у верстальщиков пары нет). */}
	<div class="absolute inset-0 z-0">
		{
			backgroundImage2 ? (
				<div class="absolute inset-0 z-0 grid grid-cols-1 overflow-hidden md:grid-cols-2">
					<FluxPicture
						src={backgroundImage}
						alt={title}
						loading="eager"
						fetchpriority="high"
						class="size-full object-cover object-center"
					/>
					<FluxPicture
						src={backgroundImage2}
						alt=""
						loading="eager"
						fetchpriority="high"
						class="hidden size-full object-cover object-center md:block"
					/>
				</div>
			) : backgroundImage ? (
				<FluxPicture
					src={backgroundImage}
					alt={title}
					loading="eager"
					fetchpriority="high"
					class={singleImageCropCls}
				/>
			) : null
		}
	</div>

	{/* Растворение фото в белый к нижней кромке (вёрстка Hero.astro:39) —
	    дизайн-инвариант оверлея, действует на всех вьюпортах (канон). */}
	{
		backgroundImage && !backgroundImage2 && (
			<div
				class="pointer-events-none absolute inset-0 z-[1] bg-gradient-to-b from-transparent from-[85%] to-white"
				aria-hidden="true"
			/>
		)
	}

	{
		overlayN > 0 && (
			<div
				class="pointer-events-none absolute inset-0 z-[2] bg-black"
				style={`opacity:${overlayN / 100}`}
			/>
		)
	}

	{/* Контент — absolute-оверлей поверх фото на всех вьюпортах (канон). */}
	<div
		class={`absolute inset-0 z-10 flex w-full flex-col px-4 ${overlayPadCls} ${hItemsCls} ${vJustifyCls}`}
		style={overlayPadStyle}
	>
		<div class={contentCls} data-reveal>
			<div class={`flex flex-col gap-2 ${alignItemsCls} ${textAlignCls}`}>
				{!isFieldHidden('heading') && (
					<h1
						id="hero-title"
						class={headingCls}
						data-puck-subsection-parent={id}
						data-puck-subsection-index="100"
						data-puck-subsection-field="heading"
					>
						{title}
					</h1>
				)}
				{!isFieldHidden('text') && (
					<p
						class={subtitleCls}
						data-puck-subsection-parent={id}
						data-puck-subsection-index="101"
						data-puck-subsection-field="text"
					>
						{String(subtitle)
							.split("\n")
							.map((line, i) => (
								<>
									{i > 0 && <br />}
									{line}
								</>
							))}
					</p>
				)}
			</div>

			{!isFieldHidden('buttons') && (
			<div class={buttonsCls}>
				<a
					href={ctaLink}
					class={ctaBtnCls}
					data-puck-subsection-parent={id}
					data-puck-subsection-index="102"
					data-puck-subsection-field="primaryButton"
				>
					{ctaText}
				</a>
				{
					secondaryText && (
						<a
							href={secondaryLink}
							class={secondaryBtnCls}
							data-puck-subsection-parent={id}
							data-puck-subsection-index="103"
							data-puck-subsection-field="secondaryButton"
						>
							{secondaryText}
						</a>
					)
				}
			</div>
			)}
		</div>
	</div>
</section>
	)
}
