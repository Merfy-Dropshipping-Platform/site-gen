---
import type { CartSectionProps } from './CartSection.puckConfig';
import { CartSectionClasses as C } from './CartSection.classes';

interface Props extends CartSectionProps {
  id?: string;
}

const {
  id,
  padding,
  colorScheme,
} = Astro.props as Props;

const paddingStyle = padding
  ? `padding-top:${padding.top}px; padding-bottom:${padding.bottom}px;`
  : '';
// NOTE: Real cart items are hydrated in Phase 1c via React island
// (reads from localStorage cart-store + orders API for server totals).

// Цветовая схема секции (зеркало CartBody.astro / CartSummary.astro): поле
// «Цветовая схема» есть в puckConfig, но раньше не доходило до рендера — панель
// его показывала, а вид не менялся («не применяется цветовая схема», баг
// владельца по темам bloom/satin). Тот же способ вычисления класса, что и у
// соседних блоков корзины.
const schemeClass =
  typeof colorScheme === 'string' && colorScheme
    ? `color-scheme-${colorScheme.replace('scheme-', '')}`
    : '';
---
<section
  id="cart-section"
  class:list={[C.root, schemeClass]}
  data-puck-component-id={id}
  data-block="cart-section"
  style={paddingStyle}
>
  <div class={C.container}>
    <h1 class={C.heading}>Корзина</h1>
    <div class={C.empty} data-cart-loading>
      <p>Загрузка корзины...</p>
    </div>
  </div>
</section>
