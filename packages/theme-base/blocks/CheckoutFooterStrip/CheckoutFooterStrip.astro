---
/**
 * CheckoutFooterStrip — НЕ РЕНДЕРИТСЯ НИГДЕ с 14.09.2026.
 *
 * Владелец убрал подвал со страницы оформления заказа: «УДАЛИТЬ В ЧЕКАУТЕ»,
 * показано на чёрную полосу «© 2026 Rose. Все права защищены.». Тем же
 * сообщением он назвал подвалом чекаута блок условий под кнопкой оплаты
 * (`CheckoutTerms`) — правовая информация осталась там.
 *
 * Файл оставлен намеренно: требование к подвалу чекаута менялось дважды за
 * сутки (18-А завёл полосу, 14.09 снял), и восстановить её дешевле, чем
 * написать заново. Ни одна тема и ни один сборщик его больше не подключают —
 * это сторожит `src/themes/__tests__/checkout-no-footer.spec.ts`. Прежде чем
 * возвращать — прочитайте тот гард: он назовёт цену возврата.
 *
 * Ниже — исходная документация блока.
 *
 * CheckoutFooterStrip — правовой подвал страницы оформления заказа.
 *
 * Контекст (spec 109, checkout chrome): live-checkout — verbatim порт-страница
 * с chrome='checkout' (CheckoutHeader, БЕЗ секции Footer), поэтому полный футер
 * (рассылка/меню/копирайт) на checkout не рендерится. Эта секция возвращает
 * нижнюю полосу: правовые ссылки магазина + строку копирайта. Подключается в
 * checkout-ветке Layout каждой темы (как общий CheckoutHeader).
 *
 * Баг-репорт 18-А: «Во вкладке Оформление заказа убрать подвал, где идёт
 * "Powered by merfy". Ожидаемый результат: подвал на этой странице — это
 * юридическая информация, ссылки». До этого полоса несла ровно одну строку —
 * «© 2026 … Все права защищены. Powered by Merfy» (Figma 1:13399, узел так и
 * назывался), и покупатель на шаге оплаты не мог открыть ни оферту, ни
 * политику возврата.
 *
 * Ссылки НЕ выдумываются: `links` приходят из реестра политик магазина
 * (site_policy → `Footer.props.informationColumn.links`, см. applyFooterData),
 * тем же каналом, что и в обычном подвале. Политика не заполнена — ссылки нет.
 *
 * Цвета — из активной color-scheme через токены (checkout = scheme-2, светлая
 * → --color-heading чёрный фон, --color-bg белый текст). Разметка зеркалит
 * bottom-strip из Footer.astro тем.
 */
import { schemeClassOf } from '../../runtime/color-scheme';
// Правовые ссылки приходят из реестра политик магазина, но в атрибут уходят
// как есть — закрываем тем же общим списком схем, что и прочие ссылки чекаута.
import { safeHref } from '../../runtime/rich-text';

interface LegalLink {
  label?: string;
  href?: string;
}

interface Props {
  /** Название магазина (Layout прокидывает SITE_TITLE, build.service патчит). */
  siteTitle?: string;
  /** «Цветовая схема» секции «Подвал» страницы чекаута ("scheme-N" | N). */
  colorScheme?: unknown;
  /** Полная замена строки копирайта (если задана). */
  text?: string;
  /** Правовые страницы магазина: оферта, политики возврата/доставки/данных. */
  links?: LegalLink[];
}
const { siteTitle = "", text, links = [], colorScheme } = Astro.props as Props;
// Схема секции «Подвал» страницы чекаута. Полоса красится токенами схемы
// (`--color-heading` фон / `--color-bg` текст), поэтому класс нужен НА КОРНЕ:
// без него полоса брала палитру страницы и контрол «Цветовая схема» в панели
// не делал ничего (п.4 третьего круга).
const schemeClass = schemeClassOf(colorScheme);
const year = new Date().getFullYear();
const copyright =
  text && text.trim()
    ? text
    : `© ${year}${siteTitle ? ` ${siteTitle}` : ""}. Все права защищены.`;
const legalLinks = (Array.isArray(links) ? links : []).filter(
  (l): l is Required<LegalLink> =>
    Boolean(l && typeof l.label === "string" && l.label.trim() && typeof l.href === "string" && l.href.trim()),
);
---

<footer class:list={["w-full", schemeClass]} data-checkout-footer-strip>
  <div
    class="flex w-full flex-col items-center justify-center gap-3 bg-[rgb(var(--color-heading,0_0_0))] px-4 py-5"
  >
    {legalLinks.length > 0 && (
      <nav
        class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2"
        data-checkout-legal-links
        aria-label="Правовая информация"
      >
        {legalLinks.map((link) => (
          <a
            href={safeHref(link.href)}
            class="text-center text-[14px] font-normal leading-none text-[rgb(var(--color-bg,255_255_255))] underline underline-offset-4"
          >{link.label}</a>
        ))}
      </nav>
    )}
    <p
      class="text-center text-[14px] font-normal leading-none text-[rgb(var(--color-bg,255_255_255))]"
    >
      {copyright}
    </p>
  </div>
</footer>
