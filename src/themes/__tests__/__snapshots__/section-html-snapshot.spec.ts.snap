exports[`снимки секций — flux PromoBanner — снимок разметки 1`] = `"<div class="bg-[rgb(var(--color-bg))] text-[rgb(var(--color-text))] flex items-center justify-center overflow-hidden px-4 md:px-20 xl:px-[300px] 2xl:px-[680px] h-12" style="padding-top:40px;padding-bottom:40px;" role="region" aria-live="polite" data-nt="promo-banner" data-nt-text-size="lg" data-puck-component-id="PromoBanner-1"> <p class="text-center font-roboto-flex font-light leading-normal max-w-full text-[12px] md:text-[16px]" data-puck-subsection-parent="PromoBanner-1" data-puck-subsection-index="100" data-puck-subsection-field="text"> <span class="whitespace-pre-wrap">Объявление</span> <a href="/" class="underline underline-offset-2 [text-decoration-skip-ink:none] decoration-solid hover:opacity-90"> Подробнее </a> </p> </div>"`;

exports[`снимки секций — flux Publications — снимок разметки 1`] = `"<section class="w-full bg-[rgb(var(--color-bg,255_255_255))] px-4 pb-16 pt-16 md:px-20 md:pb-24 md:pt-24 2xl:px-80" aria-labelledby="Publications-1-title" data-puck-component-id="Publications-1" style="padding-top:40px;padding-bottom:40px;"> <div class="mx-auto flex w-full max-w-[1320px] flex-col gap-8 md:gap-12"> <h2 id="Publications-1-title" class="font-roboto-flex text-[24px] md:text-[28px] font-normal uppercase leading-[1.115] text-[rgb(var(--color-heading,0_0_0))]" data-puck-subsection-parent="Publications-1" data-puck-subsection-index="100" data-puck-subsection-field="heading"> Публикации </h2> <div class="grid w-full grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-[repeat(var(--pub-cols),minmax(0,1fr))]" style="--pub-cols:2;"> <article class="group flex flex-col gap-3 md:gap-4" data-publication-index="0"><div class="aspect-[4/3] w-full overflow-hidden rounded-[var(--radius-media,8px)] bg-[rgb(var(--color-surface,245_245_245))]"> <img src="/placeholders/publication-card.png" alt="Новая коллекция весна 2025" width="800" height="600" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"> </div> <div class="flex flex-col gap-1"> <span class="font-roboto-flex text-[12px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))] md:text-[14px]"> 15 марта 2025 </span> <span class="font-roboto-flex text-[14px] font-light leading-[1.366] text-[rgb(var(--color-text,0_0_0))] md:text-[16px]"> Новая коллекция весна 2025 </span> <p class="font-roboto-flex text-[12px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))] md:text-[14px]"> Рассказываем о вдохновении и ключевых силуэтах новой коллекции. </p> </div> </article><article class="group flex flex-col gap-3 md:gap-4" data-publication-index="1"><div class="aspect-[4/3] w-full overflow-hidden rounded-[var(--radius-media,8px)] bg-[rgb(var(--color-surface,245_245_245))]"> <img src="/placeholders/publication-card.png" alt="Как ухаживать за изделиями" width="800" height="600" loading="lazy" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"> </div> <div class="flex flex-col gap-1"> <span class="font-roboto-flex text-[12px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))] md:text-[14px]"> 28 февраля 2025 </span> <span class="font-roboto-flex text-[14px] font-light leading-[1.366] text-[rgb(var(--color-text,0_0_0))] md:text-[16px]"> Как ухаживать за изделиями </span> <p class="font-roboto-flex text-[12px] font-light leading-normal text-[rgb(var(--color-muted,153_153_153))] md:text-[14px]"> Простые правила, чтобы ваши вещи служили долгие годы. </p> </div> </article> </div> </div> </section>"`;

exports[`снимки секций — flux Slideshow — снимок разметки 1`] = `"<section class="relative w-full overflow-hidden bg-[rgb(var(--color-bg,255_255_255))]" data-puck-component-id="Slideshow-1" data-flux-slideshow data-interval="5000" data-autoplay="false" style="padding-top:40px;padding-bottom:40px;"> <div class="w-full"> <div class="relative mx-auto w-full overflow-hidden" style="min-height:clamp(500px, 80vh, 1080px)"> <div data-slide class="!absolute inset-0 transition-opacity duration-500 ease-out opacity-100" data-puck-subsection-parent="Slideshow-1" data-puck-subsection-index="0" data-puck-subsection-field="slides"> <div class="absolute inset-0 bg-[rgb(var(--color-surface,245_245_245))]" aria-hidden="true"></div> <div class="relative z-10 flex h-full w-full flex-col items-start justify-end px-4 py-8 md:px-20 md:py-10 2xl:px-80"> <div class="flex max-w-[432px] flex-col gap-6 items-center text-center"> <div class="flex flex-col gap-2 items-center text-center"> <h2 class="font-roboto-flex text-[20px] font-normal uppercase leading-normal text-[rgb(var(--color-heading,255_255_255))] md:text-[24px]">Слайд</h2> <p class="font-roboto-flex text-[14px] font-light leading-normal text-[rgb(var(--color-text,255_255_255))] md:text-[16px]">Подзаголовок</p> </div> <a href="/catalog" class="inline-flex h-14 w-fit items-center justify-center rounded-[var(--radius-button,6px)] bg-black px-4 font-roboto-flex text-[16px] font-normal uppercase leading-none text-white transition-opacity hover:opacity-90"> Кнопка </a> </div> </div> </div> </div> </div> </section> <script> (function () { function initOne(root) { if (root.dataset.slideshowHydrated === "true") return; root.dataset.slideshowHydrated = "true"; var interval = parseInt(root.dataset.interval || "5000", 10); var autoplay = root.dataset.autoplay !== "false"; var slides = root.querySelectorAll("[data-slide]"); var dots = root.querySelectorAll("[data-slide-dot]"); if (slides.length < 2) return; var idx = 0, timer = null; // Простой fade (transition-opacity на слайде) — каскадных анимаций // в манере flux нет (MANNER §6). function show(n) { idx = (n + slides.length) % slides.length; for (var j = 0; j < slides.length; j++) { slides[j].style.opacity = j === idx ? "1" : "0"; slides[j].style.pointerEvents = j === idx ? "auto" : "none"; } for (var k = 0; k < dots.length; k++) { dots[k].setAttribute("data-active", k === idx ? "true" : "false"); } } function restart() { if (timer) clearInterval(timer); if (autoplay) timer = setInterval(function () { show(idx + 1); }, interval); } root.querySelectorAll("[data-slide-prev]").forEach(function (b) { b.addEventListener("click", function () { show(idx - 1); restart(); }); }); root.querySelectorAll("[data-slide-next]").forEach(function (b) { b.addEventListener("click", function () { show(idx + 1); restart(); }); }); dots.forEach(function (d, i) { d.addEventListener("click", function () { show(i); restart(); }); }); show(0); restart(); } function initAll() { var roots = document.querySelectorAll("[data-flux-slideshow]"); for (var k = 0; k < roots.length; k++) initOne(roots[k]); } initAll(); // Hot-replace превью вставляет секцию заново (новый узел без флага) и // шлёт astro:page-load — реинициализация подхватит свежий слайдер. document.addEventListener("astro:page-load", initAll); })(); </script>"`;

