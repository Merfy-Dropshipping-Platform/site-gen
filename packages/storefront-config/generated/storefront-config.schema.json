{
  "$comment": "Сгенерировано из схемы zod командой pnpm generate — руками не править.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "preview"
      ]
    },
    "shop": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "url"
      ],
      "additionalProperties": false
    },
    "currency": {
      "type": "string",
      "const": "RUB"
    },
    "locale": {
      "type": "string",
      "const": "ru-RU"
    },
    "api": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": ".*\\/api$"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$"
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^\\/.*"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "v",
    "mode",
    "shop",
    "currency",
    "locale",
    "api",
    "theme",
    "page"
  ],
  "additionalProperties": false
}
