---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import CheckoutHeader from "../../../../packages/theme-base/blocks/CheckoutHeader/CheckoutHeader.astro";
import Footer from "../components/Footer.astro";
import BloomCartAddedModal from "../components/cart/BloomCartAddedModal.astro";
import NtCartDrawer from "@merfy-dropshipping-platform/design-systems-theme/components/ui/NtCartDrawer.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { ViewTransitions } from "astro:transitions";

interface Props {
	title?: string;
	description?: string;
	// "checkout" → минимальная шапка оформления (CheckoutHeader, Figma 1:13563);
	// build.service патчит бренд CheckoutHeader под мерчанта на сборке сайта.
	header?: "default" | "checkout";
}

const { title, description = SITE_DESCRIPTION, header = "default" } = Astro.props;
const pageTitle = title ? `${title} — ${SITE_TITLE}` : SITE_TITLE;
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead title={pageTitle} description={description} />
		<ViewTransitions />
	</head>
	<body class="antialiased bg-white">
		{header === "checkout" ? (
			<div class="color-scheme-2" style="--size-checkout-brand:24px;--size-checkout-brand-image:32px;">
				<CheckoutHeader siteTitle={SITE_TITLE} logoMode="text" logoImage={null} rightIcon="cart" accountLink="/account" backLink="/cart" cartLink="/cart" padding={{ top: 24, bottom: 24 }} />
			</div>
		) : (
			<Header />
		)}
		<main>
			<slot />
		</main>
		{/* Чекаут — без футера (header="checkout"), паритет с rose. */}
		{header !== "checkout" && <Footer />}
		<NtCartDrawer rootId="bloom-cart-drawer-root" eventPrefix="bloom:cart" />
		{/* Тексты панели корзины из настроек темы («Заголовок панели», «Текст
		    кнопки оформления», «Текст пустой корзины»). До этого у настроек не
		    было ни одного читателя: панель сохраняла значения, витрина
		    показывала литералы дизайн-пакета. Значения приезжают строковыми
		    CSS-переменными (tokens-css) — тем же каналом, что и остальные
		    настройки темы, поэтому превью и живой сайт совпадают. Подстановка
		    через textContent (не innerHTML) — разметка DS не трогается. */}
		<script is:inline define:vars={{ evPrefix: "bloom:cart" }}>
			(() => {
				const readVar = (name) => {
					const raw = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
					if (!raw) return null;
					try {
						return JSON.parse(raw);
					} catch {
						return raw.replace(/^["']|["']$/g, "") || null;
					}
				};
				const apply = () => {
					const root = document.querySelector('[data-nt="cart-drawer"]');
					if (!root) return;
					const title = readVar("--cart-drawer-title");
					const checkout = readVar("--cart-drawer-checkout-text");
					const empty = readVar("--cart-drawer-empty-text");
					if (title) {
						const h = root.querySelector("[data-cart-panel] h2");
						if (h && h.textContent !== title) h.textContent = title;
					}
					if (checkout) {
						const btn = root.querySelector("[data-cart-summary] > a");
						if (btn && btn.textContent.trim() !== checkout) btn.textContent = checkout;
					}
					if (empty) {
						const p = root.querySelector("[data-cart-empty] p");
						if (p && p.textContent.trim() !== empty) p.textContent = empty;
					}
				};
				apply();
				document.addEventListener("astro:page-load", apply);
				document.addEventListener(evPrefix + ":open", apply);
				const root = document.querySelector('[data-nt="cart-drawer"]');
				// Содержимое панели перерисовывается стором корзины — держим тексты.
				if (root) new MutationObserver(apply).observe(root, { childList: true, subtree: true });
			})();
		</script>

		<BloomCartAddedModal />
		<script>
			import { initCartUI } from "../lib/cart";
			import { initWishlistUI } from "../lib/wishlist";
			import { initAuthUI } from "../lib/auth";
			initCartUI();
			// Избранное (wishlist) — глобальный делегат сердец/бейджей, зеркало корзины.
			initWishlistUI();
			// Аккаунт покупателя — красит [data-auth-link] и грузит профиль.
			initAuthUI();

			// Регулярное оформление («Оформить» корзины/drawer, data-action=checkout)
			// сбрасывает express «Купить сейчас» (sessionStorage bloom:buynow) — чтобы
			// чекаут показал корзину покупателя, а не залипший buy-now товар.
			document.addEventListener(
				"click",
				(e) => {
					const el = e.target as Element | null;
					if (el && el.closest("[data-action='checkout']")) {
						try { sessionStorage.removeItem("bloom:buynow"); } catch (err) {}
					}
				},
				true,
			);

				// Корзина «Сайдбар»/«Страница» (--cart-type): перехват клика по иконке
				// (<button data-cart-open>) в capture-фазе, опережая bubble-обработчик
				// панели (DS NtCartDrawer). page → /cart (live: переход; превью: <a> →
				// nav-агент → postMessage navigate). drawer (дефолт) → панель открывается сама.
				document.addEventListener(
					"click",
					(e) => {
						const el = e.target as Element | null;
						if (!el || !el.closest("[data-cart-open]")) return;
						const cartType = getComputedStyle(document.documentElement)
							.getPropertyValue("--cart-type")
							.trim()
							.replace(/['"]/g, "");
						if (cartType !== "page") return;
						e.preventDefault();
						e.stopImmediatePropagation();
						if (window.self === window.top) {
							window.location.assign("/cart");
						} else {
							const a = document.createElement("a");
							a.href = "/cart";
							document.body.appendChild(a);
							a.click();
							a.remove();
						}
					},
					true,
				);
		</script>
		<script>
			const initScrollAnimations = () => {
				const targets = document.querySelectorAll<HTMLElement>("[data-animate]");
				if (!targets.length) return;

				const observer = new IntersectionObserver(
					(entries) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								observer.unobserve(entry.target);
							}
						});
					},
					{ threshold: 0.08, rootMargin: "0px 0px -36px 0px" },
				);

				targets.forEach((el) => {
					el.classList.remove("is-visible");
					const delay = el.dataset.animateDelay;
					if (delay) el.style.animationDelay = delay;
					observer.observe(el);
				});
			};

			initScrollAnimations();
			document.addEventListener("astro:after-swap", initScrollAnimations);
		</script>
	</body>
</html>
