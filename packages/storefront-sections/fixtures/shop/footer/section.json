{
  "sdk": 1,
  "name": "footer",
  "kind": "section",
  "title": "Подвал",
  "groups": ["footer"],
  "limit": 1,
  "removable": false,
  "uses": ["theme", "shop", "newsletter"],
  "wrapper": ["scheme", "padding"],
  "wrapperSpec": { "padding": { "default": { "top": 80, "bottom": 0 } } },
  "names": {
    "payment-icons": {
      "kinds": ["toggle"],
      "label": "Значки оплаты",
      "about": "Значки карт МИР, Visa и Mastercard в подвале, когда у магазина есть оплата онлайн",
      "asks": ["значки оплаты", "платёжные системы", "карты", "мир", "visa", "mastercard", "payment icons"]
    }
  },
  "settings": [
    { "id": "logo", "label": "Логотип", "setting": { "kind": "image", "default": "", "maxBytes": 512000 } },
    {
      "id": "newsletter",
      "label": "Скрыть/показать",
      "section": "Рассылка",
      "setting": { "kind": "toggle", "default": true, "labels": { "on": "Показать", "off": "Скрыть" } }
    },
    {
      "id": "heading",
      "label": "Заголовок",
      "setting": { "kind": "string", "default": "Подпишитесь на нашу рассылку", "ai": "title" }
    },
    {
      "id": "heading-size",
      "label": "Размер заголовка",
      "setting": {
        "kind": "select",
        "default": "small",
        "options": [
          { "value": "small", "label": "Маленький" },
          { "value": "medium", "label": "Средний" },
          { "value": "large", "label": "Большой" }
        ]
      }
    },
    {
      "id": "text",
      "label": "Текст",
      "setting": {
        "kind": "text",
        "default": "Введите электронную почту и получайте информацию нашего бренда",
        "ai": "description"
      }
    },
    {
      "id": "text-size",
      "label": "Размер текста",
      "setting": {
        "kind": "select",
        "default": "small",
        "options": [
          { "value": "small", "label": "Маленький" },
          { "value": "medium", "label": "Средний" },
          { "value": "large", "label": "Большой" }
        ]
      }
    },
    { "wrapper": "scheme" },
    { "wrapper": "padding" },
    {
      "id": "layout",
      "label": "Раскладка",
      "section": "Вид",
      "setting": {
        "kind": "select",
        "default": "3-col",
        "options": [
          { "value": "3-col", "label": "Колонки" },
          { "value": "2-part", "label": "Две части" },
          { "value": "2-part-asymmetric", "label": "Друг под другом" },
          { "value": "minimal", "label": "Одна строка" }
        ]
      }
    },
    { "id": "menu", "label": "Изменить пункты меню", "setting": { "kind": "menu", "default": "main" } },
    {
      "id": "payment-icons",
      "label": "Значки оплаты",
      "setting": { "kind": "toggle", "default": true, "labels": { "on": "Показать", "off": "Скрыть" } }
    },
    {
      "id": "capitals",
      "label": "Заглавные буквы",
      "setting": {
        "kind": "select",
        "default": "columns",
        "options": [
          { "value": "none", "label": "Нет" },
          { "value": "columns", "label": "Заголовки колонок" },
          { "value": "all", "label": "Все заголовки" }
        ]
      }
    }
  ]
}
