				<!-- Описание (аккордеон) -->
				{hasDescription && (
					<div class="flex flex-col" data-cfg-spec data-puck-subsection-parent={id} data-puck-subsection-index="106" data-puck-subsection-field="description">
						<button type="button" class="flex min-h-11 w-full items-center justify-between gap-2 text-left" data-cfg-spec-toggle aria-expanded="false">
							<span class="font-roboto-flex text-[16px] font-normal uppercase leading-normal text-[#000000]">Описание</span>
							<NtIcon name="plus" sizeClass="size-6" />
						</button>
						<div class="hidden pt-2" data-cfg-spec-body>
							<p class="font-roboto-flex text-[14px] font-light leading-[1.5] text-[#999999] md:text-[15px]">{description}</p>
						</div>
					</div>
				)}

				<!-- Поделиться -->
				<button
					type="button"
					data-cfg-share
					data-puck-subsection-parent={id}
					data-puck-subsection-index="107"
					data-puck-subsection-field="share"
					class="inline-flex min-h-11 w-fit items-center gap-2 font-roboto-flex text-[14px] font-light uppercase leading-normal text-[#000000] transition-opacity hover:opacity-70"
					aria-label={shareText}
				>
					<NtIcon name="share" sizeClass="size-6" />
					<span>{shareText}</span>
				</button>
			</div>
		</div>

		<!-- ============================= MOBILE (<768px) ============================= -->
		<div class="flex w-full flex-col gap-6 md:hidden" data-nt="product-configurator">
			<!-- Фото: карусель + бейджи -->
			<div class="relative w-full" data-cfg-carousel data-cfg-images={galleryImages.join("|")}>
				<a href={href} class="relative block aspect-square w-full overflow-hidden rounded-[8px] bg-[#F5F5F5]" aria-label={displayName}>
					{isPlaceholder ? (
						<img src={mainImage} alt={displayName} width="343" height="343" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" data-cfg-main />
					) : (
						<FluxPicture src={mainImage} alt={displayName} width="343" height="343" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" data-cfg-main />
					)}
				</a>

				{showBadges && (
					<div class="absolute left-[18px] top-1 flex flex-col items-start gap-1">
						<span class="inline-flex items-center justify-center rounded-[2px] bg-[#1e2952] px-1.5 py-1 font-roboto-flex text-[12px] font-light leading-none text-white">{salePercentText}</span>
					</div>
				)}

				{galleryImages.length > 1 && (
					<>
						<button type="button" class="absolute left-2 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center transition-opacity hover:opacity-70" data-cfg-prev aria-label="Предыдущее изображение">
							<NtIcon name="arrow-slide-left" sizeClass="size-6" />
						</button>
						<button type="button" class="absolute right-2 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center transition-opacity hover:opacity-70" data-cfg-next aria-label="Следующее изображение">
							<NtIcon name="arrow-slide-right" sizeClass="size-6" />
						</button>
					</>
				)}
			</div>

			<!-- Текст -->
			<div class="flex flex-col gap-2">
				{displayBrand && (
					<p class="font-roboto-flex text-[14px] font-light uppercase leading-normal text-[#999999]" data-puck-subsection-parent={id} data-puck-subsection-index="100" data-puck-subsection-field="text">
						{displayBrand}
					</p>
				)}
				<h2 class="font-roboto-flex text-[19px] font-light uppercase leading-normal text-[#000000]" data-cfg-name data-puck-subsection-parent={id} data-puck-subsection-index="101" data-puck-subsection-field="title">
					{displayName}
				</h2>
				<div class="flex items-center gap-2" data-puck-subsection-parent={id} data-puck-subsection-index="102" data-puck-subsection-field="price">
					<span class="font-roboto-flex text-[18px] font-light leading-normal text-[#000000]" data-cfg-price>{displayPrice}</span>
					<span class="font-roboto-flex text-[15px] font-light leading-normal text-[#999999] line-through" data-cfg-oldprice hidden={!displayOldPrice}>{displayOldPrice}</span>
				</div>
			</div>

			<!-- Варианты -->
			<div
				class="flex flex-col gap-4"
				data-cfg-variants
				data-variants-style={variantsDisplayStyle}
				data-puck-subsection-parent={id}
				data-puck-subsection-index="103"
				data-puck-subsection-field="variants"
				hidden={!hasVariants}
				set:html={variantsHtml}
			/>

			<!-- Счётчик -->
			{quantityVisible && (
				<div class="inline-flex w-fit items-center gap-3" data-cfg-qty data-puck-subsection-parent={id} data-puck-subsection-index="104" data-puck-subsection-field="quantity">
					<button type="button" class="flex size-8 items-center justify-center transition-opacity hover:opacity-60" aria-label="Уменьшить количество" data-cfg-qty-dec>
						<NtIcon name="minus" sizeClass="size-4" />
					</button>
					<span class="min-w-6 text-center font-roboto-flex text-[16px] font-light leading-none text-[#1e2952]" data-cfg-qty-value>1</span>
					<button type="button" class="flex size-8 items-center justify-center transition-opacity hover:opacity-60" aria-label="Увеличить количество" data-cfg-qty-inc>
						<NtIcon name="plus" sizeClass="size-4" />
					</button>
				</div>
			)}

			<!-- Кнопки -->
			{(showAddToCart || showBuyNow) && (
				<div class="flex flex-col gap-3" data-puck-subsection-parent={id} data-puck-subsection-index="105" data-puck-subsection-field="buttons">
					{showAddToCart && (
						<button
							type="button"
							data-cfg-add
							{...addToCartAttrs}
							class="inline-flex h-14 w-full items-center justify-center rounded-[4px] border border-solid border-[#1e2952] bg-white px-4 font-roboto-flex text-[16px] font-light uppercase leading-none text-[#1e2952] transition-colors hover:bg-[#1e2952] hover:text-white"
						>
							{addBtnText}
						</button>
					)}
					{showBuyNow && (
						<button type="button" data-cfg-buy class="inline-flex h-14 w-full items-center justify-center rounded-[4px] bg-[#1e2952] px-4 font-roboto-flex text-[16px] font-light uppercase leading-none text-white transition-opacity hover:opacity-90">
							{buyBtnText}
						</button>
					)}
				</div>
			)}

			<!-- Описание (аккордеон) -->
			{hasDescription && (
				<div class="flex flex-col" data-cfg-spec data-puck-subsection-parent={id} data-puck-subsection-index="106" data-puck-subsection-field="description">
					<button type="button" class="flex w-full items-center justify-between gap-2 text-left" data-cfg-spec-toggle aria-expanded="false">
						<span class="font-roboto-flex text-[16px] font-normal uppercase leading-normal text-[#000000]">Описание</span>
						<NtIcon name="plus" sizeClass="size-6" />
					</button>
					<div class="hidden pt-2" data-cfg-spec-body>
						<p class="font-roboto-flex text-[14px] font-light leading-[1.5] text-[#999999]">{description}</p>
					</div>
				</div>
			)}

			<!-- Поделиться -->
			<button
				type="button"
				data-cfg-share
				data-puck-subsection-parent={id}
				data-puck-subsection-index="107"
				data-puck-subsection-field="share"
				class="inline-flex min-h-11 w-fit items-center gap-2 font-roboto-flex text-[14px] font-light uppercase leading-normal text-[#000000] transition-opacity hover:opacity-70"
				aria-label={shareText}
			>
				<NtIcon name="share" sizeClass="size-6" />
				<span>{shareText}</span>
			</button>
		</div>
	</div>
</section>

<script>
	// Оживление секции (общее для desktop+mobile деревьев, каждое своё —
	// паттерн 1:1 с upstream ProductConfigurator: forEach по
	// [data-nt="product-configurator"], счётчик/галерея/аккордеон/поделиться
	// независимы в каждом дереве). ЖИВОЙ рефреш данных (loadRealProducts) —
	// тот же каскад источников, что Popular.astro/FluxProductDetail.astro;
	// вызывается ОДИН раз на секцию (siteId у секции только один инстанс,
	// maxInstances:1), затем применяется к обоим деревьям.
	import {
		loadRealProducts,
		formatPrice,
		deriveVariantGroups,
		findCombination,
		renderVariantGroupsHtml,
		renderVariantSelectsHtml,
		resolveComboPricing,
	} from "../../lib/storefront-hydrate";

	function pick(opts: Record<string, string> | undefined, keys: string[]): string {
		for (const k of keys) if (opts && opts[k] != null) return opts[k];
		return "";
	}

	// Lightbox: полноэкранный попап с большим фото + лентой миниатюр. Портирован
	// 1:1 с theme-base Product.astro (то, что реально рендерит Rose) — canon
	// zoomMode="click". Разметка/поведение дословно (overlay/closeBtn/strip/
	// стрелки-клавиши/Esc), меняется только источник URL (readCfgImages ниже,
	// под структуру Flux-конфигуратора).
	function openProductLightbox(urls: string[]) {
		if (urls.length === 0) return;
		let activeIdx = 0;

		const overlay = document.createElement("div");
		overlay.setAttribute("data-product-lightbox", "");
		overlay.style.cssText = [
			"position:fixed", "inset:0", "z-index:100",
			"background:rgba(0,0,0,0.92)",
			"display:flex", "flex-direction:column",
			"align-items:center", "justify-content:center",
			"padding:32px", "gap:16px",
		].join(";");

		const closeBtn = document.createElement("button");
		closeBtn.setAttribute("type", "button");
		closeBtn.setAttribute("aria-label", "Закрыть");
		closeBtn.style.cssText = [
			"position:absolute", "top:16px", "right:16px",
			"width:40px", "height:40px", "border:none",
			"background:rgba(255,255,255,0.1)", "color:#fff",
			"border-radius:50%", "cursor:pointer",
			"font-size:24px", "line-height:1",
			"display:flex", "align-items:center", "justify-content:center",
		].join(";");
		closeBtn.innerHTML = "×";
		overlay.appendChild(closeBtn);

		const mainImgEl = document.createElement("img");
		mainImgEl.style.cssText = [
			"max-width:100%", "max-height:calc(100vh - 200px)",
			"object-fit:contain", "display:block",
			"border-radius:8px",
		].join(";");
		mainImgEl.src = urls[0];
		overlay.appendChild(mainImgEl);

		const strip = document.createElement("div");
		strip.style.cssText = [
			"display:flex", "gap:8px",
			"overflow-x:auto", "max-width:100%",
			"padding:8px",
		].join(";");

		const thumbBtns = urls.map((url, idx) => {
			const btn = document.createElement("button");
			btn.setAttribute("type", "button");
			btn.style.cssText = [
				"width:80px", "height:80px", "flex-shrink:0",
				"border:2px solid " + (idx === 0 ? "#fff" : "transparent"),
				"border-radius:6px", "overflow:hidden",
				"cursor:pointer", "padding:0", "background:transparent",
				"transition:border-color 0.15s",
			].join(";");
			const img = document.createElement("img");
			img.src = url;
			img.style.cssText = "width:100%;height:100%;object-fit:cover;display:block;";
			btn.appendChild(img);
			btn.addEventListener("click", () => {
				activeIdx = idx;
				mainImgEl.src = url;
				thumbBtns.forEach((b, i) => {
					b.style.borderColor = i === idx ? "#fff" : "transparent";
				});
			});
			strip.appendChild(btn);
			return btn;
		});
		overlay.appendChild(strip);

		function close() {
			overlay.remove();
			document.removeEventListener("keydown", onKey);
		}
		function onKey(e: KeyboardEvent) {
			if (e.key === "Escape") close();
			if (e.key === "ArrowRight" && activeIdx < urls.length - 1) {
				activeIdx++;
				mainImgEl.src = urls[activeIdx];
				thumbBtns.forEach((b, i) => {
					b.style.borderColor = i === activeIdx ? "#fff" : "transparent";
				});
			}
			if (e.key === "ArrowLeft" && activeIdx > 0) {
				activeIdx--;
				mainImgEl.src = urls[activeIdx];
				thumbBtns.forEach((b, i) => {
					b.style.borderColor = i === activeIdx ? "#fff" : "transparent";
				});
			}
		}
		closeBtn.addEventListener("click", close);
		overlay.addEventListener("click", (e) => {
			if (e.target === overlay) close();
		});
		document.addEventListener("keydown", onKey);
		document.body.appendChild(overlay);
	}

	async function hydrateFeaturedProduct() {
		const section = document.querySelector<HTMLElement>('[data-block="featured-product"]');
		if (!section) return;

		const ref = section.getAttribute("data-product-id") || "";
		// «Увеличение» (canon zoomMode: hover/click/none) — паритет с Rose
		// (packages/theme-base/blocks/Product/Product.astro: hover = tracking-zoom
		// scale(2) с transform-origin за курсором; click = lightbox на весь экран +
		// лента миниатюр + стрелки/Esc). Раньше был ЗАДОКУМЕНТИРОВАННЫМ no-op —
		// вывод «зума в теме нет» сверялся со СТАТИЧНОЙ закреплённой вёрсткой
		// (там правда нет), а не с ЖИВЫМ поведением Rose (которая рендерит эту же
		// секцию через theme-base и реально его показывает) — вывод был неверным
		// применительно к принципу «логика конструктора как у Rose».
		const zoomMode = section.getAttribute("data-zoom-mode") || "hover";

		// UI-интерактивность (счётчик/миниатюры/карусель/аккордеон/поделиться)
		// работает НЕЗАВИСИМО от живых данных — вешаем всегда, на то, что уже
		// отрендерил SSR (плейсхолдер или SSR-резолв превью).
		const cfgs = Array.from(section.querySelectorAll<HTMLElement>('[data-nt="product-configurator"]'));

		let liveProduct: any = null;
		if (ref) {
			try {
				const products = await loadRealProducts();
				if (products) {
					liveProduct = products.find((x: any) => x && (x.id === ref || x.slug === ref || x.handle === ref)) ?? null;
				}
			} catch {
				liveProduct = null;
			}
		}

		for (const cfg of cfgs) {
			const mainImg = cfg.querySelector<HTMLImageElement>("[data-cfg-main]");
			const nameEl = cfg.querySelector<HTMLElement>("[data-cfg-name]");
			const priceEl = cfg.querySelector<HTMLElement>("[data-cfg-price]");
			const oldPriceEl = cfg.querySelector<HTMLElement>("[data-cfg-oldprice]");
			const addBtn = cfg.querySelector<HTMLButtonElement>("[data-cfg-add]");
			const buyBtn = cfg.querySelector<HTMLButtonElement>("[data-cfg-buy]");
			const variantsWrap = cfg.querySelector<HTMLElement>("[data-cfg-variants]");
			const qtyValEl = cfg.querySelector<HTMLElement>("[data-cfg-qty-value]");

			// ── Живой рефреш (только если реальный товар найден клиентским фетчем). ──
			let combos: any[] = [];
			let groups: { name: string; values: string[] }[] = [];
			let selected: Record<string, string> = {};

			if (liveProduct) {
				if (nameEl) nameEl.textContent = liveProduct.name || nameEl.textContent || "";
				if (mainImg && Array.isArray(liveProduct.images) && liveProduct.images[0]) {
					mainImg.setAttribute("src", liveProduct.images[0]);
				}
				combos = Array.isArray(liveProduct.variantCombinations) ? liveProduct.variantCombinations : [];
				if (combos.length) {
					groups = deriveVariantGroups(combos);
					const firstAvailable = combos.find((c: any) => c && c.available !== false) ?? combos[0];
					selected = { ...(firstAvailable.options || {}) };
				}
			}

			function activeCombo() {
				return combos.length ? findCombination(combos, selected) : null;
			}

			function applyCombo() {
				const combo = activeCombo();
				// Единая формула резолва цены — resolveComboPricing (storefront-hydrate.ts),
				// та же, что зовёт SSR-фронтматтер этого файла (review Task 5, Finding 3a:
				// раньше здесь была слегка другая копия той же формулы).
				const { price: priceVal, oldPrice: oldVal } = resolveComboPricing(combo, liveProduct);
				if (liveProduct) {
					const priceStr = formatPrice(priceVal);
					const oldStr = formatPrice(oldVal);
					if (priceEl) priceEl.textContent = priceStr;
					if (oldPriceEl) {
						oldPriceEl.textContent = oldStr;
						oldPriceEl.hidden = !oldStr;
					}
					if (addBtn) {
						addBtn.setAttribute("data-price", priceStr);
						addBtn.setAttribute("data-old-price", oldStr);
						addBtn.setAttribute("data-name", liveProduct.name || "");
						addBtn.setAttribute("data-product-id", liveProduct.id || ref);
						if (mainImg?.getAttribute("src")) addBtn.setAttribute("data-image", mainImg.getAttribute("src")!);
					}
				}
				const available = combo ? combo.available !== false && (combo.quantity == null || Number(combo.quantity) > 0) : true;
				for (const btn of [addBtn, buyBtn]) {
					if (!btn) continue;
					btn.disabled = !available;
					btn.classList.toggle("opacity-50", !available);
					btn.classList.toggle("pointer-events-none", !available);
				}
				if (addBtn) {
					addBtn.setAttribute("data-variant-combination-id", (combo && combo.id) || "");
					addBtn.setAttribute("data-variant-color", pick(selected, ["Цвет", "Color"]));
					addBtn.setAttribute("data-variant-size", pick(selected, ["Размер", "Size"]));
				}
			}

			// displayStyle (variants.displayStyle, canon Product.puckConfig "Стиль")
			// проставлен на wrap SSR-стороной — читаем, чтобы живой рефреш
			// перерисовывал ТЕМ ЖЕ режимом (чипы или <select>), а не молча
			// переключался на дефолт.
			const isListStyle = variantsWrap?.getAttribute("data-variants-style") === "list";
			const renderVariants = (gs: { name: string; values: string[] }[], sel: Record<string, string>) =>
				isListStyle ? renderVariantSelectsHtml(gs, sel) : renderVariantGroupsHtml(gs, sel);

			if (variantsWrap && groups.length) {
				variantsWrap.hidden = false;
				variantsWrap.innerHTML = renderVariants(groups, selected);
				variantsWrap.onclick = (e) => {
					const target = e.target as HTMLElement;
					const btn = target.closest<HTMLElement>("[data-variant-value]");
					if (!btn) return;
					const groupEl = btn.closest<HTMLElement>("[data-pdp-variant-group]");
					const group = groupEl?.getAttribute("data-pdp-variant-group");
					const value = btn.getAttribute("data-variant-value");
					if (!group || value == null) return;
					selected[group] = value;
					variantsWrap.innerHTML = renderVariants(groups, selected);
					applyCombo();
				};
				variantsWrap.onchange = (e) => {
					const target = e.target as HTMLElement;
					const select = target.closest<HTMLSelectElement>("[data-variant-select]");
					if (!select) return;
					const group = select.getAttribute("data-variant-key");
					if (!group) return;
					selected[group] = select.value;
					applyCombo();
				};
			}
			if (combos.length || liveProduct) applyCombo();

			// ── Миниатюры → главное фото (обмен, как в SSR-шаблоне). ──
			cfg.querySelectorAll<HTMLButtonElement>("[data-cfg-thumb]").forEach((thumb) => {
				thumb.addEventListener("click", () => {
					const src = thumb.dataset.image;
					if (mainImg && src) mainImg.setAttribute("src", src);
					cfg.querySelectorAll("[data-cfg-thumb]").forEach((t) => t.classList.remove("border", "border-solid", "border-[#1e2952]/50"));
					thumb.classList.add("border", "border-solid", "border-[#1e2952]/50");
				});
			});

			// Стрелка ленты миниатюр (шаг = миниатюра 120px + gap 12px).
			const track = cfg.querySelector<HTMLElement>("[data-cfg-thumbs-track]");
			cfg.querySelector<HTMLButtonElement>("[data-cfg-thumbs-next]")?.addEventListener("click", () => {
				if (!track) return;
				const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
				track.scrollTo({ left: atEnd ? 0 : track.scrollLeft + 132, behavior: "smooth" });
			});

			// Мобильная карусель (prev/next меняют главное фото).
			const carousel = cfg.querySelector<HTMLElement>("[data-cfg-carousel]");
			if (carousel) {
				const slides = (carousel.dataset.cfgImages || "").split("|").filter(Boolean);
				let idx = 0;
				const go = (delta: number) => {
					if (slides.length < 2) return;
					idx = (idx + delta + slides.length) % slides.length;
					if (mainImg) mainImg.setAttribute("src", slides[idx]);
				};
				carousel.querySelector<HTMLButtonElement>("[data-cfg-prev]")?.addEventListener("click", () => go(-1));
				carousel.querySelector<HTMLButtonElement>("[data-cfg-next]")?.addEventListener("click", () => go(1));
			}

			// Счётчик количества → синкаем data-quantity на кнопки корзины.
			const syncQty = (n: number) => {
				if (qtyValEl) qtyValEl.textContent = String(n);
				if (addBtn) addBtn.setAttribute("data-quantity", String(n));
			};
			cfg.querySelector<HTMLButtonElement>("[data-cfg-qty-dec]")?.addEventListener("click", () => {
				syncQty(Math.max(1, Number(qtyValEl?.textContent || 1) - 1));
			});
			cfg.querySelector<HTMLButtonElement>("[data-cfg-qty-inc]")?.addEventListener("click", () => {
				syncQty(Number(qtyValEl?.textContent || 1) + 1);
			});

			// «Купить сейчас» — как в пине: добавляем в корзину (клик по добавить),
			// затем переходим в /cart (упрощённый upstream-путь, НЕ express-чекаут
			// FluxProductDetail — это ДРУГАЯ секция/страница со своим контрактом).
			cfg.querySelector<HTMLButtonElement>("[data-cfg-buy]")?.addEventListener("click", () => {
				if (addBtn && !addBtn.disabled) addBtn.dispatchEvent(new MouseEvent("click", { bubbles: true }));
				window.location.href = "/cart";
			});

			// Аккордеон описания — простой class-toggle (без gsap: ни одна другая
			// секция flux не импортирует gsap напрямую в компонент).
			cfg.querySelectorAll<HTMLElement>("[data-cfg-spec]").forEach((spec) => {
				const toggle = spec.querySelector<HTMLButtonElement>("[data-cfg-spec-toggle]");
				const body = spec.querySelector<HTMLElement>("[data-cfg-spec-body]");
				const icon = toggle?.querySelector<HTMLImageElement>("img");
				if (!toggle || !body) return;
				toggle.addEventListener("click", () => {
					const wasOpen = toggle.getAttribute("aria-expanded") === "true";
					const open = !wasOpen;
					toggle.setAttribute("aria-expanded", open ? "true" : "false");
					body.classList.toggle("hidden", !open);
					if (icon) icon.src = icon.src.replace(/\/(plus|minus)\.svg/, open ? "/minus.svg" : "/plus.svg");
				});
			});

			// Поделиться: clipboard/navigator.share + временная подпись.
			const shareBtn = cfg.querySelector<HTMLButtonElement>("[data-cfg-share]");
			const shareLabel = shareBtn?.querySelector<HTMLElement>("span");
			shareBtn?.addEventListener("click", async () => {
				const url = location.href;
				try {
					if (navigator.share) {
						await navigator.share({ title: document.title, url });
						return;
					}
					await navigator.clipboard.writeText(url);
				} catch {
					/* пользователь отменил / нет доступа к clipboard */
				}
				if (shareLabel) {
					const orig = shareLabel.textContent;
					shareLabel.textContent = "Ссылка скопирована!";
					setTimeout(() => {
						shareLabel.textContent = orig;
					}, 1500);
				}
			});

			// Увеличение — hover/click, см. константу zoomMode выше.
			if (mainImg && zoomMode !== "none") {
				const heroEl = mainImg.closest<HTMLAnchorElement>("a");
				if (heroEl) {
					heroEl.style.cursor = "zoom-in";
					if (zoomMode === "hover") {
						mainImg.style.transition = "transform 0.2s ease, transform-origin 0.05s linear";
						heroEl.addEventListener("mouseenter", () => {
							mainImg.style.transform = "scale(2)";
						});
						heroEl.addEventListener("mousemove", (e) => {
							const rect = heroEl.getBoundingClientRect();
							const x = ((e.clientX - rect.left) / rect.width) * 100;
							const y = ((e.clientY - rect.top) / rect.height) * 100;
							mainImg.style.transformOrigin = `${x}% ${y}%`;
						});
						heroEl.addEventListener("mouseleave", () => {
							mainImg.style.transform = "";
							mainImg.style.transformOrigin = "";
						});
					} else if (zoomMode === "click") {
						// Главное фото обёрнуто в <a href> (переход на страницу товара) —
						// в отличие от theme-base [data-product-hero] (не ссылка), здесь
						// нужен preventDefault, иначе клик одновременно откроет лайтбокс
						// И уйдёт по ссылке.
						heroEl.addEventListener("click", (e) => {
							e.preventDefault();
							const urls: string[] = [];
							if (mainImg.currentSrc || mainImg.src) urls.push(mainImg.currentSrc || mainImg.src);
							cfg.querySelectorAll<HTMLImageElement>("[data-cfg-thumb] img").forEach((im) => {
								const src = im.currentSrc || im.src;
								if (src && urls.indexOf(src) === -1) urls.push(src);
							});
							openProductLightbox(urls);
						});
					}
				}
			}
		}
	}

	hydrateFeaturedProduct();
	document.addEventListener("astro:page-load", hydrateFeaturedProduct);
</script>
