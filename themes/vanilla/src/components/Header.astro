		{!isSidebar && (
			<div data-search-results hidden aria-live="polite" class="mt-6 text-[var(--vanilla-dark)] aria-busy:opacity-60"></div>
		)}

		<nav class="mt-10 flex flex-col gap-5" aria-label="Основное меню" data-nav-drawer data-search-idle>
			{nav.map((link) => {
				const active = isActive(link);
				// Вложенные пункты в шторке vanilla не рисовались вовсе — как и в
				// инлайн-навигации. Рисуем их, как у остальных четырёх тем, и
				// раскрываем нажатием на стрелку (пункт 25 документа владельца).
				const subs = Array.isArray(link.submenu)
					? link.submenu.filter((s) => s && typeof s.label === "string" && s.label.trim() !== "")
					: [];
				return (
					<div class="flex flex-col gap-1" data-nav-group={subs.length > 0 ? "" : undefined}>
						{/* Пункт с вложенностью раскрывается ВСЕЙ СТРОКОЙ, стрелка одна
						    (пункт 28 документа владельца). Ссылкой он не рисуется: нажатие
						    уводило на страницу и закрывало меню вместо раскрытия. */}
						{subs.length > 0 ? (
							<button
								type="button"
