---
// «Мои заявки» (спека 118, T014). По образцу account/order.astro этой темы:
// тот же Layout и классы кабинета (account-*), логика — общая в
// packages/theme-base/runtime/requests-mine.ts. Вход — ссылка из письма
// (?token=<mineToken> → localStorage merfy_requests_token, из URL убирается);
// без токена — пустое состояние, БЕЗ редиректа на логин.
import Layout from '../../layouts/Layout.astro';

const shopId = "";
const apiUrl = import.meta.env.PUBLIC_MERFY_API_URL ?? "https://gateway.merfy.ru/api";
---
<Layout title="Мои заявки">
  <script is:inline define:vars={{ shopId, apiUrl }}>
    window.__MERFY_CONFIG__ = window.__MERFY_CONFIG__ || {
      shopId: shopId || "",
      apiUrl: apiUrl || "https://gateway.merfy.ru/api",
    };
  </script>

  <div class="account-page-container">
    <a href="/account" class="account-back-link">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      Вернуться назад
    </a>

    <div class="account-title">
      <h1>Мои заявки</h1>
      <span class="account-subtitle">Ответ придёт на почту и сюда</span>
    </div>

    <div id="requests-loading" style="color: rgb(var(--color-muted, 153 153 153)); font-family: var(--font-body);">Загрузка...</div>
    <div id="requests-empty" class="hidden" style="font-family: var(--font-body); color: rgb(var(--color-muted, 153 153 153));">Здесь появятся ваши заявки — ссылки приходят на почту</div>
    <div id="requests-list" class="hidden"></div>
  </div>

  <script>
    import { initRequestsMineList } from '../../../../../packages/theme-base/runtime/requests-mine';

    initRequestsMineList();
    document.addEventListener('astro:page-load', initRequestsMineList);
  </script>
</Layout>
