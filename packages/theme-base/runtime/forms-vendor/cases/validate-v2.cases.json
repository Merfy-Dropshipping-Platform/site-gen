      "contacts": { "name": "Анна", "email": "anna@mail", "phone": "+7 900 111-22-33", "consent": true },
      "filesCounts": { "f1": 1 },
      "expected": { "items": { "c-email": "Проверьте почту" } }
    },
    {
      "name": "телефон +7 (900) 111-22- — 9 цифр",
