---
// RequestForm — витринная секция «Форма заявки» (спека 118).
//
// Блок НЕ попадает в палитру конструктора: по спеке §5 секция встраивается
// в карточку товара (Product, проп requestsEnabled) вместо кнопки «В
// корзину», когда включены features.requests И у товара назначена форма.
// puckConfig — минимальный, только для анатомии блока (validateBlock).
//
// Самостоятельно (вне Product) блок рендерит статичную заглушку «Форма
// заявки (каркас)», порт стилей sf-* мокапа (инлайн <style> ниже,
// изолирован префиксом .rq-sf, собственные переменные --st-*) и ПУСТОЙ
// контейнер [data-request-form] — живую форму в него отрисовывает
// mountRequestsForm() из runtime/requests-form.ts (T013b, остров в
// Product.astro).
import { RequestFormClasses as C } from './RequestForm.classes';
import { RequestFormSfStyles } from './RequestForm.sf-styles';

interface Props {
  /**
   * Дескриптор формы @merfy/forms (спека 118 §6: 10 типов полей, условие
   * показа, лимиты, телефон, кнопка, сообщение). Заглушка показывает только
   * факт его наличия — живой рендер делает mountRequestsForm().
   */
  descriptor?: unknown;
  /** Товар, к которому относится заявка. */
  productId?: string;
  /** Условие видимости секции: features.requests && форма назначена. */
  enabled?: boolean;
}

const { descriptor, productId, enabled } = Astro.props as Props;
const hasDescriptor = descriptor !== undefined && descriptor !== null;
---
{enabled !== false && (
  <section
    class:list={[C.root]}
    data-block="request-form"
    data-request-product-id={productId ?? ''}
    data-has-descriptor={hasDescriptor ? 'true' : 'false'}
  >
    <div class={C.container}>
      <div class={C.inner}>
        <h2 class={C.heading}>Форма заявки (каркас)</h2>
        <p class={C.note}>
          Каркас секции: живую форму по дескриптору отрисовывает
          mountRequestsForm() из runtime/requests-form.ts в контейнер ниже.
        </p>
        {/* Пустой контейнер формы: класс rq-sf включает --st-* переменные
            мокапа; mountRequestsForm() наполнит его sf-разметкой. */}
        <div
          class={C.formShell}
          data-request-form
          data-request-form-product-id={productId ?? ''}
        ></div>
      </div>
    </div>
  </section>
)}
<style is:inline set:html={RequestFormSfStyles} />
