---
/**
 * FeaturedProduct — секция «Товар» на главной (spec 111-flux-constructor-live-
 * markup, Task 5). Отсутствовала на локальной главной — оживлена с нуля.
 *
 * Источник DOM/классов (SOURCE.lock.json, pinned upstream commit
 * e29b70920ffe4469744386b51b9c8ee0fcf68bd0):
 *   - src/components/sections/FeaturedProduct.astro — тонкая обёртка
 *     `<section id="featured">` вокруг `<ProductConfigurator product={demo} />`;
 *   - src/components/products/ProductConfigurator.astro — РЕАЛЬНАЯ разметка
 *     (галерея слева/инфо справа desktop `hidden md:flex`, карусель mobile
 *     `flex md:hidden`, счётчик, кнопки «Добавить в корзину»/«Купить сейчас»,
 *     аккордеон «Описание», «Поделиться»). Файл не существовал в этом
 *     репозитории как отдельный компонент — тело ProductConfigurator слито
 *     СЮДА (та же разметка/классы 1:1), т.к. бриф Task 5 просит создать ровно
 *     один новый файл, а не пару.
 *
 * Что ИЗМЕНЕНО относительно пина (принцип «Оживление секции» — только точки
 * данных, не разметка):
 *   - demo `catalogProducts[0]` заменён на канонический `Product` (theme-base
 *     `packages/theme-base/blocks/Product/Product.puckConfig.ts`): productId/
 *     layout/photoPosition/text/title/price/quantity/buttons/description/
 *     share/dynamicButton/colorScheme/padding;
 *   - добавлена подсекция «Варианты» (variants) — ЕЁ НЕ БЫЛО в пине
 *     (комментарий верстальщиков: «Без выбора цвета/памяти — цвет задаётся
 *     товаром»), но канонический контракт Product требует variants. Взята
 *     разметка/стиль установленного flux-паттерна PDP
 *     (`FluxProductDetail.astro` + `lib/storefront-hydrate.ts`
 *     `renderVariantGroupsHtml`), НЕ придумана заново — переиспользована
 *     готовая функция (чёрно-белые чипы, font-manrope — тот же вид, что уже
 *     на живом PDP).
 *   - плейсхолдер пустого состояния = Figma 1:19335 (ТОТ ЖЕ контракт, что
 *     `FluxProductDetail.astro`: /placeholders/sweater-blue-large.svg,
 *     «Новая коллекция!», «Товар», «2 500 ₽») — НЕ upstream demo-товар
 *     («M Phone 17» и т.п.), это установленный flux-паттерн gating.
 *   - quantity/add-to-cart используют существующий cart runtime
 *     (`data-add-to-cart` → глобальный делегат `initCartUI` из
 *     `lib/cart.ts` → `lib/nt-cart-flux.ts`, подключён в Layout.astro — сам
 *     клик обрабатывать не нужно).
 *   - GSAP-анимация аккордеона (upstream) заменена на простой class-toggle:
 *     ни одна другая секция flux не импортирует gsap напрямую в компонент
 *     (только `lib/animations.ts` — глобальный `[data-reveal]` scroll-reveal,
 *     который эта секция получает бесплатно через тот же атрибут на
 *     контейнере, без импорта).
 *   - "uid" проп ProductConfigurator (никогда не читался скриптом по
 *     значению, только как маркер-селектор) убран как мёртвый — заменён на
 *     обычные boolean data-атрибуты.
 *
 * SSR-резолв реального товара (siteId+productId → sites-service
 * storefront-data) — паритет Popular/Collections/theme-base Product.astro:
 * Astro Container (превью-рендер `/preview/block`) не исполняет клиентскую
 * module-гидрацию ниже, поэтому без SSR превью выбранного товара показывало
 * бы плейсхолдер даже при реальном productId. Живой сайт освежает данные
 * клиентским скриптом (loadRealProducts, тот же каскад источников, что
 * Popular/FluxProductDetail).
 */
import NtIcon from "@merfy-dropshipping-platform/design-systems-theme/components/ui/NtIcon.astro";
import FluxPicture from "../img/FluxPicture.astro";
import {
	deriveVariantGroups,
	findCombination,
	renderVariantGroupsHtml,
	renderVariantSelectsHtml,
	formatPrice,
	productHref,
	resolveComboPricing,
	toPriceNumber,
} from "../../lib/storefront-hydrate";

const p = Astro.props as Record<string, any>;
const id = p.id;
const siteId = typeof p.siteId === "string" ? p.siteId : "";

// Figma 1:19335 — ТОТ ЖЕ контракт пустого состояния, что FluxProductDetail.astro
// (PDP). Товар не выбран мерчантом / не резолвится → рендерим ЭТОТ дизайн, а не
// upstream demo-товар верстальщиков.
const PLACEHOLDER_IMAGE = "/placeholders/sweater-blue-large.svg";
const PLACEHOLDER_BRAND = "Новая коллекция!";
const PLACEHOLDER_NAME = "Товар";
const PLACEHOLDER_PRICE = "2 500 ₽";

const productIdRef = typeof p.productId === "string" ? p.productId.trim() : "";

// Layout switch (Figma 648:55733 семантика, канон theme-base Product.puckConfig).
// Все четыре значения панели работают (галерейные ветки ниже):
//   carousel/дефолт — вёрстка как есть (главное фото + ряд миниатюр снизу);
//   stacked — миниатюры СЕТКОЙ 3×N; split — миниатюры КОЛОНКОЙ слева;
//   two-columns — все фото равной сеткой 2×N без главного.
// Ранее layout нормализовался до stacked|carousel — «Макет» молчал на 2 из 4
// значений, и настройка выглядела мёртвой.
const layoutRaw = typeof p.layout === "string" ? p.layout : "";
const layout =
	layoutRaw === "stacked" || layoutRaw === "split" || layoutRaw === "two-columns"
		? layoutRaw
		: "carousel";
const photoPosition = p.photoPosition === "right" ? "right" : "left";
const photoOnLeft = photoPosition !== "right";

// — Размер (canon "size", theme-base Product.puckConfig "Размер"). Пин фиксирует
//   ОДИН масштаб: главное фото 652×652 desktop + миниатюра 120px. «Размер» не
//   переструктурирует DOM/классы (принцип файла — 1:1 разметка из пина) — он
//   параметризует ИМЕННО эти два уже существующих utility-класса (lg:w-[…] /
//   md:size-[…]) через CSS-переменную на корне секции (паттерн theme-base
//   Product.astro sizeVarsStyle). medium сохраняет пиновые 652/120 БЕЗ
//   изменений — нулевая регрессия дефолтного рендера.
const sizeRaw = typeof p.size === "string" ? p.size : "";
const productSize: "small" | "medium" | "large" =
	sizeRaw === "small" || sizeRaw === "large" ? sizeRaw : "medium";
const MAIN_IMAGE_PX = { small: 520, medium: 652, large: 760 } as const;
const THUMB_PX = { small: 96, medium: 120, large: 144 } as const;
const sizeVarsStyle = `--product-main-image-size:${MAIN_IMAGE_PX[productSize]}px;--product-thumb-size:${THUMB_PX[productSize]}px;`;

// — Увеличение (canon "zoomMode": click/hover/none). ПРОВЕРЕНО построчно против
//   пинового источника (fetched e29b70920ffe4469744386b51b9c8ee0fcf68bd0,
//   src/components/products/ProductConfigurator.astro) И против установленного
//   flux-паттерна PDP (FluxProductDetail.astro, оба места читались целиком для
//   review Task 5 Finding 2): НИ ОДНО из двух не содержит НИКАКОГО
//   zoom-механизма — ни hover-scale CSS/transform, ни click-to-expand lightbox.
//   Пиновый скрипт galereи даёт только thumb-swap/thumbs-track-scroll/mobile
//   carousel — zoom отсутствует как класс фичи во всей теме flux, не только в
//   этой секции. Изобретать lightbox/hover-zoom с нуля здесь означало бы
//   дописывать поведение, которого нет в пине — прямое нарушение принципа
//   файла «разметка/поведение 1:1 из пина, меняются только данные». Поэтому
//   zoomMode — ЛЕГИТИМНЫЙ no-op: значение читается и прокидывается на корень
//   секции (`data-zoom-mode`) для будущей проводки, но интерактивность не
//   включает. Задокументировано здесь + в фикс-репорте (не «молча мёртвое»).
const zoomModeRaw = typeof p.zoomMode === "string" ? p.zoomMode : "";
const zoomMode: "click" | "hover" | "none" =
	zoomModeRaw === "click" || zoomModeRaw === "none" ? zoomModeRaw : "hover";

// SSR-резолв: товар ВЫБРАН мерчантом → тянем реальные данные ПРЯМО в статике
// (паритет Popular.astro/Collections.astro SITES_INTERNAL_BASE fetch).
let realProduct: any = null;
if (productIdRef && siteId) {
	try {
		const base = (import.meta as any).env?.SITES_INTERNAL_BASE ?? "http://localhost:3114";
		const qs = `?product=${encodeURIComponent(productIdRef)}`;
		const res = await fetch(`${base}/api/sites/${siteId}/storefront-data${qs}`).catch(() => null);
		if (res && res.ok) {
			const data: any = await res.json();
			realProduct =
				data?.product ??
				(Array.isArray(data?.products)
					? data.products.find(
							(x: any) => x && (x.id === productIdRef || x.slug === productIdRef || x.handle === productIdRef),
						) ?? data.products[0] ?? null
					: null);
		}
	} catch {
		realProduct = null;
	}
}
const isPlaceholder = !realProduct;

// — Текст (canon "text" — брендлайн над названием). Мерчантский текст ВСЕГДА
//   приоритетнее плейсхолдера/реального brand (паритет theme-base Product.astro
//   textContent ?? badge?.text, brandText = textContent || view.brand). —
const textContent = (typeof p.text === "string" ? p.text : p.text?.content) ?? p.badge?.text ?? "";
const displayBrand =
	textContent || (isPlaceholder ? PLACEHOLDER_BRAND : realProduct.collection || realProduct.brand || realProduct.vendor || "");

const displayName = isPlaceholder ? PLACEHOLDER_NAME : realProduct.name || realProduct.title || PLACEHOLDER_NAME;

// — Варианты: peреиспользуем storefront-hydrate.ts (без дублирования логики).
const combos: any[] = isPlaceholder
	? []
	: Array.isArray(realProduct.variantCombinations)
		? realProduct.variantCombinations
		: Array.isArray(realProduct.variants)
			? realProduct.variants
			: [];
const hasVariants = combos.length > 0;
const variantGroups = hasVariants ? deriveVariantGroups(combos) : [];
let selectedOptions: Record<string, string> = {};
if (hasVariants) {
	const firstAvailable = combos.find((c: any) => c && c.available !== false) ?? combos[0];
	selectedOptions = { ...(firstAvailable.options || {}) };
}
const activeCombo = hasVariants ? findCombination(combos, selectedOptions) : null;
// Figma 1:21431 — «Стиль» (variants.displayStyle): button = чипы (дефолт),
// list = выпадающий <select> (canon theme-base Product.puckConfig; "Вариации"
// shape circle/square/none — форма свотча — здесь не применима: и upstream
// pin, и переиспользуемый render*Html не рисуют цветные свотчи, только
// текстовые чипы/список, поэтому shape не влияет на рендер этой секции).
const variantsDisplayStyle = p.variants?.displayStyle === "list" ? "list" : "button";
const variantsHtml = hasVariants
	? variantsDisplayStyle === "list"
		? renderVariantSelectsHtml(variantGroups, selectedOptions)
		: renderVariantGroupsHtml(variantGroups, selectedOptions)
	: "";

function pickOpt(opts: Record<string, string> | undefined, keys: string[]): string {
	for (const k of keys) if (opts && opts[k] != null) return opts[k];
	return "";
}
const cartColor = pickOpt(selectedOptions, ["Цвет", "Color"]);
const cartSize = pickOpt(selectedOptions, ["Размер", "Size"]);

// — Цена: активная комбинация (если положительная) перебивает базовую цену
//   товара (паритет theme-base/FluxProductDetail applyCombo). Единая формула —
//   `resolveComboPricing` (storefront-hydrate.ts), импортируется И сюда (SSR),
//   И в клиентский `<script>` applyCombo() ниже (review Task 5, Finding 3a:
//   раньше формула была продублирована чуть по-разному в двух местах). —
const { price: comboPriceRaw, oldPrice: comboOldRaw } = resolveComboPricing(activeCombo, realProduct);

const displayPrice = isPlaceholder ? PLACEHOLDER_PRICE : formatPrice(comboPriceRaw) || PLACEHOLDER_PRICE;
const displayOldPrice = isPlaceholder ? "" : formatPrice(comboOldRaw);

const priceNumForBadge = toPriceNumber(comboPriceRaw);
const oldNumForBadge = toPriceNumber(comboOldRaw);
const salePercentText =
	!isPlaceholder && oldNumForBadge && priceNumForBadge && oldNumForBadge > priceNumForBadge
		? `-${Math.round(((oldNumForBadge - priceNumForBadge) / oldNumForBadge) * 100)}%`
		: "";
const showBadges = !!salePercentText;

// — Галерея. thumbs = первые 5 фото ВКЛЮЧАЯ главное (буквально как в пине:
//   `const [mainImage] = gallery; const thumbs = gallery.slice(0, 5);`). —
const realImages: string[] = isPlaceholder
	? []
	: Array.isArray(realProduct.images)
		? realProduct.images.filter((x: unknown) => typeof x === "string" && x)
		: [];
const galleryImages = realImages.length > 0 ? realImages : [PLACEHOLDER_IMAGE];
const [mainImage] = galleryImages;
const thumbs = galleryImages.slice(0, 5);
const href = isPlaceholder ? "/catalog" : productHref(realProduct);

// «Макет» — семантика theme-base Product (Figma 648:55733), натянутая на
// вёрстку flux. Раньше работал только stacked (сетка миниатюр); split и
// two-columns не отличались от дефолта — настройка на 2 из 4 значений молчала.
//   carousel/дефолт — вёрстка как есть: главное фото + ряд миниатюр снизу;
//   stacked        — главное фото + СЕТКА миниатюр снизу;
//   split          — миниатюры КОЛОНКОЙ слева от главного фото;
//   two-columns    — все фото равной сеткой 2×N, без главного.
const isSplit = layout === "split";
const isTwoCols = layout === "two-columns";
const thumbsTrackCls =
	layout === "stacked"
		? "grid grid-cols-3 gap-3"
		: isSplit
			? "flex flex-col items-start gap-3"
			: "no-scrollbar flex flex-1 items-center gap-3 overflow-x-auto";
const galleryColCls = isSplit
	? "flex w-full flex-row-reverse items-start gap-4 lg:w-[var(--product-main-image-size,652px)] lg:min-w-0"
	: "flex w-full flex-col gap-4 lg:w-[var(--product-main-image-size,652px)] lg:min-w-0";

// — Количество: canon quantity.enabled (object) + плоский legacy-алиас
//   showQuantity (dual-support паттерн, единый для секций flux). —
const quantityEnabledRaw =
	p.quantity && typeof p.quantity === "object" ? p.quantity.enabled : (p.showQuantity ?? p.quantity);
const quantityVisible = quantityEnabledRaw !== false && quantityEnabledRaw !== "false";

// — Кнопки: «Основная» (buttons.addToCart.text, пусто = скрыть) + «Динамическая»
//   (dynamicButton toggle, дефолт показана) — канон theme-base Product.astro. —
const addBtnTextRaw = p.buttons?.addToCart?.text;
const addBtnText = addBtnTextRaw === undefined ? "Добавить в корзину" : addBtnTextRaw;
const showAddToCart = String(addBtnText).trim() !== "";
const buyBtnText = "Купить сейчас";
const dynRaw = p.dynamicButton && typeof p.dynamicButton === "object" ? p.dynamicButton.enabled : p.dynamicButton;
const showBuyNow = dynRaw !== "false" && dynRaw !== false;

// — Описание: canon disabledHint-поле (контент ТОЛЬКО из реального товара,
//   мерчант его не редактирует) + visualConfig.showDescription/showDescription
//   плоский алиас (дефолт true — DEFAULT_VISUAL_CONFIG.showDescription). —
const showDescRaw =
	p.visualConfig && typeof p.visualConfig.showDescription === "boolean" ? p.visualConfig.showDescription : p.showDescription;
const descriptionEnabled = showDescRaw !== false;
const description = isPlaceholder ? "" : realProduct.description || realProduct.metaDescription || "";
const hasDescription = descriptionEnabled && !isPlaceholder && !!description.trim();

const shareText = typeof p.share?.text === "string" && p.share.text.trim() ? p.share.text : "Поделиться";

// — Cart-атрибуты (declarative, глобальный делегат initCartUI/lib/cart.ts). —
const cartProductId = (realProduct && realProduct.id) || productIdRef || "";
const addToCartAttrs = {
	"data-add-to-cart": true,
	"data-product-id": cartProductId,
	"data-name": displayName,
	"data-price": displayPrice,
	"data-old-price": displayOldPrice || "",
	"data-image": mainImage,
	"data-variant-color": cartColor,
	"data-variant-size": cartSize,
	"data-variant-combination-id": activeCombo?.id || "",
	"data-quantity": "1",
};

// — Цветовая схема + отступы (канон Product.puckConfig colorScheme/padding,
//   паттерн CartSection.astro/Footer flux). —
const paddingStyle = p.padding
	? `padding-top:${Math.min(Number(p.padding.top) || 0, 160)}px;padding-bottom:${Math.min(Number(p.padding.bottom) || 0, 160)}px;`
	: undefined;
const schemeClass = `color-scheme-${String(p.colorScheme ?? 2).replace("scheme-", "")}`;
---

<section
	id="featured"
	class:list={["w-full bg-white", schemeClass]}
	aria-label={displayName}
	data-puck-component-id={id}
	data-block="featured-product"
	data-site-id={siteId}
	data-product-id={cartProductId}
	data-zoom-mode={zoomMode}
	style={sizeVarsStyle}
>
	<div class:list={["flux-container", paddingStyle ? "" : "py-10 md:py-16"]} style={paddingStyle} data-reveal>
		<!-- ============================= DESKTOP (≥768px) ============================= -->
		<div
			class:list={[
				"hidden w-full flex-col items-start gap-8 md:flex lg:flex-row lg:justify-between lg:gap-10",
				photoOnLeft ? "" : "lg:flex-row-reverse",
			]}
			data-nt="product-configurator"
		>
			<!-- Изображения -->
			<div class={galleryColCls}>
				{isTwoCols ? (
					/* two-columns: все фото равной сеткой, главного нет. Первому
					   оставляем data-cfg-main — live-скрипт свапа null-безопасен,
					   но так смена товара обновляет и эту раскладку. */
					<div class="grid w-full grid-cols-2 gap-4">
						{galleryImages.map((img, i) => (
							<a href={href} class="relative block aspect-square w-full overflow-hidden rounded-[8px] bg-[#F5F5F5]" aria-label={displayName}>
								{i === 0 ? (
									<FluxPicture src={img} alt={displayName} width="326" height="326" loading="eager" class="absolute inset-0 h-full w-full object-cover" data-cfg-main />
								) : (
									<FluxPicture src={img} alt={displayName} width="326" height="326" loading="lazy" class="absolute inset-0 h-full w-full object-cover" />
								)}
							</a>
						))}
					</div>
				) : (
				<>
				<a href={href} class:list={["relative block aspect-square w-full overflow-hidden rounded-[8px] bg-[#F5F5F5]", isSplit && "min-w-0 flex-1"]} aria-label={displayName}>
					{isPlaceholder ? (
						<img src={mainImage} alt={displayName} width="652" height="652" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" data-cfg-main />
					) : (
						<FluxPicture src={mainImage} alt={displayName} width="652" height="652" loading="eager" fetchpriority="high" class="absolute inset-0 h-full w-full object-cover" data-cfg-main />
					)}
				</a>
				{thumbs.length > 1 && !isTwoCols && (
					<div class:list={[isSplit ? "flex flex-col gap-3" : "flex items-center gap-3"]}>
						<div class={thumbsTrackCls} data-cfg-thumbs-track>
							{thumbs.map((img, i) => (
								<button
									type="button"
									class:list={[
										"size-[88px] shrink-0 overflow-hidden rounded-[8px] bg-[#F5F5F5] transition-opacity hover:opacity-90 md:size-[var(--product-thumb-size,120px)]",
										i === 0 ? "border border-solid border-[#1e2952]/50" : "",
									]}
									data-cfg-thumb
									data-image={img}
									aria-label="Показать изображение"
								>
									<FluxPicture src={img} alt={displayName} width="120" height="120" loading="eager" class="h-full w-full object-cover" />
								</button>
							))}
						</div>
						{thumbs.length >= 5 && layout !== "stacked" && !isSplit && (
							<button type="button" class="flex size-11 shrink-0 items-center justify-center transition-opacity hover:opacity-70" data-cfg-thumbs-next aria-label="Следующие изображения">
								<NtIcon name="arrow-slide-right" sizeClass="size-6" />
							</button>
						)}
					</div>
				)}
				</>
				)}
			</div>

			<!-- Блок -->
			<div class="flex w-full flex-col gap-10 lg:w-[628px] lg:min-w-0">
				<!-- Текст -->
				<div class="flex flex-col gap-2">
					{displayBrand && (
						<p
							class="font-roboto-flex text-[14px] font-light uppercase leading-normal text-[#999999] md:text-[16px]"
							data-puck-subsection-parent={id}
							data-puck-subsection-index="100"
							data-puck-subsection-field="text"
						>
							{displayBrand}
						</p>
					)}
					<h2
						class="font-roboto-flex text-[20px] font-light uppercase leading-normal text-[#000000] md:text-[24px]"
						data-cfg-name
						data-puck-subsection-parent={id}
						data-puck-subsection-index="101"
						data-puck-subsection-field="title"
					>
						{displayName}
					</h2>
					<div class="flex items-center gap-2" data-puck-subsection-parent={id} data-puck-subsection-index="102" data-puck-subsection-field="price">
						<span class="font-roboto-flex text-[18px] font-light leading-normal text-[#000000] md:text-[20px]" data-cfg-price>
							{displayPrice}
						</span>
						<span class="font-roboto-flex text-[15px] font-light leading-normal text-[#999999] line-through md:text-[16px]" data-cfg-oldprice hidden={!displayOldPrice}>
							{displayOldPrice}
						</span>
					</div>
				</div>

				<!-- Варианты (НЕ было в pin — добавлено по канон-контракту Product, стиль
				     переиспользован из установленного PDP-паттерна renderVariantGroupsHtml). -->
				<div
					class="flex flex-col gap-4"
					data-cfg-variants
					data-variants-style={variantsDisplayStyle}
					data-puck-subsection-parent={id}
					data-puck-subsection-index="103"
					data-puck-subsection-field="variants"
					hidden={!hasVariants}
					set:html={variantsHtml}
				/>

				<!-- Счётчик -->
				{quantityVisible && (
					<div class="inline-flex w-fit items-center gap-3" data-cfg-qty data-puck-subsection-parent={id} data-puck-subsection-index="104" data-puck-subsection-field="quantity">
						<button type="button" class="flex size-11 items-center justify-center transition-opacity hover:opacity-60" aria-label="Уменьшить количество" data-cfg-qty-dec>
							<NtIcon name="minus" sizeClass="size-4" />
						</button>
						<span class="min-w-6 text-center font-roboto-flex text-[16px] font-light leading-none text-[#1e2952]" data-cfg-qty-value>1</span>
						<button type="button" class="flex size-11 items-center justify-center transition-opacity hover:opacity-60" aria-label="Увеличить количество" data-cfg-qty-inc>
							<NtIcon name="plus" sizeClass="size-4" />
						</button>
					</div>
				)}

				<!-- Кнопки -->
				{(showAddToCart || showBuyNow) && (
					<div class="flex flex-col gap-3" data-puck-subsection-parent={id} data-puck-subsection-index="105" data-puck-subsection-field="buttons">
						{showAddToCart && (
							<button
								type="button"
								data-cfg-add
								{...addToCartAttrs}
								class="inline-flex h-14 w-full items-center justify-center rounded-[4px] border border-solid border-[#1e2952] bg-white px-6 font-roboto-flex text-[16px] font-light uppercase leading-none text-[#1e2952] transition-colors hover:bg-[#1e2952] hover:text-white"
							>
								{addBtnText}
							</button>
						)}
						{showBuyNow && (
							<button
								type="button"
								data-cfg-buy
								class="inline-flex h-14 w-full items-center justify-center rounded-[4px] bg-[#1e2952] px-6 font-roboto-flex text-[16px] font-light uppercase leading-none text-white transition-opacity hover:opacity-90"
							>
								{buyBtnText}
							</button>
						)}
					</div>
