---
// Страница «Заказы» — ШЕЛЛ для системы секций (page-orders).
// Тело вынесено в Puck-секцию «Заказы»
// (themes/flux/src/components/sections/OrdersSection.astro).
// composeContentPagesIntoDist пересаживает секции ревизии page-orders в этот
// шелл (дефолт [OrdersSection] приходит из packages/theme-flux/pages/orders.json
// через lazy-seed). Страницу теперь можно собирать из секций, как главную.
import Layout from "../../layouts/Layout.astro";
---

<Layout title="Мои заказы" promo={false}>
	<!-- Секция «Заказы» (+ добавленные секции) вставляются composeContentPagesIntoDist -->
</Layout>
