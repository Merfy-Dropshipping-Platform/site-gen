---
// Страница корзины — ШЕЛЛ для системы контент-страниц (page-cart kind:content).
// Логика корзины вынесена в Puck-секцию CartSection
// (themes/flux/src/components/sections/CartSection.astro). composeContentPagesIntoDist
// пересаживает секции ревизии page-cart в <main> этого шелла (дефолт [CartSection]
// приходит из lazy-seed / revision-migrations). Корзину теперь можно двигать/
// настраивать и добавлять вокруг другие секции, как на главной.
import Layout from "../layouts/Layout.astro";
---

<Layout title="Корзина" description="Ваша корзина — Flux">
	<section class="mx-auto w-full max-w-[1920px] px-4 py-16 md:px-20 2xl:px-80">
		<!-- Секция «Корзина» (+ добавленные секции) вставляются composeContentPagesIntoDist -->
	</section>
</Layout>
