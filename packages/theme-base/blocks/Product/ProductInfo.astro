---
/**
 * ProductInfo — brand + title primitive.
 *
 * Название печатается РОВНО так, как мерчант завёл его в админке. Жалоба
 * тестировщика 14.09: «Капс в названии товара. Ожидаемый результат: тянет с
 * админки название, а не сам пишет капсом». До правки здесь жил проп
 * `variant`: `uppercase-title` (дефолт, и он же был вбит в `Product.astro`)
 * добавлял `uppercase tracking-wide`, `normal-title` — нет. Ни один вызов
 * второе значение не передавал, то есть «вариант» был просто капсом для всех
 * четырёх тем общего порта (rose/vanilla/satin/bloom). Тот же класс, что
 * `section-text-case.spec.ts`: `text-transform: uppercase` поверх чужих
 * данных — подмена ввода. Проп снят как мёртвый.
 *
 * Brand line is shown when present (non-empty). Красится приглушённым ТЕКСТОМ
 * схемы (--color-text/60), как старая цена и описание: до 13.09 здесь стоял
 * --color-muted, которого нет в редакторе схемы. Строка эта — параметр «Текст»
 * подпанели (T4): пока он не доезжал до порта, серый никто не замечал.
 *
 * «Глаз» конструктора: бренд и название — РАЗНЫЕ именованные параметры секции
 * «Товар» (`text` и `title` в NAMED_SUBSECTIONS). Поэтому у каждого свой узел с
 * `data-puck-subsection-field` (100 / 101 — те же индексы, что у порта flux) и
 * свой флаг скрытия. Обёртка `[data-product-info]` сохранена: по ней
 * инлайн-скрипт Product.astro находит `h1` при гидрации.
 */
// Брендлайн — это поле мерчанта «Текст» (Product.text): кнопки «Ж»/«К» пишут
// туда <strong>/<em>, а Astro экранирует {brand} → начертание печаталось
// сырыми тегами (баг-репорт тестера 2026-09-13, K4).
import { sanitizeInline } from '../../runtime/rich-text';

type InfoField = 'text' | 'title';

interface Props {
  brand?: string | null;
  title: string;
  /** id секции — для data-puck-subsection-parent (подсветка выбора в превью). */
  blockId?: string;
  hideBrand?: boolean;
  hideTitle?: boolean;
  /**
   * Какие строки и в каком порядке рисует эта обёртка — порядок из
   * перетаскивания в конструкторе (`props.fieldOrder`, Product.astro). Без
   * пропа — бренд, затем название, как раньше.
   */
  fields?: readonly InfoField[];
}

const {
  brand,
  title,
  blockId,
  hideBrand = false,
  hideTitle = false,
  fields = ['text', 'title'],
} = Astro.props as Props;
---
<div class="flex flex-col gap-2 w-full" data-product-info>
  {fields.map((field) => (
  <Fragment>
  {field === 'text' && brand && !hideBrand && (
    <span
      class="[font-family:var(--font-body)] text-[length:var(--product-text-size,16px)] text-[rgb(var(--color-text))]/60"
      data-puck-subsection-parent={blockId}
      data-puck-subsection-index="100"
      data-puck-subsection-field="text"
      set:html={sanitizeInline(brand)}
    ></span>
  )}
  {field === 'title' && !hideTitle && (
    <h1
      class="[font-family:var(--font-heading)] text-[length:var(--product-title-size,24px)] leading-tight text-[rgb(var(--color-heading))] m-0 normal-case"
      data-puck-subsection-parent={blockId}
      data-puck-subsection-index="101"
      data-puck-subsection-field="title"
    >{title}</h1>
  )}
  </Fragment>
  ))}
</div>
