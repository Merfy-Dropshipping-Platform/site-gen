exports[`снимки секций — rose CartSummary — снимок разметки 1`] = `"<section data-puck-component-id="CartSummary-1" data-block="cart-summary" data-cart-summary class="w-full bg-[rgb(var(--color-bg,255_255_255))] px-4 sm:px-5 md:px-10 lg:px-16 xl:px-20 2xl:px-[280px] color-scheme-1" style="padding-top:0px;padding-bottom:80px;"> <!-- data-rc-preserve: при reconcile-морфе превью обёртка обновляется (отступы/схема), а контент сводки пропускается → итог/видимость не сбрасываются и не мигают. Видимость самой секции (hidden при пустой на live) ставит JS, а не SSR — иначе морф сбросил бы её к hidden и сводка исчезла бы в превью при смене настроек. --> <div id="rc-cart-summary-content" data-rc-preserve class="mx-auto flex w-full max-w-[1320px] flex-col items-end gap-4 sm:gap-5"> <p class="max-w-md text-right font-manrope text-[12px] font-light leading-[1.5] text-[rgb(var(--color-muted,153_153_153))] sm:text-[13px] md:text-[14px]"> Налоги, скидки и стоимость доставки рассчитываются при оформлении заказа </p> <div class="cart-summary-totals flex w-full flex-wrap items-baseline justify-end gap-x-3 gap-y-1 sm:gap-x-4"> <span class="font-manrope text-[14px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))] sm:text-[16px] md:text-[18px]">Итого</span> <span data-cart-summary-total class="font-manrope text-[18px] font-normal leading-normal text-[rgb(var(--color-text,0_0_0))] sm:text-[20px] md:text-[24px]">0 ₽</span> </div> <button type="button" data-action="checkout" class="cart-checkout-btn inline-flex h-12 w-full max-w-[320px] items-center justify-center rounded-[var(--radius-button,6px)] !bg-[rgb(var(--color-button-bg,0_0_0))] px-6 font-manrope text-[14px] font-normal leading-normal !text-[rgb(var(--color-button-text,255_255_255))] transition-opacity hover:opacity-95 sm:w-auto sm:min-w-[200px] sm:text-[16px]"> Оформить заказ </button> </div> </section> <script type="module">if(!window["__merfy_hoisted_themes_rose_src_components_sections_CartSummary_astro_0"]){window["__merfy_hoisted_themes_rose_src_components_sections_CartSummary_astro_0"]=1; // packages/theme-base/runtime/cart-added-modal.ts var CART_SCHEME_TOKENS = [ "--color-bg", "--color-bg-alt", "--color-surface", "--color-heading", "--color-text", "--color-accent", "--color-muted", "--color-button-bg", "--color-button-text", "--color-button-border", "--color-button-bg-hover", "--color-button-text-hover", "--color-button-secondary-bg", "--color-button-secondary-text", "--color-button-secondary-border", "--color-button-secondary-bg-hover", "--color-button-secondary-text-hover", "--color-button-2-bg", "--color-button-2-text", "--color-button-2-border" ]; var MODAL = "[data-cart-added-modal]"; var CARD = "[data-cart-modal-card]"; var CART_ANCHORS = '[data-cart-open], a[data-action="cart"]'; var ANCHOR_GAP = 12; var ANCHOR_MIN_SIDE = 16; var anchorToCartIcon = (modal) => { const boxes = Array.from(document.querySelectorAll(CART_ANCHORS)).map((node) => node.getBoundingClientRect()).filter((rect2) => rect2.width > 0 && rect2.height > 0); if (boxes.length === 0) { modal.style.removeProperty("--cart-modal-top"); modal.style.removeProperty("--cart-modal-right"); return; } const rect = boxes.reduce((widest, box) => box.right > widest.right ? box : widest); const card = modal.querySelector(CARD); const cardWidth = card?.getBoundingClientRect().width ?? 0; const axis = rect.left + rect.width / 2; const right = Math.max(ANCHOR_MIN_SIDE, window.innerWidth - axis - cardWidth / 2); const top = Math.max(ANCHOR_MIN_SIDE, rect.bottom + ANCHOR_GAP); modal.style.setProperty("--cart-modal-top", \`\${Math.round(top)}px\`); modal.style.setProperty("--cart-modal-right", \`\${Math.round(right)}px\`); }; var isAbsoluteUrl = (v) => /^(https?:)?\\/\\//i.test(v) || v.startsWith("data:"); function resolveCartSchemeSource(origin) { const root = document.documentElement; const cartType = getComputedStyle(root).getPropertyValue("--cart-type").trim().replace(/['"]/g, ""); if (cartType !== "page") { const dr