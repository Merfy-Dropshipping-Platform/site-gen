{
  "$comment": "Сгенерировано командой pnpm generate пакета секций — руками не править.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "groups": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      }
    },
    "names": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kinds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "string",
                "text",
                "richtext",
                "url",
                "image",
                "image-pair",
                "video",
                "select",
                "radio",
                "toggle",
                "range",
                "alignment",
                "color-scheme",
                "padding",
                "menu",
                "product",
                "collection",
                "blog",
                "policy",
                "hint"
              ]
            }
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "about": {
            "type": "string",
            "minLength": 3
          },
          "asks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "kinds",
          "label",
          "group",
          "about",
          "asks"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "v",
    "groups",
    "names"
  ],
  "additionalProperties": false
}
