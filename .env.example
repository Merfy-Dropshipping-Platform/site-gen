NODE_ENV=development
LOG_LEVEL=info
SERVICE_NAME=sites-service
PORT=3114
RABBITMQ_URL=amqp://rabbitmq:password@localhost:5672
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/sites_service

# Coolify Configuration
# Set COOLIFY_MODE=http to enable real Coolify API calls (production)
COOLIFY_MODE=mock
COOLIFY_API_URL=http://localhost:8000
COOLIFY_API_TOKEN=
COOLIFY_SERVER_UUID=
COOLIFY_PROJECT_UUID=
COOLIFY_ENVIRONMENT_NAME=production
COOLIFY_WILDCARD_DOMAIN=merfy.ru

# Wildcard-домен витрин: публичный URL сайта = https://<slug>.<SITES_WILDCARD_DOMAIN>
# Используется sites.service (publish), s3.service и traefik-router.
# Дефолт (если переменная не задана) — merfy.ru.
SITES_WILDCARD_DOMAIN=merfy.ru

# API gateway, который вшивается в статику витрин (astro.builder + scaffold-builder).
# Дефолт — https://gateway.merfy.ru/api
API_GATEWAY_URL=https://gateway.merfy.ru/api

# analytics-collector: адрес tracker.js/loader.js, вшиваемых в каждую витрину.
# Дефолт — https://iowcg0sw4wsoo0s4k8g0ws0o.176.57.218.121.sslip.io
ANALYTICS_COLLECTOR_URL=https://iowcg0sw4wsoo0s4k8g0ws0o.176.57.218.121.sslip.io

# Domain Service (RPC primary, HTTP fallback)
# DOMAIN_SERVICE_URL is used only when RPC is unavailable
DOMAIN_SERVICE_URL=http://localhost:3115
DOMAIN_RPC_TIMEOUT=10000

# IP address for DNS A-record (used in external domain attach instructions)
MERFY_ZONE_IP=176.57.218.121
# Включение/выключение Astro‑сборки (по умолчанию включена)
ASTRO_BUILD_ENABLED=true

# S3/MinIO settings for static site storage
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=merfy-sites

# Production S3 example:
# S3_ENDPOINT=https://s3.merfy.ru
# S3_PUBLIC_ENDPOINT=https://cdn.merfy.ru
# S3_BUCKET=merfy-sites

# Retention for local artifacts in days
ARTIFACT_RETENTION_DAYS=14

# Enable/disable hourly billing reconciliation job (freeze/unfreeze fallback)
BILLING_SYNC_CRON_ENABLED=true

# --- Контур (spec 116). Дефолты = прод; dev задаёт свои значения в Coolify ---
# Префикс имени файла и роутера Traefik для витрин центрального прокси. У прода `site-` (файл site-<slug>.yml,
# роутер s-<slug>). У dev `dev-site-`: иначе dev перезаписал бы роутер прода того же слага в общем каталоге.
# SITES_TRAEFIK_FILE_PREFIX=site-
# Wildcard-сертификат для роутеров витрин (например *.dev.merfy.ru через резолвер DNS-01). Пусто = сертификат на каждый хост.
# SITES_CERT_WILDCARD=
# Адрес API для тем витрин при сборке: выводится из API_GATEWAY_URL автоматически (buildEnvForThemes), задавать не нужно.
# PUBLIC_MERFY_API_URL=https://gateway.merfy.ru/api
