---
const { settings, theme, shop } = Astro.props;
---
<!-- Подвал пяти тем одной разметкой: раскладка (3-col — flux и rose, 2-part — satin и bloom, 2-part-asymmetric —
     vanilla, minimal) — атрибутом корня и вариантами классов; ссылки — из меню и данных магазина. -->
<div class="font-body text-sm text-foreground" data-capitals={settings.capitals} data-layout={settings.layout}>
  <div class="mx-auto flex max-w-page flex-col gap-10 px-4 in-data-[layout=2-part-asymmetric]:items-center in-data-[layout=2-part-asymmetric]:text-center md:in-data-[layout=2-part-asymmetric]:items-start md:in-data-[layout=2-part-asymmetric]:text-left">
    {settings.newsletter && (
      <section aria-label="Рассылка" class="flex w-full flex-col gap-6 md:in-data-[layout=2-part]:flex-row md:in-data-[layout=2-part]:items-center md:in-data-[layout=2-part]:justify-between">
        <div class="flex flex-col gap-2">
          {settings.heading && (
            <h2
              class="m-0 font-heading weight-body tracking-heading text-heading in-data-[capitals=all]:uppercase data-[heading-size=small]:text-base md:data-[heading-size=small]:text-lg data-[heading-size=medium]:text-xl md:data-[heading-size=medium]:text-2xl data-[heading-size=large]:text-2xl md:data-[heading-size=large]:text-3xl"
              data-heading-size={settings['heading-size']}
              set:html={settings.heading}
            />
          )}
          {settings.text && (
            <p
              class="m-0 text-muted-foreground data-[text-size=small]:text-xs md:data-[text-size=small]:text-sm data-[text-size=medium]:text-sm md:data-[text-size=medium]:text-base data-[text-size=large]:text-base md:data-[text-size=large]:text-lg"
              data-text-size={settings['text-size']}
              set:html={settings.text}
            />
          )}
        </div>
        <form class="m-0 flex w-full flex-col gap-2 md:max-w-108" data-action="subscribe" novalidate>
          <label class="sr-only" for="footer-newsletter-email">Электронная почта</label>
          <div class="flex h-14 items-center gap-2 rounded-input border-width-input border-input bg-background pl-4 pr-1 shadow-input focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ring">
            <input
              autocomplete="email"
              class="h-11 min-w-0 flex-1 bg-transparent text-base text-foreground outline-none placeholder:text-muted-foreground"
              data-ref="email"
              id="footer-newsletter-email"
              name="email"
              placeholder="Электронная почта"
              required
              type="email"
            />
            <button aria-label="Подписаться" class="inline-flex size-11 shrink-0 cursor-pointer items-center justify-center text-heading hover:opacity-70 disabled:opacity-50" data-ref="submit" type="submit">
              <svg class="size-7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.25" viewBox="0 0 24 24"><path d="M3 12h18" /><path d="m15 6 6 6-6 6" /></svg>
            </button>
          </div>
          <p class="m-0 text-sm text-foreground" data-ref="subscribed" hidden role="status">Спасибо! Мы отправим вам приветственное письмо.</p>
          <p class="m-0 text-sm text-foreground" data-ref="already-subscribed" hidden role="status">Вы уже подписаны на рассылку.</p>
          <p class="m-0 text-sm text-destructive" data-ref="too-many" hidden role="alert">Слишком много попыток. Попробуйте позже.</p>
          <p class="m-0 text-sm text-destructive" data-ref="invalid" hidden role="alert">Проверьте адрес электронной почты.</p>
          <p class="m-0 text-sm text-destructive" data-ref="failed" hidden role="alert">Не получилось подписаться. Попробуйте позже.</p>
        </form>
      </section>
    )}

    <div class="flex w-full flex-col gap-10 md:grid md:grid-cols-4 md:gap-4 md:in-data-[layout=2-part]:flex md:in-data-[layout=2-part]:flex-row md:in-data-[layout=2-part]:justify-between md:in-data-[layout=2-part-asymmetric]:flex md:in-data-[layout=minimal]:flex md:in-data-[layout=minimal]:flex-row md:in-data-[layout=minimal]:flex-wrap md:in-data-[layout=minimal]:items-center md:in-data-[layout=minimal]:justify-between">
      {settings.logo ? (
        <a class="inline-flex self-start no-underline in-data-[layout=2-part-asymmetric]:self-center md:col-span-4 md:in-data-[layout=2-part-asymmetric]:self-start" href="/">
          <img alt={shop.name} class="block h-10 w-auto max-w-logo object-contain" src={settings.logo} />
        </a>
      ) : (
        <a class="inline-flex min-h-11 items-center self-start font-heading weight-heading tracking-heading text-xl text-heading no-underline in-data-[capitals=all]:uppercase in-data-[layout=2-part-asymmetric]:self-center in-data-[layout=3-col]:hidden md:min-h-0 md:in-data-[layout=2-part-asymmetric]:self-start" href="/">{shop.name}</a>
      )}
      <div class="contents md:in-data-[layout=2-part]:flex md:in-data-[layout=2-part]:gap-16 md:in-data-[layout=minimal]:flex md:in-data-[layout=minimal]:flex-wrap md:in-data-[layout=minimal]:gap-x-8">
        {settings.menu.items.some((item) => item.items.length === 0) && (
          <nav aria-label="Навигация" class="flex flex-col gap-2 md:gap-4">
            <h3 class="m-0 text-base weight-body text-heading in-data-[capitals=all]:uppercase in-data-[capitals=columns]:uppercase in-data-[layout=minimal]:hidden">Навигация</h3>
            <ul class="m-0 flex list-none flex-col p-0 md:gap-3 md:in-data-[layout=minimal]:flex-row md:in-data-[layout=minimal]:gap-6">
              {settings.menu.items.filter((item) => item.items.length === 0).map((item) => (
                <li><a class="flex min-h-11 items-center text-base text-muted-foreground no-underline hover:text-heading in-data-[layout=2-part-asymmetric]:justify-center md:min-h-0 md:in-data-[layout=2-part-asymmetric]:justify-start" href={item.url}>{item.label}</a></li>
              ))}
            </ul>
          </nav>
        )}
        {settings.menu.items.filter((item) => item.items.length > 0).map((item) => (
          <nav aria-label={item.label} class="flex flex-col gap-2 md:gap-4">
            <h3 class="m-0 text-base weight-body text-heading in-data-[capitals=all]:uppercase in-data-[capitals=columns]:uppercase in-data-[layout=minimal]:hidden">{item.label}</h3>
            <ul class="m-0 flex list-none flex-col p-0 md:gap-3 md:in-data-[layout=minimal]:flex-row md:in-data-[layout=minimal]:gap-6">
              {item.items.map((child) => (
                <li><a class="flex min-h-11 items-center text-base text-muted-foreground no-underline hover:text-heading in-data-[layout=2-part-asymmetric]:justify-center md:min-h-0 md:in-data-[layout=2-part-asymmetric]:justify-start" href={child.url}>{child.label}</a></li>
              ))}
            </ul>
          </nav>
        ))}
        {shop.policies.length > 0 && (
          <nav aria-label="Информация" class="flex flex-col gap-2 md:gap-4">
            <h3 class="m-0 text-base weight-body text-heading in-data-[capitals=all]:uppercase in-data-[capitals=columns]:uppercase in-data-[layout=minimal]:hidden">Информация</h3>
            <ul class="m-0 flex list-none flex-col p-0 md:gap-3 md:in-data-[layout=minimal]:flex-row md:in-data-[layout=minimal]:gap-6">
              {shop.policies.map((policy) => (
                <li><a class="flex min-h-11 items-center text-base text-muted-foreground no-underline hover:text-heading in-data-[layout=2-part-asymmetric]:justify-center md:min-h-0 md:in-data-[layout=2-part-asymmetric]:justify-start" href={policy.url}>{policy.title}</a></li>
              ))}
            </ul>
          </nav>
        )}
        {(shop.contacts.phone || shop.contacts.email || shop.contacts.fields.length > 0) && (
          <div class="flex flex-col gap-2 md:gap-4">
            <h3 class="m-0 text-base weight-body text-heading in-data-[capitals=all]:uppercase in-data-[capitals=columns]:uppercase in-data-[layout=minimal]:hidden">Контакты</h3>
            <ul class="m-0 flex list-none flex-col p-0 text-base text-muted-foreground md:gap-3 md:in-data-[layout=minimal]:flex-row md:in-data-[layout=minimal]:gap-6">
              {shop.contacts.phone && <li><a class="flex min-h-11 items-center text-foreground no-underline hover:text-heading in-data-[layout=2-part-asymmetric]:justify-center md:min-h-0 md:in-data-[layout=2-part-asymmetric]:justify-start" href={`tel:${shop.contacts.phone}`}>{shop.contacts.phone}</a></li>}
              {shop.contacts.email && <li><a class="flex min-h-11 items-center break-all text-foreground no-underline hover:text-heading in-data-[layout=2-part-asymmetric]:justify-center md:min-h-0 md:in-data-[layout=2-part-asymmetric]:justify-start" href={`mailto:${shop.contacts.email}`}>{shop.contacts.email}</a></li>}
              {shop.contacts.fields.map((field) => <li class="py-2 md:py-0">{field.label}: {field.value}</li>)}
            </ul>
          </div>
        )}
      </div>
      {settings['payment-icons'] && shop.payments.online && (
        <ul aria-label="Способы оплаты" class="m-0 flex list-none flex-wrap items-start gap-3 p-0 in-data-[layout=2-part-asymmetric]:justify-center md:col-start-4 md:justify-end md:justify-self-end md:in-data-[layout=2-part-asymmetric]:justify-start">
          {['МИР', 'Visa', 'Mastercard'].map((card) => (
            <li class="inline-flex h-6 items-center rounded-badge bg-background px-2 text-xs weight-heading text-heading shadow-input">{card}</li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <ul class="m-0 flex list-none flex-wrap justify-center gap-2 px-4 pb-6 empty:hidden">
    {[
      { url: theme['social-telegram'], label: 'Telegram' },
      { url: theme['social-vk'], label: 'ВКонтакте' },
      { url: theme['social-dzen'], label: 'Дзен' },
      { url: theme['social-youtube'], label: 'YouTube' },
      { url: theme['social-tiktok'], label: 'TikTok' },
      { url: theme['social-max'], label: 'MAX' },
    ].filter((link) => link.url).map((link) => (
      <li><a class="inline-flex h-11 items-center rounded-badge border-width-input border-border px-4 text-sm text-foreground no-underline hover:bg-accent hover:text-accent-foreground" href={link.url} rel="noopener noreferrer" target="_blank">{link.label}</a></li>
    ))}
  </ul>
  <div class="flex min-h-16 items-center justify-center px-4">
    <a class="inline-flex min-h-11 items-center text-sm text-foreground no-underline hover:text-heading md:text-base" href="https://merfy.ru/" rel="noopener noreferrer" target="_blank">Разработано на Merfy</a>
  </div>
</div>
