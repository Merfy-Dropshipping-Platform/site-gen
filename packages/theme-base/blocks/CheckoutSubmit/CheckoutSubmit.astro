---
import type { CheckoutSubmitProps } from './CheckoutSubmit.puckConfig';
import { CheckoutSubmitClasses as C } from './CheckoutSubmit.classes';
import { schemeClassOf } from '../../runtime/color-scheme';
import { CHECKOUT_BUTTON_CONTRAST_SOURCE } from '../../runtime/checkout-button-contrast';

interface Props extends CheckoutSubmitProps {
  id?: string;
  /**
   * «Цветовая схема» секции «Оформление заказа» (CheckoutForm) — НЕ свой
   * контрол панели: в `CheckoutSubmit.puckConfig` такого поля нет и не
   * появляется (состав параметров — канон). Прокидывает родитель.
   *
   * Уточнение владельца (после третьего круга): «левая часть от нас, там
   * только меняется цвет кнопки и юр инфа цвет». То есть схема формы больше НЕ
   * поверхность левой колонки, а ровно два элемента — эта кнопка и правовая
   * полоса. Класс схемы садится на корень «Кнопки оплаты», потому что корень
   * ничего не красит (`w-full`), а кнопка внутри и так берёт цвет
   * `--color-button-bg/--color-button-text` — тем же механизмом, каким кнопка
   * берёт цвет в любой обычной секции витрины (обёртка `color-scheme-N` над
   * секцией → токены кнопки из схемы). Новый механизм не вводится.
   */
  colorScheme?: unknown;
}
const { id, buttonText, buttonStyle, loadingText, successRedirectUrl, padding, colorScheme } = Astro.props as Props;
const paddingStyle = padding ? `padding-top:${padding.top}px; padding-bottom:${padding.bottom}px;` : '';
const cls = buttonStyle === 'outline' ? C.buttonOutline : buttonStyle === 'gradient' ? C.buttonGradient : C.buttonFill;
const initialLabel = buttonText.replace('{total}', '—');
// Схема приходит строкой "scheme-2", голой "1" ИЛИ числом (живая нормализация
// ревизии) — см. runtime/color-scheme.ts.
const schemeClass = schemeClassOf(colorScheme);
---
<section
  class:list={[C.root, schemeClass]}
  data-puck-component-id={id}
  data-block="checkout-submit"
  style={paddingStyle}
>
  <div data-checkout-submit-error role="alert" hidden style="color:rgb(var(--color-error));font-size:14px;margin-bottom:8px;"></div>
  <button type="button" class={cls} data-checkout-submit>
    {initialLabel}
  </button>
</section>

<script is:inline define:vars={{ buttonText, loadingText, successRedirectUrl, blockId: id }}>
  (function () {
    // Spec 102 — свой корень через общий примитив ([data-block="checkout-submit"]
    // стоит на корневом <section>); button/error — section.querySelector. Поля
    // других чекаут-блоков читаются через document (cross-block, см. merfy-root-allow).
    var section = window.__merfyRoot(blockId) || document.querySelector('[data-block="checkout-submit"]'); // merfy-root-allow: page-singleton (один на странице), id undefined на live composed-странице
    if (!section) return;
    var button = section.querySelector('[data-checkout-submit]');
    var errorEl = section.querySelector('[data-checkout-submit-error]');
    if (!button) return;

    var state = {
      deliveryMethod: null,
      paymentMethod: 'bank_card',
      submitting: false,
      discountCents: 0,
      // PR-19 — скидка точки расширений «Оформление заказа» (см.
      // runtime/extension-points.ts, событие checkout:extension-discount-changed);
      // независима от промокода discountCents, обе вычитаются из итога.
      extensionDiscountCents: 0,
    };

    function getApiBase() {
      return (window.__MERFY_CONFIG__ && window.__MERFY_CONFIG__.apiUrl) || 'https://gateway.merfy.ru/api';
    }
    function getShopId() {
      return (window.__MERFY_CONFIG__ && window.__MERFY_CONFIG__.shopId) || '';
    }
    // Настройки чекаута инжектятся в __MERFY_CONFIG__.checkout ПОСЛЕ блоков
    // (producer в checkout.astro диспатчит checkout:config-ready). Читаем лениво
    // при КАЖДОМ вызове — дефолты при отсутствии = текущее поведение (нулевая
    // регрессия). «Выключено ли поле» определяется этим конфигом, НЕ пустым инпутом.
    function getCheckoutConfig() {
      return (window.__MERFY_CONFIG__ && window.__MERFY_CONFIG__.checkout) || {};
    }
    function getContactMethod() {
      return getCheckoutConfig().contactMethod === 'email' ? 'email' : 'email-phone';
    }
    function getCustomerNameMode() {
      var m = getCheckoutConfig().customerNameMode;
      return (m === 'surname' || m === 'name') ? m : 'name-surname';
    }
    function getAddressRequired() {
      // Дефолт true — физ-адрес обязателен; только явный false его выключает.
      return getCheckoutConfig().addressRequired !== false;
    }
    // Блок 1 «Обязательная регистрация»: магазин требует вход покупателя перед
    // оплатой. Дефолт false = fail-open (гость у магазинов без флага не ломается).
    function getRequireCustomerAuth() {
      return getCheckoutConfig().requireCustomerAuth === true;
    }
    // Bearer-токен покупателя (rose lib/auth: raw-строка под 'merfy_customer_token';
    // persistentAtom кодирует null как '' → пусто/нет ключа = гость).
    function getAuthToken() {
      try {
        return (typeof localStorage !== 'undefined' && localStorage.getItem('merfy_customer_token')) || '';
      } catch (e) { return ''; }
    }
    function getCartId() {
      return (typeof localStorage !== 'undefined' && localStorage.getItem('merfy:cartId')) || '';
    }
    function getCartItems() {
      var items = (window.cartStore && typeof window.cartStore.getItems === 'function') ? window.cartStore.getItems() : [];
      if (items && items.length) return items;
      var prefixes = ['flux', 'rose', 'vanilla', 'bloom', 'satin'];
      for (var i = 0; i < prefixes.length; i++) {
        try {
          var raw = localStorage.getItem(prefixes[i] + ':cart:v1');
          var arr = raw ? JSON.parse(raw) : [];
          if (!Array.isArray(arr) || !arr.length) continue;
          return arr.map(function (l) {
            var rub = parseFloat(l.price) || 0;
            return {
              id: l.id,
              productId: l.productId,
              quantity: l.quantity || 1,
              unitPriceCents: Math.round(rub * 100),
              priceCents: Math.round(rub * 100),
              variantCombinationId: (l.variant && l.variant.variantCombinationId) || null,
            };
          });
        } catch (e) {}
      }
      return [];
    }
    function getSubtotalCents() {
      var items = getCartItems();
      return items.reduce(function (sum, it) { return sum + (it.unitPriceCents || it.priceCents || 0) * (it.quantity || 1); }, 0);
    }
    function getDeliveryCents() {
      return state.deliveryMethod ? (state.deliveryMethod.costCents || 0) : 0;
    }
    function getDiscountCents() {
      return state.discountCents || 0;
    }
    function getExtensionDiscountCents() {
      return state.extensionDiscountCents || 0;
    }
    function getTotalCents() {
      // Итог со скидкой: max(0, subtotal − discount − extensionDiscount + delivery).
      // Зеркалит computeTotalCents (total.ts) — is:inline не умеет import.
      return Math.max(0, getSubtotalCents() - getDiscountCents() - getExtensionDiscountCents() + getDeliveryCents());
    }
    function fmtRub(cents) {
      var rub = Math.round(cents / 100);
      return rub.toLocaleString('ru-RU') + '₽';
    }
    function getField(name) {
      var el = document.querySelector('[data-checkout-field="' + name + '"] input'); // merfy-root-allow: cross-block, поля Contact/Delivery форм, page-singleton checkout
      return el ? (el.value || '').trim() : '';
    }
    function getFiasId() {
      var f = document.querySelector('[data-checkout-delivery]'); // merfy-root-allow: cross-block, секция CheckoutDeliveryForm, page-singleton checkout
      return f ? (f.getAttribute('data-selected-city-fias-id') || '') : '';
    }
    // Адрес доставки. Форма по макету (Figma 1:19998) держит одно поле «Полный
    // адрес», а разобранные улицу/дом/кв. кладёт в data-addr-* при выборе
    // подсказки DaData. Раздельные поля street/building/apartment прежней
    // вёрстки — запасной источник; последний — весь «Полный адрес» как улица.
    function getAddressParts() {
      var f = document.querySelector('[data-checkout-delivery]'); // merfy-root-allow: cross-block, секция CheckoutDeliveryForm, page-singleton checkout
      function parsed(part) { return f ? (f.getAttribute('data-addr-' + part) || '') : ''; }
      return {
        street: parsed('street') || getField('street') || getField('address'),
        building: parsed('building') || getField('building'),
        apartment: parsed('apartment') || getField('apartment'),
        full: getField('address'),
      };
    }
    // Отображаемое имя из ВИДИМЫХ полей согласно customerNameMode:
    //   name-surname → «Имя Фамилия», surname → «Фамилия», name → «Имя».
    // name-surname сохраняет legacy-fallback на поле fullName (нулевая регрессия).
    function buildCustomerName(mode) {
      // fullName-fallback во ВСЕ режимы: CheckoutDeliveryForm рендерит ЛИБО split-поля
      // (firstName/lastName), ЛИБО одно поле fullName (splitFirstLast:false). При
      // fullName-раскладке split-полей нет → без fallback surname/name вернули бы ''
      // и серверный энфорс имени (H3) ложно реджектил бы валидный заказ.
      var fn = getField('firstName');
      var ln = getField('lastName');
      var full = getField('fullName');
      if (mode === 'surname') return ln || full;
      if (mode === 'name') return fn || full;
      return full || (fn + ' ' + ln).trim();
    }

    function canSubmit() {
      if (state.submitting) return false;
      var items = getCartItems();
      if (items.length === 0) return false;
      if (!getShopId()) return false;

      // Блок 1 backstop: на магазине с requireCustomerAuth гость (нет токена) не
      // может оформить — кнопка disabled. Основной барьер — Gate A на загрузке
      // /checkout + серверный 403; это дублирующий клиентский гейт (напр. токен
      // потерян посреди сессии). Fail-open: без флага условие не срабатывает.
      if (getRequireCustomerAuth() && !getAuthToken()) return false;

      // Контакт: email обязателен всегда; телефон — только когда режим не 'email'.
      if (!getField('email')) return false;
      if (getContactMethod() !== 'email' && !getField('phone')) return false;

      // Имя: требуем заполненности ВИДИМЫХ полей согласно customerNameMode.
      // CheckoutDeliveryForm рендерит ЛИБО split-поля (firstName+lastName), ЛИБО одно
      // поле fullName (splitFirstLast:false) — при fullName-раскладке split-полей нет,
      // getField вернёт ''. Зеркалим fullName-fallback из buildCustomerName: имя
      // заполнено, если есть соответствующее режиму split-поле ЛИБО непустой fullName.
      var nameMode = getCustomerNameMode();
      if (nameMode === 'surname') {
        if (!getField('lastName') && !getField('fullName')) return false;
      } else if (nameMode === 'name') {
        if (!getField('firstName') && !getField('fullName')) return false;
      } else {
        if (!getField('fullName') && !(getField('firstName') && getField('lastName'))) return false;
      }

      // Адрес + способ доставки требуются только для физических товаров
      // (addressRequired). Для цифровых (addressRequired=false) секцию доставки
      // нейтрализует CheckoutDeliveryMethod (синтетический {type:'none'}), поэтому
      // гейт пропускает этот случай без выбора метода.
      if (getAddressRequired()) {
        if (!state.deliveryMethod) return false;
        var dt = state.deliveryMethod.type;
        // Самовывоз (self_pickup) и CDEK-ПВЗ (cdek_pickup) адрес-независимы — город/улица
        // не нужны (зеркало серверного «не-курьер»: адрес требуют только курьерские типы).
        var isPickup = (dt === 'self_pickup' || dt === 'cdek_pickup');
        var addr = getAddressParts();
        if (!isPickup && (!getField('city') || !addr.street)) return false;
        // CDEK самовывоз (ПВЗ/постамат) требует выбранного пункта — иначе СДЭК
        // отклонит отправление уже ПОСЛЕ оплаты (нет delivery_point). Тип именно
        // 'cdek_pickup' (как в CheckoutDeliveryMethod), не 'cdek_pvz'.
        if (dt === 'cdek_pickup' && !state.deliveryMethod.pickupPointCode) return false;
        // Курьер/до двери (cdek_door): «Дом» обязателен — иначе CDEK получит адрес
        // без номера дома (doorAddress = только улица) → реджект/недоставка после оплаты.
        if (dt === 'cdek_door' && !addr.building) return false;
      }

      if (!state.paymentMethod) return false;
      return true;
    }

    // 16.09, точка 2: «пусть просто отображается активной, как будто данные
    // внесены... а не неактивный статус» — но ТОЛЬКО вид в конструкторе и
    // превью. Живой сайт обязан вести себя как раньше: кнопка серая, пока
    // форма не заполнена. `window.parent !== window` — тот же признак
    // «мы в iframe превью», которым уже пользуется `cart-added-modal.ts`
    // (goToCheckout); превью конструктора рендерится в iframe, витрина —
    // нет. Реальную защиту это НЕ ослабляет: клик-хендлер ниже держит свой
    // собственный `if (!canSubmit()) return;` независимо от inIframe и от
    // DOM-атрибута disabled — покупатель на живом сайте не может отправить
    // пустой заказ, даже если бы кто-то снял disabled в devtools.
    function refresh() {
      var label = buttonText.replace('{total}', fmtRub(getTotalCents()));
      button.textContent = state.submitting ? loadingText : label;
      var inIframe = window.parent && window.parent !== window;
      button.disabled = inIframe ? false : !canSubmit();
      // Подсказка «войдите» — когда кнопку блокирует ИМЕННО требование входа
      // (магазин с requireCustomerAuth, у гостя нет токена). Пишем только этот
      // кейс, чтобы не затирать реальную ошибку сабмита (гость до неё не доходит —
      // Gate A/B разворачивают на /login). Вход — по ссылке ИЛИ коду из письма.
      if (!state.submitting && getRequireCustomerAuth() && !getAuthToken()) {
        showError('Войдите в аккаунт по ссылке или коду из письма, чтобы оформить заказ.');
      }
    }

    document.addEventListener('cart:updated', refresh);
    document.addEventListener('checkout:address-changed', refresh);
    // Настройки чекаута прилетают ПОСЛЕ init — пере-оцениваем гейт по событию.
    // (getContactMethod/getCustomerNameMode/getAddressRequired читают конфиг лениво.)
    document.addEventListener('checkout:config-ready', refresh);
    document.addEventListener('checkout:discount-applied', function (e) {
      // Кнопка «Оформить — {total}» должна показывать сумму со скидкой.
      state.discountCents = (e && e.detail && e.detail.discountCents) || 0;
      refresh();
    });
    // PR-19 — скидка точки расширений «Оформление заказа» (см.
    // runtime/extension-points.ts). Независима от checkout:discount-applied.
    document.addEventListener('checkout:extension-discount-changed', function (e) {
      state.extensionDiscountCents = (e && e.detail && e.detail.discountCents) || 0;
      refresh();
    });
    document.addEventListener('checkout:delivery-changed', function (e) {
      var d = e && e.detail;
      if (!d) return;
      state.deliveryMethod = {
        type: d.type,
        label: d.label,
        costCents: d.costCents || 0,
        tariffCode: d.tariffCode != null ? d.tariffCode : null,
        customTariffId: d.customTariffId || null,
        pickupPointId: d.pickupPointId || null,
        // Код выбранного ПВЗ/постамата СДЭК (для cdek_pickup). Доедет до заказа
        // через Step 0 /delivery/select → orders.cdekPickupPointCode.
        pickupPointCode: d.pickupPointCode || null,
        pickupPointAddress: d.pickupPointAddress || null,
        periodMin: d.periodMin != null ? d.periodMin : null,
        periodMax: d.periodMax != null ? d.periodMax : null,
      };
      refresh();
    });
    document.addEventListener('checkout:payment-method-changed', function (e) {
      var m = e && e.detail && e.detail.method;
      if (m) { state.paymentMethod = m; refresh(); }
    });

    ['email','phone','firstName','lastName','fullName','city','postalCode','street','building','apartment'].forEach(function (f) {
      var el = document.querySelector('[data-checkout-field="' + f + '"] input'); // merfy-root-allow: cross-block, поля Contact/Delivery форм, page-singleton checkout
      if (!el) return;
      el.addEventListener('input', refresh);
      el.addEventListener('change', refresh);
    });

    function showError(msg) {
      if (errorEl) { errorEl.hidden = false; errorEl.textContent = msg; }
    }
    function clearError() {
      if (errorEl) { errorEl.hidden = true; errorEl.textContent = ''; }
    }

    button.addEventListener('click', async function (e) {
      e.preventDefault();
      // Gate B (backstop): гость на магазине с requireCustomerAuth → на вход.
      // Первой строкой, ДО canSubmit. Достижимо, когда кнопка была активна (был
      // токен) и токен потерян посреди сессии; в стабильном состоянии кнопку
      // гасит canSubmit + Gate A на загрузке. Fail-open: без флага не срабатывает.
      if (getRequireCustomerAuth() && !getAuthToken()) {
        location.href = '/login?redirect=' + encodeURIComponent('/checkout');
        return;
      }
      if (!canSubmit()) return;
      clearError();
      state.submitting = true;
      refresh();

      try {
        var apiBase = getApiBase();
        // Bearer покупателя (если вошёл) — прикрепляем к checkout и create-payment.
        // Gateway soft-резолвит Bearer→customerId и привязывает заказ к клиенту;
        // customerId в теле НЕ шлём (untrusted). Гость (пусто) → заголовок опущен.
        var authToken = getAuthToken();
        var cartId = (window.cartStore && window.cartStore.syncToServer) ? await window.cartStore.syncToServer() : getCartId();
        if (!cartId) throw new Error('Корзина пуста. Добавьте товары.');

        // Переприменить промокод на пересозданной корзине (rose: syncToServer
        // очищает merfy:cartId и пересоздаёт корзину → промокод, применённый до
        // сабмита, потерян). Если код протух к моменту оплаты — ПРЕРЫВАЕМ
        // оформление (не списываем полную сумму молча).
        var promoCode = (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('merfy:promoCode')) || '';
        if (promoCode) {
          var promoRes = await fetch(apiBase + '/orders/cart/' + cartId + '/promo', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ promoCode: promoCode }),
          });
          if (!promoRes.ok) {
            var promoJson = await promoRes.json().catch(function () { return null; });
            var promoMsg = (promoJson && (typeof promoJson.message === 'string' ? promoJson.message
              : (Array.isArray(promoJson.message) ? promoJson.message[0] : promoJson.error)))
              || 'Промокод больше недействителен — обновите заказ';
            throw new Error(promoMsg);
          }
        }

        var paymentToken = null;
        if (state.paymentMethod === 'bank_card' && typeof window.__checkoutTokenizeCard === 'function') {
          paymentToken = await window.__checkoutTokenizeCard();
        }

        var nameMode = getCustomerNameMode();
        var contactMethod = getContactMethod();
        var addressRequired = getAddressRequired();
        // Отображаемое имя из видимых полей (по customerNameMode).
        var customerName = buildCustomerName(nameMode);
        // Видимые компоненты имени для metadata — скрытые режимом остаются пустыми.
        var firstName = nameMode === 'surname' ? '' : getField('firstName');
        var lastName = nameMode === 'name' ? '' : getField('lastName');
        var email = getField('email');
        var phone = getField('phone');

        // 1. PATCH cart с customer info (backend ищет на самой записи cart).
        //    Телефон отправляем только когда режим контакта не 'email' — иначе
        //    ключ опускаем совсем (не шлём пустую строку).
        var customerBody = { email: email, name: customerName };
        if (contactMethod !== 'email') customerBody.phone = phone;
        await fetch(apiBase + '/orders/cart/' + cartId + '/customer', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(customerBody),
        });

        // 2. PATCH cart с address. Backend DTO (ShippingAddressDto) ждёт
        // street/building/apartment раздельно — берём их из getAddressParts()
        // (разбор подсказки DaData либо раздельные поля). НИКАКОГО позиционного
        // split(',') — он раскладывал ручной ввод неверно («Москва, г Реутов,
        // ул Новая, д 19» → street='Москва', building='г Реутов»…).
        var addrParts = getAddressParts();
        var addrStreet = addrParts.street;
        var addrBuilding = addrParts.building;
        var addrApartment = addrParts.apartment;
        // Полная строка адреса (для метаданных / отображения): то, что покупатель
        // видит в поле «Полный адрес», иначе «улица, д. дом, кв. квартира». В PATCH
        // /address её НЕ шлём (RPC order.cart.setAddress её игнорирует; door-адрес
        // СДЭК orders собирает из street/building/apartment).
        var addrFullParts = [];
        if (addrStreet) addrFullParts.push(addrStreet);
        if (addrBuilding) addrFullParts.push('д. ' + addrBuilding);
        if (addrApartment) addrFullParts.push('кв. ' + addrApartment);
        var addrFull = addrParts.full || addrFullParts.join(', ');
        // Физ-адрес шлём только для физических товаров. Для цифровых
        // (addressRequired=false) PATCH /address НЕ вызываем (адрес не собирается).
        if (addressRequired) {
          await fetch(apiBase + '/orders/cart/' + cartId + '/address', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              country: getField('country') || 'Россия',
              city: getField('city'),
              street: addrStreet,
              building: addrBuilding,
              apartment: addrApartment,
              postalCode: getField('postalCode'),
            }),
          });
        }

        // 2.5 — CDEK самовывоз (ПВЗ/постамат): пробрасываем код точки на заказ
        // через /delivery/select. Это ЕДИНСТВЕННЫЙ путь, по которому
        // cdekPickupPointCode доезжает до logistics.producer → delivery_point;
        // metadata.deliveryMethod при checkout код точки НЕ переносит. Падение
        // НЕ глотаем — иначе СДЭК отклонит отправление уже после оплаты.
        var dm = state.deliveryMethod;
        if (addressRequired && dm && dm.type === 'cdek_pickup') {
          var selectBody = {
            type: dm.type,
            deliveryCostCents: dm.costCents || 0,
            address: {
              city: getField('city'),
              street: addrStreet,
              house: addrBuilding,
              apartment: addrApartment,
              postalCode: getField('postalCode'),
              fiasId: getFiasId(),
              fullAddress: addrFull,
            },
          };
          if (dm.tariffCode != null) selectBody.tariffCode = dm.tariffCode;
          if (dm.periodMin != null) selectBody.periodMin = dm.periodMin;
          if (dm.periodMax != null) selectBody.periodMax = dm.periodMax;
          if (dm.pickupPointCode) selectBody.pickupPointCode = dm.pickupPointCode;
          if (dm.pickupPointAddress) selectBody.pickupPointAddress = dm.pickupPointAddress;
          var selRes = await fetch(apiBase + '/store/carts/' + cartId + '/delivery/select', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify(selectBody),
          });
          if (!selRes.ok) {
            throw new Error('Не удалось сохранить пункт выдачи. Выберите точку заново.');
          }
        }

        // 3. POST checkout (теперь cart содержит customerEmail/Phone).
        //    Цифровые товары (addressRequired=false): deliveryMethod —
        //    синтетический «без доставки»; deliveryAddress не собираем;
        //    contactPhone опускаем если пусто.
        var metadata = {
          paymentMethod: state.paymentMethod,
          deliveryMethod: addressRequired ? state.deliveryMethod : { type: 'none', costCents: 0 },
          contactEmail: email,
          customerName: customerName,
        };
        // contactPhone в метаданные заказа — только когда режим контакта не 'email'
        // (консистентно с PATCH /customer). Иначе телефон, введённый вручную до
        // прихода конфига в email-only магазине, утёк бы в заказ.
        if (contactMethod !== 'email' && phone) metadata.contactPhone = phone;
        if (addressRequired) {
          metadata.deliveryAddress = {
            country: getField('country') || 'Россия',
            city: getField('city'),
            fullAddress: addrFull,
            postalCode: getField('postalCode'),
            fiasId: getFiasId(),
            firstName: firstName,
            lastName: lastName,
            fullName: customerName,
          };
        }
        var checkoutBody = { metadata: metadata };
        var checkoutHeaders = { 'Content-Type': 'application/json' };
        if (authToken) checkoutHeaders['Authorization'] = 'Bearer ' + authToken;
        var checkoutRes = await fetch(apiBase + '/orders/cart/' + cartId + '/checkout', {
          method: 'POST',
          headers: checkoutHeaders,
          credentials: 'include',
          body: JSON.stringify(checkoutBody),
        });
        var checkoutJson = await checkoutRes.json();
        // Cart not found (404) → cart устарел (paid/cancelled). Сбрасываем cartId
        // чтобы next add-to-cart создал новый, и просим юзера пересобрать заказ.
        if (checkoutRes.status === 404) {
          try { localStorage.removeItem('merfy:cartId'); } catch (e) {}
          throw new Error('Корзина устарела. Вернитесь в каталог и добавьте товары заново.');
        }
        // 403 = серверный гейт requireCustomerAuth (code='customer_auth_required'):
        // гость проскочил клиентские Gate A/B, но orders требует вход. Разворачиваем
        // на /login (НЕ списываем — оплата ещё не создана). Проверяем статус, а не
        // тело — устойчиво к любой форме ответа.
        if (checkoutRes.status === 403) {
          location.href = '/login?redirect=' + encodeURIComponent('/checkout');
          return;
        }
        var orderId = checkoutJson && checkoutJson.data && (checkoutJson.data.orderId || checkoutJson.data.id);
        if (!checkoutRes.ok || !orderId) {
          throw new Error((checkoutJson && (checkoutJson.error || checkoutJson.message)) || 'Не удалось оформить заказ');
        }

        var paymentBody = {
          returnUrl: window.location.origin + successRedirectUrl + '?orderId=' + orderId,
          paymentMethod: state.paymentMethod, // 'bank_card' | 'sbp' | ...
        };
        if (paymentToken) paymentBody.paymentToken = paymentToken;

        var paymentHeaders = { 'Content-Type': 'application/json' };
        if (authToken) paymentHeaders['Authorization'] = 'Bearer ' + authToken;
        var paymentRes = await fetch(apiBase + '/orders/' + orderId + '/create-payment', {
          method: 'POST',
          headers: paymentHeaders,
          credentials: 'include',
          body: JSON.stringify(paymentBody),
        });
        var paymentJson = await paymentRes.json();
        var confirmationUrl = paymentJson && paymentJson.data && paymentJson.data.confirmationUrl;
        if (!paymentRes.ok || !confirmationUrl) {
          throw new Error((paymentJson && (paymentJson.error || paymentJson.message)) || 'Ошибка платежа');
        }

        try {
          localStorage.setItem('merfy:lastOrderId', orderId);
          // Удаляем оба ключа — иначе stale items без cartId создают
          // зомби-cart на /checkout (сводка показывает item, но
          // delivery quote видит cartId=null → 'Добавьте товар').
          localStorage.removeItem('merfy:cartId');
          localStorage.removeItem('merfy:cartItems');
          // Промокод применён к заказу — очищаем, чтобы не переприменялся к
          // следующей корзине.
          if (typeof sessionStorage !== 'undefined') sessionStorage.removeItem('merfy:promoCode');
        } catch (e) {}
        window.location.href = confirmationUrl;
      } catch (err) {
        state.submitting = false;
        refresh();
        showError(err && err.message ? err.message : 'Не удалось оформить заказ');
      }
    });

    refresh();
  })();
</script>

{/*
  ВНИМАНИЕ: эти два скрипта обязаны идти ПОСЛЕ основного. DOM-тесты блока
  (packages/theme-base/__tests__/checkout-submit-*.dom.test.ts) достают из
  .astro ПЕРВЫЙ <script> и исполняют его в jsdom как логику сабмита —
  вставка выше уводила их на расчёт контраста, и 10 проверок падали на
  ровном месте.
*/}
{/*
  Кнопка «как у Shopify»: заметна на фоне колонки в любой теме и любой схеме.
  Исходник расчёта — общий с гардом (runtime/checkout-button-contrast.ts), он
  же объясняет пороги и порядок ролей. Здесь только применение.
*/}
<script is:inline set:html={CHECKOUT_BUTTON_CONTRAST_SOURCE}></script>
<script is:inline define:vars={{ blockId: id }}>
  (function () {
    // Spec 102 — свой корень через общий примитив. Хелпер инжектится на
    // деплое и в превью; если его почему-то нет, расчёт контраста НЕ должен
    // быть тем, обо что падает страница оплаты — отсюда проверка типа.
    var section = (typeof window.__merfyRoot === 'function' ? window.__merfyRoot(blockId) : null)
      || document.querySelector('[data-block="checkout-submit"]'); // merfy-root-allow: page-singleton (один на странице), id undefined на live composed-странице
    if (!section || typeof window.__merfyCheckoutButtonColors !== 'function') return;

    // 16.09, п.2: hover больше не читает отдельную пару hover-токенов схемы —
    // CHECKOUT_SUBMIT_HOVER_LIGHTEN_CSS (tokens-css.ts) осветляет hover ИЗ
    // базового --color-button-bg через color-mix(), поэтому исправлять хватает
    // только базовые токены; контраст на hover наследуется автоматически
    // (color-mix читает УЖЕ исправленный --color-button-bg).
    var OVERRIDES = ['--color-button-bg', '--color-button-text'];

    function apply() {
      // СНАЧАЛА снимаем свой прошлый результат. Иначе второй проход прочитал бы
      // как «цвет схемы» плашку, которую сам же и записал: расчёт замкнулся бы
      // на себя (замер: rose scheme-4 отдавал source='button-bg' вместо 'bg').
      for (var k = 0; k < OVERRIDES.length; k++) section.style.removeProperty(OVERRIDES[k]);
      var cs = getComputedStyle(section);
      var role = function (name) { return cs.getPropertyValue(name).trim(); };
      // Фон колонки читаем ФАКТИЧЕСКИЙ: его задаёт тема (<body>/global.css
      // порта), а не tokens.css — посчитать его в сборке нельзя, не угадывая.
      // Идём вверх по предкам до первого непрозрачного фона: у самой колонки
      // он есть всегда, но на превью-фрагменте блока предка может не быть.
      var el = section;
      var columnBg = '';
      while (el && el !== document.documentElement) {
        var bg = getComputedStyle(el).backgroundColor;
        if (bg && bg !== 'transparent' && !/rgba\(\s*0\s*,\s*0\s*,\s*0\s*,\s*0\s*\)/.test(bg)) { columnBg = bg; break; }
        el = el.parentElement;
      }
      var m = /(-?\d+)[,\s]+(-?\d+)[,\s]+(-?\d+)/.exec(columnBg || '');
      var column = m ? m[1] + ' ' + m[2] + ' ' + m[3] : '255 255 255';

      var out = window.__merfyCheckoutButtonColors({
        buttonBg: role('--color-button-bg'),
        buttonText: role('--color-button-text'),
        accent: role('--color-accent'),
        heading: role('--color-heading'),
        bg: role('--color-bg'),
        text: role('--color-text'),
        button2Bg: role('--color-button-2-bg')
      }, column);

      // Кладём в ТОКЕНЫ, а не в inline-style кнопки: класс блока читает
      // --color-button-bg/-text (обычное состояние), а hover — тот же
      // --color-button-bg через CSS color-mix() (CHECKOUT_SUBMIT_HOVER_
      // LIGHTEN_CSS), поэтому при наведении кнопка не вернётся к невидимому
      // цвету — она наследует уже исправленный базовый. Никаких hover-
      // переменных отдельно не пишем (16.09, п.2 — см. OVERRIDES выше).
      var plate = out.plate.join(' ');
      var label = out.label.join(' ');
      section.style.setProperty('--color-button-bg', plate);
      section.style.setProperty('--color-button-text', label);
      section.setAttribute('data-checkout-submit-contrast', out.source + (out.shaded ? '+shade' : ''));
    }

    apply();
    // Схему мерчант крутит в конструкторе без перезагрузки: превью подменяет
    // секцию целиком и заново исполняет её скрипты, поэтому отдельной подписки
    // не нужно. Пересчёт на смену темы через tokens.css ловим одним кадром.
    if (typeof requestAnimationFrame === 'function') requestAnimationFrame(apply);
  })();
</script>
