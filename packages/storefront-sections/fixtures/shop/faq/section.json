  },
  "defaultBlocks": [
    { "type": "question", "settings": { "question": "Как стирать кашемир?", "answer": "<p>Руками, в прохладной воде.</p>" } },
    { "type": "question", "settings": { "question": "Сколько идёт доставка?", "answer": "<p>Два дня по Москве, до недели — по России.</p>" } },
    { "type": "question", "settings": { "question": "Можно ли вернуть шарф?", "answer": "<p>Да, в течение 14 дней.</p>" } }
