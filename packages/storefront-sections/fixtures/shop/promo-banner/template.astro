---
const { settings, blocks } = Astro.props;
---
<!-- Строка над страницей: объявление и подчёркнутая ссылка после него. Высота и размер текста — по data-text-size,
     заглавные буквы — по data-capitals на корне. Цвет строки — общая «Цветовая схема»: обёртка секции красится ею.
     На телефоне строка и ссылка не ниже 44 px, на компьютере — высота по размеру. -->
<div class="font-body" data-capitals={settings.capitals}>
  {blocks.map((block) => (
    <div
      class="flex min-h-11 items-center justify-center px-4 py-2 text-center data-[text-size=small]:text-xs data-[text-size=medium]:text-sm data-[text-size=large]:min-h-12 data-[text-size=large]:text-sm md:px-8 md:py-0 md:data-[text-size=small]:min-h-8 md:data-[text-size=medium]:min-h-10 md:data-[text-size=large]:text-base"
      data-text-size={block.settings['text-size']}
    >
      <p class="m-0 mx-auto max-w-page text-balance in-data-[capitals=true]:uppercase">
        {block.settings.text && <span set:html={block.settings.text} />}
        {block.settings.label && block.settings.link && (
          <a class="ml-1 inline-flex min-h-11 items-center underline md:inline md:min-h-0 underline-offset-2 hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ring" href={block.settings.link}>{block.settings.label}</a>
        )}
      </p>
    </div>
  ))}
</div>
