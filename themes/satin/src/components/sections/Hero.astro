---
import { inlineFormat } from "../../lib/rich-text";
import { resolveHeroMediaSlots } from "../../../../../packages/theme-base/runtime/hero-media-slots";
import SatinPicture from "../img/SatinPicture.astro";
import { SITE_TITLE } from "../../consts";
import { fieldRuns, orderFields, sectionFieldOrder } from "../../../../../packages/theme-base/runtime/field-order";

// ОЖИВЛЕНИЕ (Фаза B, контракт rose/bloom Hero): канон-схема theme-base Hero.puckConfig
// поверх разметки верстальщика. Тело ниже — verbatim; дефолтные ветки тернарников =
// прежним строкам байт-в-байт (цвета → токены с пиксель-фоллбеком MANNER.md §7).
// ОБЯЗАТЕЛЬНО сохранены legacy flat-пропсы title/subtitle/ctaText/ctaLink/backgroundImage —
// index.astro:17-23 зовёт секцию с ними, их рендер не меняется.
const p = Astro.props as Record<string, any>;
const id = p.id;
const merfy = p.__merfy as { fields?: Record<string, { set?: boolean }> } | undefined;
function contentSet(keys: string | string[], raw: unknown): boolean {
	const ks = Array.isArray(keys) ? keys : [keys];
	for (const key of ks) {
		const f = merfy?.fields?.[key];
		if (f && typeof f.set === "boolean") return f.set;
	}
	if (typeof raw !== "string") return false;
	const t = raw.trim();
	if (!t || t.includes("/placeholders/") || t.includes("/images/4x/")) return false;
	return true;
}
function merchantImage(keys: string | string[], url: unknown): string {
	const ks = Array.isArray(keys) ? keys : [keys];
	for (const key of ks) {
		if (merfy?.fields?.[key]?.set === false) return "";
	}
	if (typeof url !== "string") return "";
	const u = url.trim();
	if (!u || u.includes("/placeholders/") || u.includes("/images/4x/")) return "";
	return u;
}

// ── Пустое состояние (Figma 1:19335) ────────────────────────────────────────
// Контракт плейсхолдеров: когда мерчант НИЧЕГО не настроил (секция в дефолте),
// рендерим нейтральный ПЛЕЙСХОЛДЕР (пустой image-rect surface-тона + заголовок
// секции + поясняющий текст + кнопка), а НЕ мок-демо верстальщика
// («Там, где классика встречается с характером» + фото кампании). Эталон —
// theme-base PopularProducts/Collections (гейт на наличии данных → DEMO).
// Гейт Hero = заданное мерчантом фоновое изображение ИЛИ собственный текст
// заголовка/кикера. Любой реальный сигнал → рендер реальных данных без изменений
// (фото-половина с SatinPicture, overlay, split — всё как было).
const rawBackgroundImage =
	(typeof p.backgroundImages?.url1 === "string" && p.backgroundImages.url1.trim()
		? p.backgroundImages.url1
		: undefined) ??
	(typeof p.backgroundImage === "string" && p.backgroundImage.trim() ? p.backgroundImage : undefined) ??
	(typeof p.image?.url === "string" && p.image.url.trim() ? p.image.url : undefined);
const rawHeadingText =
	typeof p.heading?.text === "string"
		? p.heading.text
		: typeof p.title === "string"
			? p.title
			: "";
const rawSubtitleText =
	typeof p.text?.content === "string"
		? p.text.content
		: typeof p.subtitle === "string"
			? p.subtitle
			: "";
const rawPrimaryText =
	typeof p.primaryButton?.text === "string"
		? p.primaryButton.text
		: typeof p.cta?.text === "string"
			? p.cta.text
			: typeof p.ctaText === "string"
				? p.ctaText
				: "";
const hasMerchantTitle = contentSet(["heading", "title"], rawHeadingText);
const hasMerchantSubtitle = contentSet(["text", "subtitle"], rawSubtitleText);
// /placeholders/ и /images/4x/* — не фото мерчанта. Пустой фон и заглушки
// считаем отсутствием картинки → landscape empty-state, как в rose.
const merchantBackground = merchantImage(["backgroundImage", "image"], rawBackgroundImage) || undefined;
// Дословные тексты Figma-плейсхолдера (тип «Изображение»). Без английского
// мока верстальщика STYLE'S WEAR — и в empty-state, и когда фото есть, а текста нет.
const PH_LABEL = "Изображение";
const PH_HELPER = "Покажи и расскажи о своем товаре в одном блоке";
const PH_BUTTON = "Кнопка";
const VERSTKA_TITLE = PH_LABEL;
const VERSTKA_SUB = PH_HELPER;
const VERSTKA_CTA = PH_BUTTON;
// Контракт картиночных секций (правило 2): в пустом состоянии картинка
// показывается ВСЕГДА — фолбэк = дизайн-ассет landscape-image.png из
// packages/theme-base/public/placeholders (раздаётся на каждой теме как
// /placeholders/landscape-image.png), а НЕ пустой surface-rect и НЕ мок-фото
// героя. Паритет vanilla/rose Hero.astro empty-state.
const PH_IMAGE = "/placeholders/landscape-image.png";
const rawBackgroundImage2 =
	typeof p.backgroundImages?.url2 === "string" && p.backgroundImages.url2.trim()
		? p.backgroundImages.url2
		: typeof p.backgroundImage2 === "string" && p.backgroundImage2.trim()
			? p.backgroundImage2
			: undefined;
const merchantBackground2 = merchantImage(["backgroundImage2"], rawBackgroundImage2) || undefined;
// b96-fix: `contentSet(["buttonText"], …)` смотрит `merfy.fields.buttonText` —
// такого ключа НЕТ и не может быть: кнопка Hero лежит в `cta`/`primaryButton`
// (вложенные объекты), а не в плоском top-level поле `buttonText`
// (`src/render/field-roles.ts` CONTENT_KEYS знает только плоское имя).
// `resolveBlockProps` (`src/render/resolve-props.ts`) видит top-level ключ
// `cta`/`primaryButton` как role="style" → `set` там означает лишь «объект не
// null», а не «текст не дефолтный». Поэтому `contentSet` всегда проваливался
// в свой строковый fallback: «строка непустая?» — а `cta.text` дефолт satin
// ('Кнопка', Hero.puckConfig.ts defaults) НЕПУСТОЙ с рождения. Итог —
// `hasMerchantCta` был `true` ВСЕГДА, как только `cta`/`primaryButton`
// материализовались в пропсах (deepMergeBlockProps домешивает дефолты темы в
// props при ЛЮБОЙ правке панели — не обязательно самой кнопки). Раз кнопка
// входит в hasMerchantText ниже — сплит-макет (текст-колонка + фото-колонка)
// включался при смене цветовой схемы/размера/фото, хотя заголовок и
// подзаголовок оставались дефолтными (баг владельца: «делится на две части
// при любом изменении, даже при загрузке одного фото»).
// Чиним сравнением с ЛИТЕРАЛЬНЫМ дефолтом кнопки (VERSTKA_CTA/PH_BUTTON, тот
// же текст, что и в Hero.puckConfig.ts defaults.cta.text) — так же, как
// `merchantImage()` выше отличает реальное фото мерчанта от дизайн-заглушки
// по пути `/placeholders/`. Пока текст кнопки равен дефолту — кнопка не
// считается заданной мерчантом; сторож: satin-b39-render-scheme-guards.spec.ts
// («b96: full-bleed ветка НЕ ломается, когда cta уже материализован…»).
const hasMerchantCta = !!rawPrimaryText.trim() && rawPrimaryText.trim() !== VERSTKA_CTA;
// Баг владельца (satin, секция «Изображение»): мерчант грузит ОДНО фото и не
// трогает заголовок/текст/кнопку — полотно всё равно делилось на текст-колонку
// (пустая, с плейсхолдер-копией) и фото-колонку в 50% ширины. У остальных
// четырёх тем (rose/bloom/flux/vanilla) секция ВСЕГДА full-bleed: фото на всю
// ширину, текст — оверлей поверх него; колонок нет вовсе. У satin колонки были
// БЕЗУСЛОВНЫМИ (не зависели от того, задан ли текст), поэтому даже «1 фото,
// текст не задан» уходило в сплит-ветку. Правило теперь то же, что у остальных
// тем: сплит-макет (текст-колонка + фото-колонка) — ТОЛЬКО когда мерчант реально
// задал текст/кнопку; иначе — full-bleed (тот же контракт, что и у полностью
// пустого состояния, но с РЕАЛЬНЫМ фото мерчанта вместо плейсхолдера).
// Заменяет прежний `isEmpty` (учитывал только заголовок/подзаголовок, не кнопку)
// как условие ветки — теперь совпадает с rose (rose.isEmpty включает и cta).
const hasMerchantText = hasMerchantTitle || hasMerchantSubtitle || hasMerchantCta;

// Лейблы заданного состояния (рендер мерчанта — НЕ трогаем при наличии данных).
const title = hasMerchantTitle
	? (p.heading?.text ?? p.title)
	: VERSTKA_TITLE;
const subtitle = hasMerchantSubtitle
	? (p.text?.content ?? p.subtitle)
	: VERSTKA_SUB;
const ctaRaw = p.primaryButton?.text ?? p.cta?.text ?? p.ctaText;
const ctaText = hasMerchantCta && typeof ctaRaw === "string" && ctaRaw.trim() ? ctaRaw : VERSTKA_CTA;
const ctaLink =
	p.primaryButton?.link?.href ??
	(typeof p.primaryButton?.link === "string" ? p.primaryButton.link : undefined) ??
	p.cta?.href ??
	p.ctaLink ??
	"/catalog";
// Слоты «Добавить фото» — ЕДИНОЕ правило на все темы
// (packages/theme-base/runtime/hero-media-slots.ts): одно фото занимает фото-
// половину целиком независимо от слота, деление 50/50 — только когда мерчант
// заполнил ОБА. На вход идут ТОЛЬКО фото мерчанта: заглушку подставляем ПОСЛЕ
// гейта. Раньше заглушка подставлялась ДО него, и одно фото во втором слоте
// давало деление, где левая половина — /placeholders/landscape-image.png
// (отчёт владельца: «блок делится на две части, как будто медиа два»).
const heroSlots = resolveHeroMediaSlots(merchantBackground, merchantBackground2);
// Нет своего фото (или стоит 4x верстальщика) → landscape-заглушка,
// не кампания /images/4x/Главный_экран.png и не чёрный кадр.
// Раньше плейсхолдер подставлялся ТОЛЬКО когда секция небезусловно НЕ isEmpty
// (сплит-ветка); теперь full-bleed-ветка (ниже) тоже ждёт непустой backgroundImage —
// фолбэк на PH_IMAGE безусловный, ветка сама решает рисовать плейсхолдер или нет
// (по heroSlots.primary: пусто → плейсхолдер, есть фото — оно).
const backgroundImage = heroSlots.primary || PH_IMAGE;
const backgroundImage2 = heroSlots.secondary || undefined;


// ДВА НЕЗАВИСИМЫХ размера у Hero:
//   • p.size — ВЫСОТА фото-половины/текст-колонки (heroHeightCls ниже). НЕ шрифт.
//   • heading.size / text.size — размер ШРИФТА заголовка/кикера (поля «Размер
//     заголовка»/«Размер текста»). Возвращены по решению владельца (откат unify
//     ee611471). font-size берётся ТОЛЬКО из heading.size/text.size, БЕЗ фолбэка на
//     p.size (иначе регулятор высоты снова менял бы кегль). Отсутствие → дефолт-
//     ветка large = ЛИТЕРАЛ верстальщика (MANNER.md §9) байт-в-байт прежнему виду.
//   заголовок: small 18/22 → medium 22/27 → large 26/32 (Kelly Slab uppercase)
//   кикер:     small 11    → medium 14    → large 16    (Arsenal light uppercase)
const headingSize = p.heading?.size;
const headingCls =
	headingSize === "small"
		? "font-logo text-[18px] font-normal leading-[1.08] text-[rgb(var(--color-heading,0_0_0))] md:text-[22px]"
		: headingSize === "medium"
			? "font-logo text-[22px] font-normal leading-[1.08] text-[rgb(var(--color-heading,0_0_0))] md:text-[27px]"
			: "font-logo text-[26px] font-normal leading-[1.08] text-[rgb(var(--color-heading,0_0_0))] md:text-[32px]";
const textSize = p.text?.size;
const subtitleCls =
	textSize === "small"
		? "font-manrope text-[11px] font-light tracking-[0.04em] text-[rgb(var(--color-muted,153_153_153))]"
		: textSize === "medium"
			? "font-manrope text-[14px] font-light tracking-[0.04em] text-[rgb(var(--color-muted,153_153_153))]"
			: "font-manrope text-[16px] font-light tracking-[0.04em] text-[rgb(var(--color-muted,153_153_153))]";
// «Размер» → высота фото-половины/текст-колонки (md:h-*). large (дефолт satin) =
// прежняя h-[680px] байт-в-байт; medium ≈0.82×, small ≈0.64×. Дефолт (p.size не
// задан) = large. Mobile aspect-[375/362] остаётся неизменным (портретный кадр).
const heroSize = p.size === "small" ? "small" : p.size === "medium" ? "medium" : "large";
const heroHeightCls = {
	large: "md:h-[680px]",
	medium: "md:h-[560px]",
	small: "md:h-[440px]",
}[heroSize];

// «Размер» (p.size) масштабирует не только высоту медиа, но и подложку-контейнер
// (max-w/gap/padding) + CTA-кнопку — симметрично (medium ≈0.82×, small ≈0.64×). large =
// прежние satin-значения байт-в-байт. Шрифты заголовка/кикера НЕ трогаем (у них свои
// поля heading.size/text.size).
const panelMaxWCls = {
	large: "max-w-[420px]",
	medium: "max-w-[344px]",
	small: "max-w-[270px]",
}[heroSize];
const panelGapCls = {
	large: "gap-6",
	medium: "gap-5",
	small: "gap-4",
}[heroSize];
const panelPadCls = {
	large: "p-6 md:p-10",
	medium: "p-5 md:p-8",
	small: "p-4 md:p-6",
}[heroSize];
const ctaSizeCls = {
	large: "min-h-12 px-6 text-[16px]",
	medium: "min-h-11 px-5 text-[15px]",
	small: "min-h-10 px-4 text-[14px]",
}[heroSize];

// Кнопки манеры §3 — реплика метрик .satin-button.satin-button-md. Цвета обеих —
// поля схемы своей роли (атрибут data-scheme-button, src/themes/scheme-buttons.ts):
// Основная ← «Основная кнопка», Дополнительная ← «Дополнительная кнопка»; Фон →
// фон, Текст → буквы, Обводка → рамка. Задача владельца 25.09: раньше рамка
// основной бралась из её Фона, дополнительная была прозрачным контуром с рамкой
// из «Текста», а скрытый buttonStyle=outlined менял кнопки местами.
const BTN_FRAME =
	`inline-flex ${ctaSizeCls} w-fit items-center justify-center rounded-[var(--radius-button,0px)] border border-solid font-manrope font-normal leading-none transition-opacity duration-[180ms] hover:opacity-[0.78]`;
const primaryBtnCls = BTN_FRAME;
const secondaryBtnCls = BTN_FRAME;
// Канон secondaryButton — рендер ТОЛЬКО при непустом тексте, рядом в ряд gap-3.
const secondaryText =
	typeof p.secondaryButton?.text === "string" && p.secondaryButton.text.trim()
		? p.secondaryButton.text
		: undefined;
const secondaryLink =
	p.secondaryButton?.link?.href ??
	(typeof p.secondaryButton?.link === "string" ? p.secondaryButton.link : undefined) ??
	"/catalog";

// Канон overlay 0-100 → чёрный слой на фото-половине (у верстальщика 0 — слоя нет).
const overlayN = Math.max(0, Math.min(100, Number(p.overlay) || 0));

// Канон container (toggle «Контейнер» панели «Изображение») — подложка-плашка
// ТОЛЬКО под текстовым блоком (фон схемы + паддинги + радиус), НЕ затемнение
// всего экрана (это отдельная настройка «Затемнение»/overlay). Паттерн rose Hero
// boxed: на светлой плашке текст героя переключаем на тёмный цвет схемы.
// Дефолт/пусто = 'false' → плашки нет → рендер байт-в-байт прежним строкам.
const boxed = String(p.container ?? "false") === "true";
const boxedCls = boxed
	? ` rounded-[var(--radius-card,0px)] bg-[rgb(var(--color-bg,255_255_255))]/95 ${panelPadCls} shadow-sm [&_h1]:!text-[rgb(var(--color-heading,0_0_0))] [&_p]:!text-[rgb(var(--color-muted,153_153_153))]`
	: "";

// Канон position (видимое поле панели) / contentPosition (legacy, те же 9 значений) —
// РАЗМЕЩЕНИЕ контент-блока по сетке: вертикаль (top/center=середина/bottom) → items-*
// на текст-колонке satin-bleed-left; горизонталь (left/center/right) → размещение блока
// внутри левой половины (mx-auto/ml-auto). Пустой проп = дефолт верстальщика
// (вертикаль СЕРЕДИНА, горизонталь СЛЕВА — байт-в-байт прежним строкам).
// Явное 'center' (По центру) = СЕРЕДИНА (раньше падало в дефолтную ветку — это и был баг).
// Выравнивание (alignment) теперь НЕЗАВИСИМО и отвечает только за выравнивание КОНТЕНТА.
const posRaw =
	typeof p.position === "string" && p.position
		? p.position
		: typeof p.contentPosition === "string"
			? p.contentPosition
			: "";
const vPos = posRaw.startsWith("top")
	? "top"
	: posRaw.startsWith("bottom")
		? "bottom"
		: posRaw === "center" || posRaw.startsWith("center")
			? "middle"
			: ""; // пусто = дефолт (середина)
const hPos = posRaw.endsWith("left") ? "left" : posRaw.endsWith("right") ? "right" : "center";
// vJustifyCls (вертикаль ПОЗИЦИИ) → items-* на flex-колонке; дефолт/пусто = середина.
const vJustifyCls = vPos === "top" ? "items-start" : vPos === "bottom" ? "items-end" : "items-center";
const vPadCls = vPos === "top" || vPos === "bottom" ? "md:py-12" : "md:py-0";
// hItemsCls (горизонталь ПОЗИЦИИ) → размещение блока в половине: пусто/дефолт = слева
// (без margin, байт-в-байт); center = mx-auto; right = ml-auto.
const hItemsCls = posRaw && hPos === "center" ? "mx-auto" : hPos === "right" ? "ml-auto" : "";
// alignment — выравнивание КОНТЕНТА внутри блока (НЕ двигает сам блок — это делает
// Позиция). items-*/text-* выравнивают заголовок/текст/кнопки друг относительно друга.
// Дефолт/пусто = прежняя строка байт-в-байт (без items-*/text-*, слева).
const alignItemsCls = p.alignment === "left" ? "items-start" : p.alignment === "right" ? "items-end" : p.alignment === "center" ? "items-center" : "";
const textAlignCls = p.alignment === "left" ? "text-left" : p.alignment === "right" ? "text-right" : p.alignment === "center" ? "text-center" : "";
const buttonsJustifyCls = p.alignment === "right" ? "justify-end" : p.alignment === "center" ? "justify-center" : "justify-start";
// Пустое состояние (заглушка до своих фото и текста) слушает «Позицию» и
// «Выравнивание» так же, как заполненное. Раньше заглушка стояла по центру при
// любом значении, а панель по умолчанию показывает «По центру слева» (тестер
// 24.09: «Изображение — не работают эти две фичи»). Без своего значения —
// то, что показывает панель: слева по горизонтали, середина по вертикали.
const emptyPosH = posRaw ? hPos : "left";
const emptyAlign = ["left", "center", "right"].includes(p.alignment) ? p.alignment : emptyPosH;
const EMPTY_V: Record<string, string> = { top: "justify-start md:py-12", middle: "justify-center", bottom: "justify-end md:py-12", "": "justify-center" };
const EMPTY_H: Record<string, string> = { left: "items-start", center: "items-center", right: "items-end" };
const EMPTY_TEXT: Record<string, string> = { left: "text-left", center: "text-center", right: "text-right" };
const emptyOuterCls = `absolute inset-0 z-10 flex w-full flex-col ${EMPTY_V[vPos]} ${EMPTY_H[emptyPosH]} gap-6 px-4 ${EMPTY_TEXT[emptyAlign]} sm:px-5 md:px-10`;
const emptyInnerCls = `flex w-full max-w-[540px] flex-col ${EMPTY_H[emptyAlign]} gap-4 ${EMPTY_TEXT[emptyAlign]} md:max-w-[640px]`;
const emptyBoxCls = `flex flex-col ${EMPTY_H[emptyAlign]} gap-6`;
// Без «Контейнера» заголовок, текст и кнопка — одна колонка шириной с текст,
// чтобы «Выравнивание» двигало и кнопку, а не только текст.
// Размеры заголовка и текста заглушки — та же лестница, что у заполненного
// экрана (headingCls/subtitleCls), без цвета: поверх фото цвет задаёт
// hero-over-photo. Без своего значения — «Большой», как было.
const EMPTY_HEADING_SIZE: Record<string, string> = { small: "text-[18px] md:text-[22px]", medium: "text-[22px] md:text-[27px]", large: "text-[26px] md:text-[32px]" };
const EMPTY_TEXT_SIZE: Record<string, string> = { small: "text-[11px]", medium: "text-[14px]", large: "text-[16px]" };
const emptyHeadingCls = `font-logo ${EMPTY_HEADING_SIZE[headingSize] ?? EMPTY_HEADING_SIZE.large} font-normal leading-[1.08] hero-over-photo-heading`;
const emptyTextCls = `font-manrope ${EMPTY_TEXT_SIZE[textSize] ?? EMPTY_TEXT_SIZE.large} font-light tracking-[0.04em] hero-over-photo-text`;
const EMPTY_ROW_JUSTIFY: Record<string, string> = { left: "justify-start", center: "justify-center", right: "justify-end" };
const emptyButtonsRowCls = `flex flex-row flex-wrap items-center gap-3 ${EMPTY_ROW_JUSTIFY[emptyAlign]}`;
const emptyWrapCls = `flex w-full max-w-[540px] flex-col ${EMPTY_H[emptyAlign]} gap-6 md:max-w-[640px]`;
const textColCls =
	`satin-bleed-left order-2 flex ${vJustifyCls} py-12 pr-4 md:order-1 ${heroHeightCls} ${vPadCls} md:pr-0`;
const blockCls =
	[hItemsCls, `flex ${panelMaxWCls} flex-col`, alignItemsCls, panelGapCls, textAlignCls]
		.filter(Boolean)
		.join(" ") + boxedCls;
const rowJustifyCls = buttonsJustifyCls;

// Канон padding {top,bottom} — inline-стиль ТОЛЬКО при заданном пропе (паттерн rose T14).
const paddingStyle = p.padding
	? `padding-top:${p.padding.top}px;padding-bottom:${p.padding.bottom}px;`
	: undefined;

// §4 Контракта секции: секция сама ставит свою цветовую схему. В превью
// конструктора блок перерисовывается БЕЗ обёртки композитора и иначе берёт
// :root (базовую палитру) — мерчант видит это как «поменял одну секцию, а
// соседние перекрасились». На live обёртка даёт ту же схему, дубль безвреден.
// Схема приходит строкой ИЛИ числом (нормализатор Slideshow) — разбираем оба.
const _rawScheme = p.colorScheme;
const _schemeId =
	typeof _rawScheme === "number"
		? String(_rawScheme)
		: typeof _rawScheme === "string" && _rawScheme
			? String(_rawScheme).replace("scheme-", "")
			: "";
const selfSchemeClass = _schemeId ? ` color-scheme-${_schemeId}` : "";


// Скрытый «глазом» именованный параметр не рендерится вовсе — ни своим
// значением, ни дефолтом-плейсхолдером. Список скрытых полей кладёт
// конструктор (props.hiddenFields), общий для всех тем.
const hiddenFields: string[] = Array.isArray((p as any).hiddenFields)
	? ((p as any).hiddenFields as unknown[]).filter((x): x is string => typeof x === 'string')
	: [];
const isFieldHidden = (f: string) => hiddenFields.includes(f);
// Порядок заголовка/текста/кнопок из перетаскивания в конструкторе
// (props.fieldOrder, packages/theme-base/runtime/field-order.ts). ПУСТАЯ секция —
// обычный реестр (heading выше text — Figma-плейсхолдер). ЗАПОЛНЕННАЯ секция
// satin по манере держит кикер (text) ВЫШЕ заголовка — свой базовый порядок
// SATIN_HERO_ORDER; при явном fieldOrder порядок буквальный (orderFields).
const SATIN_HERO_ORDER = ["text", "heading", "buttons"] as const;
const heroEmptyRuns = fieldRuns(sectionFieldOrder("Hero", p), ["heading", "text"]);
const heroFilledRuns = fieldRuns(orderFields(p, SATIN_HERO_ORDER), ["heading", "text"]);
---

{
	!hasMerchantText ? (
		/* Full-bleed-ветка (Figma 1:19335, тип «Изображение»): фото на ВСЮ секцию
		   + overlay-лейбл «Изображение» + хелпер-текст + кнопка «Кнопка» поверх
		   него. Раньше срабатывала ТОЛЬКО когда секция полностью пуста (без фото);
		   стоило добавить ОДНО фото — блок безусловно уходил в сплит-ветку ниже
		   (текст-колонка + фото-колонка 50/50), даже когда заголовок/текст/кнопку
		   мерчант не трогал (отчёт владельца: «загрузил одно фото — блок всё
		   равно делится на две части, слева пусто»). Теперь гейт — ЗАДАННЫЙ
		   мерчантом текст/кнопка, а не наличие фото: без текста секция full-bleed
		   с РЕАЛЬНЫМ фото мерчанта (heroSlots), без фото — тем же плейсхолдером,
		   что и раньше. Эталон — rose/bloom/flux/vanilla Hero.astro: там текст
		   ВСЕГДА оверлей поверх full-bleed фото, отдельной колонки нет вовсе.
		   Цвет заголовка/текста ПОВЕРХ фото — общий источник packages/theme-base/
		   styles/hero-over-photo.css (решает схема, белое — только фолбэк
		   переменной); читаемость держит градиент from-black/30 to-black/45 ниже.
		   Puck-subsection-атрибуты сохранены (heading=100, text=101,
		   primaryButton=102) — блок остаётся выделяемым/редактируемым в конструкторе. */
		<section
			class={`relative w-full overflow-hidden bg-[#111111]${selfSchemeClass}`}
			aria-labelledby="hero-title"
			data-puck-component-id={id}
			style={paddingStyle}
		>
			<div class={`relative aspect-[375/362] w-full md:aspect-auto ${heroHeightCls}`}>
				{/* Контракт картиночной секции (правило 2): картинка показывается
				    ВСЕГДА (object-cover) + штатное затемнение для читаемости overlay-
				    лейбла. Два фото мерчанта (оба слота заполнены, текст не задан) —
				    делятся 50/50 МЕЖДУ СОБОЙ на всю ширину секции (паритет rose:
				    grid-cols-2 внутри full-bleed рамки, а не рядом с текст-колонкой).
				    Плоский <img> — ТОЛЬКО для дизайн-плейсхолдера (нет фото мерчанта):
				    у placeholder-PNG нет соимённого .webp, а SatinPicture безусловно
				    эмитит <source srcset=*.webp> → 404 + <picture> не откатывается
				    (баг project_cart_thumb_image_bug). Реальное фото(-а) мерчанта —
				    SatinPicture, как в сплит-ветке ниже (webp/responsive). */}
				{/* Гейт — heroSlots.primary, а НЕ merchantBackground (тот проверяет ТОЛЬКО
				   слот 1 backgroundImages.url1/backgroundImage): фото, положенное ТОЛЬКО во
				   второй слот, проваливалось в плейсхолдер-ветку ниже, хотя backgroundImage
				   (из heroSlots) уже корректно указывал на фото мерчанта — мерчант видел
				   design-плейсхолдер вместо своего фото. Саботаж-тест
				   satin-b39-render-scheme-guards.spec.ts («фото ТОЛЬКО во втором слоте»). */}
				{
					backgroundImage2 ? (
						<div class="absolute inset-0 grid grid-cols-2">
							<SatinPicture
								src={backgroundImage}
								alt=""
								loading="eager"
								fetchpriority="high"
								class="size-full object-cover object-center"
							/>
							<SatinPicture
								src={backgroundImage2}
								alt=""
								loading="eager"
								fetchpriority="high"
								class="size-full object-cover object-center"
							/>
						</div>
					) : heroSlots.primary ? (
						<SatinPicture
							src={backgroundImage}
							alt=""
							loading="eager"
							fetchpriority="high"
							class="absolute inset-0 size-full object-cover object-center"
						/>
					) : (
						<img src={PH_IMAGE} alt="" loading="eager" fetchpriority="high" class="absolute inset-0 size-full object-cover object-center" aria-hidden="true" />
					)
				}
				<div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/30 to-black/45" aria-hidden="true"></div>
				{
					backgroundImage && overlayN > 0 && (
						<div
							class="pointer-events-none absolute inset-0 bg-black"
							style={`opacity:${overlayN / 100}`}
							aria-hidden="true"
						/>
					)
				}
				<div class={emptyOuterCls}>
					{/* «Контейнер» работает и на ПУСТОЙ секции. Свежедобавленный герой
					    рисуется этой веткой, и плашка до неё не доходила: мерчант щёлкал
					    переключателем и не видел ничего (баг тестера 22.09; замер прода —
					    разметка байт-в-байт). bloom и vanilla пустую секцию рисуют обычной
					    веткой, поэтому у них работало — расхождение 3 к 2. Выключенный
					    контейнер = `contents`: обёртка исчезает из раскладки целиком,
					    прежний вид сохраняется байт-в-байт. */}
					<div class:list={[boxed ? `${emptyBoxCls}${boxedCls}` : emptyWrapCls]}>
					{heroEmptyRuns.map((run) => run.grouped ? (
					<div class={emptyInnerCls}>
						{run.fields.map((field) => (
						<Fragment>
						{field === 'heading' && !isFieldHidden('heading') && (
							<h1
								id="hero-title"
								class={emptyHeadingCls}
								data-puck-subsection-parent={id}
								data-puck-subsection-index="100"
								data-puck-subsection-field="heading"
							>
								{PH_LABEL}
							</h1>
						)}
						{field === 'text' && !isFieldHidden('text') && (
							<p
								class={emptyTextCls}
								data-puck-subsection-parent={id}
								data-puck-subsection-index="101"
								data-puck-subsection-field="text"
							>
								{PH_HELPER}
							</p>
						)}
						</Fragment>
						))}
					</div>
					) : !isFieldHidden('buttons') && (
					/* Кнопки пустого состояния красятся ролью схемы (data-scheme-button),
					   как у заполненной ветки. Заголовок и текст поверх фото остаются на
					   hero-over-photo — они намеренно белые. */
					<div class={emptyButtonsRowCls}>
					<a
						href={ctaLink}
						class="inline-flex min-h-12 w-fit items-center justify-center rounded-[var(--radius-button,0px)] border border-solid px-6 font-manrope text-[16px] font-normal leading-none transition-opacity duration-[180ms] hover:opacity-[0.78]"
						data-scheme-button="primary"
						data-puck-subsection-parent={id}
						data-puck-subsection-index="102"
						data-puck-subsection-field="primaryButton"
					>
						{PH_BUTTON}
					</a>
					{secondaryText && (
						<a
							href={secondaryLink}
							class="inline-flex min-h-12 w-fit items-center justify-center rounded-[var(--radius-button,0px)] border border-solid px-6 font-manrope text-[16px] font-normal leading-none transition-opacity duration-[180ms] hover:opacity-[0.78]"
							data-scheme-button="secondary"
							data-puck-subsection-parent={id}
							data-puck-subsection-index="103"
							data-puck-subsection-field="secondaryButton"
						>
							{secondaryText}
						</a>
					)}
					</div>
					))}
					</div>
				</div>
			</div>
		</section>
	) : (
<section
	class={`relative w-full bg-[rgb(var(--color-bg,255_255_255))]${selfSchemeClass}`}
	aria-labelledby="hero-title"
	data-puck-component-id={id}
	style={paddingStyle}
>
	<div class="mx-auto grid w-full max-w-[1920px] grid-cols-1 md:grid-cols-2">
		<div class={textColCls}>
			<div class={blockCls}>
				{heroFilledRuns.map((run) => run.grouped ? (
				<div class="flex flex-col gap-4">
					{run.fields.map((field) => (
					<Fragment>
					{field === 'text' && !isFieldHidden('text') && (
						<p
							class={subtitleCls}
							data-puck-subsection-parent={id}
							data-puck-subsection-index="101"
							data-puck-subsection-field="text"
							set:html={inlineFormat(subtitle)}
						/>
					)}
					{field === 'heading' && !isFieldHidden('heading') && (
						<h1
							id="hero-title"
							class={headingCls}
							data-puck-subsection-parent={id}
							data-puck-subsection-index="100"
							data-puck-subsection-field="heading"
							set:html={inlineFormat(title)}
						/>
					)}
					</Fragment>
					))}
				</div>
				) : (
					!isFieldHidden('buttons') && (secondaryText ? (
						<div class={`flex w-full flex-row flex-wrap items-center gap-3 ${rowJustifyCls}`}>
							<a
								href={ctaLink}
								class={primaryBtnCls}
								data-scheme-button="primary"
								data-puck-subsection-parent={id}
								data-puck-subsection-index="102"
								data-puck-subsection-field="primaryButton"
							>
								{ctaText}
							</a>
							<a
								href={secondaryLink}
								class={secondaryBtnCls}
								data-scheme-button="secondary"
								data-puck-subsection-parent={id}
								data-puck-subsection-index="103"
								data-puck-subsection-field="secondaryButton"
							>
								{secondaryText}
							</a>
						</div>
					) : (
						<a
							href={ctaLink}
							class={primaryBtnCls}
							data-scheme-button="primary"
							data-puck-subsection-parent={id}
							data-puck-subsection-index="102"
							data-puck-subsection-field="primaryButton"
						>
							{ctaText}
						</a>
					))
				))}
			</div>
		</div>

		<div
			class:list={[
				`relative order-1 aspect-[375/362] overflow-hidden md:order-2 md:aspect-auto ${heroHeightCls}`,
				// Пустое состояние — пустой image-rect surface-тона темы (Figma 1:19335);
				// с фото — чёрная подложка верстальщика (под object-cover кадрами).
				backgroundImage ? "bg-[#111111]" : "bg-[rgb(var(--color-surface,245_245_245))]",
			]}
		>
			{
				backgroundImage ? (
					backgroundImage2 ? (
						<div class="absolute inset-0 grid grid-cols-2">
							<SatinPicture
								src={backgroundImage}
								alt={title}
								loading="eager"
								fetchpriority="high"
								class="size-full object-cover object-center"
							/>
							<SatinPicture
								src={backgroundImage2}
								alt=""
								loading="eager"
								fetchpriority="high"
								class="size-full object-cover object-center"
							/>
						</div>
					) : (
						<SatinPicture
							src={backgroundImage}
							alt={title}
							loading="eager"
							fetchpriority="high"
							class="absolute inset-0 size-full object-cover object-center"
						/>
					)
				) : null
			}
			{
				backgroundImage && overlayN > 0 && (
					<div
						class="pointer-events-none absolute inset-0 z-[1] bg-black"
						style={`opacity:${overlayN / 100}`}
					/>
				)
			}
		</div>
	</div>
</section>
	)
}
