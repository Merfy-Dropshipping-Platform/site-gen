							class="flex h-10 shrink-0 items-center justify-center border-0 bg-[var(--vanilla-header-bg)] px-3 py-2.5 font-vanilla-arsenal text-[14px] font-normal uppercase leading-[18px] text-white transition-opacity hover:opacity-90"
